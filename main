def get_active_event():
    """Retourne l'événement de points actif (si existant)."""
    cursor.execute("""
        SELECT id, event_type, multiplier, target_game, description, ends_at
        FROM active_events
        WHERE is_active=1
        AND (ends_at IS NULL OR ends_at > datetime('now'))
        ORDER BY id DESC LIMIT 1
    """)
    row = cursor.fetchone()
    if not row:
        return None
    return {
        'id': row[0], 'event_type': row[1], 'multiplier': row[2],
        'target_game': row[3], 'description': row[4], 'ends_at': row[5]
    }

def get_event_multiplier(game, event):
    """Retourne le multiplicateur de l'événement pour ce jeu."""
    if not event:
        return 1.0
    if event['event_type'] == 'all_games':
        return event['multiplier']
    if event['event_type'] == 'specific_game' and event['target_game']:
        if normalize_str(game or '') == normalize_str(event['target_game']):
            return event['multiplier']
    return 1.0

def get_active_monthly_challenge():
    """Retourne le challenge mensuel actif."""
    month_start = get_current_month_start()
    cursor.execute("""
        SELECT id, description, target_type, target_value, bonus_points, max_winners
        FROM monthly_challenge WHERE month_start=? AND is_active=1
    """, (month_start,))
    row = cursor.fetchone()
    if not row:
        return None
    return {
        'id': row[0], 'description': row[1], 'target_type': row[2],
        'target_value': row[3], 'bonus_points': row[4], 'max_winners': row[5]
    }

def get_active_monthly_type_challenge():
    cursor.execute("""
        SELECT id, month, year, shiny_type, top_n, bonus_points,
               bonus_top1, bonus_top2, bonus_top3, bonus_other,
               description, ends_at, announce_channel_id
        FROM monthly_type_challenge
        WHERE active = 1
        ORDER BY id DESC
        LIMIT 1
    """)
    row = cursor.fetchone()
    if not row:
        return None

    # Un challenge expiré (ends_at dépassé) ne doit plus être traité comme
    # "actif" pour l'affichage/les commandes, mais on NE désactive PAS la ligne
    # ici : c'est auto_finalize_expired_type_challenges() qui s'en charge, car
    # lui seul distribue les points de bonus avant de clôturer. Le faire ici
    # sans distribuer les points était le bug : le challenge disparaissait
    # silencieusement en fin de période sans que personne ne reçoive ses points.
    ends_at = row[11]
    if ends_at:
        try:
            if datetime.strptime(ends_at, "%Y-%m-%d %H:%M") <= datetime.now():
                return None
        except Exception:
            pass
    return row

def close_active_monthly_type_challenges():
    cursor.execute("UPDATE monthly_type_challenge SET active = 0 WHERE active = 1")
    conn.commit()


def canonical_pokemon_type(type_name):
    """Retourne le libellé FR canonique d'un type Pokémon."""
    norm = normalize_str(type_name)
    if not norm:
        return ""
    for fr, _en in POKEMON_TYPES:
        if normalize_str(fr) == norm:
            return fr
    return str(type_name).strip()


def create_monthly_type_challenge(
    month, year, shiny_type, top_n,
    bonus_points, bonus_top1, bonus_top2, bonus_top3, bonus_other,
    description, ends_at, announce_channel_id, created_by
):
    created_at = datetime.now().strftime("%d-%m-%Y %H:%M:%S")
    shiny_type = canonical_pokemon_type(shiny_type)
    close_active_monthly_type_challenges()
    cursor.execute(
        """
        INSERT INTO monthly_type_challenge (
            month, year, shiny_type, top_n, bonus_points,
            bonus_top1, bonus_top2, bonus_top3, bonus_other,
            description, ends_at, announce_channel_id, created_by, created_at, active
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1)
        """,
        (
            month, year, shiny_type, top_n, float(bonus_points),
            float(bonus_top1), float(bonus_top2), float(bonus_top3), float(bonus_other),
            description or "", ends_at, str(announce_channel_id) if announce_channel_id else None,
            created_by, created_at
        )
    )
    conn.commit()
    return cursor.lastrowid


def _parse_challenge_shiny_date(date_value, created_at=None):
    """Parse la date affichée d'un shiny, avec fallback sur created_at."""
    candidates = [date_value, created_at]
    formats = (
        "%d-%m-%Y", "%d/%m/%Y",
        "%Y-%m-%d", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M:%S.%f",
        "%d-%m-%Y %H:%M:%S", "%d/%m/%Y %H:%M:%S",
    )
    for value in candidates:
        if not value:
            continue
        raw = str(value).strip()
        for fmt in formats:
            try:
                return datetime.strptime(raw[:26] if "%f" in fmt else raw[:19], fmt).date()
            except ValueError:
                continue
        try:
            return datetime.fromisoformat(raw).date()
        except Exception:
            continue
    return None


def _get_type_challenge_base_counts(shiny_type, month=None, year=None, user_id=None, start_date=None, end_date=None):
    """Compte les vrais shinys d'un type avec comparaison normalisée."""
    target_type = normalize_str(shiny_type)
    if not target_type:
        return {}
    if start_date is None and month is not None and year is not None:
        start_date = datetime(int(year), int(month), 1).date()

    exclude = VARIETY_COUNT_EXCLUDE
    placeholders = ",".join("?" * len(exclude))
    params = [*exclude]
    user_clause = ""
    if user_id is not None:
        user_clause = "AND user_id = ?"
        params.append(str(user_id))

    cursor.execute(f"""
        SELECT user_id, type_pokemon, date, created_at
        FROM shiny
        WHERE type_pokemon IS NOT NULL
          AND TRIM(type_pokemon) != ''
          AND (methode IS NULL OR methode NOT IN ({placeholders}))
          {user_clause}
    """, tuple(params))

    counts = {}
    for uid, row_type, shiny_date, created_at in cursor.fetchall():
        if normalize_str(row_type) != target_type:
            continue

        parsed_date = _parse_challenge_shiny_date(shiny_date, created_at)
        if not parsed_date:
            continue
        if start_date is not None and parsed_date < start_date:
            continue
        if end_date is not None and parsed_date > end_date:
            continue

        uid = str(uid)
        counts[uid] = counts.get(uid, 0) + 1
    return counts


def _get_type_challenge_period(month, year, created_at=None, ends_at=None):
    """Retourne les bornes de comptage d'un challenge type actif."""
    start_date = datetime(int(year), int(month), 1).date()
    created_date = _parse_challenge_shiny_date(created_at)
    if created_date and created_date < start_date:
        start_date = created_date
    end_date = _parse_challenge_shiny_date(ends_at)
    return start_date, end_date


def get_type_challenge_base_count(challenge_id, user_id):
    cursor.execute("""
        SELECT month, year, shiny_type, created_at, ends_at
        FROM monthly_type_challenge
        WHERE id = ?
    """, (challenge_id,))
    challenge = cursor.fetchone()
    if not challenge:
        return 0

    month, year, shiny_type, created_at, ends_at = challenge
    start_date, end_date = _get_type_challenge_period(month, year, created_at, ends_at)
    counts = _get_type_challenge_base_counts(
        shiny_type,
        user_id=str(user_id),
        start_date=start_date,
        end_date=end_date
    )
    return counts.get(str(user_id), 0)

def set_type_challenge_count(challenge_id, user_id, desired_total):
    base_count = get_type_challenge_base_count(challenge_id, user_id)
    adjustment = int(desired_total) - int(base_count)
    updated_at = datetime.now().strftime("%d-%m-%Y %H:%M:%S")
    cursor.execute("""
        INSERT INTO monthly_type_challenge_adjustments (challenge_id, user_id, adjustment, updated_at)
        VALUES (?, ?, ?, ?)
        ON CONFLICT(challenge_id, user_id)
        DO UPDATE SET adjustment = excluded.adjustment, updated_at = excluded.updated_at
    """, (challenge_id, str(user_id), adjustment, updated_at))
    conn.commit()
    return base_count, adjustment

def get_type_challenge_leaderboard(challenge_id):
    cursor.execute("""
        SELECT month, year, shiny_type, top_n, bonus_points,
               bonus_top1, bonus_top2, bonus_top3, bonus_other,
               description, ends_at, announce_channel_id, created_at
        FROM monthly_type_challenge
        WHERE id = ?
    """, (challenge_id,))
    challenge = cursor.fetchone()
    if not challenge:
        return None, []

    month, year, shiny_type = challenge[0], challenge[1], challenge[2]
    start_date, end_date = _get_type_challenge_period(month, year, challenge[12], challenge[10])
    base_counts = _get_type_challenge_base_counts(
        shiny_type,
        start_date=start_date,
        end_date=end_date
    )

    cursor.execute("""
        SELECT user_id, adjustment
        FROM monthly_type_challenge_adjustments
        WHERE challenge_id = ?
    """, (challenge_id,))
    adjustments = {str(uid): int(adj or 0) for uid, adj in cursor.fetchall()}

    scores = []
    for uid in sorted(set(base_counts) | set(adjustments)):
        total = int(base_counts.get(uid, 0)) + int(adjustments.get(uid, 0))
        if total > 0:
            scores.append((uid, total))

    scores.sort(key=lambda x: (-x[1], x[0]))

    return challenge, scores

def close_monthly_type_challenge(challenge_id):
    cursor.execute("UPDATE monthly_type_challenge SET active = 0 WHERE id = ?", (challenge_id,))
    conn.commit()


def get_expired_active_type_challenges():
    """Retourne les challenges type encore marqués actifs mais dont la date de
    fin est dépassée — ceux qu'il faut finaliser (distribuer les points + clôturer)."""
    cursor.execute("""
        SELECT id, ends_at FROM monthly_type_challenge
        WHERE active = 1 AND ends_at IS NOT NULL
    """)
    expired = []
    for challenge_id, ends_at in cursor.fetchall():
        try:
            if datetime.strptime(ends_at, "%Y-%m-%d %H:%M") <= datetime.now():
                expired.append(challenge_id)
        except Exception:
            continue
    return expired


async def auto_finalize_expired_type_challenges():
    """Distribue automatiquement les points de bonus aux gagnants d'un challenge
    type dès que sa date de fin est atteinte, puis clôture le challenge et
    poste une annonce. Avant ce correctif, le challenge disparaissait
    silencieusement à l'expiration sans que personne ne touche ses points."""
    for challenge_id in get_expired_active_type_challenges():
        try:
            info, scores = get_type_challenge_leaderboard(challenge_id)
            if not info:
                close_monthly_type_challenge(challenge_id)
                continue

            month, year, shiny_type, top_n = info[0], info[1], info[2], info[3]
            bonus_top1, bonus_top2, bonus_top3, bonus_other = info[5], info[6], info[7], info[8]
            announce_channel_id = info[11]

            winners = scores[:top_n]
            winner_lines = []
            guild = bot.get_guild(GUILD_ID)
            for position, (user_id, total_shinys) in enumerate(winners, start=1):
                rank_bonus = get_rank_bonus(position, bonus_top1, bonus_top2, bonus_top3, bonus_other)
                effective_rank_bonus = rank_bonus
                if rank_bonus > 0:
                    effective_rank_bonus = award_capped_bonus(
                        user_id, f"[Bonus Challenge Type {month:02d}/{year} Top {position}]",
                        'type_challenge_bonus', float(rank_bonus)
                    )
                member = guild.get_member(int(user_id)) if guild else None
                player_name = member.mention if member else f"Utilisateur {user_id}"
                medal = "🥇" if position == 1 else ("🥈" if position == 2 else ("🥉" if position == 3 else "🏅"))
                winner_lines.append(f"{medal} {player_name} — **{total_shinys}** shiny(s) · +{float(effective_rank_bonus):.2f} pts")
            conn.commit()

            close_monthly_type_challenge(challenge_id)
            logger.info(f"[CHALLENGE TYPE] Challenge #{challenge_id} ({shiny_type}) finalisé automatiquement, {len(winners)} gagnant(s) récompensé(s).")

            channel = None
            if announce_channel_id:
                channel = bot.get_channel(int(announce_channel_id))
            if not channel:
                channel = bot.get_channel(SALON_CHALLENGE_STATUS_ID)
            if channel:
                embed = discord.Embed(
                    title="🎉 Challenge Type terminé — Résultats",
                    description=f"**{shiny_type} ({month:02d}/{year})** vient de se terminer automatiquement.",
                    color=discord.Color.purple(),
                    timestamp=datetime.now(timezone.utc)
                )
                embed.add_field(
                    name="🏆 Classement final",
                    value="\n".join(winner_lines) if winner_lines else "Aucun participant n'a validé de shiny de ce type.",
                    inline=False
                )
                embed.set_footer(text="ShinyBot · Points distribués automatiquement")
                await channel.send(embed=embed)
        except Exception as e:
            logger.error(f"[CHALLENGE TYPE] Erreur finalisation auto challenge #{challenge_id}: {e}", exc_info=True)


async def background_type_challenge_watcher():
    """Tâche de fond : vérifie toutes les 5 minutes si un challenge type actif
    a dépassé sa date de fin, et distribue automatiquement les points le cas échéant."""
    await bot.wait_until_ready()
    await asyncio.sleep(20)
    while not bot.is_closed():
        try:
            await auto_finalize_expired_type_challenges()
        except Exception as e:
            logger.error(f"[CHALLENGE TYPE] Erreur background_type_challenge_watcher: {e}", exc_info=True)
        await asyncio.sleep(300)

def get_rank_bonus(position, bonus_top1, bonus_top2, bonus_top3, bonus_other):
    if position == 1:
        return float(bonus_top1)
    if position == 2:
        return float(bonus_top2)
    if position == 3:
        return float(bonus_top3)
    return float(bonus_other)

def get_challenge_winners_count():
    """Retourne le nombre de gagnants du challenge ce mois."""
    month_start = get_current_month_start()
    cursor.execute("SELECT COUNT(*) FROM monthly_challenge_winners WHERE month_start=?", (month_start,))
    return cursor.fetchone()[0] or 0

def has_won_challenge(user_id):
    month_start = get_current_month_start()
    cursor.execute("SELECT 1 FROM monthly_challenge_winners WHERE month_start=? AND user_id=?",
                   (month_start, str(user_id)))
    return cursor.fetchone() is not None

def register_challenge_winner(user_id):
    month_start = get_current_month_start()
    try:
        cursor.execute("INSERT OR IGNORE INTO monthly_challenge_winners (month_start, user_id) VALUES (?,?)",
                       (month_start, str(user_id)))
        conn.commit()
        return cursor.rowcount > 0
    except Exception:
        return False

def check_challenge_completion(user_id, pokemon, game, pokemon_type=None):
    """Vérifie si le shiny complète le challenge mensuel pour ce joueur.
    Retourne le bonus si oui, sinon 0.

    Règle anti-abus : un même Pokémon (même nom normalisé) dans le même jeu
    ne peut être soumis qu'une seule fois par participant pour le challenge en cours.
    La liste se remet à zéro automatiquement à chaque nouveau challenge (nouveau challenge_id).
    """
    challenge = get_active_monthly_challenge()
    if not challenge or has_won_challenge(user_id):
        return 0, None
    if get_challenge_winners_count() >= challenge['max_winners']:
        return 0, None

    # ── Déduplication (pokemon, jeu) par participant ──────────────────────
    pnorm = normalize_str(pokemon)
    gnorm = normalize_str(game or '')
    cursor.execute(
        "SELECT 1 FROM monthly_challenge_pokemon_log "
        "WHERE challenge_id=? AND user_id=? AND pokemon_norm=? AND game_norm=?",
        (challenge['id'], str(user_id), pnorm, gnorm)
    )
    if cursor.fetchone():
        # Ce (pokemon, jeu) a déjà été soumis par ce participant pour ce challenge
        return 0, None

    # Enregistrer immédiatement pour éviter tout double comptage concurrent
    try:
        cursor.execute(
            "INSERT OR IGNORE INTO monthly_challenge_pokemon_log "
            "(challenge_id, user_id, pokemon_norm, game_norm) VALUES (?,?,?,?)",
            (challenge['id'], str(user_id), pnorm, gnorm)
        )
        conn.commit()
    except Exception as _e:
        logger.warning(f"Erreur log challenge pokemon: {_e}")
    # ─────────────────────────────────────────────────────────────────────

    ttype = challenge['target_type']
    tval  = challenge['target_value'] or ''
    completed = False

    if ttype == 'pokemon_type' and pokemon_type:
        completed = normalize_str(pokemon_type) == normalize_str(tval)
    elif ttype == 'game' and game:
        completed = normalize_str(game) == normalize_str(tval)
    elif ttype == 'pokemon':
        completed = normalize_str(pokemon) == normalize_str(tval)
    elif ttype == 'letter':
        completed = normalize_str(pokemon).startswith(normalize_str(tval))
    elif ttype == 'starter':
        completed = normalize_str(pokemon) in get_special_list('starter')
    elif ttype == 'legendary':
        completed = normalize_str(pokemon) in get_special_list('legendary')

    if completed:
        if register_challenge_winner(user_id):
            rank = get_challenge_winners_count()
            return challenge['bonus_points'], challenge['description']
    return 0, None

def award_participation_bonus(user_id):
    """Attribue le bonus de participation hebdo (+5 pts, réduit par le cap bonus si déjà atteint) si pas encore reçu.
    Retourne le montant effectif crédité (float), ou False si déjà reçu cette semaine."""
    week_start = get_current_week_start()
    cursor.execute(
        "SELECT bonus_awarded FROM weekly_participation WHERE user_id=? AND week_start=?",
        (str(user_id), week_start)
    )
    row = cursor.fetchone()
    if row and row[0]:
        return False  # Déjà reçu
    cursor.execute("""
        INSERT INTO weekly_participation (user_id, week_start, bonus_awarded)
        VALUES (?, ?, 1)
        ON CONFLICT(user_id, week_start) DO UPDATE SET bonus_awarded=1
    """, (str(user_id), week_start))
    effective = award_capped_bonus(user_id, '[Participation Hebdo]', 'participation_bonus', 5)
    conn.commit()
    return effective

WEEKLY_GAME_BONUS_ANNOUNCE_CHANNEL = 1488606331483979868
# Jeux exclus du tirage hebdo (pas de shiny possible ou hors-compétition)
WEEKLY_GAME_EXCLUDED = {'dc_event'}

def draw_weekly_game():
    """Tire au sort un jeu aléatoire pour la semaine. Appelé chaque lundi à minuit."""
    import random as _rand
    eligible = [k for k in GAMES if k not in WEEKLY_GAME_EXCLUDED]
    week_start = get_current_week_start()
    # Ne pas retirer si déjà tiré cette semaine
    cursor.execute("SELECT game_key FROM weekly_game_bonus WHERE week_start=?", (week_start,))
    row = cursor.fetchone()
    if row:
        return row[0]  # Déjà tiré, on renvoie le même
    chosen = _rand.choice(eligible)
    cursor.execute("""
        INSERT OR IGNORE INTO weekly_game_bonus (week_start, game_key) VALUES (?, ?)
    """, (week_start, chosen))
    conn.commit()
    return chosen

def get_weekly_game():
    """Retourne le jeu tiré pour la semaine courante, ou None si pas encore tiré."""
    week_start = get_current_week_start()
    cursor.execute("SELECT game_key FROM weekly_game_bonus WHERE week_start=?", (week_start,))
    row = cursor.fetchone()
    return row[0] if row else None

def is_weekly_game_bonus_available():
    """Retourne True si le bonus du jeu de la semaine n'a pas encore été réclamé."""
    week_start = get_current_week_start()
    cursor.execute("""
        SELECT claimed_by FROM weekly_game_bonus WHERE week_start=? AND claimed_by IS NULL
    """, (week_start,))
    return cursor.fetchone() is not None

def award_weekly_game_bonus(user_id):
    """Attribue le bonus jeu de la semaine (+20 pts, réduit par le cap bonus si déjà atteint) au premier joueur qualifié.
    Retourne le montant effectif crédité (float), ou False si déjà pris."""
    week_start = get_current_week_start()
    cursor.execute("""
        UPDATE weekly_game_bonus
        SET claimed_by=?, claimed_at=datetime('now')
        WHERE week_start=? AND claimed_by IS NULL
    """, (str(user_id), week_start))
    if cursor.rowcount == 0:
        return False  # Déjà réclamé par quelqu'un d'autre
    effective = award_capped_bonus(user_id, '[🎮 1er Shiny du Jeu de la Semaine !]', 'monday_first_bonus', 20)
    conn.commit()
    return effective

