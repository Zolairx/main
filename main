@bot.tree.command(
    name="objectifs_mois",
    description="Voir vos objectifs mensuels et votre progression",
    guild=discord.Object(id=GUILD_ID)
)
async def objectifs_mois(interaction: discord.Interaction):
    await interaction.response.defer(ephemeral=True)
    user_id = str(interaction.user.id)
    objectives = get_active_monthly_objectives()
    month_start = get_current_month_start()

    if not objectives:
        embed = discord.Embed(
            title="📆 Objectifs Mensuels",
            description="Aucun objectif actif ce mois.\nLes admins peuvent en créer avec `/admin_objectif_mensuel_add`.",
            color=discord.Color.light_grey()
        )
        await interaction.followup.send(embed=embed, ephemeral=True)
        return

    diff_emoji = {'easy':'🟢','medium':'🟡','hard':'🔴','':'⚪'}
    embed = discord.Embed(
        title="📆 Objectifs du Mois",
        description=f"Mois de **{month_start[:7]}**",
        color=discord.Color.purple()
    )

    for obj in objectives:
        progress = get_user_monthly_progress(user_id, obj['id'])
        current = progress['current_value']
        target = obj['target_value']
        completed = bool(progress['completed'])
        awarded = bool(progress['bonus_awarded'])

        status = "✅ Complété !" if completed else f"⏳ {current}/{int(target) if target == int(target) else target}"
        reward = " 💰 Bonus reçu !" if awarded else (f" → +{obj['bonus_points']} pts" if completed else f" → +{obj['bonus_points']} pts à gagner")
        bar_filled = int((min(current, target) / target) * 10) if target > 0 else 0
        bar = "█" * bar_filled + "░" * (10 - bar_filled)

        embed.add_field(
            name=f"{diff_emoji.get(obj['difficulty'],'⚪')} [{obj['difficulty'].upper()}] {obj['description']}",
            value=f"{status}{reward}\n`{bar}`",
            inline=False
        )

    embed.set_footer(text="Les objectifs mensuels se renouvellent le 1er de chaque mois • ShinyBot")
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="admin_objectif_mensuel_add",
    description="[ADMIN] Créer un objectif mensuel en 3 étapes",
    guild=discord.Object(id=GUILD_ID)
)
async def admin_objectif_mensuel_add(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    view = ObjectiveBuilderStep1(mode="monthly")
    embed = discord.Embed(
        title="📆 Créer un Objectif Mensuel",
        description="**Étape 1/3** — Quel est le type d'objectif ?",
        color=discord.Color.purple()
    )
    await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


def save_monthly_objective(otype, desc, target, bonus, diff, extra, destination, user_id):
    if destination == 'monthly_pool':
        cursor.execute("""
            INSERT INTO monthly_objectives_pool (type, description, target_value, bonus_points, difficulty, target_extra, created_by)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (otype, desc, target, bonus, diff, extra, user_id))
    else:
        month_start = get_current_month_start()
        cursor.execute("""
            INSERT INTO monthly_objectives (type, description, target_value, bonus_points, difficulty, target_extra, month_start, created_by)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (otype, desc, target, bonus, diff, extra, month_start, user_id))
    conn.commit()


@bot.tree.command(
    name="admin_objectif_mensuel_list",
    description="[ADMIN] Voir le pool d'objectifs mensuels",
    guild=discord.Object(id=GUILD_ID)
)
async def admin_objectif_mensuel_list(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    cursor.execute("SELECT id, type, description, target_value, bonus_points, difficulty, target_extra, is_active FROM monthly_objectives_pool ORDER BY difficulty, id")
    rows = cursor.fetchall()
    if not rows:
        await interaction.followup.send("Le pool mensuel est vide. Utilisez `/admin_objectif_mensuel_add`.", ephemeral=True)
        return
    diff_emoji = {'easy':'🟢','medium':'🟡','hard':'🔴'}
    embed = discord.Embed(title="📋 Pool d'Objectifs Mensuels", color=discord.Color.purple())
    for row in rows[:25]:
        oid, otype, desc, target, bonus, diff, extra, active = row
        status = "✅" if active else "❌"
        extra_txt = f" | Cible: {display_target_extra(extra)}" if extra else ""
        embed.add_field(
            name=f"{status} #{oid} {diff_emoji.get(diff,'⚪')} [{diff.upper()}] {desc}",
            value=f"Type: `{otype}` | Valeur: `{target}`{extra_txt} | Bonus: **+{bonus} pts**",
            inline=False
        )
    embed.set_footer(text="Utilisez /admin_objectif_mensuel_remove <id> pour désactiver")
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="admin_objectif_mensuel_remove",
    description="[ADMIN] Désactiver un objectif du pool mensuel",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(objectif_id="ID de l'objectif (visible avec /admin_objectif_mensuel_list)")
async def admin_objectif_mensuel_remove(interaction: discord.Interaction, objectif_id: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    cursor.execute("SELECT description FROM monthly_objectives_pool WHERE id=?", (objectif_id,))
    row = cursor.fetchone()
    if not row:
        await interaction.response.send_message("❌ Objectif introuvable.", ephemeral=True)
        return
    cursor.execute("UPDATE monthly_objectives_pool SET is_active=0 WHERE id=?", (objectif_id,))
    conn.commit()
    await interaction.response.send_message(f"✅ Objectif mensuel **{row[0]}** désactivé du pool.", ephemeral=True)


@bot.tree.command(
    name="admin_objectif_mois_retirer",
    description="[ADMIN] Retirer un objectif actif du mois en cours",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(objectif_id="ID de l'objectif actif (visible avec /admin_objectifs_mois action:Voir les objectifs du mois)")
async def admin_objectif_mois_retirer(interaction: discord.Interaction, objectif_id: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    month_start = get_current_month_start()

    # Vérifier que l'objectif appartient bien au mois actif
    cursor.execute(
        "SELECT description FROM monthly_objectives WHERE id=? AND month_start=? AND is_active=1",
        (objectif_id, month_start)
    )
    row = cursor.fetchone()
    if not row:
        # Essayer de trouver l'objectif pour donner un message utile
        cursor.execute("SELECT description, month_start FROM monthly_objectives WHERE id=?", (objectif_id,))
        any_row = cursor.fetchone()
        if any_row:
            await interaction.followup.send(
                f"❌ L'objectif **#{objectif_id}** existe mais n'est pas actif ce mois-ci (mois: {any_row[1]})."
                f"Utilisez `/admin_objectifs_mois action:Voir les objectifs du mois` pour voir les IDs actifs.",
                ephemeral=True
            )
        else:
            await interaction.followup.send(
                f"❌ Objectif **#{objectif_id}** introuvable."
                f"Utilisez `/admin_objectifs_mois action:Voir les objectifs du mois` pour voir les IDs actifs.",
                ephemeral=True
            )
        return

    # Désactiver l'objectif du mois en cours
    cursor.execute("UPDATE monthly_objectives SET is_active=0 WHERE id=?", (objectif_id,))
    conn.commit()
    await interaction.followup.send(
        f"✅ Objectif mensuel **{row[0]}** retiré du mois en cours.",
        ephemeral=True
    )


@bot.tree.command(
    name="admin_objectifs_mois",
    description="[ADMIN] Gérer les objectifs du mois en cours",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(action="Action à effectuer")
@app_commands.choices(action=[
    app_commands.Choice(name="Tirage automatique depuis le pool", value="draw"),
    app_commands.Choice(name="Voir les objectifs du mois", value="view"),
    app_commands.Choice(name="Effacer les objectifs du mois", value="clear"),
])
async def admin_objectifs_mois(interaction: discord.Interaction, action: str):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    month_start = get_current_month_start()

    if action == "draw":
        ok, result = draw_monthly_objectives()
        if ok:
            await interaction.followup.send(
                f"✅ Tirage effectué pour **{month_start[:7]}** ({len(result)} objectifs) :\n" +
                "\n".join(f"• {r}" for r in result), ephemeral=True
            )
        else:
            await interaction.followup.send(f"⚠️ {result}\nUtilisez **Effacer** puis relancez.", ephemeral=True)

    elif action == "view":
        # Chercher tous les objectifs du mois actuel (actifs ou non)
        cursor.execute("""
            SELECT id, type, description, target_value, bonus_points, difficulty, target_extra, is_active
            FROM monthly_objectives WHERE month_start = ?
            ORDER BY id
        """, (month_start,))
        rows = cursor.fetchall()
        if not rows:
            # Chercher si des objectifs existent pour un autre mois
            cursor.execute("SELECT DISTINCT month_start FROM monthly_objectives ORDER BY month_start DESC LIMIT 3")
            other_months = [r[0] for r in cursor.fetchall()]
            msg = f"❌ Aucun objectif trouvé pour **{month_start[:7]}**."
            if other_months:
                msg += f"\n📅 Objectifs existants pour : {', '.join(other_months)}"
                msg += f"\nUtilisez `/admin_objectif_mensuel_add` ou `/admin_objectifs_mois action:Tirage automatique` pour créer les objectifs du mois."
            await interaction.followup.send(msg, ephemeral=True)
            return
        diff_emoji = {"easy":"🟢","medium":"🟡","hard":"🔴"}
        embed = discord.Embed(title=f"📆 Objectifs du mois {month_start[:7]}", color=discord.Color.purple())
        for row in rows:
            oid, otype, desc, target, bonus, diff, extra, is_active = row
            status = "✅" if is_active else "❌ (désactivé)"
            extra_txt = f" (cible: {display_target_extra(extra)})" if extra else ""
            embed.add_field(
                name=f"{status} {diff_emoji.get(diff,'⚪')} #{oid} [{diff.upper()}] {desc}",
                value=f"Type: `{otype}` | Valeur: `{target}`{extra_txt} | Bonus: **+{bonus} pts**",
                inline=False
            )
        embed.set_footer(text=f"Utilisez /admin_objectif_mois_retirer objectif_id:<ID> pour retirer un objectif actif")
        await interaction.followup.send(embed=embed, ephemeral=True)

    elif action == "clear":
        cursor.execute("UPDATE monthly_objectives SET is_active=0 WHERE month_start=?", (month_start,))
        conn.commit()
        await interaction.followup.send(f"✅ Objectifs de **{month_start[:7]}** effacés.", ephemeral=True)



