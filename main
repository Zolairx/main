async def pokemon_autocomplete(interaction: discord.Interaction, current: str):
    """Autocomplete pour les noms de Pokémon"""
    if not current:
        # Retourner les 25 premiers si rien de tapé
        return [app_commands.Choice(name=p, value=p) for p in POKEMON_FR[:25]]
    
    norm_current = normalize_str(current)
    matches = [
        p for p in POKEMON_FR
        if normalize_str(p).startswith(norm_current)
    ]
    # Si pas assez de résultats par début, chercher aussi par inclusion
    if len(matches) < 10:
        extra = [
            p for p in POKEMON_FR
            if norm_current in normalize_str(p) and p not in matches
        ]
        matches += extra
    
    return [app_commands.Choice(name=p, value=p) for p in matches[:25]]


