# Modal pour les informations finales (avec le nouveau système)
class ShinyModal(discord.ui.Modal):
    def __init__(self, language, game_key, method_key, hunt_type="emulators"):
        self.language = language
        self.game_key = game_key
        self.method_key = method_key
        self.hunt_type = hunt_type
        
        title = "Informations du Shiny" if language == "Français" else "Shiny Information"
        super().__init__(title=title)
        
        # Champ Pokémon
        pokemon_label = "Nom du Pokémon" if language == "Français" else "Pokémon Name"
        pokemon_placeholder = "Ex: Pikachu" if language == "Français" else "Ex: Pikachu"
        self.pokemon = discord.ui.TextInput(
            label=pokemon_label,
            placeholder=pokemon_placeholder,
            required=True,
            max_length=50
        )
        self.add_item(self.pokemon)

        # Champ Nombre de consoles/émulateurs
        console_label = "Combien de consoles / émulateurs ?" if language == "Français" else "How many consoles/emulators?"
        console_placeholder = "Entrez un nombre (1-20)" if language == "Français" else "Enter a number (1-20)"
        self.console_count = discord.ui.TextInput(
            label=console_label,
            placeholder=console_placeholder,
            required=True,
            max_length=2,
            default="1"
        )
        self.add_item(self.console_count)

        # Champ Compteur de shasse
        counter_label = "Compteur de la shasse (rencontres/resets)" if language == "Français" else "Hunt counter (encounters/resets)"
        counter_placeholder = "Ex: 1234 (optionnel)" if language == "Français" else "Ex: 1234 (optional)"
        self.hunt_counter = discord.ui.TextInput(
            label=counter_label,
            placeholder=counter_placeholder,
            required=False,
            max_length=10,
            default="0"
        )
        self.add_item(self.hunt_counter)
    
    async def on_submit(self, interaction: discord.Interaction):
        async def _process_submission(**kwargs):
            await interaction.response.defer()

            date_obj = datetime.now()
            date_formatted = date_obj.strftime("%d-%m-%Y")

            # Récupérer et valider le nombre de consoles
            try:
                console_count = int(self.console_count.value)
                if console_count < 1:
                    console_count = 1
            except ValueError:
                console_count = 1

            # Récupérer le compteur de shasse
            try:
                hunt_counter = int(self.hunt_counter.value) if self.hunt_counter.value else 0
            except ValueError:
                hunt_counter = 0

            points = calculate_points(self.game_key, self.method_key, console_count, self.hunt_type)
            game_name = GAMES[self.game_key]["fr" if self.language == "Français" else "en"]

            # Récupérer le nom de la méthode dans la langue choisie
            lang_code = "fr" if self.language == "Français" else "en"
            method_name = METHODS_BY_GAME[self.game_key][self.method_key][lang_code]

            # Validations spécifiques pour Z-A
            if self.game_key == "za":
                # Vérifier si c'est un doublon pendant la saison
                if check_duplicate_shiny_za(str(interaction.user.id), self.pokemon.value):
                    error_msg = "❌ Ce shiny est déjà enregistré pour Z-A (toutes méthodes) et ne compte pas." if self.language == "Français" else "❌ This shiny is already recorded for Z-A (all methods) and doesn't count."
                    await interaction.followup.send(error_msg, ephemeral=True)
                    return None

            # Récupérer le rang AVANT l'ajout du shiny
            old_rank, old_points = get_user_rank(str(interaction.user.id))
            
            # Ajouter le shiny (avec vérification du wanted)
            total_points, bonus_points, is_wanted, objective_bonuses, special_bonuses = add_shiny(str(interaction.user.id), self.pokemon.value, game_name, self.method_key, date_formatted, points, lang_code, console_count, hunt_counter, self.hunt_type)
            
            # Vérifier toutes les races 1v1 actives pour ce Pokémon (multi-adversaires inclus)
            race_bonus_points = 0
            race_won = False
            race_malus_total = 0
            all_races = get_all_active_races_for_user_and_pokemon(str(interaction.user.id), self.pokemon.value)
            for race_info in all_races:
                mark_race_won(race_info['id'], str(interaction.user.id))
                # mark_race_won insère déjà le malus au perdant
                race_bonus_points += race_info['bonus_points']
                race_won = True
                cursor.execute(
                    "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter, hunt_type) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?, ?, ?, ?)",
                    (str(interaction.user.id), f"[Race Bonus] {self.pokemon.value}", game_name, "race_bonus", date_formatted, race_info['bonus_points'], lang_code, 1, 0, self.hunt_type)
                )
                conn.commit()
            if race_won:
                try:
                    update_race_win_objective(str(interaction.user.id))
                    update_monthly_race_win_objective(str(interaction.user.id))
                except Exception as e:
                    logger.error(f"Erreur objectif race_win: {e}")

            # Vérifier si une race en équipe est en cours pour ce Pokémon
            team_race_bonus = 0
            team_race_msg = None
            try:
                guild = bot.get_guild(GUILD_ID)
                team_race_bonus, team_race_msg = await handle_team_race_point(str(interaction.user.id), self.pokemon.value, guild)
                if team_race_msg:
                    channel = bot.get_channel(SALON_CLASSEMENT_ID)
                    if channel:
                        await channel.send(team_race_msg)
                # Si la race équipe est gagnée, mettre à jour objectif race_win
                if team_race_bonus > 0:
                    try:
                        update_race_win_objective(str(interaction.user.id))
                    except Exception as e:
                        logger.error(f"Erreur objectif race_win équipe: {e}")
            except Exception as e:
                logger.error(f"Erreur handle_team_race_point: {e}")
            
            # Calculer le nom affiché (masqué si wanted mystère)
            cursor.execute("""
                SELECT id FROM shiny_wanted
                WHERE is_active=1 AND LOWER(pokemon_name)=LOWER(?)
                AND indice IS NOT NULL AND indice != ''
            """, (self.pokemon.value,))
            _myst_row = cursor.fetchone()
            if _myst_row:
                cursor.execute("SELECT indice FROM shiny_wanted WHERE id=?", (_myst_row[0],))
                _myst_ind = cursor.fetchone()
                _is_mystery = _myst_ind and _myst_ind[0] and not _myst_ind[0].strip().startswith("[Méthode :")
            else:
                _is_mystery = False
            _display_pokemon = "???" if _is_mystery else self.pokemon.value

            # Vérifier si le rang a changé
            rank_change_data = check_rank_change(str(interaction.user.id), old_rank, old_points)
            if rank_change_data:
                # Envoyer le message de félicitations en arrière-plan
                lang_code_for_msg = lang_code if lang_code else "fr"
                asyncio.create_task(send_rank_up_message(
                    interaction.user, 
                    rank_change_data, 
                    _display_pokemon, 
                    points, 
                    lang_code_for_msg
                ))
            
            member = interaction.user
            color = member.color if hasattr(member, "color") and member.color.value else discord.Color.gold()
            
            title = "✨ Nouveau Shiny Ajouté ! ✨" if self.language == "Français" else "✨ New Shiny Added! ✨"
            congrats = f"Félicitations {member.mention} !" if self.language == "Français" else f"Congratulations {member.mention}!"
            
            embed = discord.Embed(
                title=title,
                description=congrats,
                color=color,
                timestamp=date_obj
            )
            embed.set_author(name=member.display_name, icon_url=member.display_avatar.url)
            embed.set_thumbnail(url=member.display_avatar.url)
            
            pokemon_field = "Pokémon" if self.language == "Français" else "Pokémon"
            game_field = "Jeu" if self.language == "Français" else "Game"
            method_field = "Méthode" if self.language == "Français" else "Method"
            date_field = "Date" if self.language == "Français" else "Date"
            points_field = "Points obtenus" if self.language == "Français" else "Points earned"
            
            embed.add_field(name=pokemon_field, value=_display_pokemon, inline=True)
            embed.add_field(name=game_field, value=game_name, inline=True)
            embed.add_field(name=method_field, value=method_name, inline=True)
            embed.add_field(name=date_field, value=date_formatted, inline=True)
            
            # Afficher les points avec bonus et multiplicateurs
            _pos_mult = getattr(add_shiny, '_last_pos_mult', 1.0)
            _raw_pts  = getattr(add_shiny, '_last_raw_pts', points)
            _cap_raw  = getattr(add_shiny, '_last_cap_raw_pts', _raw_pts)
            _weekly   = get_user_weekly_pts(str(interaction.user.id))

            points_lines = [f"{points} ⭐ (base)"]
            if is_wanted and bonus_points > 0:
                points_lines.append(f"+ {bonus_points} 🎯 (Wanted)")
            if race_won and race_bonus_points > 0:
                points_lines.append(f"+ {race_bonus_points} 🏁 (Race)")

            total_display_points = total_points + race_bonus_points

            # Infos multiplicateurs
            mult_lines = []
            if _pos_mult != 1.0:
                if _pos_mult > 1.0:
                    mult_lines.append(f"📈 Comeback ×{_pos_mult:.2f}")
                else:
                    mult_lines.append(f"📉 Top 3 ×{_pos_mult:.2f}")
            if _weekly > WEEKLY_CAP:
                # Calculer l'efficacité marginale actuelle
                _eff_now  = _weekly_soft_cap(_weekly)
                _eff_next = _weekly_soft_cap(_weekly + 10)
                _marginal = round((_eff_next - _eff_now) / 10 * 100)
                mult_lines.append(f"📉 Soft cap hebdo actif (~{_marginal}% d'efficacité)")

            if len(points_lines) > 1:
                points_value = " + ".join(points_lines) + f" = **{total_display_points} ⭐**"
            else:
                points_value = f"**{total_display_points} ⭐**"
            if mult_lines:
                points_value += "\n" + " | ".join(mult_lines)
            points_value += f"\n📊 Semaine : **{min(_weekly, WEEKLY_CAP):.0f}/{WEEKLY_CAP:.0f} pts** cap"
            _excluded = max(0.0, round(_raw_pts - _cap_raw, 2))
            points_value += (
                f"\n🧮 Compte pour cap : **{_cap_raw:.2f}** | "
                f"Hors cap : **{_excluded:.2f}**"
            )
            
            embed.add_field(name=points_field, value=points_value, inline=True)
            
            # Messages spéciaux
            if is_wanted and bonus_points > 0:
                wanted_msg = f"🎯 **BONUS WANTED !** Vous avez trouvé le Pokémon recherché ! +{bonus_points} points bonus !" if self.language == "Français" else f"🎯 **WANTED BONUS !** You found the wanted Pokémon! +{bonus_points} bonus points!"
                embed.add_field(name="🎯 Bonus Wanted", value=wanted_msg, inline=False)
            
            if race_won and race_bonus_points > 0:
                nb_races = len(all_races)
                race_msg = (f"🏁 **{'RACE GAGNÉE' if nb_races == 1 else str(nb_races) + ' RACES GAGNÉES'} !** +{race_bonus_points} pts bonus !\n💔 Vos adversaires ont chacun perdu leurs points misés (min 0).")
                embed.add_field(name="🏁 Race Shiny", value=race_msg, inline=False)

            if team_race_msg:
                embed.add_field(name="⚔️ Race en Équipe", value=team_race_msg[:1024], inline=False)

            if objective_bonuses:
                obj_lines = "\n".join(f"✅ **{desc}** → +{pts} pts !" for desc, pts in objective_bonuses)
                embed.add_field(name="📅 Objectif(s) complété(s) !", value=obj_lines, inline=False)

            if special_bonuses:
                sp_lines = "\n".join(f"🎁 **{label}** → +{pts} pts !" for label, pts in special_bonuses)
                embed.add_field(name="🎁 Bonus spéciaux !", value=sp_lines, inline=False)

            # Infos événement actif
            _ev_mult = getattr(add_shiny, '_last_event_mult', 1.0)
            _ev_desc = getattr(add_shiny, '_last_event_desc', None)
            if _ev_mult != 1.0 and _ev_desc:
                embed.add_field(
                    name=f"🎉 Événement actif × {_ev_mult}",
                    value=f"*{_ev_desc}*",
                    inline=False
                )

            if console_count > 1:
                console_field = "Consoles/Émulateurs" if self.language == "Français" else "Consoles/Emulators"
                embed.add_field(name=console_field, value=f"{console_count}", inline=True)

            if hunt_counter > 0:
                counter_field = "Compteur" if self.language == "Français" else "Counter"
                embed.add_field(name=counter_field, value=f"{hunt_counter}", inline=True)
            
            footer_text = "ShinyBot - Merci à toi bgette/bg !" if self.language == "Français" else "ShinyBot - Thank you!"
            embed.set_footer(text=footer_text)

            # Construire la vue de suivi multi-ajout
            shiny_count = getattr(self, '_shiny_count', 1)
            follow_view = MultiShinyFollowUpView(
                language=self.language,
                hunt_type=self.hunt_type,
                shiny_count=shiny_count
            )

            await interaction.followup.send(embed=embed, view=follow_view)
            
            # Programmer la mise à jour du classement avec un délai équilibré
            async def delayed_update():
                await asyncio.sleep(3)
                await update_classement_message()
            asyncio.create_task(delayed_update())
            return True
        
        result = await discord_retry_wrapper(
            _process_submission,
            context="Shiny Modal Submit"
        )
        
        if result is None:
            error_msg = f"❌ Une erreur s'est produite lors de l'ajout du shiny. Veuillez réessayer." if self.language == "Français" else f"❌ An error occurred while adding the shiny. Please try again."
            try:
                if interaction.response.is_done():
                    await interaction.followup.send(error_msg, ephemeral=True)
                else:
                    await interaction.response.send_message(error_msg, ephemeral=True)
            except:
                logger.error("Impossible d'envoyer le message d'erreur à l'utilisateur")

# Vues Admin corrigées de la même manière
class AdminShinyAddView(discord.ui.View):
    def __init__(self, target_member):
        super().__init__(timeout=300)
        self.target_member = target_member
        
    @discord.ui.select(
        placeholder="Choisissez la langue / Choose language",
        options=[
            discord.SelectOption(label="Français", value="Français", emoji="🇫🇷"),
            discord.SelectOption(label="English", value="English", emoji="🇬🇧")
        ]
    )
    async def language_select(self, interaction: discord.Interaction, select: discord.ui.Select):
        async def _respond(**kwargs):
            language = select.values[0]

            embed = discord.Embed(
                title="🛡️ Admin - Ajout de Shiny" if language == "Français" else "🛡️ Admin - Add Shiny",
                description=f"**Membre / Member:** {self.target_member.mention}\n**Langue / Language:** {language}\n\n{'Choisissez le type :' if language == 'Français' else 'Choose the type:'}",
                color=discord.Color.green()
            )

            new_view = AdminHuntTypeSelectView(language, self.target_member)
            await interaction.response.edit_message(embed=embed, view=new_view)

        await discord_retry_wrapper(_respond, context="Admin Language Select")

