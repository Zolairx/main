        except:
            pass


class ShinyPointsView(discord.ui.View):
    """Barème des points : un menu déroulant pour choisir un jeu plutôt qu'un
    embed unique listant les 20 jeux et leurs ~86 méthodes d'un coup.

    - Vue "publique" (personal=False) : postée par /shiny_points, persistante
      (timeout=None, custom_id fixe) pour rester active indéfiniment, même après
      un redémarrage du bot. Elle n'est JAMAIS éditée au clic : chaque sélection
      ouvre une réponse éphémère (visible uniquement par l'utilisateur qui clique),
      pour que le message partagé reste identique pour tout le monde.
    - Vue "personnelle" (personal=True) : celle envoyée dans cette réponse éphémère.
      Elle peut s'éditer elle-même sans impact sur personne d'autre, puisqu'elle
      n'est visible que par son propriétaire.
    """
    def __init__(self, personal: bool = False):
        # Vue publique persistante : pas de timeout, custom_id fixe requis par discord.py.
        # Vue éphémère personnelle : un timeout classique suffit (elle n'appartient qu'à un utilisateur).
        super().__init__(timeout=None if not personal else 600)
        self.personal = personal
        game_options = [
            discord.SelectOption(label=translations["fr"][:100], value=game_key)
            for game_key, translations in GAMES.items()
        ]
        select = discord.ui.Select(
            placeholder="🎮 Choisir un jeu",
            options=game_options[:25],
            custom_id="shiny_points_game_select_personal" if personal else "shiny_points_game_select_public"
        )
        select.callback = self.game_selected
        self.add_item(select)

    @staticmethod
    def _fmt_pts(pts):
        pts = float(pts)
        s = f"{pts:.2f}".rstrip('0').rstrip('.') if pts % 1 != 0 else f"{int(pts)}"
        return s.replace('.', ',')

    @staticmethod
    def _build_embed(game_key: str) -> discord.Embed:
        game_name = GAMES.get(game_key, {}).get('fr', game_key)
        methods = METHODS_BY_GAME.get(game_key, {})
        sorted_methods = sorted(methods.items(), key=lambda kv: kv[1]['points'], reverse=True)
        lines = [f"**{data['fr']}** — {ShinyPointsView._fmt_pts(data['points'])} pts" for _, data in sorted_methods]
        embed = discord.Embed(
            title=f"📊 Barème — {game_name}",
            description="\n".join(lines) if lines else "Aucune méthode définie pour ce jeu.",
            color=discord.Color.gold()
        )
        embed.set_footer(text="ShinyBot • Choisis un autre jeu dans le menu ci-dessous (visible par toi uniquement)")
        return embed

    async def game_selected(self, interaction: discord.Interaction):
        async def _respond(**kwargs):
            game_key = interaction.data['values'][0]
            embed = self._build_embed(game_key)
            if self.personal:
                # Déjà dans la réponse privée de l'utilisateur : on peut éditer sans
                # affecter qui que ce soit d'autre.
                await interaction.response.edit_message(embed=embed, view=self)
            else:
                # Message public partagé : on NE le modifie JAMAIS. On ouvre une
                # réponse éphémère propre à cet utilisateur avec sa propre vue.
                await interaction.response.send_message(
                    embed=embed, view=ShinyPointsView(personal=True), ephemeral=True
                )
        await discord_retry_wrapper(_respond, context="Shiny Points Game Select")

