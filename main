# ── /profil ──────────────────────────────────────────────────
@bot.tree.command(
    name="profil",
    description="Voir votre profil complet (rang, shinys, objectifs, races, historique)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(membre="Membre dont vous voulez voir le profil (optionnel)")
async def profil(interaction: discord.Interaction, membre: discord.Member = None):
    await interaction.response.defer(ephemeral=True)
    target = membre if membre else interaction.user
    await _send_profil(interaction, target, page="general")


async def _send_profil(interaction, target, page="general"):
    """Construit et envoie le profil avec vue à onglets."""

    def rank_color(rank):
        if rank == 1:   return discord.Color.gold()
        if rank == 2:   return discord.Color.light_grey()
        if rank == 3:   return discord.Color.from_rgb(205, 127, 50)
        if rank and rank <= 8:  return discord.Color.purple()
        if rank and rank <= 14: return discord.Color.blue()
        return discord.Color.green()

    def build_embed(page):
        user_id = str(target.id)
        rank, total_points = get_user_rank(user_id)
        stats = get_user_stats(user_id)
        rank_title = get_rank_title(rank) if rank else "🌟 Non classé"
        pts_str = f"{total_points:.1f}" if total_points and total_points % 1 != 0 else f"{int(total_points or 0)}"
        color = rank_color(rank)

        embed = discord.Embed(color=color, timestamp=datetime.now())
        embed.set_author(name=target.display_name, icon_url=target.display_avatar.url)
        embed.set_thumbnail(url=target.display_avatar.url)

        if page == "general":
            embed.title = f"✨ Profil — {target.display_name}"
            embed.add_field(
                name="🏆 Classement",
                value=f"**#{rank if rank else 'N/A'}** — {rank_title}\n⭐ **{pts_str} pts**",
                inline=True
            )
            _prog = get_progression_tier(total_points)
            if _prog['next_name']:
                _prog_bar = render_progress_bar(_prog['ratio'])
                _prog_value = (
                    f"{_prog['emoji']} **{_prog['name']}**\n"
                    f"{_prog_bar} ({_prog['points_to_next']:.0f} pts avant {_prog['next_emoji']} {_prog['next_name']})"
                )
            else:
                _prog_value = f"{_prog['emoji']} **{_prog['name']}** — rang maximum atteint ! 👑"
            embed.add_field(
                name="📈 Progression personnelle",
                value=_prog_value,
                inline=True
            )
            embed.add_field(
                name="✨ Shinys",
                value=f"**Total :** {stats['total_shinys']}\n📅 Semaine : {stats['week_count']}\n📆 Mois : {stats['month_count']}",
                inline=True
            )
            streak_emoji = "🔥" if stats['current_streak'] > 0 else "💤"
            embed.add_field(
                name="⚡ Streak",
                value=f"{streak_emoji} Actuel : **{stats['current_streak']}j** · Record : **{stats['best_streak']}j**",
                inline=True
            )
            cursor.execute("SELECT COUNT(*) FROM shiny_wanted_claimed WHERE user_id=?", (user_id,))
            wanted_count = cursor.fetchone()[0] or 0
            guilde = guilde_of_user(user_id)
            embed.add_field(
                name="🎯 Succès",
                value=f"Wanteds trouvés : **{wanted_count}**\nGuilde : {guilde[4]+' **'+guilde[1]+'**' if guilde else '*Aucune*'}",
                inline=True
            )
            # Dernier shiny
            cursor.execute("""
                SELECT pokemon, game, methode, date FROM shiny
                WHERE user_id=? AND methode NOT IN ('race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
                    'weekly_objective','monthly_objective','season_carryover','admin_adjustment')
                ORDER BY created_at DESC LIMIT 1
            """, (user_id,))
            last = cursor.fetchone()
            if last:
                embed.add_field(
                    name="🌟 Dernier Shiny",
                    value=f"**{last[0]}** — {last[1]}\n`{last[3]}`",
                    inline=True
                )
            # Objectifs semaine
            week_start = get_current_week_start()
            cursor.execute("""
                SELECT wo.description, wo.target_value, wop.current_value, COALESCE(wop.completed,0)
                FROM weekly_objectives wo
                LEFT JOIN weekly_objectives_progress wop ON wo.id=wop.objective_id AND wop.user_id=?
                WHERE wo.week_start=? AND wo.is_active=1 LIMIT 3
            """, (user_id, week_start))
            obj_rows = cursor.fetchall()
            if obj_rows:
                lines = []
                for desc, tgt, cur, done in obj_rows:
                    cur = cur or 0
                    status = "✅" if done else f"⏳ {int(cur)}/{int(tgt)}"
                    lines.append(f"{status} {desc[:40]}")
                embed.add_field(name="📅 Objectifs semaine", value="\n".join(lines), inline=False)

        elif page == "ranked":
            embed.title = f"📊 Stats Ranked — {target.display_name}"
            weekly_pts = get_user_weekly_pts(user_id)
            pos_mult = get_position_multiplier(user_id)
            eff_now = _weekly_soft_cap(weekly_pts)
            marginal = round((_weekly_soft_cap(weekly_pts + 10) - eff_now) / 10 * 100)
            pos_label = ("×0.9 (Top 3)" if pos_mult < 1 else
                         "×1.1 (Rang 4-10)" if pos_mult == 1.1 else
                         "×1.25 (Comeback)")
            rank_title_for_pos = get_rank_title_for_position(rank) if rank else "Non classé"
            embed.add_field(
                name="🏆 Classement",
                value=f"Rang : **#{rank if rank else '-'}** — {rank_title_for_pos}\nPoints total : **{pts_str}**",
                inline=False
            )
            embed.add_field(
                name="⚖️ Soft cap hebdo",
                value=(
                    f"Points bruts semaine : **{weekly_pts:.1f}/{WEEKLY_CAP:.0f}**\n"
                    f"Points effectifs capés : **{eff_now:.1f}**\n"
                    f"Efficacité marginale : **~{marginal}%**\n"
                    f"Multiplicateur position : **{pos_label}**"
                ),
                inline=False
            )
            embed.add_field(
                name="✨ Activité",
                value=(
                    f"Shinys total : **{stats['total_shinys']}** · Semaine : **{stats['week_count']}** · Mois : **{stats['month_count']}**\n"
                    f"Streak actuel : **{stats['current_streak']}j** (best : {stats['best_streak']}j)"
                ),
                inline=False
            )
            # Missions variété semaine
            week_start = get_current_week_start()
            claimed = sum(1 for m in WEEKLY_VARIETY_MISSIONS if is_variety_mission_claimed(user_id, week_start, m[0]))
            total_m = len(WEEKLY_VARIETY_MISSIONS)
            pts_missions = sum(m[3] for m in WEEKLY_VARIETY_MISSIONS if is_variety_mission_claimed(user_id, week_start, m[0]))
            embed.add_field(
                name="🎲 Missions variété",
                value=f"**{claimed}/{total_m}** complétées · **+{pts_missions:.0f} pts** récupérés",
                inline=True
            )

        elif page == "streaks":
            embed.title = f"⚡ Streaks & Compteurs — {target.display_name}"
            streak = get_user_streak(user_id)
            embed.add_field(
                name="🔥 Streak quotidien",
                value=(
                    f"Actuel : **{stats['current_streak']} jour{'s' if stats['current_streak'] > 1 else ''}**\n"
                    f"🏆 Record : **{stats['best_streak']} jour{'s' if stats['best_streak'] > 1 else ''}**\n"
                    f"Total jours actifs : **{streak.get('total_active_days', 0)}**"
                ),
                inline=True
            )
            embed.add_field(
                name="✨ Compteurs Shinys",
                value=(
                    f"📊 Total saison : **{stats['total_shinys']}**\n"
                    f"📅 Cette semaine : **{stats['week_count']}**\n"
                    f"📆 Ce mois : **{stats['month_count']}**\n"
                    f"🗓️ Aujourd'hui : **{stats['today_count']}**"
                ),
                inline=True
            )
            # Pokémon et méthode favoris
            embed.add_field(
                name="⭐ Préférences",
                value=(
                    f"Pokémon favori : **{stats['favorite_pokemon'] or 'N/A'}**\n"
                    f"Méthode favorite : **{stats['favorite_method'] or 'N/A'}**\n"
                    f"Jeu favori : **{stats.get('favorite_game', 'N/A') or 'N/A'}**"
                ),
                inline=False
            )
            # Chasse les plus longues
            cursor.execute("""
                SELECT pokemon, game, hunt_counter FROM shiny
                WHERE user_id=? AND hunt_counter > 0
                ORDER BY hunt_counter DESC LIMIT 3
            """, (user_id,))
            top_hunts = cursor.fetchall()
            if top_hunts:
                lines = [f"**{p}** ({g}) — {hc:,} rencontres" for p, g, hc in top_hunts]
                embed.add_field(name="🔝 Chasses les plus longues", value="\n".join(lines), inline=False)

        elif page == "races":
            embed.title = f"🏁 Races — {target.display_name}"
            race_stats = get_race_stats(user_id)
            total_races = race_stats['total']
            wins = race_stats['wins']
            losses = max(total_races - wins, 0)
            winrate = f"{wins/total_races*100:.0f}%" if total_races > 0 else "N/A"
            embed.add_field(
                name="📊 Bilan Général",
                value=(
                    f"✅ Victoires : **{wins}** · ❌ Défaites : **{losses}**\n"
                    f"📊 Winrate : **{winrate}**\n"
                    f"🔥 Races actives : **{race_stats['active']}**"
                ),
                inline=False
            )
            # Races récentes
            cursor.execute("""
                SELECT r.pokemon_name, r.winner_id, r.created_at
                FROM shiny_races r
                WHERE r.challenger_id=? OR r.opponent_id=?
                ORDER BY r.created_at DESC LIMIT 5
            """, (user_id, user_id))
            recent_races = cursor.fetchall()
            if recent_races:
                lines = []
                for poke, winner, created in recent_races:
                    result = "✅ Victoire" if winner == user_id else ("❌ Défaite" if winner else "⏳ En cours")
                    lines.append(f"{result} — **{poke}** · {created[:10]}")
                embed.add_field(name="🕹️ Dernières Races", value="\n".join(lines), inline=False)
            # Races d'équipe
            cursor.execute("""
                SELECT COUNT(*) FROM team_races tr
                JOIN team_race_members trm ON tr.id=trm.race_id
                WHERE trm.user_id=? AND tr.status='completed'
            """, (user_id,))
            team_count = cursor.fetchone()[0] or 0
            if team_count:
                embed.add_field(name="👥 Races en équipe", value=f"Participations terminées : **{team_count}**", inline=True)

        elif page == "historique":
            embed.title = f"📜 Historique Saisons — {target.display_name}"
            cursor.execute("""
                SELECT sa.season_number, sa.season_name, sa.rank, sa.total_points, sm.total_players
                FROM season_archives sa
                JOIN season_meta sm ON sa.season_number = sm.season_number
                WHERE sa.user_id=? ORDER BY sa.season_number DESC LIMIT 8
            """, (user_id,))
            seasons = cursor.fetchall()
            if seasons:
                for snum, sname, srank, spts, splayers in seasons:
                    spts_str = f"{spts:.1f}" if spts % 1 != 0 else f"{int(spts)}"
                    top_pct = f"{srank/splayers*100:.0f}%" if splayers else "N/A"
                    embed.add_field(
                        name=f"📅 {sname or f'Saison {snum}'}",
                        value=f"#{srank}/{splayers} — **{spts_str} pts** *(top {top_pct})*",
                        inline=True
                    )
            else:
                embed.description = "Aucun historique de saison trouvé."

        embed.set_footer(text="ShinyBot · Profil interactif")
        return embed

    class ProfilView(discord.ui.View):
        def __init__(self, target, page="general", viewer_id=None):
            super().__init__(timeout=300)
            self.target = target
            self.page = page
            self.viewer_id = viewer_id

        async def interaction_check(self, inter: discord.Interaction) -> bool:
            if self.viewer_id and inter.user.id != self.viewer_id:
                await inter.response.send_message("❌ Ce profil n'est pas le tien.", ephemeral=True)
                return False
            return True

        async def _go(self, inter, p):
            self.page = p
            await inter.response.edit_message(embed=build_embed(p), view=self)

        @discord.ui.button(label="🌟 Général",    style=discord.ButtonStyle.primary,   row=0, custom_id="p_general")
        async def btn_general(self, inter, btn): await self._go(inter, "general")

        @discord.ui.button(label="📊 Ranked",    style=discord.ButtonStyle.secondary,  row=0, custom_id="p_ranked")
        async def btn_ranked(self, inter, btn): await self._go(inter, "ranked")

        @discord.ui.button(label="⚡ Streaks",   style=discord.ButtonStyle.secondary,  row=0, custom_id="p_streaks")
        async def btn_streaks(self, inter, btn): await self._go(inter, "streaks")

        @discord.ui.button(label="🏁 Races",     style=discord.ButtonStyle.secondary,  row=1, custom_id="p_races")
        async def btn_races(self, inter, btn): await self._go(inter, "races")

        @discord.ui.button(label="📜 Historique", style=discord.ButtonStyle.secondary, row=1, custom_id="p_historique")
        async def btn_historique(self, inter, btn): await self._go(inter, "historique")

    viewer_id = interaction.user.id
    embed = build_embed(page)
    view = ProfilView(target, page, viewer_id)
    if interaction.response.is_done():
        await interaction.followup.send(embed=embed, view=view, ephemeral=True)
    else:
        await interaction.followup.send(embed=embed, view=view, ephemeral=True)


# ── /shiny_delete_precise — Admin supprime un shiny précis ──────────
@bot.tree.command(
    name="shiny_delete_precise",
    description="[ADMIN] Supprimer un shiny précis d'un membre",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(membre="Membre dont on veut supprimer un shiny")
async def shiny_delete_precise(interaction: discord.Interaction, membre: discord.Member):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)

    user_id = str(membre.id)
    cursor.execute("""
        SELECT rowid, pokemon, game, methode, date, points FROM shiny
        WHERE user_id=? AND methode NOT IN ('race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration','weekly_objective','monthly_objective')
        ORDER BY created_at DESC LIMIT 20
    """, (user_id,))
    rows = cursor.fetchall()

    if not rows:
        await interaction.followup.send(f"❌ {membre.display_name} n'a aucun shiny enregistré.", ephemeral=True)
        return

    options = []
    for row in rows:
        rid, poke, game, method, date, pts = row
        pts_str = f"{pts:.1f}" if pts and pts % 1 != 0 else f"{int(pts or 0)}"
        label = f"{poke} — {date} ({pts_str} pts)"[:100]
        options.append(discord.SelectOption(label=label, value=str(rid)))

    view = ShinyDeletePreciseView(membre, options)
    embed = discord.Embed(
        title=f"🗑️ Supprimer un shiny de {membre.display_name}",
        description="Sélectionnez le shiny à supprimer (20 derniers affichés) :",
        color=discord.Color.red()
    )
    await interaction.followup.send(embed=embed, view=view, ephemeral=True)


class ShinyDeletePreciseView(discord.ui.View):
    def __init__(self, membre, options):
        super().__init__(timeout=120)
        self.membre = membre
        sel = discord.ui.Select(
            placeholder="Choisir le shiny à supprimer",
            options=options,
            min_values=1, max_values=1
        )
        sel.callback = self.shiny_selected
        self.add_item(sel)

    async def shiny_selected(self, interaction: discord.Interaction):
        rowid = int(interaction.data['values'][0])
        cursor.execute("SELECT pokemon, game, date, points FROM shiny WHERE rowid=?", (rowid,))
        row = cursor.fetchone()
        if not row:
            await interaction.response.send_message("❌ Shiny introuvable.", ephemeral=True)
            return

        poke, game, date, pts = row
        view = ShinyDeleteConfirmView(rowid, poke, game, date, pts, self.membre)
        pts_str = f"{pts:.1f}" if pts and pts % 1 != 0 else f"{int(pts or 0)}"
        await interaction.response.edit_message(
            embed=discord.Embed(
                title="⚠️ Confirmer la suppression",
                description=f"Supprimer **{poke}** ({game}) du {date} — **{pts_str} pts** de {self.membre.display_name} ?",
                color=discord.Color.orange()
            ),
            view=view
        )


class ShinyDeleteConfirmView(discord.ui.View):
    def __init__(self, rowid, poke, game, date, pts, membre):
        super().__init__(timeout=60)
        self.rowid = rowid
        self.poke = poke
        self.membre = membre

    @discord.ui.button(label="🗑️ Supprimer", style=discord.ButtonStyle.danger)
    async def confirm(self, interaction: discord.Interaction, button: discord.ui.Button):
        cursor.execute("DELETE FROM shiny WHERE rowid=?", (self.rowid,))
        conn.commit()
        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(
            embed=discord.Embed(
                title="✅ Shiny supprimé",
                description=f"**{self.poke}** a été supprimé de la collection de {self.membre.display_name}.",
                color=discord.Color.green()
            ),
            view=self
        )
        async def delayed():
            await asyncio.sleep(2)
            await update_classement_message()
        asyncio.create_task(delayed())

    @discord.ui.button(label="❌ Annuler", style=discord.ButtonStyle.secondary)
    async def cancel(self, interaction: discord.Interaction, button: discord.ui.Button):
        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(
            content="Suppression annulée.", embed=None, view=self
        )


# ── /shiny_edit — Joueur modifie son propre shiny ───────────────────
@bot.tree.command(
    name="shiny_edit",
    description="Modifier un de vos shinys (Pokémon, jeu ou méthode)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(nouveau_pokemon="Nouveau nom du Pokémon (autocomplétion disponible, optionnel)")
async def shiny_edit(interaction: discord.Interaction, nouveau_pokemon: str = None):
    await interaction.response.defer(ephemeral=True)
    user_id = str(interaction.user.id)

    cursor.execute("""
        SELECT rowid, pokemon, game, methode, date, points, hunt_counter FROM shiny
        WHERE user_id=? AND methode NOT IN ('race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
            'weekly_objective','monthly_objective','season_carryover','admin_adjustment',
            'participation_bonus','monday_first_bonus','new_player_bonus', 'parrainage_bonus','wanted_bonus')
        ORDER BY created_at DESC LIMIT 20
    """, (user_id,))
    rows = cursor.fetchall()

    if not rows:
        await interaction.followup.send("❌ Vous n'avez aucun shiny enregistré.", ephemeral=True)
        return

    options = []
    for row in rows:
        rid, poke, game, method, date, pts, hunt_counter = row
        pts_str = f"{pts:.1f}" if pts and pts % 1 != 0 else f"{int(pts or 0)}"
        # Label enrichi : Pokémon · Jeu · Méthode — Date (pts)
        game_short = (game or "?")[:20]
        method_short = (method or "?")[:18]
        counter_txt = f" [{hunt_counter:,} rencontres]" if hunt_counter and hunt_counter > 0 else ""
        label = f"{poke} · {game_short} · {method_short}{counter_txt}"[:95]
        description = f"{date} — {pts_str} pts"[:50]
        options.append(discord.SelectOption(label=label, value=str(rid), description=description))

    view = ShinyEditSelectView(options, nouveau_pokemon)
    embed = discord.Embed(
        title="✏️ Modifier un Shiny",
        description=(
            "Sélectionnez le shiny à modifier (20 derniers affichés) :"
            + (f"\n\n🎯 Nouveau Pokémon pré-rempli : **{nouveau_pokemon}**" if nouveau_pokemon else "")
            + "\n\n*Le label affiche : Pokémon · Jeu · Méthode [rencontres] — Date (pts)*"
        ),
        color=discord.Color.blue()
    )
    await interaction.followup.send(embed=embed, view=view, ephemeral=True)

@shiny_edit.autocomplete("nouveau_pokemon")
async def shiny_edit_autocomplete(interaction: discord.Interaction, current: str):
    return await pokemon_autocomplete(interaction, current)


class ShinyEditSelectView(discord.ui.View):
    """Étape 1 : choisir quel shiny modifier."""
    def __init__(self, options, nouveau_pokemon=None):
        super().__init__(timeout=300)
        self.nouveau_pokemon = nouveau_pokemon
        sel = discord.ui.Select(
            placeholder="Choisir le shiny à modifier",
            options=options,
            min_values=1, max_values=1
        )
        sel.callback = self.shiny_selected
        self.add_item(sel)

    async def shiny_selected(self, interaction: discord.Interaction):
        rowid = int(interaction.data['values'][0])
        cursor.execute(
            "SELECT pokemon, game, methode, date, hunt_counter FROM shiny WHERE rowid=? AND user_id=?",
            (rowid, str(interaction.user.id))
        )
        row = cursor.fetchone()
        if not row:
            await interaction.response.send_message("❌ Shiny introuvable.", ephemeral=True)
            return
        poke, game, methode, date, hunt_counter = row
        poke_to_show = self.nouveau_pokemon if self.nouveau_pokemon else poke

        embed = discord.Embed(
            title="✏️ Que voulez-vous modifier ?",
            description=(
                f"**Pokémon :** {poke_to_show}\n"
                f"**Jeu :** {game or '?'}\n"
                f"**Méthode :** {methode or '?'}\n"
                f"**Date :** {date or '?'}\n"
                f"**Rencontres :** {hunt_counter or 0:,}"
            ),
            color=discord.Color.blue()
        )
        view = ShinyEditFieldChoiceView(rowid, poke_to_show, game, methode, date, hunt_counter or 0)
        await interaction.response.edit_message(embed=embed, view=view)


class ShinyEditFieldChoiceView(discord.ui.View):
    """Étape 2 : choisir quel champ modifier via boutons."""
    def __init__(self, rowid, poke, game, methode, date, hunt_counter):
        super().__init__(timeout=300)
        self.rowid = rowid
        self.poke = poke
        self.game = game
        self.methode = methode
        self.date = date
        self.hunt_counter = hunt_counter

    async def _save_and_confirm(self, interaction, field_label, **updates):
        """Applique les changements en base et affiche la confirmation."""
        cursor.execute("SELECT user_id FROM shiny WHERE rowid=?", (self.rowid,))
        row = cursor.fetchone()
        if not row or row[0] != str(interaction.user.id):
            await interaction.response.send_message("❌ Ce shiny ne t'appartient pas.", ephemeral=True)
            return

        set_clauses = ", ".join(f"{k}=?" for k in updates)
        cursor.execute(
            f"UPDATE shiny SET {set_clauses} WHERE rowid=? AND user_id=?",
            (*updates.values(), self.rowid, str(interaction.user.id))
        )
        conn.commit()

        # Relire les valeurs actuelles pour l'embed de confirmation
        cursor.execute("SELECT pokemon, game, methode, date, hunt_counter FROM shiny WHERE rowid=?", (self.rowid,))
        current = cursor.fetchone()
        poke, game, methode, date, hc = current

        embed = discord.Embed(
            title="✅ Shiny mis à jour !",
            description=(
                f"**Pokémon :** {poke}\n"
                f"**Jeu :** {game or '?'}\n"
                f"**Méthode :** {methode or '?'}\n"
                f"**Date :** {date or '?'}\n"
                f"**Rencontres :** {hc or 0:,}"
            ),
            color=discord.Color.green()
        )
        embed.set_footer(text=f"Champ modifié : {field_label}")

        # Mettre à jour l'état interne pour un éventuel second edit
        if 'pokemon' in updates: self.poke = updates['pokemon']
        if 'game' in updates:    self.game = updates['game']
        if 'methode' in updates: self.methode = updates['methode']
        if 'date' in updates:    self.date = updates['date']
        if 'hunt_counter' in updates: self.hunt_counter = updates['hunt_counter']

        for item in self.children:
            item.disabled = False
        await interaction.response.edit_message(embed=embed, view=self)
        asyncio.create_task(update_classement_message())

    # ── Bouton Pokémon ────────────────────────────────────────────────
    @discord.ui.button(label="🐾 Pokémon", style=discord.ButtonStyle.primary, row=0)
    async def edit_pokemon(self, interaction: discord.Interaction, button: discord.ui.Button):
        modal = ShinyEditPokemonModal(self)
        await interaction.response.send_modal(modal)

    # ── Bouton Jeu ────────────────────────────────────────────────────
    @discord.ui.button(label="🎮 Jeu", style=discord.ButtonStyle.secondary, row=0)
    async def edit_game(self, interaction: discord.Interaction, button: discord.ui.Button):
        current_gk = resolve_game_key(self.game)
        options = []
        # Jeu actuel en tête
        if current_gk and current_gk in GAMES:
            name = GAMES[current_gk]['fr']
            options.append(discord.SelectOption(label=f"✅ {name}", value=current_gk, description="Jeu actuel"))
        for gk, tr in GAMES.items():
            if gk == current_gk:
                continue
            options.append(discord.SelectOption(label=tr['fr'], value=gk))

        view = ShinyEditGameSelectView(self, options)
        embed = discord.Embed(
            title="🎮 Choisir le nouveau jeu",
            description=f"Jeu actuel : **{self.game or '?'}**",
            color=discord.Color.blue()
        )
        await interaction.response.edit_message(embed=embed, view=view)

    # ── Bouton Méthode ────────────────────────────────────────────────
    @discord.ui.button(label="⚔️ Méthode", style=discord.ButtonStyle.secondary, row=0)
    async def edit_methode(self, interaction: discord.Interaction, button: discord.ui.Button):
        game_key = resolve_game_key(self.game)
        if not game_key or game_key not in METHODS_BY_GAME:
            await interaction.response.send_message(
                "⚠️ Modifie d'abord le jeu pour pouvoir choisir une méthode.",
                ephemeral=True
            )
            return

        methods = METHODS_BY_GAME[game_key]
        options = []
        for mk, md in list(methods.items())[:25]:
            label = f"{'✅ ' if mk == self.methode else ''}{md['fr']} ({md['points']} pts)"
            desc = md.get('note_fr', '')
            options.append(discord.SelectOption(
                label=label[:100],
                value=mk,
                description=desc[:100] if desc else None
            ))

        view = ShinyEditMethodSelectView(self, options)
        embed = discord.Embed(
            title="⚔️ Choisir la nouvelle méthode",
            description=f"Méthode actuelle : **{self.methode or '?'}** · Jeu : **{self.game or '?'}**",
            color=discord.Color.blue()
        )
        await interaction.response.edit_message(embed=embed, view=view)

    # ── Bouton Date ───────────────────────────────────────────────────
    @discord.ui.button(label="📅 Date", style=discord.ButtonStyle.secondary, row=1)
    async def edit_date(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.send_modal(ShinyEditDateModal(self))

    # ── Bouton Rencontres ─────────────────────────────────────────────
    @discord.ui.button(label="🔢 Rencontres", style=discord.ButtonStyle.secondary, row=1)
    async def edit_counter(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.send_modal(ShinyEditCounterModal(self))


class ShinyEditGameSelectView(discord.ui.View):
    """Select menu pour choisir le nouveau jeu."""
    def __init__(self, parent: ShinyEditFieldChoiceView, options):
        super().__init__(timeout=300)
        self.parent = parent
        sel = discord.ui.Select(placeholder="Choisir le jeu", options=options[:25])
        sel.callback = self.game_selected
        self.add_item(sel)

        btn_back = discord.ui.Button(label="↩️ Retour", style=discord.ButtonStyle.secondary)
        btn_back.callback = self._back
        self.add_item(btn_back)

    async def game_selected(self, interaction: discord.Interaction):
        gk = interaction.data['values'][0]
        game_name = GAMES[gk]['fr']
        await self.parent._save_and_confirm(interaction, "🎮 Jeu", game=game_name)

    async def _back(self, interaction: discord.Interaction):
        embed = discord.Embed(
            title="✏️ Que voulez-vous modifier ?",
            description=(
                f"**Pokémon :** {self.parent.poke}\n"
                f"**Jeu :** {self.parent.game or '?'}\n"
                f"**Méthode :** {self.parent.methode or '?'}\n"
                f"**Date :** {self.parent.date or '?'}\n"
                f"**Rencontres :** {self.parent.hunt_counter or 0:,}"
            ),
            color=discord.Color.blue()
        )
        await interaction.response.edit_message(embed=embed, view=self.parent)


class ShinyEditMethodSelectView(discord.ui.View):
    """Select menu pour choisir la nouvelle méthode."""
    def __init__(self, parent: ShinyEditFieldChoiceView, options):
        super().__init__(timeout=300)
        self.parent = parent
        sel = discord.ui.Select(placeholder="Choisir la méthode", options=options)
        sel.callback = self.method_selected
        self.add_item(sel)

        btn_back = discord.ui.Button(label="↩️ Retour", style=discord.ButtonStyle.secondary)
        btn_back.callback = self._back
        self.add_item(btn_back)

    async def method_selected(self, interaction: discord.Interaction):
        mk = interaction.data['values'][0]
        game_key = resolve_game_key(self.parent.game)
        md = METHODS_BY_GAME[game_key][mk]
        # Recalculer les points selon la nouvelle méthode
        new_pts = md['points']
        await self.parent._save_and_confirm(interaction, "⚔️ Méthode", methode=mk, points=new_pts)

    async def _back(self, interaction: discord.Interaction):
        embed = discord.Embed(
            title="✏️ Que voulez-vous modifier ?",
            description=(
                f"**Pokémon :** {self.parent.poke}\n"
                f"**Jeu :** {self.parent.game or '?'}\n"
                f"**Méthode :** {self.parent.methode or '?'}\n"
                f"**Date :** {self.parent.date or '?'}\n"
                f"**Rencontres :** {self.parent.hunt_counter or 0:,}"
            ),
            color=discord.Color.blue()
        )
        await interaction.response.edit_message(embed=embed, view=self.parent)


class ShinyEditPokemonModal(discord.ui.Modal, title="Modifier le Pokémon"):
    """Modal simple pour modifier uniquement le nom du Pokémon."""
    pokemon_input = discord.ui.TextInput(
        label="Nouveau nom du Pokémon",
        required=True, max_length=50
    )

    def __init__(self, parent: ShinyEditFieldChoiceView):
        super().__init__()
        self.parent = parent
        self.pokemon_input.default = parent.poke

    async def on_submit(self, interaction: discord.Interaction):
        new_poke = self.pokemon_input.value.strip()
        await self.parent._save_and_confirm(interaction, "🐾 Pokémon", pokemon=new_poke)


class ShinyEditDateModal(discord.ui.Modal, title="Modifier la Date"):
    """Modal simple pour modifier uniquement la date."""
    date_input = discord.ui.TextInput(
        label="Nouvelle date (JJ-MM-AAAA)",
        placeholder="Ex: 25-12-2024",
        required=True, max_length=10
    )

    def __init__(self, parent: ShinyEditFieldChoiceView):
        super().__init__()
        self.parent = parent
        self.date_input.default = parent.date or ""

    async def on_submit(self, interaction: discord.Interaction):
        new_date = self.date_input.value.strip()
        await self.parent._save_and_confirm(interaction, "📅 Date", date=new_date)


class ShinyEditCounterModal(discord.ui.Modal, title="Modifier le nombre de rencontres"):
    """Modal simple pour modifier uniquement le compteur de rencontres."""
    counter_input = discord.ui.TextInput(
        label="Nombre de rencontres",
        placeholder="Ex: 5432",
        required=True, max_length=10
    )

    def __init__(self, parent: ShinyEditFieldChoiceView):
        super().__init__()
        self.parent = parent
        self.counter_input.default = str(parent.hunt_counter) if parent.hunt_counter else ""

    async def on_submit(self, interaction: discord.Interaction):
        raw = self.counter_input.value.strip().replace(" ", "").replace(",", "")
        try:
            new_counter = max(0, int(raw))
        except ValueError:
            await interaction.response.send_message(
                "❌ Nombre invalide — entrez un entier (ex: 5432).", ephemeral=True
            )
            return
        await self.parent._save_and_confirm(interaction, "🔢 Rencontres", hunt_counter=new_counter)


# ── Commande raccourci objectif Pokémon avec autocomplete ───────────
@bot.tree.command(
    name="admin_objectif_pokemon",
    description="[ADMIN] Créer rapidement un objectif 'Trouver un Pokémon précis' avec autocomplétion",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    pokemon="Nom du Pokémon à trouver (autocomplétion)",
    mode="Hebdomadaire ou Mensuel",
    destination="Où ajouter l'objectif",
    bonus="Points bonus à attribuer",
    difficulte="Difficulté de l'objectif"
)
@app_commands.choices(
    mode=[
        app_commands.Choice(name="Hebdomadaire", value="weekly"),
        app_commands.Choice(name="Mensuel", value="monthly"),
    ],
    destination=[
        app_commands.Choice(name="Pool réutilisable", value="pool"),
        app_commands.Choice(name="Période en cours", value="current"),
    ],
    difficulte=[
        app_commands.Choice(name="🟢 Facile", value="easy"),
        app_commands.Choice(name="🟡 Moyen", value="medium"),
        app_commands.Choice(name="🔴 Difficile", value="hard"),
    ]
)
async def admin_objectif_pokemon(
    interaction: discord.Interaction,
    pokemon: str,
    mode: str,
    destination: str,
    bonus: float,
    difficulte: str
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    desc = f"Trouver un {pokemon} shiny"
    user_id = str(interaction.user.id)

    if mode == "weekly":
        dest = "pool" if destination == "pool" else "week"
        save_objective("pokemon", desc, 1.0, bonus, difficulte, pokemon, dest, user_id)
        dest_label = "pool hebdomadaire" if dest == "pool" else "semaine en cours"
    else:
        dest = "monthly_pool" if destination == "pool" else "monthly"
        save_monthly_objective("pokemon", desc, 1.0, bonus, difficulte, pokemon, dest, user_id)
        dest_label = "pool mensuel" if dest == "monthly_pool" else "mois en cours"

    await interaction.response.send_message(
        f"✅ Objectif **{desc}** ajouté au **{dest_label}** !\n"
        f"⭐ Bonus : **+{bonus} pts** | Difficulté : **{difficulte}**",
        ephemeral=True
    )

@admin_objectif_pokemon.autocomplete("pokemon")
async def objectif_pokemon_autocomplete(interaction: discord.Interaction, current: str):
    return await pokemon_autocomplete(interaction, current)


# ============================================================
# ====== COMMANDE ADMIN : CORRECTION DONNÉES MEMBRE ==========
# ============================================================

@bot.tree.command(
    name="admin_correct_membre",
    description="[ADMIN] Corriger les données d'un membre (shinys, points, progression objectifs)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(membre="Membre à corriger")
async def admin_correct_membre(interaction: discord.Interaction, membre: discord.Member):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    user_id = str(membre.id)

    # Récupérer les stats de base
    cursor.execute("SELECT COALESCE(SUM(points),0) FROM shiny WHERE user_id=?", (user_id,))
    total_points = cursor.fetchone()[0] or 0

    cursor.execute("""
        SELECT COUNT(*) FROM shiny WHERE user_id=?
        AND methode NOT IN ('race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
                            'weekly_objective','monthly_objective','admin_adjustment')
    """, (user_id,))
    total_shinys = cursor.fetchone()[0]

    # Progression objectifs hebdo en cours
    week_start = get_current_week_start()
    cursor.execute("""
        SELECT wo.id, wo.description, wo.type, wo.target_value, wop.current_value, wop.completed, wop.bonus_awarded
        FROM weekly_objectives wo
        LEFT JOIN weekly_objectives_progress wop ON wo.id=wop.objective_id AND wop.user_id=?
        WHERE wo.week_start=? AND wo.is_active=1
    """, (user_id, week_start))
    weekly_objs = cursor.fetchall()

    # Progression objectifs mensuels en cours
    month_start = get_current_month_start()
    cursor.execute("""
        SELECT mo.id, mo.description, mo.type, mo.target_value, mop.current_value, mop.completed, mop.bonus_awarded
        FROM monthly_objectives mo
        LEFT JOIN monthly_objectives_progress mop ON mo.id=mop.objective_id AND mop.user_id=?
        WHERE mo.month_start=? AND mo.is_active=1
    """, (user_id, month_start))
    monthly_objs = cursor.fetchall()

    pts_str = f"{total_points:.1f}" if total_points % 1 != 0 else str(int(total_points))
    desc_lines = [
        f"👤 **{membre.display_name}**",
        f"✨ Shinys : **{total_shinys}** | ⭐ Points totaux : **{pts_str}**",
        "",
        "Que souhaitez-vous corriger ?"
    ]
    embed = discord.Embed(
        title="🛠️ Admin — Correction membre",
        description="\n".join(desc_lines),
        color=discord.Color.orange()
    )
    embed.set_footer(text="ShinyBot — Correction administrative")

    view = AdminCorrectView(membre, weekly_objs, monthly_objs)
    await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


class AdminCorrectView(discord.ui.View):
    """Menu principal de correction d'un membre."""
    def __init__(self, membre, weekly_objs, monthly_objs):
        super().__init__(timeout=300)
        self.membre = membre
        self.weekly_objs = weekly_objs
        self.monthly_objs = monthly_objs

    @discord.ui.button(label="⭐ Ajuster les points", style=discord.ButtonStyle.primary)
    async def adjust_points(self, interaction: discord.Interaction, button: discord.ui.Button):
        modal = AdminCorrectPointsModal(self.membre)
        await interaction.response.send_modal(modal)

    @discord.ui.button(label="✨ Corriger nb shinys", style=discord.ButtonStyle.secondary)
    async def correct_shinys(self, interaction: discord.Interaction, button: discord.ui.Button):
        modal = AdminCorrectShinysModal(self.membre)
        await interaction.response.send_modal(modal)

    @discord.ui.button(label="📅 Progressions hebdo", style=discord.ButtonStyle.secondary)
    async def correct_weekly(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not self.weekly_objs:
            await interaction.response.send_message("❌ Aucun objectif hebdomadaire actif cette semaine.", ephemeral=True)
            return
        view = AdminCorrectObjectiveSelectView(self.membre, self.weekly_objs, mode="weekly")
        embed = discord.Embed(
            title="📅 Corriger objectifs hebdomadaires",
            description=f"Choisissez l'objectif à corriger pour **{self.membre.display_name}** :",
            color=discord.Color.gold()
        )
        await interaction.response.edit_message(embed=embed, view=view)

    @discord.ui.button(label="📆 Progressions mensuelles", style=discord.ButtonStyle.secondary)
    async def correct_monthly(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not self.monthly_objs:
            await interaction.response.send_message("❌ Aucun objectif mensuel actif ce mois.", ephemeral=True)
            return
        view = AdminCorrectObjectiveSelectView(self.membre, self.monthly_objs, mode="monthly")
        embed = discord.Embed(
            title="📆 Corriger objectifs mensuels",
            description=f"Choisissez l'objectif à corriger pour **{self.membre.display_name}** :",
            color=discord.Color.purple()
        )
        await interaction.response.edit_message(embed=embed, view=view)


class AdminCorrectPointsModal(discord.ui.Modal):
    def __init__(self, membre):
        super().__init__(title=f"Ajuster les points de {membre.display_name[:20]}")
        self.membre = membre
        self.points_input = discord.ui.TextInput(
            label="Points à ajouter (négatif pour retirer)",
            placeholder="Ex: 5 ou -3",
            required=True,
            max_length=10
        )
        self.raison_input = discord.ui.TextInput(
            label="Raison (optionnel)",
            placeholder="Ex: correction erreur saisie",
            required=False,
            max_length=100
        )
        self.add_item(self.points_input)
        self.add_item(self.raison_input)

    async def on_submit(self, interaction: discord.Interaction):
        try:
            pts = float(self.points_input.value.strip().replace(",", "."))
        except ValueError:
            await interaction.response.send_message("❌ Valeur de points invalide.", ephemeral=True)
            return

        if pts == 0:
            await interaction.response.send_message("⚠️ La modification doit être différente de 0.", ephemeral=True)
            return

        user_id = str(self.membre.id)
        cursor.execute("SELECT COALESCE(SUM(points),0) FROM shiny WHERE user_id=?", (user_id,))
        before = cursor.fetchone()[0] or 0

        raison = self.raison_input.value.strip() or "Correction admin"
        pokemon_label = f"[Correction: {raison[:50]}]"
        date_now = datetime.now().strftime("%d-%m-%Y")
        cursor.execute(
            "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter) "
            "VALUES (?, ?, ?, ?, ?, ?, datetime('now'), 'fr', 1, 0)",
            (user_id, pokemon_label, "Correction Admin", "admin_adjustment", date_now, pts)
        )
        conn.commit()

        after = before + pts
        embed = discord.Embed(
            title="✅ Points corrigés",
            description=f"Points de **{self.membre.display_name}** mis à jour.",
            color=discord.Color.green()
        )
        embed.add_field(name="Avant", value=f"{before:.1f} ⭐" if before % 1 != 0 else f"{int(before)} ⭐", inline=True)
        embed.add_field(name="Modification", value=f"{'+' if pts > 0 else ''}{pts:.1f} ⭐", inline=True)
        embed.add_field(name="Après", value=f"{after:.1f} ⭐" if after % 1 != 0 else f"{int(after)} ⭐", inline=True)
        embed.add_field(name="Raison", value=raison, inline=False)
        await interaction.response.send_message(embed=embed, ephemeral=True)
        asyncio.create_task(update_classement_message())


class AdminCorrectShinysModal(discord.ui.Modal):
    """Permet d'ajouter ou retirer une entrée shiny fictive pour corriger le compteur."""
    def __init__(self, membre):
        super().__init__(title=f"Corriger le nb shinys de {membre.display_name[:18]}")
        self.membre = membre
        self.action_input = discord.ui.TextInput(
            label="Action : ajouter ou retirer",
            placeholder="ajouter  (ou: retirer)",
            required=True,
            max_length=10
        )
        self.nb_input = discord.ui.TextInput(
            label="Nombre de shinys à ajouter/retirer",
            placeholder="Ex: 1",
            required=True,
            max_length=3
        )
        self.raison_input = discord.ui.TextInput(
            label="Raison",
            placeholder="Ex: shiny oublié lors de la migration",
            required=False,
            max_length=100
        )
        self.add_item(self.action_input)
        self.add_item(self.nb_input)
        self.add_item(self.raison_input)

    async def on_submit(self, interaction: discord.Interaction):
        action = self.action_input.value.strip().lower()
        if action not in ("ajouter", "retirer", "add", "remove"):
            await interaction.response.send_message("❌ Action invalide. Utilisez 'ajouter' ou 'retirer'.", ephemeral=True)
            return
        try:
            nb = int(self.nb_input.value.strip())
            if nb <= 0:
                raise ValueError
        except ValueError:
            await interaction.response.send_message("❌ Nombre invalide (doit être ≥ 1).", ephemeral=True)
            return

        user_id = str(self.membre.id)
        raison = self.raison_input.value.strip() or "Correction admin"
        date_now = datetime.now().strftime("%d-%m-%Y")

        if action in ("ajouter", "add"):
            for _ in range(nb):
                cursor.execute(
                    "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter) "
                    "VALUES (?, ?, ?, ?, ?, 0, datetime('now'), 'fr', 1, 0)",
                    (user_id, f"[Correction: {raison[:40]}]", "Correction Admin", "admin_adjustment", date_now)
                )
            conn.commit()
            msg = f"✅ **{nb}** shiny(s) ajouté(s) au compteur de **{self.membre.display_name}**.\nRaison : {raison}"
        else:
            # Pour "retirer" : supprimer les N dernières entrées réelles (pas bonus/malus)
            cursor.execute("""
                SELECT rowid FROM shiny WHERE user_id=?
                AND methode NOT IN ('race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
                                    'weekly_objective','monthly_objective','admin_adjustment')
                ORDER BY created_at DESC LIMIT ?
            """, (user_id, nb))
            rowids = [r[0] for r in cursor.fetchall()]
            if not rowids:
                await interaction.response.send_message("❌ Pas assez de shinys à retirer.", ephemeral=True)
                return
            for rid in rowids:
                cursor.execute("DELETE FROM shiny WHERE rowid=?", (rid,))
            conn.commit()
            msg = f"✅ **{len(rowids)}** shiny(s) retiré(s) du compteur de **{self.membre.display_name}**.\nRaison : {raison}"

        await interaction.response.send_message(msg, ephemeral=True)
        asyncio.create_task(update_classement_message())


class AdminCorrectObjectiveSelectView(discord.ui.View):
    """Sélectionner un objectif à corriger."""
    def __init__(self, membre, objectives, mode):
        super().__init__(timeout=300)
        self.membre = membre
        self.mode = mode
        options = []
        for obj in objectives:
            obj_id, desc, otype, target, current, completed, awarded = obj
            current_val = current or 0
            label = f"{'✅' if completed else '⏳'} {desc}"[:100]
            description = f"Progression: {current_val}/{target}"[:100]
            options.append(discord.SelectOption(label=label, value=str(obj_id), description=description))
        sel = discord.ui.Select(
            placeholder="Choisir l'objectif à corriger",
            options=options[:25],
            min_values=1, max_values=1
        )
        sel.callback = self.obj_selected
        self.add_item(sel)
        # Stocker les objectifs pour lookup
        self._objectives = {str(o[0]): o for o in objectives}

    async def obj_selected(self, interaction: discord.Interaction):
        obj_id = interaction.data["values"][0]
        obj = self._objectives[obj_id]
        modal = AdminCorrectProgressModal(self.membre, obj, self.mode)
        await interaction.response.send_modal(modal)


class AdminCorrectProgressModal(discord.ui.Modal):
    def __init__(self, membre, obj, mode):
        obj_id, desc, otype, target, current, completed, awarded = obj
        super().__init__(title=f"Corriger progression objectif")
        self.membre = membre
        self.obj_id = obj_id
        self.obj_desc = desc
        self.obj_target = target
        self.mode = mode

        self.value_input = discord.ui.TextInput(
            label=f"Nouvelle valeur (cible: {target})",
            placeholder=f"Valeur actuelle: {current or 0}",
            default=str(int(current) if current and current == int(current) else (current or 0)),
            required=True,
            max_length=10
        )
        self.completed_input = discord.ui.TextInput(
            label="Marquer comme complété ? (oui/non)",
            placeholder="oui  ou  non",
            required=True,
            max_length=3,
            default="oui" if completed else "non"
        )
        self.award_input = discord.ui.TextInput(
            label="Bonus déjà attribué ? (oui/non)",
            placeholder="oui  ou  non",
            required=True,
            max_length=3,
            default="oui" if awarded else "non"
        )
        self.add_item(self.value_input)
        self.add_item(self.completed_input)
        self.add_item(self.award_input)

    async def on_submit(self, interaction: discord.Interaction):
        try:
            new_val = float(self.value_input.value.strip().replace(",", "."))
        except ValueError:
            await interaction.response.send_message("❌ Valeur invalide.", ephemeral=True)
            return

        is_completed = self.completed_input.value.strip().lower() in ("oui", "o", "yes", "1")
        is_awarded = self.award_input.value.strip().lower() in ("oui", "o", "yes", "1")

        user_id = str(self.membre.id)

        if self.mode == "weekly":
            cursor.execute("""
                INSERT INTO weekly_objectives_progress (objective_id, user_id, current_value, completed, completed_at, bonus_awarded)
                VALUES (?, ?, ?, ?, CASE WHEN ? THEN datetime('now') ELSE NULL END, ?)
                ON CONFLICT(objective_id, user_id) DO UPDATE SET
                    current_value = excluded.current_value,
                    completed = excluded.completed,
                    completed_at = CASE WHEN excluded.completed AND completed_at IS NULL THEN datetime('now') ELSE completed_at END,
                    bonus_awarded = excluded.bonus_awarded
            """, (self.obj_id, user_id, new_val, 1 if is_completed else 0, is_completed, 1 if is_awarded else 0))
        else:
            cursor.execute("""
                INSERT INTO monthly_objectives_progress (objective_id, user_id, current_value, completed, completed_at, bonus_awarded)
                VALUES (?, ?, ?, ?, CASE WHEN ? THEN datetime('now') ELSE NULL END, ?)
                ON CONFLICT(objective_id, user_id) DO UPDATE SET
                    current_value = excluded.current_value,
                    completed = excluded.completed,
                    completed_at = CASE WHEN excluded.completed AND completed_at IS NULL THEN datetime('now') ELSE completed_at END,
                    bonus_awarded = excluded.bonus_awarded
            """, (self.obj_id, user_id, new_val, 1 if is_completed else 0, is_completed, 1 if is_awarded else 0))
        conn.commit()

        status = "✅ Complété" if is_completed else "⏳ En cours"
        bonus_status = "💰 Bonus attribué" if is_awarded else "⏳ Bonus non attribué"
        await interaction.response.send_message(
            f"✅ Progression mise à jour pour **{self.membre.display_name}**\n"
            f"📝 Objectif : **{self.obj_desc}**\n"
            f"📊 Valeur : **{new_val}** / {self.obj_target} — {status} — {bonus_status}",
            ephemeral=True
        )


# ============================================================
# ===== OBJECTIF TYPE METHODE AVEC SÉLECTEUR JEU+MÉTHODE ====
# ============================================================

@bot.tree.command(
    name="admin_objectif_methode",
    description="[ADMIN] Créer un objectif 'méthode précise' avec sélection du jeu et de la méthode",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    mode="Hebdomadaire ou Mensuel",
    destination="Où ajouter l'objectif"
)
@app_commands.choices(
    mode=[
        app_commands.Choice(name="Hebdomadaire", value="weekly"),
        app_commands.Choice(name="Mensuel", value="monthly"),
    ],
    destination=[
        app_commands.Choice(name="Pool réutilisable", value="pool"),
        app_commands.Choice(name="Période en cours", value="current"),
    ]
)
async def admin_objectif_methode(interaction: discord.Interaction, mode: str, destination: str):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    # Étape 1 : choisir le jeu
    view = ObjectifMethodeGameSelect(mode, destination)
    embed = discord.Embed(
        title="🎮 Objectif Méthode Précise — Étape 1/3",
        description="Sélectionnez le **jeu** pour lequel vous voulez définir la méthode :",
        color=discord.Color.gold() if mode == "weekly" else discord.Color.purple()
    )
    await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


class ObjectifMethodeGameSelect(discord.ui.View):
    def __init__(self, mode, destination):
        super().__init__(timeout=300)
        self.mode = mode
        self.destination = destination

        options = [discord.SelectOption(label=v["fr"][:100], value=k) for k, v in GAMES.items()]
        # Diviser si > 25
        if len(options) <= 25:
            sel = discord.ui.Select(placeholder="🎮 Choisir le jeu", options=options, min_values=1, max_values=1)
            sel.callback = self.game_selected
            self.add_item(sel)
        else:
            sel1 = discord.ui.Select(placeholder="🎮 Jeux (1/2)", options=options[:25], min_values=1, max_values=1)
            sel1.callback = self.game_selected
            self.add_item(sel1)
            sel2 = discord.ui.Select(placeholder="🎮 Jeux (2/2)", options=options[25:50], min_values=1, max_values=1)
            sel2.callback = self.game_selected
            self.add_item(sel2)

    async def game_selected(self, interaction: discord.Interaction):
        game_key = interaction.data["values"][0]
        game_name = GAMES[game_key]["fr"]

        methods = METHODS_BY_GAME.get(game_key, {})
        if not methods:
            await interaction.response.send_message(
                f"❌ Aucune méthode disponible pour **{game_name}**.", ephemeral=True
            )
            return

        view = ObjectifMethodeMethodSelect(self.mode, self.destination, game_key, game_name)
        embed = discord.Embed(
            title="🎯 Objectif Méthode Précise — Étape 2/3",
            description=f"Jeu sélectionné : **{game_name}**\n\nChoisissez maintenant la **méthode** :",
            color=discord.Color.gold() if self.mode == "weekly" else discord.Color.purple()
        )
        await interaction.response.edit_message(embed=embed, view=view)


class ObjectifMethodeMethodSelect(discord.ui.View):
    def __init__(self, mode, destination, game_key, game_name):
        super().__init__(timeout=300)
        self.mode = mode
        self.destination = destination
        self.game_key = game_key
        self.game_name = game_name

        methods = METHODS_BY_GAME.get(game_key, {})
        options = [
            discord.SelectOption(
                label=f"{v['fr']} ({v['points']} pts)"[:100],
                value=method_key
            )
            for method_key, v in methods.items()
        ]
        sel = discord.ui.Select(
            placeholder="🎯 Choisir la méthode",
            options=options[:25],
            min_values=1, max_values=1
        )
        sel.callback = self.method_selected
        self.add_item(sel)

    async def method_selected(self, interaction: discord.Interaction):
        method_key = interaction.data["values"][0]
        method_name = METHODS_BY_GAME[self.game_key][method_key]["fr"]
        # Étape 3 : modal pour bonus/difficulté/destination
        modal = ObjectifMethodeFinalModal(self.mode, self.destination, self.game_key, self.game_name, method_key, method_name)
        await interaction.response.send_modal(modal)


class ObjectifMethodeFinalModal(discord.ui.Modal):
    def __init__(self, mode, destination, game_key, game_name, method_key, method_name):
        super().__init__(title="Finaliser l'objectif méthode")
        self.mode = mode
        self.destination = destination
        self.game_key = game_key
        self.game_name = game_name
        self.method_key = method_key
        self.method_name = method_name

        self.desc_input = discord.ui.TextInput(
            label="Description (laisser vide = auto)",
            placeholder=f"Ex: Trouver un shiny en {method_name}",
            default=f"Trouver un shiny en {method_name} ({game_name})",
            required=True,
            max_length=150
        )
        self.bonus_input = discord.ui.TextInput(
            label="Points bonus à attribuer",
            placeholder="Ex: 5",
            required=True,
            max_length=6
        )
        self.diff_input = discord.ui.TextInput(
            label="Difficulté : easy / medium / hard",
            placeholder="easy",
            required=True,
            max_length=6
        )
        self.add_item(self.desc_input)
        self.add_item(self.bonus_input)
        self.add_item(self.diff_input)

    async def on_submit(self, interaction: discord.Interaction):
        diff = self.diff_input.value.strip().lower()
        if diff not in ("easy", "medium", "hard"):
            await interaction.response.send_message("❌ Difficulté invalide. Utilisez : easy, medium ou hard.", ephemeral=True)
            return
        try:
            bonus = float(self.bonus_input.value.strip().replace(",", "."))
            if bonus <= 0:
                raise ValueError
        except ValueError:
            await interaction.response.send_message("❌ Points bonus invalides.", ephemeral=True)
            return

        desc = self.desc_input.value.strip()
        user_id = str(interaction.user.id)

        if self.mode == "weekly":
            dest = "pool" if self.destination == "pool" else "week"
            save_objective("method", desc, 1.0, bonus, diff, self.method_key, dest, user_id)
            dest_label = "pool hebdomadaire" if dest == "pool" else "semaine en cours"
        else:
            dest = "monthly_pool" if self.destination == "pool" else "monthly"
            save_monthly_objective("method", desc, 1.0, bonus, diff, self.method_key, dest, user_id)
            dest_label = "pool mensuel" if dest == "monthly_pool" else "mois en cours"

        await interaction.response.send_message(
            f"✅ Objectif méthode ajouté au **{dest_label}** !\n"
            f"📝 **{desc}**\n"
            f"🎮 Jeu : **{self.game_name}** | 🎯 Méthode : **{self.method_name}**\n"
            f"⭐ Bonus : **+{bonus} pts** | Difficulté : **{diff}**",
            ephemeral=True
        )


# ============================================================
# ===== WANTED AVEC SÉLECTEUR JEU + MÉTHODE OPTIONNELLE =====
# ============================================================

@bot.tree.command(
    name="admin_wanted_avance",
    description="[ADMIN] Créer un Wanted avec choix du jeu et de la méthode précise",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    pokemon="Nom du Pokémon wanted (autocomplétion)",
    bonus_points="Points bonus attribués au premier trouveur",
    decay_percent="Pourcentage de décroissance (défaut 100)",
    indice="Indice optionnel pour les joueurs",
    unique="Si True : bonus uniquement pour le 1er trouveur, 0 pts pour les suivants",
    date_fin="Date de fin programmée (optionnel, format JJ/MM/AAAA HH:MM — ex: 25/12/2025 20:00)"
)
async def admin_wanted_avance(
    interaction: discord.Interaction,
    pokemon: str,
    bonus_points: float,
    decay_percent: float = 100.0,
    indice: str = None,
    unique: bool = False,
    date_fin: str = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    expires_dt, error_msg = parse_wanted_end_date(date_fin)
    if error_msg:
        await interaction.response.send_message(error_msg, ephemeral=True)
        return

    # Proposer de choisir un jeu (optionnel)
    view = WantedAvanceGameSelect(pokemon, bonus_points, decay_percent, indice, unique=unique, expires_at=expires_dt)
    unique_label = " | 🔒 **Unique** (1er seulement)" if unique else ""
    date_fin_label = f" | 📅 Fin : <t:{int(expires_dt.timestamp())}:f>" if expires_dt else ""
    embed = discord.Embed(
        title="🎯 Wanted Avancé — Étape 1/2",
        description=(
            f"Pokémon : **{pokemon}** | Bonus : **+{bonus_points} pts** | Décroissance : **{decay_percent}%**{unique_label}{date_fin_label}\n\n"
            "Sélectionnez un **jeu** pour restreindre le wanted à un jeu précis "
            "(ou cliquez sur **Aucun jeu** pour tous les jeux) :"
        ),
        color=discord.Color.red()
    )
    await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


@admin_wanted_avance.autocomplete("pokemon")
async def wanted_avance_autocomplete(interaction: discord.Interaction, current: str):
    return await pokemon_autocomplete(interaction, current)


class WantedAvanceGameSelect(discord.ui.View):
    def __init__(self, pokemon, bonus_points, decay_percent, indice, unique=False, expires_at=None):
        super().__init__(timeout=300)
        self.pokemon = pokemon
        self.bonus_points = bonus_points
        self.decay_percent = decay_percent
        self.indice = indice
        self.unique = unique
        self.expires_at = expires_at

        options = [discord.SelectOption(label=v["fr"][:100], value=k) for k, v in GAMES.items()]
        if len(options) <= 25:
            sel = discord.ui.Select(placeholder="🎮 Choisir un jeu (optionnel)", options=options, min_values=1, max_values=1)
            sel.callback = self.game_selected
            self.add_item(sel)
        else:
            sel1 = discord.ui.Select(placeholder="🎮 Jeux (1/2)", options=options[:25], min_values=1, max_values=1)
            sel1.callback = self.game_selected
            self.add_item(sel1)
            sel2 = discord.ui.Select(placeholder="🎮 Jeux (2/2)", options=options[25:50], min_values=1, max_values=1)
            sel2.callback = self.game_selected
            self.add_item(sel2)

        # Bouton "aucun jeu"
        btn_no_game = discord.ui.Button(label="🌐 Aucun jeu (tous les jeux)", style=discord.ButtonStyle.secondary)
        btn_no_game.callback = self.no_game
        self.add_item(btn_no_game)

    async def game_selected(self, interaction: discord.Interaction):
        game_key = interaction.data["values"][0]
        game_name = GAMES[game_key]["fr"]

        methods = METHODS_BY_GAME.get(game_key, {})
        if methods:
            view = WantedAvanceMethodSelect(self.pokemon, self.bonus_points, self.decay_percent, self.indice, game_key, game_name, unique=self.unique, expires_at=self.expires_at)
            embed = discord.Embed(
                title="🎯 Wanted Avancé — Étape 2/2",
                description=(
                    f"Pokémon : **{self.pokemon}** | Jeu : **{game_name}**\n\n"
                    "Sélectionnez une **méthode précise** (optionnel) :"
                ),
                color=discord.Color.red()
            )
            await interaction.response.edit_message(embed=embed, view=view)
        else:
            # Pas de méthode pour ce jeu, créer directement
            await self._create_wanted(interaction, game_key, game_name, method_key=None)

    async def no_game(self, interaction: discord.Interaction):
        await self._create_wanted(interaction, game_key=None, game_name=None, method_key=None)

    async def _create_wanted(self, interaction, game_key, game_name, method_key):
        import json as _json
        game_to_store = game_name
        wanted_id = set_wanted(self.pokemon, self.bonus_points, self.decay_percent, game_to_store)

        # Si unique : stocker paliers avec p2=p3=suite=0
        if self.unique:
            paliers = {"p1": self.bonus_points, "p2": 0, "p3": 0, "suite": 0}
            cursor.execute("UPDATE shiny_wanted SET paliers_json=? WHERE id=?", (_json.dumps(paliers), wanted_id))
            conn.commit()

        # Stocker l'indice si fourni
        if self.indice:
            cursor.execute("UPDATE shiny_wanted SET indice=? WHERE id=?", (self.indice, wanted_id))
            conn.commit()

        # Stocker la date de fin programmée si fournie
        if self.expires_at:
            cursor.execute("UPDATE shiny_wanted SET expires_at=? WHERE id=?",
                           (self.expires_at.strftime("%Y-%m-%d %H:%M"), wanted_id))
            conn.commit()

        game_label = game_name if game_name else "Tous les jeux"
        unique_label = "🔒 **Unique** — 1er trouveur uniquement" if self.unique else f"Décroissance {self.decay_percent}%"
        embed = discord.Embed(
            title="✅ Wanted créé !",
            description=f"**{self.pokemon}** est maintenant un Pokémon Wanted !",
            color=discord.Color.green()
        )
        embed.add_field(name="🎮 Jeu", value=game_label, inline=True)
        embed.add_field(name="⭐ Bonus 1er", value=f"+{self.bonus_points} pts", inline=True)
        embed.add_field(name="📋 Type", value=unique_label, inline=True)
        if self.indice:
            embed.add_field(name="💡 Indice", value=self.indice, inline=False)
        if self.expires_at:
            embed.add_field(name="📅 Fin programmée", value=f"<t:{int(self.expires_at.timestamp())}:F>", inline=False)
        embed.set_footer(text="ShinyBot — Wanted Avancé")
        await interaction.response.edit_message(embed=embed, view=None)


class WantedAvanceMethodSelect(discord.ui.View):
    def __init__(self, pokemon, bonus_points, decay_percent, indice, game_key, game_name, unique=False, expires_at=None):
        super().__init__(timeout=300)
        self.pokemon = pokemon
        self.bonus_points = bonus_points
        self.decay_percent = decay_percent
        self.indice = indice
        self.game_key = game_key
        self.game_name = game_name
        self.unique = unique
        self.expires_at = expires_at

        methods = METHODS_BY_GAME.get(game_key, {})
        options = [
            discord.SelectOption(
                label=f"{v['fr']} ({v['points']} pts)"[:100],
                value=method_key
            )
            for method_key, v in methods.items()
        ]
        sel = discord.ui.Select(
            placeholder="🎯 Choisir une méthode (optionnel)",
            options=options[:25],
            min_values=1, max_values=1
        )
        sel.callback = self.method_selected
        self.add_item(sel)

        # Bouton "sans méthode précise"
        btn_no_method = discord.ui.Button(label="🌐 Toutes les méthodes", style=discord.ButtonStyle.secondary)
        btn_no_method.callback = self.no_method
        self.add_item(btn_no_method)

    async def method_selected(self, interaction: discord.Interaction):
        method_key = interaction.data["values"][0]
        method_name = METHODS_BY_GAME[self.game_key][method_key]["fr"]
        await self._create_wanted_with_method(interaction, method_key, method_name)

    async def no_method(self, interaction: discord.Interaction):
        await self._create_wanted_with_method(interaction, method_key=None, method_name=None)

    async def _create_wanted_with_method(self, interaction, method_key, method_name):
        import json as _json
        indice_final = self.indice or ""
        if method_name:
            method_suffix = f"[Méthode : {method_name}]"
            indice_final = f"{indice_final} {method_suffix}".strip() if indice_final else method_suffix

        wanted_id = set_wanted(self.pokemon, self.bonus_points, self.decay_percent, self.game_name)

        # Si unique : stocker paliers avec p2=p3=suite=0
        if self.unique:
            paliers = {"p1": self.bonus_points, "p2": 0, "p3": 0, "suite": 0}
            cursor.execute("UPDATE shiny_wanted SET paliers_json=? WHERE id=?", (_json.dumps(paliers), wanted_id))
            conn.commit()

        if indice_final:
            cursor.execute("UPDATE shiny_wanted SET indice=? WHERE id=?", (indice_final, wanted_id))
            conn.commit()

        if self.expires_at:
            cursor.execute("UPDATE shiny_wanted SET expires_at=? WHERE id=?",
                           (self.expires_at.strftime("%Y-%m-%d %H:%M"), wanted_id))
            conn.commit()

        method_label = method_name if method_name else "Toutes les méthodes"
        unique_label = "🔒 **Unique** — 1er seulement" if self.unique else f"Décroissance {self.decay_percent}%"
        embed = discord.Embed(
            title="✅ Wanted créé !",
            description=f"**{self.pokemon}** est maintenant un Pokémon Wanted !",
            color=discord.Color.green()
        )
        embed.add_field(name="🎮 Jeu", value=self.game_name, inline=True)
        embed.add_field(name="🎯 Méthode", value=method_label, inline=True)
        embed.add_field(name="⭐ Bonus 1er", value=f"+{self.bonus_points} pts", inline=True)
        embed.add_field(name="📋 Type", value=unique_label, inline=True)
        if self.indice:
            embed.add_field(name="💡 Indice original", value=self.indice, inline=False)
        if self.expires_at:
            embed.add_field(name="📅 Fin programmée", value=f"<t:{int(self.expires_at.timestamp())}:F>", inline=False)
        embed.set_footer(text="ShinyBot — Wanted Avancé")
        await interaction.response.edit_message(embed=embed, view=None)


