@bot.tree.command(name="mes_badges", description="Voir tes badges ranked", guild=discord.Object(id=GUILD_ID))
async def mes_badges(interaction: discord.Interaction):
    async def _show(**kwargs):
        badges = get_user_badges(interaction.user.id)
        embed = discord.Embed(
            title=f"🎖️ Badges de {interaction.user.display_name}",
            color=discord.Color.gold(),
            timestamp=datetime.now()
        )
        embed.set_thumbnail(url=interaction.user.display_avatar.url)
        if badges:
            for code, emoji, name, desc, awarded_at in badges:
                date_str = awarded_at[:10] if awarded_at else "?"
                embed.add_field(name=f"{emoji} {name}", value=f"*{desc}*\n📅 {date_str}", inline=True)
        else:
            embed.description = "Tu n'as pas encore de badges. Continue à chasser ! 🌟"

        # Badges non encore obtenus
        cursor.execute("SELECT code, emoji, name, description FROM badges_definitions WHERE is_auto=1")
        all_badges = cursor.fetchall()
        owned_codes = {b[0] for b in badges}
        locked = [b for b in all_badges if b[0] not in owned_codes]
        if locked:
            locked_str = "  ".join(f"🔒 {b[1]} {b[2]}" for b in locked)
            if len(locked_str) > 1024:
                locked_str = locked_str[:1020] + "…"
            embed.add_field(name="🔒 Badges à débloquer", value=locked_str, inline=False)

        embed.set_footer(text="ShinyBot · Badges Ranked")
        await interaction.response.send_message(embed=embed, ephemeral=True)
        return True
    await discord_retry_wrapper(_show, context="Mes Badges")


@bot.tree.command(name="admin_badge_donner", description="[ADMIN] Donner un badge à un membre", guild=discord.Object(id=GUILD_ID))
@app_commands.describe(membre="Le membre qui reçoit le badge", badge_code="Code du badge (ex: first_shiny)")
async def admin_badge_donner(interaction: discord.Interaction, membre: discord.Member, badge_code: str):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    cursor.execute("SELECT emoji, name FROM badges_definitions WHERE code=?", (badge_code,))
    row = cursor.fetchone()
    if not row:
        cursor.execute("SELECT code, name FROM badges_definitions")
        all_b = cursor.fetchall()
        list_str = "\n".join(f"• `{b[0]}` — {b[1]}" for b in all_b)
        await interaction.response.send_message(f"❌ Badge `{badge_code}` introuvable.\n\n**Badges disponibles :**\n{list_str}", ephemeral=True)
        return
    is_new = award_badge(membre.id, badge_code, awarded_by=str(interaction.user.id))
    if is_new:
        await interaction.response.send_message(f"✅ Badge **{row[0]} {row[1]}** donné à {membre.mention} !", ephemeral=True)
    else:
        await interaction.response.send_message(f"ℹ️ {membre.mention} a déjà ce badge.", ephemeral=True)


@bot.tree.command(name="admin_badge_retirer", description="[ADMIN] Retirer un badge à un membre", guild=discord.Object(id=GUILD_ID))
@app_commands.describe(membre="Le membre concerné", badge_code="Code du badge à retirer")
async def admin_badge_retirer(interaction: discord.Interaction, membre: discord.Member, badge_code: str):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    removed = revoke_badge(membre.id, badge_code)
    if removed:
        await interaction.response.send_message(f"✅ Badge `{badge_code}` retiré à {membre.mention}.", ephemeral=True)
    else:
        await interaction.response.send_message(f"ℹ️ {membre.mention} n'avait pas ce badge.", ephemeral=True)


@bot.tree.command(name="admin_badge_creer", description="[ADMIN] Créer un nouveau badge personnalisé", guild=discord.Object(id=GUILD_ID))
@app_commands.describe(
    code="Code unique du badge (ex: champion_ete)",
    emoji="Emoji du badge",
    nom="Nom affiché",
    description="Description du badge"
)
async def admin_badge_creer(interaction: discord.Interaction, code: str, emoji: str, nom: str, description: str):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    try:
        cursor.execute("""
            INSERT INTO badges_definitions (code, emoji, name, description, is_auto)
            VALUES (?, ?, ?, ?, 0)
        """, (code, emoji, nom, description))
        conn.commit()
        await interaction.response.send_message(
            f"✅ Badge **{emoji} {nom}** créé avec le code `{code}` !\n"
            f"Utilisez `/admin_badge_donner` pour l'attribuer.",
            ephemeral=True
        )
    except Exception:
        await interaction.response.send_message(f"❌ Le code `{code}` existe déjà.", ephemeral=True)


