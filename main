@bot.tree.command(
    name="admin_wanted_avance",
    description="[ADMIN] Créer un Wanted avec choix du jeu et de la méthode précise",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    pokemon="Nom du Pokémon wanted (autocomplétion)",
    bonus_points="Points bonus attribués au premier trouveur",
    decay_percent="Pourcentage de décroissance (défaut 100)",
    indice="Indice optionnel pour les joueurs",
    unique="Si True : bonus uniquement pour le 1er trouveur, 0 pts pour les suivants"
)
async def admin_wanted_avance(
    interaction: discord.Interaction,
    pokemon: str,
    bonus_points: float,
    decay_percent: float = 100.0,
    indice: str = None,
    unique: bool = False
):
