def get_active_event():
    """Retourne l'événement de points actif (si existant)."""
    cursor.execute("""
        SELECT id, event_type, multiplier, target_game, description, ends_at
        FROM active_events
        WHERE is_active=1
        AND (ends_at IS NULL OR ends_at > datetime('now'))
        ORDER BY id DESC LIMIT 1
    """)
    row = cursor.fetchone()
    if not row:
        return None
    return {
        'id': row[0], 'event_type': row[1], 'multiplier': row[2],
        'target_game': row[3], 'description': row[4], 'ends_at': row[5]
    }

def get_event_multiplier(game, event):
    """Retourne le multiplicateur de l'événement pour ce jeu."""
    if not event:
        return 1.0
    if event['event_type'] == 'all_games':
        return event['multiplier']
    if event['event_type'] == 'specific_game' and event['target_game']:
        if normalize_str(game or '') == normalize_str(event['target_game']):
            return event['multiplier']
    return 1.0

def get_active_monthly_challenge():
    """Retourne le challenge mensuel actif."""
    month_start = get_current_month_start()
    cursor.execute("""
        SELECT id, description, target_type, target_value, bonus_points, max_winners
        FROM monthly_challenge WHERE month_start=? AND is_active=1
    """, (month_start,))
    row = cursor.fetchone()
    if not row:
        return None
    return {
        'id': row[0], 'description': row[1], 'target_type': row[2],
        'target_value': row[3], 'bonus_points': row[4], 'max_winners': row[5]
    }

def get_active_monthly_type_challenge():
    cursor.execute("""
        SELECT id, month, year, shiny_type, top_n, bonus_points,
               bonus_top1, bonus_top2, bonus_top3, bonus_other,
               description, ends_at, announce_channel_id
        FROM monthly_type_challenge
        WHERE active = 1
        ORDER BY id DESC
        LIMIT 1
    """)
    row = cursor.fetchone()
    if not row:
        return None

    # Auto-clôture si la date de fin est dépassée.
    ends_at = row[11]
    if ends_at:
        try:
            if datetime.strptime(ends_at, "%Y-%m-%d %H:%M") <= datetime.now():
                cursor.execute("UPDATE monthly_type_challenge SET active = 0 WHERE id = ?", (row[0],))
                conn.commit()
                return None
        except Exception:
            pass
    return row

def close_active_monthly_type_challenges():
    cursor.execute("UPDATE monthly_type_challenge SET active = 0 WHERE active = 1")
    conn.commit()

def create_monthly_type_challenge(
    month, year, shiny_type, top_n,
    bonus_points, bonus_top1, bonus_top2, bonus_top3, bonus_other,
    description, ends_at, announce_channel_id, created_by
):
    created_at = datetime.now().strftime("%d-%m-%Y %H:%M:%S")
    close_active_monthly_type_challenges()
    cursor.execute(
        """
        INSERT INTO monthly_type_challenge (
            month, year, shiny_type, top_n, bonus_points,
            bonus_top1, bonus_top2, bonus_top3, bonus_other,
            description, ends_at, announce_channel_id, created_by, created_at, active
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1)
        """,
        (
            month, year, shiny_type, top_n, float(bonus_points),
            float(bonus_top1), float(bonus_top2), float(bonus_top3), float(bonus_other),
            description or "", ends_at, str(announce_channel_id) if announce_channel_id else None,
            created_by, created_at
        )
    )
    conn.commit()
    return cursor.lastrowid

def get_type_challenge_base_count(challenge_id, user_id):
    cursor.execute("""
        SELECT month, year, shiny_type
        FROM monthly_type_challenge
        WHERE id = ?
    """, (challenge_id,))
    challenge = cursor.fetchone()
    if not challenge:
        return 0

    month, year, shiny_type = challenge
    month_txt = f"{month:02d}"
    year_txt = str(year)
    cursor.execute("""
        SELECT COUNT(*) FROM shiny
        WHERE user_id = ?
          AND type_pokemon = ?
          AND substr(date, 4, 2) = ?
          AND substr(date, 7, 4) = ?
    """, (str(user_id), shiny_type, month_txt, year_txt))
    row = cursor.fetchone()
    return row[0] if row else 0

def set_type_challenge_count(challenge_id, user_id, desired_total):
    base_count = get_type_challenge_base_count(challenge_id, user_id)
    adjustment = int(desired_total) - int(base_count)
    updated_at = datetime.now().strftime("%d-%m-%Y %H:%M:%S")
    cursor.execute("""
        INSERT INTO monthly_type_challenge_adjustments (challenge_id, user_id, adjustment, updated_at)
        VALUES (?, ?, ?, ?)
        ON CONFLICT(challenge_id, user_id)
        DO UPDATE SET adjustment = excluded.adjustment, updated_at = excluded.updated_at
    """, (challenge_id, str(user_id), adjustment, updated_at))
    conn.commit()
    return base_count, adjustment

def get_type_challenge_leaderboard(challenge_id):
    cursor.execute("""
        SELECT month, year, shiny_type, top_n, bonus_points,
               bonus_top1, bonus_top2, bonus_top3, bonus_other,
               description, ends_at, announce_channel_id
        FROM monthly_type_challenge
        WHERE id = ?
    """, (challenge_id,))
    challenge = cursor.fetchone()
    if not challenge:
        return None, []

    month, year, shiny_type, top_n = challenge[0], challenge[1], challenge[2], challenge[3]
    month_txt = f"{month:02d}"
    year_txt = str(year)

    cursor.execute("""
        SELECT s.user_id, COUNT(*) + COALESCE(a.adjustment, 0) AS total_shinys
        FROM shiny s
        LEFT JOIN monthly_type_challenge_adjustments a
          ON a.challenge_id = ? AND a.user_id = s.user_id
        WHERE s.type_pokemon = ?
          AND substr(s.date, 4, 2) = ?
          AND substr(s.date, 7, 4) = ?
        GROUP BY s.user_id
        HAVING total_shinys > 0
        ORDER BY total_shinys DESC, s.user_id ASC
    """, (challenge_id, shiny_type, month_txt, year_txt))
    scores = cursor.fetchall()

    cursor.execute("""
        SELECT a.user_id, a.adjustment
        FROM monthly_type_challenge_adjustments a
        WHERE a.challenge_id = ?
          AND a.user_id NOT IN (
              SELECT user_id FROM shiny
              WHERE type_pokemon = ?
                AND substr(date, 4, 2) = ?
                AND substr(date, 7, 4) = ?
          )
          AND a.adjustment > 0
        ORDER BY a.adjustment DESC, a.user_id ASC
    """, (challenge_id, shiny_type, month_txt, year_txt))
    scores.extend(cursor.fetchall())

    return challenge, scores

def close_monthly_type_challenge(challenge_id):
    cursor.execute("UPDATE monthly_type_challenge SET active = 0 WHERE id = ?", (challenge_id,))
    conn.commit()

def get_rank_bonus(position, bonus_top1, bonus_top2, bonus_top3, bonus_other):
    if position == 1:
        return float(bonus_top1)
    if position == 2:
        return float(bonus_top2)
    if position == 3:
        return float(bonus_top3)
    return float(bonus_other)

def get_challenge_winners_count():
    """Retourne le nombre de gagnants du challenge ce mois."""
    month_start = get_current_month_start()
    cursor.execute("SELECT COUNT(*) FROM monthly_challenge_winners WHERE month_start=?", (month_start,))
    return cursor.fetchone()[0] or 0

def has_won_challenge(user_id):
    month_start = get_current_month_start()
    cursor.execute("SELECT 1 FROM monthly_challenge_winners WHERE month_start=? AND user_id=?",
                   (month_start, str(user_id)))
    return cursor.fetchone() is not None

def register_challenge_winner(user_id):
    month_start = get_current_month_start()
    try:
        cursor.execute("INSERT OR IGNORE INTO monthly_challenge_winners (month_start, user_id) VALUES (?,?)",
                       (month_start, str(user_id)))
        conn.commit()
        return cursor.rowcount > 0
    except Exception:
        return False

def check_challenge_completion(user_id, pokemon, game, pokemon_type=None):
    """Vérifie si le shiny complète le challenge mensuel pour ce joueur.
    Retourne le bonus si oui, sinon 0.

    Règle anti-abus : un même Pokémon (même nom normalisé) dans le même jeu
    ne peut être soumis qu'une seule fois par participant pour le challenge en cours.
    La liste se remet à zéro automatiquement à chaque nouveau challenge (nouveau challenge_id).
    """
    challenge = get_active_monthly_challenge()
    if not challenge or has_won_challenge(user_id):
        return 0, None
    if get_challenge_winners_count() >= challenge['max_winners']:
        return 0, None

    # ── Déduplication (pokemon, jeu) par participant ──────────────────────
    pnorm = normalize_str(pokemon)
    gnorm = normalize_str(game or '')
    cursor.execute(
        "SELECT 1 FROM monthly_challenge_pokemon_log "
        "WHERE challenge_id=? AND user_id=? AND pokemon_norm=? AND game_norm=?",
        (challenge['id'], str(user_id), pnorm, gnorm)
    )
    if cursor.fetchone():
        # Ce (pokemon, jeu) a déjà été soumis par ce participant pour ce challenge
        return 0, None

    # Enregistrer immédiatement pour éviter tout double comptage concurrent
    try:
        cursor.execute(
            "INSERT OR IGNORE INTO monthly_challenge_pokemon_log "
            "(challenge_id, user_id, pokemon_norm, game_norm) VALUES (?,?,?,?)",
            (challenge['id'], str(user_id), pnorm, gnorm)
        )
        conn.commit()
    except Exception as _e:
        logger.warning(f"Erreur log challenge pokemon: {_e}")
    # ─────────────────────────────────────────────────────────────────────

    ttype = challenge['target_type']
    tval  = challenge['target_value'] or ''
    completed = False

    if ttype == 'pokemon_type' and pokemon_type:
        completed = normalize_str(pokemon_type) == normalize_str(tval)
    elif ttype == 'game' and game:
        completed = normalize_str(game) == normalize_str(tval)
    elif ttype == 'pokemon':
        completed = normalize_str(pokemon) == normalize_str(tval)
    elif ttype == 'letter':
        completed = normalize_str(pokemon).startswith(normalize_str(tval))
    elif ttype == 'starter':
        completed = normalize_str(pokemon) in get_special_list('starter')
    elif ttype == 'legendary':
        completed = normalize_str(pokemon) in get_special_list('legendary')

    if completed:
        if register_challenge_winner(user_id):
            rank = get_challenge_winners_count()
            return challenge['bonus_points'], challenge['description']
    return 0, None

def award_participation_bonus(user_id):
    """Attribue le bonus de participation hebdo (+5 pts) si pas encore reçu.
    Retourne True si nouveau bonus."""
    week_start = get_current_week_start()
    cursor.execute(
        "SELECT bonus_awarded FROM weekly_participation WHERE user_id=? AND week_start=?",
        (str(user_id), week_start)
    )
    row = cursor.fetchone()
    if row and row[0]:
        return False  # Déjà reçu
    cursor.execute("""
        INSERT INTO weekly_participation (user_id, week_start, bonus_awarded)
        VALUES (?, ?, 1)
        ON CONFLICT(user_id, week_start) DO UPDATE SET bonus_awarded=1
    """, (str(user_id), week_start))
    cursor.execute("""
        INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
        VALUES (?, '[Participation Hebdo]', '', 'participation_bonus', date('now'), 5, datetime('now'), 'fr')
    """, (str(user_id),))
    conn.commit()
    return True

def is_monday_first_shiny():
    """Vérifie si c'est le 1er shiny du serveur ce lundi."""
    from datetime import datetime as _dt
    now = _dt.now()
    if now.weekday() != 0:  # 0 = lundi
        return False
    cursor.execute("""
        SELECT COUNT(*) FROM shiny
        WHERE DATE(created_at) = DATE('now')
        AND methode NOT IN ('participation_bonus','weekly_objective','monthly_objective',
                            'race_bonus','race_malus','race_team_bonus','race_team_malus',
                            'admin_adjustment','bounty_bonus','season_carryover','monday_first_bonus')
    """)
    count = cursor.fetchone()[0] or 0
    return count == 1  # On vient juste d'insérer le 1er shiny du jour (count inclut celui qu'on vient d'ajouter)

def award_monday_first_bonus(user_id):
    """Attribue le bonus lundi 1er shiny du serveur (+15 pts)."""
    cursor.execute("""
        INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
        VALUES (?, '[🌟 1er Shiny du Lundi !]', '', 'monday_first_bonus', date('now'), 15, datetime('now'), 'fr')
    """, (str(user_id),))
    conn.commit()

def is_new_player(user_id):
    """Vérifie si c'est le tout premier shiny de ce joueur."""
    cursor.execute("""
        SELECT COUNT(*) FROM shiny WHERE user_id=?
        AND methode NOT IN ('participation_bonus','weekly_objective','monthly_objective',
                            'race_bonus','race_malus','race_team_bonus','race_team_malus',
                            'admin_adjustment','bounty_bonus','season_carryover',
                            'monday_first_bonus','new_player_bonus')
    """, (str(user_id),))
    return (cursor.fetchone()[0] or 0) == 1  # Vient d'être inséré = 1

def award_new_player_bonus(user_id):
    """Attribue le bonus nouveau joueur (+25 pts)."""
    cursor.execute("""
        INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
        VALUES (?, '[🎉 Bienvenue !]', '', 'new_player_bonus', date('now'), 25, datetime('now'), 'fr')
    """, (str(user_id),))
    conn.commit()


async def launch_scheduled_wanted(row):
    """Lance un wanted programmé : l'insère en DB et envoie l'alerte."""
    import json as _j
    sid, scheduled_at, pname, bpts, decay, game, indice, paliers_json, unique_w, alternates, created_by = row

    # Créer le wanted
    cursor.execute("""
        INSERT INTO shiny_wanted (pokemon_name, bonus_points, decay_percent, game, paliers_json, indice, is_active, updated_at)
        VALUES (?, ?, ?, ?, ?, ?, 1, datetime('now'))
    """, (pname, bpts, decay, game, paliers_json, indice))
    conn.commit()
    wanted_id = cursor.lastrowid

    # Si unique : paliers p2/p3/suite = 0
    if unique_w and not paliers_json:
        paliers = {"p1": bpts, "p2": 0, "p3": 0, "suite": 0}
        cursor.execute("UPDATE shiny_wanted SET paliers_json=? WHERE id=?", (_j.dumps(paliers), wanted_id))

    # Alternates
    if alternates:
        cursor.execute("UPDATE shiny_wanted SET pokemon_alternates=? WHERE id=?", (alternates, wanted_id))

    conn.commit()

    # Marquer comme lancé
    cursor.execute("UPDATE scheduled_wanteds SET status='launched' WHERE id=?", (sid,))
    conn.commit()

    # Envoyer l'alerte
    try:
        channel = bot.get_channel(SALON_WANTED_ALERT_ID)
        if channel:
            is_mystery = indice and not indice.strip().startswith("[Méthode :")
            displayed_fr = "???" if is_mystery else pname
            displayed_en = "???" if is_mystery else pname
            game_txt_fr = f" sur **{game}**" if game else ""
            game_txt_en = f" on **{game}**" if game else ""
            end_ts = int((datetime.now() + timedelta(days=7)).timestamp())
            desc = (
                f"**{displayed_fr}** est maintenant recherché{game_txt_fr} !\n"
                f"**{displayed_en}** is now wanted{game_txt_en}!\n\n"
                f"⭐ Bonus : **+{bpts} pts** pour le premier trouveur / for the first finder\n"
                f"⏰ Se termine / Ends : <t:{end_ts}:F> (<t:{end_ts}:R>)\n\n"
            )
            if indice and not is_mystery:
                desc += f"🎯 Méthode : {indice.replace('[Méthode : ', '').rstrip(']')}\n\n"
            elif is_mystery:
                desc += f"🔍 **Indice :** {indice}\n\n"
            if alternates:
                try:
                    alt_list = _j.loads(alternates)
                    if alt_list:
                        alt_display = [("???" if is_mystery else a) for a in alt_list]
                        desc += f"🔄 Aussi accepté : {', '.join(alt_display)}\n\n"
                except Exception:
                    pass
            desc += (
                f"🇫🇷 Utilisez `/shiny_ajout` pour réclamer votre bonus !\n"
                f"🇬🇧 Use `/add_myshiny` to claim your bonus!"
            )
            embed = discord.Embed(
                title="🎯 Nouveau Pokémon Wanted !  ·  New Wanted Pokémon!",
                description=desc,
                color=discord.Color.red(),
                timestamp=datetime.now()
            )
            embed.set_footer(text="ShinyBot · Wanted Alert")
            await channel.send(embed=embed)
            logger.info(f"Wanted programmé lancé : {pname} (ID {wanted_id})")
    except Exception as e:
        logger.error(f"Erreur alerte wanted programmé {pname}: {e}")


async def auto_scheduled_wanteds():
    """Tâche de fond : vérifie et lance les wanteds programmés toutes les 30 secondes."""
    await bot.wait_until_ready()
    while not bot.is_closed():
        try:
            now_str = datetime.now().strftime("%Y-%m-%d %H:%M")
            cursor.execute("""
                SELECT id, scheduled_at, pokemon_name, bonus_points, decay_percent,
                       game, indice, paliers_json, unique_wanted, alternates, created_by
                FROM scheduled_wanteds
                WHERE status='pending' AND scheduled_at <= ?
            """, (now_str,))
            rows = cursor.fetchall()
            for row in rows:
                await launch_scheduled_wanted(row)
        except Exception as e:
            logger.error(f"Erreur auto_scheduled_wanteds: {e}")
        await asyncio.sleep(30)


@bot.tree.command(
    name="admin_wanted_programmer",
    description="[ADMIN] Programmer le lancement d'un wanted à une date/heure précise",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    pokemon="Nom du Pokémon wanted",
    bonus_points="Points bonus pour le 1er trouveur",
    date_heure="Date et heure (format : JJ/MM/AAAA HH:MM — ex: 25/12/2025 20:00)",
    jeu="Jeu spécifique (optionnel)",
    indice="Indice (optionnel, met ??? dans l'alerte si défini)",
    unique="Bonus uniquement pour le 1er trouveur (défaut: False)",
    alternates="Pokémon alternatifs acceptés, séparés par virgules (optionnel)"
)
async def admin_wanted_programmer(
    interaction: discord.Interaction,
    pokemon: str,
    bonus_points: float,
    date_heure: str,
    jeu: str = None,
    indice: str = None,
    unique: bool = False,
    alternates: str = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    # Parser la date/heure
    try:
        dt = datetime.strptime(date_heure.strip(), "%d/%m/%Y %H:%M")
    except ValueError:
        await interaction.response.send_message(
            "❌ Format invalide. Utilisez **JJ/MM/AAAA HH:MM** — ex: `25/12/2025 20:00`",
            ephemeral=True
        )
        return

    if dt <= datetime.now():
        await interaction.response.send_message(
            "❌ La date doit être dans le futur !",
            ephemeral=True
        )
        return

    import json as _j
    paliers_json = None
    if unique:
        paliers = {"p1": bonus_points, "p2": 0, "p3": 0, "suite": 0}
        paliers_json = _j.dumps(paliers)

    alts_json = None
    if alternates:
        alt_list = [p.strip() for p in alternates.replace(';', ',').split(',') if p.strip()]
        alts_json = _j.dumps(alt_list) if alt_list else None

    cursor.execute("""
        INSERT INTO scheduled_wanteds
        (scheduled_at, pokemon_name, bonus_points, decay_percent, game, indice, paliers_json, unique_wanted, alternates, created_by)
        VALUES (?, ?, ?, 100.0, ?, ?, ?, ?, ?, ?)
    """, (
        dt.strftime("%Y-%m-%d %H:%M"),
        pokemon, bonus_points, jeu, indice, paliers_json,
        1 if unique else 0,
        alts_json,
        str(interaction.user.id)
    ))
    conn.commit()
    sched_id = cursor.lastrowid

    ts = int(dt.timestamp())
    unique_label = " | 🔒 Unique (1er seulement)" if unique else ""
    jeu_label = f" | 🎮 {jeu}" if jeu else ""
    alt_label = f"\n🔄 Alternates : {alternates}" if alternates else ""
    indice_label = f"\n🔍 Indice : {indice}" if indice else ""

    embed = discord.Embed(
        title="⏰ Wanted Programmé !",
        description=(
            f"Le wanted **{pokemon}** sera lancé automatiquement :\n"
            f"📅 <t:{ts}:F> (<t:{ts}:R>)\n\n"
            f"⭐ Bonus : **+{bonus_points} pts**{unique_label}{jeu_label}"
            f"{indice_label}{alt_label}"
        ),
        color=discord.Color.orange(),
        timestamp=datetime.now()
    )
    embed.set_footer(text=f"ShinyBot · Wanted Programmé #{sched_id} — Utilisez /admin_wanted_programmes pour voir la liste")
    await interaction.response.send_message(embed=embed, ephemeral=True)


@bot.tree.command(
    name="admin_wanted_programmes",
    description="[ADMIN] Voir et gérer les wanteds programmés",
    guild=discord.Object(id=GUILD_ID)
)
async def admin_wanted_programmes(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)

    cursor.execute("""
        SELECT id, scheduled_at, pokemon_name, bonus_points, game, unique_wanted, status
        FROM scheduled_wanteds
        ORDER BY scheduled_at ASC
        LIMIT 20
    """)
    rows = cursor.fetchall()

    if not rows:
        await interaction.followup.send("Aucun wanted programmé.", ephemeral=True)
        return

    embed = discord.Embed(
        title="⏰ Wanteds Programmés",
        color=discord.Color.orange(),
        timestamp=datetime.now()
    )

    for sid, scheduled_at, pname, bpts, game, unique_w, status in rows:
        try:
            dt = datetime.strptime(scheduled_at, "%Y-%m-%d %H:%M")
            ts = int(dt.timestamp())
            time_str = f"<t:{ts}:F> (<t:{ts}:R>)"
        except Exception:
            time_str = scheduled_at

        status_emoji = {"pending": "⏳", "launched": "✅", "cancelled": "❌"}.get(status, "❓")
        jeu_str = f" | {game}" if game else ""
        unique_str = " | 🔒 Unique" if unique_w else ""
        embed.add_field(
            name=f"{status_emoji} #{sid} — **{pname}**",
            value=f"{time_str}\n⭐ +{bpts} pts{jeu_str}{unique_str}",
            inline=False
        )

    embed.set_footer(text="Utilisez /admin_wanted_annuler_programme pour annuler un wanted en attente")
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="admin_wanted_annuler_programme",
    description="[ADMIN] Annuler un wanted programmé avant son lancement",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(programme_id="ID du wanted programmé (voir /admin_wanted_programmes)")
async def admin_wanted_annuler_programme(interaction: discord.Interaction, programme_id: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    cursor.execute("SELECT pokemon_name, status FROM scheduled_wanteds WHERE id=?", (programme_id,))
    row = cursor.fetchone()
    if not row:
        await interaction.response.send_message(f"❌ Wanted programmé #{programme_id} introuvable.", ephemeral=True)
        return
    pname, status = row
    if status != "pending":
        await interaction.response.send_message(
            f"❌ Le wanted **{pname}** a déjà été **{status}** et ne peut plus être annulé.",
            ephemeral=True
        )
        return

    cursor.execute("UPDATE scheduled_wanteds SET status='cancelled' WHERE id=?", (programme_id,))
    conn.commit()
    await interaction.response.send_message(
        f"✅ Wanted programmé **{pname}** (#{programme_id}) annulé.",
        ephemeral=True
    )


@bot.tree.command(
    name="ranked_regles",
    description="Voir les règles du ranked shiny hunting",
    guild=discord.Object(id=GUILD_ID)
)
async def ranked_regles(interaction: discord.Interaction):
    user_id = str(interaction.user.id)
    weekly_pts = get_user_weekly_pts(user_id)
    pos_mult = get_position_multiplier(user_id)
    ladder = get_ladder()
    rank = next((i+1 for i, r in enumerate(ladder) if str(r[0]) == user_id), None)

    def _eff_pct(x):
        if x <= WEEKLY_CAP:
            return 100
        return round((_weekly_soft_cap(x + 10) - _weekly_soft_cap(x)) / 10 * 100)

    embed = discord.Embed(
        title="📘 Règles Ranked Shiny",
        color=discord.Color.blurple(),
        timestamp=datetime.now()
    )
    embed.add_field(
        name="🧮 Ce qui compte pour le cap 250",
