    'quantity': 'Trouver X shinys avec la guilde',
    'points': 'Gagner X points avec la guilde',
    'method': 'Trouver un shiny avec une méthode précise',
    'game': 'Trouver un shiny dans un jeu précis',
    'pokemon': 'Trouver un Pokémon précis',
    'letter': 'Trouver un shiny commençant par une lettre',
    'starter': 'Trouver un Pokémon starter',
    'legendary': 'Trouver un Pokémon légendaire',
    'pokemon_type': "Trouver un shiny d'un type précis",
}


def get_active_guilde_weekly_objectives():
    week_start = get_current_week_start()
    cursor.execute("""
        SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
        FROM guilde_weekly_objectives
        WHERE week_start=? AND is_active=1
        ORDER BY difficulty DESC, id ASC
    """, (week_start,))
    rows = cursor.fetchall()
    return [
        {
            'id': r[0],
            'type': r[1],
            'description': r[2],
            'target_value': r[3],
            'bonus_points': r[4],
            'difficulty': r[5],
            'target_extra': r[6],
        }
        for r in rows
    ]


def get_guilde_weekly_choice(guilde_id):
    week_start = get_current_week_start()
    cursor.execute("""
        SELECT gwo.id, gwo.type, gwo.description, gwo.target_value,
               gwo.bonus_points, gwo.difficulty, gwo.target_extra
        FROM guilde_weekly_choices gwc
        JOIN guilde_weekly_objectives gwo ON gwo.id = gwc.objective_id
        WHERE gwc.guilde_id=? AND gwc.week_start=? AND gwo.is_active=1
    """, (guilde_id, week_start))
    row = cursor.fetchone()
    if not row:
        return None
    return {
        'id': row[0],
        'type': row[1],
        'description': row[2],
        'target_value': row[3],
        'bonus_points': row[4],
        'difficulty': row[5],
        'target_extra': row[6],
    }


def auto_assign_guilde_weekly_objective(guilde_ids=None, week_start=None):
    """Assigne automatiquement le même objectif hebdo (le premier objectif actif,
    selon l'ordre difficulté DESC puis id ASC) à toutes les guildes indiquées
    (ou à toutes les guildes existantes si guilde_ids est None).
    Ne fait rien si aucun objectif n'est actif cette semaine. Écrase un éventuel
    choix précédent : l'objectif de guilde n'est plus choisi par le leader,
    il est automatique et fixe pour toute la semaine."""
    week_start = week_start or get_current_week_start()
    objectives = get_active_guilde_weekly_objectives()
    if not objectives:
        return None
    objectif = objectives[0]

    if guilde_ids is None:
        cursor.execute("SELECT id FROM shinyhunter_guildes")
        guilde_ids = [r[0] for r in cursor.fetchall()]

    for gid in guilde_ids:
        cursor.execute("""
            INSERT INTO guilde_weekly_choices (guilde_id, week_start, objective_id, chosen_by)
            VALUES (?, ?, ?, 'auto')
            ON CONFLICT(guilde_id, week_start) DO UPDATE SET
                objective_id=excluded.objective_id,
                chosen_by='auto',
                chosen_at=datetime('now')
        """, (gid, week_start, objectif['id']))
    conn.commit()
    return objectif


def get_guilde_objective_progress(guilde_id, objective_id):
    cursor.execute("""
        SELECT current_value, completed, bonus_awarded
        FROM guilde_objectives_progress
        WHERE guilde_id=? AND objective_id=?
    """, (guilde_id, objective_id))
    row = cursor.fetchone()
    if row:
        return {'current_value': row[0], 'completed': row[1], 'bonus_awarded': row[2]}
    return {'current_value': 0, 'completed': 0, 'bonus_awarded': 0}


def upsert_guilde_objective_progress(guilde_id, objective_id, new_value, completed=False):
    cursor.execute("""
        INSERT INTO guilde_objectives_progress
            (guilde_id, objective_id, current_value, completed, completed_at, bonus_awarded)
        VALUES (?, ?, ?, ?, CASE WHEN ? THEN datetime('now') ELSE NULL END, 0)
        ON CONFLICT(guilde_id, objective_id) DO UPDATE SET
            current_value = excluded.current_value,
            completed = excluded.completed,
            completed_at = CASE WHEN excluded.completed AND completed_at IS NULL THEN datetime('now') ELSE completed_at END
    """, (guilde_id, objective_id, new_value, 1 if completed else 0, completed))
    conn.commit()


def award_guilde_objective_bonus(guilde_id, objective_id, bonus_points, description):
    """Répartit le bonus de guilde entre les membres actuels pour compter dans le classement guildes.
    Le montant est majoré par le multiplicateur du niveau de la guilde (perk de progression)."""
    members = guilde_get_members(guilde_id)
    if not members:
        return 0, 0

    cursor.execute("SELECT xp FROM shinyhunter_guildes WHERE id=?", (guilde_id,))
    row = cursor.fetchone()
    level_multiplier = get_guilde_level_info(row[0] if row else 0)['bonus_multiplier']
    bonus_points = round(float(bonus_points) * level_multiplier, 2)

    share = round(float(bonus_points) / len(members), 2)
    if share <= 0:
        return 0, len(members)
    cursor.execute("""
        UPDATE guilde_objectives_progress SET bonus_awarded=1
        WHERE guilde_id=? AND objective_id=?
    """, (guilde_id, objective_id))
    for uid, _ in members:
        award_capped_bonus(
            uid, f'[Objectif Guilde: {description[:35]}]', 'guilde_objective_bonus', share, game='Guilde'
        )
    conn.commit()
    return share, len(members)


def check_and_update_guilde_objective(user_id, pokemon, game, method_key, points_earned, type_pokemon=None):
    """Met à jour l'objectif hebdo choisi par la guilde du joueur."""
    guilde = guilde_of_user(user_id)
    if not guilde:
        return None
    guilde_id = guilde[0]
    obj = get_guilde_weekly_choice(guilde_id)
    if not obj:
        return None

    progress = get_guilde_objective_progress(guilde_id, obj['id'])
    if progress['completed'] and progress['bonus_awarded']:
        return None

    otype = obj['type']
    target = float(obj['target_value'] or 0)
    extra = obj['target_extra']
    current = float(progress['current_value'] or 0)
    new_val = current
    completed = bool(progress['completed'])

    if otype == 'quantity':
        new_val = current + 1
        completed = new_val >= target
    elif otype == 'points':
        new_val = current + float(points_earned or 0)
        completed = new_val >= target
    elif otype == 'method':
        if extra and normalize_str(method_key) == normalize_str(extra):
            new_val = current + 1
            completed = new_val >= target
    elif otype == 'game':
        if extra and game and normalize_str(extra) in normalize_str(game):
            new_val = current + 1
            completed = new_val >= target
    elif otype == 'pokemon':
        if extra and normalize_str(pokemon) == normalize_str(extra):
            new_val = current + 1
            completed = new_val >= target
    elif otype == 'letter':
        if extra and normalize_str(pokemon).startswith(normalize_str(extra)):
            new_val = current + 1
            completed = new_val >= target
    elif otype == 'starter':
        if normalize_str(pokemon) in get_special_list('starter'):
            new_val = current + 1
            completed = new_val >= target
    elif otype == 'legendary':
        if normalize_str(pokemon) in get_special_list('legendary'):
            new_val = current + 1
            completed = new_val >= target
    elif otype == 'pokemon_type':
        if extra and type_pokemon and normalize_str(type_pokemon) == normalize_str(extra):
            new_val = current + 1
            completed = new_val >= target

    if new_val != current or (completed and not progress['completed']):
        upsert_guilde_objective_progress(guilde_id, obj['id'], new_val, completed)

    if completed and not progress['bonus_awarded']:
        share, count = award_guilde_objective_bonus(guilde_id, obj['id'], obj['bonus_points'], obj['description'])
        return {
            'guilde': guilde,
            'objective': obj,
            'share': share,
            'members_count': count,
            'bonus': obj['bonus_points'],
        }
    return None


def format_guilde_objective_line(obj, progress=None):
    progress = progress or {'current_value': 0, 'completed': 0, 'bonus_awarded': 0}
    current = progress['current_value'] or 0
    target = obj['target_value'] or 0
    cur_txt = int(current) if current == int(current) else round(current, 1)
    tgt_txt = int(target) if target == int(target) else target
    status = "✅" if progress.get('bonus_awarded') else ("🟡" if progress.get('completed') else "⬜")
    extra_txt = f" · cible: `{obj['target_extra']}`" if obj.get('target_extra') else ""
    return (
        f"{status} `#{obj['id']}` **{obj['description']}**\n"
        f"Progression : **{cur_txt}/{tgt_txt}** · Bonus guilde : **+{obj['bonus_points']:.0f} pts**{extra_txt}"
    )


# ─── Table wanted personnel ───────────────────────────────────────────────────
cursor.execute("""
CREATE TABLE IF NOT EXISTS personal_wanted (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id     TEXT NOT NULL,
    pokemon     TEXT NOT NULL,
    generation  INTEGER NOT NULL,
    bonus_pts   REAL DEFAULT 20.0,
    expires_at  TEXT NOT NULL,
    claimed     INTEGER DEFAULT 0,
    claimed_at  TEXT DEFAULT NULL,
    created_at  TIMESTAMP DEFAULT CURRENT_TIMESTAMP
)
""")
conn.commit()

