# Recherche de la base de donnees existante ou creation dans un dossier accessible
def _find_db_path():
    _cwd = os.getcwd()
    candidates = [
        os.path.join(_cwd, 'shinybot.db'),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), 'shinybot.db'),
        '/home/container/shinybot.db',
    ]
    # Priorite 1 : base existante (pour ne jamais perdre les donnees)
    for path in candidates:
        if os.path.isfile(path):
            print(f"[DB] Base existante trouvee : {path}")
            return path
    # Priorite 2 : premier dossier accessible en ecriture
    for path in candidates:
        d = os.path.dirname(path)
        try:
            os.makedirs(d, exist_ok=True)
            test = path + ".writetest"
            with open(test, 'w') as f:
                f.write('test')
            os.remove(test)
            print(f"[DB] Nouvelle base sera creee : {path}")
            return path
        except Exception as e:
            print(f"[DB] Impossible d ecrire dans {d} : {e}")
            continue
    raise RuntimeError("[DB] ERREUR CRITIQUE : aucun dossier accessible en ecriture !")

