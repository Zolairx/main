def normalize_str(s):
    """Normalise une chaîne : minuscules + suppression des accents."""
    if not s:
        return ""
    nfkd = unicodedata.normalize('NFKD', s.lower())
    return ''.join(c for c in nfkd if not unicodedata.combining(c))

