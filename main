@bot.tree.command(
    name="classement_info",
    description="Voir les règles du système de points compétitif",
    guild=discord.Object(id=GUILD_ID)
)
async def classement_info(interaction: discord.Interaction):
    user_id = str(interaction.user.id)
    weekly_pts = get_user_weekly_pts(user_id)
    pos_mult = get_position_multiplier(user_id)
    ladder = get_ladder()
    rank = next((i+1 for i,r in enumerate(ladder) if str(r[0])==user_id), None)

    embed = discord.Embed(
        title="⚖️ Système de Points Compétitif",
        color=discord.Color.blurple(),
        timestamp=datetime.now()
    )

    embed.add_field(
        name="📈 Bonus de Comeback",
        value=(
            "🥇🥈🥉 Top 3 → **×0.9** (léger nerf)\n"
            "4ème–10ème → **×1.1** (+10%)\n"
            "11ème et au-delà → **×1.25** (+25%)\n"
            "*Aide les joueurs derrière à remonter !*"
        ),
        inline=False
    )
    # Calculer l'efficacité à différents paliers pour l'affichage
    def _eff_pct(x):
        if x <= WEEKLY_CAP: return 100
        return round((_weekly_soft_cap(x+10) - _weekly_soft_cap(x)) / 10 * 100)

    embed.add_field(
        name="📉 Soft Cap Hebdo Progressif",
        value=(
            f"Sous **{WEEKLY_CAP:.0f} pts** → 100% d'efficacité\n"
            f"À 300 pts → ~{_eff_pct(300)}% | À 500 pts → ~{_eff_pct(500)}%\n"
            f"À 700 pts → ~{_eff_pct(700)}% | À 1000 pts → ~{_eff_pct(1000)}%\n"
            "*Progression fluide et satisfaisante même après le cap*"
        ),
        inline=False
    )
    embed.add_field(
        name="🔄 Reset de Saison",
        value=(
            "Formule : **√(pts_total) × 20**\n"
            "Ex: 400 pts → 20×20 = 400 | 1600 pts → 40×20 = 800\n"
            "*Compresse les écarts, tout le monde repart proches*"
        ),
        inline=False
    )

    # Stats personnelles
    if rank:
        pos_label = ("🔴 Nerf ×0.9" if pos_mult < 1 else
                     "🟡 Bonus ×1.1" if pos_mult == 1.1 else
                     "🟢 Comeback ×1.25")
        remaining = max(0, WEEKLY_CAP - weekly_pts)
        _eff_now = _weekly_soft_cap(weekly_pts)
        _current_eff = round((_weekly_soft_cap(weekly_pts + 10) - _eff_now) / 10 * 100)
        embed.add_field(
            name=f"📊 Votre situation (#{rank})",
            value=(
                f"Multiplicateur position : **{pos_label}**\n"
                f"Points bruts cette semaine : **{weekly_pts:.1f} pts**\n"
                f"Points effectifs (après soft cap) : **{_eff_now:.1f} pts**\n"
                f"Efficacité marginale actuelle : **~{_current_eff}%**"
            ),
            inline=False
        )

    embed.set_footer(text="ShinyBot · Système Compétitif")
    await interaction.response.send_message(embed=embed, ephemeral=True)


