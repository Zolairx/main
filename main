class WantedGameSelectView(discord.ui.View):
    """Vue pour sélectionner le jeu obligatoire d'un wanted (après le modal)"""
    def __init__(self, pokemon, p1, p2, p3, p_suite, indice=None):
        super().__init__(timeout=300)
        self.pokemon = pokemon
        self.p1 = p1
        self.p2 = p2
        self.p3 = p3
        self.p_suite = p_suite
        self.indice = indice

        # Bouton "Tous jeux" toujours visible en premier
        btn_all = discord.ui.Button(
            label="🌍 Tous jeux (pas de restriction)",
            style=discord.ButtonStyle.success
        )
        btn_all.callback = self._make_game_callback("__all__")
        self.add_item(btn_all)

        # Selects des jeux
        game_options = [
            discord.SelectOption(label=translations["fr"][:100], value=game_key)
            for game_key, translations in GAMES.items()
        ]

        if len(game_options) <= 24:  # 24 car le bouton prend une place dans la vue
            select = discord.ui.Select(
                placeholder="🎮 Ou choisir un jeu spécifique",
                options=game_options,
                min_values=1,
                max_values=1
            )
            select.callback = self.game_selected
            self.add_item(select)
        else:
            select1 = discord.ui.Select(
                placeholder="🎮 Jeux (1/2)",
                options=game_options[:25],
                min_values=1,
                max_values=1
            )
            select1.callback = self.game_selected
            self.add_item(select1)
            select2 = discord.ui.Select(
                placeholder="🎮 Jeux (2/2)",
                options=game_options[25:],
                min_values=1,
                max_values=1
            )
            select2.callback = self.game_selected
            self.add_item(select2)

    def _make_game_callback(self, value):
        async def callback(interaction: discord.Interaction):
            await self._finalize(interaction, value)
        return callback

    async def game_selected(self, interaction: discord.Interaction):
        await self._finalize(interaction, interaction.data['values'][0])

    async def _finalize(self, interaction: discord.Interaction, selected: str):
        game_value = None if selected == "__all__" else GAMES[selected]["fr"]

        import json
        paliers = {"p1": self.p1, "p2": self.p2, "p3": self.p3, "suite": self.p_suite}
        paliers_json = json.dumps(paliers)

        cursor.execute("""
            INSERT INTO shiny_wanted (pokemon_name, bonus_points, decay_percent, game, paliers_json, indice, is_active, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, 1, datetime('now'))
        """, (self.pokemon, self.p1, 100.0, game_value, paliers_json, self.indice))
        conn.commit()
        wanted_id = cursor.lastrowid

        embed = discord.Embed(
            title="✅ Pokémon Wanted Ajouté !",
            description=f"Le wanted **{self.pokemon}** est maintenant actif.",
            color=discord.Color.green()
        )
        embed.add_field(name="🎯 Pokémon", value=f"**{self.pokemon}**", inline=True)
        embed.add_field(name="🆔 ID", value=str(wanted_id), inline=True)
        embed.add_field(
            name="💰 Points par palier",
            value=f"🥇 1er : **+{self.p1} pts**\n🥈 2e : **+{self.p2} pts**\n🥉 3e : **+{self.p3} pts**\n👥 Suivants : **+{self.p_suite} pts**",
            inline=False
        )
        if game_value:
            embed.add_field(name="🎮 Jeu obligatoire", value=f"**{game_value}**", inline=False)
        else:
            embed.add_field(name="🎮 Jeu", value="Libre (tous jeux acceptés)", inline=False)
        if self.indice:
            embed.add_field(name="🔍 Indice", value=self.indice, inline=False)
        embed.set_footer(text="ShinyBot - Options : alternates et/ou date de fin programmable (facultatif)")
        view = WantedAlternatesView(wanted_id, self.pokemon)
        await interaction.response.edit_message(embed=embed, view=view)


class WantedAlternatesModal(discord.ui.Modal):
    """Modal pour ajouter des Pokémon alternatifs à un wanted existant."""
    def __init__(self, wanted_id, main_pokemon):
        super().__init__(title="Ajouter des Pokémon alternatifs")
        self.wanted_id = wanted_id
        self.main_pokemon = main_pokemon
        self.alternates_input = discord.ui.TextInput(
            label="Pokémon acceptés (séparés par virgules)",
            placeholder="Ex: Évoli, Salamèche, Carapuce",
            required=True,
            max_length=500
        )
        self.add_item(self.alternates_input)

    async def on_submit(self, interaction: discord.Interaction):
        import json as _j
        raw = self.alternates_input.value.strip()
        alternates = [p.strip() for p in raw.replace(';', ',').split(',') if p.strip()]
        # Retirer le pokémon principal si inclus par erreur
        alternates = [p for p in alternates if p.lower() != self.main_pokemon.lower()]

        if not alternates:
            await interaction.response.send_message("❌ Aucun Pokémon valide.", ephemeral=True)
            return

        cursor.execute(
            "UPDATE shiny_wanted SET pokemon_alternates=? WHERE id=?",
            (_j.dumps(alternates), self.wanted_id)
        )
        conn.commit()
        alt_str = ", ".join(f"**{p}**" for p in alternates)
        embed = discord.Embed(
            title="✅ Wanted mis à jour !",
            description=(
                f"Le wanted **{self.main_pokemon}** accepte maintenant aussi :\n{alt_str}\n\n"
                f"🎯 N'importe lequel de ces Pokémon déclenchera le bonus !"
            ),
            color=discord.Color.green()
        )
        await interaction.response.send_message(embed=embed, ephemeral=True)


class WantedExpiryModal(discord.ui.Modal, title="Programmer une date de fin"):
    """Modal pour ajouter une date de fin programmable à un wanted existant."""
    date_input = discord.ui.TextInput(
        label="Date et heure de fin",
        placeholder="Ex: 25/12/2025 20:00 (format JJ/MM/AAAA HH:MM)",
        required=True,
        max_length=20
    )

    def __init__(self, wanted_id, main_pokemon):
        super().__init__()
        self.wanted_id = wanted_id
        self.main_pokemon = main_pokemon

    async def on_submit(self, interaction: discord.Interaction):
        expires_dt, error_msg = parse_wanted_end_date(self.date_input.value)
        if error_msg:
            await interaction.response.send_message(error_msg, ephemeral=True)
            return
        cursor.execute(
            "UPDATE shiny_wanted SET expires_at=? WHERE id=?",
            (expires_dt.strftime("%Y-%m-%d %H:%M"), self.wanted_id)
        )
        conn.commit()
        ts = int(expires_dt.timestamp())
        embed = discord.Embed(
            title="✅ Date de fin programmée !",
            description=f"Le wanted **{self.main_pokemon}** se terminera automatiquement le <t:{ts}:F> (<t:{ts}:R>).",
            color=discord.Color.green()
        )
        await interaction.response.send_message(embed=embed, ephemeral=True)


class WantedAlternatesView(discord.ui.View):
    """Vue affichée après création d'un wanted — permet d'ajouter des alternates et/ou une date de fin."""
    def __init__(self, wanted_id, main_pokemon):
        super().__init__(timeout=300)
        self.wanted_id = wanted_id
        self.main_pokemon = main_pokemon

        btn_add = discord.ui.Button(
            label="➕ Ajouter des Pokémon alternatifs",
            style=discord.ButtonStyle.primary
        )
        btn_add.callback = self._add_alternates
        self.add_item(btn_add)

        btn_expiry = discord.ui.Button(
            label="📅 Programmer une date de fin",
            style=discord.ButtonStyle.primary
        )
        btn_expiry.callback = self._add_expiry
        self.add_item(btn_expiry)

        btn_skip = discord.ui.Button(
            label="✅ Terminer",
            style=discord.ButtonStyle.secondary
        )
        btn_skip.callback = self._skip
        self.add_item(btn_skip)

    async def _add_alternates(self, interaction: discord.Interaction):
        modal = WantedAlternatesModal(self.wanted_id, self.main_pokemon)
        await interaction.response.send_modal(modal)

    async def _add_expiry(self, interaction: discord.Interaction):
        modal = WantedExpiryModal(self.wanted_id, self.main_pokemon)
        await interaction.response.send_modal(modal)

    async def _skip(self, interaction: discord.Interaction):
        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(
            content="✅ Wanted créé sans Pokémon alternatifs.",
            view=self
        )


class WantedSetupModal(discord.ui.Modal, title="Créer un Pokémon Wanted"):
    pokemon_name_input = discord.ui.TextInput(
        label="Nom du Pokémon",
        placeholder="Ex: Pikachu",
        required=True,
        max_length=50
    )
    points_1er = discord.ui.TextInput(
        label="Points pour le 1er",
        placeholder="Ex: 10",
        required=True,
        max_length=6
    )
    points_2e = discord.ui.TextInput(
        label="Points 2e (vide = même que 1er)",
        placeholder="Ex: 7",
        required=False,
        max_length=6
    )
    points_3e = discord.ui.TextInput(
        label="Points 3e (vide = même que 2e)",
        placeholder="Ex: 5",
        required=False,
        max_length=6
    )
    indice_input = discord.ui.TextInput(
        label="Indice (optionnel)",
        placeholder="Ex: C'est un Pokémon de type Feu de la Gen 1",
        required=False,
        max_length=200
    )

    async def on_submit(self, interaction: discord.Interaction):
        def parse_pts(val, fallback):
            if not val or not val.strip():
                return fallback
            try:
                return float(val.strip().replace(',', '.'))
            except ValueError:
                return None

        p1 = parse_pts(self.points_1er.value, None)
        if p1 is None or p1 <= 0:
            await interaction.response.send_message("❌ Points du 1er invalides ou nuls.", ephemeral=True)
            return

        p2 = parse_pts(self.points_2e.value, p1)
        p3 = parse_pts(self.points_3e.value, p2)
        p_suite = p3  # Points suivants = même que le 3e

        if None in (p2, p3, p_suite):
            await interaction.response.send_message("❌ Une valeur de points est invalide.", ephemeral=True)
            return

        indice = self.indice_input.value.strip() or None

        embed = discord.Embed(
            title="🎯 Wanted — Choisissez le jeu",
            description=f"Pokémon : **{self.pokemon_name_input.value}**\n\nSélectionnez le jeu obligatoire ci-dessous, ou **Tous jeux** pour aucune restriction :",
            color=discord.Color.orange()
        )
        embed.add_field(
            name="💰 Points configurés",
            value=f"🥇 1er : **+{p1} pts**\n🥈 2e : **+{p2} pts**\n🥉 3e : **+{p3} pts**\n👥 Suivants : **+{p_suite} pts**",
            inline=False
        )
        if indice:
            embed.add_field(name="🔍 Indice", value=indice, inline=False)
        view = WantedGameSelectView(self.pokemon_name_input.value, p1, p2, p3, p_suite, indice)
        await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


