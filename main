class AdminShinyModal(discord.ui.Modal):
    def __init__(self, language, game_key, method_key, target_member, hunt_type="emulators"):
        self.language = language
        self.game_key = game_key
        self.method_key = method_key
        self.target_member = target_member
        self.hunt_type = hunt_type
        self._type_pokemon = None
        
        title = "Admin - Informations du Shiny" if language == "Français" else "Admin - Shiny Information"
        super().__init__(title=title)
        
        pokemon_label = "Nom du Pokémon" if language == "Français" else "Pokémon Name"
        pokemon_placeholder = "Ex: Pikachu" if language == "Français" else "Ex: Pikachu"
        self.pokemon = discord.ui.TextInput(
            label=pokemon_label,
            placeholder=pokemon_placeholder,
            required=True,
            max_length=50
        )
        self.add_item(self.pokemon)

        # Champ Nombre de consoles/émulateurs
        console_label = "Combien de consoles / émulateurs ?" if language == "Français" else "How many consoles/emulators?"
        console_placeholder = "Entrez un nombre (1-20)" if language == "Français" else "Enter a number (1-20)"
        self.console_count = discord.ui.TextInput(
            label=console_label,
            placeholder=console_placeholder,
            required=True,
            max_length=2,
            default="1"
        )
        self.add_item(self.console_count)

        # Champ Compteur de shasse
        counter_label = "Compteur de la shasse (rencontres/resets)" if language == "Français" else "Hunt counter (encounters/resets)"
        counter_placeholder = "Ex: 1234 (optionnel)" if language == "Français" else "Ex: 1234 (optional)"
        self.hunt_counter = discord.ui.TextInput(
            label=counter_label,
            placeholder=counter_placeholder,
            required=False,
            max_length=10,
            default="0"
        )
        self.add_item(self.hunt_counter)

        # Champ Wanted Mystère — Discord ne propose pas de vraie case à cocher
        # dans un modal (seulement du texte), donc on demande "oui"/"non".
        mystere_label = "Pour un Wanted Mystère ? (oui/non)" if language == "Français" else "For a Mystery Wanted? (yes/no)"
        mystere_placeholder = "Laisser vide si non" if language == "Français" else "Leave empty if no"
        self.wanted_mystere = discord.ui.TextInput(
            label=mystere_label,
            placeholder=mystere_placeholder,
            required=False,
            max_length=5
        )
        self.add_item(self.wanted_mystere)

    async def on_submit(self, interaction: discord.Interaction):
        async def _process_admin_submission(**kwargs):
            await interaction.response.defer()

            date_obj = datetime.now()
            date_formatted = date_obj.strftime("%d-%m-%Y")

            # Récupérer et valider le nombre de consoles
            try:
                console_count = int(self.console_count.value)
                if console_count < 1:
                    console_count = 1
            except ValueError:
                console_count = 1

            # Récupérer le compteur de shasse
            try:
                hunt_counter = int(self.hunt_counter.value) if self.hunt_counter.value else 0
            except ValueError:
                hunt_counter = 0

            # Ce shiny est-il chassé pour un wanted mystère ?
            is_for_mystery_wanted = self.wanted_mystere.value.strip().lower() in ("oui", "o", "yes", "y")

            points = calculate_points(self.game_key, self.method_key, console_count, self.hunt_type)
            game_name = GAMES[self.game_key]["fr" if self.language == "Français" else "en"]

            lang_code = "fr" if self.language == "Français" else "en"
            method_name = METHODS_BY_GAME[self.game_key][self.method_key][lang_code]

            # Validations spécifiques pour Z-A
            if self.game_key == "za":
                # Vérifier si c'est un doublon pendant la saison
                if check_duplicate_shiny_za(str(self.target_member.id), self.pokemon.value):
                    error_msg = "❌ Ce shiny est déjà enregistré pour Z-A (toutes méthodes) et ne compte pas." if self.language == "Français" else "❌ This shiny is already recorded for Z-A (all methods) and doesn't count."
                    await interaction.followup.send(error_msg, ephemeral=True)
                    return None

            # Récupérer le rang AVANT l'ajout du shiny
            old_rank, old_points = get_user_rank(str(self.target_member.id))
            badge_codes_before = {b[0] for b in get_user_badges(str(self.target_member.id))}
            
            # Ajouter le shiny (avec vérification du wanted)
            total_points, bonus_points, is_wanted, objective_bonuses, special_bonuses = add_shiny(
                str(self.target_member.id), self.pokemon.value, game_name, self.method_key,
                date_formatted, points, lang_code, console_count, hunt_counter, self.hunt_type,
                type_pokemon=getattr(self, '_type_pokemon', None),
                for_mystery_wanted=is_for_mystery_wanted
            )
            mystery_reveals = getattr(add_shiny, '_last_mystery_reveals', [])
            bounty_events = getattr(add_shiny, '_last_bounty_events', [])
            parrain_notify = getattr(add_shiny, '_last_parrain_notify', None)
            if parrain_notify:
                _pn_id2, _pn_filleul_eff2, _pn_parrain_eff2 = parrain_notify
                asyncio.create_task(notify_parrain_bonus(
                    _pn_id2, self.target_member, self.pokemon.value,
                    filleul_effective=_pn_filleul_eff2, parrain_effective=_pn_parrain_eff2
                ))
            
            # Vérifier toutes les races 1v1 actives pour ce Pokémon
            race_bonus_points = 0
            race_won = False
            all_races = get_all_active_races_for_user_and_pokemon(str(self.target_member.id), self.pokemon.value)
            for race_info in all_races:
                mark_race_won(race_info['id'], str(self.target_member.id))
                _race_eff3 = apply_bonus_diminishing_returns(str(self.target_member.id), float(race_info['bonus_points']))
                add_user_weekly_bonus_pts(str(self.target_member.id), float(race_info['bonus_points']))
                race_bonus_points += _race_eff3
                race_won = True
                cursor.execute(
                    "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter, hunt_type) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?, ?, ?, ?)",
                    (str(self.target_member.id), f"[Race Bonus] {self.pokemon.value}", game_name, "race_bonus", date_formatted, _race_eff3, lang_code, 1, 0, self.hunt_type)
                )
                conn.commit()
            if race_won:
                try:
                    update_race_win_objective(str(self.target_member.id))
                    update_monthly_race_win_objective(str(self.target_member.id))
                except Exception as e:
                    logger.error(f"Erreur objectif race_win admin: {e}")

            # Vérifier les races ouvertes actives (nouveau système, participants illimités)
            open_race_matches = get_active_open_races_for_user_and_pokemon(str(self.target_member.id), self.pokemon.value)
            for race_info in open_race_matches:
                if race_info['game'] and normalize_str(race_info['game']) != normalize_str(game_name):
                    continue
                if race_info['method_key'] and race_info['method_key'] != self.method_key:
                    continue
                if race_info['max_consoles'] and console_count and console_count > race_info['max_consoles']:
                    continue
                finished = finish_open_race(race_info['id'], str(self.target_member.id))
                if not finished:
                    continue
                if finished['awarded_points'] > 0:
                    _race_eff4 = apply_bonus_diminishing_returns(str(self.target_member.id), float(finished['awarded_points']))
                    add_user_weekly_bonus_pts(str(self.target_member.id), float(finished['awarded_points']))
                    race_bonus_points += _race_eff4
                    race_won = True
                    cursor.execute(
                        "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter, hunt_type) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?, ?, ?, ?)",
                        (str(self.target_member.id), f"[Race Ouverte] {self.pokemon.value}", game_name, "race_bonus", date_formatted, _race_eff4, lang_code, 1, 0, self.hunt_type)
                    )
                    conn.commit()
                    try:
                        update_race_win_objective(str(self.target_member.id))
                        update_monthly_race_win_objective(str(self.target_member.id))
                    except Exception as e:
                        logger.error(f"Erreur objectif race_win admin (ouverte): {e}")
                asyncio.create_task(close_open_race_message(race_info['id'], winner_member=self.target_member))

            # Vérifier si une race en équipe est en cours
            team_race_bonus = 0
            team_race_msg = None
            try:
                guild = bot.get_guild(GUILD_ID)
                team_race_bonus, team_race_msg = await handle_team_race_point(str(self.target_member.id), self.pokemon.value, guild)
                if team_race_msg:
                    channel = bot.get_channel(SALON_CLASSEMENT_ID)
                    if channel:
                        await channel.send(team_race_msg)
                if team_race_bonus > 0:
                    try:
                        update_race_win_objective(str(self.target_member.id))
                    except Exception as e:
                        logger.error(f"Erreur objectif race_win équipe admin: {e}")
            except Exception as e:
                logger.error(f"Erreur handle_team_race_point admin: {e}")

            try:
                check_and_award_badges(str(self.target_member.id))
                new_badges = get_new_badges_since(str(self.target_member.id), badge_codes_before)
            except Exception as e:
                logger.error(f"Erreur récupération nouveaux badges admin: {e}")
                new_badges = []
            
            # Vérifier si le rang a changé
            rank_change_data = check_rank_change(str(self.target_member.id), old_rank, old_points)
            if rank_change_data:
                # Envoyer le message de félicitations en arrière-plan
                lang_code_for_msg = lang_code if lang_code else "fr"
                asyncio.create_task(send_rank_up_message(
                    self.target_member, 
                    rank_change_data, 
                    self.pokemon.value, 
                    points, 
                    lang_code_for_msg
                ))
            _new_rank_a, _new_pts_a = get_user_rank(str(self.target_member.id))

            # Vérifier si le rang de progression personnel a changé (indépendant du classement)
            _progression_change_a = check_progression_tier_change(old_points, _new_pts_a)
            if _progression_change_a:
                lang_code_for_msg = lang_code if lang_code else "fr"
                asyncio.create_task(send_progression_rank_up_message(
                    self.target_member, _progression_change_a, self.pokemon.value, points, lang_code_for_msg
                ))
            
            color = self.target_member.color if hasattr(self.target_member, "color") and self.target_member.color.value else discord.Color.gold()
            
            embed = discord.Embed(
                title="🛡️ Shiny Ajouté par un Admin ! ✨",
                description=f"Un shiny a été ajouté à {self.target_member.mention} par {interaction.user.mention}",
                color=color,
                timestamp=date_obj
            )
            embed.set_author(name=f"Shiny ajouté à {self.target_member.display_name}", icon_url=self.target_member.display_avatar.url)
            embed.set_thumbnail(url=self.target_member.display_avatar.url)
            cursor.execute("SELECT id FROM shiny_wanted WHERE is_active=1 AND LOWER(pokemon_name)=LOWER(?) AND indice IS NOT NULL AND indice != ''", (self.pokemon.value,))
            _mrow = cursor.fetchone()
            _is_myst = False
            if _mrow:
                cursor.execute("SELECT indice FROM shiny_wanted WHERE id=?", (_mrow[0],))
                _ri = cursor.fetchone()
                _is_myst = _ri and _ri[0] and not _ri[0].strip().startswith("[Méthode :")
            _admin_poke = "???" if _is_myst else self.pokemon.value
            embed.add_field(name="Pokémon", value=_admin_poke, inline=True)
            embed.add_field(name="Jeu", value=game_name, inline=True)
            embed.add_field(name="Méthode", value=method_name, inline=True)
            embed.add_field(name="Date", value=date_formatted, inline=True)
            # Afficher les points avec bonus si applicable
            # ── Points attribués (admin embed) ────────────────────────────────
            _pos_mult_a = getattr(add_shiny, '_last_pos_mult', 1.0)
            _ev_mult_a  = getattr(add_shiny, '_last_event_mult', 1.0)

            pts_lines_a = [f"**{points}** ⭐ (base)"]
            if getattr(add_shiny, '_last_new_game_bonus', False):
                pts_lines_a.append(f"+ **{round(points*0.10,2)}** 🗺️ (nouveau jeu +10%)")
            if _ev_mult_a != 1.0:
                pts_lines_a.append(f"× **{_ev_mult_a}** 🎉 (événement)")
            if _pos_mult_a != 1.0:
                pts_lines_a.append(f"× **{_pos_mult_a:.2f}** {'📈' if _pos_mult_a > 1 else '📉'} (position)")
            if is_wanted and bonus_points > 0:
                pts_lines_a.append(f"+ **{bonus_points:.2f}** 🎯 (wanted)")

            sp_total_a  = sum(p for _, p in special_bonuses)
            obj_total_a = sum(p for _, p in objective_bonuses)
            grand_total_a = round(total_points + sp_total_a + obj_total_a + race_bonus_points, 2)

            points_display = "\n".join(pts_lines_a)
            points_display += f"\n= **{total_points:.2f} ⭐** (shiny effectif)"
            if sp_total_a > 0:
                points_display += f"\n+ **{sp_total_a:.2f}** 🎁 (bonus spéciaux)"
            if race_bonus_points > 0:
                points_display += f"\n+ **{race_bonus_points}** 🏁 (race)"
            if obj_total_a > 0:
                points_display += f"\n+ **{obj_total_a:.2f}** 📅 (objectifs)"
            points_display += f"\n🏆 **Total : {grand_total_a:.2f} ⭐**"

            embed.add_field(name="Points attribués", value=points_display[:1024], inline=False)

            summary_value_a = build_smart_shiny_summary(
                language=self.language,
                game_key=self.game_key,
                method_key=self.method_key,
                grand_total=grand_total_a,
                total_points=total_points,
                sp_total=sp_total_a,
                obj_total=obj_total_a,
                race_total=race_bonus_points,
                objective_bonuses=objective_bonuses,
                special_bonuses=special_bonuses,
                is_wanted=is_wanted,
                bonus_points=bonus_points,
                rank_change_data=rank_change_data,
                new_rank=_new_rank_a,
                new_badges=new_badges,
                bounty_events=bounty_events,
                mystery_reveals=[],
                team_race_msg=team_race_msg,
            )
            embed.add_field(
                name="🧠 Résumé intelligent" if self.language == "Français" else "🧠 Smart Summary",
                value=summary_value_a,
                inline=False
            )

            # Ajouter messages spéciaux
            if is_wanted and bonus_points > 0:
                wanted_msg = f"🎯 **BONUS WANTED !** Le Pokémon recherché a été trouvé ! +{bonus_points} points bonus !" if self.language == "Français" else f"🎯 **WANTED BONUS !** The wanted Pokémon was found! +{bonus_points} bonus points!"
                embed.add_field(name="🎯 Bonus Wanted", value=wanted_msg, inline=False)

            # ── Field unique bonus (admin embed) ─────────────────────────────
            bonus_lines_a = []
            if is_wanted and bonus_points > 0:
                bonus_lines_a.append(f"🎯 **Wanted !** +{bonus_points:.2f} pts")
            if race_won and race_bonus_points > 0:
                nb_races_a = len(all_races)
                race_lbl_a = "RACE GAGNÉE" if nb_races_a == 1 else f"{nb_races_a} RACES GAGNÉES"
                bonus_lines_a.append(f"🏁 **{race_lbl_a} !** +{race_bonus_points} pts")
            if team_race_msg:
                bonus_lines_a.append(f"⚔️ {team_race_msg[:150]}")
            for desc, pts in objective_bonuses:
                bonus_lines_a.append(f"✅ {desc} → +{pts} pts")
            for label, pts in special_bonuses:
                bonus_lines_a.append(f"🎁 {label} → +{pts} pts" if pts else f"🎁 {label}")
            if getattr(add_shiny, '_last_new_game_bonus', False):
                bonus_lines_a.append("🗺️ Nouveau jeu — **+10% accordé !**")
            if bonus_lines_a:
                embed.add_field(name="🎁 Bonus & Événements", value="\n".join(bonus_lines_a)[:1024], inline=False)

            embed.add_field(name="Admin", value=interaction.user.mention, inline=True)

            if console_count > 1:
                console_field = "Consoles/Émulateurs" if self.language == "Français" else "Consoles/Emulators"
                embed.add_field(name=console_field, value=f"{console_count}", inline=True)

            if hunt_counter > 0:
                counter_field = "Compteur" if self.language == "Français" else "Counter"
                embed.add_field(name=counter_field, value=f"{hunt_counter}", inline=True)
            embed.set_footer(text="ShinyBot - Ajout administrateur")
            
            await interaction.followup.send(embed=embed)

            if mystery_reveals:
                for wid, masked, count in mystery_reveals:
                    dm_text = (
                        f"🔍 **Wanted mystère** — {count} shinys chassés pour ce wanted !\n"
                        f"Une nouvelle lettre t'est révélée (juste à toi) : `{masked}`"
                    )
                    try:
                        await self.target_member.send(dm_text)
                    except Exception:
                        await interaction.followup.send(
                            f"⚠️ Impossible d'envoyer la révélation en MP à {self.target_member.mention} (MPs fermés) : `{masked}`",
                            ephemeral=True
                        )
            
            # Programmer la mise à jour du classement avec un délai équilibré
            async def delayed_update():
                await asyncio.sleep(3)  # Réduit de 10s à 3s pour une meilleure expérience
                await update_classement_message()
            asyncio.create_task(delayed_update())
            return True
        
        result = await discord_retry_wrapper(
            _process_admin_submission,
            context="Admin Shiny Modal Submit"
        )
        
        if result is None:
            try:
                if interaction.response.is_done():
                    await interaction.followup.send(f"❌ Une erreur s'est produite lors de l'ajout du shiny.", ephemeral=True)
                else:
                    await interaction.response.send_message(f"❌ Une erreur s'est produite lors de l'ajout du shiny.", ephemeral=True)
            except:
                logger.error("Impossible d'envoyer le message d'erreur admin à l'utilisateur")

class AddCandidateModal(discord.ui.Modal):
    def __init__(self, image_url=None):
        super().__init__(title="Ajouter un Pokémon Shiny au vote")

        self.uploaded_image_url = image_url

        self.pokemon_name = discord.ui.TextInput(
            label="Nom du Pokémon",
            placeholder="Ex: Pikachu",
            required=True,
            max_length=50
        )
        self.add_item(self.pokemon_name)

        if not image_url:
            self.image_url = discord.ui.TextInput(
                label="URL de l'image (optionnel)",
                placeholder="https://... (ou utilisez le paramètre image)",
                required=False,
                max_length=500
            )
            self.add_item(self.image_url)
        else:
            self.image_url = None

        self.encounters = discord.ui.TextInput(
            label="Nombre de rencontres/resets",
            placeholder="Ex: 1234",
            required=True,
            max_length=10
        )
        self.add_item(self.encounters)

        self.game = discord.ui.TextInput(
            label="Nom du jeu",
            placeholder="Ex: Pokémon Écarlate",
            required=True,
            max_length=100
        )
        self.add_item(self.game)

        self.method = discord.ui.TextInput(
            label="Méthode de chasse",
            placeholder="Ex: Full Odds",
            required=True,
            max_length=100
        )
        self.add_item(self.method)

    async def on_submit(self, interaction: discord.Interaction):
        async def _process_candidate(**kwargs):
            await interaction.response.defer(ephemeral=True)

            try:
                encounters_count = int(self.encounters.value)
            except ValueError:
                encounters_count = 0

            final_image_url = self.uploaded_image_url
            if not final_image_url and self.image_url:
                final_image_url = self.image_url.value if self.image_url.value else None

            success, message = add_shiny_candidate(
                self.pokemon_name.value,
                final_image_url,
                encounters_count,
                self.game.value,
                self.method.value,
                str(interaction.user.id)
            )

            if success:
                embed = discord.Embed(
                    title="✅ Pokémon ajouté au vote",
                    description=f"**{self.pokemon_name.value}** a été ajouté à la liste des candidats !",
                    color=discord.Color.green()
                )
                embed.add_field(name="Jeu", value=self.game.value, inline=True)
                embed.add_field(name="Méthode", value=self.method.value, inline=True)
                embed.add_field(name="Rencontres", value=str(encounters_count), inline=True)

                if final_image_url:
                    embed.set_thumbnail(url=final_image_url)

                embed.set_footer(text=f"Ajouté par {interaction.user.display_name}")
                await interaction.followup.send(embed=embed, ephemeral=True)
            else:
                await interaction.followup.send(f"❌ {message}", ephemeral=True)

            return success

        await discord_retry_wrapper(_process_candidate, context="Add Candidate Modal")

class VoteSelectView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=300)
        self.selected_votes = []

        candidates = get_shiny_candidates()

        if not candidates:
            return

        options = []
        for candidate in candidates:
            cand_id, pokemon_name, image_url, encounters, game, method = candidate
            label = f"{pokemon_name} ({game})"
            description = f"{method} - {encounters} rencontres"
            if len(description) > 100:
                description = description[:97] + "..."
            options.append(discord.SelectOption(
                label=label[:100],
                value=str(cand_id),
                description=description
            ))

        if len(options) > 25:
            options = options[:25]

        select = discord.ui.Select(
            placeholder="Sélectionnez jusqu'à 3 Pokémon",
            options=options,
            min_values=1,
            max_values=min(3, len(options))
        )
        select.callback = self.select_callback
        self.add_item(select)

    async def select_callback(self, interaction: discord.Interaction):
        async def _handle_vote_selection(**kwargs):
            self.selected_votes = [int(val) for val in interaction.data['values']]

            candidates = get_shiny_candidates()
            selected_names = []
            for cand in candidates:
                if cand[0] in self.selected_votes:
                    selected_names.append(cand[1])

            embed = discord.Embed(
                title="✅ Sélection confirmée",
                description="Vous avez sélectionné les Pokémon suivants :\n" + "\n".join([f"• {name}" for name in selected_names]),
                color=discord.Color.blue()
            )
            embed.set_footer(text="Cliquez sur 'Valider le vote' pour enregistrer")

            confirm_view = ConfirmVoteView(self.selected_votes)
            await interaction.response.edit_message(embed=embed, view=confirm_view)
            return True

        await discord_retry_wrapper(_handle_vote_selection, context="Vote Selection")

class ConfirmVoteView(discord.ui.View):
    def __init__(self, selected_votes):
        super().__init__(timeout=60)
        self.selected_votes = selected_votes

    @discord.ui.button(label="✅ Valider le vote", style=discord.ButtonStyle.success)
    async def confirm(self, interaction: discord.Interaction, button: discord.ui.Button):
        async def _confirm_vote(**kwargs):
            await interaction.response.defer(ephemeral=True)

            add_user_vote(str(interaction.user.id), self.selected_votes)

            embed = discord.Embed(
                title="🎉 Vote enregistré !",
                description=f"Votre vote pour le **Shiny du Mois** a été enregistré avec succès !",
                color=discord.Color.gold()
            )
            embed.set_footer(text="Merci de votre participation !")

            await interaction.followup.send(embed=embed, ephemeral=True)
            return True

        await discord_retry_wrapper(_confirm_vote, context="Confirm Vote")

    @discord.ui.button(label="❌ Annuler", style=discord.ButtonStyle.secondary)
    async def cancel(self, interaction: discord.Interaction, button: discord.ui.Button):
        async def _cancel_vote(**kwargs):
            embed = discord.Embed(
                title="Vote annulé",
                description="Votre vote n'a pas été enregistré.",
                color=discord.Color.light_grey()
            )
            await interaction.response.edit_message(embed=embed, view=None)
            return True

        await discord_retry_wrapper(_cancel_vote, context="Cancel Vote")

