    )


class GuildeSemaineMultiSelect(discord.ui.View):
    """Permet de choisir plusieurs objectifs du pool à activer pour la semaine,
    sans avoir à taper une liste d'IDs à la main."""
    def __init__(self, pool_rows, week_start):
        super().__init__(timeout=180)
        self.week_start = week_start
        diff_emoji = {"easy": "🟢", "medium": "🟡", "hard": "🔴"}
        options = []
        for oid, desc, diff, bonus in pool_rows:
            emoji = diff_emoji.get(diff, "")
            options.append(discord.SelectOption(
                label=desc[:100],
                value=str(oid),
                description=f"{emoji} +{bonus:g} pts"[:100]
            ))
        select = discord.ui.Select(
            placeholder="Choisis un ou plusieurs objectifs",
            min_values=1,
            max_values=len(options),
            options=options
        )
        select.callback = self.on_select
        self.add_item(select)

    async def on_select(self, interaction: discord.Interaction):
        ids = [int(v) for v in interaction.data['values']]
        cursor.execute("UPDATE guilde_weekly_objectives SET is_active=0 WHERE week_start=?", (self.week_start,))
        added = 0
        for oid in ids:
            cursor.execute("""
                SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
                FROM guilde_objectives_pool WHERE id=? AND is_active=1
            """, (oid,))
            row = cursor.fetchone()
            if not row:
                continue
            pool_id, otype, desc, target, bonus, diff, extra_db = row
            cursor.execute("""
                INSERT INTO guilde_weekly_objectives
                    (pool_id, type, description, target_value, bonus_points, difficulty, target_extra, week_start, created_by)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (pool_id, otype, desc, target, bonus, diff, extra_db, self.week_start, str(interaction.user.id)))
            added += 1
        cursor.execute("DELETE FROM guilde_weekly_choices WHERE week_start=?", (self.week_start,))
        conn.commit()
        await interaction.response.edit_message(
            content=f"✅ {added} objectif(s) proposé(s) aux guildes pour la semaine du **{self.week_start}**.",
            view=None
        )


@bot.tree.command(
    name="guilde_admin",
    description="[ADMIN] Gérer les guildes et le pool d'objectifs",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    action="Action à effectuer",
    objectif_id="ID de l'objectif pour remove",
    ids_semaine="Pour 'semaine' : IDs séparés par virgule — ex: 1,4,7",
    type_objectif="Pour 'add' : quantity / points / method / game / pokemon / letter / starter / legendary / pokemon_type",
    description="Pour 'add' : texte affiché aux guildes · Pour 'renommer' : nouveau nom de la guilde",
    cible="Pour 'add' : valeur à atteindre · Pour 'logo/renommer/membre_ajouter/membre_retirer' : nom de la guilde",
    bonus_points="Pour 'add' : bonus total accordé à la guilde",
    difficulte="Pour 'add' : easy / medium / hard",
    extra="Pour 'add' : cible optionnelle · Pour 'logo' : URL de l'image · Pour 'membre_ajouter' : mention du joueur",
    membre="Pour 'membre_ajouter' ou 'membre_retirer' : le joueur concerné (doit être encore sur le serveur)",
    membre_id="Pour 'membre_retirer' uniquement : ID Discord du joueur, utile s'il a quitté le serveur (clic droit > Copier l'ID)"
)
@app_commands.choices(
    action=[
        app_commands.Choice(name="pool — voir tous les objectifs du pool",          value="pool"),
        app_commands.Choice(name="add — ajouter un objectif au pool",               value="add"),
        app_commands.Choice(name="remove — retirer un objectif du pool",            value="remove"),
        app_commands.Choice(name="semaine — définir les objectifs de la semaine",   value="semaine"),
        app_commands.Choice(name="reset — vider les objectifs de la semaine",       value="reset"),
        app_commands.Choice(name="membre_ajouter — ajouter un joueur dans une guilde", value="membre_ajouter"),
        app_commands.Choice(name="membre_retirer — retirer un joueur d'une guilde",    value="membre_retirer"),
        app_commands.Choice(name="renommer — renommer une guilde",                  value="renommer"),
        app_commands.Choice(name="logo — définir le logo d'une guilde (URL)",       value="logo"),
    ],
    difficulte=[
        app_commands.Choice(name="🟢 easy",   value="easy"),
        app_commands.Choice(name="🟡 medium", value="medium"),
        app_commands.Choice(name="🔴 hard",   value="hard"),
    ],
    type_objectif=[
        app_commands.Choice(name=label, value=key)
        for key, label in GUILDE_OBJECTIVE_TYPES.items()
    ]
)
async def guilde_admin(
    interaction: discord.Interaction,
    action: str,
    objectif_id: int = None,
    ids_semaine: str = None,
    type_objectif: str = None,
    description: str = None,
    cible: float = None,
    bonus_points: float = None,
    difficulte: str = None,
    extra: str = None,
    membre: discord.Member = None,
    membre_id: str = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    week_start = get_current_week_start()

    # ── Ajouter un membre dans une guilde ─────────────────────────────────────
    if action == "membre_ajouter":
        if not membre or not cible:
            await interaction.followup.send("❌ Indique `membre` (le joueur) et `cible` (nom de la guilde).", ephemeral=True)
            return
        guilde = guilde_get_by_name(str(cible))
        if not guilde:
            await interaction.followup.send(f"❌ Aucune guilde nommée **{cible}**.", ephemeral=True)
            return
        existing = guilde_of_user(membre.id)
        if existing:
            await interaction.followup.send(f"❌ {membre.display_name} est déjà dans **{existing[1]}**.", ephemeral=True)
            return
        membres = guilde_get_members(guilde[0])
        if len(membres) >= GUILDE_MAX_MEMBRES:
            await interaction.followup.send(f"❌ Guilde pleine ({GUILDE_MAX_MEMBRES} membres max).", ephemeral=True)
            return
        cursor.execute("INSERT OR IGNORE INTO shinyhunter_guilde_membres (guilde_id, user_id) VALUES (?,?)", (guilde[0], str(membre.id)))
        conn.commit()
        await interaction.followup.send(f"✅ {membre.mention} ajouté à **{guilde[1]}**.", ephemeral=True)
        return

    # ── Retirer un membre d'une guilde ────────────────────────────────────────
    if action == "membre_retirer":
        target_id = None
        target_display = None
        if membre_id and membre_id.strip():
            if not membre_id.strip().isdigit():
                await interaction.followup.send("❌ `membre_id` doit être un ID Discord valide (uniquement des chiffres).", ephemeral=True)
                return
            target_id = membre_id.strip()
            target_member = interaction.guild.get_member(int(target_id)) if interaction.guild else None
            target_display = target_member.display_name if target_member else f"Joueur {target_id} (a quitté le serveur)"
        elif membre:
            target_id = str(membre.id)
            target_display = membre.display_name
        else:
            await interaction.followup.send(
                "❌ Indique `membre` (s'il est encore sur le serveur) ou `membre_id` (utile s'il l'a quitté).",
                ephemeral=True
            )
            return

        guilde = guilde_of_user(target_id)
        if not guilde:
            await interaction.followup.send(f"❌ {target_display} n'est dans aucune guilde.", ephemeral=True)
            return
        cursor.execute("DELETE FROM shinyhunter_guilde_membres WHERE guilde_id=? AND user_id=?", (guilde[0], target_id))
        if not guilde_get_members(guilde[0]):
            cursor.execute("DELETE FROM shinyhunter_guildes WHERE id=?", (guilde[0],))
        conn.commit()
        await interaction.followup.send(f"✅ {target_display} retiré de **{guilde[1]}**.", ephemeral=True)
        return

    # ── Renommer une guilde ───────────────────────────────────────────────────
    if action == "renommer":
        if not cible or not description:
            await interaction.followup.send("❌ Indique `cible` (nom actuel) et `description` (nouveau nom).", ephemeral=True)
            return
        guilde = guilde_get_by_name(str(cible))
        if not guilde:
            await interaction.followup.send(f"❌ Aucune guilde nommée **{cible}**.", ephemeral=True)
            return
        nouveau_nom = str(description).strip()
        if len(nouveau_nom) > GUILDE_NOM_MAX:
            await interaction.followup.send(f"❌ Nom trop long (max {GUILDE_NOM_MAX} car.).", ephemeral=True)
            return
        if guilde_get_by_name(nouveau_nom):
            await interaction.followup.send(f"❌ Une guilde nommée **{nouveau_nom}** existe déjà.", ephemeral=True)
            return
        cursor.execute("UPDATE shinyhunter_guildes SET nom=? WHERE id=?", (nouveau_nom, guilde[0]))
        conn.commit()
        asyncio.create_task(update_guilde_classement_message())
        await interaction.followup.send(f"✅ **{cible}** → **{nouveau_nom}**", ephemeral=True)
        return

    # ── Logo d'une guilde ─────────────────────────────────────────────────────
    if action == "logo":
        if not cible or not extra:
            await interaction.followup.send("❌ Indique `cible` (nom de la guilde) et `extra` (URL de l'image).", ephemeral=True)
            return
        guilde = guilde_get_by_name(str(cible))
        if not guilde:
            await interaction.followup.send(f"❌ Aucune guilde nommée **{cible}**.", ephemeral=True)
            return
        url = str(extra).strip()
        if not url.startswith(("https://", "http://")):
            await interaction.followup.send("❌ L'URL doit commencer par `https://`.", ephemeral=True)
            return
        cursor.execute("UPDATE shinyhunter_guildes SET logo_url=? WHERE id=?", (url, guilde[0]))
        conn.commit()
        embed = discord.Embed(title=f"🖼️ Logo mis à jour — {guilde[4]} {guilde[1]}", color=discord.Color.green())
        embed.set_thumbnail(url=url)
        asyncio.create_task(update_guilde_classement_message())
        await interaction.followup.send(embed=embed, ephemeral=True)
        return

    # ── Voir le pool ──────────────────────────────────────────────────────────
    if action == "pool":
        cursor.execute("""
            SELECT id, type, description, target_value, bonus_points, difficulty, target_extra, is_active
            FROM guilde_objectives_pool
            ORDER BY is_active DESC, difficulty DESC, id ASC
            LIMIT 40
        """)
        rows = cursor.fetchall()
        embed = discord.Embed(title="🏰 Pool d'Objectifs de Guilde", color=discord.Color.blurple())
        if not rows:
            embed.description = "Pool vide. Utilise `/guilde_admin action:add` pour ajouter des objectifs."
        diff_emoji = {'easy': '🟢', 'medium': '🟡', 'hard': '🔴'}
        for oid, otype, desc, target, bonus, diff, extra_db, active in rows[:25]:
            status = "✅" if active else "❌ désactivé"
            de = diff_emoji.get(diff, '⚪')
            extra_txt = f" · cible `{extra_db}`" if extra_db else ""
            embed.add_field(
                name=f"{de} #{oid} — {desc}",
                value=f"`{otype}` · objectif `{target}` · **+{bonus:.0f} pts** · {status}{extra_txt}",
                inline=False
            )
        await interaction.followup.send(embed=embed, ephemeral=True)
        return

    # ── Ajouter au pool ───────────────────────────────────────────────────────
    if action == "add":
        missing = [n for n, v in [("type_objectif", type_objectif), ("description", description), ("cible", cible), ("bonus_points", bonus_points), ("difficulte", difficulte)] if v is None]
        if missing:
            await interaction.followup.send("❌ Paramètres manquants : " + ", ".join(f"`{m}`" for m in missing), ephemeral=True)
            return
        cursor.execute("""
            INSERT INTO guilde_objectives_pool
                (type, description, target_value, bonus_points, difficulty, target_extra, created_by)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (type_objectif, description[:200], cible, bonus_points, difficulte, extra, str(interaction.user.id)))
        conn.commit()
        await interaction.followup.send(
            f"✅ Objectif ajouté au pool : **{description}** (`#{cursor.lastrowid}`).",
            ephemeral=True
        )
        return

    # ── Retirer du pool ───────────────────────────────────────────────────────
    if action == "remove":
        if objectif_id is None:
            await interaction.followup.send("❌ Indique `objectif_id`.", ephemeral=True)
            return
        cursor.execute("SELECT description FROM guilde_objectives_pool WHERE id=?", (objectif_id,))
        row = cursor.fetchone()
        if not row:
            await interaction.followup.send("❌ Objectif introuvable.", ephemeral=True)
            return
        cursor.execute("UPDATE guilde_objectives_pool SET is_active=0 WHERE id=?", (objectif_id,))
        conn.commit()
        await interaction.followup.send(f"✅ Objectif **{row[0]}** retiré du pool.", ephemeral=True)
        return

    # ── Définir les objectifs proposés cette semaine ──────────────────────────
    if action == "semaine":
        if not ids_semaine:
            cursor.execute("""
                SELECT id, description, difficulty, bonus_points
                FROM guilde_objectives_pool WHERE is_active=1
                ORDER BY id DESC LIMIT 25
            """)
            pool_rows = cursor.fetchall()
            if not pool_rows:
                await interaction.followup.send("❌ Le pool d'objectifs de guilde est vide. Crée-en avec `/guilde_objectif_creer`.", ephemeral=True)
                return
            view = GuildeSemaineMultiSelect(pool_rows, week_start)
            await interaction.followup.send(
                "🗓️ Sélectionne un ou plusieurs objectifs à proposer aux guildes cette semaine "
                "(ou passe `ids_semaine` en paramètre si tu préfères taper les IDs directement) :",
                view=view, ephemeral=True
            )
            return
        ids = [int(p.strip()) for p in ids_semaine.replace(";", ",").split(",") if p.strip().isdigit()]
        if not ids:
            await interaction.followup.send("❌ Aucun ID valide.", ephemeral=True)
            return
        cursor.execute("UPDATE guilde_weekly_objectives SET is_active=0 WHERE week_start=?", (week_start,))
        added, skipped = 0, 0
        for oid in ids[:10]:
            cursor.execute("""
                SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
                FROM guilde_objectives_pool WHERE id=? AND is_active=1
            """, (oid,))
            row = cursor.fetchone()
            if not row:
                skipped += 1
                continue
            pool_id, otype, desc, target, bonus, diff, extra_db = row
            cursor.execute("""
                INSERT INTO guilde_weekly_objectives
                    (pool_id, type, description, target_value, bonus_points, difficulty, target_extra, week_start, created_by)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (pool_id, otype, desc, target, bonus, diff, extra_db, week_start, str(interaction.user.id)))
            added += 1
        conn.commit()
        assigned = auto_assign_guilde_weekly_objective(week_start=week_start)
        msg = f"✅ {added} objectif(s) proposés pour la semaine."
        if skipped:
            msg += f" ({skipped} ID(s) introuvable(s) ou inactif(s).)"
        if assigned:
            msg += f"\n🏰 Objectif assigné automatiquement à toutes les guildes : **{assigned['description']}**."
        await interaction.followup.send(msg, ephemeral=True)
        return

    # ── Reset de la semaine ───────────────────────────────────────────────────
    if action == "reset":
        cursor.execute("UPDATE guilde_weekly_objectives SET is_active=0 WHERE week_start=?", (week_start,))
        cursor.execute("DELETE FROM guilde_weekly_choices WHERE week_start=?", (week_start,))
        conn.commit()
        await interaction.followup.send("✅ Objectifs de guilde de la semaine vidés.", ephemeral=True)
        return

    await interaction.followup.send("❌ Action inconnue.", ephemeral=True)



# ══════════════════════════════════════════════════════════════════════════════
#  WANTED PERSONNEL
# ══════════════════════════════════════════════════════════════════════════════
#  WANTED PERSONNEL
# ══════════════════════════════════════════════════════════════════════════════

def get_used_generations(user_id: str) -> set:
    """Retourne les générations déjà tirées cette semaine (reset chaque lundi)."""
    week_start, next_week_start = get_current_week_bounds_for_sqlite()
    cursor.execute("""
        SELECT generation FROM personal_wanted
        WHERE user_id = ?
          AND datetime(created_at) >= datetime(?)
          AND datetime(created_at) < datetime(?)
    """, (str(user_id), week_start, next_week_start))
    used_gens = set()
    for (generation,) in cursor.fetchall():
        try:
            gen = int(generation)
        except (TypeError, ValueError):
            continue
        if gen in POKEMON_PAR_GEN:
            used_gens.add(gen)
    return used_gens


PERSONAL_WANTED_WEEKLY_LIMIT = 7  # Max de wanteds perso par semaine


def get_current_week_bounds_for_sqlite():
    """Retourne les bornes UTC de la semaine locale, au format SQLite."""
    today = datetime.now().date()
    monday = today - timedelta(days=today.weekday())
    start_local = datetime.combine(monday, datetime.min.time()).astimezone()
    end_local = start_local + timedelta(days=7)
    return (
        start_local.astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M:%S"),
        end_local.astimezone(timezone.utc).strftime("%Y-%m-%d %H:%M:%S"),
    )


def get_weekly_personal_wanted_count(user_id: str) -> int:
    """Retourne le nombre de wanteds personnels créés cette semaine."""
    week_start, next_week_start = get_current_week_bounds_for_sqlite()
    cursor.execute("""
        SELECT COUNT(*) FROM personal_wanted
        WHERE user_id = ?
          AND datetime(created_at) >= datetime(?)
          AND datetime(created_at) < datetime(?)
    """, (str(user_id), week_start, next_week_start))
    return cursor.fetchone()[0] or 0


def get_last_used_generation(user_id: str):
    """Retourne la dernière génération tirée cette semaine (int) ou None si aucune."""
    week_start, next_week_start = get_current_week_bounds_for_sqlite()
    cursor.execute("""
        SELECT generation FROM personal_wanted
        WHERE user_id = ?
          AND datetime(created_at) >= datetime(?)
          AND datetime(created_at) < datetime(?)
        ORDER BY created_at DESC
        LIMIT 1
    """, (str(user_id), week_start, next_week_start))
    row = cursor.fetchone()
    if row:
        try:
            gen = int(row[0])
            return gen if gen in POKEMON_PAR_GEN else None
        except (TypeError, ValueError):
            return None
    return None


def has_used_joker_this_week(user_id: str) -> bool:
    """Retourne True si le joueur a déjà utilisé son joker cette semaine."""
    week_start = get_current_week_start()
    cursor.execute(
        "SELECT 1 FROM weekly_joker_usage WHERE user_id=? AND week_start=?",
        (str(user_id), week_start)
    )
    return cursor.fetchone() is not None


def use_joker(user_id: str, gen: int, pokemon: str):
    """Enregistre l'utilisation du joker pour cette semaine."""
    week_start = get_current_week_start()
    cursor.execute(
        "INSERT OR IGNORE INTO weekly_joker_usage (user_id, week_start, gen_chosen, pokemon) VALUES (?, ?, ?, ?)",
        (str(user_id), week_start, gen, pokemon)
    )
    conn.commit()


class WantedPersoGenSelect(discord.ui.View):
    """Select menu de génération pour le wanted personnel.

    Si `joker_mode=True`, en plus des gens libres, la DERNIÈRE gen utilisée
    cette semaine est également débloquée (et uniquement elle).
    Les autres gens déjà utilisées restent bloquées même avec le joker.
    """
    def __init__(self, used_gens: set, joker_mode: bool = False, last_used_gen: int = None):
        super().__init__(timeout=120)
        self.joker_mode = joker_mode
        self.last_used_gen = last_used_gen  # la seule gen supplémentaire débloquée par le joker
        options = []
        for g in sorted(POKEMON_PAR_GEN):
            already_used = g in used_gens
            is_joker_unlocked = joker_mode and (g == last_used_gen)

            if not already_used:
                # Gen libre — disponible normalement
                options.append(discord.SelectOption(
                    label=f"Génération {g}",
                    value=str(g),
                    description=f"{len(POKEMON_PAR_GEN[g])} Pokémon disponibles",
                    emoji="✅"
                ))
            elif is_joker_unlocked:
                # Dernière gen utilisée — débloquée par le joker
                options.append(discord.SelectOption(
                    label=f"Génération {g} ♻️ (joker)",
                    value=str(g),
                    description=f"Nouveau tirage autorisé par le joker ({len(POKEMON_PAR_GEN[g])} Pokémon)",
                    emoji="🃏"
                ))
            else:
                if joker_mode:
                    # Autres gens utilisées — toujours bloquées même avec le joker
                    options.append(discord.SelectOption(
                        label=f"Génération {g} — bloquée",
                        value=str(g),
                        description="❌ Le joker ne permet pas de re-tirer ici",
                        emoji="🚫"
                    ))
                else:
                    options.append(discord.SelectOption(
                        label=f"Génération {g} — déjà utilisée",
                        value=str(g),
                        description="❌ Tu as déjà tiré dans cette gen ce cycle",
                        emoji="🚫"
                    ))

        placeholder = "🃏 Joker — Choisis ta génération…" if joker_mode else "🎲 Choisis une génération…"
        select = discord.ui.Select(
            placeholder=placeholder,
            options=options,
            min_values=1,
            max_values=1
        )
        select.callback = self._on_select
        self.used_gens = used_gens
        self.add_item(select)

    async def _on_select(self, interaction: discord.Interaction):
        import random as _rand
        user_id = str(interaction.user.id)
        gen = int(interaction.data["values"][0])
        if gen not in POKEMON_PAR_GEN:
            await interaction.response.send_message("❌ Génération invalide.", ephemeral=True)
            return

        # Vérifier qu'il n'a pas déjà un wanted actif (bloquant seulement en mode normal)
        existing = get_active_personal_wanted(user_id)
        if existing and not self.joker_mode:
            from datetime import datetime as _dt
            ts = int(_dt.fromisoformat(existing[4]).timestamp())
            await interaction.response.send_message(
                f"⏳ Tu as déjà un wanted personnel actif : **{existing[1]}** (Gen {existing[2]})\n"
                f"Il expire <t:{ts}:R>.",
                ephemeral=True
            )
            return

        # Vérifier la limite hebdomadaire (sécurité serveur)
        weekly_count = get_weekly_personal_wanted_count(user_id)
        if weekly_count >= PERSONAL_WANTED_WEEKLY_LIMIT:
            await interaction.response.send_message(
                f"🚫 Tu as atteint la limite de **{PERSONAL_WANTED_WEEKLY_LIMIT} wanteds personnels** cette semaine.\n"
                f"Reviens lundi prochain pour en relancer !",
                ephemeral=True
            )
            return

        # En mode normal : refuser si la gen est déjà utilisée
        # En mode joker : autoriser si gen libre OU si c'est la dernière gen utilisée
        if not self.joker_mode:
            used_gens = get_used_generations(user_id)
            if gen in used_gens:
                await interaction.response.send_message(
                    f"🚫 Tu as déjà tiré dans la **Génération {gen}** cette semaine !\n"
                    f"Choisis une autre génération, ou utilise ton **🃏 Joker** pour re-tirer dans ta dernière gen.",
                    ephemeral=True
                )
                return
        else:
            # Mode joker : vérifier que la gen choisie est soit libre, soit la dernière utilisée
            used_gens = get_used_generations(user_id)
            if gen in used_gens and gen != self.last_used_gen:
                await interaction.response.send_message(
                    f"🚫 Le joker ne permet pas de re-tirer dans la **Génération {gen}**.\n"
                    f"Il débloque uniquement ta **dernière génération utilisée** (Gen {self.last_used_gen}) en plus des gens libres.",
                    ephemeral=True
                )
                return

        # Tirage aléatoire dans la génération choisie
        pool = POKEMON_PAR_GEN[gen]
        pokemon = _rand.choice(pool)

        from datetime import datetime as _dt, timedelta as _td

        # En mode joker, annuler le wanted actif s'il y en a un
        cancelled_pokemon = None
        if self.joker_mode and existing:
            cancelled_pokemon = existing[1]
            cursor.execute(
                "UPDATE personal_wanted SET claimed=1, claimed_at=datetime('now') WHERE id=?",
                (existing[0],)
            )
            conn.commit()

        expires_at = (_dt.now() + _td(days=PERSONAL_WANTED_DURATION)).strftime("%Y-%m-%d %H:%M:%S")

        cursor.execute("""
            INSERT INTO personal_wanted (user_id, pokemon, generation, bonus_pts, expires_at)
            VALUES (?, ?, ?, ?, ?)
        """, (user_id, pokemon, gen, PERSONAL_WANTED_BONUS, expires_at))
        conn.commit()

        # Si c'était le joker, l'enregistrer
        if self.joker_mode:
            use_joker(user_id, gen, pokemon)

        ts_exp = int((_dt.now() + _td(days=PERSONAL_WANTED_DURATION)).timestamp())
        new_weekly = get_weekly_personal_wanted_count(user_id)
        restants = PERSONAL_WANTED_WEEKLY_LIMIT - new_weekly

        joker_note = (
            f"\n\n🃏 **Joker utilisé** — Tu as re-tiré dans la **Génération {gen}** (déjà jouée cette semaine) !"
            + (f"\n↩️ Ton ancien wanted **{cancelled_pokemon}** a été annulé." if cancelled_pokemon else "")
        ) if (self.joker_mode and gen == self.last_used_gen) else (
            ("\n\n🃏 **Joker utilisé**"
             + (f"\n↩️ Ton ancien wanted **{cancelled_pokemon}** a été annulé." if cancelled_pokemon else ""))
            if self.joker_mode else ""
        )

        reset_note = (
            f"\n\n*{restants} tirage{'s' if restants > 1 else ''} restant{'s' if restants > 1 else ''} cette semaine.*"
            if restants > 0
            else "\n\n🔄 **Tu as utilisé tous tes tirages cette semaine.** Reviens lundi !"
        )

        embed = discord.Embed(
            title="🎯 Ton Wanted Personnel !",
            description=(
                f"Un Pokémon mystère t'a été assigné pour les **{PERSONAL_WANTED_DURATION} prochains jours** !\n\n"
                f"✨ **{pokemon}**\n"
                f"📖 Génération **{gen}**\n\n"
                f"Trouve ce shiny et enregistre-le avec `/shiny_ajout` pour remporter "
                f"**+{int(PERSONAL_WANTED_BONUS)} pts bonus** !"
                f"{joker_note}"
                f"{reset_note}"
            ),
            color=discord.Color.orange() if self.joker_mode else discord.Color.gold()
        )
        embed.add_field(name="⏰ Expire", value=f"<t:{ts_exp}:R> (<t:{ts_exp}:f>)", inline=False)
        embed.add_field(name="🗓️ Cette semaine", value=f"{new_weekly}/{PERSONAL_WANTED_WEEKLY_LIMIT} wanteds utilisés", inline=True)
        if self.joker_mode:
            embed.add_field(name="🃏 Joker", value="Utilisé cette semaine", inline=True)
        embed.set_footer(text="ShinyBot · Wanted Personnel • 1 seul actif à la fois")
        await interaction.response.edit_message(embed=embed, view=None)


@bot.tree.command(
    name="wanted_perso",
    description="Tire un Pokémon aléatoire à trouver en shiny — +20 pts si trouvé en 7 jours !",
    guild=discord.Object(id=GUILD_ID)
)
async def wanted_perso(interaction: discord.Interaction):
    user_id = str(interaction.user.id)

    # Vérifier qu'il n'a pas déjà un wanted actif
    existing = get_active_personal_wanted(user_id)
    if existing:
        from datetime import datetime as _dt
        ts = int(_dt.fromisoformat(existing[4]).timestamp())
        embed = discord.Embed(
            title="🎯 Ton Wanted Personnel en cours",
            description=(
                f"Tu cherches déjà : **{existing[1]}** (Gen {existing[2]})\n\n"
                f"Trouve-le en shiny avant <t:{ts}:R> pour remporter **+{int(existing[3])} pts** !"
            ),
            color=discord.Color.blurple()
        )
        embed.set_footer(text="ShinyBot · Wanted Personnel")
        await interaction.response.send_message(embed=embed, ephemeral=True)
        return

    # Compteur hebdo exact (nombre de wanteds créés cette semaine)
    weekly_count = get_weekly_personal_wanted_count(user_id)

    # Vérifier la limite hebdomadaire
    if weekly_count >= PERSONAL_WANTED_WEEKLY_LIMIT:
        embed = discord.Embed(
            title="🚫 Limite hebdomadaire atteinte",
            description=(
                f"Tu as déjà lancé **{weekly_count}/{PERSONAL_WANTED_WEEKLY_LIMIT}** wanteds personnels cette semaine.\n\n"
                f"Reviens **lundi prochain** pour en relancer !"
            ),
            color=discord.Color.red()
        )
        embed.set_footer(text="ShinyBot · Wanted Personnel • Limite : 7 par semaine")
        await interaction.response.send_message(embed=embed, ephemeral=True)
        return

    # Générations déjà tirées cette semaine
    used_gens = get_used_generations(user_id)
    gen_keys = sorted(POKEMON_PAR_GEN)
    remaining_gens = len([g for g in gen_keys if g not in used_gens])

    gens_dispo  = [str(g) for g in gen_keys if g not in used_gens]
    gens_locked = [str(g) for g in gen_keys if g in used_gens]

    joker_used = has_used_joker_this_week(user_id)
    joker_line = "🃏 **Joker :** ✅ Disponible (re-tire dans une gen déjà jouée !)" if not joker_used else "🃏 **Joker :** ❌ Déjà utilisé cette semaine"

    desc_lines = [
        "Sélectionne une génération et le bot tirera un Pokémon au hasard.\n"
        f"Si tu le trouves en shiny dans les **{PERSONAL_WANTED_DURATION} jours**, tu gagnes **+{int(PERSONAL_WANTED_BONUS)} pts** !\n"
    ]
    if gens_dispo:
        desc_lines.append(f"✅ **Disponibles ({remaining_gens}/{len(gen_keys)}) :** Gen {', '.join(gens_dispo)}")
    if gens_locked:
        desc_lines.append(f"🚫 **Déjà utilisées cette semaine :** Gen {', '.join(gens_locked)}")
    desc_lines.append(f"\n🗓️ **Wanteds cette semaine :** {weekly_count}/{PERSONAL_WANTED_WEEKLY_LIMIT}")
    desc_lines.append(joker_line)
    desc_lines.append("⚠️ Un seul wanted personnel actif à la fois.")

    embed = discord.Embed(
        title="🎲 Wanted Personnel — Choisis ta génération",
        description="\n".join(desc_lines),
        color=discord.Color.gold()
    )
    await interaction.response.send_message(
        embed=embed,
        view=WantedPersoGenSelect(used_gens),
        ephemeral=True
    )


