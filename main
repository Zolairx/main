@bot.tree.command(
    name="classement_perso",
    description="Voir ta position dans le classement avec les joueurs juste autour de toi",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(membre="Voir la position d'un autre membre (optionnel)")
async def classement_perso(interaction: discord.Interaction, membre: discord.Member = None):
    async def _show(**kwargs):
        await interaction.response.defer(ephemeral=True)
        guild = interaction.guild
        target = membre if membre else interaction.user
        ladder_list = get_ladder()  # déjà trié par points décroissants

        if not ladder_list:
            await interaction.followup.send("❌ Aucun joueur classé pour le moment.", ephemeral=True)
            return True

        podium_emojis = ["🥇", "🥈", "🥉"]

        def fmt_pts(pts):
            return f"{pts:.1f}" if pts % 1 != 0 else f"{int(pts)}"

        embed = discord.Embed(
            title="🏆 Classement — Ta position" if target.id == interaction.user.id else f"🏆 Classement — Position de {target.display_name}",
            color=discord.Color.gold(),
            timestamp=datetime.now()
        )

        # Podium fixe (toujours visible, pour le contexte général de la saison)
        podium_lines = []
        for position in range(min(3, len(ladder_list))):
            user_id, total_points, wanted_count, race_wins = ladder_list[position]
            member = guild.get_member(int(user_id)) if guild else None
            name = member.display_name if member else f"Utilisateur {user_id}"
            podium_lines.append(f"{podium_emojis[position]} **{name}** — {fmt_pts(total_points)} pts")
        embed.add_field(name="Podium", value="\n".join(podium_lines), inline=False)

        # Position du joueur ciblé
        target_rank, target_points = get_user_rank(str(target.id))
        if target_rank is None:
            embed.add_field(
                name="📍 Ta position" if target.id == interaction.user.id else "📍 Sa position",
                value="Pas encore classé — aucun shiny enregistré cette saison.",
                inline=False
            )
            await interaction.followup.send(embed=embed, ephemeral=True)
            return True

        if target_rank <= 3:
            embed.add_field(
                name="📍 Position",
                value=f"**{target.display_name}** est déjà sur le podium — {podium_emojis[target_rank-1]} **#{target_rank}** !",
                inline=False
            )
        else:
            # Fenêtre de ~3 joueurs au-dessus et ~3 en dessous, sans jamais recouvrir le podium déjà affiché
            window_radius = 3
            start_idx = max(3, (target_rank - 1) - window_radius)  # index 0-based, jamais < 3 (top 3 déjà affiché)
            end_idx = min(len(ladder_list), (target_rank - 1) + window_radius + 1)

            lines = []
            if start_idx > 3:
                lines.append("⋯")
            for idx in range(start_idx, end_idx):
                user_id, total_points, wanted_count, race_wins = ladder_list[idx]
                position = idx + 1
                member = guild.get_member(int(user_id)) if guild else None
                name = member.display_name if member else f"Utilisateur {user_id}"
                is_target = (str(user_id) == str(target.id))
                prefix = "▶ " if is_target else "   "
                line = f"{prefix}**#{position}** {name} — {fmt_pts(total_points)} pts"
                if is_target:
                    line = f"__{line}__"
                lines.append(line)
            if end_idx < len(ladder_list):
                lines.append("⋯")

            # Distance au joueur juste au-dessus (objectif concret et proche)
            above_gap = ""
            if target_rank > 1:
                above_user_id, above_points, _, _ = ladder_list[target_rank - 2]
                gap = above_points - target_points
                if gap > 0:
                    above_member = guild.get_member(int(above_user_id)) if guild else None
                    above_name = above_member.display_name if above_member else f"Utilisateur {above_user_id}"
                    above_gap = f"\n\n💡 Encore **{fmt_pts(gap)} pts** pour dépasser **{above_name}** (#{target_rank-1})."

            embed.add_field(
                name=f"📍 Autour de la position #{target_rank}",
                value="\n".join(lines) + above_gap,
                inline=False
            )

        embed.set_thumbnail(url=target.display_avatar.url)
        embed.set_footer(text="ShinyBot · Classement complet mis à jour en continu dans le salon dédié")
        await interaction.followup.send(embed=embed, ephemeral=True)
        return True

    await discord_retry_wrapper(_show, context="Classement Perso Command")

