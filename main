    cursor.execute("SELECT description FROM monthly_type_challenge LIMIT 1")
except sqlite3.OperationalError:
    cursor.execute("ALTER TABLE monthly_type_challenge ADD COLUMN description TEXT DEFAULT ''")
    print("Colonne description ajoutée à la table monthly_type_challenge")

try:
    cursor.execute("SELECT ends_at FROM monthly_type_challenge LIMIT 1")
except sqlite3.OperationalError:
    cursor.execute("ALTER TABLE monthly_type_challenge ADD COLUMN ends_at TEXT")
    print("Colonne ends_at ajoutée à la table monthly_type_challenge")

try:
    cursor.execute("SELECT announce_channel_id FROM monthly_type_challenge LIMIT 1")
except sqlite3.OperationalError:
    cursor.execute("ALTER TABLE monthly_type_challenge ADD COLUMN announce_channel_id TEXT")
    print("Colonne announce_channel_id ajoutée à la table monthly_type_challenge")

cursor.execute("""
CREATE TABLE IF NOT EXISTS weekly_points_tracking (
    user_id TEXT NOT NULL,
    week_start TEXT NOT NULL,
    total_pts REAL DEFAULT 0,
    PRIMARY KEY (user_id, week_start)
)
""")
conn.commit()

cursor.execute("""
CREATE TABLE IF NOT EXISTS scheduled_wanteds (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    scheduled_at TEXT NOT NULL,
    pokemon_name TEXT NOT NULL,
    bonus_points REAL NOT NULL,
    decay_percent REAL DEFAULT 100.0,
    game TEXT,
    indice TEXT,
    paliers_json TEXT,
    unique_wanted INTEGER DEFAULT 0,
    alternates TEXT,
    created_by TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    status TEXT DEFAULT 'pending'
)
""")
conn.commit()

def get_last_classement_message_id(channel_id):
    """Récupère l'ID du dernier message de classement"""
    cursor.execute("SELECT message_id FROM classement_message WHERE channel_id = ?", (str(channel_id),))
    result = cursor.fetchone()
    return result[0] if result else None

def set_last_classement_message_id(channel_id, message_id):
    """Stocke l'ID du dernier message de classement"""
    cursor.execute("REPLACE INTO classement_message (channel_id, message_id) VALUES (?, ?)", (str(channel_id), str(message_id)))
    conn.commit()

