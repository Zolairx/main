    bonus_top3="Bonus pour le 3e",
    bonus_autres="Bonus pour les rangs 4 à Top N",
    description="Description affichée aux joueurs",
    date_fin="Fin du challenge (format: JJ/MM/AAAA HH:MM)",
    salon_annonce="Salon où annoncer le nouveau challenge (sinon salon wanted)"
)
@app_commands.choices(
    shiny_type=[app_commands.Choice(name=t, value=t) for t in POKEMON_TYPE_CHOICES]
)
async def challenge_creer(
    interaction: discord.Interaction,
    shiny_type: str,
    top_n: app_commands.Range[int, 1, 50],
    bonus_points: app_commands.Range[float, 0, 10000] = 0,
    bonus_top1: app_commands.Range[float, 0, 10000] = 0,
    bonus_top2: app_commands.Range[float, 0, 10000] = 0,
    bonus_top3: app_commands.Range[float, 0, 10000] = 0,
    bonus_autres: app_commands.Range[float, 0, 10000] = 0,
    description: str = "",
    date_fin: str = None,
    salon_annonce: discord.TextChannel = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    ends_at = None
    if date_fin:
        try:
            dt_fin = datetime.strptime(date_fin.strip(), "%d/%m/%Y %H:%M")
            if dt_fin <= datetime.now():
                await interaction.response.send_message("❌ La date de fin doit être dans le futur.", ephemeral=True)
                return
            ends_at = dt_fin.strftime("%Y-%m-%d %H:%M")
        except Exception:
            await interaction.response.send_message("❌ Format invalide pour `date_fin`. Utilisez `JJ/MM/AAAA HH:MM`.", ephemeral=True)
            return

    # Si des bonus par rang sont fournis, ils prennent priorité sur bonus_points.
    rank_bonus_sum = float(bonus_top1) + float(bonus_top2) + float(bonus_top3) + float(bonus_autres)
    if rank_bonus_sum > 0:
        b1, b2, b3, b_other = float(bonus_top1), float(bonus_top2), float(bonus_top3), float(bonus_autres)
    else:
        b1 = b2 = b3 = b_other = float(bonus_points)

    channel_id = salon_annonce.id if salon_annonce else SALON_WANTED_ALERT_ID
    now = datetime.now()
    challenge_id = create_monthly_type_challenge(
        now.month, now.year, shiny_type, int(top_n),
        float(bonus_points), b1, b2, b3, b_other,
        description, ends_at, channel_id, str(interaction.user.id)
    )

    fin_txt = date_fin if date_fin else "Non définie"
    await interaction.response.send_message(
        f"✅ Challenge type créé (ID **#{challenge_id}**)\n"
        f"• Période : **{now.strftime('%m/%Y')}**\n"
        f"• Type suivi : **{shiny_type}**\n"
        f"• Récompense : **Top {top_n}**\n"
        f"• Bonus : **Top1 +{b1:.2f} / Top2 +{b2:.2f} / Top3 +{b3:.2f} / autres +{b_other:.2f}**\n"
        f"• Fin : **{fin_txt}**"
    )
    # Mise à jour immédiate du salon classement challenge
    asyncio.create_task(update_challenge_status_message())

    # Annonce publique dans le salon demandé (ou salon wanted par défaut)
    try:
        channel = bot.get_channel(int(channel_id))
        if channel:
            ann_embed = discord.Embed(
                title="🎯 Nouveau Challenge Type",
                description=(
                    f"**Type ciblé : {shiny_type}**\n"
                    f"{description if description else '*Aucune description fournie.*'}\n\n"
                    f"🏆 Récompenses Top {top_n} :\n"
                    f"• Top 1 : **+{b1:.2f} pts**\n"
                    f"• Top 2 : **+{b2:.2f} pts**\n"
                    f"• Top 3 : **+{b3:.2f} pts**\n"
                    f"• Top 4+ : **+{b_other:.2f} pts**"
                ),
                color=discord.Color.purple(),
                timestamp=datetime.now(timezone.utc)
            )
            if ends_at:
                ts = int(datetime.strptime(ends_at, "%Y-%m-%d %H:%M").timestamp())
                ann_embed.add_field(name="⏰ Fin du challenge", value=f"<t:{ts}:F> (<t:{ts}:R>)", inline=False)
            ann_embed.set_footer(text="ShinyBot · Challenge mensuel par type")
            await channel.send(embed=ann_embed)
    except Exception as e:
        logger.error(f"Erreur annonce challenge type: {e}")

@bot.tree.command(
    name="challenge_classement",
    description="Voir le classement du challenge type actif",
    guild=discord.Object(id=GUILD_ID)
)
async def challenge_classement(interaction: discord.Interaction):
    challenge = get_active_monthly_type_challenge()
    if not challenge:
        await interaction.response.send_message("⚠️ Aucun challenge type actif.", ephemeral=True)
        return

    challenge_id = challenge[0]
    info, scores = get_type_challenge_leaderboard(challenge_id)
    if not info:
        await interaction.response.send_message("⚠️ Impossible de charger le classement.", ephemeral=True)
        return

    month, year, shiny_type, top_n = info[0], info[1], info[2], info[3]
    bonus_points, bonus_top1, bonus_top2, bonus_top3, bonus_other = info[4], info[5], info[6], info[7], info[8]
    challenge_desc, ends_at = info[9], info[10]
    guild = bot.get_guild(GUILD_ID)
    embed = discord.Embed(
        title="🏅 Classement Challenge Type",
        description=(
            f"Type : **{shiny_type}** | Période : **{month:02d}/{year}** | "
            f"Récompense : **Top {top_n}**"
        ),
        color=discord.Color.blue(),
        timestamp=datetime.now(timezone.utc)
    )
    if challenge_desc:
        embed.add_field(name="📝 Description", value=challenge_desc, inline=False)
    embed.add_field(
        name="🎁 Bonus par rang",
        value=(
            f"Top1: **+{float(bonus_top1):.2f}** | Top2: **+{float(bonus_top2):.2f}** | "
            f"Top3: **+{float(bonus_top3):.2f}** | Top4+: **+{float(bonus_other):.2f}**"
        ),
        inline=False
    )
    if ends_at:
        try:
            ts = int(datetime.strptime(ends_at, "%Y-%m-%d %H:%M").timestamp())
            embed.add_field(name="⏰ Fin", value=f"<t:{ts}:F> (<t:{ts}:R>)", inline=False)
        except Exception:
            embed.add_field(name="⏰ Fin", value=ends_at, inline=False)

    if not scores:
        embed.add_field(name="Aucun score", value="Aucun shiny correspondant pour l'instant.", inline=False)
    else:
        for position, (user_id, total_shinys) in enumerate(scores, start=1):
            member = guild.get_member(int(user_id)) if guild else None
            player_name = member.display_name if member else f"Utilisateur {user_id}"
            badge = "🏆 " if position <= top_n else ""
            embed.add_field(
                name=f"{badge}#{position} - {player_name}",
                value=f"Shinys comptabilisés : **{total_shinys}**",
                inline=False
            )
    await interaction.response.send_message(embed=embed)

@bot.tree.command(
    name="challenge_modifier_score",
    description="[ADMIN] Modifier le total d'un participant sur le challenge type actif",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    member="Participant ciblé",
    nouveau_total="Nouveau total à afficher pour ce participant"
)
async def challenge_modifier_score(interaction: discord.Interaction, member: discord.Member, nouveau_total: app_commands.Range[int, 0, 999]):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    challenge = get_active_monthly_type_challenge()
    if not challenge:
        await interaction.response.send_message("⚠️ Aucun challenge type actif à modifier.", ephemeral=True)
        return

    challenge_id, month, year, shiny_type = challenge[0], challenge[1], challenge[2], challenge[3]
    base_count, adjustment = set_type_challenge_count(challenge_id, str(member.id), int(nouveau_total))
    await interaction.response.send_message(
        f"✅ Score mis à jour pour {member.mention}\n"
        f"Challenge : **{shiny_type} ({month:02d}/{year})**\n"
        f"Compteur réel : **{base_count}** | Ajustement : **{adjustment:+d}**\n"
        f"Total affiché : **{nouveau_total}**"
    )
    asyncio.create_task(update_challenge_status_message())

@bot.tree.command(
    name="challenge_rebuild_depuis",
    description="[ADMIN] Reconstruire le classement du challenge type depuis une date précise (JJ-MM-AAAA)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    depuis="Date de début du comptage, format JJ-MM-AAAA (ex: 22-04-2026)"
)
async def challenge_rebuild_depuis(interaction: discord.Interaction, depuis: str):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    # Validation de la date
    try:
        from datetime import datetime as _dt
        date_debut = _dt.strptime(depuis, "%d-%m-%Y")
    except ValueError:
        await interaction.response.send_message(
            "❌ Format de date invalide. Utilisez **JJ-MM-AAAA** (ex: `22-04-2026`).",
            ephemeral=True
        )
        return

    challenge = get_active_monthly_type_challenge()
    if not challenge:
        await interaction.response.send_message("⚠️ Aucun challenge type actif.", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)

    challenge_id = challenge[0]
    shiny_type   = challenge[3]

    # --- 1. Compter les shinys du bon type depuis la date de départ ---
    # Comparaison normalisée : accents/majuscules ne doivent pas casser Électrik/Electrik.
    real_counts = _get_type_challenge_base_counts(
        shiny_type,
        user_id=None,
        start_date=date_debut.date()
    )

    if not real_counts:
        await interaction.followup.send(
            f"⚠️ Aucun shiny de type **{shiny_type}** trouvé depuis le **{depuis}**.",
            ephemeral=True
        )
        return

    # --- 2. Pour chaque joueur, calculer l'ajustement nécessaire ---
    # base_count = ce que la requête normale compte (tout le mois)
    # On veut : base_count + adjustment = real_count_since_date
    # Donc : adjustment = real_count - base_count
    guild = bot.get_guild(GUILD_ID)
    lines = []
    for user_id, desired in real_counts.items():
        base_count, new_adj = set_type_challenge_count(challenge_id, user_id, desired)
        member = guild.get_member(int(user_id)) if guild else None
        name = member.display_name if member else f"<@{user_id}>"
        lines.append(f"**{name}** → {desired} shiny{'s' if desired > 1 else ''} (base: {base_count}, ajust: {new_adj:+d})")

    # --- 3. Réinitialiser les joueurs qui avaient des ajustements mais 0 shiny depuis la date ---
    cursor.execute("""
        SELECT user_id FROM monthly_type_challenge_adjustments WHERE challenge_id = ?
    """, (challenge_id,))
    all_adjusted = {row[0] for row in cursor.fetchall()}
    for uid in all_adjusted:
        if uid not in real_counts:
            # Ce joueur n'a aucun shiny depuis la date → on force son total à 0
            base = get_type_challenge_base_count(challenge_id, uid)
            if base > 0:
                set_type_challenge_count(challenge_id, uid, 0)
            else:
                cursor.execute("""
                    DELETE FROM monthly_type_challenge_adjustments
                    WHERE challenge_id = ? AND user_id = ?
                """, (challenge_id, uid))
                conn.commit()

    # --- 4. Embed récapitulatif ---
    embed = discord.Embed(
        title=f"🔄 Classement reconstruit — {shiny_type}",
        description=(
            f"Comptage depuis le **{depuis}**\n"
            f"Challenge ID : `{challenge_id}` | Type : **{shiny_type}**\n\n"
            + "\n".join(lines)
        ),
        color=discord.Color.blurple()
    )
    embed.set_footer(text="ShinyBot · /challenge_classement pour voir le classement mis à jour")
    await interaction.followup.send(embed=embed, ephemeral=True)

    # Mettre à jour le message de classement affiché
    asyncio.create_task(update_challenge_status_message())


@bot.tree.command(
    name="challenge_cloturer",
    description="[ADMIN] Clôturer le challenge type actif et annoncer le top final",
    guild=discord.Object(id=GUILD_ID)
)
async def challenge_cloturer(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    challenge = get_active_monthly_type_challenge()
    if not challenge:
        # Peut-être un challenge déjà expiré mais pas encore traité par la
        # tâche de fond (fenêtre de 5 min max) : on le finalise immédiatement.
        pending = get_expired_active_type_challenges()
        if pending:
            await auto_finalize_expired_type_challenges()
            await interaction.response.send_message(
                "✅ Ce challenge était déjà expiré : il vient d'être clôturé et les points ont été distribués automatiquement.",
                ephemeral=True
            )
            return
        await interaction.response.send_message("⚠️ Aucun challenge type actif à clôturer.", ephemeral=True)
        return

    challenge_id = challenge[0]
    info, scores = get_type_challenge_leaderboard(challenge_id)
    if not info:
        await interaction.response.send_message("⚠️ Impossible de clôturer ce challenge.", ephemeral=True)
        return

    month, year, shiny_type, top_n = info[0], info[1], info[2], info[3]
    bonus_top1, bonus_top2, bonus_top3, bonus_other = info[5], info[6], info[7], info[8]
    close_monthly_type_challenge(challenge_id)

    guild = bot.get_guild(GUILD_ID)
    embed = discord.Embed(
        title="🎉 Résultats finaux - Challenge Type",
        description=(
            f"Challenge clôturé : **{shiny_type} ({month:02d}/{year})**\n"
            f"Récompense : **Top {top_n}**"
        ),
        color=discord.Color.purple(),
        timestamp=datetime.now(timezone.utc)
    )

    if not scores:
        embed.add_field(name="Aucun participant", value="Aucun shiny de ce type n'a été comptabilisé.", inline=False)
    else:
        winners = scores[:top_n]
        for position, (user_id, total_shinys) in enumerate(winners, start=1):
            member = guild.get_member(int(user_id)) if guild else None
            player_name = member.mention if member else f"Utilisateur {user_id}"
            medal = "🥇" if position == 1 else ("🥈" if position == 2 else ("🥉" if position == 3 else "🏅"))
            rank_bonus = get_rank_bonus(position, bonus_top1, bonus_top2, bonus_top3, bonus_other)
            effective_rank_bonus = rank_bonus
            if rank_bonus > 0:
                effective_rank_bonus = award_capped_bonus(
                    user_id, f"[Bonus Challenge Type {month:02d}/{year} Top {position}]",
                    'type_challenge_bonus', float(rank_bonus)
                )

            embed.add_field(
                name=f"{medal} Top {position}",
                value=f"{player_name} — **{total_shinys}** shiny(s) | Bonus : **+{float(effective_rank_bonus):.2f} pts**",
                inline=False
            )

    conn.commit()
    await interaction.response.send_message(embed=embed)
    # Mettre à jour le salon classement (affichera "aucun challenge actif")
    asyncio.create_task(update_challenge_status_message())

def build_wanted_server_embed(user_id, is_admin):
    wanteds = get_active_wanteds()
    if not wanteds:
        return discord.Embed(
            title="🎯 Wanteds Serveur",
            description="Aucun Pokémon wanted n'est actuellement défini.",
            color=discord.Color.light_grey()
        )
    embed = discord.Embed(
        title="🎯 Wanteds Serveur",
        description="Pokémon actuellement recherchés — trouve-les en shiny pour gagner des points !",
        color=discord.Color.gold()
    )
    for wd in wanteds[:10]:
        cursor.execute("SELECT COUNT(*) FROM shiny_wanted_claimed WHERE wanted_id=?", (wd['id'],))
        claimed_count = cursor.fetchone()[0] or 0
        paliers_json = wd.get('paliers_json')
        game_restriction = wd.get('game')
        try:
            if paliers_json:
                paliers = json.loads(paliers_json)
                p1 = paliers.get('p1', wd['bonus_points'])
                p2 = paliers.get('p2', p1)
                p3 = paliers.get('p3', p2)
                ps = paliers.get('suite', p3)
                points_display = f"🥇 **+{p1}** · 🥈 **+{p2}** · 🥉 **+{p3}** · 👥 **+{ps}**"
            else:
                base = wd['bonus_points']
                decay = float(wd.get('decay_percent', 100.0) or 100.0)
                points_display = f"**+{base} pts**" + (f" (dégressif {decay}%)" if decay < 100 else " (même bonus pour tous)")
        except Exception:
            points_display = f"**+{wd['bonus_points']} pts**"
        indice = wd.get('indice')
        displayed_name = wd['pokemon_name'] if (not indice or is_admin) else "???"
        field_name = f"🎯 {displayed_name} (ID {wd['id']})" + (" 🔓" if indice and is_admin else "")
        game_txt = f"• Jeu : **{game_restriction}**" if game_restriction and game_restriction.strip() else "• Jeu : **Libre**"
        field_value = (
            f"💰 {points_display}\n"
            f"👥 Déjà trouvé : **{claimed_count}** joueur{'s' if claimed_count > 1 else ''}\n"
            f"{game_txt}"
        )
        if indice:
            field_value += f"\n🔍 **Indice :** {indice}"
            if not is_admin:
                field_value += "\n🕵️ *Trouve ce Pokémon mystère !*"
        cursor.execute("SELECT pokemon_alternates FROM shiny_wanted WHERE id=?", (wd['id'],))
        alt_db = cursor.fetchone()
        if alt_db and alt_db[0]:
            try:
                alt_names = json.loads(alt_db[0])
                if alt_names:
                    visible = [n if (is_admin or not indice or indice.strip().startswith("[Méthode :")) else "???" for n in alt_names]
                    field_value += f"\n🔄 **Aussi accepté :** {', '.join(visible)}"
            except Exception:
                pass
        embed.add_field(name=field_name, value=field_value[:1024], inline=False)
    embed.set_footer(text="ShinyBot · Wanteds Serveur")
    return embed


def build_wanted_perso_embed(user_id):
    existing = get_active_personal_wanted(user_id)
    weekly_count = get_weekly_personal_wanted_count(user_id)
    joker_used = has_used_joker_this_week(user_id)
    joker_status = "🃏 **Joker :** ✅ Disponible" if not joker_used else "🃏 **Joker :** ❌ Déjà utilisé cette semaine"
    embed = discord.Embed(title="🎲 Mon Wanted Personnel", color=discord.Color.blurple())
    if existing:
        ts = int(datetime.fromisoformat(existing[4]).timestamp())
        embed.description = (
            f"🎯 En cours : **{existing[1]}** (Gen {existing[2]})\n"
            f"⏳ Expire <t:{ts}:R>\n"
            f"💰 Bonus si trouvé : **+{int(existing[3])} pts**\n\n"
            f"🗓️ Wanteds lancés cette semaine : **{weekly_count}/{PERSONAL_WANTED_WEEKLY_LIMIT}**\n"
            f"{joker_status}"
        )
    else:
        used_gens = get_used_generations(user_id)
        gen_keys = sorted(POKEMON_PAR_GEN)
        dispo = [str(g) for g in gen_keys if g not in used_gens]
        locked = [str(g) for g in gen_keys if g in used_gens]
        lines = [
            "Aucun wanted personnel actif.\n",
            f"🗓️ **Wanteds cette semaine :** {weekly_count}/{PERSONAL_WANTED_WEEKLY_LIMIT}\n",
            f"{joker_status}\n",
        ]
        if dispo:
            lines.append(f"✅ **Gens disponibles :** {', '.join(dispo)}")
        if locked:
            lines.append(f"🚫 **Gens déjà utilisées :** {', '.join(locked)}")
        if not joker_used and locked:
            lines.append("\n💡 *Tu peux utiliser le **🃏 Joker** pour re-tirer dans une gen déjà jouée !*")
        if weekly_count >= PERSONAL_WANTED_WEEKLY_LIMIT:
            lines.append("\n🚫 **Limite hebdomadaire atteinte** — reviens lundi !")
        else:
            lines.append("\n➡️ Clique sur **🎲 Lancer un wanted** pour tirer un Pokémon !")
        embed.description = "\n".join(lines)
    embed.set_footer(text=f"ShinyBot · +{int(PERSONAL_WANTED_BONUS)} pts si trouvé dans les {PERSONAL_WANTED_DURATION} jours")
    return embed


class WantedUnifiedView(discord.ui.View):
    def __init__(self, user_id, is_admin, page="serveur", show_menu_back=False):
        super().__init__(timeout=300)
        self.user_id = user_id
        self.is_admin = is_admin
        self.page = page
        self.show_menu_back = show_menu_back
        if show_menu_back:
            btn = discord.ui.Button(label="🏠 Menu", style=discord.ButtonStyle.secondary, row=1)
            btn.callback = self._menu_back
            self.add_item(btn)

    async def _menu_back(self, interaction: discord.Interaction):
        embed = build_menu_home_embed(interaction.user)
        await interaction.response.edit_message(embed=embed, view=MainMenuView(interaction.user.id))

    async def interaction_check(self, inter: discord.Interaction) -> bool:
        if str(inter.user.id) != self.user_id:
            await inter.response.send_message("❌ Ce menu n'est pas le tien.", ephemeral=True)
            return False
        return True

    @discord.ui.button(label="🎯 Wanteds Serveur", style=discord.ButtonStyle.primary, custom_id="w_serveur")
    async def btn_serveur(self, inter: discord.Interaction, button: discord.ui.Button):
        self.page = "serveur"
        await inter.response.edit_message(embed=build_wanted_server_embed(self.user_id, self.is_admin), view=self)

    @discord.ui.button(label="🎲 Mon Wanted Perso", style=discord.ButtonStyle.secondary, custom_id="w_perso")
    async def btn_perso(self, inter: discord.Interaction, button: discord.ui.Button):
        self.page = "perso"
        await inter.response.edit_message(embed=build_wanted_perso_embed(self.user_id), view=self)

    @discord.ui.button(label="🎲 Lancer un wanted", style=discord.ButtonStyle.success, custom_id="w_lancer")
    async def btn_lancer(self, inter: discord.Interaction, button: discord.ui.Button):
        existing = get_active_personal_wanted(self.user_id)
        weekly_count = get_weekly_personal_wanted_count(self.user_id)
        if existing:
            await inter.response.send_message("⚠️ Tu as déjà un wanted personnel actif !", ephemeral=True)
            return
        if weekly_count >= PERSONAL_WANTED_WEEKLY_LIMIT:
            await inter.response.send_message(f"🚫 Limite hebdomadaire atteinte ({weekly_count}/{PERSONAL_WANTED_WEEKLY_LIMIT}).", ephemeral=True)
            return
        used_gens = get_used_generations(self.user_id)
        gen_keys = sorted(POKEMON_PAR_GEN)
        dispo = [str(g) for g in gen_keys if g not in used_gens]
        locked = [str(g) for g in gen_keys if g in used_gens]
        embed_gen = discord.Embed(
            title="🎲 Wanted Personnel — Choisis ta génération",
            description=(
                f"Sélectionne une génération. Si tu trouves le Pokémon tiré en shiny dans les **{PERSONAL_WANTED_DURATION} jours**, tu gagnes **+{int(PERSONAL_WANTED_BONUS)} pts** !\n\n"
                + (f"✅ Disponibles : Gen {', '.join(dispo)}\n" if dispo else "")
                + (f"🚫 Déjà utilisées : Gen {', '.join(locked)}" if locked else "")
            ),
            color=discord.Color.gold()
        )
        await inter.response.edit_message(embed=embed_gen, view=WantedPersoGenSelect(used_gens))

    @discord.ui.button(label="🃏 Joker (1/semaine)", style=discord.ButtonStyle.danger, custom_id="w_joker")
    async def btn_joker(self, inter: discord.Interaction, button: discord.ui.Button):
        weekly_count = get_weekly_personal_wanted_count(self.user_id)
        if weekly_count >= PERSONAL_WANTED_WEEKLY_LIMIT:
            await inter.response.send_message(
                f"🚫 Limite hebdomadaire atteinte ({weekly_count}/{PERSONAL_WANTED_WEEKLY_LIMIT}).",
                ephemeral=True
            )
            return
        if has_used_joker_this_week(self.user_id):
            await inter.response.send_message(
                "🃏 Tu as déjà utilisé ton **joker** cette semaine !\n"
                "Reviens **lundi prochain** pour en avoir un nouveau.",
                ephemeral=True
            )
            return
        used_gens = get_used_generations(self.user_id)
        last_gen = get_last_used_generation(self.user_id)
        gen_keys = sorted(POKEMON_PAR_GEN)
        dispo = [str(g) for g in gen_keys if g not in used_gens]
        existing = get_active_personal_wanted(self.user_id)
        existing_note = ""
        if existing:
            existing_note = (
                f"⚠️ **Ton wanted en cours ({existing[1]}, Gen {existing[2]}) sera annulé** et remplacé par le nouveau tirage.\n\n"
            )
        if last_gen:
            joker_desc = (
                existing_note +
                f"Le **joker** te permet de re-tirer dans ta **dernière génération utilisée (Gen {last_gen})**, "
                f"en plus des gens encore libres.\n\n"
                f"♻️ **Re-tirage autorisé :** Gen {last_gen}\n"
            )
            if dispo:
                joker_desc += f"✅ **Gens libres :** Gen {', '.join(dispo)}\n"
            other_locked = [str(g) for g in gen_keys if g in used_gens and g != last_gen]
            if other_locked:
                joker_desc += f"🚫 **Toujours bloquées :** Gen {', '.join(other_locked)}\n"
        else:
            joker_desc = (
                existing_note +
                "Tu n'as encore utilisé aucune génération cette semaine.\n"
                "Le joker ne change rien : toutes les gens sont libres !\n"
            )
            if dispo:
                joker_desc += f"✅ **Gens disponibles :** Gen {', '.join(dispo)}"
        joker_desc += "\n\n**1 joker par semaine** — utilise-le bien !"
        embed_joker = discord.Embed(
            title="🃏 Joker — Re-tire dans ta dernière gen !",
            description=joker_desc,
            color=discord.Color.orange()
        )
        await inter.response.edit_message(embed=embed_joker, view=WantedPersoGenSelect(used_gens, joker_mode=True, last_used_gen=last_gen))


