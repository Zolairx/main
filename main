    return await pokemon_autocomplete(interaction, current)

@bot.tree.command(
    name="admin_disable_wanted",
    description="[ADMIN] Désactiver un Pokémon Shiny Wanted par ID",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    wanted_id="ID du wanted à désactiver (visible avec /wanted)"
)
async def admin_disable_wanted(interaction: discord.Interaction, wanted_id: int):
    async def _disable_wanted(**kwargs):
        await interaction.response.defer(ephemeral=True)

        if not interaction.user.guild_permissions.administrator:
            await interaction.followup.send("❌ Vous devez être administrateur pour utiliser cette commande.", ephemeral=True)
            return None

        cursor.execute("""
            SELECT pokemon_name, is_active FROM shiny_wanted WHERE id = ?
        """, (wanted_id,))
        row = cursor.fetchone()
        if not row:
            await interaction.followup.send("❌ Aucun wanted trouvé avec cet ID.", ephemeral=True)
            return None

        pokemon_name, is_active = row
        if not is_active:
            await interaction.followup.send(f"⚠️ Le wanted ID {wanted_id} (**{pokemon_name}**) est déjà désactivé.", ephemeral=True)
            return None

        cursor.execute("""
            UPDATE shiny_wanted
            SET is_active = 0, updated_at = datetime('now')
            WHERE id = ?
        """, (wanted_id,))
        conn.commit()

        embed = discord.Embed(
            title="✅ Pokémon Wanted Désactivé",
            description=f"Le wanted ID **{wanted_id}** pour **{pokemon_name}** a été désactivé.",
            color=discord.Color.red()
        )
        await interaction.followup.send(embed=embed, ephemeral=True)
        return True

    result = await discord_retry_wrapper(_disable_wanted, context="Admin Disable Wanted Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

# Dictionnaire pour stocker les races en attente d'acceptation
def build_open_race_embed(race_id):
    """Construit l'embed d'une race ouverte, à jour de son état (active / gagnée / annulée)."""
    race = get_open_race(race_id)
    if not race:
        return discord.Embed(title="🏁 Race introuvable", color=discord.Color.red())

    participants = get_open_race_participants(race_id)
    guild = bot.get_guild(GUILD_ID)
    names = []
    for uid in participants:
        member = guild.get_member(int(uid)) if guild else None
        names.append(member.display_name if member else f"Joueur {uid}")

    if race['status'] == 'active':
        color = discord.Color.gold()
        title = "🔒 Race Shiny Privée !" if race.get('is_private') else "🏁 Race Shiny Ouverte !"
        if race.get('is_private'):
            status_line = "🔒 **Race privée** — seuls les joueurs invités listés ci-dessous peuvent participer."
        else:
            status_line = "🟢 **En cours** — clique sur *Rejoindre* pour participer, à tout moment !"
    elif race['status'] == 'finished':
        color = discord.Color.green()
        winner = guild.get_member(int(race['winner_id'])) if guild and race['winner_id'] else None
        winner_name = winner.display_name if winner else f"Joueur {race['winner_id']}"
        title = "🏆 Race Shiny Terminée !"
        if race['awarded_points']:
            status_line = f"🏆 **Gagnant : {winner_name}** (+{race['awarded_points']} pts)"
        else:
            status_line = (
                f"🔍 **Trouvé par {winner_name}** — mais aucun bonus versé "
                f"(il fallait au moins {RACE_MIN_PARTICIPANTS_FOR_REWARD} participants pour éviter la triche)."
            )
    else:
        color = discord.Color.light_grey()
        title = "🚫 Race Shiny Annulée"
        status_line = "🚫 Cette race a été annulée."

    creator = guild.get_member(int(race['created_by'])) if guild else None
    creator_name = creator.display_name if creator else f"Joueur {race['created_by']}"

    embed = discord.Embed(title=title, color=color)
    embed.add_field(name="🎯 Pokémon cible", value=f"**{race['pokemon_name']}**", inline=True)
    embed.add_field(name="🎮 Jeu / Version", value=race['game'] or "—", inline=True)
    embed.add_field(name="💰 Points bonus", value=f"+{race['bonus_points']} pts", inline=True)
    embed.add_field(name="👑 Lancée par", value=creator_name, inline=True)
    embed.add_field(name="🆔 ID Race", value=f"#{race['id']}", inline=True)
    embed.add_field(name="🎯 Méthode", value=race.get('method_label') or "Toutes méthodes", inline=True)
    embed.add_field(name="🕹️ Consoles max", value=(f"{race['max_consoles']}" if race.get('max_consoles') else "Illimité"), inline=True)
    participants_text = ", ".join(names) if names else "Aucun participant"
    if len(participants_text) > 1000:
        participants_text = participants_text[:1000] + "…"
    embed.add_field(name=f"👥 Participants ({len(names)})", value=participants_text, inline=False)
    embed.add_field(name="📋 Statut", value=status_line, inline=False)
    embed.set_footer(text=f"Le premier à ajouter ce shiny avec /shiny_ajout (méthode et consoles respectées) remporte la race ! (min. {RACE_MIN_PARTICIPANTS_FOR_REWARD} participants pour que le bonus soit versé)")
    return embed


async def close_open_race_message(race_id, winner_member=None):
    """Met à jour (et verrouille) le message de la race dans le salon une fois qu'elle est terminée."""
    try:
        race = get_open_race(race_id)
        if not race or not race.get('channel_id') or not race.get('message_id'):
            return
        channel = bot.get_channel(int(race['channel_id']))
        if not channel:
            return
        try:
            message = await channel.fetch_message(int(race['message_id']))
        except Exception:
            return
        embed = build_open_race_embed(race_id)
        try:
            await message.edit(embed=embed, view=None)
        except Exception:
            pass
        if winner_member is not None:
            try:
                if race['awarded_points']:
                    await channel.send(
                        f"🏆 {winner_member.mention} remporte la race pour **{race['pokemon_name']}** "
                        f"avec **+{race['awarded_points']} pts** ! 🎉"
                    )
                else:
                    await channel.send(
                        f"🔍 {winner_member.mention} a trouvé **{race['pokemon_name']}** en premier, "
                        f"mais aucun bonus n'est versé : il fallait au moins {RACE_MIN_PARTICIPANTS_FOR_REWARD} "
                        f"participants pour que la race soit valide."
                    )
            except Exception:
                pass
    except Exception as e:
        logger.error(f"Erreur fermeture message race ouverte #{race_id}: {e}")


class OpenRaceView(discord.ui.View):
    """Vue publique d'une race ouverte : bouton pour rejoindre (illimité) + annulation par le créateur/un admin."""
    def __init__(self, race_id):
        super().__init__(timeout=None)
        self.race_id = race_id

        join_btn = discord.ui.Button(
            label="🏁 Rejoindre la race",
            style=discord.ButtonStyle.success,
            custom_id=f"open_race_join_{race_id}"
        )
        join_btn.callback = self._join
        self.add_item(join_btn)

        cancel_btn = discord.ui.Button(
            label="🚫 Annuler",
            style=discord.ButtonStyle.danger,
            custom_id=f"open_race_cancel_{race_id}"
        )
        cancel_btn.callback = self._cancel
        self.add_item(cancel_btn)

    async def _join(self, interaction: discord.Interaction):
        race = get_open_race(self.race_id)
        if not race or race['status'] != 'active':
            await interaction.response.send_message("❌ Cette race n'est plus active.", ephemeral=True)
            return

        if race.get('is_private'):
            cursor.execute(
                "SELECT 1 FROM open_race_participants WHERE race_id=? AND user_id=?",
                (self.race_id, str(interaction.user.id))
            )
            if not cursor.fetchone():
                await interaction.response.send_message(
                    "🔒 Cette race est privée — seuls les joueurs invités par le créateur peuvent y participer.",
                    ephemeral=True
                )
                return

        joined = join_open_race(self.race_id, interaction.user.id)
        embed = build_open_race_embed(self.race_id)
        try:
            await interaction.response.edit_message(embed=embed, view=self)
        except Exception:
            pass

        try:
            if joined:
                await interaction.followup.send(
                    f"🏁 Tu participes maintenant à la race pour **{race['pokemon_name']}** !\n"
                    f"Trouve-le en shiny et enregistre-le avec `/shiny_ajout` pour remporter **+{race['bonus_points']} pts**.",
                    ephemeral=True
                )
            else:
                await interaction.followup.send("✅ Tu participes déjà à cette race !", ephemeral=True)
        except Exception:
            pass

    async def _cancel(self, interaction: discord.Interaction):
        race = get_open_race(self.race_id)
        if not race:
            await interaction.response.send_message("❌ Race introuvable.", ephemeral=True)
            return

        is_admin = interaction.user.guild_permissions.administrator
        if str(interaction.user.id) != str(race['created_by']) and not is_admin:
            await interaction.response.send_message(
                "❌ Seul le créateur de la race ou un admin peut l'annuler.", ephemeral=True
            )
            return

        if race['status'] != 'active':
            await interaction.response.send_message("⚠️ Cette race n'est plus active.", ephemeral=True)
            return

        cancel_open_race(self.race_id)
        for item in self.children:
            item.disabled = True
        embed = build_open_race_embed(self.race_id)
        try:
            await interaction.response.edit_message(embed=embed, view=self)
        except Exception:
            pass


def restore_active_open_race_views():
    """Réenregistre auprès du bot les vues (boutons Rejoindre/Annuler) de toutes les races
    ouvertes encore actives, pour qu'elles restent cliquables après un redémarrage du bot."""
    cursor.execute("""
        SELECT id, message_id FROM open_races
        WHERE status = 'active' AND message_id IS NOT NULL
    """)
    rows = cursor.fetchall()
    count = 0
    for race_id, message_id in rows:
        if not message_id:
            continue
        try:
            view = OpenRaceView(race_id)
            bot.add_view(view, message_id=int(message_id))
            count += 1
        except Exception as e:
            logger.error(f"Impossible de réattacher la vue de la race ouverte #{race_id}: {e}")
    return count


class RaceGameSelectView(discord.ui.View):
    """Vue affichée après /race_shiny : choisir le jeu parmi le menu déroulant (comme /shiny_ajout)."""
    def __init__(self, pokemon, language, creator_id, origin_channel_id):
        super().__init__(timeout=180)
        self.pokemon = pokemon
        self.language = language
        self.creator_id = creator_id
        self.origin_channel_id = origin_channel_id

        game_options = []
        for game_key, translations in GAMES.items():
            name = translations["fr"] if language == "Français" else translations["en"]
            game_options.append(discord.SelectOption(label=name[:100], value=game_key))

        if len(game_options) <= 25:
            select = discord.ui.Select(
                placeholder="Choisissez le jeu" if language == "Français" else "Choose the game",
                options=game_options
            )
            select.callback = self.game_callback
            self.add_item(select)
        else:
            for i in range(0, len(game_options), 25):
                batch = game_options[i:i + 25]
                select = discord.ui.Select(
                    placeholder=f"Jeux {i // 25 + 1}" if language == "Français" else f"Games {i // 25 + 1}",
                    options=batch
                )
                select.callback = self.game_callback
                self.add_item(select)

    async def game_callback(self, interaction: discord.Interaction):
        async def _respond(**kwargs):
            game_key = interaction.data['values'][0]
            game_name = GAMES[game_key]['fr' if self.language == 'Français' else 'en']

            methods = METHODS_BY_GAME.get(game_key, {})
            if methods:
                view = RaceMethodSelectView(self.pokemon, self.language, self.creator_id, self.origin_channel_id, game_key, game_name)
                prompt = "🎯 Choisissez une méthode pour cette race (optionnel) :" if self.language == "Français" else "🎯 Choose a method for this race (optional):"
                await interaction.response.edit_message(content=prompt, view=view)
            else:
                # Pas de méthode définie pour ce jeu : passer directement au choix des consoles
                view = RaceConsolesSelectView(self.pokemon, self.language, self.creator_id, self.origin_channel_id, game_key, game_name, None, None)
                prompt = "🕹️ Nombre de consoles max autorisées pour cette race (optionnel) :" if self.language == "Français" else "🕹️ Max number of consoles allowed for this race (optional):"
                await interaction.response.edit_message(content=prompt, view=view)

        await discord_retry_wrapper(_respond, context="Race Game Select")


class RaceMethodSelectView(discord.ui.View):
    """Étape 2 : choisir une méthode précise pour la race (ou toutes les méthodes)."""
    def __init__(self, pokemon, language, creator_id, origin_channel_id, game_key, game_name):
        super().__init__(timeout=180)
        self.pokemon = pokemon
        self.language = language
        self.creator_id = creator_id
        self.origin_channel_id = origin_channel_id
        self.game_key = game_key
        self.game_name = game_name

        methods = METHODS_BY_GAME.get(game_key, {})
        method_options = [
            discord.SelectOption(
                label="🌐 Toutes les méthodes" if language == "Français" else "🌐 All methods",
                value="any"
            )
        ]
        for method_key, translations in methods.items():
            name = translations["fr"] if language == "Français" else translations["en"]
            method_options.append(discord.SelectOption(label=name[:100], value=method_key))

        select = discord.ui.Select(
            placeholder="Choisissez une méthode" if language == "Français" else "Choose a method",
            options=method_options[:25]
        )
        select.callback = self.method_callback
        self.add_item(select)

    async def method_callback(self, interaction: discord.Interaction):
        async def _respond(**kwargs):
            value = interaction.data['values'][0]
            if value == "any":
                method_key, method_label = None, None
            else:
                method_key = value
                translations = METHODS_BY_GAME.get(self.game_key, {}).get(method_key, {})
                method_label = translations.get("fr" if self.language == "Français" else "en", method_key)

            view = RaceConsolesSelectView(self.pokemon, self.language, self.creator_id, self.origin_channel_id, self.game_key, self.game_name, method_key, method_label)
            prompt = "🕹️ Nombre de consoles max autorisées pour cette race (optionnel) :" if self.language == "Français" else "🕹️ Max number of consoles allowed for this race (optional):"
            await interaction.response.edit_message(content=prompt, view=view)

        await discord_retry_wrapper(_respond, context="Race Method Select")


class RaceConsolesSelectView(discord.ui.View):
    """Étape 3 (finale) : choisir le nombre de consoles max autorisées, puis créer la race."""
    def __init__(self, pokemon, language, creator_id, origin_channel_id, game_key, game_name, method_key, method_label):
        super().__init__(timeout=180)
        self.pokemon = pokemon
        self.language = language
        self.creator_id = creator_id
        self.origin_channel_id = origin_channel_id
        self.game_key = game_key
        self.game_name = game_name
        self.method_key = method_key
        self.method_label = method_label

        unlimited_label = "🔓 Illimité" if language == "Français" else "🔓 Unlimited"
        console_options = [discord.SelectOption(label=unlimited_label, value="0")]
        for n in (1, 2, 3, 4):
            label = f"🕹️ {n} console{'s' if n > 1 else ''} max"
            console_options.append(discord.SelectOption(label=label, value=str(n)))

        select = discord.ui.Select(
            placeholder="Nombre de consoles max" if language == "Français" else "Max number of consoles",
            options=console_options
        )
        select.callback = self.consoles_callback
        self.add_item(select)

    async def consoles_callback(self, interaction: discord.Interaction):
        async def _respond(**kwargs):
            max_consoles = int(interaction.data['values'][0]) or None
            view = RaceOpponentsSelectView(
                self.pokemon, self.language, self.creator_id, self.origin_channel_id,
                self.game_key, self.game_name, self.method_key, self.method_label, max_consoles
            )
            prompt = (
                "⚔️ Choisis des adversaires précis (optionnel) — laisse vide pour une race ouverte à tous :"
                if self.language == "Français" else
                "⚔️ Choose specific opponents (optional) — leave empty for a race open to everyone:"
            )
            await interaction.response.edit_message(content=prompt, view=view)

        await discord_retry_wrapper(_respond, context="Race Consoles Select")


class RaceOpponentsSelectView(discord.ui.View):
    """Étape 4 : choisir des adversaires précis (optionnel) via un menu de sélection de membres."""
    def __init__(self, pokemon, language, creator_id, origin_channel_id, game_key, game_name, method_key, method_label, max_consoles):
        super().__init__(timeout=180)
        self.pokemon = pokemon
        self.language = language
        self.creator_id = creator_id
        self.origin_channel_id = origin_channel_id
        self.game_key = game_key
        self.game_name = game_name
        self.method_key = method_key
        self.method_label = method_label
        self.max_consoles = max_consoles

        user_select = discord.ui.UserSelect(
            placeholder="⚔️ Adversaires (optionnel)" if language == "Français" else "⚔️ Opponents (optional)",
            min_values=0,
            max_values=24
        )
        user_select.callback = self.opponents_callback
        self.add_item(user_select)

        skip_btn = discord.ui.Button(
            label="Passer — race ouverte à tous" if language == "Français" else "Skip — race open to everyone",
            style=discord.ButtonStyle.secondary
        )
        skip_btn.callback = self.skip_callback
        self.add_item(skip_btn)

    async def _go_to_privacy(self, interaction, opponent_ids):
        view = RacePrivacySelectView(
            self.pokemon, self.language, self.creator_id, self.origin_channel_id,
            self.game_key, self.game_name, self.method_key, self.method_label, self.max_consoles,
            opponent_ids
        )
        if opponent_ids:
            names_preview = ", ".join(f"<@{uid}>" for uid in opponent_ids[:10])
            extra = f" (+{len(opponent_ids)-10} autres)" if len(opponent_ids) > 10 else ""
            prompt = (
                f"⚔️ Adversaires choisis : {names_preview}{extra}\n\n"
                f"🔒 Cette race doit-elle être **privée** (réservée à ces joueurs + toi) ou **ouverte** à tous malgré tout ?"
            )
        else:
            prompt = "🌐 Aucun adversaire choisi — la race sera ouverte à tous. Confirme ci-dessous :"
        await interaction.response.edit_message(content=prompt, view=view)

    async def opponents_callback(self, interaction: discord.Interaction):
        opponent_ids = list(interaction.data.get('values', []))
        await self._go_to_privacy(interaction, opponent_ids)

    async def skip_callback(self, interaction: discord.Interaction):
        await self._go_to_privacy(interaction, [])


class RacePrivacySelectView(discord.ui.View):
    """Étape 5 (finale) : choisir si la race est privée ou publique, puis la créer."""
    def __init__(self, pokemon, language, creator_id, origin_channel_id, game_key, game_name, method_key, method_label, max_consoles, opponent_ids):
        super().__init__(timeout=180)
        self.pokemon = pokemon
        self.language = language
        self.creator_id = creator_id
        self.origin_channel_id = origin_channel_id
        self.game_key = game_key
        self.game_name = game_name
        self.method_key = method_key
        self.method_label = method_label
        self.max_consoles = max_consoles
        self.opponent_ids = opponent_ids

        if opponent_ids:
            private_btn = discord.ui.Button(label="🔒 Privée (invités seulement)", style=discord.ButtonStyle.danger)
            private_btn.callback = self._make_finalize(True)
            self.add_item(private_btn)

            public_btn = discord.ui.Button(label="🌐 Ouverte à tous", style=discord.ButtonStyle.secondary)
            public_btn.callback = self._make_finalize(False)
            self.add_item(public_btn)
        else:
            confirm_btn = discord.ui.Button(label="✅ Confirmer", style=discord.ButtonStyle.success)
            confirm_btn.callback = self._make_finalize(False)
            self.add_item(confirm_btn)

    def _make_finalize(self, is_private):
        async def _finalize(interaction: discord.Interaction):
            async def _respond(**kwargs):
                race_id = create_open_race(
                    self.pokemon, self.game_name, RACE_DEFAULT_BONUS_POINTS, self.creator_id,
                    method_key=self.method_key, method_label=self.method_label, max_consoles=self.max_consoles,
                    is_private=is_private, opponent_ids=self.opponent_ids
                )

                embed = build_open_race_embed(race_id)
                view = OpenRaceView(race_id)

                channel = bot.get_channel(self.origin_channel_id) or interaction.channel
                message = await channel.send(embed=embed, view=view)
                set_open_race_message(race_id, channel.id, message.id)
                try:
                    bot.add_view(view, message_id=message.id)
                except Exception as e:
                    logger.error(f"Impossible d'enregistrer la vue persistante de la race #{race_id}: {e}")

                method_txt = f" · méthode : **{self.method_label}**" if self.method_label else ""
                consoles_txt = f" · max **{self.max_consoles}** console(s)" if self.max_consoles else ""
                privacy_txt = " · 🔒 privée" if is_private else ""
                confirm = (
                    f"✅ Race lancée pour **{self.pokemon}** ({self.game_name}){method_txt}{consoles_txt}{privacy_txt} — +{int(RACE_DEFAULT_BONUS_POINTS)} pts pour le gagnant !"
                    if self.language == "Français" else
                    f"✅ Race launched for **{self.pokemon}** ({self.game_name}){method_txt}{consoles_txt}{privacy_txt} — +{int(RACE_DEFAULT_BONUS_POINTS)} pts for the winner!"
                )
                await interaction.response.edit_message(content=confirm, embed=None, view=None)

            await discord_retry_wrapper(_respond, context="Race Privacy Select")
        return _finalize


