    """Retourne (embed, view) pour le flux d'ajout de shiny (même flux que /shiny_ajout)."""
    return build_shiny_entry(user_id, interaction)



def build_menu_home_embed(member):
    user_id = str(member.id)
    lines = [
        "Bienvenue ! Utilise les **boutons ci-dessous** pour naviguer.",
        "Tu n'as pas besoin de mémoriser toutes les commandes slash.\n",
    ]
    if is_in_placement(user_id):
        placement_row = get_or_init_placement_state(user_id)
        if placement_row:
            shinys_used = placement_row[0]
            lines.append(
                f"🆕 **Série de placement** : **{shinys_used}/{PLACEMENT_MAX_SHINYS}** shinys\n"
                f"Tes prochains ajouts bénéficient de règles allégées — commence par **Ajouter un shiny** !\n"
            )
    rank, total_pts = get_user_rank(user_id)
    if rank:
        pts_str = f"{total_pts:.1f}" if total_pts % 1 != 0 else str(int(total_pts))
        lines.append(f"📊 Ton rang actuel : **#{rank}** — **{pts_str} pts**")
    else:
        lines.append("📊 Tu n'es pas encore classé — ajoute ton premier shiny pour commencer !")

    embed = discord.Embed(
        title="🧭 Menu ShinyBot",
        description="\n".join(lines),
        color=discord.Color.blurple(),
        timestamp=datetime.now()
    )
    embed.set_thumbnail(url=member.display_avatar.url)
    embed.add_field(
        name="💡 Astuce",
        value="Ce menu est **éphémère** (visible uniquement par toi). "
              "Pour un suivi détaillé, utilise aussi `/mon_recap`.",
        inline=False
    )
    embed.set_footer(text="ShinyBot · Menu central")
    return embed


def build_menu_classement_embed(guild, user_id):
    ladder = get_ladder()
    medals = ["🥇", "🥈", "🥉"]
    lines = []
    for i, row in enumerate(ladder[:10]):
        uid, pts, _, _ = row
        m = guild.get_member(int(uid)) if guild else None
        name = m.display_name if m else f"<@{uid}>"
        medal = medals[i] if i < 3 else f"`#{i + 1}`"
        pts_str = f"{pts:.1f}" if pts % 1 != 0 else str(int(pts))
        marker = " ← **Toi**" if str(uid) == user_id else ""
        trend_symbol, trend_delta = get_rank_trend(uid)
        trend_str = f" {trend_symbol}{trend_delta}" if trend_delta else (" –" if trend_symbol == "–" else "")
        lines.append(f"{medal} **{name}** — {pts_str} pts{trend_str}{marker}")

    my_rank = next((i + 1 for i, r in enumerate(ladder) if str(r[0]) == user_id), None)
    desc = "\n".join(lines) if lines else "Aucun joueur classé pour le moment."
    if my_rank and my_rank > 10:
        my_pts = next(r[1] for r in ladder if str(r[0]) == user_id)
        pts_str = f"{my_pts:.1f}" if my_pts % 1 != 0 else str(int(my_pts))
        desc += f"\n\n📍 **Ta position :** #{my_rank} — {pts_str} pts"
        # Barre de progression vers le rang juste au-dessus
        if my_rank > 1:
            above_pts = ladder[my_rank - 2][1]
            if above_pts > 0:
                ratio = my_pts / above_pts
                bar = render_progress_bar(ratio)
                gap = max(0.0, above_pts - my_pts)
                desc += f"\n`{bar}` {gap:.1f} pts pour dépasser #{my_rank - 1}"

    embed_color = get_tier_color_by_position(my_rank) if my_rank else discord.Color.gold()

    embed = discord.Embed(
        title="🏆 Classement Ranked",
        description=desc,
        color=embed_color
    )
    embed.add_field(
        name="📢 Classement complet",
        value=f"Consulte le salon <#{SALON_CLASSEMENT_ID}> pour le podium détaillé.",
        inline=False
    )
    embed.set_footer(text="ShinyBot · Top 10 · Tendance vs hier")
    return embed


def build_menu_races_embed(guild):
    open_races = get_active_open_races()
    legacy_races = get_active_races()
    if not open_races and not legacy_races:
        return discord.Embed(
            title="🏁 Races Shiny",
            description="Aucune race active pour le moment.\n\n"
                        "Lance une race ouverte avec `/race_shiny` ou une race en équipe avec `/race_equipe_create`.",
            color=discord.Color.orange()
        )
    embed = discord.Embed(title="🏁 Races Shiny Actives", color=discord.Color.orange())
    for race in open_races[:5]:
        race_id, pokemon_name, game, bonus_points, created_by, created_at = race
        nb_participants = len(get_open_race_participants(race_id))
        creator = guild.get_member(int(created_by)) if guild else None
        creator_name = creator.display_name if creator else created_by
        embed.add_field(
            name=f"🆕 Race Ouverte #{race_id} — {pokemon_name}",
            value=(
                f"👑 {creator_name} · 🎮 {game or '?'}\n"
                f"💰 +{bonus_points} pts · 👥 {nb_participants} participant(s)"
            ),
            inline=False
        )
    for race in legacy_races[:3]:
        race_id, challenger_id, opponent_id, pokemon_name, game, bonus_points, _ = race
        challenger = guild.get_member(int(challenger_id)) if guild else None
        opponent = guild.get_member(int(opponent_id)) if guild else None
        c_name = challenger.display_name if challenger else challenger_id
        o_name = opponent.display_name if opponent else opponent_id
        embed.add_field(
            name=f"⚔️ Race #{race_id} — {pokemon_name}",
            value=f"**{c_name}** vs **{o_name}** · 🎮 {game or '?'} · 💰 +{bonus_points} pts",
            inline=False
        )
    embed.set_footer(text="ShinyBot · Races")
    return embed


def build_menu_regles_embed(user_id):
    weekly_pts = get_user_weekly_pts(user_id)
    pos_mult = get_position_multiplier(user_id)
    ladder = get_ladder()
    rank = next((i + 1 for i, r in enumerate(ladder) if str(r[0]) == user_id), None)

    def _eff_pct(x):
        if x <= WEEKLY_CAP:
            return 100
        return round((_weekly_soft_cap(x + 10) - _weekly_soft_cap(x)) / 10 * 100)

    embed = discord.Embed(title="📘 Règles Ranked Shiny", color=get_tier_color_by_position(rank) if rank else discord.Color.blurple(), timestamp=datetime.now())
    embed.add_field(
        name="🧮 Cap hebdo",
        value=f"Sous **{WEEKLY_CAP:.0f} pts** de shinys bruts : 100% d'efficacité. Au-delà, soft cap progressif.",
        inline=False
    )
    embed.add_field(
        name="📈 Multiplicateur de position",
        value="Top 3 : **×0.92 à ×0.98** (progressif selon l'écart) · 4–10 : **×1.1** · 11+ : **×1.25**",
        inline=False
    )
    embed.add_field(
        name="📊 Barème des points",
        value="Consulte `/shiny_points` pour le détail par jeu et méthode.",
        inline=False
    )
    if rank:
        pos_label = (f"🔴 Nerf ×{pos_mult:.2f}" if pos_mult < 1 else
                     "🟡 Bonus ×1.1" if pos_mult == 1.1 else
                     "🟢 Comeback ×1.25")
        _eff_now = _weekly_soft_cap(weekly_pts)
        _current_eff = round((_weekly_soft_cap(weekly_pts + 10) - _eff_now) / 10 * 100)
        cap_ratio = min(1.0, weekly_pts / WEEKLY_CAP) if WEEKLY_CAP else 0
        cap_bar = render_progress_bar(cap_ratio)
        embed.add_field(
            name=f"📊 Ton état (#{rank})",
            value=(
                f"Position : **{pos_label}**\n"
                f"Points cap semaine : `{cap_bar}` **{weekly_pts:.1f}** / {WEEKLY_CAP:.0f} pts\n"
                f"Efficacité actuelle : **~{_current_eff}%**"
            ),
            inline=False
        )
    embed.set_footer(text="ShinyBot · /ranked_regles pour le détail complet")
    return embed


def build_menu_objectifs_embed(user_id, page="semaine"):
    if page == "semaine":
        objectives = get_active_weekly_objectives()
        week_start = get_current_week_start()
        if not objectives:
            return discord.Embed(
                title="📅 Objectifs Hebdomadaires",
                description="Aucun objectif actif cette semaine.",
                color=discord.Color.light_grey()
            )
        chosen_ids = get_user_weekly_choices(user_id)
        if not chosen_ids:
            diff_emoji = {"easy": "🟢", "medium": "🟡", "hard": "🔴"}
            embed = discord.Embed(
                title="📅 Choix d'objectifs requis",
                description=(
                    f"Semaine du **{week_start}**\n\n"
                    "Tu dois choisir **2 objectifs** parmi ceux proposés.\n"
                    "Utilise `/objectifs` pour faire ton choix."
                ),
                color=discord.Color.gold()
            )
            for obj in objectives[:4]:
                embed.add_field(
                    name=f"{diff_emoji.get(obj['difficulty'], '⚪')} {obj['description']}",
                    value=f"⭐ +{obj['bonus_points']} pts",
                    inline=False
                )
            return embed
        diff_emoji = {"easy": "🟢", "medium": "🟡", "hard": "🔴"}
        chosen_objs = [o for o in objectives if o["id"] in chosen_ids]
        embed = discord.Embed(
            title="📅 Mes Objectifs de la Semaine",
            description=f"Semaine du **{week_start}**",
            color=discord.Color.gold()
        )
        for obj in chosen_objs:
            progress = get_user_objective_progress(user_id, obj["id"])
            current = progress["current_value"]
            target = obj["target_value"]
            completed = bool(progress["completed"])
            tgt_str = int(target) if target == int(target) else target
            status = "✅ Complété !" if completed else f"⏳ {current}/{tgt_str}"
            bar_filled = int((min(current, target) / target) * 10) if target > 0 else 0
            bar = "█" * bar_filled + "░" * (10 - bar_filled)
            embed.add_field(
                name=f"{diff_emoji.get(obj['difficulty'], '⚪')} {obj['description']}",
                value=f"{status}\n`{bar}` → +{obj['bonus_points']} pts",
                inline=False
            )
        embed.set_footer(text="ShinyBot · Objectifs semaine")
        return embed

    objectives = get_active_monthly_objectives()
    month_start = get_current_month_start()
    if not objectives:
        return discord.Embed(
            title="📆 Objectifs Mensuels",
            description="Aucun objectif actif ce mois.",
            color=discord.Color.light_grey()
        )
    diff_emoji = {"easy": "🟢", "medium": "🟡", "hard": "🔴", "": "⚪"}
    embed = discord.Embed(
        title="📆 Objectifs du Mois",
        description=f"Mois de **{month_start[:7]}**",
        color=discord.Color.purple()
    )
    for obj in objectives:
        progress = get_user_monthly_progress(user_id, obj["id"])
        current = progress["current_value"]
        target = obj["target_value"]
        completed = bool(progress["completed"])
        tgt_str = int(target) if target == int(target) else target
        status = "✅ Complété !" if completed else f"⏳ {current}/{tgt_str}"
        bar_filled = int((min(current, target) / target) * 10) if target > 0 else 0
        bar = "█" * bar_filled + "░" * (10 - bar_filled)
        embed.add_field(
            name=f"{diff_emoji.get(obj['difficulty'], '⚪')} {obj['description']}",
            value=f"{status}\n`{bar}` → +{obj['bonus_points']} pts",
            inline=False
        )
    embed.set_footer(text="ShinyBot · Objectifs mois")
    return embed


def build_menu_guilde_embed(guild, user_id):
    guilde = guilde_of_user(user_id)
    if not guilde:
        return discord.Embed(
            title="🏰 Guildes",
            description=(
                "Tu n'es dans **aucune guilde** pour le moment.\n\n"
                "• `/guilde_creer` — créer ta propre guilde\n"
                "• `/guilde_rejoindre` — demander à rejoindre une guilde existante\n\n"
                "Les guildes cumulent les points de leurs membres et ont des **objectifs hebdo** communs !"
            ),
            color=discord.Color.light_grey()
        )
    guilde_id, g_nom, g_desc, owner_id, g_emoji, g_logo, g_created = (
        guilde[0], guilde[1], guilde[2], guilde[3], guilde[4], guilde[5], guilde[6]
    )
    membres = guilde_get_members(guilde_id)
    pts_total = guilde_get_points(guilde_id)
    cursor.execute("""
        SELECT m.user_id, COALESCE(SUM(s.points), 0) as pts
        FROM shinyhunter_guilde_membres m
        LEFT JOIN shiny s ON s.user_id = m.user_id
        WHERE m.guilde_id = ?
        GROUP BY m.user_id ORDER BY pts DESC LIMIT 5
    """, (guilde_id,))
    membres_pts = cursor.fetchall()
    medals = ["🥇", "🥈", "🥉"]
    lines = []
    for i, (uid, pts) in enumerate(membres_pts):
        member = guild.get_member(int(uid)) if guild else None
        name = member.display_name if member else f"<@{uid}>"
        crown = " 👑" if uid == owner_id else ""
        medal = medals[i] if i < 3 else f"`#{i + 1}`"
        lines.append(f"{medal} **{name}**{crown} — {pts:.0f} pts")
    embed = discord.Embed(
        title=f"{g_emoji} {g_nom}",
        description=g_desc or "*Pas de description.*",
        color=discord.Color.gold()
    )
    if g_logo:
        embed.set_thumbnail(url=g_logo)
    embed.add_field(name="⭐ Points totaux", value=f"**{pts_total:.0f}** pts", inline=True)
    embed.add_field(name="👥 Membres", value=f"{len(membres)}/{GUILDE_MAX_MEMBRES}", inline=True)
    embed.add_field(name="📊 Top contributeurs", value="\n".join(lines) if lines else "—", inline=False)
    embed.set_footer(text="ShinyBot · /guilde_voir pour l'objectif hebdo")
    return embed


class MenuBackView(discord.ui.View):
    """Vue minimale avec bouton retour au menu principal."""
    def __init__(self, owner_id):
        super().__init__(timeout=300)
        self.owner_id = owner_id

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        if interaction.user.id != self.owner_id:
            await interaction.response.send_message("❌ Ce menu n'est pas le tien.", ephemeral=True)
            return False
        return True

    @discord.ui.button(label="🏠 Menu", style=discord.ButtonStyle.secondary)
    async def menu_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        embed = build_menu_home_embed(interaction.user)
        await interaction.response.edit_message(embed=embed, view=MainMenuView(interaction.user.id))


class MenuObjectifsView(MenuBackView):
    def __init__(self, owner_id, page="semaine"):
        super().__init__(owner_id)
        self.page = page

    @discord.ui.button(label="📅 Semaine", style=discord.ButtonStyle.primary, row=0)
    async def btn_semaine(self, interaction: discord.Interaction, button: discord.ui.Button):
        self.page = "semaine"
        button.style = discord.ButtonStyle.primary
        self.btn_mois.style = discord.ButtonStyle.secondary
        await interaction.response.edit_message(
            embed=build_menu_objectifs_embed(str(interaction.user.id), "semaine"),
            view=self
        )

    @discord.ui.button(label="📆 Mois", style=discord.ButtonStyle.secondary, row=0)
    async def btn_mois(self, interaction: discord.Interaction, button: discord.ui.Button):
        self.page = "mois"
        button.style = discord.ButtonStyle.primary
        self.btn_semaine.style = discord.ButtonStyle.secondary
        await interaction.response.edit_message(
            embed=build_menu_objectifs_embed(str(interaction.user.id), "mois"),
            view=self
        )


class MainMenuView(discord.ui.View):
    def __init__(self, owner_id):
        super().__init__(timeout=300)
        self.owner_id = owner_id

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        if interaction.user.id != self.owner_id:
            await interaction.response.send_message("❌ Ce menu n'est pas le tien.", ephemeral=True)
            return False
        return True

    @discord.ui.button(label="✨ Ajouter un shiny", style=discord.ButtonStyle.success, row=0)
    async def shiny_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        embed, view = build_shiny_add_embed_and_view(interaction.user.id, interaction)
        await interaction.response.edit_message(embed=embed, view=view)

    @discord.ui.button(label="👤 Mon profil", style=discord.ButtonStyle.primary, row=0)
    async def profil_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        guild = bot.get_guild(GUILD_ID)
        user_id = str(interaction.user.id)
        ladder_list = get_ladder()
        embed = build_profile_embed(guild, user_id, ladder_list)
        if not embed:
            embed = discord.Embed(
                title=f"👤 {interaction.user.display_name}",
                description="Tu n'as pas encore de shiny enregistré !\nClique sur **Ajouter un shiny** pour commencer. 🌟",
                color=discord.Color.light_grey()
            )
            embed.set_thumbnail(url=interaction.user.display_avatar.url)
        await interaction.response.edit_message(embed=embed, view=MenuBackView(interaction.user.id))

    @discord.ui.button(label="📋 Mon récap", style=discord.ButtonStyle.primary, row=0)
    async def recap_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        embed = build_recap_focus_embed(interaction.user, "accueil")
        await interaction.response.edit_message(embed=embed, view=MenuRecapView(interaction.user))

    @discord.ui.button(label="🎯 Wanteds", style=discord.ButtonStyle.secondary, row=1)
    async def wanted_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        user_id = str(interaction.user.id)
        is_admin = interaction.user.guild_permissions.administrator
        embed = build_wanted_server_embed(user_id, is_admin)
        await interaction.response.edit_message(
            embed=embed,
            view=WantedUnifiedView(user_id, is_admin, "serveur", show_menu_back=True)
        )

    @discord.ui.button(label="🏁 Races", style=discord.ButtonStyle.secondary, row=1)
    async def races_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        guild = bot.get_guild(GUILD_ID)
        embed = build_menu_races_embed(guild)
        await interaction.response.edit_message(embed=embed, view=MenuBackView(interaction.user.id))

    @discord.ui.button(label="🏰 Guilde", style=discord.ButtonStyle.secondary, row=1)
    async def guilde_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        guild = bot.get_guild(GUILD_ID)
        embed = build_menu_guilde_embed(guild, str(interaction.user.id))
        await interaction.response.edit_message(embed=embed, view=MenuBackView(interaction.user.id))

    @discord.ui.button(label="🏆 Classement", style=discord.ButtonStyle.secondary, row=2)
    async def classement_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        guild = bot.get_guild(GUILD_ID)
        embed = build_menu_classement_embed(guild, str(interaction.user.id))
        await interaction.response.edit_message(embed=embed, view=MenuBackView(interaction.user.id))

    @discord.ui.button(label="📌 Objectifs", style=discord.ButtonStyle.secondary, row=2)
    async def objectifs_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        user_id = str(interaction.user.id)
        embed = build_menu_objectifs_embed(user_id, "semaine")
        await interaction.response.edit_message(embed=embed, view=MenuObjectifsView(interaction.user.id, "semaine"))

    @discord.ui.button(label="📖 Règles", style=discord.ButtonStyle.secondary, row=2)
    async def regles_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        embed = build_menu_regles_embed(str(interaction.user.id))
        await interaction.response.edit_message(embed=embed, view=MenuBackView(interaction.user.id))


