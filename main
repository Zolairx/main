class MenuRecapView(MonRecapView):
    @discord.ui.button(label="🏠 Menu", style=discord.ButtonStyle.secondary, row=2)
    async def menu_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        embed = build_menu_home_embed(interaction.user)
        await interaction.response.edit_message(embed=embed, view=MainMenuView(interaction.user.id))


@bot.tree.command(
    name="mon_recap",
    description="Ton récapitulatif personnel : points, missions variété, jeu de la semaine, wanted…",
    guild=discord.Object(id=GUILD_ID)
)
async def mon_recap(interaction: discord.Interaction):
    await interaction.response.defer(ephemeral=True)
    embed = build_recap_focus_embed(interaction.user, "accueil")
    await interaction.followup.send(embed=embed, view=MonRecapView(interaction.user), ephemeral=True)

# -- Début ajout Flask Keep Alive --
app = Flask('')

@app.route('/')
def home():
    return "Bot is alive!"

def run():
    app.run(host='0.0.0.0', port=8080)

def keep_alive():
    t = threading.Thread(target=run)
    t.start()

# -- Fin ajout Flask Keep Alive --
token = os.environ.get("TOKEN")
keep_alive()
bot.run(token)
