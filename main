class EditCandidateSelectView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=300)

        candidates = get_shiny_candidates()

        if not candidates:
            return

        options = []
        for candidate in candidates:
            cand_id, pokemon_name, image_url, encounters, game, method = candidate
            label = f"{pokemon_name} ({game})"
            description = f"{method} - {encounters} rencontres"
            if len(description) > 100:
                description = description[:97] + "..."
            options.append(discord.SelectOption(
                label=label[:100],
                value=str(cand_id),
                description=description
            ))

        if len(options) > 25:
            options = options[:25]

        select = discord.ui.Select(
            placeholder="Sélectionnez un candidat à modifier",
            options=options,
            min_values=1,
            max_values=1
        )
        select.callback = self.select_callback
        self.add_item(select)

    async def select_callback(self, interaction: discord.Interaction):
        async def _handle_selection(**kwargs):
            candidate_id = int(interaction.data['values'][0])

            cursor.execute("SELECT pokemon_name, image_url, encounters, game, method FROM shiny_candidates WHERE id = ?", (candidate_id,))
            result = cursor.fetchone()

            if not result:
                await interaction.response.send_message("❌ Candidat introuvable.", ephemeral=True)
                return None

            pokemon_name, image_url, encounters, game, method = result

            embed = discord.Embed(
                title=f"✏️ Modifier : {pokemon_name}",
                description="Que souhaitez-vous faire ?",
                color=discord.Color.blue()
            )
            embed.add_field(name="Jeu", value=game, inline=True)
            embed.add_field(name="Méthode", value=method, inline=True)
            embed.add_field(name="Rencontres", value=str(encounters), inline=True)

            if image_url:
                embed.set_thumbnail(url=image_url)

            view = EditCandidateActionView(candidate_id, pokemon_name, image_url, encounters, game, method)
            await interaction.response.edit_message(embed=embed, view=view)
            return True

        await discord_retry_wrapper(_handle_selection, context="Edit Candidate Selection")

class EditCandidateActionView(discord.ui.View):
    def __init__(self, candidate_id, pokemon_name, image_url, encounters, game, method):
        super().__init__(timeout=300)
        self.candidate_id = candidate_id
        self.pokemon_name = pokemon_name
        self.image_url = image_url
        self.encounters = encounters
        self.game = game
        self.method = method

    @discord.ui.button(label="✏️ Modifier", style=discord.ButtonStyle.primary)
    async def edit_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        async def _show_modal(**kwargs):
            modal = EditCandidateModal(self.candidate_id, self.pokemon_name, self.image_url, self.encounters, self.game, self.method)
            await interaction.response.send_modal(modal)
            return True

        await discord_retry_wrapper(_show_modal, context="Edit Candidate Modal")

    @discord.ui.button(label="🗑️ Supprimer", style=discord.ButtonStyle.danger)
    async def delete_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        async def _delete_candidate(**kwargs):
            await interaction.response.defer(ephemeral=True)

            # Supprimer l'image associée
            image_deleted = delete_candidate_image(self.candidate_id)

            # Supprimer les votes liés à ce candidat
            cursor.execute("DELETE FROM shiny_votes WHERE candidate_id = ?", (self.candidate_id,))
            cursor.execute("DELETE FROM shiny_candidates WHERE id = ?", (self.candidate_id,))
            conn.commit()

            embed = discord.Embed(
                title="✅ Candidat supprimé",
                description=f"**{self.pokemon_name}** a été retiré de la liste des candidats.\nLes votes associés ont également été supprimés." + 
                           (f"\n📷 Image supprimée." if image_deleted else ""),
                color=discord.Color.green()
            )
            embed.set_footer(text="ShinyBot - Gestion des candidats")

            await interaction.followup.send(embed=embed, ephemeral=True)
            return True

        await discord_retry_wrapper(_delete_candidate, context="Delete Candidate")


class EditCandidateModal(discord.ui.Modal):
    def __init__(self, candidate_id, pokemon_name, image_url, encounters, game, method):
        super().__init__(title="Modifier le candidat")
        self.candidate_id = candidate_id

        self.pokemon_name = discord.ui.TextInput(
            label="Nom du Pokémon",
            placeholder="Ex: Pikachu",
            required=True,
            max_length=50,
            default=pokemon_name
        )
        self.add_item(self.pokemon_name)

        self.image_url = discord.ui.TextInput(
            label="URL de l'image",
            placeholder="https://...",
            required=False,
            max_length=500,
            default=image_url if image_url else ""
        )
        self.add_item(self.image_url)

        self.encounters = discord.ui.TextInput(
            label="Nombre de rencontres/resets",
            placeholder="Ex: 1234",
            required=True,
            max_length=10,
            default=str(encounters)
        )
        self.add_item(self.encounters)

        self.game = discord.ui.TextInput(
            label="Nom du jeu",
            placeholder="Ex: Pokémon Écarlate",
            required=True,
            max_length=100,
            default=game
        )
        self.add_item(self.game)

        self.method = discord.ui.TextInput(
            label="Méthode de chasse",
            placeholder="Ex: Full Odds",
            required=True,
            max_length=100,
            default=method
        )
        self.add_item(self.method)

    async def on_submit(self, interaction: discord.Interaction):
        async def _process_edit(**kwargs):
            await interaction.response.defer(ephemeral=True)

            try:
                encounters_count = int(self.encounters.value)
            except ValueError:
                encounters_count = 0

            final_image_url = self.image_url.value if self.image_url.value else None

            cursor.execute("""
                UPDATE shiny_candidates
                SET pokemon_name = ?, image_url = ?, encounters = ?, game = ?, method = ?
                WHERE id = ?
            """, (self.pokemon_name.value, final_image_url, encounters_count, self.game.value, self.method.value, self.candidate_id))
            conn.commit()

            embed = discord.Embed(
                title="✅ Candidat modifié",
                description=f"**{self.pokemon_name.value}** a été mis à jour avec succès !",
                color=discord.Color.green()
            )
            embed.add_field(name="Jeu", value=self.game.value, inline=True)
            embed.add_field(name="Méthode", value=self.method.value, inline=True)
            embed.add_field(name="Rencontres", value=str(encounters_count), inline=True)

            if final_image_url:
                embed.set_thumbnail(url=final_image_url)

            embed.set_footer(text="ShinyBot - Modification effectuée")

            await interaction.followup.send(embed=embed, ephemeral=True)
            return True

        await discord_retry_wrapper(_process_edit, context="Edit Candidate Modal Submit")


# ============================================================
# ================ RACES EN ÉQUIPE ==========================
# ============================================================

def create_team_race(pokemon_name, game, bonus_points, format_, team_size, created_by):
    cursor.execute("""
        INSERT INTO team_races (pokemon_name, game, bonus_points, format, team_size, status, created_by)
        VALUES (?, ?, ?, ?, ?, 'pending', ?)
    """, (pokemon_name, game, bonus_points, format_, team_size, created_by))
    conn.commit()
    return cursor.lastrowid

def add_team_race_member(race_id, user_id, team, accepted=0):
    cursor.execute("""
        INSERT OR IGNORE INTO team_race_members (race_id, user_id, team, accepted)
        VALUES (?, ?, ?, ?)
    """, (race_id, user_id, team, accepted))
    conn.commit()

def get_team_race(race_id):
    cursor.execute("SELECT * FROM team_races WHERE id = ?", (race_id,))
    row = cursor.fetchone()
    if not row:
        return None
    cols = ['id','pokemon_name','game','bonus_points','format','team_size','status',
            'score_team1','score_team2','winner_team','created_by','created_at','ended_at']
    return dict(zip(cols, row))

def get_team_race_members(race_id):
    cursor.execute("SELECT user_id, team, accepted FROM team_race_members WHERE race_id = ?", (race_id,))
    return cursor.fetchall()

def get_active_team_races():
    cursor.execute("""
        SELECT id, pokemon_name, game, bonus_points, format, team_size, score_team1, score_team2, created_by, created_at
        FROM team_races WHERE status IN ('pending','active') ORDER BY created_at DESC LIMIT 30
    """)
    return cursor.fetchall()

def get_active_team_race_for_user_pokemon(user_id, pokemon_name):
    """Cherche une race en équipe active où le joueur est dans une équipe et le pokemon correspond"""
    cursor.execute("""
        SELECT tr.id, tr.bonus_points, tr.format, tr.score_team1, tr.score_team2, trm.team
        FROM team_races tr
        JOIN team_race_members trm ON tr.id = trm.race_id
        WHERE tr.status = 'active'
        AND trm.user_id = ?
        AND LOWER(tr.pokemon_name) = LOWER(?)
        LIMIT 1
    """, (user_id, pokemon_name))
    row = cursor.fetchone()
    if not row:
        return None
    return {'id': row[0], 'bonus_points': row[1], 'format': row[2],
            'score_team1': row[3], 'score_team2': row[4], 'team': row[5]}

def record_team_race_point(race_id, scoring_team):
    """Ajoute un point à l'équipe et retourne (score1, score2, winner_team_or_None)"""
    race = get_team_race(race_id)
    if not race:
        return None
    s1 = race['score_team1']
    s2 = race['score_team2']
    if scoring_team == 1:
        s1 += 1
    else:
        s2 += 1

    fmt = race['format']
    target = {'BO1': 1, 'BO3': 2, 'BO5': 3}.get(fmt, 1)
    winner = None
    if s1 >= target:
        winner = 1
    elif s2 >= target:
        winner = 2

    if winner:
        cursor.execute("""
            UPDATE team_races SET score_team1=?, score_team2=?, winner_team=?, status='finished', ended_at=datetime('now')
            WHERE id=?
        """, (s1, s2, winner, race_id))
    else:
        cursor.execute("""
            UPDATE team_races SET score_team1=?, score_team2=? WHERE id=?
        """, (s1, s2, race_id))
    conn.commit()
    return s1, s2, winner

async def handle_team_race_point(user_id, pokemon_name, guild):
    """Appelé depuis add_shiny_full — vérifie si un point de race équipe doit être accordé.
       Retourne (bonus_points, message_text) ou (0, None)."""
    race_info = get_active_team_race_for_user_pokemon(user_id, pokemon_name)
    if not race_info:
        return 0, None

    race_id = race_info['id']
    scoring_team = race_info['team']
    bonus = race_info['bonus_points']

    result = record_team_race_point(race_id, scoring_team)
    if not result:
        return 0, None

    s1, s2, winner_team = result
    fmt = race_info['format']

    # Récupérer membres
    members = get_team_race_members(race_id)
    team1_ids = [m[0] for m in members if m[1] == 1]
    team2_ids = [m[0] for m in members if m[1] == 2]

    # Noms pour l'annonce
    def display(uid):
        if guild:
            m = guild.get_member(int(uid))
            return m.display_name if m else uid
        return uid

    t1_names = ", ".join(display(u) for u in team1_ids)
    t2_names = ", ".join(display(u) for u in team2_ids)

    if winner_team:
        # Appliquer bonus aux gagnants, retirer aux perdants
        winning_ids = team1_ids if winner_team == 1 else team2_ids
        losing_ids = team2_ids if winner_team == 1 else team1_ids

        for wid in winning_ids:
            award_capped_bonus(wid, f'[Bonus Race Équipe #{race_id}]', 'race_team_bonus', bonus)

        for lid in losing_ids:
            cursor.execute("SELECT SUM(points) FROM shiny WHERE user_id = ?", (lid,))
            current = cursor.fetchone()[0] or 0
            deduction = min(bonus, current)
            if deduction > 0:
                cursor.execute("""
                    INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                    VALUES (?, ?, ?, ?, date('now'), ?, datetime('now'), 'fr')
                """, (lid, f'[Malus Race Équipe #{race_id}]', '', 'race_team_malus', -deduction))
        conn.commit()

        winner_names = t1_names if winner_team == 1 else t2_names
        loser_names = t2_names if winner_team == 1 else t1_names
        msg = (f"🏆 **Race Équipe #{race_id} terminée !** Score final : Équipe 1 ({t1_names}) **{s1}** — **{s2}** Équipe 2 ({t2_names})\n"
               f"🥇 Victoire de : **{winner_names}** (+{bonus} pts chacun)\n"
               f"💔 Défaite de : **{loser_names}** (-{bonus} pts chacun, min 0)")
    else:
        target_label = {'BO1':'1','BO3':'2','BO5':'3'}.get(fmt,'?')
        msg = (f"⚡ **Race Équipe #{race_id}** — Point marqué par l'Équipe {scoring_team} !\n"
               f"Score : Équipe 1 ({t1_names}) **{s1}** — **{s2}** Équipe 2 ({t2_names}) | Premier à {target_label} remporte la race.")

    return bonus if winner_team else 0, msg

# ---- Vue d'acceptation race équipe ----

pending_team_races = {}

class TeamRaceAcceptView(discord.ui.View):
    def __init__(self, race_id, creator, race_info, guild_channel_id):
        super().__init__(timeout=300)
        self.race_id = race_id
        self.creator = creator
        self.race_info = race_info
        self.guild_channel_id = guild_channel_id

    async def on_timeout(self):
        pending_team_races.pop(self.race_id, None)

    @discord.ui.button(label="✅ Accepter la race", style=discord.ButtonStyle.success)
    async def accept(self, interaction: discord.Interaction, button: discord.ui.Button):
        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(view=self)

        # Activer la race
        cursor.execute("UPDATE team_races SET status='active' WHERE id=?", (self.race_id,))
        # Marquer tous les membres comme acceptés
        cursor.execute("UPDATE team_race_members SET accepted=1 WHERE race_id=?", (self.race_id,))
        conn.commit()
        pending_team_races.pop(self.race_id, None)

        await interaction.followup.send(
            f"✅ Race acceptée ! La Race Équipe **#{self.race_id}** est maintenant active.\n"
            f"🎯 Pokémon : **{self.race_info['pokemon_name']}** | Format : **{self.race_info['format']}** | Bonus : **+{self.race_info['bonus_points']} pts**"
        )

        # Notifier dans le salon
        try:
            channel = bot.get_channel(self.guild_channel_id)
            if channel:
                members = get_team_race_members(self.race_id)
                guild = bot.get_guild(GUILD_ID)
                def mention(uid):
                    m = guild.get_member(int(uid)) if guild else None
                    return m.mention if m else f"<@{uid}>"
                t1 = " & ".join(mention(m[0]) for m in members if m[1] == 1)
                t2 = " & ".join(mention(m[0]) for m in members if m[1] == 2)
                embed = discord.Embed(
                    title="⚔️ Race en Équipe Lancée !",
                    description=f"Que la chasse commence !",
                    color=discord.Color.orange()
                )
                embed.add_field(name="🎯 Pokémon", value=f"**{self.race_info['pokemon_name']}**", inline=True)
                embed.add_field(name="🎮 Jeu", value=self.race_info['game'] or "Libre", inline=True)
                embed.add_field(name="📋 Format", value=self.race_info['format'], inline=True)
                embed.add_field(name="💰 Bonus/Malus", value=f"+{self.race_info['bonus_points']} pts (gagnants) / -{self.race_info['bonus_points']} pts (perdants)", inline=False)
                embed.add_field(name="🔵 Équipe 1", value=t1, inline=True)
                embed.add_field(name="🔴 Équipe 2", value=t2, inline=True)
                embed.set_footer(text=f"Race #{self.race_id} • Premier à trouver le Pokémon avec /shiny_ajout marque un point !")
                await channel.send(embed=embed)
        except Exception as e:
            logger.error(f"Erreur annonce race équipe: {e}")

        # Notifier le créateur
        try:
            await self.creator.send(f"✅ Votre défi de race équipe #{self.race_id} a été **accepté** ! La chasse est lancée.")
        except Exception:
            pass

    @discord.ui.button(label="❌ Refuser", style=discord.ButtonStyle.danger)
    async def refuse(self, interaction: discord.Interaction, button: discord.ui.Button):
        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(view=self)

        cursor.execute("UPDATE team_races SET status='cancelled', ended_at=datetime('now') WHERE id=?", (self.race_id,))
        conn.commit()
        pending_team_races.pop(self.race_id, None)

        await interaction.followup.send(f"❌ Vous avez refusé la race équipe #{self.race_id}.")
        try:
            await self.creator.send(f"😔 Votre défi de race équipe #{self.race_id} a été **refusé**.")
        except Exception:
            pass


def resolve_members_from_text(guild, text):
    """Résout une liste de membres depuis un texte contenant pseudos ou mentions.
    Retourne (membres_trouvés, noms_introuvables)."""
    if not text or not text.strip():
        return [], []
    # Séparer par virgule ou point-virgule
    parts = [p.strip() for p in text.replace(';', ',').split(',') if p.strip()]
    found = []
    not_found = []
    for part in parts:
        member = None
        # Mention <@123456> ou <@!123456>
        if part.startswith('<@') and part.endswith('>'):
            uid_str = part.strip('<@!>').strip()
            try:
                member = guild.get_member(int(uid_str))
            except ValueError:
                pass
        # ID numérique pur
        elif part.isdigit():
            member = guild.get_member(int(part))
        # Pseudo (display_name ou username, insensible à la casse)
        else:
            part_lower = part.lower()
            for m in guild.members:
                if m.display_name.lower() == part_lower or m.name.lower() == part_lower:
                    member = m
                    break
        if member and not member.bot:
            if member not in found:
                found.append(member)
        else:
            not_found.append(part)
    return found, not_found


class TeamRaceCreateModal(discord.ui.Modal):
    def __init__(self, guild_channel_id):
        super().__init__(title="Créer une Race en Équipe")
        self.guild_channel_id = guild_channel_id

        self.pokemon_input = discord.ui.TextInput(
            label="Pokémon cible",
            placeholder="Ex: Dracaufeu",
            required=True, max_length=50
        )
        self.bonus_input = discord.ui.TextInput(
            label="Points bonus/malus + Format (BO1/BO3/BO5)",
            placeholder="Ex: 10 BO3   ou juste 10 pour BO1",
            required=True, max_length=10
        )
        self.team1_input = discord.ui.TextInput(
            label="Équipe 1 — vos coéquipiers (pseudos, virgule)",
            placeholder="Ex: Sacha, Ondine  (vous êtes automatiquement inclus)",
            required=False, max_length=200
        )
        self.team2_input = discord.ui.TextInput(
            label="Équipe 2 — adversaires (pseudos, virgule)",
            placeholder="Ex: Pierre, Régis",
            required=True, max_length=200
        )
        self.add_item(self.pokemon_input)
        self.add_item(self.bonus_input)
        self.add_item(self.team1_input)
        self.add_item(self.team2_input)

    async def on_submit(self, interaction: discord.Interaction):
        # Parser bonus + format depuis le même champ "10 BO3"
        bonus_fmt_raw = self.bonus_input.value.strip().upper()
        fmt = 'BO1'
        bonus_str = bonus_fmt_raw
        for f in ('BO5', 'BO3', 'BO1'):
            if f in bonus_fmt_raw:
                fmt = f
                bonus_str = bonus_fmt_raw.replace(f, '').strip()
                break
        try:
            bonus = float(bonus_str.replace(',', '.'))
            if bonus <= 0:
                raise ValueError
        except ValueError:
            await interaction.response.send_message(
                "❌ Points bonus invalides. Ex: `10 BO3` ou juste `10` pour BO1.", ephemeral=True
            )
            return

        guild = interaction.guild
        creator = interaction.user
        creator_id = str(creator.id)

        # Résoudre équipe 1
        team1_extra_members, t1_not_found = resolve_members_from_text(guild, self.team1_input.value)
        # Résoudre équipe 2
        team2_members, t2_not_found = resolve_members_from_text(guild, self.team2_input.value)

        errors = []
        if t1_not_found:
            errors.append(f"Équipe 1 introuvable : {', '.join(t1_not_found)}")
        if t2_not_found:
            errors.append(f"Équipe 2 introuvable : {', '.join(t2_not_found)}")
        if not team2_members:
            await interaction.response.send_message(
                "❌ Aucun membre valide trouvé pour l'équipe adverse.\nVérifiez les pseudos (séparés par des virgules).",
                ephemeral=True
            )
            return

        if any(m.id == creator.id for m in team2_members):
            await interaction.response.send_message("❌ Vous ne pouvez pas être dans l'équipe adverse.", ephemeral=True)
            return

        t1_ids = set([creator_id] + [str(m.id) for m in team1_extra_members])
        t2_ids = set(str(m.id) for m in team2_members)
        overlap = t1_ids & t2_ids
        if overlap:
            names = [guild.get_member(int(uid)).display_name for uid in overlap if guild.get_member(int(uid))]
            await interaction.response.send_message(
                f"❌ Ces joueurs sont dans les deux équipes : {', '.join(names)}", ephemeral=True
            )
            return

        t1_size = 1 + len(team1_extra_members)
        t2_size = len(team2_members)
        if t1_size != t2_size:
            await interaction.response.send_message(
                f"❌ Les équipes doivent avoir le même nombre de joueurs.\nÉquipe 1 : {t1_size} joueur(s) | Équipe 2 : {t2_size} joueur(s)",
                ephemeral=True
            )
            return

        pokemon_val = self.pokemon_input.value.strip()

        # Afficher le select de jeu avant de finaliser
        view = TeamRaceGameSelectView(
            pokemon_val, bonus, fmt, t1_size, creator,
            team1_extra_members, team2_members, errors, self.guild_channel_id
        )
        embed = discord.Embed(
            title="🎮 Choisir le jeu",
            description=(
                f"🎯 Pokémon : **{pokemon_val}** | Format : **{fmt}** | Bonus : **±{bonus} pts**\n\n"
                "Sélectionnez le jeu de la race, ou cliquez sur **Pas de restriction** pour laisser libre."
            ),
            color=discord.Color.orange()
        )
        await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


class TeamRaceGameSelectView(discord.ui.View):
    """Sélection du jeu après le modal de race équipe"""
    def __init__(self, pokemon_val, bonus, fmt, t1_size, creator,
                 team1_extra_members, team2_members, errors, guild_channel_id):
        super().__init__(timeout=300)
        self.pokemon_val = pokemon_val
        self.bonus = bonus
        self.fmt = fmt
        self.t1_size = t1_size
        self.creator = creator
        self.team1_extra_members = team1_extra_members
        self.team2_members = team2_members
        self.errors = errors
        self.guild_channel_id = guild_channel_id

        # Bouton "Pas de restriction"
        btn_free = discord.ui.Button(
            label="🌍 Pas de restriction de jeu",
            style=discord.ButtonStyle.secondary
        )
        btn_free.callback = self._make_game_callback(None)
        self.add_item(btn_free)

        # Select(s) de jeux — même liste que /shiny_ajout
        all_options = [
            discord.SelectOption(label=v['fr'][:100], value=v['fr'][:100])
            for v in GAMES.values()
        ]
        if len(all_options) <= 25:
            sel = discord.ui.Select(
                placeholder="🎮 Choisir un jeu",
                options=all_options,
                min_values=1, max_values=1
            )
            sel.callback = self.game_selected
            self.add_item(sel)
        else:
            sel1 = discord.ui.Select(
                placeholder="🎮 Jeux (1/2)",
                options=all_options[:25],
                min_values=1, max_values=1
            )
            sel1.callback = self.game_selected
            self.add_item(sel1)
            sel2 = discord.ui.Select(
                placeholder="🎮 Jeux (2/2)",
                options=all_options[25:50],
                min_values=1, max_values=1
            )
            sel2.callback = self.game_selected
            self.add_item(sel2)

    def _make_game_callback(self, game_value):
        async def callback(interaction: discord.Interaction):
            await self._finalize(interaction, game_value)
        return callback

    async def game_selected(self, interaction: discord.Interaction):
        game_value = interaction.data['values'][0]
        await self._finalize(interaction, game_value)

    async def _finalize(self, interaction: discord.Interaction, game_val):
        """Crée la race en base et envoie le DM après sélection du jeu"""
        guild = interaction.guild
        creator = self.creator
        creator_id = str(creator.id)

        race_id = create_team_race(self.pokemon_val, game_val, self.bonus, self.fmt, self.t1_size, creator_id)
        add_team_race_member(race_id, creator_id, 1, accepted=1)
        for m in self.team1_extra_members:
            add_team_race_member(race_id, str(m.id), 1, accepted=1)
        for m in self.team2_members:
            add_team_race_member(race_id, str(m.id), 2, accepted=0)

        pending_team_races[race_id] = True

        t1_names = creator.display_name
        for m in self.team1_extra_members:
            t1_names += f" & {m.display_name}"
        t2_names = " & ".join(m.display_name for m in self.team2_members)
        captain2 = self.team2_members[0]

        race_info = {
            'pokemon_name': self.pokemon_val,
            'game': game_val,
            'bonus_points': self.bonus,
            'format': self.fmt
        }

        dm_embed = discord.Embed(
            title="⚔️ Défi de Race en Équipe !",
            description=f"**{creator.display_name}** défie votre équipe sur **{guild.name}** !",
            color=discord.Color.orange()
        )
        dm_embed.add_field(name="🎯 Pokémon", value=f"**{self.pokemon_val}**", inline=True)
        dm_embed.add_field(name="🎮 Jeu", value=game_val or "Libre", inline=True)
        dm_embed.add_field(name="📋 Format", value=self.fmt, inline=True)
        dm_embed.add_field(
            name="💰 Bonus/Malus",
            value=f"+{self.bonus} pts (gagnants) / -{self.bonus} pts (perdants, min 0)",
            inline=False
        )
        dm_embed.add_field(name="🔵 Équipe 1", value=t1_names, inline=True)
        dm_embed.add_field(name="🔴 Équipe 2 (vous)", value=t2_names, inline=True)
        dm_embed.set_footer(text="Vous avez 5 minutes pour accepter ou refuser.")

        view = TeamRaceAcceptView(race_id, creator, race_info, self.guild_channel_id)

        try:
            await captain2.send(embed=dm_embed, view=view)
        except discord.Forbidden:
            cursor.execute("UPDATE team_races SET status='cancelled' WHERE id=?", (race_id,))
            conn.commit()
            pending_team_races.pop(race_id, None)
            await interaction.response.edit_message(
                content=f"❌ Impossible d'envoyer un DM à **{captain2.display_name}**. Race annulée.\nDemandez-lui d'ouvrir ses messages privés sur ce serveur.",
                embed=None, view=None
            )
            return
        except Exception as e:
            logger.error(f"Erreur DM race équipe: {e}")
            await interaction.response.edit_message(
                content="❌ Erreur lors de l'envoi du DM.", embed=None, view=None
            )
            return

        confirm_lines = [
            f"✅ Défi envoyé à **{captain2.display_name}** par DM ! Race **#{race_id}** en attente.",
            f"🔵 Équipe 1 : **{t1_names}**",
            f"🔴 Équipe 2 : **{t2_names}**",
            f"🎯 **{self.pokemon_val}** | 🎮 {game_val or 'Libre'} | {self.fmt} | ±{self.bonus} pts",
        ]
        if self.errors:
            confirm_lines.append("⚠️ " + " | ".join(self.errors))

        await interaction.response.edit_message(
            content="\n".join(confirm_lines), embed=None, view=None
        )


@bot.tree.command(
    name="race_equipe_create",
    description="Créer une race shiny en équipe (saisie des pseudos)",
    guild=discord.Object(id=GUILD_ID)
)
async def race_equipe_create(interaction: discord.Interaction):
    modal = TeamRaceCreateModal(interaction.channel_id)
    await interaction.response.send_modal(modal)


@bot.tree.command(
    name="race_equipe_list",
    description="Voir les races en équipe actives",
    guild=discord.Object(id=GUILD_ID)
)
async def race_equipe_list(interaction: discord.Interaction):
    await interaction.response.defer(ephemeral=True)
    races = get_active_team_races()
    if not races:
        await interaction.followup.send("Aucune race en équipe active pour le moment.", ephemeral=True)
        return

    guild = interaction.guild
    embed = discord.Embed(title="⚔️ Races en Équipe Actives", color=discord.Color.orange())

    for r in races[:10]:
        rid, pokemon, game, bonus, fmt, tsize, s1, s2, creator_id, created_at = r
        members = get_team_race_members(rid)
        def name(uid):
            m = guild.get_member(int(uid)) if guild else None
            return m.display_name if m else uid
        t1 = " & ".join(name(m[0]) for m in members if m[1] == 1)
        t2 = " & ".join(name(m[0]) for m in members if m[1] == 2)
        status_row = get_team_race(rid)
        status_label = "⏳ En attente" if status_row['status'] == 'pending' else "🏁 Active"
        embed.add_field(
            name=f"Race #{rid} — {pokemon} ({fmt}) {status_label}",
            value=f"🔵 Équipe 1 : {t1 or '?'} **[{s1}]**\n🔴 Équipe 2 : {t2 or '?'} **[{s2}]**\n💰 Bonus/Malus : {bonus} pts | 🎮 {game or 'Libre'}",
            inline=False
        )
    embed.set_footer(text="Utilisez /race_equipe_cancel pour annuler une race (admin ou créateur)")
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="race_equipe_score",
    description="Voir le score en direct d'une race en équipe",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(race_id="ID de la race (visible avec /race_equipe_list)")
async def race_equipe_score(interaction: discord.Interaction, race_id: int):
    await interaction.response.defer(ephemeral=True)
    race = get_team_race(race_id)
    if not race:
        await interaction.followup.send("❌ Race introuvable.", ephemeral=True)
        return
    guild = interaction.guild
    members = get_team_race_members(race_id)
    def name(uid):
        m = guild.get_member(int(uid)) if guild else None
        return m.display_name if m else uid
    t1 = " & ".join(name(m[0]) for m in members if m[1] == 1)
    t2 = " & ".join(name(m[0]) for m in members if m[1] == 2)
    fmt = race['format']
    target = {'BO1':1,'BO3':2,'BO5':3}.get(fmt,1)
    embed = discord.Embed(
        title=f"📊 Score Race Équipe #{race_id}",
        description=f"🎯 **{race['pokemon_name']}** | Format : **{fmt}** | Premier à **{target}** point(s)",
        color=discord.Color.blue()
    )
    embed.add_field(name=f"🔵 Équipe 1 : {t1}", value=f"**{race['score_team1']}** point(s)", inline=True)
    embed.add_field(name=f"🔴 Équipe 2 : {t2}", value=f"**{race['score_team2']}** point(s)", inline=True)
    status_map = {'pending':'⏳ En attente','active':'🏁 En cours','finished':'✅ Terminée','cancelled':'❌ Annulée'}
    embed.add_field(name="Statut", value=status_map.get(race['status'], race['status']), inline=False)
    if race['winner_team']:
        winner_names = " & ".join(name(m[0]) for m in members if m[1] == race['winner_team'])
        embed.add_field(name="🏆 Vainqueur", value=winner_names, inline=False)
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="race_equipe_cancel",
    description="Annuler une race en équipe (créateur ou admin)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(race_id="ID de la race à annuler")
async def race_equipe_cancel(interaction: discord.Interaction, race_id: int):
    await interaction.response.defer(ephemeral=True)
    race = get_team_race(race_id)
    if not race:
        await interaction.followup.send("❌ Race introuvable.", ephemeral=True)
        return
    is_admin = interaction.user.guild_permissions.administrator
    is_creator = race['created_by'] == str(interaction.user.id)
    if not is_admin and not is_creator:
        await interaction.followup.send("❌ Seul le créateur ou un admin peut annuler cette race.", ephemeral=True)
        return
    if race['status'] not in ('pending', 'active'):
        await interaction.followup.send("⚠️ Cette race n'est pas active.", ephemeral=True)
        return
    cursor.execute("UPDATE team_races SET status='cancelled', ended_at=datetime('now') WHERE id=?", (race_id,))
    conn.commit()
    pending_team_races.pop(race_id, None)
    await interaction.followup.send(f"✅ Race équipe #{race_id} annulée.", ephemeral=True)


