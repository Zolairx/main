    @discord.ui.button(label="📌 Objectifs", style=discord.ButtonStyle.secondary, row=1)
    async def objectifs_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.edit_message(embed=build_recap_focus_embed(self.member, "objectifs"), view=self)

    @discord.ui.button(label="🎯 Wanteds", style=discord.ButtonStyle.secondary, row=1)
