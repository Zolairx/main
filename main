def create_collab_bounty(pokemon_name, goal, bonus_points, game=None, description=None, created_by=None):
    cursor.execute("""
        INSERT INTO collab_bounties (pokemon_name, goal, bonus_points, game, description, created_by)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (pokemon_name, goal, bonus_points, game, description, created_by))
    conn.commit()
    return cursor.lastrowid

def get_active_collab_bounties():
    cursor.execute("""
        SELECT id, pokemon_name, goal, bonus_points, game, description, created_at
        FROM collab_bounties WHERE status='active'
        ORDER BY created_at DESC
    """)
    rows = cursor.fetchall()
    return [{'id':r[0],'pokemon_name':r[1],'goal':r[2],'bonus_points':r[3],
             'game':r[4],'description':r[5],'created_at':r[6]} for r in rows]

def get_bounty_progress(bounty_id):
    cursor.execute("SELECT COUNT(*) FROM collab_bounty_participants WHERE bounty_id=?", (bounty_id,))
    return cursor.fetchone()[0] or 0

def join_collab_bounty(bounty_id, user_id):
    """Enregistre qu'un joueur a trouvé le pokémon du bounty. Retourne True si nouveau participant."""
    try:
        cursor.execute("""
            INSERT OR IGNORE INTO collab_bounty_participants (bounty_id, user_id)
            VALUES (?, ?)
        """, (bounty_id, str(user_id)))
        conn.commit()
        return cursor.rowcount > 0
    except Exception:
        return False

def complete_collab_bounty(bounty_id):
    """Marque le bounty comme complété et retourne la liste des participants."""
    cursor.execute("SELECT user_id FROM collab_bounty_participants WHERE bounty_id=?", (bounty_id,))
    participants = [r[0] for r in cursor.fetchall()]
    cursor.execute("""
        UPDATE collab_bounties SET status='completed', ended_at=datetime('now')
        WHERE id=?
    """, (bounty_id,))
    conn.commit()
    return participants


def parse_wanted_end_date(date_str):
    """Parse une date de fin au format JJ/MM/AAAA HH:MM saisie par un admin.
    Retourne (datetime, None) si valide et dans le futur, ou (None, message_erreur) sinon.
    Retourne (None, None) si date_str est vide/None (pas de date de fin demandée)."""
    if not date_str or not date_str.strip():
        return None, None
    try:
        dt = datetime.strptime(date_str.strip(), "%d/%m/%Y %H:%M")
    except ValueError:
        return None, "❌ Format de date de fin invalide. Utilisez **JJ/MM/AAAA HH:MM** — ex: `25/12/2025 20:00`"
    if dt <= datetime.now():
        return None, "❌ La date de fin doit être dans le futur !"
    return dt, None


def get_active_wanteds():
    """Récupère tous les Pokémon wanted actifs (désactive au passage ceux dont
    la date de fin programmée est dépassée)."""
    cursor.execute("""
        SELECT id, expires_at FROM shiny_wanted
        WHERE is_active = 1 AND expires_at IS NOT NULL
    """)
    now = datetime.now()
    expired_ids = []
    for wid, expires_at in cursor.fetchall():
        try:
            if datetime.strptime(expires_at, "%Y-%m-%d %H:%M") <= now:
                expired_ids.append(wid)
        except Exception:
            continue
    if expired_ids:
        cursor.executemany("UPDATE shiny_wanted SET is_active = 0 WHERE id = ?", [(i,) for i in expired_ids])
        conn.commit()

    cursor.execute("""
        SELECT id, pokemon_name, bonus_points, decay_percent, game, paliers_json, indice, pokemon_alternates, expires_at
        FROM shiny_wanted
        WHERE is_active = 1
        ORDER BY updated_at DESC
    """)
    rows = cursor.fetchall()
    wanteds = []
    for row in rows:
        wanteds.append({
            'id': row[0],
            'pokemon_name': row[1],
            'bonus_points': row[2],
            'decay_percent': row[3] if row[3] is not None else 100.0,
            'game': row[4],
            'paliers_json': row[5],
            'indice': row[6],
            'pokemon_alternates': row[7],
            'expires_at': row[8]
        })
    return wanteds


def get_active_mystery_wanteds():
    """Parmi les wanteds actifs, ceux qui sont de vrais wanteds mystère (indice
    renseigné, pas juste une méthode imposée stockée dans ce même champ)."""
    return [
        w for w in get_active_wanteds()
        if w['indice'] and not w['indice'].strip().startswith("[Méthode :")
    ]


MYSTERY_WANTED_MAX_REVEALS = 2  # Nombre max de lettres révélables par joueur et par wanted mystère

def process_mystery_wanted_hunt(user_id):
    """Appelé quand un joueur signale qu'un shiny vient d'être chassé pour un
    wanted mystère. Incrémente sa progression pour chaque wanted mystère actif,
    et révèle une lettre supplémentaire (position aléatoire jamais révélée
    auparavant pour ce joueur) tous les 5 shinys, jusqu'à MYSTERY_WANTED_MAX_REVEALS
    lettres maximum. Retourne une liste de (wanted_id, texte_masqué, compteur)
    pour les paliers atteints ce coup-ci."""
    reveals = []
    for w in get_active_mystery_wanteds():
        wid = w['id']
        name = w['pokemon_name']
        cursor.execute(
            "SELECT count, revealed_positions FROM mystery_wanted_progress WHERE wanted_id=? AND user_id=?",
            (wid, str(user_id))
        )
        row = cursor.fetchone()
        if row:
            count, positions = row[0], (json.loads(row[1]) if row[1] else [])
        else:
            count, positions = 0, []
        count += 1

        masked = None
        if count % 5 == 0 and len(positions) < MYSTERY_WANTED_MAX_REVEALS:
            eligible = [i for i, c in enumerate(name) if c.isalpha() and i not in positions]
            if eligible:
                positions.append(random.choice(eligible))
            masked = "".join(
                (name[i] if (not name[i].isalpha() or i in positions) else "_")
                for i in range(len(name))
            )

        cursor.execute("""
            INSERT INTO mystery_wanted_progress (wanted_id, user_id, count, revealed_positions)
            VALUES (?, ?, ?, ?)
            ON CONFLICT(wanted_id, user_id) DO UPDATE SET count=excluded.count, revealed_positions=excluded.revealed_positions
        """, (wid, str(user_id), count, json.dumps(positions)))
        conn.commit()

        if masked:
            reveals.append((wid, masked, count))
    return reveals

def analyze_wanted_tiers(paliers_json, bonus_points):
    """Analyse le paliers_json d'un wanted pour savoir s'il est 'unique'
    (seul le 1er gagne des points) ou à 'paliers' (points différents par rang)."""
    p1, p2, p3, suite = bonus_points, 0, 0, 0
    if paliers_json:
        try:
            data = json.loads(paliers_json)
            p1 = data.get('p1', bonus_points)
            p2 = data.get('p2', 0)
            p3 = data.get('p3', 0)
            suite = data.get('suite', 0)
        except Exception:
            pass
    is_unique = (p2 == 0 and p3 == 0 and suite == 0)
    is_tiered = not is_unique and not (p1 == p2 == p3 == suite)
    return {'is_unique': is_unique, 'is_tiered': is_tiered, 'p1': p1, 'p2': p2, 'p3': p3, 'suite': suite}


def build_wanted_alert_embed(pokemon_name, bonus_points, game, indice, paliers_json, expires_at=None, wanted_id=None, alternates_json=None):
    """Construit l'embed d'alerte public d'un wanted (utilisé par set_wanted,
    launch_scheduled_wanted et admin_wanted_alerte) avec détection automatique
    du type : unique (rouge), paliers différents (bleu), ou mystère (vert)."""
    is_mystery = bool(indice) and not indice.strip().startswith("[Méthode :")
    tiers = analyze_wanted_tiers(paliers_json, bonus_points)

    displayed_fr = "???" if is_mystery else pokemon_name
    displayed_en = "???" if is_mystery else pokemon_name
    game_txt_fr = f" sur **{game}**" if game else ""
    game_txt_en = f" on **{game}**" if game else ""

    if expires_at:
        try:
            end_ts = int(datetime.strptime(expires_at, "%Y-%m-%d %H:%M").timestamp())
        except Exception:
            end_ts = int((datetime.now() + timedelta(days=7)).timestamp())
    else:
        end_ts = int((datetime.now() + timedelta(days=7)).timestamp())

    # Titre et couleur selon le type (priorité : unique > paliers > mystère > standard)
    if tiers['is_unique']:
        title = "🔒 Wanted Unique !  ·  Unique Wanted!"
        color = discord.Color.red()
    elif tiers['is_tiered']:
        title = "📊 Wanted à Paliers !  ·  Tiered Wanted!"
        color = discord.Color.blue()
    elif is_mystery:
        title = "🔍 Wanted Mystère !  ·  Mystery Wanted!"
        color = discord.Color.from_rgb(0, 200, 80)
    else:
        title = "🎯 Nouveau Pokémon Wanted !  ·  New Wanted Pokémon!"
        color = discord.Color.red()

    desc = (
        f"**{displayed_fr}** est maintenant recherché{game_txt_fr} !\n"
        f"**{displayed_en}** is now wanted{game_txt_en}!\n\n"
    )

    if tiers['is_unique']:
        desc += (
            f"🔒 **Wanted unique** : seul le premier trouveur remporte le bonus — personne d'autre ne gagne de points !\n"
            f"🔒 **Unique wanted**: only the first finder gets the bonus — no one else earns points!\n"
            f"⭐ Bonus : **+{tiers['p1']} pts**\n\n"
        )
    elif tiers['is_tiered']:
        desc += (
            f"📊 **Points dégressifs selon l'ordre d'arrivée / Points decrease by finding order :**\n"
            f"🥇 +{tiers['p1']} pts · 🥈 +{tiers['p2']} pts · 🥉 +{tiers['p3']} pts · Ensuite/Then +{tiers['suite']} pts\n\n"
        )
    else:
        desc += f"⭐ Bonus : **+{bonus_points} pts** pour le premier trouveur / for the first finder\n\n"

    desc += f"⏰ Se termine / Ends : <t:{end_ts}:F> (<t:{end_ts}:R>)\n\n"

    if indice and not is_mystery:
        # Ce n'est pas un vrai indice mystère, juste une méthode imposée stockée dans le champ indice
        desc += f"🎯 Méthode imposée / Required method : {indice.replace('[Méthode : ', '').rstrip(']')}\n\n"
    elif is_mystery:
        desc += (
            f"🔍 **Wanted mystère** — le nom est caché, un indice est fourni ci-dessous !\n"
            f"🔍 **Mystery wanted** — the name is hidden, a hint is provided below!\n"
            f"🔍 **Indice / Hint :** {indice}\n\n"
        )

    if alternates_json:
        try:
            alt_list = json.loads(alternates_json)
            if alt_list:
                alt_display = [("???" if is_mystery else a) for a in alt_list]
                desc += f"🔄 Aussi accepté / Also accepted : {', '.join(alt_display)}\n\n"
        except Exception:
            pass

    desc += (
        f"🇫🇷 Utilisez `/shiny_ajout` pour réclamer votre bonus !\n"
        f"🇬🇧 Use `/add_myshiny` to claim your bonus!"
    )

    embed = discord.Embed(title=title, description=desc, color=color, timestamp=datetime.now())
    footer = "ShinyBot · Wanted Alert" if not wanted_id else f"ShinyBot · Wanted Alert #{wanted_id}"
    embed.set_footer(text=footer)
    return embed


def set_wanted(pokemon_name, bonus_points, decay_percent=100.0, game: str | None = None):
    """Définit un nouveau Pokémon wanted (sans désactiver les précédents, permet plusieurs wanted actifs)"""
    cursor.execute("""
        INSERT INTO shiny_wanted (pokemon_name, bonus_points, decay_percent, game, is_active, updated_at)
        VALUES (?, ?, ?, ?, 1, datetime('now'))
    """, (pokemon_name, bonus_points, decay_percent, game))
    conn.commit()
    wanted_id = cursor.lastrowid

    # Alerte dans le salon dédié
    # Alerte dans le salon dédié
    async def _send_wanted_alert(wid=wanted_id, pname=pokemon_name, bpts=bonus_points, gme=game):
        try:
            channel = bot.get_channel(SALON_WANTED_ALERT_ID)
            if not channel:
                logger.error(f"Salon wanted alert introuvable (ID: {SALON_WANTED_ALERT_ID})")
                return
            # Récupérer l'indice, les paliers et la date de fin (ajoutés après set_wanted)
            cursor.execute("SELECT indice, paliers_json, expires_at FROM shiny_wanted WHERE id=?", (wid,))
            row = cursor.fetchone()
            indice, paliers_json, expires_at = row if row else (None, None, None)
            embed = build_wanted_alert_embed(pname, bpts, gme, indice, paliers_json, expires_at, wanted_id=wid)
            await channel.send(embed=embed)
            logger.info(f"Alerte wanted envoyée pour {pname} (#{wid})")
        except Exception as e:
            logger.error(f"Erreur alerte wanted: {e}")


    try:
        loop = asyncio.get_event_loop()
        if loop.is_running():
            asyncio.create_task(_send_wanted_alert())
    except Exception as e:
        logger.error(f"Erreur création task alerte wanted: {e}")


    return wanted_id

def has_claimed_wanted(user_id, wanted_id):
    """Vérifie si l'utilisateur a déjà réclamé le bonus pour ce wanted"""
    cursor.execute("""
        SELECT COUNT(*) FROM shiny_wanted_claimed 
        WHERE user_id = ? AND wanted_id = ?
    """, (user_id, wanted_id))
    result = cursor.fetchone()
    return result[0] > 0 if result else False

def claim_wanted_bonus(user_id, wanted_id, pokemon_name, bonus_points):
    """Enregistre que l'utilisateur a réclamé le bonus wanted"""
    cursor.execute("""
        INSERT INTO shiny_wanted_claimed (user_id, wanted_id, pokemon_name, bonus_points)
        VALUES (?, ?, ?, ?)
    """, (user_id, wanted_id, pokemon_name, bonus_points))
    conn.commit()

def create_shiny_race(challenger_id, opponent_id, pokemon_name, game, bonus_points):
    """Crée une nouvelle race shiny entre deux joueurs"""
    cursor.execute("""
        INSERT INTO shiny_races (challenger_id, opponent_id, pokemon_name, game, bonus_points, status)
        VALUES (?, ?, ?, ?, ?, 'active')
    """, (challenger_id, opponent_id, pokemon_name, game, bonus_points))
    conn.commit()
    return cursor.lastrowid

def get_active_race_for_user_and_pokemon(user_id, pokemon_name):
    """Récupère une race active pour un utilisateur et un Pokémon donné"""
    cursor.execute("""
        SELECT id, challenger_id, opponent_id, game, bonus_points
        FROM shiny_races
        WHERE status = 'active'
        AND (challenger_id = ? OR opponent_id = ?)
        AND LOWER(pokemon_name) = LOWER(?)
        ORDER BY created_at ASC
        LIMIT 1
    """, (user_id, user_id, pokemon_name))
    result = cursor.fetchone()
    if not result:
        return None
    return {
        'id': result[0],
        'challenger_id': result[1],
        'opponent_id': result[2],
        'game': result[3],
        'bonus_points': result[4],
    }

def get_all_active_races_for_user_and_pokemon(user_id, pokemon_name):
    """Récupère TOUTES les races actives pour un utilisateur et un Pokémon donné (multi-adversaires)"""
    cursor.execute("""
        SELECT id, challenger_id, opponent_id, game, bonus_points
        FROM shiny_races
        WHERE status = 'active'
        AND (challenger_id = ? OR opponent_id = ?)
        AND LOWER(pokemon_name) = LOWER(?)
        ORDER BY created_at ASC
    """, (user_id, user_id, pokemon_name))
    results = cursor.fetchall()
    return [
        {'id': r[0], 'challenger_id': r[1], 'opponent_id': r[2], 'game': r[3], 'bonus_points': r[4]}
        for r in results
    ]

def mark_race_won(race_id, winner_id):
    """Marque une race comme gagnée, attribue le bonus au gagnant et déduit du perdant."""
    # Récupérer infos race
    cursor.execute("""
        SELECT challenger_id, opponent_id, bonus_points
        FROM shiny_races WHERE id = ? AND status = 'active'
    """, (race_id,))
    row = cursor.fetchone()
    if not row:
        return
    challenger_id, opponent_id, bonus_points = row

    # Déterminer le perdant
    loser_id = opponent_id if winner_id == challenger_id else challenger_id

    # Marquer la race terminée
    cursor.execute("""
        UPDATE shiny_races
        SET status = 'finished',
            winner_id = ?,
            ended_at = datetime('now')
        WHERE id = ? AND status = 'active'
    """, (winner_id, race_id))

    # Malus perdant : retirer les points (plancher 0)
    cursor.execute("SELECT COALESCE(SUM(points),0) FROM shiny WHERE user_id=?", (loser_id,))
    loser_total = cursor.fetchone()[0] or 0
    deduction = min(bonus_points, loser_total)
    if deduction > 0:
        cursor.execute("""
            INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
            VALUES (?, ?, '', 'race_malus', date('now'), ?, datetime('now'), 'fr')
        """, (loser_id, f'[Malus Race #{race_id}]', -deduction))
    conn.commit()

    # Vérifier badge race
    try:
        check_and_award_badges(winner_id)
    except Exception:
        pass

# ════════════════════════════════════════════════════════════════
# ══  RACES OUVERTES (annonce en salon, participants illimités)  ══
# ════════════════════════════════════════════════════════════════

def create_open_race(pokemon_name, game, bonus_points, created_by, method_key=None, method_label=None, max_consoles=None, is_private=False, opponent_ids=None):
    """Crée une race ouverte et y inscrit automatiquement son créateur (+ les adversaires choisis). Retourne l'id de la race."""
    cursor.execute("""
        INSERT INTO open_races (pokemon_name, game, bonus_points, status, created_by, method_key, method_label, max_consoles, is_private)
        VALUES (?, ?, ?, 'active', ?, ?, ?, ?, ?)
    """, (pokemon_name, game, bonus_points, str(created_by), method_key, method_label, max_consoles, 1 if is_private else 0))
    conn.commit()
    race_id = cursor.lastrowid
    cursor.execute(
        "INSERT OR IGNORE INTO open_race_participants (race_id, user_id) VALUES (?, ?)",
        (race_id, str(created_by))
    )
    for uid in (opponent_ids or []):
        cursor.execute(
            "INSERT OR IGNORE INTO open_race_participants (race_id, user_id) VALUES (?, ?)",
            (race_id, str(uid))
        )
    conn.commit()
    return race_id

def set_open_race_message(race_id, channel_id, message_id):
    cursor.execute(
        "UPDATE open_races SET channel_id=?, message_id=? WHERE id=?",
        (str(channel_id), str(message_id), race_id)
    )
    conn.commit()

RACE_MIN_PARTICIPANTS_FOR_REWARD = 2  # Il faut au moins 2 participants pour que la race rapporte des points

def get_open_race(race_id):
    cursor.execute("""
        SELECT id, pokemon_name, game, bonus_points, status, winner_id, created_by, channel_id, message_id, created_at, awarded_points,
               method_key, method_label, max_consoles, is_private
        FROM open_races WHERE id=?
    """, (race_id,))
    row = cursor.fetchone()
    if not row:
        return None
    keys = ['id', 'pokemon_name', 'game', 'bonus_points', 'status', 'winner_id',
            'created_by', 'channel_id', 'message_id', 'created_at', 'awarded_points',
            'method_key', 'method_label', 'max_consoles', 'is_private']
    return dict(zip(keys, row))

def get_open_race_participants(race_id):
    cursor.execute(
        "SELECT user_id FROM open_race_participants WHERE race_id=? ORDER BY joined_at ASC",
        (race_id,)
    )
    return [r[0] for r in cursor.fetchall()]

def join_open_race(race_id, user_id):
    """Inscrit un joueur à la race. Retourne True s'il vient de rejoindre, False s'il participait déjà."""
    uid = str(user_id)
    cursor.execute("SELECT 1 FROM open_race_participants WHERE race_id=? AND user_id=?", (race_id, uid))
    if cursor.fetchone():
        return False
    cursor.execute("INSERT INTO open_race_participants (race_id, user_id) VALUES (?, ?)", (race_id, uid))
    conn.commit()
    return True

def get_active_open_races_for_user_and_pokemon(user_id, pokemon_name):
    """Toutes les races ouvertes actives auxquelles ce joueur participe, pour un Pokémon donné."""
    cursor.execute("""
        SELECT r.id, r.game, r.bonus_points, r.created_by, r.method_key, r.method_label, r.max_consoles
        FROM open_races r
        JOIN open_race_participants p ON p.race_id = r.id
        WHERE r.status = 'active'
        AND p.user_id = ?
        AND LOWER(r.pokemon_name) = LOWER(?)
        ORDER BY r.created_at ASC
    """, (str(user_id), pokemon_name))
    results = cursor.fetchall()
    return [
        {'id': r[0], 'game': r[1], 'bonus_points': r[2], 'created_by': r[3],
         'method_key': r[4], 'method_label': r[5], 'max_consoles': r[6]}
        for r in results
    ]

def finish_open_race(race_id, winner_id):
    """Termine une race ouverte de façon atomique. Retourne les infos de la race, ou None si déjà terminée/annulée.

    Anti-triche : si la race compte moins de RACE_MIN_PARTICIPANTS_FOR_REWARD participants
    (typiquement le créateur tout seul), elle se termine bien mais ne rapporte aucun point."""
    cursor.execute(
        "SELECT pokemon_name, bonus_points, channel_id, message_id, created_by FROM open_races WHERE id=? AND status='active'",
        (race_id,)
    )
    row = cursor.fetchone()
    if not row:
        return None
    pokemon_name, bonus_points, channel_id, message_id, created_by = row

    cursor.execute("SELECT COUNT(*) FROM open_race_participants WHERE race_id=?", (race_id,))
    nb_participants = cursor.fetchone()[0] or 0
    awarded_points = bonus_points if nb_participants >= RACE_MIN_PARTICIPANTS_FOR_REWARD else 0.0

    cursor.execute(
        "UPDATE open_races SET status='finished', winner_id=?, awarded_points=?, ended_at=datetime('now') WHERE id=? AND status='active'",
        (str(winner_id), awarded_points, race_id)
    )
    conn.commit()
    if cursor.rowcount == 0:
        return None
    return {
        'pokemon_name': pokemon_name, 'bonus_points': bonus_points, 'awarded_points': awarded_points,
        'nb_participants': nb_participants,
        'channel_id': channel_id, 'message_id': message_id, 'created_by': created_by
    }

def cancel_open_race(race_id):
    cursor.execute(
        "UPDATE open_races SET status='cancelled', ended_at=datetime('now') WHERE id=? AND status='active'",
        (race_id,)
    )
    conn.commit()
    return cursor.rowcount > 0

def get_active_open_races():
    cursor.execute("""
        SELECT id, pokemon_name, game, bonus_points, created_by, created_at
        FROM open_races WHERE status='active'
        ORDER BY created_at ASC
        LIMIT 50
    """)
    return cursor.fetchall()

def get_total_race_wins(user_id):
    """Nombre total de races gagnées, tous systèmes confondus (legacy 1v1 + ouvertes)."""
    uid = str(user_id)
    cursor.execute("SELECT COUNT(*) FROM shiny_races WHERE winner_id=?", (uid,))
    legacy = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COUNT(*) FROM open_races WHERE winner_id=? AND awarded_points > 0", (uid,))
    open_wins = cursor.fetchone()[0] or 0
    return legacy + open_wins

def get_race_stats(user_id):
    """Récupère les statistiques de race pour un utilisateur (legacy 1v1 + races ouvertes)."""
    uid = str(user_id)

    # Races gagnées
    cursor.execute("SELECT COUNT(*) FROM shiny_races WHERE winner_id = ?", (uid,))
    wins_legacy = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COUNT(*) FROM open_races WHERE winner_id = ? AND awarded_points > 0", (uid,))
    wins_open = cursor.fetchone()[0] or 0
    wins = wins_legacy + wins_open

    # Races jouées
    cursor.execute("""
        SELECT COUNT(*)
        FROM shiny_races
        WHERE challenger_id = ? OR opponent_id = ?
    """, (uid, uid))
    total_legacy = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COUNT(*) FROM open_race_participants WHERE user_id = ?", (uid,))
    total_open = cursor.fetchone()[0] or 0
    total = total_legacy + total_open

    # Races en cours
    cursor.execute("""
        SELECT COUNT(*)
        FROM shiny_races
        WHERE status = 'active'
        AND (challenger_id = ? OR opponent_id = ?)
    """, (uid, uid))
    active_legacy = cursor.fetchone()[0] or 0
    cursor.execute("""
        SELECT COUNT(*) FROM open_race_participants p
        JOIN open_races r ON r.id = p.race_id
        WHERE p.user_id = ? AND r.status = 'active'
    """, (uid,))
    active_open = cursor.fetchone()[0] or 0
    active = active_legacy + active_open

    # Total de points bonus gagnés
    cursor.execute("SELECT COALESCE(SUM(bonus_points), 0) FROM shiny_races WHERE winner_id = ?", (uid,))
    bonus_legacy = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COALESCE(SUM(awarded_points), 0) FROM open_races WHERE winner_id = ?", (uid,))
    bonus_open = cursor.fetchone()[0] or 0
    total_bonus = bonus_legacy + bonus_open

    return {
        'wins': wins,
        'total': total,
        'active': active,
        'total_bonus': total_bonus
    }

def get_active_races():
    """Retourne la liste des races actives"""
    cursor.execute("""
        SELECT id, challenger_id, opponent_id, pokemon_name, game, bonus_points, created_at
        FROM shiny_races
        WHERE status = 'active'
        ORDER BY created_at ASC
        LIMIT 50
    """)
    return cursor.fetchall()

# ════════════════════════════════════════════════════════════════
# ══  SYSTÈME COMPÉTITIF (comeback, nerf top, diminishing)     ══
# ════════════════════════════════════════════════════════════════

# Soft cap hebdomadaire progressif
# Formule : effective = CAP + SOFTCAP_A × (extra)^SOFTCAP_B
# Résultat : 320→320 | 400→~394 | 500→~474 | 700→~622 | 1000→~830
WEEKLY_CAP    = 700.0   # Points hebdo à partir desquels le soft cap s'active (assoupli : le grind shiny honnête n'est presque plus bridé, 320 → 700)
SOFTCAP_A     = 1.44    # Coefficient du soft cap (amplitude)
SOFTCAP_B     = 0.90    # Exposant du soft cap (courbure) — plus bas = plus doux (adouci : 0.85 → 0.90)

# ── Décote d'inactivité (Top 20 uniquement) ───────────────────────────────────
INACTIVITY_TOP_N       = 20     # Seuls les joueurs classés dans ce Top sont concernés
INACTIVITY_GRACE_DAYS  = 14     # Jours sans shiny avant que la décote démarre (adouci : 7 → 14)
INACTIVITY_DECAY_RATE  = 0.015  # % de points en moins par jour au-delà de la grâce
INACTIVITY_MAX_DECAY   = 0.08   # Plafond : jamais plus de 8% de décote (adouci : 15% → 8%)

# ── Races ouvertes ─────────────────────────────────────────────────────────────
RACE_DEFAULT_BONUS_POINTS = 50.0  # Bonus fixe pour le gagnant d'une race ouverte

# ── Série de placement (nouveaux joueurs uniquement) ──────────────────────────
PLACEMENT_MAX_SHINYS    = 5      # Nombre de shinys couverts par la série de placement
PLACEMENT_MAX_BONUS_PTS = 150.0  # Plafond cumulé d'exemption de soft cap sur la série

# ── Calibrage doux après reset de saison ──────────────────────────────────────
SEASON_CALIBRATION_BY_TIER = {
    "hunter1": 15, "hunter2": 15, "hunter3": 15,
    "master": 10,
    "diamant": 6,
    "emeraude": 4,
    "platine": 2,
}

def get_user_weekly_pts(user_id):
    """Points accumulés par l'utilisateur cette semaine."""
    week_start = get_current_week_start()
    cursor.execute(
        "SELECT total_pts FROM weekly_points_tracking WHERE user_id=? AND week_start=?",
        (str(user_id), week_start)
    )
    row = cursor.fetchone()
    return row[0] if row else 0.0

def add_user_weekly_pts(user_id, pts):
    """Ajoute des points au compteur hebdomadaire."""
    week_start = get_current_week_start()
    cursor.execute("""
        INSERT INTO weekly_points_tracking (user_id, week_start, total_pts)
        VALUES (?, ?, ?)
        ON CONFLICT(user_id, week_start) DO UPDATE SET total_pts = total_pts + excluded.total_pts
    """, (str(user_id), week_start, pts))
    conn.commit()

def _weekly_soft_cap(total_raw):
    """Calcule les points effectifs à partir du total brut hebdomadaire.
    Formule fluide : CAP + A*(extra)^B — aucune cassure brutale.

    Exemples :
        250 → 250  |  300 → ~290  |  400 → ~352
        500 → ~407 |  700 → ~509  | 1000 → ~650
    """
    import math as _m
    if total_raw <= WEEKLY_CAP:
        return total_raw
    extra = total_raw - WEEKLY_CAP
    return round(WEEKLY_CAP + SOFTCAP_A * (extra ** SOFTCAP_B), 2)


def apply_diminishing_returns(user_id, raw_pts):
    """Applique le soft cap hebdomadaire progressif à un gain de points.

    Calcule combien de points effectifs le joueur reçoit en tenant compte
    de ce qu'il a déjà accumulé cette semaine.
    Retourne les points effectifs (toujours >= 0).
    """
    already = get_user_weekly_pts(user_id)
    total_after = already + raw_pts

    # Points effectifs avant et après cet ajout
    eff_before = _weekly_soft_cap(already)
    eff_after  = _weekly_soft_cap(total_after)

    # Le gain effectif = différence des caps
    effective = round(max(0.0, eff_after - eff_before), 2)
    return effective

# Nerf top 3 progressif : borné entre NERF_MIN (grosse avance) et NERF_MAX (course serrée)
TOP3_NERF_MIN = 0.92   # Pénalité max si le joueur a une grosse avance sur la 4e place
TOP3_NERF_MAX = 0.98   # Pénalité minimale si la course est serrée avec la 4e place

def get_position_multiplier(user_id):
    """Retourne le multiplicateur de position (comeback/nerf top3).

    Le nerf du top 3 est désormais progressif : un joueur qui vient tout
    juste d'atteindre la 3e place, à quelques points du 4e, n'est presque
    pas pénalisé. Le nerf ne devient significatif que si le joueur creuse
    un écart important avec la 4e place — on freine la domination, pas
    juste le fait d'être bien classé.
    """
    ladder = get_ladder()
    rank = next((i + 1 for i, r in enumerate(ladder) if str(r[0]) == str(user_id)), None)
    if rank is None:
        return 1.25  # Pas encore classé = bonus max
    if rank <= 3:
        leader_pts = ladder[rank - 1][1] or 0.0
        if leader_pts <= 0:
            return TOP3_NERF_MAX
        fourth_pts = ladder[3][1] if len(ladder) > 3 else leader_pts
        fourth_pts = fourth_pts or 0.0
        lead_ratio = max(0.0, min(1.0, (leader_pts - fourth_pts) / leader_pts))
        mult = TOP3_NERF_MAX - lead_ratio * (TOP3_NERF_MAX - TOP3_NERF_MIN)
        return round(mult, 3)
    elif rank <= 10:
        return 1.10  # Bonus rang 4-10
    else:
        return 1.25  # Bonus comeback rang 11+


def apply_competitive_multipliers(user_id, raw_pts, cap_source_pts=None):
    """Applique tous les multiplicateurs compétitifs dans l'ordre :
    1. Multiplicateur de position (comeback/nerf)
    2. Diminishing returns hebdo
    Retourne (pts_finaux, pts_avant_dr, position_mult, cap_after_pos).

    `cap_source_pts` permet de définir explicitement la base qui compte pour le cap.
    Si None, on utilise raw_pts (comportement historique).
    """
    pos_mult = get_position_multiplier(user_id)
    after_pos = round(raw_pts * pos_mult, 2)
    cap_input = raw_pts if cap_source_pts is None else cap_source_pts
    cap_after_pos = round(cap_input * pos_mult, 2)
    effective = apply_diminishing_returns(user_id, cap_after_pos)
    return effective, after_pos, pos_mult, cap_after_pos


# ════════════════════════════════════════════════════════════════
# ══  CAP HEBDO SUR LES BONUS (séparé du cap shiny)             ══
# ════════════════════════════════════════════════════════════════
# Le cap shiny ci-dessus ne freine que le grind "brut" (Full Odds, etc.).
# Tous les bonus (wanted perso, race, guilde, participation, challenges...)
# contournaient entièrement ce système. Ce second cap, indépendant, les
# regroupe pour qu'ils restent un complément et non une stratégie de farm
# aussi rentable que le grind honnête.
BONUS_WEEKLY_CAP = 200.0  # Points de bonus/semaine à partir desquels le soft cap bonus s'active
BONUS_SOFTCAP_A  = 1.20   # Coefficient du soft cap bonus (amplitude)
BONUS_SOFTCAP_B  = 0.85   # Exposant du soft cap bonus (courbure) — valeurs de départ, à ajuster à l'usage

# Catégories considérées comme des "bonus" (tout ce qui n'est pas un vrai
# shiny trouvé) et donc soumises au cap bonus. Les malus (race_malus,
# race_team_malus), la décote d'inactivité et les ajustements admin/saison
# ne sont volontairement JAMAIS plafonnés : une pénalité doit toujours
# s'appliquer intégralement, et les ajustements admin sont déjà décidés au cas par cas.
BONUS_CAPPED_METHODS = {
    'race_bonus', 'race_team_bonus',
    'weekly_objective', 'monthly_objective',
    'bounty_bonus', 'participation_bonus', 'monday_first_bonus',
    'new_player_bonus', 'parrainage_bonus', 'guilde_objective_bonus',
    'challenge_bonus', 'type_challenge_bonus', 'wanted_bonus',
}

cursor.execute("""
CREATE TABLE IF NOT EXISTS weekly_bonus_tracking (
    user_id TEXT NOT NULL,
    week_start TEXT NOT NULL,
    total_pts REAL DEFAULT 0,
    PRIMARY KEY (user_id, week_start)
)
""")
conn.commit()


def get_user_weekly_bonus_pts(user_id):
    """Points de bonus accumulés (bruts, avant cap) par l'utilisateur cette semaine."""
    week_start = get_current_week_start()
    cursor.execute(
        "SELECT total_pts FROM weekly_bonus_tracking WHERE user_id=? AND week_start=?",
        (str(user_id), week_start)
    )
    row = cursor.fetchone()
    return row[0] if row else 0.0


def add_user_weekly_bonus_pts(user_id, pts):
    """Ajoute des points au compteur hebdomadaire de bonus."""
    week_start = get_current_week_start()
    cursor.execute("""
        INSERT INTO weekly_bonus_tracking (user_id, week_start, total_pts)
        VALUES (?, ?, ?)
        ON CONFLICT(user_id, week_start) DO UPDATE SET total_pts = total_pts + excluded.total_pts
    """, (str(user_id), week_start, pts))
    conn.commit()


def _bonus_weekly_soft_cap(total_raw):
    """Même principe que le soft cap shiny (courbe progressive, aucune cassure brutale),
    appliqué au total hebdo de BONUS d'un joueur."""
    import math as _m
    if total_raw <= BONUS_WEEKLY_CAP:
        return total_raw
    extra = total_raw - BONUS_WEEKLY_CAP
    return round(BONUS_WEEKLY_CAP + BONUS_SOFTCAP_A * (extra ** BONUS_SOFTCAP_B), 2)


def apply_bonus_diminishing_returns(user_id, raw_pts):
    """Calcule combien de points de bonus effectifs le joueur reçoit, en tenant
    compte de ce qu'il a déjà accumulé en bonus cette semaine. Retourne les
    points effectifs (toujours >= 0)."""
    if raw_pts <= 0:
        return raw_pts  # Ne jamais plafonner un malus/valeur négative ou nulle
    already = get_user_weekly_bonus_pts(user_id)
    total_after = already + raw_pts
    eff_before = _bonus_weekly_soft_cap(already)
    eff_after  = _bonus_weekly_soft_cap(total_after)
    return round(max(0.0, eff_after - eff_before), 2)


def award_capped_bonus(user_id, pokemon_label, methode, raw_points, game=''):
    """Point d'entrée UNIQUE pour créditer un bonus (wanted, race, guilde,
    participation, challenge, etc.). Applique le cap hebdo bonus, insère la
    ligne dans `shiny` avec le montant EFFECTIF (déjà plafonné), met à jour
    le compteur hebdo de bonus, et retourne les points réellement accordés
    (utile pour les messages Discord qui annoncent le gain).

    Ne s'applique qu'aux catégories listées dans BONUS_CAPPED_METHODS —
    les malus et ajustements système passent toujours en direct.
    """
    if methode in BONUS_CAPPED_METHODS and raw_points > 0:
        effective_points = apply_bonus_diminishing_returns(user_id, raw_points)
        add_user_weekly_bonus_pts(user_id, raw_points)
    else:
        effective_points = raw_points
    cursor.execute("""
        INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
        VALUES (?, ?, ?, ?, date('now'), ?, datetime('now'), 'fr')
    """, (str(user_id), pokemon_label, game, methode, effective_points))
    conn.commit()
    return effective_points


def get_or_init_placement_state(user_id):
    """Retourne (shinys_used, bonus_pts_used) pour la série de placement.

    Si c'est la toute première fois qu'on voit ce user_id (jamais vu, même
    lors d'une saison précédente), on l'enregistre comme nouveau joueur et
    on initialise sa série de placement. Sinon, on renvoie son état existant
    (ou None si ce n'est pas/plus un joueur en placement)."""
    uid = str(user_id)
    cursor.execute("SELECT 1 FROM user_first_seen WHERE user_id=?", (uid,))
    already_known = cursor.fetchone() is not None
    if not already_known:
        cursor.execute("INSERT INTO user_first_seen (user_id) VALUES (?)", (uid,))
        cursor.execute(
            "INSERT OR IGNORE INTO placement_state (user_id, shinys_used, bonus_pts_used) VALUES (?, 0, 0)",
            (uid,)
        )
        conn.commit()
    cursor.execute("SELECT shinys_used, bonus_pts_used FROM placement_state WHERE user_id=?", (uid,))
    return cursor.fetchone()


def is_in_placement(user_id):
    """True si le joueur est encore couvert par sa série de placement."""
    row = get_or_init_placement_state(user_id)
    if row is None:
        return False
    shinys_used, bonus_pts_used = row
    return shinys_used < PLACEMENT_MAX_SHINYS and bonus_pts_used < PLACEMENT_MAX_BONUS_PTS


def register_placement_usage(user_id, exemption_used):
    """Incrémente le compteur de shinys/points utilisés pour la série de placement."""
    uid = str(user_id)
    cursor.execute("""
        UPDATE placement_state
        SET shinys_used = shinys_used + 1,
            bonus_pts_used = bonus_pts_used + ?
        WHERE user_id = ?
    """, (round(exemption_used, 2), uid))
    conn.commit()


_INACTIVITY_REAL_SHINY_EXCLUDE = (
    'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus',
    'inactivity_decay', 'season_calibration', 'season_carryover',
    'weekly_objective', 'monthly_objective', 'admin_adjustment', 'bounty_bonus',
    'participation_bonus', 'monday_first_bonus', 'new_player_bonus', 'parrainage_bonus',
    'challenge_bonus', 'type_challenge_bonus', 'guilde_objective_bonus', 'wanted_bonus'
)


def get_last_real_shiny_datetime(user_id):
    """Dernière date/heure (created_at) d'un vrai shiny (hors bonus/malus système)."""
    placeholders = ",".join("?" for _ in _INACTIVITY_REAL_SHINY_EXCLUDE)
    cursor.execute(f"""
        SELECT MAX(created_at) FROM shiny
        WHERE user_id=? AND methode NOT IN ({placeholders})
    """, (str(user_id), *_INACTIVITY_REAL_SHINY_EXCLUDE))
    row = cursor.fetchone()
    return row[0] if row and row[0] else None


def get_raw_real_points_sum(user_id):
    """Somme des points 'réels' du joueur (hors décote d'inactivité elle-même)."""
    cursor.execute(
        "SELECT COALESCE(SUM(points),0) FROM shiny WHERE user_id=? AND methode != 'inactivity_decay'",
        (str(user_id),)
    )
    return cursor.fetchone()[0] or 0.0


def apply_inactivity_decay_for_user(user_id):
    """Calcule et applique (ou rembourse) la décote d'inactivité pour un joueur du Top N.

    - Aucun effet tant que le joueur reste actif dans la fenêtre de grâce.
    - Dès qu'il logue un nouveau shiny, toute décote en cours est intégralement remboursée.
    - La décote grimpe doucement (INACTIVITY_DECAY_RATE/jour) et plafonne à INACTIVITY_MAX_DECAY.
    """
    uid = str(user_id)
    last_dt_str = get_last_real_shiny_datetime(uid)
    if not last_dt_str:
        return

    cursor.execute(
        "SELECT idle_start_date, base_points, decay_applied_pts, last_shiny_date_seen FROM inactivity_decay_state WHERE user_id=?",
        (uid,)
    )
    state = cursor.fetchone()

    # Le joueur a loggé un nouveau shiny depuis notre dernière vérification → on rembourse tout.
    if state and state[3] != last_dt_str:
        decay_applied_pts = state[2] or 0.0
        if decay_applied_pts > 0:
            cursor.execute("""
                INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                VALUES (?, ?, '', 'inactivity_decay', date('now'), ?, datetime('now'), 'fr')
            """, (uid, '[⏳ Décote annulée — retour actif]', decay_applied_pts))
            conn.commit()
        cursor.execute("DELETE FROM inactivity_decay_state WHERE user_id=?", (uid,))
        state = None

    try:
        last_dt = datetime.strptime(last_dt_str[:19], "%Y-%m-%d %H:%M:%S")
    except Exception:
        return
    idle_days = (datetime.now() - last_dt).days
    if idle_days <= INACTIVITY_GRACE_DAYS:
        return

    if state is None:
        base_points = get_raw_real_points_sum(uid)
        cursor.execute("""
            INSERT INTO inactivity_decay_state (user_id, idle_start_date, base_points, decay_applied_pts, last_shiny_date_seen)
            VALUES (?, ?, ?, 0, ?)
        """, (uid, last_dt_str, base_points, last_dt_str))
        conn.commit()
        decay_applied_pts = 0.0
    else:
        base_points = state[1] or 0.0
        decay_applied_pts = state[2] or 0.0

    target_pct = min(INACTIVITY_MAX_DECAY, INACTIVITY_DECAY_RATE * (idle_days - INACTIVITY_GRACE_DAYS))
    target_pts = round(base_points * target_pct, 2)
    delta = round(target_pts - decay_applied_pts, 2)
    if delta <= 0.01:
        return

    # Ne jamais faire passer le total du joueur sous 0.
    current_total = get_raw_real_points_sum(uid)
    delta = min(delta, current_total)
    if delta <= 0:
        return

    cursor.execute("""
        INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
        VALUES (?, ?, '', 'inactivity_decay', date('now'), ?, datetime('now'), 'fr')
    """, (uid, f"[⏳ Décote d'inactivité — {idle_days}j]", -delta))
    cursor.execute(
        "UPDATE inactivity_decay_state SET decay_applied_pts=? WHERE user_id=?",
        (round(decay_applied_pts + delta, 2), uid)
    )
    conn.commit()


async def background_inactivity_decay():
    """Vérifie une fois par jour la décote d'inactivité des joueurs du Top N."""
    await bot.wait_until_ready()
    await asyncio.sleep(30)
    last_run_date = None
    while not bot.is_closed():
        now = datetime.now()
        if last_run_date != now.date():
            try:
                ladder = get_ladder()
                top_users = [uid for uid, *_ in ladder[:INACTIVITY_TOP_N]]
                for uid in top_users:
                    apply_inactivity_decay_for_user(uid)
                last_run_date = now.date()
                logger.info(f"[INACTIVITY DECAY] Vérification effectuée pour {len(top_users)} joueur(s) du Top {INACTIVITY_TOP_N}.")
            except Exception as e:
                logger.error(f"[INACTIVITY DECAY] Erreur: {e}", exc_info=True)
        await asyncio.sleep(1800)


def take_ladder_snapshot():
    """Enregistre l'état actuel du classement (rang + points) pour permettre
    d'afficher des flèches de tendance (▲/▼/–) dans les embeds de classement."""
    ladder = get_ladder()
    today = date.today().isoformat()
    for i, (uid, points, *_rest) in enumerate(ladder, 1):
        cursor.execute("""
            INSERT INTO ladder_snapshot (user_id, snapshot_at, rank, points)
            VALUES (?, ?, ?, ?)
            ON CONFLICT(user_id, snapshot_at) DO UPDATE SET rank=excluded.rank, points=excluded.points
        """, (str(uid), today, i, points))
    conn.commit()
    # On garde 30 jours d'historique max pour ne pas alourdir la table indéfiniment
    cursor.execute("DELETE FROM ladder_snapshot WHERE snapshot_at < date('now', '-30 days')")
    conn.commit()


def get_rank_trend(user_id, days_ago=1):
    """Compare le rang actuel d'un joueur à son rang d'il y a `days_ago` jours.

    Retourne un tuple (symbole, delta) où symbole est '▲', '▼' ou '–', et
    delta le nombre de places gagnées/perdues (None si pas de snapshot dispo).
    """
    target_date = (date.today() - timedelta(days=days_ago)).isoformat()
    cursor.execute(
        "SELECT rank FROM ladder_snapshot WHERE user_id=? AND snapshot_at<=? ORDER BY snapshot_at DESC LIMIT 1",
        (str(user_id), target_date)
    )
    row = cursor.fetchone()
    if not row:
        return ("–", None)
    old_rank = row[0]
    new_rank, _ = get_user_rank(user_id)
    if new_rank is None:
        return ("–", None)
    delta = old_rank - new_rank  # positif = progression (rang plus petit)
    if delta > 0:
        return ("▲", delta)
    elif delta < 0:
        return ("▼", abs(delta))
    else:
        return ("–", 0)


async def background_ladder_snapshot():
    """Prend un instantané quotidien du classement (pour les flèches de tendance)."""
    await bot.wait_until_ready()
    await asyncio.sleep(45)
    last_run_date = None
    while not bot.is_closed():
        now = datetime.now()
        if last_run_date != now.date():
            try:
                take_ladder_snapshot()
                last_run_date = now.date()
                logger.info("[LADDER SNAPSHOT] Instantané du classement enregistré.")
            except Exception as e:
                logger.error(f"[LADDER SNAPSHOT] Erreur: {e}", exc_info=True)
        await asyncio.sleep(1800)


def add_shiny(user_id, pokemon, game, method_key, date, points, language="fr", console_count=1, hunt_counter=0, hunt_type="emulators", type_pokemon=None, for_mystery_wanted=False):
    """Ajoute un shiny à la base de données et met à jour les streaks"""
    bonus_points = 0
    is_wanted = False
    wanted_details = []
    stored_type_pokemon = type_pokemon or getattr(add_shiny, '_pending_type', None)
    
    # Vérifier si c'est un Pokémon wanted (il peut y en avoir plusieurs actifs)
    wanteds = get_active_wanteds()
    for wanted in wanteds:
        # Comparer le nom de Pokémon (insensible à la casse) — principal + alternates
        import json as _json_wanted
        _alt_raw = wanted.get('pokemon_alternates')
        _alt_list = []
        if _alt_raw:
            try:
                _alt_list = [n.lower() for n in _json_wanted.loads(_alt_raw)]
            except Exception:
                pass
        _all_names = {wanted['pokemon_name'].lower()} | set(_alt_list)
        if pokemon.lower() not in _all_names:
            continue

        # Si un jeu est imposé pour ce wanted, vérifier qu'il correspond (insensible à la casse)
        wanted_game = wanted.get('game')
        if wanted_game and wanted_game.strip():
            if not game or game.lower() != wanted_game.lower():
                continue

        # Vérifier si l'utilisateur n'a pas déjà réclamé ce bonus pour CE wanted
        if has_claimed_wanted(user_id, wanted['id']):
            continue

        # Calcul du bonus en fonction du palier (rang du joueur parmi ceux ayant trouvé ce wanted)
        cursor.execute("""
            SELECT COUNT(*) FROM shiny_wanted_claimed
            WHERE wanted_id = ?
        """, (wanted['id'],))
        already_count = cursor.fetchone()[0] or 0

        import json
        paliers_json = wanted.get('paliers_json')
        try:
            if paliers_json:
                paliers = json.loads(paliers_json)
                p1 = paliers.get('p1', wanted['bonus_points'])
                p2 = paliers.get('p2', p1)
                p3 = paliers.get('p3', p2)
                p_suite = paliers.get('suite', p3)
                if already_count == 0:
                    this_bonus = p1
                elif already_count == 1:
                    this_bonus = p2
                elif already_count == 2:
                    this_bonus = p3
                else:
                    this_bonus = p_suite
            else:
                # Ancien système decay_percent (rétrocompatibilité)
                decay = float(wanted.get('decay_percent', 100.0) or 100.0)
                factor = 1.0
                if decay < 100.0:
                    factor = (decay / 100.0) ** already_count
                this_bonus = max(wanted['bonus_points'] * factor, 0)
        except Exception:
            this_bonus = wanted['bonus_points']
        if this_bonus <= 0:
            continue

        # Appliquer le multiplicateur console/émulateur exactement comme pour les points normaux
        console_multiplier = calculate_console_multiplier(console_count, hunt_type)
        this_bonus = round(this_bonus * console_multiplier, 2)
        if this_bonus <= 0:
            continue

        bonus_points += this_bonus
        is_wanted = True
        wanted_details.append((wanted, this_bonus))

        # Enregistrer que l'utilisateur a réclamé le bonus pour CE wanted
        claim_wanted_bonus(user_id, wanted['id'], pokemon, this_bonus)
        logger.info(f"Bonus wanted accordé à {user_id} pour {pokemon} (+{this_bonus} pts x{console_multiplier}, wanted {wanted['id']})")
    
    # Le cap hebdo doit compter uniquement les points du shiny ajouté,
    # sans les bonus annexes (wanted, challenge, etc.).
    raw_shiny_only = points
    raw_total = points + bonus_points

    # ── Bonus "Nouveau jeu" (+10%) ─────────────────────────────────────────────
    # Si le joueur utilise un jeu qu'il n'a JAMAIS utilisé depuis son inscription
    # (toutes saisons confondues), on applique un bonus de +10% sur les points du shiny.
    # La table user_game_history persiste à travers les resets de saison.
    add_shiny._last_new_game_bonus = False
    _system_methods_ng = {'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus', 'inactivity_decay', 'season_calibration',
                          'weekly_objective', 'monthly_objective', 'admin_adjustment',
                          'bounty_bonus', 'participation_bonus', 'monday_first_bonus',
                          'new_player_bonus', 'parrainage_bonus', 'challenge_bonus', 'type_challenge_bonus',
                          'season_carryover', 'wanted_bonus'}
    _game_key_ng = resolve_game_key(game) if game else None
    if _game_key_ng and method_key not in _system_methods_ng:
        cursor.execute(
            "SELECT 1 FROM user_game_history WHERE user_id=? AND game_key=?",
            (str(user_id), _game_key_ng)
        )
        if cursor.fetchone() is None:
            # Premier shiny dans ce jeu pour ce joueur — appliquer +10% et mémoriser
            _new_game_bonus = round(raw_shiny_only * 0.10, 2)
            raw_shiny_only = round(raw_shiny_only + _new_game_bonus, 2)
            raw_total      = round(raw_total      + _new_game_bonus, 2)
            cursor.execute(
                "INSERT OR IGNORE INTO user_game_history (user_id, game_key) VALUES (?, ?)",
                (str(user_id), _game_key_ng)
            )
            add_shiny._last_new_game_bonus = True
            logger.info(f"Bonus nouveau jeu (+10%) accordé à {user_id} pour {_game_key_ng}")


    _event = get_active_event()
    _event_mult = get_event_multiplier(game, _event)
    if _event_mult != 1.0:
        raw_total = round(raw_total * _event_mult, 2)
        # Le cap hebdomadaire doit aussi tenir compte du bonus event
        # pour que le diminishing returns soit calculé correctement
        raw_shiny_only = round(raw_shiny_only * _event_mult, 2)
        add_shiny._last_event_mult = _event_mult
        add_shiny._last_event_desc = _event['description'] if _event else None
    else:
        add_shiny._last_event_mult = 1.0
        add_shiny._last_event_desc = None

    # Appliquer multiplicateurs compétitifs (comeback, nerf top3, diminishing returns)
    # Seulement pour les vrais shinys (pas les bonus/malus systèmes)
    _system_methods = {'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus', 'inactivity_decay', 'season_calibration',
                       'weekly_objective', 'monthly_objective', 'admin_adjustment', 'bounty_bonus',
                       'wanted_bonus'}
    if method_key not in _system_methods:
        effective_pts, after_pos, pos_mult, cap_after_pos = apply_competitive_multipliers(
            user_id, raw_shiny_only, cap_source_pts=raw_shiny_only
        )

        # Série de placement : les tout premiers shinys d'un nouveau joueur
        # sont exemptés du soft cap hebdo (dans la limite d'un budget cumulé),
        # pour qu'il trouve rapidement son vrai niveau sans être bridé.
        placement_row = get_or_init_placement_state(user_id)
        in_placement = (
            placement_row is not None
            and placement_row[0] < PLACEMENT_MAX_SHINYS
            and placement_row[1] < PLACEMENT_MAX_BONUS_PTS
        )
        exemption_used = 0.0
        if in_placement:
            exemption_potential = max(0.0, round(cap_after_pos - effective_pts, 2))
            remaining_budget = max(0.0, round(PLACEMENT_MAX_BONUS_PTS - placement_row[1], 2))
            exemption_used = min(exemption_potential, remaining_budget)
            if exemption_used > 0:
                effective_pts = round(effective_pts + exemption_used, 2)
            register_placement_usage(user_id, exemption_used)

        bonus_outside_cap = max(0.0, raw_total - raw_shiny_only)
        total_points = round(effective_pts + bonus_outside_cap, 2)
        add_shiny._last_pos_mult = pos_mult
        add_shiny._last_raw_pts = raw_total
        add_shiny._last_cap_raw_pts = cap_after_pos
        add_shiny._last_placement_exemption = exemption_used
        # Mettre à jour le compteur hebdo (montant brut, même si exempté du soft cap)
        add_user_weekly_pts(user_id, cap_after_pos)
    else:
        total_points = raw_total
        add_shiny._last_pos_mult = 1.0
        add_shiny._last_raw_pts = raw_total
        add_shiny._last_cap_raw_pts = raw_total
        add_shiny._last_placement_exemption = 0.0

    cursor.execute(
        "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter, hunt_type) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?, ?, ?, ?)",
        (user_id, pokemon, game, method_key, date, total_points, language, console_count, hunt_counter, hunt_type)
    )
    # Stocker le type si fourni. `_pending_type` reste uniquement un fallback rétrocompatibilité.
    if stored_type_pokemon:
        _last_rowid = cursor.lastrowid
        cursor.execute("UPDATE shiny SET type_pokemon=? WHERE rowid=?", (stored_type_pokemon, _last_rowid))
    add_shiny._pending_type = None
    conn.commit()
    
    # Mettre à jour le streak de l'utilisateur
    try:
        update_user_streak(user_id, date)
    except Exception as e:
        logger.error(f"Erreur lors de la mise à jour du streak pour {user_id}: {e}")

    # Vérification badges automatiques
    try:
        check_and_award_badges(user_id)
    except Exception as e:
        logger.error(f"Erreur badge check pour {user_id}: {e}")

    # Vérification bounties collaboratifs
    add_shiny._last_bounty_events = []
    try:
        active_bounties = get_active_collab_bounties()
        for bounty in active_bounties:
            if pokemon.lower() != bounty['pokemon_name'].lower():
                continue
            if bounty['game'] and game and game.lower() != bounty['game'].lower():
                continue
            is_new = join_collab_bounty(bounty['id'], user_id)
            if is_new:
                progress = get_bounty_progress(bounty['id'])
                bounty_event = {
                    'id': bounty['id'],
                    'pokemon_name': bounty['pokemon_name'],
                    'progress': progress,
                    'goal': bounty['goal'],
                    'bonus_points': bounty['bonus_points'],
                    'completed': progress >= bounty['goal'],
                }
                add_shiny._last_bounty_events.append(bounty_event)
                if progress >= bounty['goal']:
                    # Bounty complété : distribuer les bonus
                    participants = complete_collab_bounty(bounty['id'])
                    for pid in participants:
                        award_capped_bonus(
                            pid, f'[Bounty Collab #{bounty["id"]}]', 'bounty_bonus', bounty['bonus_points']
                        )
                    conn.commit()
    except Exception as e:
        logger.error(f"Erreur bounty check pour {user_id}: {e}")

    # Vérifier si le joueur est le premier du jour (avant son propre ajout)
    cursor.execute("""
        SELECT COUNT(*) FROM shiny
        WHERE user_id != ? AND DATE(created_at) = DATE('now')
        AND methode NOT IN ('participation_bonus','weekly_objective','monthly_objective',
                            'race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
                            'admin_adjustment','bounty_bonus','season_carryover',
                            'monday_first_bonus','new_player_bonus', 'parrainage_bonus','guilde_objective_bonus')
    """, (user_id,))
    others_today = cursor.fetchone()[0] or 0
    is_first_of_day = (others_today == 0)

    # ── Bonus spéciaux ──────────────────────────────────────────────────────
    special_bonuses = []  # liste de (label, pts) pour affichage
    _system_skip = {
        'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus', 'inactivity_decay', 'season_calibration',
        'weekly_objective', 'monthly_objective', 'admin_adjustment',
        'bounty_bonus', 'season_carryover', 'participation_bonus',
        'monday_first_bonus', 'new_player_bonus', 'parrainage_bonus', 'guilde_objective_bonus',
    }

    # Bonus participation hebdo (+5 pts, 1 fois par semaine)
    try:
        if method_key not in _system_skip:
            _part_eff = award_participation_bonus(user_id)
            if _part_eff:
                special_bonuses.append(("🗓️ Participation hebdo", _part_eff))
    except Exception as e:
        logger.error(f"Erreur participation bonus: {e}")

    # Bonus jeu de la semaine : +20 pts pour le 1er joueur à ajouter un shiny du jeu tiré
    try:
        if method_key not in _system_skip:
            _weekly_game = get_weekly_game()
            if _weekly_game and resolve_game_key(game) == _weekly_game and is_weekly_game_bonus_available():
                _wg_eff = award_weekly_game_bonus(user_id)
                if _wg_eff:
                    _game_label = GAMES.get(_weekly_game, {}).get('fr', _weekly_game)
                    special_bonuses.append((f"🎮 1er shiny du jeu de la semaine ({_game_label}) !", _wg_eff))
    except Exception as e:
        logger.error(f"Erreur weekly game bonus: {e}")

    # Bonus nouveau joueur (+25 pts, 1er shiny ever)
    try:
        if method_key not in _system_skip and is_new_player(user_id):
            _np_eff = award_new_player_bonus(user_id)
            if _np_eff:
                special_bonuses.append(("🎉 Bienvenue (nouveau joueur)", _np_eff))
    except Exception as e:
        logger.error(f"Erreur new player bonus: {e}")

    # Bonus de parrainage (+15 pts au filleul + 15 pts au parrain, 1er shiny ever du filleul)
    add_shiny._last_parrain_notify = None
    try:
        if method_key not in _system_skip:
            _parrain_result = award_parrainage_bonus_if_due(user_id)
            if _parrain_result:
                parrain_id, filleul_eff, parrain_eff = _parrain_result
                special_bonuses.append(("🤝 Bonus parrainage", filleul_eff))
                add_shiny._last_parrain_notify = (parrain_id, filleul_eff, parrain_eff)
    except Exception as e:
        logger.error(f"Erreur parrainage bonus: {e}")

    # Challenge mensuel surprise
    try:
        if method_key not in _system_skip:
            _ch_bonus, _ch_desc = check_challenge_completion(user_id, pokemon, game, stored_type_pokemon)
            if _ch_bonus > 0:
                _ch_effective = award_capped_bonus(
                    user_id, f'[Challenge : {_ch_desc[:40]}]', 'challenge_bonus', _ch_bonus
                )
                conn.commit()
                special_bonuses.append((f"🎯 Challenge mensuel !", _ch_effective))
    except Exception as e:
        logger.error(f"Erreur challenge bonus: {e}")

    # Mettre à jour la progression des objectifs hebdomadaires
    objective_bonuses = []
    try:
        objective_bonuses = check_and_update_objectives(
            user_id, pokemon, game, method_key, total_points, is_first_of_day
        )
    except Exception as e:
        logger.error(f"Erreur mise à jour objectifs hebdo pour {user_id}: {e}")

    # Missions variété (jeux / méthodes / full odds) — indépendantes des objectifs aléatoires
    try:
        if method_key not in _system_skip:
            vbonuses = check_weekly_variety_missions(user_id, game, method_key, pokemon)
            if vbonuses:
                objective_bonuses = list(objective_bonuses) + list(vbonuses)
    except Exception as e:
        logger.error(f"Erreur missions variété hebdo pour {user_id}: {e}")

    # Mettre à jour la progression des objectifs mensuels
    try:
        monthly_bonuses = check_and_update_monthly_objectives(
            user_id, pokemon, game, method_key, total_points, is_first_of_day
        )
        objective_bonuses += monthly_bonuses
    except Exception as e:
        logger.error(f"Erreur mise à jour objectifs mensuels pour {user_id}: {e}")

    # Mettre à jour l'objectif hebdomadaire de guilde choisi par le leader
    try:
        if method_key not in _system_skip:
            guild_bonus = check_and_update_guilde_objective(
                user_id, pokemon, game, method_key, total_points, stored_type_pokemon
            )
            if guild_bonus:
                special_bonuses.append((
                    f"🏰 Objectif guilde : {guild_bonus['objective']['description']}",
                    guild_bonus['bonus']
                ))
    except Exception as e:
        logger.error(f"Erreur objectif guilde pour {user_id}: {e}")

    # Gain d'XP de guilde (progression permanente, indépendante de la saison)
    try:
        if method_key not in _system_skip:
            user_guilde = guilde_of_user(user_id)
            if user_guilde:
                old_level, new_level = add_guilde_xp(user_guilde[0], total_points)
                if old_level is not None and new_level is not None and new_level > old_level:
                    special_bonuses.append((
                        f"🎉 La guilde **{user_guilde[1]}** passe niveau {new_level} !",
                        0
                    ))
    except Exception as e:
        logger.error(f"Erreur gain XP guilde pour {user_id}: {e}")

    # Progression vers un indice de wanted mystère (tous les 5 shinys chassés pour ça)
    # Note : on NE met PAS ça dans special_bonuses car cette liste est affichée
    # publiquement — la révélation doit rester privée au joueur qui la débloque.
    add_shiny._last_mystery_reveals = []
    try:
        if for_mystery_wanted and method_key not in _system_skip:
            add_shiny._last_mystery_reveals = process_mystery_wanted_hunt(user_id)
    except Exception as e:
        logger.error(f"Erreur progression wanted mystère pour {user_id}: {e}")

    # Si le shiny correspond au type du challenge actif, rafraîchir le classement
    try:
        if method_key not in _system_skip:
            if stored_type_pokemon:
                _tc = get_active_monthly_type_challenge()
                if _tc and normalize_str(stored_type_pokemon) == normalize_str(_tc[3]):
                    asyncio.create_task(update_challenge_status_message())
    except Exception:
        pass

    # Bonus wanted personnel (+20 pts si le shiny correspond au wanted perso actif)
    try:
        if method_key not in _system_skip:
            _pw_bonus, _pw_desc = check_personal_wanted(user_id, pokemon)
            if _pw_bonus > 0:
                special_bonuses.append((_pw_desc, _pw_bonus))
    except Exception as e:
        logger.error(f"Erreur check_personal_wanted: {e}")

    return total_points, bonus_points, is_wanted, objective_bonuses, special_bonuses

def get_ladder():
    cursor.execute("""
    SELECT user_id,
           SUM(points) as total_points,
           (SELECT COUNT(*) FROM shiny_wanted_claimed WHERE shiny_wanted_claimed.user_id = shiny.user_id) as wanted_count,
           ((SELECT COUNT(*) FROM shiny_races WHERE winner_id = shiny.user_id) +
            (SELECT COUNT(*) FROM open_races WHERE winner_id = shiny.user_id AND awarded_points > 0)) as race_wins
    FROM shiny
    GROUP BY user_id
    ORDER BY total_points DESC
    """)
    return cursor.fetchall()


def get_game_names_for_keys(game_keys, include_english=True):
    """Retourne les noms de jeux enregistrables en base pour une liste de clés."""
    names = []
    for key in game_keys:
        if key not in GAMES:
            continue
        names.append(GAMES[key]['fr'])
        if include_english:
            names.append(GAMES[key]['en'])
    return list(dict.fromkeys(names))


def get_retro_full_odds_method_keys():
    """Méthodes Full Odds autorisées pour les jeux ajoutés en FO uniquement."""
    method_keys = []
    for game_key in RETRO_LADDER_FULL_ODDS_ONLY_GAME_KEYS:
        for method_key in METHODS_BY_GAME.get(game_key, {}):
            method_key_lower = str(method_key).lower()
            if method_key_lower.startswith('full_odds') and 'horde' not in method_key_lower:
                method_keys.append(method_key)
    return list(dict.fromkeys(method_keys))


def get_full_odds_ladder_eligibility(game_key, method_key, language="fr"):
    """Indique si un shiny compte dans le Classement Full Odds, avec raison bilingue."""
    is_fr = language == "fr" or language == "Français"
    method_key_lower = str(method_key or "").lower()

    if game_key in RETRO_LADDER_GAME_KEYS:
        reason = "jeu classique inclus entièrement" if is_fr else "classic game fully included"
        return True, reason

    if game_key in RETRO_LADDER_FULL_ODDS_ONLY_GAME_KEYS:
        if method_key in get_retro_full_odds_method_keys():
            reason = "jeu accepté en Full Odds strict" if is_fr else "game accepted in strict Full Odds"
            return True, reason
        if "horde" in method_key_lower:
            reason = "Full Odds Hordes est exclu" if is_fr else "Full Odds Hordes is excluded"
            return False, reason
        reason = "ce jeu ne compte ici qu'en Full Odds" if is_fr else "this game only counts here in Full Odds"
        return False, reason

    reason = "jeu non éligible à ce classement" if is_fr else "game not eligible for this leaderboard"
    return False, reason


def get_new_badges_since(user_id, badge_codes_before):
    """Retourne les badges obtenus depuis un snapshot de codes."""
    badges = get_user_badges(user_id)
    return [b for b in badges if b[0] not in badge_codes_before]


def build_smart_shiny_summary(
    *,
    language,
    game_key,
    method_key,
    grand_total,
    total_points,
    sp_total,
    obj_total,
    race_total,
    objective_bonuses,
    special_bonuses,
    is_wanted,
    bonus_points,
    rank_change_data,
    new_rank,
    new_badges,
    bounty_events,
    mystery_reveals,
    team_race_msg=None,
):
    """Construit le résumé intelligent affiché après un ajout de shiny."""
    is_fr = language == "Français" or language == "fr"
    fo_ok, fo_reason = get_full_odds_ladder_eligibility(game_key, method_key, language)
    lines = []

    if is_fr:
        lines.append(f"{'✅' if fo_ok else '❌'} **Classement Full Odds :** {'compte' if fo_ok else 'ne compte pas'} ({fo_reason})")
        if rank_change_data and rank_change_data.get('old_rank') and rank_change_data.get('new_rank'):
            gained = rank_change_data['old_rank'] - rank_change_data['new_rank']
            lines.append(f"🏆 **Ranked :** +{grand_total:.2f} pts au total, +{gained} place(s), rang **#{new_rank}**")
        else:
            rank_text = f", rang **#{new_rank}**" if new_rank else ""
            lines.append(f"🏆 **Ranked :** +{grand_total:.2f} pts au total{rank_text}")
        if is_wanted and bonus_points > 0:
            lines.append(f"🎯 **Wanted serveur :** validé (+{bonus_points:.2f} pts)")
        if obj_total > 0:
            lines.append(f"📅 **Objectifs :** {len(objective_bonuses)} récompense(s) débloquée(s) (+{obj_total:.2f} pts)")
        else:
            lines.append("📅 **Objectifs :** progression vérifiée")
        if sp_total > 0:
            lines.append(f"🎁 **Bonus spéciaux :** {len(special_bonuses)} bonus (+{sp_total:.2f} pts)")
        if race_total > 0:
            lines.append(f"🏁 **Races :** victoire/progression validée (+{race_total:.2f} pts)")
        elif team_race_msg:
            lines.append("⚔️ **Race équipe :** progression enregistrée")
        if bounty_events:
            completed = [b for b in bounty_events if b.get('completed')]
            if completed:
                lines.append(f"🤝 **Bounty :** complété (+{completed[0]['bonus_points']:.2f} pts aux participants)")
            else:
                b = bounty_events[0]
                lines.append(f"🤝 **Bounty :** progression {b['progress']}/{b['goal']}")
        if new_badges:
            badge_text = ", ".join(f"{emoji} {name}" for _code, emoji, name, _desc, _at in new_badges[:3])
            lines.append(f"🎖️ **Badge :** {badge_text}")
        if mystery_reveals:
            lines.append("🔍 **Wanted mystère :** nouvel indice envoyé en privé")
    else:
        lines.append(f"{'✅' if fo_ok else '❌'} **Full Odds Leaderboard:** {'counts' if fo_ok else 'does not count'} ({fo_reason})")
        if rank_change_data and rank_change_data.get('old_rank') and rank_change_data.get('new_rank'):
            gained = rank_change_data['old_rank'] - rank_change_data['new_rank']
            lines.append(f"🏆 **Ranked:** +{grand_total:.2f} total pts, +{gained} place(s), rank **#{new_rank}**")
        else:
            rank_text = f", rank **#{new_rank}**" if new_rank else ""
            lines.append(f"🏆 **Ranked:** +{grand_total:.2f} total pts{rank_text}")
        if is_wanted and bonus_points > 0:
            lines.append(f"🎯 **Server wanted:** completed (+{bonus_points:.2f} pts)")
        if obj_total > 0:
            lines.append(f"📅 **Objectives:** {len(objective_bonuses)} reward(s) unlocked (+{obj_total:.2f} pts)")
        else:
            lines.append("📅 **Objectives:** progress checked")
        if sp_total > 0:
            lines.append(f"🎁 **Special bonuses:** {len(special_bonuses)} bonus(es) (+{sp_total:.2f} pts)")
        if race_total > 0:
            lines.append(f"🏁 **Races:** win/progress confirmed (+{race_total:.2f} pts)")
        elif team_race_msg:
            lines.append("⚔️ **Team race:** progress recorded")
        if bounty_events:
            completed = [b for b in bounty_events if b.get('completed')]
            if completed:
                lines.append(f"🤝 **Bounty:** completed (+{completed[0]['bonus_points']:.2f} pts to participants)")
            else:
                b = bounty_events[0]
                lines.append(f"🤝 **Bounty:** progress {b['progress']}/{b['goal']}")
        if new_badges:
            badge_text = ", ".join(f"{emoji} {name}" for _code, emoji, name, _desc, _at in new_badges[:3])
            lines.append(f"🎖️ **Badge:** {badge_text}")
        if mystery_reveals:
            lines.append("🔍 **Mystery wanted:** new hint sent privately")

    return "\n".join(lines)[:1024]


def get_retro_ladder():
    """Classement séparé : uniquement les points de capture (pas de bonus) des
    shinys attrapés dans les jeux configurés pour le Classement Full Odds.

    Les jeux historiques sont inclus entièrement. Les jeux plus récents listés
    dans RETRO_LADDER_FULL_ODDS_ONLY_GAME_KEYS ne comptent qu'en Full Odds strict
    (hors Full Odds Hordes).
    """
    retro_game_names = get_game_names_for_keys(RETRO_LADDER_GAME_KEYS)
    retro_fo_game_names = get_game_names_for_keys(RETRO_LADDER_FULL_ODDS_ONLY_GAME_KEYS)
    retro_fo_methods = get_retro_full_odds_method_keys()
    if not retro_game_names and not (retro_fo_game_names and retro_fo_methods):
        return []

    placeholders_game = ",".join("?" for _ in retro_game_names) or "NULL"
    placeholders_fo_game = ",".join("?" for _ in retro_fo_game_names) or "NULL"
    placeholders_fo_method = ",".join("?" for _ in retro_fo_methods) or "NULL"
    placeholders_skip = ",".join("?" for _ in BONUS_METHODE_SENTINELS)
    cursor.execute(f"""
        SELECT user_id, SUM(points) as total_points
        FROM shiny
        WHERE (
            game IN ({placeholders_game})
            OR (game IN ({placeholders_fo_game}) AND methode IN ({placeholders_fo_method}))
        )
        AND methode NOT IN ({placeholders_skip})
        GROUP BY user_id
        ORDER BY total_points DESC
    """, (*retro_game_names, *retro_fo_game_names, *retro_fo_methods, *BONUS_METHODE_SENTINELS))
    return cursor.fetchall()

def get_user_shinys(user_id, page=1, per_page=5):
    """Récupère les shinys d'un utilisateur avec pagination"""
    offset = (page - 1) * per_page
    
    # Compte total des shinys
    cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id = ?", (user_id,))
    total_shinys = cursor.fetchone()[0]
    
    # Vérifier si la colonne created_at existe
    try:
        cursor.execute("SELECT created_at FROM shiny LIMIT 1")
        has_created_at = True
    except sqlite3.OperationalError:
        has_created_at = False
    
    # Récupère les shinys pour la page actuelle
    if has_created_at:
        cursor.execute("""
            SELECT rowid, pokemon, game, methode, odds, date, points, created_at, language
            FROM shiny 
            WHERE user_id = ? 
            ORDER BY created_at DESC 
            LIMIT ? OFFSET ?
        """, (user_id, per_page, offset))
    else:
        cursor.execute("""
            SELECT rowid, pokemon, game, methode, odds, date, points, date as created_at, language
            FROM shiny 
            WHERE user_id = ? 
            ORDER BY rowid DESC 
            LIMIT ? OFFSET ?
        """, (user_id, per_page, offset))
    
    shinys = cursor.fetchall()
    total_pages = math.ceil(total_shinys / per_page) if total_shinys > 0 else 1
    
    return shinys, total_shinys, total_pages

def get_user_stats(user_id):
    """Récupère les statistiques d'un utilisateur"""
    cursor.execute("""
        SELECT 
            COUNT(*) as total_shinys,
            SUM(points) as total_points,
            AVG(points) as avg_points,
            MAX(points) as best_shiny,
            MIN(date) as first_shiny_date,
            MAX(date) as last_shiny_date
        FROM shiny 
        WHERE user_id = ?
    """, (user_id,))
    
    stats = cursor.fetchone()
    
    # Méthode favorite
    cursor.execute("""
        SELECT methode, COUNT(*) as count
        FROM shiny 
        WHERE user_id = ? 
        GROUP BY methode 
        ORDER BY count DESC 
        LIMIT 1
    """, (user_id,))
    
    favorite_method = cursor.fetchone()
    
    # Pokémon le plus capturé
    cursor.execute("""
        SELECT pokemon, COUNT(*) as count
        FROM shiny 
        WHERE user_id = ? 
        GROUP BY pokemon 
        ORDER BY count DESC 
        LIMIT 1
    """, (user_id,))
    
    favorite_pokemon = cursor.fetchone()
    
    # Récupérer les streaks
    streak_data = get_user_streak(user_id)
    
    # Compteurs par période
    today_count = get_shiny_count_period(user_id, "day")
    week_count = get_shiny_count_period(user_id, "week")
    month_count = get_shiny_count_period(user_id, "month")
    
    return {
        'total_shinys': stats[0] if stats[0] else 0,
        'total_points': stats[1] if stats[1] else 0,
        'avg_points': stats[2] if stats[2] else 0,
        'best_shiny': stats[3] if stats[3] else 0,
        'first_shiny_date': stats[4],
        'last_shiny_date': stats[5],
        'favorite_method': favorite_method[0] if favorite_method else "Aucune",
        'favorite_pokemon': favorite_pokemon[0] if favorite_pokemon else "Aucun",
        'current_streak': streak_data['current_streak'],
        'best_streak': streak_data['best_streak'],
        'total_days_with_shiny': streak_data['total_days_with_shiny'],
        'today_count': today_count,
        'week_count': week_count,
        'month_count': month_count
    }

def get_user_rank(user_id):
    """Récupère le rang d'un utilisateur dans le classement"""
    ladder = get_ladder()
    for i, (uid, points, wanted_count, race_wins) in enumerate(ladder, 1):
        if uid == user_id:
            return i, points
    return None, 0

def get_rank_title_for_position(position):
    """Retourne le titre du rang pour une position donnée"""
    if position == 1:
        return "🥇 Shiny Hunter #1"
    elif position == 2:
        return "🥈 Shiny Hunter #2"
    elif position == 3:
        return "🥉 Shiny Hunter #3"
    elif 4 <= position <= 8:
        return "💜 Shiny Master"
    elif 9 <= position <= 14:
        return "💎 Shiny de Diamant"
    elif 15 <= position <= 20:
        return "💚 Shiny d'Émeraude"
    elif 21 <= position <= 29:
        return "🏆 Shiny de Platine"
    elif 30 <= position <= 39:
        return "✨ Shiny d'Or"
    elif 40 <= position <= 51:
        return "🌠 Shiny d'Argent"
    else:
        return "🌟 Shiny Novice"

RETRO_RANK_GROUPS = (
    (1, "Légende de la Ranked FO !", discord.Color.gold()),
    (3, "Élite de la Ranked FO !", discord.Color.from_rgb(192, 192, 192)),
    (8, "Maître de la Ranked FO !", discord.Color.purple()),
    (14, "Vétéran de la Ranked FO !", discord.Color.blue()),
    (20, "Expert de la Ranked FO !", discord.Color.from_rgb(0, 200, 80)),
    (29, "Confirmé de la Ranked FO !", discord.Color.from_rgb(0, 191, 255)),
    (39, "Shasseur de la Ranked FO !", discord.Color.gold()),
    (51, "Apprenti de la Ranked FO !", discord.Color.light_grey()),
    (999, "Recrue de la Ranked FO !", discord.Color.from_rgb(139, 69, 19)),
)

def get_retro_rank_title_for_position(position):
    """Retourne le titre du Classement Full Odds pour une position donnée."""
    for max_pos, title, _color in RETRO_RANK_GROUPS:
        if position <= max_pos:
            return title
    return RETRO_RANK_GROUPS[-1][1]

def check_rank_change(user_id, old_rank, old_points):
    """Vérifie si l'utilisateur a changé de rang/tier après l'ajout du shiny"""
    new_rank, new_points = get_user_rank(user_id)
    
    # Si l'utilisateur n'avait pas de rang avant ou n'a toujours pas de rang après
    if old_rank is None or new_rank is None:
        return None
    
    # On ne notifie que les montées de rang (rang plus petit = meilleur)
    if new_rank >= old_rank:
        return None
    
    # Vérifier les changements significatifs
    changes = []
    
    # Montée dans le top 3
    if old_rank > 3 and new_rank <= 3:
        changes.append("top3")
    # Passage à la 1ère place
    if old_rank > 1 and new_rank == 1:
        changes.append("first")
    # Passage à la 2ème place
    if old_rank > 2 and new_rank == 2:
        changes.append("second")
    # Passage à la 3ème place
    if old_rank > 3 and new_rank == 3:
        changes.append("third")
    
    # Changement de tier (catégorie de rôle)
    old_tier = get_tier_from_position(old_rank)
    new_tier = get_tier_from_position(new_rank)
    if old_tier != new_tier and old_tier is not None:
        changes.append("tier_change")
        changes.append(f"from_{old_tier}_to_{new_tier}")
    
    # Montée significative (plus de 5 places)
    if old_rank and new_rank and old_rank - new_rank >= 5:
        changes.append("significant_climb")
    
    if changes:
        return {
            'old_rank': old_rank,
            'new_rank': new_rank,
            'old_points': old_points,
            'new_points': new_points,
            'old_tier': old_tier,
            'new_tier': new_tier,
            'changes': changes
        }
    return None

def get_tier_from_position(position):
    """Retourne le tier (catégorie de rôle) pour une position donnée"""
    if position is None:
        return None
    if position == 1:
        return "hunter1"
    elif position == 2:
        return "hunter2"
    elif position == 3:
        return "hunter3"
    elif 4 <= position <= 8:
        return "master"
    elif 9 <= position <= 14:
        return "diamant"
    elif 15 <= position <= 20:
        return "emeraude"
    elif 21 <= position <= 29:
        return "platine"
    elif 30 <= position <= 39:
        return "or"
    elif 40 <= position <= 51:
        return "argent"
    else:
        return "novice"


