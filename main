@bot.tree.command(
    name="admin_challenge_creer",
    description="[ADMIN] Créer le challenge mensuel surprise",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    description="Description visible par les joueurs",
    target_type="Type de cible",
    target_value="Valeur cible (lettre, nom de jeu, type Pokémon, nom de Pokémon...)",
    bonus_points="Points bonus pour chaque gagnant",
    max_winners="Nombre max de gagnants (défaut: 5)"
)
@app_commands.choices(target_type=[
    app_commands.Choice(name="Type Pokémon (ex: Feu)", value="pokemon_type"),
    app_commands.Choice(name="Jeu précis", value="game"),
    app_commands.Choice(name="Pokémon précis", value="pokemon"),
    app_commands.Choice(name="Lettre du nom", value="letter"),
    app_commands.Choice(name="Starter", value="starter"),
    app_commands.Choice(name="Légendaire", value="legendary"),
])
async def admin_challenge_creer(
    interaction: discord.Interaction,
    description: str,
    target_type: str,
    bonus_points: float,
    target_value: str = None,
    max_winners: int = 5
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    month_start = get_current_month_start()

    cursor.execute("""
        INSERT OR REPLACE INTO monthly_challenge
        (month_start, description, target_type, target_value, bonus_points, max_winners, is_active, created_by)
        VALUES (?, ?, ?, ?, ?, ?, 1, ?)
    """, (month_start, description, target_type, target_value, bonus_points, max_winners, str(interaction.user.id)))
    conn.commit()

    # Annoncer dans le salon classement
    try:
