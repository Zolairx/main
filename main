    await interaction.response.send_modal(modal)


@bot.tree.command(
    name="race_equipe_list",
    description="Voir les races en équipe actives",
    guild=discord.Object(id=GUILD_ID)
)
async def race_equipe_list(interaction: discord.Interaction):
    await interaction.response.defer(ephemeral=True)
    races = get_active_team_races()
    if not races:
        await interaction.followup.send("Aucune race en équipe active pour le moment.", ephemeral=True)
        return

    guild = interaction.guild
    embed = discord.Embed(title="⚔️ Races en Équipe Actives", color=discord.Color.orange())

    for r in races[:10]:
        rid, pokemon, game, bonus, fmt, tsize, s1, s2, creator_id, created_at = r
        members = get_team_race_members(rid)
        def name(uid):
            m = guild.get_member(int(uid)) if guild else None
            return m.display_name if m else uid
        t1 = " & ".join(name(m[0]) for m in members if m[1] == 1)
        t2 = " & ".join(name(m[0]) for m in members if m[1] == 2)
        status_row = get_team_race(rid)
        status_label = "⏳ En attente" if status_row['status'] == 'pending' else "🏁 Active"
        embed.add_field(
            name=f"Race #{rid} — {pokemon} ({fmt}) {status_label}",
            value=f"🔵 Équipe 1 : {t1 or '?'} **[{s1}]**\n🔴 Équipe 2 : {t2 or '?'} **[{s2}]**\n💰 Bonus/Malus : {bonus} pts | 🎮 {game or 'Libre'}",
            inline=False
        )
    embed.set_footer(text="Utilisez /race_equipe_cancel pour annuler une race (admin ou créateur)")
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="race_equipe_score",
    description="Voir le score en direct d'une race en équipe",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(race_id="ID de la race (visible avec /race_equipe_list)")
async def race_equipe_score(interaction: discord.Interaction, race_id: int):
    await interaction.response.defer(ephemeral=True)
    race = get_team_race(race_id)
    if not race:
        await interaction.followup.send("❌ Race introuvable.", ephemeral=True)
        return
    guild = interaction.guild
    members = get_team_race_members(race_id)
    def name(uid):
        m = guild.get_member(int(uid)) if guild else None
        return m.display_name if m else uid
    t1 = " & ".join(name(m[0]) for m in members if m[1] == 1)
    t2 = " & ".join(name(m[0]) for m in members if m[1] == 2)
    fmt = race['format']
    target = {'BO1':1,'BO3':2,'BO5':3}.get(fmt,1)
    embed = discord.Embed(
        title=f"📊 Score Race Équipe #{race_id}",
        description=f"🎯 **{race['pokemon_name']}** | Format : **{fmt}** | Premier à **{target}** point(s)",
        color=discord.Color.blue()
    )
    embed.add_field(name=f"🔵 Équipe 1 : {t1}", value=f"**{race['score_team1']}** point(s)", inline=True)
    embed.add_field(name=f"🔴 Équipe 2 : {t2}", value=f"**{race['score_team2']}** point(s)", inline=True)
    status_map = {'pending':'⏳ En attente','active':'🏁 En cours','finished':'✅ Terminée','cancelled':'❌ Annulée'}
    embed.add_field(name="Statut", value=status_map.get(race['status'], race['status']), inline=False)
    if race['winner_team']:
        winner_names = " & ".join(name(m[0]) for m in members if m[1] == race['winner_team'])
        embed.add_field(name="🏆 Vainqueur", value=winner_names, inline=False)
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="race_equipe_cancel",
    description="Annuler une race en équipe (créateur ou admin)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(race_id="ID de la race à annuler")
async def race_equipe_cancel(interaction: discord.Interaction, race_id: int):
    await interaction.response.defer(ephemeral=True)
    race = get_team_race(race_id)
    if not race:
        await interaction.followup.send("❌ Race introuvable.", ephemeral=True)
        return
    is_admin = interaction.user.guild_permissions.administrator
    is_creator = race['created_by'] == str(interaction.user.id)
    if not is_admin and not is_creator:
        await interaction.followup.send("❌ Seul le créateur ou un admin peut annuler cette race.", ephemeral=True)
        return
    if race['status'] not in ('pending', 'active'):
        await interaction.followup.send("⚠️ Cette race n'est pas active.", ephemeral=True)
        return
    cursor.execute("UPDATE team_races SET status='cancelled', ended_at=datetime('now') WHERE id=?", (race_id,))
    conn.commit()
    pending_team_races.pop(race_id, None)
    await interaction.followup.send(f"✅ Race équipe #{race_id} annulée.", ephemeral=True)


