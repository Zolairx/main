@bot.tree.command(
    name="admin_event_lancer",
    description="[ADMIN] Lancer un événement de points doublés (ou ×N)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    multiplicateur="Multiplicateur de points (ex: 2 pour ×2)",
    jeu="Jeu spécifique (laisser vide = tous les jeux)",
    description="Description de l'événement",
    duree_heures="Durée en heures (laisser vide = pas de fin automatique)"
)
async def admin_event_lancer(
    interaction: discord.Interaction,
    multiplicateur: float,
    description: str,
    jeu: str = None,
    duree_heures: float = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)

    # Désactiver l'événement précédent s'il y en a un
    cursor.execute("UPDATE active_events SET is_active=0 WHERE is_active=1")

    event_type = 'specific_game' if jeu else 'all_games'
    ends_at = None
    if duree_heures:
        ends_at = (datetime.now() + timedelta(hours=duree_heures)).strftime("%Y-%m-%d %H:%M:%S")

    cursor.execute("""
        INSERT INTO active_events (event_type, multiplier, target_game, description, ends_at, created_by)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (event_type, multiplicateur, jeu, description, ends_at, str(interaction.user.id)))
    conn.commit()

    # Annoncer dans le salon classement
    try:
        channel = bot.get_channel(SALON_CLASSEMENT_ID)
        if channel:
            jeu_txt = f" sur **{jeu}**" if jeu else " sur **tous les jeux**"
            duration_txt = f"\n⏰ Fin : <t:{int((datetime.now() + timedelta(hours=duree_heures)).timestamp())}:R>" if duree_heures else ""
            embed = discord.Embed(
                title=f"🎉 ÉVÉNEMENT : Points ×{multiplicateur} !",
                description=(
                    f"*{description}*\n\n"
                    f"Tous les shinys ajoutés{jeu_txt} rapportent **×{multiplicateur}** points !{duration_txt}\n\n"
                    f"🇫🇷 Utilisez `/shiny_ajout` pour en profiter !\n"
                    f"🇬🇧 Use `/add_myshiny` to take advantage!"
                ),
                color=discord.Color.from_rgb(255, 165, 0),
                timestamp=datetime.now()
            )
            embed.set_footer(text="ShinyBot · Événement Spécial")
            await channel.send(embed=embed)
    except Exception as e:
        logger.error(f"Erreur annonce événement: {e}")

    jeu_label = f" sur {jeu}" if jeu else " (tous jeux)"
    await interaction.followup.send(
        f"✅ Événement **×{multiplicateur}**{jeu_label} lancé ! *{description}*",
        ephemeral=True
    )


