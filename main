def guilde_get_by_name(nom):
    cursor.execute("SELECT * FROM shinyhunter_guildes WHERE nom=? COLLATE NOCASE", (nom,))
    return cursor.fetchone()  # (id, nom, description, owner_id, emoji, created_at)

def guilde_get_by_id(guilde_id):
    cursor.execute("SELECT * FROM shinyhunter_guildes WHERE id=?", (guilde_id,))
    return cursor.fetchone()

def guilde_of_user(user_id):
    """Retourne la guilde (row complète) dont user_id est membre, ou None."""
    cursor.execute("""
        SELECT g.* FROM shinyhunter_guildes g
        JOIN shinyhunter_guilde_membres m ON m.guilde_id = g.id
        WHERE m.user_id = ?
    """, (str(user_id),))
    return cursor.fetchone()

def guilde_get_members(guilde_id):
    cursor.execute("""
        SELECT user_id, joined_at FROM shinyhunter_guilde_membres
        WHERE guilde_id = ? ORDER BY joined_at ASC
    """, (guilde_id,))
    return cursor.fetchall()

def guilde_get_points(guilde_id):
    """Somme des points ranked de tous les membres de la guilde."""
    cursor.execute("""
        SELECT COALESCE(SUM(s.points), 0)
        FROM shiny s
        WHERE s.user_id IN (
            SELECT user_id FROM shinyhunter_guilde_membres WHERE guilde_id = ?
        )
    """, (guilde_id,))
    return float(cursor.fetchone()[0] or 0)

def guilde_leaderboard():
    """Retourne la liste des guildes triées par points décroissants."""
    cursor.execute("""
        SELECT g.id, g.nom, g.emoji, g.owner_id,
               (SELECT COUNT(*) FROM shinyhunter_guilde_membres WHERE guilde_id = g.id) as nb_membres,
               COALESCE((
                   SELECT SUM(s.points) FROM shiny s
                   WHERE s.user_id IN (
                       SELECT user_id FROM shinyhunter_guilde_membres WHERE guilde_id = g.id
                   )
               ), 0) as total_pts,
               g.logo_url,
               g.xp
        FROM shinyhunter_guildes g
        ORDER BY total_pts DESC
    """)
    return cursor.fetchall()


# ── Système de niveaux de guilde (progression permanente, ne se réinitialise pas avec la saison) ──
# Chaque palier : (niveau, xp_requis, titre, couleur, multiplicateur bonus objectif guilde)
GUILDE_LEVELS = [
    (1, 0,      "Guilde Novice",        discord.Color.light_grey(),           1.00),
    (2, 500,    "Guilde Débutante",     discord.Color.from_rgb(205, 127, 50), 1.00),
    (3, 1500,   "Guilde Confirmée",     discord.Color.blue(),                 1.05),
    (4, 3500,   "Guilde Expérimentée",  discord.Color.from_rgb(0, 200, 80),   1.05),
    (5, 7000,   "Guilde Vétérante",     discord.Color.from_rgb(0, 191, 255),  1.10),
    (6, 13000,  "Guilde Élite",         discord.Color.purple(),               1.10),
    (7, 22000,  "Guilde Légendaire",    discord.Color.gold(),                 1.15),
    (8, 35000,  "Guilde Mythique",      discord.Color.from_rgb(255, 0, 128),  1.20),
]


def get_guilde_level_info(xp):
    """Calcule le niveau actuel d'une guilde à partir de son XP cumulée.
    Retourne un dict avec le niveau, le titre, la couleur, le multiplicateur de
    bonus, et la progression vers le niveau suivant (ou None si niveau max)."""
    xp = xp or 0
    current = GUILDE_LEVELS[0]
    next_level = None
    for entry in GUILDE_LEVELS:
        if xp >= entry[1]:
            current = entry
        else:
            next_level = entry
            break

    level, threshold, title, color, multiplier = current
    info = {
        'level': level,
        'title': title,
        'color': color,
        'bonus_multiplier': multiplier,
        'xp': xp,
        'xp_threshold': threshold,
    }
    if next_level:
        next_threshold = next_level[1]
        span = next_threshold - threshold
        progress = (xp - threshold) / span if span > 0 else 1.0
        info['next_level'] = next_level[0]
        info['next_title'] = next_level[2]
        info['xp_to_next'] = next_threshold - xp
        info['progress_ratio'] = max(0.0, min(1.0, progress))
    else:
        info['next_level'] = None
        info['next_title'] = None
        info['xp_to_next'] = 0
        info['progress_ratio'] = 1.0
    return info


def add_guilde_xp(guilde_id, amount):
    """Ajoute de l'XP à une guilde (progression permanente, indépendante du
    classement saisonnier). Retourne (ancien_niveau, nouveau_niveau)."""
    if not guilde_id or amount is None or amount <= 0:
        return None, None
    cursor.execute("SELECT xp FROM shinyhunter_guildes WHERE id=?", (guilde_id,))
    row = cursor.fetchone()
    if not row:
        return None, None
    old_xp = row[0] or 0
    old_level = get_guilde_level_info(old_xp)['level']
    new_xp = old_xp + amount
    cursor.execute("UPDATE shinyhunter_guildes SET xp=? WHERE id=?", (new_xp, guilde_id))
    conn.commit()
    new_level = get_guilde_level_info(new_xp)['level']
    return old_level, new_level


