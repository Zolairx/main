CREATE TABLE IF NOT EXISTS shiny (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id TEXT,
    pokemon TEXT,
    game TEXT,
    methode TEXT,
    odds TEXT,
    date TEXT,
    points REAL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    language TEXT DEFAULT 'fr',
    console_count INTEGER DEFAULT 1,
    hunt_counter INTEGER DEFAULT 0
)
""")

# Vérifier et ajouter les colonnes manquantes
try:
    cursor.execute("SELECT created_at FROM shiny LIMIT 1")
except sqlite3.OperationalError:
    cursor.execute("ALTER TABLE shiny ADD COLUMN created_at TIMESTAMP")
    cursor.execute("UPDATE shiny SET created_at = datetime('now') WHERE created_at IS NULL")
    print("Colonne created_at ajoutée à la table shiny")

try:
    cursor.execute("SELECT game FROM shiny LIMIT 1")
except sqlite3.OperationalError:
    cursor.execute("ALTER TABLE shiny ADD COLUMN game TEXT")
    cursor.execute("UPDATE shiny SET game = 'Non spécifié' WHERE game IS NULL")
    print("Colonne game ajoutée à la table shiny")

try:
    cursor.execute("SELECT language FROM shiny LIMIT 1")
except sqlite3.OperationalError:
    cursor.execute("ALTER TABLE shiny ADD COLUMN language TEXT DEFAULT 'fr'")
    cursor.execute("UPDATE shiny SET language = 'fr' WHERE language IS NULL")
    print("Colonne language ajoutée à la table shiny")

try:
    cursor.execute("SELECT console_count FROM shiny LIMIT 1")
except sqlite3.OperationalError:
    cursor.execute("ALTER TABLE shiny ADD COLUMN console_count INTEGER DEFAULT 1")
    cursor.execute("UPDATE shiny SET console_count = 1 WHERE console_count IS NULL")
    print("Colonne console_count ajoutée à la table shiny")

try:
    cursor.execute("SELECT hunt_counter FROM shiny LIMIT 1")
except sqlite3.OperationalError:
    cursor.execute("ALTER TABLE shiny ADD COLUMN hunt_counter INTEGER DEFAULT 0")
    cursor.execute("UPDATE shiny SET hunt_counter = 0 WHERE hunt_counter IS NULL")
    print("Colonne hunt_counter ajoutée à la table shiny")

try:
    cursor.execute("SELECT hunt_type FROM shiny LIMIT 1")
except sqlite3.OperationalError:
