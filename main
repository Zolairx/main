                description=f"**Membre / Member:** {self.target_member.mention}\n\n{'Choisissez le jeu :' if self.language == 'Français' else 'Choose the game:'}",
                color=discord.Color.gold()
            )

            new_view = AdminGameSelectView(self.language, self.target_member, hunt_type)
            await interaction.response.edit_message(embed=embed, view=new_view)

        await discord_retry_wrapper(_respond, context="Admin Hunt Type Select")

