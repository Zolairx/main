# Missions « variété » hebdo (indépendantes du choix d’objectifs aléatoires)
VARIETY_COUNT_EXCLUDE = (
    'participation_bonus', 'weekly_objective', 'monthly_objective',
    'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus',
    'admin_adjustment', 'bounty_bonus', 'season_carryover',
    'monday_first_bonus', 'new_player_bonus', 'challenge_bonus', 'type_challenge_bonus',
)
# (mission_key, kind, min_count, bonus, description) — kind in 'games', 'methods', 'full_odds'
WEEKLY_VARIETY_MISSIONS = [
    ('variety_games_2', 'games', 2, 8.0, '2 jeux différents cette semaine'),
    ('variety_games_3', 'games', 3, 12.0, '3 jeux différents cette semaine'),
    ('variety_games_4', 'games', 4, 16.0, '4 jeux différents cette semaine'),
    ('variety_methods_2', 'methods', 2, 10.0, '2 méthodes différentes cette semaine'),
    ('variety_methods_3', 'methods', 3, 15.0, '3 méthodes différentes cette semaine'),
    ('variety_methods_4', 'methods', 4, 20.0, '4 méthodes différentes cette semaine'),
    ('variety_full_odds_1', 'full_odds', 1, 10.0, '1 shiny Full Odds (barème) cette semaine'),
]
_FULL_ODDS_METHOD_KEYS = None  # rempli paresseusement

def get_full_odds_method_keys():
    global _FULL_ODDS_METHOD_KEYS
    if _FULL_ODDS_METHOD_KEYS is None:
        s = set()
        for gk, methods in METHODS_BY_GAME.items():
            if gk == 'dc_event':
                continue
            for mk in methods.keys():
                if 'full_odds' in str(mk).lower():
                    s.add(mk)
        _FULL_ODDS_METHOD_KEYS = frozenset(s)
    return _FULL_ODDS_METHOD_KEYS

def get_weekly_variety_stats(user_id, week_start):
    """Compte jeux / méthodes distincts (hors bonus système) + full odds sur la semaine (lundi →)."""
    ex = VARIETY_COUNT_EXCLUDE
    ph = ','.join('?' * len(ex))
    dc_name = GAMES['dc_event']['fr']
    cursor.execute(f"""
        SELECT COUNT(DISTINCT game) FROM shiny
        WHERE user_id=?
        AND date(created_at) >= date(?)
        AND game IS NOT NULL AND TRIM(game) != ''
        AND (LOWER(game) != LOWER(?))
        AND methode NOT IN ({ph})
    """, (str(user_id), week_start, dc_name, *ex))
    n_games = int(cursor.fetchone()[0] or 0)
    cursor.execute(f"""
        SELECT COUNT(DISTINCT methode) FROM shiny
        WHERE user_id=?
        AND date(created_at) >= date(?)
        AND methode IS NOT NULL AND TRIM(methode) != ''
        AND methode NOT IN ({ph})
    """, (str(user_id), week_start, *ex))
    n_methods = int(cursor.fetchone()[0] or 0)
    fo = get_full_odds_method_keys()
    if not fo:
        has_fo = False
    else:
        fph = ','.join('?' * len(fo))
        cursor.execute(f"""
            SELECT 1 FROM shiny
            WHERE user_id=?
            AND date(created_at) >= date(?)
            AND methode IN ({fph})
            AND methode NOT IN ({ph})
            LIMIT 1
        """, (str(user_id), week_start, *fo, *ex))
        has_fo = cursor.fetchone() is not None
    return n_games, n_methods, has_fo

def is_variety_mission_claimed(user_id, week_start, mission_key):
    cursor.execute(
        "SELECT 1 FROM weekly_variety_claims WHERE user_id=? AND week_start=? AND mission_key=?",
        (str(user_id), week_start, mission_key)
    )
    return cursor.fetchone() is not None

def claim_variety_mission(user_id, week_start, mission_key, bonus, description):
    if is_variety_mission_claimed(user_id, week_start, mission_key):
        return False
    cursor.execute(
        "INSERT OR IGNORE INTO weekly_variety_claims (user_id, week_start, mission_key) VALUES (?,?,?)",
        (str(user_id), week_start, mission_key)
    )
    if cursor.rowcount == 0:
        return False
    short = f'[Variete: {mission_key[:25]}]'[:80]
    cursor.execute(
        "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language) VALUES (?, ?, '', 'weekly_objective', date('now'), ?, datetime('now'), 'fr')",
        (str(user_id), short, float(bonus))
    )
    conn.commit()
    return True

def check_weekly_variety_missions(user_id, game, method_key):
    """Retourne [(description, bonus), ...] pour les missions variété validées sur cet ajout."""
    out = []
    skip = {'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus',
            'weekly_objective', 'monthly_objective', 'admin_adjustment', 'bounty_bonus',
            'participation_bonus', 'monday_first_bonus', 'new_player_bonus',
            'challenge_bonus', 'type_challenge_bonus', 'season_carryover'}
    if method_key in skip or method_key in VARIETY_COUNT_EXCLUDE:
        return out
    if game and normalize_str(game) == normalize_str(GAMES['dc_event']['fr']):
        return out
    week_start = get_current_week_start()
    n_games, n_methods, has_fo = get_weekly_variety_stats(user_id, week_start)
    for mkey, kind, need, bonus, desc in WEEKLY_VARIETY_MISSIONS:
        if is_variety_mission_claimed(user_id, week_start, mkey):
            continue
        if kind == 'games' and n_games < need:
            continue
        if kind == 'methods' and n_methods < need:
            continue
        if kind == 'full_odds' and not has_fo:
            continue
        if claim_variety_mission(user_id, week_start, mkey, bonus, desc):
            out.append((desc, float(bonus)))
    return out

class LanguageEnum(enum.Enum):
    French = "Français"
    English = "English"

def get_game_choices(language):
    """Retourne les choix de jeux selon la langue"""
    choices = []
    for game_key, translations in GAMES.items():
        name = translations["fr"] if language == "Français" else translations["en"]
        choices.append(app_commands.Choice(name=name, value=game_key))
    return choices

def get_method_choices(game_key, language):
    """Retourne les choix de méthodes pour un jeu donné dans la langue spécifiée"""
    if game_key not in METHODS_BY_GAME:
        return []
    
    choices = []
    lang_code = "fr" if language == "Français" else "en"
    
    for method_key, method_data in METHODS_BY_GAME[game_key].items():
        method_name = method_data[lang_code]
        points = method_data["points"]
        choices.append(app_commands.Choice(name=f"{method_name} ({points} pts)", value=method_key))
    return choices

def get_method_name(game_key, method_key, language):
    """Récupère le nom traduit d'une méthode"""
    if game_key not in METHODS_BY_GAME or method_key not in METHODS_BY_GAME[game_key]:
        return method_key
    
    lang_code = "fr" if language == "Français" else "en"
    return METHODS_BY_GAME[game_key][method_key][lang_code]

def calculate_console_multiplier(console_count, hunt_type="emulators"):
    """Calcule le multiplicateur selon le nombre de consoles/émulateurs et le type de chasse"""
    if hunt_type in ["emulators", "console_mods"]:
        if console_count == 1:
            return 1.0
        elif console_count == 2:
            return 0.95
        elif console_count == 3:
            return 0.9
        elif console_count == 4:
            return 0.85
        elif console_count == 5:
            return 0.75
        elif console_count == 6:
            return 0.65
        elif console_count == 7:
            return 0.55
        elif console_count == 8:
            return 0.45
        elif console_count == 9:
            return 0.35
        elif console_count == 10:
            return 0.25
        else:  # 11+
            return 0.15
    else:  # consoles
        if console_count == 1:
            return 1.0
        elif console_count == 2:
            return 1.0
        elif console_count == 3:
            return 0.98
        elif console_count == 4:
            return 0.95
        elif console_count == 5:
            return 0.92
        elif console_count == 6:
            return 0.9
        elif console_count == 7:
            return 0.85
        elif console_count == 8:
            return 0.8
        elif console_count == 9:
            return 0.75
        elif console_count == 10:
            return 0.7
        elif console_count == 11:
            return 0.65
        else:  # 12+
            return 0.6

def calculate_points(game_key, method_key, console_count=1, hunt_type="emulators"):
    """Calcule les points selon le jeu, la méthode, le nombre de consoles et le type"""
    if game_key not in METHODS_BY_GAME or method_key not in METHODS_BY_GAME[game_key]:
        return 0

    base_points = METHODS_BY_GAME[game_key][method_key]["points"]
    multiplier = calculate_console_multiplier(console_count, hunt_type)
    points = base_points * multiplier
    return points

def check_duplicate_shiny_za(user_id, pokemon):
    """Vérifie si un shiny est un doublon pour Z-A pendant la saison actuelle"""
    cursor.execute(
        "SELECT COUNT(*) FROM shiny WHERE user_id = ? AND pokemon = ? AND game LIKE '%Z-A%'",
        (user_id, pokemon)
    )
    count = cursor.fetchone()[0]
    return count > 0

def get_user_streak(user_id):
    """Récupère les informations de streak d'un utilisateur"""
    cursor.execute("""
        SELECT current_streak, best_streak, last_shiny_date, streak_start_date, total_days_with_shiny
        FROM user_streaks
        WHERE user_id = ?
    """, (user_id,))
    result = cursor.fetchone()
    
    if result:
        return {
            'current_streak': result[0] or 0,
            'best_streak': result[1] or 0,
            'last_shiny_date': result[2],
            'streak_start_date': result[3],
            'total_days_with_shiny': result[4] or 0
        }
    else:
        # Initialiser l'utilisateur dans la table streaks
        cursor.execute("""
            INSERT INTO user_streaks (user_id, current_streak, best_streak, total_days_with_shiny)
            VALUES (?, 0, 0, 0)
        """, (user_id,))
        conn.commit()
        return {
            'current_streak': 0,
            'best_streak': 0,
            'last_shiny_date': None,
            'streak_start_date': None,
            'total_days_with_shiny': 0
        }

def update_user_streak(user_id, shiny_date):
    """Met à jour le streak d'un utilisateur après l'ajout d'un shiny"""
    today = datetime.now().strftime("%Y-%m-%d")
    streak_data = get_user_streak(user_id)
    
    # Vérifier si l'utilisateur a déjà ajouté un shiny aujourd'hui
    # On compte tous les shinys d'aujourd'hui (incluant celui qu'on vient d'ajouter)
    # car la fonction est appelée APRÈS l'insertion
    cursor.execute("""
        SELECT COUNT(*) FROM shiny 
        WHERE user_id = ? 
        AND DATE(created_at) = DATE('now')
    """, (user_id,))
    count_today = cursor.fetchone()[0]
    # Si c'est le 2ème shiny ou plus aujourd'hui, on ne met pas à jour le streak
    already_today = count_today > 1
    
    current_streak = streak_data['current_streak']
    best_streak = streak_data['best_streak']
    last_shiny_date = streak_data['last_shiny_date']
    streak_start_date = streak_data['streak_start_date']
    total_days = streak_data['total_days_with_shiny']
    
    # Si c'est le premier shiny aujourd'hui
    if not already_today:
        if last_shiny_date:
            last_date = datetime.strptime(last_shiny_date, "%Y-%m-%d")
            today_date = datetime.strptime(today, "%Y-%m-%d")
            days_diff = (today_date - last_date).days
            
            if days_diff == 1:
                # Streak continue
                current_streak += 1
                if streak_start_date is None:
                    streak_start_date = last_shiny_date
            elif days_diff > 1:
                # Streak cassé, on recommence
                current_streak = 1
                streak_start_date = today
            else:
                # Même jour (ne devrait pas arriver avec la vérification ci-dessus)
                pass
        else:
            # Premier shiny jamais ajouté
            current_streak = 1
            streak_start_date = today
        
        # Mettre à jour le meilleur streak
        if current_streak > best_streak:
            best_streak = current_streak
        
        # Augmenter le total de jours avec shiny
        total_days += 1
    
    # Mettre à jour dans la base de données
    cursor.execute("""
        INSERT INTO user_streaks (user_id, current_streak, best_streak, last_shiny_date, streak_start_date, total_days_with_shiny, updated_at)
        VALUES (?, ?, ?, ?, ?, ?, datetime('now'))
        ON CONFLICT(user_id) DO UPDATE SET
            current_streak = excluded.current_streak,
            best_streak = excluded.best_streak,
            last_shiny_date = excluded.last_shiny_date,
            streak_start_date = excluded.streak_start_date,
            total_days_with_shiny = excluded.total_days_with_shiny,
            updated_at = datetime('now')
    """, (user_id, current_streak, best_streak, today, streak_start_date, total_days))
    conn.commit()
    
    return current_streak

def get_shiny_count_period(user_id, period="day"):
    """Récupère le nombre de shinys sur une période donnée"""
    if period == "day":
        cursor.execute("""
            SELECT COUNT(*) FROM shiny 
            WHERE user_id = ? 
            AND DATE(created_at) = DATE('now')
        """, (user_id,))
    elif period == "week":
        cursor.execute("""
            SELECT COUNT(*) FROM shiny 
            WHERE user_id = ? 
            AND DATE(created_at) >= DATE('now', '-7 days')
        """, (user_id,))
    elif period == "month":
        cursor.execute("""
            SELECT COUNT(*) FROM shiny 
            WHERE user_id = ? 
            AND DATE(created_at) >= DATE('now', 'start of month')
        """, (user_id,))
    else:
        return 0
    
    result = cursor.fetchone()
    return result[0] if result else 0

def get_current_wanted():
    """Récupère le dernier Pokémon wanted (pour compatibilité)"""
    cursor.execute("""
        SELECT id, pokemon_name, bonus_points, decay_percent, game 
        FROM shiny_wanted 
        WHERE is_active = 1 
        ORDER BY updated_at DESC 
        LIMIT 1
    """)
    result = cursor.fetchone()
    if result:
        return {
            'id': result[0],
            'pokemon_name': result[1],
            'bonus_points': result[2],
            'decay_percent': result[3] if result[3] is not None else 100.0,
            'game': result[4]
        }
    return None

# ════════════════════════════════════════════════════════════════
# ══  SYSTÈME DE BADGES                                         ══
# ════════════════════════════════════════════════════════════════

def get_user_badges(user_id):
    cursor.execute("""
        SELECT bd.code, bd.emoji, bd.name, bd.description, ub.awarded_at
        FROM user_badges ub
        JOIN badges_definitions bd ON ub.badge_code = bd.code
        WHERE ub.user_id = ?
        ORDER BY ub.awarded_at ASC
    """, (str(user_id),))
    return cursor.fetchall()

def award_badge(user_id, badge_code, awarded_by=None):
    """Attribue un badge à un utilisateur. Retourne True si nouveau badge."""
    try:
        cursor.execute("""
            INSERT OR IGNORE INTO user_badges (user_id, badge_code, awarded_by)
            VALUES (?, ?, ?)
        """, (str(user_id), badge_code, awarded_by))
        conn.commit()
        return cursor.rowcount > 0
    except Exception:
        return False

def revoke_badge(user_id, badge_code):
    cursor.execute("DELETE FROM user_badges WHERE user_id=? AND badge_code=?", (str(user_id), badge_code))
    conn.commit()
    return cursor.rowcount > 0

def check_and_award_badges(user_id):
    """Vérifie et attribue automatiquement tous les badges mérités. Retourne liste des nouveaux badges."""
    new_badges = []
    uid = str(user_id)

    # Compteurs
    cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id=?", (uid,))
    shiny_count = cursor.fetchone()[0] or 0

    cursor.execute("SELECT COUNT(*) FROM shiny_wanted_claimed WHERE user_id=?", (uid,))
    wanted_count = cursor.fetchone()[0] or 0

    cursor.execute("SELECT COUNT(*) FROM shiny_races WHERE winner_id=?", (uid,))
    race_wins = cursor.fetchone()[0] or 0

    streak_data = get_user_streak(uid)
    best_streak = streak_data.get('best_streak', 0)

    cursor.execute("SELECT COUNT(*) FROM season_archives WHERE user_id=?", (uid,))
    seasons_played = cursor.fetchone()[0] or 0

    cursor.execute("SELECT COUNT(*) FROM season_archives WHERE user_id=? AND rank<=3", (uid,))
    top3_seasons = cursor.fetchone()[0] or 0

    checks = [
        ("first_shiny",   shiny_count >= 1),
        ("shiny_10",      shiny_count >= 10),
        ("shiny_50",      shiny_count >= 50),
        ("shiny_100",     shiny_count >= 100),
        ("streak_7",      best_streak >= 7),
        ("streak_30",     best_streak >= 30),
        ("wanted_5",      wanted_count >= 5),
        ("race_5",        race_wins >= 5),
        ("top3",          top3_seasons >= 1),
        ("season_finish", seasons_played >= 1),
    ]

    for code, condition in checks:
        if condition:
            if award_badge(uid, code):
                cursor.execute("SELECT emoji, name FROM badges_definitions WHERE code=?", (code,))
                row = cursor.fetchone()
                if row:
                    new_badges.append((row[0], row[1]))

    return new_badges


# ════════════════════════════════════════════════════════════════
# ══  BOUNTY COLLABORATIF                                       ══
# ════════════════════════════════════════════════════════════════

def create_collab_bounty(pokemon_name, goal, bonus_points, game=None, description=None, created_by=None):
    cursor.execute("""
        INSERT INTO collab_bounties (pokemon_name, goal, bonus_points, game, description, created_by)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (pokemon_name, goal, bonus_points, game, description, created_by))
    conn.commit()
    return cursor.lastrowid

def get_active_collab_bounties():
    cursor.execute("""
        SELECT id, pokemon_name, goal, bonus_points, game, description, created_at
        FROM collab_bounties WHERE status='active'
        ORDER BY created_at DESC
    """)
    rows = cursor.fetchall()
    return [{'id':r[0],'pokemon_name':r[1],'goal':r[2],'bonus_points':r[3],
             'game':r[4],'description':r[5],'created_at':r[6]} for r in rows]

def get_bounty_progress(bounty_id):
    cursor.execute("SELECT COUNT(*) FROM collab_bounty_participants WHERE bounty_id=?", (bounty_id,))
    return cursor.fetchone()[0] or 0

def join_collab_bounty(bounty_id, user_id):
    """Enregistre qu'un joueur a trouvé le pokémon du bounty. Retourne True si nouveau participant."""
    try:
        cursor.execute("""
            INSERT OR IGNORE INTO collab_bounty_participants (bounty_id, user_id)
            VALUES (?, ?)
        """, (bounty_id, str(user_id)))
        conn.commit()
        return cursor.rowcount > 0
    except Exception:
        return False

def complete_collab_bounty(bounty_id):
    """Marque le bounty comme complété et retourne la liste des participants."""
    cursor.execute("SELECT user_id FROM collab_bounty_participants WHERE bounty_id=?", (bounty_id,))
    participants = [r[0] for r in cursor.fetchall()]
    cursor.execute("""
        UPDATE collab_bounties SET status='completed', ended_at=datetime('now')
        WHERE id=?
    """, (bounty_id,))
    conn.commit()
    return participants


def get_active_wanteds():
    """Récupère tous les Pokémon wanted actifs"""
    cursor.execute("""
        SELECT id, pokemon_name, bonus_points, decay_percent, game, paliers_json, indice, pokemon_alternates
        FROM shiny_wanted
        WHERE is_active = 1
        ORDER BY updated_at DESC
    """)
    rows = cursor.fetchall()
    wanteds = []
    for row in rows:
        wanteds.append({
            'id': row[0],
            'pokemon_name': row[1],
            'bonus_points': row[2],
            'decay_percent': row[3] if row[3] is not None else 100.0,
            'game': row[4],
            'paliers_json': row[5],
            'indice': row[6],
            'pokemon_alternates': row[7]
        })
    return wanteds

def set_wanted(pokemon_name, bonus_points, decay_percent=100.0, game: str | None = None):
    """Définit un nouveau Pokémon wanted (sans désactiver les précédents, permet plusieurs wanted actifs)"""
    cursor.execute("""
        INSERT INTO shiny_wanted (pokemon_name, bonus_points, decay_percent, game, is_active, updated_at)
        VALUES (?, ?, ?, ?, 1, datetime('now'))
    """, (pokemon_name, bonus_points, decay_percent, game))
    conn.commit()
    wanted_id = cursor.lastrowid

    # Alerte dans le salon dédié
    # Alerte dans le salon dédié
    async def _send_wanted_alert(wid=wanted_id, pname=pokemon_name, bpts=bonus_points, gme=game):
        try:
            channel = bot.get_channel(SALON_WANTED_ALERT_ID)
            if not channel:
                logger.error(f"Salon wanted alert introuvable (ID: {SALON_WANTED_ALERT_ID})")
                return
            # Récupérer l'indice depuis la DB (ajouté après set_wanted)
            cursor.execute("SELECT indice FROM shiny_wanted WHERE id=?", (wid,))
            row = cursor.fetchone()
            indice = row[0] if row else None
            indice = row[0] if row else None
            # Cacher le nom seulement si l'indice est un vrai indice (pas juste [Méthode : ...])
            is_mystery = indice and not indice.strip().startswith("[Méthode :")
            displayed_name_fr = "???" if is_mystery else pname
            displayed_name_en = "???" if is_mystery else pname
            game_txt_en = f" on **{gme}**" if gme else ""
            end_ts = int((datetime.now() + timedelta(days=7)).timestamp())
            desc = (
                f"**{displayed_name_fr}** est maintenant recherché{game_txt_fr} !\n"
                f"**{displayed_name_en}** is now wanted{game_txt_en}!\n\n"
                f"⭐ Bonus : **+{bpts} pts** pour le premier trouveur / for the first finder\n"
                f"⏰ Se termine / Ends : <t:{end_ts}:F> (<t:{end_ts}:R>)\n\n"
            )
            if indice:
                desc += f"🔍 **Indice :** {indice}\n\n"
            desc += (
                f"🇫🇷 Utilisez `/shiny_ajout` pour réclamer votre bonus !\n"
                f"🇬🇧 Use `/add_myshiny` to claim your bonus!"
            )
            embed = discord.Embed(
                title="🎯 Nouveau Pokémon Wanted !  ·  New Wanted Pokémon!",
                description=desc,
                color=discord.Color.red(),
                timestamp=datetime.now()
            )
            embed.set_footer(text="ShinyBot · Wanted Alert")
            await channel.send(embed=embed)
            logger.info(f"Alerte wanted envoyée pour {pname} (affiché: {displayed_name_fr})")
        except Exception as e:
            logger.error(f"Erreur alerte wanted: {e}")


    try:
        loop = asyncio.get_event_loop()
        if loop.is_running():
            asyncio.create_task(_send_wanted_alert())
    except Exception as e:
        logger.error(f"Erreur création task alerte wanted: {e}")


    return wanted_id

def has_claimed_wanted(user_id, wanted_id):
    """Vérifie si l'utilisateur a déjà réclamé le bonus pour ce wanted"""
    cursor.execute("""
        SELECT COUNT(*) FROM shiny_wanted_claimed 
        WHERE user_id = ? AND wanted_id = ?
    """, (user_id, wanted_id))
    result = cursor.fetchone()
    return result[0] > 0 if result else False

def claim_wanted_bonus(user_id, wanted_id, pokemon_name, bonus_points):
    """Enregistre que l'utilisateur a réclamé le bonus wanted"""
    cursor.execute("""
        INSERT INTO shiny_wanted_claimed (user_id, wanted_id, pokemon_name, bonus_points)
        VALUES (?, ?, ?, ?)
    """, (user_id, wanted_id, pokemon_name, bonus_points))
    conn.commit()

def create_shiny_race(challenger_id, opponent_id, pokemon_name, game, bonus_points):
    """Crée une nouvelle race shiny entre deux joueurs"""
    cursor.execute("""
        INSERT INTO shiny_races (challenger_id, opponent_id, pokemon_name, game, bonus_points, status)
        VALUES (?, ?, ?, ?, ?, 'active')
    """, (challenger_id, opponent_id, pokemon_name, game, bonus_points))
    conn.commit()
    return cursor.lastrowid

def get_active_race_for_user_and_pokemon(user_id, pokemon_name):
    """Récupère une race active pour un utilisateur et un Pokémon donné"""
    cursor.execute("""
        SELECT id, challenger_id, opponent_id, game, bonus_points
        FROM shiny_races
        WHERE status = 'active'
        AND (challenger_id = ? OR opponent_id = ?)
        AND LOWER(pokemon_name) = LOWER(?)
        ORDER BY created_at ASC
        LIMIT 1
    """, (user_id, user_id, pokemon_name))
    result = cursor.fetchone()
    if not result:
        return None
    return {
        'id': result[0],
        'challenger_id': result[1],
        'opponent_id': result[2],
        'game': result[3],
        'bonus_points': result[4],
    }

def get_all_active_races_for_user_and_pokemon(user_id, pokemon_name):
    """Récupère TOUTES les races actives pour un utilisateur et un Pokémon donné (multi-adversaires)"""
    cursor.execute("""
        SELECT id, challenger_id, opponent_id, game, bonus_points
        FROM shiny_races
        WHERE status = 'active'
        AND (challenger_id = ? OR opponent_id = ?)
        AND LOWER(pokemon_name) = LOWER(?)
        ORDER BY created_at ASC
    """, (user_id, user_id, pokemon_name))
    results = cursor.fetchall()
    return [
        {'id': r[0], 'challenger_id': r[1], 'opponent_id': r[2], 'game': r[3], 'bonus_points': r[4]}
        for r in results
    ]

def mark_race_won(race_id, winner_id):
    """Marque une race comme gagnée, attribue le bonus au gagnant et déduit du perdant."""
    # Récupérer infos race
    cursor.execute("""
        SELECT challenger_id, opponent_id, bonus_points
        FROM shiny_races WHERE id = ? AND status = 'active'
    """, (race_id,))
    row = cursor.fetchone()
    if not row:
        return
    challenger_id, opponent_id, bonus_points = row

    # Déterminer le perdant
    loser_id = opponent_id if winner_id == challenger_id else challenger_id

    # Marquer la race terminée
    cursor.execute("""
        UPDATE shiny_races
        SET status = 'finished',
            winner_id = ?,
            ended_at = datetime('now')
        WHERE id = ? AND status = 'active'
    """, (winner_id, race_id))

    # Malus perdant : retirer les points (plancher 0)
    cursor.execute("SELECT COALESCE(SUM(points),0) FROM shiny WHERE user_id=?", (loser_id,))
    loser_total = cursor.fetchone()[0] or 0
    deduction = min(bonus_points, loser_total)
    if deduction > 0:
        cursor.execute("""
            INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
            VALUES (?, ?, '', 'race_malus', date('now'), ?, datetime('now'), 'fr')
        """, (loser_id, f'[Malus Race #{race_id}]', -deduction))
    conn.commit()

    # Vérifier badge race
    try:
        check_and_award_badges(winner_id)
    except Exception:
        pass

def get_race_stats(user_id):
    """Récupère les statistiques de race pour un utilisateur"""
    # Races gagnées
    cursor.execute("""
        SELECT COUNT(*)
        FROM shiny_races
        WHERE winner_id = ?
    """, (user_id,))
    wins = cursor.fetchone()[0] or 0

    # Races jouées
    cursor.execute("""
        SELECT COUNT(*)
        FROM shiny_races
        WHERE challenger_id = ? OR opponent_id = ?
    """, (user_id, user_id))
    total = cursor.fetchone()[0] or 0

    # Races en cours
    cursor.execute("""
        SELECT COUNT(*)
        FROM shiny_races
        WHERE status = 'active'
        AND (challenger_id = ? OR opponent_id = ?)
    """, (user_id, user_id))
    active = cursor.fetchone()[0] or 0

    # Total de points bonus gagnés
    cursor.execute("""
        SELECT COALESCE(SUM(bonus_points), 0)
        FROM shiny_races
        WHERE winner_id = ?
    """, (user_id,))
    total_bonus = cursor.fetchone()[0] or 0

    return {
        'wins': wins,
        'total': total,
        'active': active,
        'total_bonus': total_bonus
    }

def get_active_races():
    """Retourne la liste des races actives"""
    cursor.execute("""
        SELECT id, challenger_id, opponent_id, pokemon_name, game, bonus_points, created_at
        FROM shiny_races
        WHERE status = 'active'
        ORDER BY created_at ASC
        LIMIT 50
    """)
    return cursor.fetchall()

# ════════════════════════════════════════════════════════════════
# ══  SYSTÈME COMPÉTITIF (comeback, nerf top, diminishing)     ══
# ════════════════════════════════════════════════════════════════

# Soft cap hebdomadaire progressif
# Formule : effective = CAP + SOFTCAP_A × (extra)^SOFTCAP_B
# Résultat : 250→250 | 300→~290 | 400→~352 | 500→~407 | 700→~509 | 1000→~650
WEEKLY_CAP    = 250.0   # Points hebdo à partir desquels le soft cap s'active
SOFTCAP_A     = 1.44    # Coefficient du soft cap (amplitude)
SOFTCAP_B     = 0.85    # Exposant du soft cap (courbure) — plus bas = plus doux

def get_user_weekly_pts(user_id):
    """Points accumulés par l'utilisateur cette semaine."""
    week_start = get_current_week_start()
    cursor.execute(
        "SELECT total_pts FROM weekly_points_tracking WHERE user_id=? AND week_start=?",
        (str(user_id), week_start)
    )
    row = cursor.fetchone()
    return row[0] if row else 0.0

def add_user_weekly_pts(user_id, pts):
    """Ajoute des points au compteur hebdomadaire."""
    week_start = get_current_week_start()
    cursor.execute("""
        INSERT INTO weekly_points_tracking (user_id, week_start, total_pts)
        VALUES (?, ?, ?)
        ON CONFLICT(user_id, week_start) DO UPDATE SET total_pts = total_pts + excluded.total_pts
    """, (str(user_id), week_start, pts))
    conn.commit()

def _weekly_soft_cap(total_raw):
    """Calcule les points effectifs à partir du total brut hebdomadaire.
    Formule fluide : CAP + A*(extra)^B — aucune cassure brutale.

    Exemples :
        250 → 250  |  300 → ~290  |  400 → ~352
        500 → ~407 |  700 → ~509  | 1000 → ~650
    """
    import math as _m
    if total_raw <= WEEKLY_CAP:
        return total_raw
    extra = total_raw - WEEKLY_CAP
    return round(WEEKLY_CAP + SOFTCAP_A * (extra ** SOFTCAP_B), 2)


def apply_diminishing_returns(user_id, raw_pts):
    """Applique le soft cap hebdomadaire progressif à un gain de points.

    Calcule combien de points effectifs le joueur reçoit en tenant compte
    de ce qu'il a déjà accumulé cette semaine.
    Retourne les points effectifs (toujours >= 0).
    """
    already = get_user_weekly_pts(user_id)
    total_after = already + raw_pts

    # Points effectifs avant et après cet ajout
    eff_before = _weekly_soft_cap(already)
    eff_after  = _weekly_soft_cap(total_after)

    # Le gain effectif = différence des caps
    effective = round(max(0.0, eff_after - eff_before), 2)
    return effective

def get_position_multiplier(user_id):
    """Retourne le multiplicateur de position (comeback/nerf top3)."""
    ladder = get_ladder()
    rank = next((i + 1 for i, r in enumerate(ladder) if str(r[0]) == str(user_id)), None)
    if rank is None:
        return 1.25  # Pas encore classé = bonus max
    if rank <= 3:
        return 0.9   # Nerf top 3
    elif rank <= 10:
        return 1.10  # Bonus rang 4-10
    else:
        return 1.25  # Bonus comeback rang 11+


def apply_competitive_multipliers(user_id, raw_pts, cap_source_pts=None):
    """Applique tous les multiplicateurs compétitifs dans l'ordre :
    1. Multiplicateur de position (comeback/nerf)
    2. Diminishing returns hebdo
    Retourne (pts_finaux, pts_avant_dr, position_mult, cap_after_pos).

    `cap_source_pts` permet de définir explicitement la base qui compte pour le cap.
    Si None, on utilise raw_pts (comportement historique).
    """
    pos_mult = get_position_multiplier(user_id)
    after_pos = round(raw_pts * pos_mult, 2)
    cap_input = raw_pts if cap_source_pts is None else cap_source_pts
    cap_after_pos = round(cap_input * pos_mult, 2)
    effective = apply_diminishing_returns(user_id, cap_after_pos)
    return effective, after_pos, pos_mult, cap_after_pos


def add_shiny(user_id, pokemon, game, method_key, date, points, language="fr", console_count=1, hunt_counter=0, hunt_type="emulators"):
    """Ajoute un shiny à la base de données et met à jour les streaks"""
    bonus_points = 0
    is_wanted = False
    wanted_details = []
    
    # Vérifier si c'est un Pokémon wanted (il peut y en avoir plusieurs actifs)
    wanteds = get_active_wanteds()
    for wanted in wanteds:
        # Comparer le nom de Pokémon (insensible à la casse) — principal + alternates
        import json as _json_wanted
        _alt_raw = wanted.get('pokemon_alternates')
        _alt_list = []
        if _alt_raw:
            try:
                _alt_list = [n.lower() for n in _json_wanted.loads(_alt_raw)]
            except Exception:
                pass
        _all_names = {wanted['pokemon_name'].lower()} | set(_alt_list)
        if pokemon.lower() not in _all_names:
            continue

        # Si un jeu est imposé pour ce wanted, vérifier qu'il correspond (insensible à la casse)
        wanted_game = wanted.get('game')
        if wanted_game and wanted_game.strip():
            if not game or game.lower() != wanted_game.lower():
                continue

        # Vérifier si l'utilisateur n'a pas déjà réclamé ce bonus pour CE wanted
        if has_claimed_wanted(user_id, wanted['id']):
            continue

        # Calcul du bonus en fonction du palier (rang du joueur parmi ceux ayant trouvé ce wanted)
        cursor.execute("""
            SELECT COUNT(*) FROM shiny_wanted_claimed
            WHERE wanted_id = ?
        """, (wanted['id'],))
        already_count = cursor.fetchone()[0] or 0

        import json
        paliers_json = wanted.get('paliers_json')
        try:
            if paliers_json:
                paliers = json.loads(paliers_json)
                p1 = paliers.get('p1', wanted['bonus_points'])
                p2 = paliers.get('p2', p1)
                p3 = paliers.get('p3', p2)
                p_suite = paliers.get('suite', p3)
                if already_count == 0:
                    this_bonus = p1
                elif already_count == 1:
                    this_bonus = p2
                elif already_count == 2:
                    this_bonus = p3
                else:
                    this_bonus = p_suite
            else:
                # Ancien système decay_percent (rétrocompatibilité)
                decay = float(wanted.get('decay_percent', 100.0) or 100.0)
                factor = 1.0
                if decay < 100.0:
                    factor = (decay / 100.0) ** already_count
                this_bonus = max(wanted['bonus_points'] * factor, 0)
        except Exception:
            this_bonus = wanted['bonus_points']
        if this_bonus <= 0:
            continue

        # Appliquer le multiplicateur console/émulateur exactement comme pour les points normaux
        console_multiplier = calculate_console_multiplier(console_count, hunt_type)
        this_bonus = round(this_bonus * console_multiplier, 2)
        if this_bonus <= 0:
            continue

        bonus_points += this_bonus
        is_wanted = True
        wanted_details.append((wanted, this_bonus))

        # Enregistrer que l'utilisateur a réclamé le bonus pour CE wanted
        claim_wanted_bonus(user_id, wanted['id'], pokemon, this_bonus)
        logger.info(f"Bonus wanted accordé à {user_id} pour {pokemon} (+{this_bonus} pts x{console_multiplier}, wanted {wanted['id']})")
    
    # Le cap hebdo doit compter uniquement les points du shiny ajouté,
    # sans les bonus annexes (wanted, challenge, etc.).
    raw_shiny_only = points
    raw_total = points + bonus_points

    # Appliquer multiplicateur événement actif
    _event = get_active_event()
    _event_mult = get_event_multiplier(game, _event)
    if _event_mult != 1.0:
        raw_total = round(raw_total * _event_mult, 2)
        # Le cap hebdomadaire doit aussi tenir compte du bonus event
        # pour que le diminishing returns soit calculé correctement
        raw_shiny_only = round(raw_shiny_only * _event_mult, 2)
        add_shiny._last_event_mult = _event_mult
        add_shiny._last_event_desc = _event['description'] if _event else None
    else:
        add_shiny._last_event_mult = 1.0
        add_shiny._last_event_desc = None

    # Appliquer multiplicateurs compétitifs (comeback, nerf top3, diminishing returns)
    # Seulement pour les vrais shinys (pas les bonus/malus systèmes)
    _system_methods = {'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus',
                       'weekly_objective', 'monthly_objective', 'admin_adjustment', 'bounty_bonus'}
    if method_key not in _system_methods:
        effective_pts, after_pos, pos_mult, cap_after_pos = apply_competitive_multipliers(
            user_id, raw_total, cap_source_pts=raw_shiny_only
        )
        total_points = effective_pts
        add_shiny._last_pos_mult = pos_mult
        add_shiny._last_raw_pts = raw_total
        add_shiny._last_cap_raw_pts = cap_after_pos
        # Mettre à jour le compteur hebdo
        add_user_weekly_pts(user_id, cap_after_pos)
    else:
        total_points = raw_total
        add_shiny._last_pos_mult = 1.0
        add_shiny._last_raw_pts = raw_total
        add_shiny._last_cap_raw_pts = raw_total

    cursor.execute(
        "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter, hunt_type) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?, ?, ?, ?)",
        (user_id, pokemon, game, method_key, date, total_points, language, console_count, hunt_counter, hunt_type)
    )
    # Stocker le type si fourni (mis à jour après l'insert)
    if hasattr(add_shiny, '_pending_type') and add_shiny._pending_type:
        _last_rowid = cursor.lastrowid
        cursor.execute("UPDATE shiny SET type_pokemon=? WHERE rowid=?", (add_shiny._pending_type, _last_rowid))
        add_shiny._pending_type = None
    conn.commit()
    
    # Mettre à jour le streak de l'utilisateur
    try:
        update_user_streak(user_id, date)
    except Exception as e:
        logger.error(f"Erreur lors de la mise à jour du streak pour {user_id}: {e}")

    # Vérification badges automatiques
    try:
        check_and_award_badges(user_id)
    except Exception as e:
        logger.error(f"Erreur badge check pour {user_id}: {e}")

    # Vérification bounties collaboratifs
    try:
        active_bounties = get_active_collab_bounties()
        for bounty in active_bounties:
            if pokemon.lower() != bounty['pokemon_name'].lower():
                continue
            if bounty['game'] and game and game.lower() != bounty['game'].lower():
                continue
            is_new = join_collab_bounty(bounty['id'], user_id)
            if is_new:
                progress = get_bounty_progress(bounty['id'])
                if progress >= bounty['goal']:
                    # Bounty complété : distribuer les bonus
                    participants = complete_collab_bounty(bounty['id'])
                    for pid in participants:
                        cursor.execute("""
                            INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                            VALUES (?, ?, '', 'bounty_bonus', date('now'), ?, datetime('now'), 'fr')
                        """, (pid, f'[Bounty Collab #{bounty["id"]}]', bounty['bonus_points']))
                    conn.commit()
    except Exception as e:
        logger.error(f"Erreur bounty check pour {user_id}: {e}")

    # Vérifier si le joueur est le premier du jour (avant son propre ajout)
    cursor.execute("""
        SELECT COUNT(*) FROM shiny
        WHERE user_id != ? AND DATE(created_at) = DATE('now')
        AND methode NOT IN ('participation_bonus','weekly_objective','monthly_objective',
                            'race_bonus','race_malus','race_team_bonus','race_team_malus',
                            'admin_adjustment','bounty_bonus','season_carryover',
                            'monday_first_bonus','new_player_bonus')
    """, (user_id,))
    others_today = cursor.fetchone()[0] or 0
    is_first_of_day = (others_today == 0)

    # ── Bonus spéciaux ──────────────────────────────────────────────────────
    special_bonuses = []  # liste de (label, pts) pour affichage
    _system_skip = {
        'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus',
        'weekly_objective', 'monthly_objective', 'admin_adjustment',
        'bounty_bonus', 'season_carryover', 'participation_bonus',
        'monday_first_bonus', 'new_player_bonus',
    }

    # Bonus participation hebdo (+5 pts, 1 fois par semaine)
    try:
        if method_key not in _system_skip:
            if award_participation_bonus(user_id):
                special_bonuses.append(("🗓️ Participation hebdo", 5))
    except Exception as e:
        logger.error(f"Erreur participation bonus: {e}")

    # Bonus 1er shiny du lundi (+15 pts)
    try:
        if method_key not in _system_skip and is_monday_first_shiny():
            award_monday_first_bonus(user_id)
            special_bonuses.append(("🌟 1er shiny du lundi !", 15))
    except Exception as e:
        logger.error(f"Erreur monday bonus: {e}")

    # Bonus nouveau joueur (+25 pts, 1er shiny ever)
    try:
        if method_key not in _system_skip and is_new_player(user_id):
            award_new_player_bonus(user_id)
            special_bonuses.append(("🎉 Bienvenue (nouveau joueur)", 25))
    except Exception as e:
        logger.error(f"Erreur new player bonus: {e}")

    # Challenge mensuel surprise
    try:
        if method_key not in _system_skip:
            _ptype = getattr(add_shiny, '_pending_type', None)
            _ch_bonus, _ch_desc = check_challenge_completion(user_id, pokemon, game, _ptype)
            if _ch_bonus > 0:
                cursor.execute("""
                    INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                    VALUES (?, ?, '', 'challenge_bonus', date('now'), ?, datetime('now'), 'fr')
                """, (str(user_id), f'[Challenge : {_ch_desc[:40]}]', _ch_bonus))
                conn.commit()
                special_bonuses.append((f"🎯 Challenge mensuel !", _ch_bonus))
    except Exception as e:
        logger.error(f"Erreur challenge bonus: {e}")

    # Mettre à jour la progression des objectifs hebdomadaires
    objective_bonuses = []
    try:
        objective_bonuses = check_and_update_objectives(
            user_id, pokemon, game, method_key, total_points, is_first_of_day
        )
    except Exception as e:
        logger.error(f"Erreur mise à jour objectifs hebdo pour {user_id}: {e}")

    # Missions variété (jeux / méthodes / full odds) — indépendantes des objectifs aléatoires
    try:
        if method_key not in _system_skip:
            vbonuses = check_weekly_variety_missions(user_id, game, method_key)
            if vbonuses:
                objective_bonuses = list(objective_bonuses) + list(vbonuses)
    except Exception as e:
        logger.error(f"Erreur missions variété hebdo pour {user_id}: {e}")

    # Mettre à jour la progression des objectifs mensuels
    try:
        monthly_bonuses = check_and_update_monthly_objectives(
            user_id, pokemon, game, method_key, total_points, is_first_of_day
        )
        objective_bonuses += monthly_bonuses
    except Exception as e:
        logger.error(f"Erreur mise à jour objectifs mensuels pour {user_id}: {e}")

    # Si le shiny correspond au type du challenge actif, rafraîchir le classement
    try:
        if method_key not in _system_skip:
            _pending_type = getattr(add_shiny, '_pending_type', None)
            if _pending_type:
                _tc = get_active_monthly_type_challenge()
                if _tc and normalize_str(_pending_type) == normalize_str(_tc[3]):
                    asyncio.create_task(update_challenge_status_message())
    except Exception:
        pass

    return total_points, bonus_points, is_wanted, objective_bonuses, special_bonuses

def get_ladder():
    cursor.execute("""
    SELECT user_id,
           SUM(points) as total_points,
           (SELECT COUNT(*) FROM shiny_wanted_claimed WHERE shiny_wanted_claimed.user_id = shiny.user_id) as wanted_count,
           (SELECT COUNT(*) FROM shiny_races WHERE winner_id = shiny.user_id) as race_wins
    FROM shiny
    GROUP BY user_id
    ORDER BY total_points DESC
    """)
    return cursor.fetchall()

def get_user_shinys(user_id, page=1, per_page=5):
    """Récupère les shinys d'un utilisateur avec pagination"""
    offset = (page - 1) * per_page
    
    # Compte total des shinys
    cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id = ?", (user_id,))
    total_shinys = cursor.fetchone()[0]
    
    # Vérifier si la colonne created_at existe
    try:
        cursor.execute("SELECT created_at FROM shiny LIMIT 1")
        has_created_at = True
    except sqlite3.OperationalError:
        has_created_at = False
    
    # Récupère les shinys pour la page actuelle
    if has_created_at:
        cursor.execute("""
            SELECT rowid, pokemon, game, methode, odds, date, points, created_at, language
            FROM shiny 
            WHERE user_id = ? 
            ORDER BY created_at DESC 
            LIMIT ? OFFSET ?
        """, (user_id, per_page, offset))
    else:
        cursor.execute("""
            SELECT rowid, pokemon, game, methode, odds, date, points, date as created_at, language
            FROM shiny 
            WHERE user_id = ? 
            ORDER BY rowid DESC 
            LIMIT ? OFFSET ?
        """, (user_id, per_page, offset))
    
    shinys = cursor.fetchall()
    total_pages = math.ceil(total_shinys / per_page) if total_shinys > 0 else 1
    
    return shinys, total_shinys, total_pages

def get_user_stats(user_id):
    """Récupère les statistiques d'un utilisateur"""
    cursor.execute("""
        SELECT 
            COUNT(*) as total_shinys,
            SUM(points) as total_points,
            AVG(points) as avg_points,
            MAX(points) as best_shiny,
            MIN(date) as first_shiny_date,
            MAX(date) as last_shiny_date
        FROM shiny 
        WHERE user_id = ?
    """, (user_id,))
    
    stats = cursor.fetchone()
    
    # Méthode favorite
    cursor.execute("""
        SELECT methode, COUNT(*) as count
        FROM shiny 
        WHERE user_id = ? 
        GROUP BY methode 
        ORDER BY count DESC 
        LIMIT 1
    """, (user_id,))
    
    favorite_method = cursor.fetchone()
    
    # Pokémon le plus capturé
    cursor.execute("""
        SELECT pokemon, COUNT(*) as count
        FROM shiny 
        WHERE user_id = ? 
        GROUP BY pokemon 
        ORDER BY count DESC 
        LIMIT 1
    """, (user_id,))
    
    favorite_pokemon = cursor.fetchone()
    
    # Récupérer les streaks
    streak_data = get_user_streak(user_id)
    
    # Compteurs par période
    today_count = get_shiny_count_period(user_id, "day")
    week_count = get_shiny_count_period(user_id, "week")
    month_count = get_shiny_count_period(user_id, "month")
    
    return {
        'total_shinys': stats[0] if stats[0] else 0,
        'total_points': stats[1] if stats[1] else 0,
        'avg_points': stats[2] if stats[2] else 0,
        'best_shiny': stats[3] if stats[3] else 0,
        'first_shiny_date': stats[4],
        'last_shiny_date': stats[5],
        'favorite_method': favorite_method[0] if favorite_method else "Aucune",
        'favorite_pokemon': favorite_pokemon[0] if favorite_pokemon else "Aucun",
        'current_streak': streak_data['current_streak'],
        'best_streak': streak_data['best_streak'],
        'total_days_with_shiny': streak_data['total_days_with_shiny'],
        'today_count': today_count,
        'week_count': week_count,
        'month_count': month_count
    }

def get_user_rank(user_id):
    """Récupère le rang d'un utilisateur dans le classement"""
    ladder = get_ladder()
    for i, (uid, points, wanted_count, race_wins) in enumerate(ladder, 1):
        if uid == user_id:
            return i, points
    return None, 0

def get_rank_title_for_position(position):
    """Retourne le titre du rang pour une position donnée"""
    if position == 1:
        return "🥇 Shiny Hunter #1"
    elif position == 2:
        return "🥈 Shiny Hunter #2"
    elif position == 3:
        return "🥉 Shiny Hunter #3"
    elif 4 <= position <= 8:
        return "💜 Shiny Master"
    elif 9 <= position <= 14:
        return "💎 Shiny de Diamant"
    elif 15 <= position <= 20:
        return "💚 Shiny d'Émeraude"
    elif 21 <= position <= 29:
        return "🏆 Shiny de Platine"
    elif 30 <= position <= 39:
        return "✨ Shiny d'Or"
    elif 40 <= position <= 51:
        return "🌠 Shiny d'Argent"
    else:
        return "🌟 Shiny Novice"

def check_rank_change(user_id, old_rank, old_points):
    """Vérifie si l'utilisateur a changé de rang/tier après l'ajout du shiny"""
    new_rank, new_points = get_user_rank(user_id)
    
    # Si l'utilisateur n'avait pas de rang avant ou n'a toujours pas de rang après
    if old_rank is None or new_rank is None:
        return None
    
    # On ne notifie que les montées de rang (rang plus petit = meilleur)
    if new_rank >= old_rank:
        return None
    
    # Vérifier les changements significatifs
    changes = []
    
    # Montée dans le top 3
    if old_rank > 3 and new_rank <= 3:
        changes.append("top3")
    # Passage à la 1ère place
    if old_rank > 1 and new_rank == 1:
        changes.append("first")
    # Passage à la 2ème place
    if old_rank > 2 and new_rank == 2:
        changes.append("second")
    # Passage à la 3ème place
    if old_rank > 3 and new_rank == 3:
        changes.append("third")
    
    # Changement de tier (catégorie de rôle)
    old_tier = get_tier_from_position(old_rank)
    new_tier = get_tier_from_position(new_rank)
    if old_tier != new_tier and old_tier is not None:
        changes.append("tier_change")
        changes.append(f"from_{old_tier}_to_{new_tier}")
    
    # Montée significative (plus de 5 places)
    if old_rank and new_rank and old_rank - new_rank >= 5:
        changes.append("significant_climb")
    
    if changes:
        return {
            'old_rank': old_rank,
            'new_rank': new_rank,
            'old_points': old_points,
            'new_points': new_points,
            'old_tier': old_tier,
            'new_tier': new_tier,
            'changes': changes
        }
    return None

def get_tier_from_position(position):
    """Retourne le tier (catégorie de rôle) pour une position donnée"""
    if position is None:
        return None
    if position == 1:
        return "hunter1"
    elif position == 2:
        return "hunter2"
    elif position == 3:
        return "hunter3"
    elif 4 <= position <= 8:
        return "master"
    elif 9 <= position <= 14:
        return "diamant"
    elif 15 <= position <= 20:
        return "emeraude"
    elif 21 <= position <= 29:
        return "platine"
    elif 30 <= position <= 39:
        return "or"
    elif 40 <= position <= 51:
        return "argent"
    else:
        return "novice"

async def send_rank_up_message(member, rank_change_data, pokemon_name, points, language="fr"):
    """Envoie un message de félicitations pour une montée de rang"""
    try:
        guild = bot.get_guild(GUILD_ID)
        if not guild:
            return
        
        # Utiliser le salon de classement ou un salon général
        channel = bot.get_channel(SALON_CLASSEMENT_ID)
        if not channel:
            # Essayer de trouver un salon général
            for ch in guild.text_channels:
                if 'general' in ch.name.lower() or 'shiny' in ch.name.lower():
                    channel = ch
                    break
        
        if not channel:
            return
        
        changes = rank_change_data['changes']
        old_rank = rank_change_data['old_rank']
        new_rank = rank_change_data['new_rank']
        old_tier = rank_change_data['old_tier']
        new_tier = rank_change_data['new_tier']
        
        # Déterminer le type de message
        if "first" in changes:
            title = "🏆 NOUVELLE PREMIÈRE PLACE ! 🏆" if language == "fr" else "🏆 NEW FIRST PLACE ! 🏆"
            description = f"{member.mention} vient de prendre la **1ère place** du classement !"
            color = discord.Color.gold()
            emoji = "🥇"
        elif "second" in changes:
            title = "🥈 2ème place ! 🥈" if language == "fr" else "🥈 2nd Place ! 🥈"
            description = f"{member.mention} vient de passer à la **2ème place** !"
            color = discord.Color.light_grey()
            emoji = "🥈"
        elif "third" in changes:
            title = "🥉 3ème place ! 🥉" if language == "fr" else "🥉 3rd Place ! 🥉"
            description = f"{member.mention} vient de passer à la **3ème place** !"
            color = discord.Color.from_rgb(205, 127, 50)
            emoji = "🥉"
        elif "top3" in changes:
            title = "🔥 ENTREE DANS LE TOP 3 ! 🔥" if language == "fr" else "🔥 TOP 3 ENTRY ! 🔥"
            description = f"{member.mention} vient d'entrer dans le **Top 3** du classement !"
            color = discord.Color.gold()
            emoji = "🔥"
        elif "tier_change" in changes:
            tier_names = {
                "master":   ("💜 Shiny Master",       "Shiny Master"),
                "diamant":  ("💎 Shiny de Diamant",   "Shiny Diamond"),
                "emeraude": ("💚 Shiny d'Émeraude",  "Shiny Emerald"),
                "platine":  ("🏆 Shiny de Platine",   "Shiny Platinum"),
                "or":       ("✨ Shiny d'Or",         "Shiny Gold"),
                "argent":   ("🌠 Shiny d'Argent",    "Shiny Silver"),
            }
            new_tier_name = tier_names.get(new_tier, ("🌟 Nouveau tier", "🌟 New tier"))
            tier_display = new_tier_name[0] if language == "fr" else new_tier_name[1]
            title = f"⭐ NOUVEAU TIER : {tier_display} ⭐" if language == "fr" else f"⭐ NEW TIER : {tier_display} ⭐"
            description = f"{member.mention} vient d'atteindre le tier **{tier_display}** !"
            color = discord.Color.purple()
            emoji = "⭐"
        elif "significant_climb" in changes:
            places_gained = old_rank - new_rank
            title = f"📈 Montée impressionnante ! 📈" if language == "fr" else f"📈 Impressive Climb ! 📈"
            description = f"{member.mention} vient de monter de **{places_gained} places** !"
            color = discord.Color.green()
            emoji = "📈"
        else:
            # Montée normale
            places_gained = old_rank - new_rank
            title = f"⬆️ Montée de rang ! ⬆️" if language == "fr" else f"⬆️ Rank Up ! ⬆️"
            description = f"{member.mention} vient de monter de **{places_gained} place{'s' if places_gained > 1 else ''}** !"
            color = discord.Color.blue()
            emoji = "⬆️"
        
        embed = discord.Embed(
            title=title,
            description=description,
            color=color,
            timestamp=datetime.now()
        )
        
        embed.set_author(name=member.display_name, icon_url=member.display_avatar.url)
        embed.set_thumbnail(url=member.display_avatar.url)
        
        # Informations sur le changement
        rank_field = "Rang" if language == "fr" else "Rank"
        points_field = "Points" if language == "fr" else "Points"
        shiny_field = "Shiny ajouté" if language == "fr" else "Shiny added"
        
        embed.add_field(
            name=f"{emoji} Changement de {rank_field.lower()}",
            value=f"**#{old_rank}** → **#{new_rank}**\n"
                  f"{points_field}: **{int(rank_change_data['old_points'])}** → **{int(rank_change_data['new_points'])}** ⭐",
            inline=True
        )
        
        embed.add_field(
            name=f"✨ {shiny_field}",
            value=f"**{pokemon_name}** (+{points} pts)",
            inline=True
        )
        
        # Nouveau titre de rang
        new_rank_title = get_rank_title_for_position(new_rank)
        embed.add_field(
            name="🏅 Nouveau rang" if language == "fr" else "🏅 New rank",
            value=new_rank_title,
            inline=False
        )
        
        embed.set_footer(text="ShinyBot - Félicitations !" if language == "fr" else "ShinyBot - Congratulations!")
        
        await channel.send(embed=embed)
        logger.info(f"Message de montée de rang envoyé pour {member.display_name} (rang {old_rank} → {new_rank})")
        
    except Exception as e:
        logger.error(f"Erreur lors de l'envoi du message de montée de rang: {e}")

def get_method_emoji(methode):
    """Retourne un emoji selon la méthode"""
    if "Full Odds" in methode:
        return "🔥"
    elif "Masuda" in methode:
        return "🥚"
    elif "Charme Chroma" in methode or "Shiny Charm" in methode:
        return "✨"
    elif "Hordes" in methode:
        return "👥"
    elif "Légendes Arceus" in methode or "Legends Arceus" in methode:
        return "🏔️"
    elif "Violet" in methode or "Écarlate" in methode or "Scarlet" in methode:
        return "🍃"
    else:
        return "⭐"

def get_rarity_color(points):
    """Retourne une couleur selon la rareté du shiny"""
    if points >= 25:
        return discord.Color.red()  # Légendaire
    elif points >= 10:
        return discord.Color.purple()  # Épique
    elif points >= 5:
        return discord.Color.blue()  # Rare
    elif points >= 2:
        return discord.Color.green()  # Peu commun
    else:
        return discord.Color.light_grey()  # Commun

