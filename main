)
async def race_list(interaction: discord.Interaction):
    async def _show_list(**kwargs):
        await interaction.response.defer(ephemeral=True)

        races = get_active_races()
        if not races:
            await interaction.followup.send("⚠️ Aucune race active pour le moment.", ephemeral=True)
            return True

        embed = discord.Embed(
            title="🏁 Races Shiny Actives",
            color=discord.Color.orange()
        )

        guild = bot.get_guild(GUILD_ID)

        for race in races:
            race_id, challenger_id, opponent_id, pokemon_name, game, bonus_points, created_at = race
            challenger = guild.get_member(int(challenger_id)) if guild else None
            opponent = guild.get_member(int(opponent_id)) if guild else None
