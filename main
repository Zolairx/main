POINT_METHOD_LABELS = {
    'participation_bonus': 'Participation hebdo',
    'weekly_objective': 'Objectifs hebdo / missions variété',
    'monthly_objective': 'Objectifs mensuels',
    'race_bonus': 'Bonus race',
    'race_malus': 'Malus race',
    'race_team_bonus': 'Bonus race équipe',
    'race_team_malus': 'Malus race équipe',
    'admin_adjustment': 'Corrections admin',
    'bounty_bonus': 'Bounty collaboratif',
    'season_carryover': 'Report saison',
    'season_calibration': 'Calibrage début de saison',
    'inactivity_decay': "Décote d'inactivité",
    'monday_first_bonus': 'Jeu de la semaine',
    'new_player_bonus': 'Bonus nouveau joueur',
    'parrainage_bonus': 'Bonus parrainage',
    'challenge_bonus': 'Challenge mensuel',
    'type_challenge_bonus': 'Challenge de type',
    'wanted_bonus': 'Wanted personnel',
    'guilde_objective_bonus': 'Objectif de guilde',
}

REAL_SHINY_METHOD_EXCLUDE = tuple(POINT_METHOD_LABELS.keys())

def _fmt_pts(value):
    value = float(value or 0)
    return f"{value:.0f}" if value == int(value) else f"{value:.2f}"

def _clip_lines(lines, limit=1024):
    out = []
    size = 0
    for line in lines:
        extra = len(line) + 1
        if size + extra > limit:
            out.append("…")
            break
        out.append(line)
        size += extra
    return "\n".join(out) if out else "Aucune donnée."

def get_points_breakdown(user_id):
    """Retourne le détail des points persistés dans shiny, plus les wanteds serveur réclamés."""
    user_id = str(user_id)
    placeholders = ",".join("?" * len(REAL_SHINY_METHOD_EXCLUDE))
    cursor.execute(f"""
        SELECT COALESCE(SUM(points), 0), COUNT(*)
        FROM shiny
        WHERE user_id=? AND (methode IS NULL OR methode NOT IN ({placeholders}))
    """, (user_id, *REAL_SHINY_METHOD_EXCLUDE))
    shiny_points, shiny_count = cursor.fetchone()

    cursor.execute(f"""
        SELECT methode, COALESCE(SUM(points), 0), COUNT(*)
        FROM shiny
        WHERE user_id=? AND methode IN ({placeholders})
        GROUP BY methode
        ORDER BY SUM(points) DESC
    """, (user_id, *REAL_SHINY_METHOD_EXCLUDE))
    system_rows = cursor.fetchall()

    cursor.execute("""
        SELECT COALESCE(SUM(points), 0), COUNT(*)
        FROM shiny
        WHERE user_id=?
    """, (user_id,))
    total_points, total_entries = cursor.fetchone()

    cursor.execute("""
        SELECT COALESCE(SUM(bonus_points), 0), COUNT(*)
        FROM shiny_wanted_claimed
        WHERE user_id=?
    """, (user_id,))
    wanted_server_points, wanted_server_count = cursor.fetchone()

    cursor.execute("""
        SELECT pokemon, game, methode, points, created_at
        FROM shiny
        WHERE user_id=?
        ORDER BY datetime(created_at) DESC, rowid DESC
        LIMIT 12
    """, (user_id,))
    recent_rows = cursor.fetchall()

    return {
        'shiny_points': float(shiny_points or 0),
        'shiny_count': int(shiny_count or 0),
        'system_rows': system_rows,
        'total_points': float(total_points or 0),
        'total_entries': int(total_entries or 0),
        'wanted_server_points': float(wanted_server_points or 0),
        'wanted_server_count': int(wanted_server_count or 0),
        'recent_rows': recent_rows,
    }

def build_points_detail_embed(member, viewer=None):
    data = get_points_breakdown(member.id)
    embed = discord.Embed(
        title=f"📒 Journal des points — {member.display_name}",
        color=discord.Color.gold(),
        timestamp=datetime.now()
    )
    embed.set_thumbnail(url=member.display_avatar.url)
    embed.add_field(
        name="Total",
        value=(
            f"**{_fmt_pts(data['total_points'])} pts**\n"
            f"{data['total_entries']} entrées enregistrées"
        ),
        inline=True
    )
    embed.add_field(
        name="Shinys enregistrés",
        value=f"**{_fmt_pts(data['shiny_points'])} pts**\n{data['shiny_count']} shinys / lignes ranked",
        inline=True
    )
    embed.add_field(
        name="Wanteds serveur",
        value=(
            f"**{_fmt_pts(data['wanted_server_points'])} pts**\n"
            f"{data['wanted_server_count']} réclamation(s)\n"
            "*Déjà inclus dans les lignes shiny concernées.*"
        ),
        inline=True
    )

    bonus_lines = []
    for methode, pts, count in data['system_rows']:
        label = POINT_METHOD_LABELS.get(methode or "", methode or "Autre")
        bonus_lines.append(f"• **{label}** : {_fmt_pts(pts)} pts ({count})")
    embed.add_field(name="Bonus / ajustements séparés", value=_clip_lines(bonus_lines), inline=False)

    recent_lines = []
    for pokemon, game, methode, pts, created_at in data['recent_rows']:
        label = POINT_METHOD_LABELS.get(methode or "", methode or "Shiny")
        game_txt = f" · {game}" if game else ""
        date_txt = (created_at or "")[:10]
        recent_lines.append(f"• **{pokemon}**{game_txt} — {_fmt_pts(pts)} pts · {label} · {date_txt}")
    embed.add_field(name="Dernières entrées", value=_clip_lines(recent_lines), inline=False)
    embed.set_footer(text="Les wanteds serveur sont suivis à part mais crédités dans la ligne du shiny trouvé.")
    return embed

@bot.tree.command(
    name="points_detail",
    description="Voir le journal détaillé des points d'un joueur",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(membre="Joueur à consulter (toi par défaut)")
async def points_detail(interaction: discord.Interaction, membre: discord.Member = None):
    try:
        member = membre or interaction.user
        if membre and membre.id != interaction.user.id and not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("❌ Tu peux consulter seulement tes propres points.", ephemeral=True)
            return
        await interaction.response.send_message(embed=build_points_detail_embed(member), ephemeral=True)
    except Exception as e:
        logger.error(f"Erreur /points_detail: {e}", exc_info=True)
        msg = "❌ Impossible d'afficher le journal des points pour ce membre. L'erreur a été enregistrée dans les logs."
        if interaction.response.is_done():
            await interaction.followup.send(msg, ephemeral=True)
        else:
            await interaction.response.send_message(msg, ephemeral=True)


RECALC_ADJUSTMENT_PREFIX = "[Recalcul Secours:"


def _parse_sqlite_datetime(value):
    """Parse les timestamps SQLite les plus courants sans lever d'erreur."""
    if not value:
        return None
    raw = str(value).strip()
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M:%S.%f", "%Y-%m-%d"):
        try:
            return datetime.strptime(raw[:26] if "%f" in fmt else raw[:19 if "H" in fmt else 10], fmt)
        except ValueError:
            continue
    try:
        return datetime.fromisoformat(raw)
    except Exception:
        return None


def _allocate_server_wanted_claims(user_id, real_rows):
    """Rattache les wanteds serveur aux shinys les plus proches du même Pokémon."""
    rows_by_pokemon = {}
    for row in real_rows:
        norm = normalize_str(row["pokemon"])
        if not norm:
            continue
        rows_by_pokemon.setdefault(norm, []).append(row)

    cursor.execute("""
        SELECT pokemon_name, bonus_points, claimed_at
        FROM shiny_wanted_claimed
        WHERE user_id=?
        ORDER BY datetime(claimed_at), id
    """, (str(user_id),))

    by_rowid = {}
    unmatched_total = 0.0
    claimed_count = 0
    for pokemon_name, bonus_points, claimed_at in cursor.fetchall():
        claimed_count += 1
        bonus = float(bonus_points or 0)
        candidates = rows_by_pokemon.get(normalize_str(pokemon_name), [])
        if not candidates:
            unmatched_total += bonus
            continue

        claim_dt = _parse_sqlite_datetime(claimed_at)
        if claim_dt:
            best = min(
                candidates,
                key=lambda r: abs(((r.get("created_dt") or claim_dt) - claim_dt).total_seconds())
            )
        else:
            best = candidates[-1]
        by_rowid[best["rowid"]] = by_rowid.get(best["rowid"], 0.0) + bonus

    return by_rowid, unmatched_total, claimed_count


def build_user_points_recalc_report(user_id):
    """Reconstruit un total prudent depuis les lignes shiny et bonus persistées."""
    user_id = str(user_id)
    placeholders = ",".join("?" * len(REAL_SHINY_METHOD_EXCLUDE))

    cursor.execute(f"""
        SELECT rowid, pokemon, game, methode, points, created_at,
               COALESCE(console_count, 1), COALESCE(hunt_type, 'emulators')
        FROM shiny
        WHERE user_id=? AND (methode IS NULL OR methode NOT IN ({placeholders}))
        ORDER BY datetime(created_at), rowid
    """, (user_id, *REAL_SHINY_METHOD_EXCLUDE))
    real_rows = []
    for rowid, pokemon, game, methode, points, created_at, console_count, hunt_type in cursor.fetchall():
        real_rows.append({
            "rowid": rowid,
            "pokemon": pokemon or "",
            "game": game or "",
            "methode": methode or "",
            "points": float(points or 0),
            "created_at": created_at,
            "created_dt": _parse_sqlite_datetime(created_at),
            "console_count": int(console_count or 1),
            "hunt_type": hunt_type or "emulators",
        })

    wanted_by_rowid, unmatched_wanted_total, wanted_claims = _allocate_server_wanted_claims(user_id, real_rows)

    recalculated_real_total = 0.0
    current_real_total = sum(r["points"] for r in real_rows)
    resolved_count = 0
    unresolved_rows = []
    new_game_bonus_total = 0.0
    wanted_attached_total = 0.0
    seen_games = set()

    for row in real_rows:
        game_key = resolve_game_key(row["game"])
        method_key = row["methode"]
        wanted_bonus = float(wanted_by_rowid.get(row["rowid"], 0.0))

        if game_key and method_key in METHODS_BY_GAME.get(game_key, {}):
            base_points = round(calculate_points(game_key, method_key, row["console_count"], row["hunt_type"]), 2)
            row_total = base_points
            if game_key not in seen_games:
                new_game_bonus = round(base_points * 0.10, 2)
                row_total = round(row_total + new_game_bonus, 2)
                new_game_bonus_total = round(new_game_bonus_total + new_game_bonus, 2)
            if wanted_bonus:
                row_total = round(row_total + wanted_bonus, 2)
                wanted_attached_total = round(wanted_attached_total + wanted_bonus, 2)
            resolved_count += 1
        else:
            row_total = row["points"]
            unresolved_rows.append(row)

        if game_key:
            seen_games.add(game_key)
        recalculated_real_total = round(recalculated_real_total + row_total, 2)

    cursor.execute(f"""
        SELECT COALESCE(SUM(points), 0), COUNT(*)
        FROM shiny
        WHERE user_id=?
          AND methode IN ({placeholders})
          AND NOT (methode='admin_adjustment' AND pokemon LIKE ?)
    """, (user_id, *REAL_SHINY_METHOD_EXCLUDE, f"{RECALC_ADJUSTMENT_PREFIX}%"))
    system_total, system_count = cursor.fetchone()
    system_total = float(system_total or 0)

    cursor.execute("""
        SELECT COALESCE(SUM(points), 0), COUNT(*)
        FROM shiny
        WHERE user_id=? AND methode='admin_adjustment' AND pokemon LIKE ?
    """, (user_id, f"{RECALC_ADJUSTMENT_PREFIX}%"))
    previous_recalc_total, previous_recalc_count = cursor.fetchone()
    previous_recalc_total = float(previous_recalc_total or 0)

    cursor.execute("SELECT COALESCE(SUM(points), 0), COUNT(*) FROM shiny WHERE user_id=?", (user_id,))
    current_total, total_entries = cursor.fetchone()
    current_total = float(current_total or 0)

    recalculated_total = round(recalculated_real_total + system_total + unmatched_wanted_total, 2)
    difference = round(recalculated_total - current_total, 2)

    return {
        "current_total": current_total,
        "recalculated_total": recalculated_total,
        "difference": difference,
        "total_entries": int(total_entries or 0),
        "real_count": len(real_rows),
        "resolved_count": resolved_count,
        "unresolved_rows": unresolved_rows,
        "current_real_total": round(current_real_total, 2),
        "recalculated_real_total": round(recalculated_real_total, 2),
        "system_total": round(system_total, 2),
        "system_count": int(system_count or 0),
        "wanted_claims": wanted_claims,
        "wanted_attached_total": round(wanted_attached_total, 2),
        "unmatched_wanted_total": round(unmatched_wanted_total, 2),
        "new_game_bonus_total": round(new_game_bonus_total, 2),
        "previous_recalc_total": round(previous_recalc_total, 2),
        "previous_recalc_count": int(previous_recalc_count or 0),
    }


def build_points_recalc_embed(member, report, applied=False):
    color = discord.Color.green() if applied else discord.Color.blurple()
    embed = discord.Embed(
        title=f"🧮 Recalcul points — {member.display_name}",
        color=color,
        timestamp=datetime.now()
    )
    embed.set_thumbnail(url=member.display_avatar.url)
    embed.add_field(name="Total actuel", value=f"**{_fmt_pts(report['current_total'])} pts**", inline=True)
    embed.add_field(name="Total reconstruit", value=f"**{_fmt_pts(report['recalculated_total'])} pts**", inline=True)
    embed.add_field(name="Écart", value=f"**{_fmt_pts(report['difference'])} pts**", inline=True)
    embed.add_field(
        name="Lignes shiny",
        value=(
            f"{report['resolved_count']}/{report['real_count']} recalculées\n"
            f"Stocké : {_fmt_pts(report['current_real_total'])} pts\n"
            f"Reconstruit : {_fmt_pts(report['recalculated_real_total'])} pts"
        ),
        inline=True
    )
    embed.add_field(
        name="Bonus séparés",
        value=f"{report['system_count']} ligne(s)\n{_fmt_pts(report['system_total'])} pts",
        inline=True
    )
    embed.add_field(
        name="Wanteds serveur",
        value=(
            f"{report['wanted_claims']} réclamation(s)\n"
            f"{_fmt_pts(report['wanted_attached_total'])} pts rattachés\n"
            f"{_fmt_pts(report['unmatched_wanted_total'])} pts non rattachés"
        ),
        inline=True
    )

    notes = [
        f"Bonus nouveau jeu reconstruits : {_fmt_pts(report['new_game_bonus_total'])} pts.",
        "Les bonus/malus déjà stockés (objectifs, races, wanted perso, corrections admin, report saison) sont conservés.",
        "Les multiplicateurs historiques de rang, soft cap et événements passés ne sont pas rejoués parfaitement."
    ]
    if report["previous_recalc_count"]:
        notes.append(
            f"Anciennes corrections secours ignorées dans la cible : "
            f"{_fmt_pts(report['previous_recalc_total'])} pts ({report['previous_recalc_count']})."
        )
    if report["unresolved_rows"]:
        sample = ", ".join(f"#{r['rowid']} {r['pokemon']}" for r in report["unresolved_rows"][:5])
        notes.append(f"Lignes gardées telles quelles faute de jeu/méthode reconnue : {sample}.")
    if not applied:
        notes.append("Pour appliquer, relance avec `appliquer: True` et `confirmation: RECALCULER`.")
    embed.add_field(name="Notes", value=_clip_lines([f"• {n}" for n in notes]), inline=False)
    embed.set_footer(text="Mode secours : ajoute une correction admin, ne modifie pas l'historique.")
    return embed


@bot.tree.command(
    name="admin_recalcul_points",
    description="[ADMIN] Auditer ou recaler le total de points d'un joueur",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    membre="Joueur à recalculer",
    appliquer="False = aperçu seulement. True = ajoute une correction admin de l'écart.",
    confirmation="Pour appliquer, écrire exactement RECALCULER"
)
async def admin_recalcul_points(
    interaction: discord.Interaction,
    membre: discord.Member,
    appliquer: bool = False,
    confirmation: str = ""
):
    global last_classement_update

    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)
    report = build_user_points_recalc_report(membre.id)

    if not appliquer:
        await interaction.followup.send(embed=build_points_recalc_embed(membre, report), ephemeral=True)
        return

    if confirmation.strip() != "RECALCULER":
        embed = build_points_recalc_embed(membre, report)
        embed.add_field(
            name="Application refusée",
            value="Relance avec `confirmation: RECALCULER` pour créer la correction.",
            inline=False
        )
        await interaction.followup.send(embed=embed, ephemeral=True)
        return

    diff = report["difference"]
    if abs(diff) < 0.01:
        embed = build_points_recalc_embed(membre, report, applied=True)
        embed.add_field(name="Résultat", value="Aucune correction nécessaire.", inline=False)
        await interaction.followup.send(embed=embed, ephemeral=True)
        return

    date_now = datetime.now().strftime("%d-%m-%Y")
    label = f"{RECALC_ADJUSTMENT_PREFIX} {'+' if diff > 0 else ''}{_fmt_pts(diff)} pts]"
    cursor.execute("""
        INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter, hunt_type)
        VALUES (?, ?, 'Correction Admin', 'admin_adjustment', ?, ?, datetime('now'), 'fr', 1, 0, 'emulators')
    """, (str(membre.id), label, date_now, diff))
    conn.commit()

    after_report = build_user_points_recalc_report(membre.id)
    embed = build_points_recalc_embed(membre, after_report, applied=True)
    embed.add_field(
        name="Correction créée",
        value=f"{label}\nAncien écart appliqué : **{_fmt_pts(diff)} pts**",
        inline=False
    )
    await interaction.followup.send(embed=embed, ephemeral=True)

    last_classement_update = None
    asyncio.create_task(update_classement_message())
    asyncio.create_task(update_roles())

def build_admin_panel_embed(guild):
    active_wanteds = get_active_wanteds()
    week_start = get_current_week_start()
    month_start = get_current_month_start()
    cursor.execute("SELECT COUNT(*) FROM weekly_objectives WHERE week_start=? AND is_active=1", (week_start,))
    weekly_count = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COUNT(*) FROM monthly_objectives WHERE month_start=? AND is_active=1", (month_start,))
    monthly_count = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COUNT(*) FROM scheduled_wanteds WHERE status='pending'")
    scheduled_count = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COUNT(*) FROM active_events WHERE is_active=1")
    event_count = cursor.fetchone()[0] or 0
    cursor.execute("SELECT COUNT(*) FROM shinyhunter_guildes")
    guildes_count = cursor.fetchone()[0] or 0

    embed = discord.Embed(
        title="🛠️ Dashboard Admin",
        description="Vue rapide des modules actifs et raccourcis de gestion.",
        color=discord.Color.blurple(),
        timestamp=datetime.now()
    )
    if guild and guild.icon:
        embed.set_thumbnail(url=guild.icon.url)
    embed.add_field(name="🎯 Wanteds", value=f"{len(active_wanteds)} actif(s)\n{scheduled_count} programmé(s)", inline=True)
    embed.add_field(name="📌 Objectifs", value=f"{weekly_count} hebdo actif(s)\n{monthly_count} mensuel(s)", inline=True)
    embed.add_field(name="🏰 Guildes", value=f"{guildes_count} guilde(s)\nClassement dédié actif", inline=True)
    embed.add_field(name="⚡ Événements", value=f"{event_count} événement(s) actif(s)", inline=True)
    embed.add_field(name="📊 Classements", value=f"`/classement`\n`/guilde_classement`", inline=True)
    embed.add_field(name="📒 Audit joueur", value="`/points_detail`\n`/admin_recalcul_points`", inline=True)
    embed.set_footer(text="Utilise les boutons pour afficher les raccourcis par module.")
    return embed

def build_admin_help_embed(section):
    sections = {
        "wanted": (
            "🎯 Admin Wanteds",
            [
                "`/admin_set_wanted` — créer un wanted par paliers",
                "`/admin_wanted_avance` — wanted avec jeu/méthode",
                "`/admin_wanted_programmer` — programmer un wanted",
                "`/admin_wanted_programmes` — voir la file programmée",
                "`/admin_disable_wanted` — désactiver un wanted",
                "`/admin_wanted_alternates` — ajouter des noms acceptés",
                "`/wanted` — voir les wanteds actifs",
            ],
            discord.Color.red()
        ),
        "objectifs": (
            "📌 Admin Objectifs",
            [
                "`/admin_objectif_add` — créer un objectif hebdo",
                "`/admin_objectif_pokemon` — objectif Pokémon précis",
                "`/admin_objectif_methode` — objectif méthode précise",
                "`/admin_objectifs_semaine` — gérer la semaine",
                "`/admin_objectif_mensuel_add` — créer un objectif mensuel",
                "`/admin_objectifs_mois` — gérer le mois",
            ],
            discord.Color.green()
        ),
        "joueurs": (
            "👥 Admin Joueurs",
            [
                "`/points_detail membre:@joueur` — journal des points",
                "`/admin_recalcul_points` — audit/recalage secours",
                "`/admin_edit_points` — correction de points",
                "`/shiny_remove` — retirer le dernier shiny",
                "`/admin_badge_donner` / `/admin_badge_retirer`",
                "`/admin_badge_creer` — badge personnalisé",
            ],
            discord.Color.gold()
        ),
        "systeme": (
            "⚙️ Admin Système",
            [
                "`/admin_event_lancer` — multiplicateur de points",
                "`/admin_event_stop` — arrêter l'événement",
                "`/classement` — rafraîchir le classement",
                "`/guilde_classement` — rafraîchir les guildes",
                "`/admin_bounty_creer` — bounty collaboratif",
                "`/challenge` — challenge actif",
            ],
            discord.Color.purple()
        ),
    }
    title, lines, color = sections[section]
    embed = discord.Embed(title=title, description="\n".join(lines), color=color, timestamp=datetime.now())
    embed.set_footer(text="Ces boutons servent de tableau de bord, les actions restent dans les slash commands existantes.")
    return embed

class AdminPanelView(discord.ui.View):
    def __init__(self, owner_id):
        super().__init__(timeout=300)
        self.owner_id = owner_id

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        if interaction.user.id != self.owner_id:
            await interaction.response.send_message("❌ Ce dashboard n'est pas le tien.", ephemeral=True)
            return False
        return True

    @discord.ui.button(label="Vue globale", style=discord.ButtonStyle.primary)
    async def overview(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.edit_message(embed=build_admin_panel_embed(interaction.guild), view=self)

    @discord.ui.button(label="Wanteds", style=discord.ButtonStyle.secondary)
    async def wanted_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.edit_message(embed=build_admin_help_embed("wanted"), view=self)

    @discord.ui.button(label="Objectifs", style=discord.ButtonStyle.secondary)
    async def objectifs_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.edit_message(embed=build_admin_help_embed("objectifs"), view=self)

    @discord.ui.button(label="Joueurs", style=discord.ButtonStyle.secondary)
    async def joueurs_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.edit_message(embed=build_admin_help_embed("joueurs"), view=self)

    @discord.ui.button(label="Système", style=discord.ButtonStyle.secondary)
    async def systeme_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.edit_message(embed=build_admin_help_embed("systeme"), view=self)

    @discord.ui.button(label="🧹 Nettoyer images", style=discord.ButtonStyle.danger, row=2)
    async def cleanup_images_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.defer(ephemeral=True)
        image_count_before = len(list(IMAGES_DIR.glob("candidate_*.*")))
        cleanup_old_images()
        image_count_after = len(list(IMAGES_DIR.glob("candidate_*.*")))
        deleted = image_count_before - image_count_after
        embed = discord.Embed(
            title="🧹 Nettoyage des images terminé",
            description=f"**Images supprimées :** {deleted}\n**Images restantes :** {image_count_after}",
            color=discord.Color.green()
        )
        await interaction.followup.send(embed=embed, ephemeral=True)

    @discord.ui.button(label="🔄 Reset rôles shiny", style=discord.ButtonStyle.danger, row=2)
    async def reset_roles_btn(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.defer(ephemeral=True)
        await interaction.followup.send("🔄 Réinitialisation des rôles en cours...", ephemeral=True)
        result = await reset_all_shiny_roles()
        if result is None:
            await interaction.followup.send("❌ Erreur lors de la réinitialisation des rôles.", ephemeral=True)
            return
        ok, fail = result
        embed = discord.Embed(
            title="✅ Réinitialisation des rôles terminée",
            description="Tous les rôles shiny ont été retirés.",
            color=discord.Color.green()
        )
        embed.add_field(name="Succès", value=f"{ok} membres", inline=True)
        if fail:
            embed.add_field(name="Échecs", value=f"{fail} membres", inline=True)
        embed.set_footer(text="Les rôles seront réattribués à la prochaine mise à jour du classement.")
        await interaction.followup.send(embed=embed, ephemeral=True)

@bot.tree.command(
    name="admin_panel",
    description="[ADMIN] Dashboard de gestion rapide du bot",
    guild=discord.Object(id=GUILD_ID)
)
async def admin_panel(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.send_message(
        embed=build_admin_panel_embed(interaction.guild),
        view=AdminPanelView(interaction.user.id),
        ephemeral=True
    )

def build_recap_focus_embed(member, page):
    user_id = str(member.id)
    week_start = get_current_week_start()
    month_start = get_current_month_start()
    embed = discord.Embed(color=discord.Color.blurple(), timestamp=datetime.now())
    embed.set_thumbnail(url=member.display_avatar.url)

    if page == "accueil":
        rank, total_points = get_user_rank(user_id)
        weekly_raw = get_user_weekly_pts(user_id)
        weekly_eff = _weekly_soft_cap(weekly_raw)
        rank_title = get_rank_title(rank) if rank else "🌟 Non classé"
        pts_str = f"{total_points:.1f}" if total_points and total_points % 1 != 0 else f"{int(total_points or 0)}"
        ladder = get_ladder()
        nb_joueurs = len(ladder)
        cap_status = (
            f"✅ Sous le cap ({weekly_raw:.0f}/{WEEKLY_CAP:.0f} pts)"
            if weekly_raw <= WEEKLY_CAP
            else f"⚠️ Soft cap actif ({weekly_raw:.0f} pts bruts → {weekly_eff:.0f} pts effectifs)"
        )
        cursor.execute(
            "SELECT 1 FROM shiny WHERE user_id=? AND methode='participation_bonus' AND date(created_at) >= date(?)",
            (user_id, week_start)
        )
        participation_ok = cursor.fetchone() is not None
        next_mission = get_closest_weekly_mission(user_id)
        embed.title = f"📋 Récap — {member.display_name}"
        embed.add_field(
            name="🏆 Classement",
            value=f"**#{rank if rank else 'N/A'}** sur {nb_joueurs} — {rank_title}\n⭐ **{pts_str} pts** au total",
            inline=True
        )
        embed.add_field(
            name="⭐ Points cette semaine",
            value=f"**{weekly_raw:.0f} pts** bruts\n{cap_status}",
            inline=True
        )
        embed.add_field(
            name="🗓️ Participation hebdo (+5 pts)",
            value="✅ Récupérée" if participation_ok else "❌ Ajoute un shiny pour la récupérer !",
            inline=False
        )
        if next_mission:
            m_desc, m_bonus, m_cur, m_need = next_mission
            bar_filled = int((m_cur / m_need) * 8) if m_need else 0
            bar = "█" * bar_filled + "░" * (8 - bar_filled)
            embed.add_field(
                name="💡 Prochaine mission",
                value=f"*{m_desc}*\n`{bar}` {m_cur}/{m_need} — **+{m_bonus:.0f} pts** (manque {m_need - m_cur})",
                inline=False
            )

    elif page == "missions":
        embed.title = f"🎲 Missions Variété — {member.display_name}"
        stats = get_weekly_mission_stats(user_id, week_start)
        done, todo = [], []
        pts_done = 0.0
        for mkey, kind, need, bonus, desc in WEEKLY_VARIETY_MISSIONS:
            claimed = is_variety_mission_claimed(user_id, week_start, mkey)
            current = mission_current_value(stats, kind)
            label = mission_kind_label(kind)
            if claimed:
                done.append(f"✅ {desc} *(+{bonus:.0f} pts)*")
                pts_done += bonus
            else:
                ratio = min(float(current) / float(need), 1.0) if need else 0
                filled = int(ratio * 8)
                bar = "■" * filled + "□" * (8 - filled)
                manque = need - current
                if manque <= 0:
                    todo.append(f"🟡 {desc} — **prêt à être réclamé !** (+{bonus:.0f} pts)")
                else:
                    todo.append(f"⬜ `[{bar}]` {current}/{need} {label} — +{bonus:.0f} pts")
        all_lines = done + todo
        # Découper si > 1024 chars
        LIMIT = 1024
        chunk, chunks = "", []
        for line in all_lines:
            candidate = (chunk + "\n" + line).lstrip("\n") if chunk else line
            if len(candidate) > LIMIT:
                chunks.append(chunk)
                chunk = line
            else:
                chunk = candidate
        if chunk:
            chunks.append(chunk)
        header = f"({len(done)}/{len(WEEKLY_VARIETY_MISSIONS)} complétées · +{pts_done:.0f} pts récupérés)"
        for i, c in enumerate(chunks or ["Aucune mission."]):
            fname = f"🎲 Missions {header}" if i == 0 else f"🎲 Missions (suite)"
            embed.add_field(name=fname, value=c, inline=False)

    elif page == "points":
        data = get_points_breakdown(user_id)
        weekly_raw = get_user_weekly_pts(user_id)
        weekly_eff = _weekly_soft_cap(weekly_raw)
        rank, total_points = get_user_rank(user_id)
        embed.title = f"⭐ Récap points — {member.display_name}"
        embed.add_field(name="Total ranked", value=f"**{_fmt_pts(total_points)} pts**\nRang : **#{rank}**" if rank else "Non classé", inline=True)
        embed.add_field(name="Cette semaine", value=f"{_fmt_pts(weekly_raw)} pts bruts\n{_fmt_pts(weekly_eff)} pts effectifs", inline=True)
        embed.add_field(name="Wanteds serveur", value=f"{data['wanted_server_count']} réclamation(s)\n{_fmt_pts(data['wanted_server_points'])} pts inclus", inline=True)
        recent = [f"• **{p}** — {_fmt_pts(pts)} pts" for p, _, _, pts, _ in data['recent_rows'][:8]]
        embed.add_field(name="Dernières entrées", value=_clip_lines(recent), inline=False)
    elif page == "objectifs":
        embed.title = f"📌 Objectifs — {member.display_name}"
        cursor.execute("""
            SELECT wo.description, wo.target_value, wo.bonus_points, wo.difficulty,
                   COALESCE(wop.current_value, 0), COALESCE(wop.completed, 0), COALESCE(wop.bonus_awarded, 0)
            FROM weekly_objectives wo
            LEFT JOIN weekly_objectives_progress wop ON wo.id = wop.objective_id AND wop.user_id = ?
            WHERE wo.week_start = ? AND wo.is_active = 1
            ORDER BY wop.completed ASC, wo.difficulty DESC
        """, (user_id, week_start))
        weekly = cursor.fetchall()
        cursor.execute("""
            SELECT mo.description, mo.target_value, mo.bonus_points, mo.difficulty,
                   COALESCE(mop.current_value, 0), COALESCE(mop.completed, 0), COALESCE(mop.bonus_awarded, 0)
            FROM monthly_objectives mo
            LEFT JOIN monthly_objectives_progress mop ON mo.id = mop.objective_id AND mop.user_id = ?
            WHERE mo.month_start = ? AND mo.is_active = 1
            ORDER BY mop.completed ASC, mo.difficulty DESC
        """, (user_id, month_start))
        monthly = cursor.fetchall()

        def obj_lines(rows):
            out = []
            for desc, target, bonus, diff, current, completed, awarded in rows[:8]:
                status = "✅" if awarded else ("🟡" if completed else "⬜")
                cur = int(current) if current == int(current) else round(current, 1)
                tgt = int(target) if target == int(target) else target
                out.append(f"{status} **{desc}** — {cur}/{tgt} (+{_fmt_pts(bonus)} pts)")
            return out
        embed.add_field(name=f"Semaine ({sum(1 for r in weekly if r[5])}/{len(weekly)})", value=_clip_lines(obj_lines(weekly)), inline=False)
        embed.add_field(name=f"Mois ({sum(1 for r in monthly if r[5])}/{len(monthly)})", value=_clip_lines(obj_lines(monthly)), inline=False)
    elif page == "wanted":
        embed.title = f"🎯 Wanteds — {member.display_name}"
        pw = get_active_personal_wanted(user_id)
        if pw:
            ts = int(datetime.fromisoformat(pw[4]).timestamp())
            perso = f"En cours : **{pw[1]}** (Gen {pw[2]})\nExpire <t:{ts}:R>"
        else:
            perso = "Aucun wanted personnel actif."
        active = get_active_wanteds()
        active_lines = []
        for w in active[:8]:
            claimed = has_claimed_wanted(user_id, w['id'])
            name = "???" if w.get('indice') and not w['indice'].strip().startswith("[Méthode :") else w['pokemon_name']
            status = "✅ réclamé" if claimed else f"+{_fmt_pts(w['bonus_points'])} pts"
            game_txt = f" · {w['game']}" if w.get('game') else ""
            active_lines.append(f"• `#{w['id']}` **{name}**{game_txt} — {status}")
        embed.add_field(name="Wanted personnel", value=perso, inline=False)
        embed.add_field(name=f"Wanteds serveur actifs ({len(active)})", value=_clip_lines(active_lines), inline=False)
    else:  # activite
        embed.title = f"📊 Activité — {member.display_name}"
        stats = get_user_stats(user_id)
        streak = get_user_streak(user_id)
        embed.add_field(name="Shinys", value=f"Total : **{stats['total_shinys']}**\nAujourd'hui : {stats['today_count']}\n7 jours : {stats['week_count']}", inline=True)
        embed.add_field(name="Préférences", value=f"Pokémon : **{stats['favorite_pokemon']}**\nMéthode : **{stats['favorite_method']}**", inline=True)
        embed.add_field(name="Streak", value=f"Actuel : **{streak['current_streak']}** jours\nRecord : **{streak['best_streak']}** jours", inline=True)
        guilde = guilde_of_user(user_id)
        embed.add_field(name="Guilde", value=f"{guilde[4]} **{guilde[1]}**" if guilde else "Aucune guilde", inline=False)
    embed.set_footer(text="Récap interactif · boutons visibles seulement par toi")
    return embed


