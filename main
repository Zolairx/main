# Kinds de missions par "paliers exclusifs" : seul le palier le plus élevé atteint
# est déclenché. Sans ça, un shiny à 20 000 rencontres activerait 5k + 10k + 20k
# simultanément, car hunt_counter est un MAX (pas un cumul incrémental).
TIERED_MISSION_KINDS = {'hunt_counter', 'fo_hunt_counter'}

_FULL_ODDS_METHOD_KEYS = None  # rempli paresseusement

# Jeux récents sur lesquels les bonus Full Odds (missions, stats, major_methods)
# ne s'appliquent PAS. Les méthodes de ces jeux gardent leurs points de base
# mais sont traitées comme des méthodes neutres (ni FO, ni réduites).
# Jeux exclus : Let's Go Pikachu/Évoli, Écarlate/Violet, Légendes Z-A
# (Légendes Arceus n'a pas de méthode full_odds donc pas concerné)
NO_FO_BONUS_GAME_KEYS = {'lgpe', 'gen9', 'za'}

def _build_no_fo_bonus_method_keys():
    """Retourne le set des method_keys FO des jeux sans bonus FO."""
    s = set()
    for gk in NO_FO_BONUS_GAME_KEYS:
        for mk in METHODS_BY_GAME.get(gk, {}).keys():
            if 'full_odds' in str(mk).lower():
                s.add(mk)
    return frozenset(s)

_NO_FO_BONUS_METHOD_KEYS = None  # rempli au premier appel

def get_no_fo_bonus_method_keys():
    global _NO_FO_BONUS_METHOD_KEYS
    if _NO_FO_BONUS_METHOD_KEYS is None:
        _NO_FO_BONUS_METHOD_KEYS = _build_no_fo_bonus_method_keys()
    return _NO_FO_BONUS_METHOD_KEYS

def get_closest_weekly_mission(user_id):
    """Retourne la mission variété la plus proche de complétion (non réclamée).
    Renvoie (description, bonus, current, need) ou None."""
    week_start = get_current_week_start()
    stats = get_weekly_mission_stats(user_id, week_start)
    best = None
    best_ratio = -1.0
    for mkey, kind, need, bonus, desc in WEEKLY_VARIETY_MISSIONS:
        if is_variety_mission_claimed(user_id, week_start, mkey):
            continue
        current = mission_current_value(stats, kind)
        if current >= need:
            continue  # déjà remplie mais pas encore réclamée — cas rare, on ignore
        if need <= 0:
            continue
        ratio = current / need
        if ratio > best_ratio:
            best_ratio = ratio
            best = (desc, bonus, current, need)
    return best

# Cache inverse : nom_normalisé → numéro de génération (construit une seule fois)
_POKEMON_GEN_MAP = None

def get_pokemon_gen_map():
    """Retourne un dict {nom_normalisé: gen} basé sur POKEMON_PAR_GEN."""
    global _POKEMON_GEN_MAP
    if _POKEMON_GEN_MAP is None:
        _POKEMON_GEN_MAP = {}
        for gen, lst in POKEMON_PAR_GEN.items():
            for name in lst:
                _POKEMON_GEN_MAP[normalize_str(name)] = gen
    return _POKEMON_GEN_MAP

def get_full_odds_method_keys():
    global _FULL_ODDS_METHOD_KEYS
    if _FULL_ODDS_METHOD_KEYS is None:
        s = set()
        for gk, methods in METHODS_BY_GAME.items():
            if gk == 'dc_event':
                continue
            if gk in NO_FO_BONUS_GAME_KEYS:
                continue  # jeux récents : leurs méthodes FO sont neutres, pas bonifiées
            for mk in methods.keys():
                if 'full_odds' in str(mk).lower():
                    s.add(mk)
        _FULL_ODDS_METHOD_KEYS = frozenset(s)
    return _FULL_ODDS_METHOD_KEYS

OLD_GEN_GAME_KEYS = {'gen1', 'gen2'}
OLD_LEGEND_GAME_KEYS = {'gen1', 'gen2', 'gen3', 'frlg', 'colosseum_xd'}
MAJOR_METHOD_CATEGORIES = ('full_odds', 'masuda', 'radar', 'sos')

# ── Préférences utilisateur ────────────────────────────────────────────────────
# Stocke : langue, type de chasse, liste des 3 derniers jeux utilisés,
# et le dernier method_key utilisé par jeu (pour pré-sélectionner).

def get_user_preferences(user_id):
    """Retourne les préférences de l'utilisateur (valeurs par défaut si absent)."""
    cursor.execute("SELECT language, hunt_type, recent_games, recent_methods FROM user_preferences WHERE user_id=?", (str(user_id),))
    row = cursor.fetchone()
    if not row:
        return {'language': None, 'hunt_type': None, 'recent_games': [], 'recent_methods': {}}
    language, hunt_type, recent_games_json, recent_methods_json = row
    try:
        recent_games = json.loads(recent_games_json or '[]')
    except Exception:
        recent_games = []
    try:
        recent_methods = json.loads(recent_methods_json or '{}')
    except Exception:
        recent_methods = {}
    return {
        'language': language,
        'hunt_type': hunt_type,
        'recent_games': recent_games,
        'recent_methods': recent_methods,
    }

def save_user_preferences(user_id, language=None, hunt_type=None, game_key=None, method_key=None):
    """Met à jour les préférences après chaque ajout de shiny."""
    prefs = get_user_preferences(user_id)
    if language:
        prefs['language'] = language
    if hunt_type:
        prefs['hunt_type'] = hunt_type
    if game_key:
        # Garder les 3 derniers jeux distincts utilisés, le plus récent en premier
        games = [g for g in prefs['recent_games'] if g != game_key]
        games.insert(0, game_key)
        prefs['recent_games'] = games[:3]
    if method_key and game_key:
        prefs['recent_methods'][game_key] = method_key
    cursor.execute("""
        INSERT INTO user_preferences (user_id, language, hunt_type, recent_games, recent_methods)
        VALUES (?, ?, ?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET
            language=excluded.language,
            hunt_type=excluded.hunt_type,
            recent_games=excluded.recent_games,
            recent_methods=excluded.recent_methods
    """, (
        str(user_id),
        prefs['language'],
        prefs['hunt_type'],
        json.dumps(prefs['recent_games']),
        json.dumps(prefs['recent_methods']),
    ))
    conn.commit()

def resolve_game_key(game):
    """Retourne la cle GAMES depuis une cle, un nom FR ou un nom EN."""
    if not game:
        return None
    if game in GAMES:
        return game
    norm_game = normalize_str(str(game).strip())
    for key, labels in GAMES.items():
        if norm_game in {
            normalize_str(labels.get('fr', '')),
            normalize_str(labels.get('en', '')),
        }:
            return key
    return None

def is_full_odds_method(method_key):
    return method_key in get_full_odds_method_keys()

def get_method_category(method_key):
    if is_full_odds_method(method_key):
        return 'full_odds'
    method_norm = normalize_str(method_key or '')
    if 'masuda' in method_norm:
        return 'masuda'
    if 'radar' in method_norm:
        return 'radar'
    if method_norm == 'sos' or '_sos' in method_norm or 'sos_' in method_norm:
        return 'sos'
    return None

def is_reduced_odds_method(method_key):
    if not method_key or method_key in VARIETY_COUNT_EXCLUDE:
        return False
    # Les méthodes FO des jeux récents (lgpe, gen9, za) sont neutres :
    # elles ne sont ni full odds bonifiées, ni réduites.
    if method_key in get_no_fo_bonus_method_keys():
        return False
    return not is_full_odds_method(method_key)

def get_next_month_start(month_start):
    base = datetime.strptime(month_start, "%Y-%m-%d").date()
    if base.month == 12:
        return str(base.replace(year=base.year + 1, month=1, day=1))
    return str(base.replace(month=base.month + 1, day=1))

def get_previous_month_start(ref_date=None):
    ref = ref_date or datetime.now().date()
    first = ref.replace(day=1)
    prev_last = first - timedelta(days=1)
    return str(prev_last.replace(day=1))

def _parse_db_date(value):
    if not value:
        return None
    try:
        return datetime.strptime(str(value)[:10], "%Y-%m-%d").date()
    except Exception:
        return None

def _real_shiny_rows_for_period(user_id, start_date, end_date=None):
    ex = VARIETY_COUNT_EXCLUDE
    ph = ','.join('?' * len(ex))
    end_clause = ""
    params = [str(user_id), start_date]
    if end_date:
        end_clause = "AND date(created_at) < date(?)"
        params.append(end_date)
    params.extend(ex)
    cursor.execute(f"""
        SELECT pokemon, game, methode, date(created_at), COALESCE(hunt_counter, 0), COALESCE(type_pokemon, '')
        FROM shiny
        WHERE user_id=? AND date(created_at) >= date(?)
        {end_clause}
        AND methode NOT IN ({ph})
        AND pokemon IS NOT NULL AND TRIM(pokemon) != ''
    """, tuple(params))
    dc_name = normalize_str(GAMES.get('dc_event', {}).get('fr', ''))
    rows = []
    for pokemon, game, method_key, created_day, hunt_counter, type_pokemon in cursor.fetchall():
        if normalize_str(game or '') == dc_name:
            continue
        rows.append({
            'pokemon': pokemon or '',
            'game': game or '',
            'game_key': resolve_game_key(game),
            'method_key': method_key or '',
            'created_day': created_day,
            'hunt_counter': int(hunt_counter or 0),
            'type_pokemon': type_pokemon or '',
        })
    return rows

def get_period_bonus_stats(user_id, start_date, end_date=None):
    rows = _real_shiny_rows_for_period(user_id, start_date, end_date)
    fo = get_full_odds_method_keys()
    gen_map = get_pokemon_gen_map()
    legendary = get_special_list('legendary')
    starters = get_special_list('starter')
    weekly_game = get_weekly_game()

    games = set()
    methods = set()
    gens = set()
    days = set()
    types_found = set()
    days_by_week = {}
    major_methods = set()
    count_fo = count_reduced = 0
    count_legendary = count_starter = 0
    count_legendary_fo = count_starter_fo = 0
    count_old_gen = count_old_gen_fo = 0
    count_masuda = count_radar = count_sos = 0
    count_weekly_game_fo = count_legendary_old = 0
    max_hunt = max_fo_hunt = 0

    for row in rows:
        method_key = row['method_key']
        game_key = row['game_key']
        game_identity = game_key or normalize_str(row['game'])
        if game_identity:
            games.add(game_identity)
        if method_key:
            methods.add(method_key)

        day = _parse_db_date(row['created_day'])
        if day:
            days.add(day)
            week_day = day - timedelta(days=day.weekday())
            days_by_week.setdefault(str(week_day), set()).add(day)

        pokemon_norm = normalize_str(row['pokemon'])
        pokemon_gen = gen_map.get(pokemon_norm)
        if pokemon_gen:
            gens.add(pokemon_gen)

        type_norm = normalize_str(row['type_pokemon'])
        if type_norm:
            types_found.add(type_norm)

        hunt_counter = row['hunt_counter']
        max_hunt = max(max_hunt, hunt_counter)

        is_fo = method_key in fo
        if is_fo:
            count_fo += 1
            max_fo_hunt = max(max_fo_hunt, hunt_counter)
        elif is_reduced_odds_method(method_key):
            count_reduced += 1

        category = get_method_category(method_key)
        if category in MAJOR_METHOD_CATEGORIES:
            major_methods.add(category)
        if category == 'masuda':
            count_masuda += 1
        elif category == 'radar':
            count_radar += 1
        elif category == 'sos':
            count_sos += 1

        is_legend = pokemon_norm in legendary
        is_starter = pokemon_norm in starters
        if is_legend:
            count_legendary += 1
            if game_key in OLD_LEGEND_GAME_KEYS:
                count_legendary_old += 1
            if is_fo:
                count_legendary_fo += 1
        if is_starter:
            count_starter += 1
            if is_fo:
                count_starter_fo += 1
        if game_key in OLD_GEN_GAME_KEYS:
            count_old_gen += 1
            if is_fo:
                count_old_gen_fo += 1
        if weekly_game and game_key == weekly_game and is_fo:
            count_weekly_game_fo += 1

    params = [str(user_id), start_date]
    end_clause = ""
    if end_date:
        end_clause = "AND date(claimed_at) < date(?)"
        params.append(end_date)
    cursor.execute(f"""
        SELECT pokemon FROM personal_wanted
        WHERE user_id=? AND claimed=1
        AND claimed_at IS NOT NULL
        AND date(claimed_at) >= date(?)
        {end_clause}
    """, tuple(params))
    personal_wanted_rows = [normalize_str(r[0]) for r in cursor.fetchall()]
    personal_wanted_names = set(personal_wanted_rows)
    count_personal_wanted = len(personal_wanted_rows)
    count_fo_wanted = sum(
        1 for row in rows
        if row['method_key'] in fo and normalize_str(row['pokemon']) in personal_wanted_names
    )

    weekly_claimed = set()
    if end_date:
        cursor.execute("""
            SELECT DISTINCT mission_key FROM weekly_variety_claims
            WHERE user_id=? AND date(created_at) >= date(?) AND date(created_at) < date(?)
        """, (str(user_id), start_date, end_date))
        weekly_claimed = {r[0] for r in cursor.fetchall()}
    weekly_keys = {m[0] for m in WEEKLY_VARIETY_MISSIONS if m[0].startswith('weekly_')}

    stats = {
        'shinys': len(rows),
        'games': len(games),
        'methods': len(methods),
        'full_odds_count': count_fo,
        'days': len(days),
        'gens': len(gens),
        'legendary': count_legendary,
        'starter': count_starter,
        'legendary_fo': count_legendary_fo,
        'starter_fo': count_starter_fo,
        'hunt_counter': max_hunt,
        'fo_hunt_counter': max_fo_hunt,
        'old_gen': count_old_gen,
        'old_gen_fo': count_old_gen_fo,
        'masuda': count_masuda,
        'radar': count_radar,
        'sos': count_sos,
        'combo_fo_wanted': count_fo_wanted,
        'combo_jeu_fo': count_weekly_game_fo,
        'combo_leg_old': count_legendary_old,
        'fo_and_reduced': 1 if count_fo > 0 and count_reduced > 0 else 0,
        'active_weeks': len(days_by_week),
        'weeks_5days': sum(1 for week_days in days_by_week.values() if len(week_days) >= 5),
        'types': len(types_found),
        'major_methods': len(major_methods),
        'personal_wanted': count_personal_wanted,
        'weekly_clean_sweep': 1 if weekly_keys and weekly_keys.issubset(weekly_claimed) else 0,
    }
    return stats

def get_weekly_mission_stats(user_id, week_start, current_pokemon=None, current_method_key=None):
    stats = get_period_bonus_stats(user_id, week_start)
    if current_pokemon and is_full_odds_method(current_method_key):
        row = get_active_personal_wanted(user_id)
        if row and normalize_str(row[1]) == normalize_str(current_pokemon):
            stats['combo_fo_wanted'] = max(stats.get('combo_fo_wanted', 0), 1)

    # ── Mission Anti-sèche : méthode jamais utilisée cette saison avant cette semaine ──
    # On vérifie si current_method_key apparaît dans la table shiny avant le début
    # de la semaine courante. Si non → méthode inédite cette saison → stat = 1.
    stats['new_season_method'] = 0
    if current_method_key:
        _system_methods = {
            'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus', 'inactivity_decay', 'season_calibration',
            'weekly_objective', 'monthly_objective', 'admin_adjustment', 'bounty_bonus',
            'participation_bonus', 'monday_first_bonus', 'new_player_bonus', 'parrainage_bonus',
            'challenge_bonus', 'type_challenge_bonus', 'season_carryover', 'wanted_bonus',
        }
        if current_method_key not in _system_methods:
            cursor.execute("""
                SELECT COUNT(*) FROM shiny
                WHERE user_id=? AND methode=? AND date(created_at) < date(?)
            """, (str(user_id), current_method_key, week_start))
            used_before = cursor.fetchone()[0]
            if used_before == 0:
                stats['new_season_method'] = 1

    return stats

def mission_current_value(stats, kind):
    return stats.get(kind, 0)

def mission_kind_label(kind):
    labels = {
        'games': 'jeux',
        'methods': 'methodes',
        'full_odds_count': 'Full Odds',
        'days': 'jours',
        'gens': 'generations',
        'legendary': 'legendaires',
        'starter': 'starters',
        'legendary_fo': 'legendaires FO',
        'starter_fo': 'starters FO',
        'hunt_counter': 'rencontres max',
        'fo_hunt_counter': 'rencontres FO max',
        'old_gen': 'shiny Gen 1/2',
        'old_gen_fo': 'FO Gen 1/2',
        'masuda': 'Masuda',
        'radar': 'Radar',
        'sos': 'SOS',
        'combo_fo_wanted': 'combo FO wanted',
        'combo_jeu_fo': 'jeu semaine FO',
        'combo_leg_old': 'legendaire ancien',
        'fo_and_reduced': 'FO + odds reduits',
        'shinys': 'shinys',
        'active_weeks': 'semaines actives',
        'weeks_5days': 'semaines a 5 jours',
        'types': 'types',
        'major_methods': 'methodes majeures',
        'personal_wanted': 'wanteds perso',
        'weekly_clean_sweep': 'objectifs hebdo',
        'new_season_method': 'methode inedite saison',
    }
    return labels.get(kind, kind)

def get_weekly_variety_stats(user_id, week_start):
    """Compte toutes les stats hebdo nécessaires aux missions variété."""
    ex = VARIETY_COUNT_EXCLUDE
    ph = ','.join('?' * len(ex))
    dc_name = GAMES['dc_event']['fr']

    # ── Jeux distincts ────────────────────────────────────────────────────────
    cursor.execute(f"""
        SELECT COUNT(DISTINCT game) FROM shiny
        WHERE user_id=? AND date(created_at) >= date(?)
        AND game IS NOT NULL AND TRIM(game) != ''
        AND LOWER(game) != LOWER(?) AND methode NOT IN ({ph})
    """, (str(user_id), week_start, dc_name, *ex))
    n_games = int(cursor.fetchone()[0] or 0)

    # ── Méthodes distinctes ───────────────────────────────────────────────────
    cursor.execute(f"""
        SELECT COUNT(DISTINCT methode) FROM shiny
        WHERE user_id=? AND date(created_at) >= date(?)
        AND methode IS NOT NULL AND TRIM(methode) != '' AND methode NOT IN ({ph})
    """, (str(user_id), week_start, *ex))
    n_methods = int(cursor.fetchone()[0] or 0)

    # ── Full Odds ─────────────────────────────────────────────────────────────
    fo = get_full_odds_method_keys()
    if not fo:
        count_fo = 0
    else:
        fph = ','.join('?' * len(fo))
        cursor.execute(f"""
            SELECT COUNT(*) FROM shiny
            WHERE user_id=? AND date(created_at) >= date(?)
            AND methode IN ({fph}) AND methode NOT IN ({ph})
        """, (str(user_id), week_start, *fo, *ex))
        count_fo = int(cursor.fetchone()[0] or 0)

    # ── Jours distincts ───────────────────────────────────────────────────────
    cursor.execute(f"""
        SELECT COUNT(DISTINCT date(created_at)) FROM shiny
        WHERE user_id=? AND date(created_at) >= date(?) AND methode NOT IN ({ph})
    """, (str(user_id), week_start, *ex))
    n_days = int(cursor.fetchone()[0] or 0)

    # ── Générations distinctes ────────────────────────────────────────────────
    cursor.execute(f"""
        SELECT DISTINCT pokemon FROM shiny
        WHERE user_id=? AND date(created_at) >= date(?)
        AND methode NOT IN ({ph})
        AND pokemon IS NOT NULL AND TRIM(pokemon) != ''
    """, (str(user_id), week_start, *ex))
    gen_map = get_pokemon_gen_map()
    gens_found = set()
    for (pname,) in cursor.fetchall():
        g = gen_map.get(normalize_str(pname or ''))
        if g:
            gens_found.add(g)
    n_gens = len(gens_found)

    # ── Légendaires ───────────────────────────────────────────────────────────
    cursor.execute(f"""
        SELECT COUNT(*) FROM shiny s
        JOIN special_pokemon_lists spl
            ON LOWER(s.pokemon) = LOWER(spl.pokemon_name) AND spl.list_type = 'legendary'
        WHERE s.user_id=? AND date(s.created_at) >= date(?) AND s.methode NOT IN ({ph})
    """, (str(user_id), week_start, *ex))
    count_legendary = int(cursor.fetchone()[0] or 0)

    # ── Starters ──────────────────────────────────────────────────────────────
    cursor.execute(f"""
        SELECT COUNT(*) FROM shiny s
        JOIN special_pokemon_lists spl
            ON LOWER(s.pokemon) = LOWER(spl.pokemon_name) AND spl.list_type = 'starter'
        WHERE s.user_id=? AND date(s.created_at) >= date(?) AND s.methode NOT IN ({ph})
    """, (str(user_id), week_start, *ex))
    count_starter = int(cursor.fetchone()[0] or 0)

    # ── Légendaires Full Odds ─────────────────────────────────────────────────
    if fo:
        fph = ','.join('?' * len(fo))
        cursor.execute(f"""
            SELECT COUNT(*) FROM shiny s
            JOIN special_pokemon_lists spl
                ON LOWER(s.pokemon) = LOWER(spl.pokemon_name) AND spl.list_type = 'legendary'
            WHERE s.user_id=? AND date(s.created_at) >= date(?)
            AND s.methode IN ({fph}) AND s.methode NOT IN ({ph})
        """, (str(user_id), week_start, *fo, *ex))
        count_legendary_fo = int(cursor.fetchone()[0] or 0)
    else:
        count_legendary_fo = 0

    return n_games, n_methods, count_fo, n_days, n_gens, count_legendary, count_starter, count_legendary_fo

def is_variety_mission_claimed(user_id, week_start, mission_key):
    cursor.execute(
        "SELECT 1 FROM weekly_variety_claims WHERE user_id=? AND week_start=? AND mission_key=?",
        (str(user_id), week_start, mission_key)
    )
    return cursor.fetchone() is not None

def claim_variety_mission(user_id, week_start, mission_key, bonus, description):
    if is_variety_mission_claimed(user_id, week_start, mission_key):
        return False
    cursor.execute(
        "INSERT OR IGNORE INTO weekly_variety_claims (user_id, week_start, mission_key) VALUES (?,?,?)",
        (str(user_id), week_start, mission_key)
    )
    if cursor.rowcount == 0:
        return False
    short = f'[Variete: {mission_key[:25]}]'[:80]
    award_capped_bonus(user_id, short, 'weekly_objective', float(bonus))
    conn.commit()
    return True

def check_weekly_variety_missions(user_id, game, method_key, pokemon=None):
    """Retourne [(description, bonus), ...] pour les missions variété validées sur cet ajout."""
    out = []
    skip = {'race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus', 'inactivity_decay', 'season_calibration',
            'weekly_objective', 'monthly_objective', 'admin_adjustment', 'bounty_bonus',
            'participation_bonus', 'monday_first_bonus', 'new_player_bonus', 'parrainage_bonus',
            'challenge_bonus', 'type_challenge_bonus', 'season_carryover',
            'wanted_bonus'}
    if method_key in skip or method_key in VARIETY_COUNT_EXCLUDE:
        return out
    if game and normalize_str(game) == normalize_str(GAMES['dc_event']['fr']):
        return out
    week_start = get_current_week_start()
    stats = get_weekly_mission_stats(user_id, week_start, pokemon, method_key)

    # Regrouper les missions "paliers exclusifs" par kind (hunt_counter, fo_hunt_counter).
    # Pour ces kinds, la stat est un MAX (pas un cumul), donc un seul shiny peut valider
    # tous les seuils d'un coup. On ne déclenche que le palier le plus élevé atteint.
    tiered_by_kind = {}
    for mkey, kind, need, bonus, desc in WEEKLY_VARIETY_MISSIONS:
        if kind in TIERED_MISSION_KINDS:
            tiered_by_kind.setdefault(kind, []).append((need, mkey, bonus, desc))

    # Missions normales : comportement inchangé
    for mkey, kind, need, bonus, desc in WEEKLY_VARIETY_MISSIONS:
        if kind in TIERED_MISSION_KINDS:
            continue  # traité séparément ci-dessous
        if is_variety_mission_claimed(user_id, week_start, mkey):
            continue
        if mission_current_value(stats, kind) < need:
            continue
        if claim_variety_mission(user_id, week_start, mkey, bonus, desc):
            out.append((desc, float(bonus)))

    # Missions paliers exclusifs :
    # - On ne réclame que le palier le plus haut atteint non encore réclamé.
    # - Les paliers inférieurs non réclamés sont marqués silencieusement (0 pts)
    #   pour ne pas se déclencher lors d'un futur ajout de la même semaine.
    for kind, tiers in tiered_by_kind.items():
        current_val = mission_current_value(stats, kind)
        tiers_sorted = sorted(tiers, key=lambda x: x[0], reverse=True)  # plus haut en premier

        best = None
        for need, mkey, bonus, desc in tiers_sorted:
            if is_variety_mission_claimed(user_id, week_start, mkey):
                continue
            if current_val >= need:
                best = (need, mkey, bonus, desc)
                break

        if best is None:
            continue

        best_need, best_mkey, best_bonus, best_desc = best

        if claim_variety_mission(user_id, week_start, best_mkey, best_bonus, best_desc):
            out.append((best_desc, float(best_bonus)))

        # Marquer silencieusement les paliers inférieurs non réclamés (sans attribuer de points)
        for need, mkey, bonus, desc in tiers_sorted:
            if need < best_need and not is_variety_mission_claimed(user_id, week_start, mkey):
                cursor.execute(
                    "INSERT OR IGNORE INTO weekly_variety_claims (user_id, week_start, mission_key) VALUES (?,?,?)",
                    (str(user_id), week_start, mkey)
                )
        conn.commit()
    return out

class LanguageEnum(enum.Enum):
    French = "Français"
    English = "English"

def get_game_choices(language):
    """Retourne les choix de jeux selon la langue"""
    choices = []
    for game_key, translations in GAMES.items():
        name = translations["fr"] if language == "Français" else translations["en"]
        choices.append(app_commands.Choice(name=name, value=game_key))
    return choices

def get_method_choices(game_key, language):
    """Retourne les choix de méthodes pour un jeu donné dans la langue spécifiée"""
    if game_key not in METHODS_BY_GAME:
        return []
    
    choices = []
    lang_code = "fr" if language == "Français" else "en"
    
    for method_key, method_data in METHODS_BY_GAME[game_key].items():
        method_name = method_data[lang_code]
        points = method_data["points"]
        choices.append(app_commands.Choice(name=f"{method_name} ({points} pts)", value=method_key))
    return choices

def get_method_name(game_key, method_key, language):
    """Récupère le nom traduit d'une méthode"""
    if game_key not in METHODS_BY_GAME or method_key not in METHODS_BY_GAME[game_key]:
        return method_key
    
    lang_code = "fr" if language == "Français" else "en"
    return METHODS_BY_GAME[game_key][method_key][lang_code]

def calculate_console_multiplier(console_count, hunt_type="emulators"):
    """Calcule le multiplicateur selon le nombre de consoles/émulateurs et le type de chasse"""
    if hunt_type in ["emulators", "console_mods"]:
        if console_count == 1:
            return 1.0
        elif console_count == 2:
            return 0.95
        elif console_count == 3:
            return 0.9
        elif console_count == 4:
            return 0.85
        elif console_count == 5:
            return 0.75
        elif console_count == 6:
            return 0.65
        elif console_count == 7:
            return 0.55
        elif console_count == 8:
            return 0.45
        elif console_count == 9:
            return 0.35
        elif console_count == 10:
            return 0.25
        else:  # 11+
            return 0.15
    else:  # consoles
        if console_count == 1:
            return 1.0
        elif console_count == 2:
            return 1.0
        elif console_count == 3:
            return 0.98
        elif console_count == 4:
            return 0.95
        elif console_count == 5:
            return 0.92
        elif console_count == 6:
            return 0.9
        elif console_count == 7:
            return 0.85
        elif console_count == 8:
            return 0.8
        elif console_count == 9:
            return 0.75
        elif console_count == 10:
            return 0.7
        elif console_count == 11:
            return 0.65
        else:  # 12+
            return 0.6

def calculate_points(game_key, method_key, console_count=1, hunt_type="emulators"):
    """Calcule les points selon le jeu, la méthode, le nombre de consoles et le type"""
    if game_key not in METHODS_BY_GAME or method_key not in METHODS_BY_GAME[game_key]:
        return 0

    base_points = METHODS_BY_GAME[game_key][method_key]["points"]
    multiplier = calculate_console_multiplier(console_count, hunt_type)
    points = base_points * multiplier
    return points

# Lien vers le site partenaire où les joueurs peuvent trouver le taux de spawn (%)
# de chaque Pokémon shiny (page "Encounters/Slots").
SPAWN_RATE_PARTNER_URL = "https://www.pokemon-element-sh.fr/encounters-slots"

def get_spawn_rate_multiplier(spawn_percent):
    """Retourne le multiplicateur de points selon le taux de spawn (%) du Pokémon shiny.
    Plus le Pokémon est rare à faire apparaître (spawn faible), plus le multiplicateur est élevé.

    Taux de spawn   Multiplicateur
    30 % et +        ×1.00
    21-29 %          ×1.05
    16-20 %          ×1.10
    11-15 %          ×1.15
    9-10 %           ×1.20
    6-8 %            ×1.30
    5 %               ×1.40
    3-4 %            ×1.50
    2 %               ×1.65
    1 % et moins      ×1.80
    """
    if spawn_percent is None:
        return 1.0
    try:
        pct = float(spawn_percent)
    except (TypeError, ValueError):
        return 1.0

    if pct >= 30:
        return 1.00
    elif pct >= 21:
        return 1.05
    elif pct >= 16:
        return 1.10
    elif pct >= 11:
        return 1.15
    elif pct >= 9:
        return 1.20
    elif pct >= 6:
        return 1.30
    elif pct >= 5:
        return 1.40
    elif pct >= 3:
        return 1.50
    elif pct >= 2:
        return 1.65
    else:  # 1 % et moins
        return 1.80

def parse_spawn_rate_input(raw_value):
    """Parse la saisie libre du taux de spawn (%) fournie dans le modal.
    Accepte '8', '8%', '8,5', '8.5' ... Retourne None si vide/invalide."""
    if not raw_value:
        return None
    cleaned = raw_value.strip().replace('%', '').replace(',', '.')
    if not cleaned:
        return None
    try:
        pct = float(cleaned)
    except ValueError:
        return None
    if pct < 0:
        return None
    return pct

def check_duplicate_shiny_za(user_id, pokemon):
    """Vérifie si un shiny est un doublon pour Z-A pendant la saison actuelle"""
    cursor.execute(
        "SELECT COUNT(*) FROM shiny WHERE user_id = ? AND pokemon = ? AND game LIKE '%Z-A%'",
        (user_id, pokemon)
    )
    count = cursor.fetchone()[0]
    return count > 0

def get_user_streak(user_id):
    """Récupère les informations de streak d'un utilisateur"""
    cursor.execute("""
        SELECT current_streak, best_streak, last_shiny_date, streak_start_date, total_days_with_shiny
        FROM user_streaks
        WHERE user_id = ?
    """, (user_id,))
    result = cursor.fetchone()
    
    if result:
        return {
            'current_streak': result[0] or 0,
            'best_streak': result[1] or 0,
            'last_shiny_date': result[2],
            'streak_start_date': result[3],
            'total_days_with_shiny': result[4] or 0
        }
    else:
        # Initialiser l'utilisateur dans la table streaks
        cursor.execute("""
            INSERT INTO user_streaks (user_id, current_streak, best_streak, total_days_with_shiny)
            VALUES (?, 0, 0, 0)
        """, (user_id,))
        conn.commit()
        return {
            'current_streak': 0,
            'best_streak': 0,
            'last_shiny_date': None,
            'streak_start_date': None,
            'total_days_with_shiny': 0
        }

def update_user_streak(user_id, shiny_date):
    """Met à jour le streak d'un utilisateur après l'ajout d'un shiny"""
    today = datetime.now().strftime("%Y-%m-%d")
    streak_data = get_user_streak(user_id)
    
    # Vérifier si l'utilisateur a déjà ajouté un shiny aujourd'hui
    # On compte tous les shinys d'aujourd'hui (incluant celui qu'on vient d'ajouter)
    # car la fonction est appelée APRÈS l'insertion
    cursor.execute("""
        SELECT COUNT(*) FROM shiny 
        WHERE user_id = ? 
        AND DATE(created_at) = DATE('now')
    """, (user_id,))
    count_today = cursor.fetchone()[0]
    # Si c'est le 2ème shiny ou plus aujourd'hui, on ne met pas à jour le streak
    already_today = count_today > 1
    
    current_streak = streak_data['current_streak']
    best_streak = streak_data['best_streak']
    last_shiny_date = streak_data['last_shiny_date']
    streak_start_date = streak_data['streak_start_date']
    total_days = streak_data['total_days_with_shiny']
    
    # Si c'est le premier shiny aujourd'hui
    if not already_today:
        if last_shiny_date:
            last_date = datetime.strptime(last_shiny_date, "%Y-%m-%d")
            today_date = datetime.strptime(today, "%Y-%m-%d")
            days_diff = (today_date - last_date).days
            
            if days_diff == 1:
                # Streak continue
                current_streak += 1
                if streak_start_date is None:
                    streak_start_date = last_shiny_date
            elif days_diff > 1:
                # Streak cassé, on recommence
                current_streak = 1
                streak_start_date = today
            else:
                # Même jour (ne devrait pas arriver avec la vérification ci-dessus)
                pass
        else:
            # Premier shiny jamais ajouté
            current_streak = 1
            streak_start_date = today
        
        # Mettre à jour le meilleur streak
        if current_streak > best_streak:
            best_streak = current_streak
        
        # Augmenter le total de jours avec shiny
        total_days += 1
    
    # Mettre à jour dans la base de données
    cursor.execute("""
        INSERT INTO user_streaks (user_id, current_streak, best_streak, last_shiny_date, streak_start_date, total_days_with_shiny, updated_at)
        VALUES (?, ?, ?, ?, ?, ?, datetime('now'))
        ON CONFLICT(user_id) DO UPDATE SET
            current_streak = excluded.current_streak,
            best_streak = excluded.best_streak,
            last_shiny_date = excluded.last_shiny_date,
            streak_start_date = excluded.streak_start_date,
            total_days_with_shiny = excluded.total_days_with_shiny,
            updated_at = datetime('now')
    """, (user_id, current_streak, best_streak, today, streak_start_date, total_days))
    conn.commit()
    
    return current_streak

def get_shiny_count_period(user_id, period="day"):
    """Récupère le nombre de shinys sur une période donnée"""
    if period == "day":
        cursor.execute("""
            SELECT COUNT(*) FROM shiny 
            WHERE user_id = ? 
            AND DATE(created_at) = DATE('now')
        """, (user_id,))
    elif period == "week":
        cursor.execute("""
            SELECT COUNT(*) FROM shiny 
            WHERE user_id = ? 
            AND DATE(created_at) >= DATE('now', '-7 days')
        """, (user_id,))
    elif period == "month":
        cursor.execute("""
            SELECT COUNT(*) FROM shiny 
            WHERE user_id = ? 
            AND DATE(created_at) >= DATE('now', 'start of month')
        """, (user_id,))
    else:
        return 0
    
    result = cursor.fetchone()
    return result[0] if result else 0

def get_current_wanted():
    """Récupère le dernier Pokémon wanted (pour compatibilité)"""
    cursor.execute("""
        SELECT id, pokemon_name, bonus_points, decay_percent, game 
        FROM shiny_wanted 
        WHERE is_active = 1 
        ORDER BY updated_at DESC 
        LIMIT 1
    """)
    result = cursor.fetchone()
    if result:
        return {
            'id': result[0],
            'pokemon_name': result[1],
            'bonus_points': result[2],
            'decay_percent': result[3] if result[3] is not None else 100.0,
            'game': result[4]
        }
    return None

