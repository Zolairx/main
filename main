# Types Pokémon (menu FR+EN dans shiny_ajout)
POKEMON_TYPES = [
    ("Normal",   "Normal"),    ("Feu",      "Fire"),
    ("Eau",      "Water"),     ("Plante",   "Grass"),
    ("Électrik", "Electric"),  ("Glace",    "Ice"),
    ("Combat",   "Fighting"),  ("Poison",   "Poison"),
    ("Sol",      "Ground"),    ("Vol",      "Flying"),
    ("Psy",      "Psychic"),   ("Insecte",  "Bug"),
    ("Roche",    "Rock"),      ("Spectre",  "Ghost"),
    ("Dragon",   "Dragon"),    ("Ténèbres", "Dark"),
    ("Acier",    "Steel"),     ("Fée",      "Fairy"),
]

OBJECTIVE_TYPES = {
    'quantity':     'Trouver X shinys dans la semaine',
    'method':       'Trouver un shiny avec une méthode précise',
    'game':         'Trouver un shiny dans un jeu précis',
    'pokemon':      'Trouver un Pokémon shiny précis',
    'streak':       'Maintenir un streak de X jours consécutifs',
    'points':       'Accumuler X points dans la semaine',
    'race_win':     'Gagner une race shiny',
    'first_of_day': 'Être le premier à ajouter un shiny dans la journée',
    'letter':       'Trouver un shiny dont le nom commence par une lettre',
    'starter':      'Trouver un Pokémon starter',
    'legendary':    'Trouver un Pokémon légendaire',
    'pokemon_type': "Trouver un shiny d'un type précis",
}

def get_current_week_start():
    """Retourne le lundi de la semaine actuelle au format YYYY-MM-DD"""
    today = datetime.now().date()
    monday = today - timedelta(days=today.weekday())
    return str(monday)

def get_active_weekly_objectives():
    week_start = get_current_week_start()
    cursor.execute("""
        SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
        FROM weekly_objectives WHERE week_start = ? AND is_active = 1
    """, (week_start,))
    rows = cursor.fetchall()
    return [{'id':r[0],'type':r[1],'description':r[2],'target_value':r[3],
              'bonus_points':r[4],'difficulty':r[5],'target_extra':r[6]} for r in rows]

def get_user_objective_progress(user_id, objective_id):
    cursor.execute("""
        SELECT current_value, completed, bonus_awarded
        FROM weekly_objectives_progress WHERE objective_id=? AND user_id=?
    """, (objective_id, user_id))
    row = cursor.fetchone()
    if row:
        return {'current_value': row[0], 'completed': row[1], 'bonus_awarded': row[2]}
    return {'current_value': 0, 'completed': 0, 'bonus_awarded': 0}

def upsert_objective_progress(user_id, objective_id, new_value, completed=False):
    cursor.execute("""
        INSERT INTO weekly_objectives_progress (objective_id, user_id, current_value, completed, completed_at, bonus_awarded)
        VALUES (?, ?, ?, ?, CASE WHEN ? THEN datetime('now') ELSE NULL END, 0)
        ON CONFLICT(objective_id, user_id) DO UPDATE SET
            current_value = excluded.current_value,
            completed = excluded.completed,
            completed_at = CASE WHEN excluded.completed AND completed_at IS NULL THEN datetime('now') ELSE completed_at END
    """, (objective_id, user_id, new_value, 1 if completed else 0, completed))
    conn.commit()

def award_objective_bonus(user_id, objective_id, bonus_points, description):
    """Attribue le bonus d'objectif et marque comme récompensé"""
    cursor.execute("""
        UPDATE weekly_objectives_progress SET bonus_awarded=1
        WHERE objective_id=? AND user_id=?
    """, (objective_id, user_id))
    cursor.execute("""
        INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
        VALUES (?, ?, ?, ?, date('now'), ?, datetime('now'), 'fr')
    """, (user_id, f'[Objectif: {description[:40]}]', '', 'weekly_objective', bonus_points))
    conn.commit()

def check_and_update_objectives(user_id, pokemon, game, method_key, points_earned, is_first_of_day=False):
    """Vérifie et met à jour la progression des objectifs après l'ajout d'un shiny.
       Retourne liste de (description, bonus) pour les objectifs complétés."""
    # Les shinys de l'Événement DC ne comptent pas pour les objectifs
    if game and normalize_str(game) == normalize_str(GAMES['dc_event']['fr']):
        return []
    objectives = get_active_weekly_objectives()
    completed_new = []
    week_start = get_current_week_start()

    # Filtrer : seulement les objectifs que le joueur a choisis.
    # Si le joueur n'a pas encore choisi (chosen_ids vide), on n'accorde AUCUNE progression.
    chosen_ids = get_user_weekly_choices(user_id)
    if not chosen_ids:
        return []  # Pas de choix = pas de progression
    objectives = [o for o in objectives if o['id'] in chosen_ids]
    if not objectives:
        return []

    for obj in objectives:
        progress = get_user_objective_progress(user_id, obj['id'])
        if progress['completed'] and progress['bonus_awarded']:
            continue

        otype = obj['type']
        target = obj['target_value']
        extra = obj['target_extra']
        current = progress['current_value']
        new_val = current
        completed = bool(progress['completed'])

        if otype == 'quantity':
            new_val = current + 1
            completed = new_val >= target

        elif otype == 'method':
            # extra = la clé de méthode attendue
            if extra and method_key == extra:
                new_val = current + 1
                completed = new_val >= target

        elif otype == 'game':
            # extra peut être une clé de jeu (gen9, usum...) ou un nom FR (rétrocompat.)
            if extra and game:
                # Résoudre la clé depuis extra
                game_key_extra = extra if extra in GAMES else None
                if game_key_extra is None:
                    # Chercher par nom FR/EN normalisé (rétrocompat. anciennes entrées)
                    norm_extra = normalize_str(extra)
                    for gk, gv in GAMES.items():
                        if normalize_str(gv['fr']) == norm_extra or normalize_str(gv.get('en','')) == norm_extra:
                            game_key_extra = gk
                            break
                # Comparer avec le jeu du shiny ajouté
                if game_key_extra:
                    # game stocké en base = nom FR du jeu
                    game_fr = GAMES.get(game_key_extra, {}).get('fr', '')
                    if normalize_str(game) == normalize_str(game_fr):
                        new_val = current + 1
                        completed = new_val >= target
                else:
                    # Fallback : comparaison normalisée
                    if normalize_str(extra) in normalize_str(game):
                        new_val = current + 1
                        completed = new_val >= target

        elif otype == 'pokemon':
            # Comparaison insensible aux accents et à la casse
            if extra and normalize_str(pokemon) == normalize_str(extra):
                new_val = current + 1
                completed = new_val >= target

        elif otype == 'points':
            # Calculer les points de vrais shinys cette semaine (hors bonus système)
            cursor.execute("""
                SELECT COALESCE(SUM(points),0) FROM shiny
                WHERE user_id=? AND DATE(created_at) >= ?
                AND methode NOT IN (
                    'participation_bonus','weekly_objective','monthly_objective',
                    'race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
                    'admin_adjustment','bounty_bonus','season_carryover',
                    'monday_first_bonus','new_player_bonus', 'parrainage_bonus','guilde_objective_bonus',
                    'challenge_bonus','type_challenge_bonus','wanted_bonus'
                )
            """, (user_id, week_start))
            total_week = cursor.fetchone()[0] or 0
            new_val = total_week
            completed = new_val >= target

        elif otype == 'first_of_day':
            if is_first_of_day:
                new_val = current + 1
                completed = new_val >= target
            else:
                continue

        elif otype == 'streak':
            # Streak réel de jours consécutifs (table user_streaks, mise à jour
            # juste avant l'appel à cette fonction dans add_shiny)
            streak_data = get_user_streak(user_id)
            new_val = streak_data.get('current_streak', 0)
            completed = new_val >= target

        elif otype == 'race_win':
            continue

        elif otype == 'letter':
            # extra = la lettre (ex: "P")
            if extra and normalize_str(pokemon).startswith(normalize_str(extra)):
                new_val = current + 1
                completed = new_val >= target

        elif otype == 'starter':
            starters = get_special_list('starter')
            if normalize_str(pokemon) in starters:
                new_val = current + 1
                completed = new_val >= target

        elif otype == 'legendary':
            legendaries = get_special_list('legendary')
            if normalize_str(pokemon) in legendaries:
                new_val = current + 1
                completed = new_val >= target

        elif otype == 'pokemon_type':
            # extra = type attendu (ex: "Feu")
            # Récupérer le type du shiny ajouté depuis la DB (dernière entrée de cet user/pokemon)
            if extra:
                cursor.execute("""
                    SELECT type_pokemon FROM shiny WHERE user_id=?
                    AND LOWER(pokemon)=LOWER(?) ORDER BY rowid DESC LIMIT 1
                """, (user_id, pokemon))
                type_row = cursor.fetchone()
                if type_row and type_row[0]:
                    if normalize_str(type_row[0]) == normalize_str(extra):
                        new_val = current + 1
                        completed = new_val >= target

        if new_val != current or (completed and not progress['completed']):
            upsert_objective_progress(user_id, obj['id'], new_val, completed)

        if completed and not progress['bonus_awarded']:
            award_objective_bonus(user_id, obj['id'], obj['bonus_points'], obj['description'])
            completed_new.append((obj['description'], obj['bonus_points']))

    return completed_new

def update_race_win_objective(user_id):
    """Appelé quand un joueur gagne une race — met à jour les objectifs de type race_win"""
    objectives = get_active_weekly_objectives()
    completed_new = []
    for obj in objectives:
        if obj['type'] != 'race_win':
            continue
        progress = get_user_objective_progress(user_id, obj['id'])
        if progress['completed'] and progress['bonus_awarded']:
            continue
        new_val = progress['current_value'] + 1
        completed = new_val >= obj['target_value']
        upsert_objective_progress(user_id, obj['id'], new_val, completed)
        if completed and not progress['bonus_awarded']:
            award_objective_bonus(user_id, obj['id'], obj['bonus_points'], obj['description'])
            completed_new.append((obj['description'], obj['bonus_points']))
    return completed_new

def draw_weekly_objectives():
    """Tire aléatoirement 4 objectifs du pool pour la semaine en cours (joueurs choisissent 2 parmi 4)."""
    week_start = get_current_week_start()
    cursor.execute("SELECT COUNT(*) FROM weekly_objectives WHERE week_start=? AND is_active=1", (week_start,))
    if cursor.fetchone()[0] > 0:
        return False, "Des objectifs existent déjà pour cette semaine."

    drawn = []
    # Tirer 4 objectifs : 1 easy, 1 hard + 2 medium (ou fallback si manque)
    targets = ['easy', 'medium', 'medium', 'hard']
    used_ids = set()
    for diff in targets:
        cursor.execute("""
            SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
            FROM objectives_pool WHERE difficulty=? AND is_active=1 AND id NOT IN ({})
            ORDER BY RANDOM() LIMIT 1
        """.format(','.join('?' * len(used_ids)) if used_ids else '0'), (diff, *used_ids))
        row = cursor.fetchone()
        if not row:
            # Fallback : n'importe quel objectif non encore tiré
            cursor.execute("""
                SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
                FROM objectives_pool WHERE is_active=1 AND id NOT IN ({})
                ORDER BY RANDOM() LIMIT 1
            """.format(','.join('?' * len(used_ids)) if used_ids else '0'), tuple(used_ids))
            row = cursor.fetchone()
        if row:
            used_ids.add(row[0])
            cursor.execute("""
                INSERT INTO weekly_objectives (type, description, target_value, bonus_points, difficulty, target_extra, week_start, is_active)
                VALUES (?, ?, ?, ?, ?, ?, ?, 1)
            """, (row[1], row[2], row[3], row[4], row[5], row[6], week_start))
            drawn.append(row[2])
    conn.commit()

    # Réinitialiser les choix de tous les joueurs pour la nouvelle semaine
    cursor.execute("DELETE FROM weekly_player_choices WHERE week_start != ?", (week_start,))
    conn.commit()

    return True, drawn

def get_user_weekly_choices(user_id):
    """Retourne les IDs des 2 objectifs choisis par le joueur cette semaine."""
    week_start = get_current_week_start()
    cursor.execute("""
        SELECT objective_id FROM weekly_player_choices
        WHERE user_id=? AND week_start=?
    """, (str(user_id), week_start))
    return [r[0] for r in cursor.fetchall()]

def save_user_weekly_choices(user_id, objective_ids):
    """Enregistre le choix de 2 objectifs pour le joueur cette semaine."""
    week_start = get_current_week_start()
    cursor.execute("DELETE FROM weekly_player_choices WHERE user_id=? AND week_start=?", (str(user_id), week_start))
    for oid in objective_ids:
        cursor.execute("""
            INSERT OR IGNORE INTO weekly_player_choices (user_id, week_start, objective_id)
            VALUES (?, ?, ?)
        """, (str(user_id), week_start, oid))
    conn.commit()

def get_special_list(list_type):
    """Retourne la liste des Pokémon d'un type spécial (starter / legendary)."""
    cursor.execute("SELECT pokemon_name FROM special_pokemon_lists WHERE list_type=?", (list_type,))
    return {normalize_str(r[0]) for r in cursor.fetchall()}

async def auto_weekly_draw():
    """Tâche de fond : tire objectifs + reset compteurs chaque lundi à 00h00"""
    await bot.wait_until_ready()
    while not bot.is_closed():
        now = datetime.now()
        days_until_monday = (7 - now.weekday()) % 7
        if days_until_monday == 0 and now.hour == 0 and now.minute < 5:
            # Tirage objectifs
            ok, result = draw_weekly_objectives()
            if ok:
                logger.info(f"✅ Tirage automatique objectifs semaine : {result}")
            # Tirage du jeu de la semaine + annonce
            try:
                chosen_game = draw_weekly_game()
                game_label = GAMES.get(chosen_game, {}).get('fr', chosen_game)
                announce_ch = bot.get_channel(WEEKLY_GAME_BONUS_ANNOUNCE_CHANNEL)
                if announce_ch:
                    embed = discord.Embed(
                        title="🎮 Jeu de la Semaine — Bonus Disponible !",
                        description=(
                            f"Cette semaine, le **bonus de 20 pts** est attribué au **premier joueur**\n"
                            f"à enregistrer un shiny dans :\n\n"
                            f"✨ **{game_label}**\n\n"
                            f"Utilisez `/shiny_ajout` pour tenter de le décrocher !"
                        ),
                        color=discord.Color.gold()
                    )
                    embed.set_footer(text="ShinyBot · Jeu de la semaine — 1 seul gagnant possible !")
                    await announce_ch.send(embed=embed)
                logger.info(f"✅ Jeu de la semaine tiré : {chosen_game} ({game_label})")
            except Exception as e:
                logger.error(f"Erreur tirage jeu de la semaine: {e}")
            # Les compteurs hebdo sont basés sur week_start donc se réinitialisent naturellement
            # On nettoie les vieilles entrées (> 4 semaines)
            cursor.execute("""
                DELETE FROM weekly_points_tracking
                WHERE week_start < date('now', '-28 days')
            """)
            conn.commit()
            logger.info("✅ Nettoyage compteurs hebdo effectué")
            await asyncio.sleep(600)
        else:
            if days_until_monday == 0:
                days_until_monday = 7
            next_monday = now + timedelta(days=days_until_monday)
            next_monday = next_monday.replace(hour=0, minute=0, second=0, microsecond=0)
            wait_seconds = (next_monday - now).total_seconds()
            logger.info(f"⏳ Prochain tirage objectifs dans {wait_seconds/3600:.1f}h")
            await asyncio.sleep(min(wait_seconds, 3600))


async def auto_assign_weekly_choices():
    """Tâche de fond : assigne automatiquement les 2 premiers objectifs aux joueurs
       qui n'ont pas encore choisi après 2 jours (mercredi 00h00)."""
    await bot.wait_until_ready()
    while not bot.is_closed():
        now = datetime.now()
        week_start = get_current_week_start()

        # Se déclenche mercredi (weekday=2) à 00h00
        if now.weekday() == 2 and now.hour == 0 and now.minute < 5:
            objectives = get_active_weekly_objectives()
            if len(objectives) >= 2:
                # Récupérer tous les joueurs actifs cette semaine ou la semaine précédente
                cursor.execute("""
                    SELECT DISTINCT user_id FROM shiny
                    WHERE DATE(created_at) >= DATE('now', '-14 days')
                """)
                active_users = [r[0] for r in cursor.fetchall()]

                assigned = 0
                for uid in active_users:
                    chosen = get_user_weekly_choices(uid)
                    if not chosen:
                        # Assigner les 2 premiers objectifs du pool de la semaine (1 easy/medium + 1 medium/hard)
                        auto_ids = [objectives[0]['id'], objectives[-1]['id']]
                        if auto_ids[0] == auto_ids[1] and len(objectives) >= 2:
                            auto_ids[1] = objectives[1]['id']
                        save_user_weekly_choices(uid, auto_ids)
                        assigned += 1

                if assigned > 0:
                    logger.info(f"✅ Auto-assignation objectifs semaine : {assigned} joueur(s) assigné(s)")
            await asyncio.sleep(600)  # Éviter double déclenchement
        else:
            # Calculer le prochain mercredi 00h00
            days_until_wednesday = (2 - now.weekday()) % 7
            if days_until_wednesday == 0:
                days_until_wednesday = 7
            next_wed = now + timedelta(days=days_until_wednesday)
            next_wed = next_wed.replace(hour=0, minute=0, second=0, microsecond=0)
            wait_seconds = (next_wed - now).total_seconds()
            await asyncio.sleep(min(wait_seconds, 3600))


# ---- Commandes objectifs ----

class WeeklyChoiceView(discord.ui.View):
    """Vue pour choisir 2 objectifs parmi 4."""
    def __init__(self, objectives, user_id):
        super().__init__(timeout=300)
        self.objectives = objectives
        self.user_id    = user_id
        diff_emoji = {'easy': '🟢', 'medium': '🟡', 'hard': '🔴'}
        options = [
            discord.SelectOption(
                label=f"{diff_emoji.get(o['difficulty'],'⚪')} {o['description']}"[:100],
                value=str(o['id']),
                description=f"+{o['bonus_points']} pts — {o['difficulty'].upper()}"[:100]
            )
            for o in objectives
        ]
        sel = discord.ui.Select(
            placeholder="Choisissez 2 objectifs…",
            options=options,
            min_values=2,
            max_values=2
        )
        sel.callback = self.on_select
        self.add_item(sel)

    async def on_select(self, interaction: discord.Interaction):
        if str(interaction.user.id) != self.user_id:
            await interaction.response.send_message("❌ Ce menu ne vous appartient pas.", ephemeral=True)
            return
        chosen_ids = [int(v) for v in interaction.data['values']]
        save_user_weekly_choices(self.user_id, chosen_ids)

        chosen_objs = [o for o in self.objectives if o['id'] in chosen_ids]
        diff_emoji = {'easy': '🟢', 'medium': '🟡', 'hard': '🔴'}
        embed = discord.Embed(
            title="✅ Objectifs choisis !",
            description="Vos 2 objectifs de la semaine sont :",
            color=discord.Color.gold()
        )
        for obj in chosen_objs:
            embed.add_field(
                name=f"{diff_emoji.get(obj['difficulty'],'⚪')} {obj['description']}",
                value=f"⭐ +{obj['bonus_points']} pts | Difficulté : **{obj['difficulty'].upper()}**",
                inline=False
            )
        embed.set_footer(text="Bonne chance ! Les objectifs se renouvellent chaque lundi • ShinyBot")
        await interaction.response.edit_message(embed=embed, view=None)


@bot.tree.command(
    name="objectifs",
    description="Voir tes objectifs (semaine et mois) avec ta progression",
    guild=discord.Object(id=GUILD_ID)
)
async def objectifs(interaction: discord.Interaction):
    await interaction.response.defer(ephemeral=True)
    user_id = str(interaction.user.id)

    async def build_embed(page: str) -> discord.Embed:
        if page == "semaine":
            objectives = get_active_weekly_objectives()
            week_start = get_current_week_start()

            if not objectives:
                embed = discord.Embed(
                    title="📅 Objectifs Hebdomadaires",
                    description="Aucun objectif actif cette semaine.\nLes admins peuvent en créer avec `/admin_objectif_add`.",
                    color=discord.Color.light_grey()
                )
                return embed

            chosen_ids = get_user_weekly_choices(user_id)
            # Si les choix pointent vers des objectifs qui n'existent plus
            # (semaine effacée puis retirée après le choix du joueur), on les
            # traite comme "pas encore choisi" plutôt que d'afficher un embed vide.
            valid_ids = {o["id"] for o in objectives}
            if chosen_ids and not (set(chosen_ids) & valid_ids):
                chosen_ids = []

            if not chosen_ids:
                diff_emoji = {"easy": "🟢", "medium": "🟡", "hard": "🔴"}
                embed = discord.Embed(
                    title="📅 Choisissez vos 2 objectifs de la semaine",
                    description=f"Semaine du **{week_start}**\n\n4 objectifs sont disponibles, **choisissez-en 2** :",
                    color=discord.Color.gold()
                )
                for obj in objectives:
                    embed.add_field(
                        name=f"{diff_emoji.get(obj['difficulty'],'⚪')} [{obj['difficulty'].upper()}] {obj['description']}",
                        value=f"⭐ +{obj['bonus_points']} pts",
                        inline=False
                    )
                embed.set_footer(text="Ce choix est définitif pour la semaine • ShinyBot")
                return embed

            diff_emoji = {"easy": "🟢", "medium": "🟡", "hard": "🔴"}
            chosen_objs = [o for o in objectives if o["id"] in chosen_ids]
            embed = discord.Embed(
                title="📅 Mes Objectifs de la Semaine",
                description=f"Semaine du **{week_start}**",
                color=discord.Color.gold()
            )
            all_done = True
            for obj in chosen_objs:
                progress = get_user_objective_progress(user_id, obj["id"])
                current = progress["current_value"]
                target = obj["target_value"]
                completed = bool(progress["completed"])
                awarded = bool(progress["bonus_awarded"])
                if not completed:
                    all_done = False
                tgt_str = int(target) if target == int(target) else target
                status = "✅ Complété !" if completed else f"⏳ {current}/{tgt_str}"
                reward = " 💰 Bonus reçu !" if awarded else (f" → +{obj['bonus_points']} pts" if completed else f" → +{obj['bonus_points']} pts à gagner")
                bar_filled = int((min(current, target) / target) * 10) if target > 0 else 0
                bar = "█" * bar_filled + "░" * (10 - bar_filled)
                embed.add_field(
                    name=f"{diff_emoji.get(obj['difficulty'],'⚪')} [{obj['difficulty'].upper()}] {obj['description']}",
                    value=f"{status}{reward}\n`{bar}`",
                    inline=False
                )
            if all_done and chosen_objs:
                embed.add_field(name="🌟 TOUS COMPLÉTÉS !", value="Félicitations, tous tes objectifs de la semaine sont faits !", inline=False)
            embed.set_footer(text="Les objectifs se renouvellent chaque lundi à minuit • ShinyBot")
            return embed

        else:  # mois
            objectives = get_active_monthly_objectives()
            month_start = get_current_month_start()

            if not objectives:
                return discord.Embed(
                    title="📆 Objectifs Mensuels",
                    description="Aucun objectif actif ce mois.\nLes admins peuvent en créer avec `/admin_objectif_mensuel_add`.",
                    color=discord.Color.light_grey()
                )

            diff_emoji = {"easy": "🟢", "medium": "🟡", "hard": "🔴", "": "⚪"}
            embed = discord.Embed(
                title="📆 Objectifs du Mois",
                description=f"Mois de **{month_start[:7]}**",
                color=discord.Color.purple()
            )
            for obj in objectives:
                progress = get_user_monthly_progress(user_id, obj["id"])
                current = progress["current_value"]
                target = obj["target_value"]
                completed = bool(progress["completed"])
                awarded = bool(progress["bonus_awarded"])
                tgt_str = int(target) if target == int(target) else target
                status = "✅ Complété !" if completed else f"⏳ {current}/{tgt_str}"
                reward = " 💰 Bonus reçu !" if awarded else (f" → +{obj['bonus_points']} pts" if completed else f" → +{obj['bonus_points']} pts à gagner")
                bar_filled = int((min(current, target) / target) * 10) if target > 0 else 0
                bar = "█" * bar_filled + "░" * (10 - bar_filled)
                embed.add_field(
                    name=f"{diff_emoji.get(obj['difficulty'],'⚪')} [{obj['difficulty'].upper()}] {obj['description']}",
                    value=f"{status}{reward}\n`{bar}`",
                    inline=False
                )
            embed.set_footer(text="Les objectifs mensuels se renouvellent le 1er de chaque mois • ShinyBot")
            return embed

    class ObjectifsView(discord.ui.View):
        def __init__(self, user_id, page="semaine"):
            super().__init__(timeout=300)
            self.user_id = user_id
            self.page = page
            self._update_buttons()

        def _update_buttons(self):
            for item in self.children:
                if hasattr(item, "custom_id"):
                    item.style = discord.ButtonStyle.primary if item.custom_id == f"obj_{self.page}" else discord.ButtonStyle.secondary

        async def interaction_check(self, inter: discord.Interaction) -> bool:
            if str(inter.user.id) != self.user_id:
                await inter.response.send_message("❌ Ce menu n'est pas le tien.", ephemeral=True)
                return False
            return True

        @discord.ui.button(label="📅 Cette semaine", style=discord.ButtonStyle.primary, custom_id="obj_semaine")
        async def btn_semaine(self, inter: discord.Interaction, button: discord.ui.Button):
            self.page = "semaine"
            self._update_buttons()
            objectives = get_active_weekly_objectives()
            chosen_ids = get_user_weekly_choices(self.user_id)
            valid_ids = {o["id"] for o in objectives}
            if chosen_ids and not (set(chosen_ids) & valid_ids):
                chosen_ids = []
            if objectives and not chosen_ids:
                embed = await build_embed("semaine")
                await inter.response.edit_message(embed=embed, view=WeeklyChoiceView(objectives, self.user_id))
            else:
                await inter.response.edit_message(embed=await build_embed("semaine"), view=self)

        @discord.ui.button(label="📆 Ce mois", style=discord.ButtonStyle.secondary, custom_id="obj_mois")
        async def btn_mois(self, inter: discord.Interaction, button: discord.ui.Button):
            self.page = "mois"
            self._update_buttons()
            await inter.response.edit_message(embed=await build_embed("mois"), view=self)

    initial_embed = await build_embed("semaine")
    objectives = get_active_weekly_objectives()
    chosen_ids = get_user_weekly_choices(user_id)
    valid_ids = {o["id"] for o in objectives}
    if chosen_ids and not (set(chosen_ids) & valid_ids):
        chosen_ids = []
    if objectives and not chosen_ids:
        view = WeeklyChoiceView(objectives, user_id)
    else:
        view = ObjectifsView(user_id, "semaine")
    await interaction.followup.send(embed=initial_embed, view=view, ephemeral=True)


@bot.tree.command(
    name="quoi_faire",
    description="Analyse ta progression et te propose des actions utiles à faire maintenant",
    guild=discord.Object(id=GUILD_ID)
)
async def quoi_faire(interaction: discord.Interaction):
    await interaction.response.defer(ephemeral=True)
    user_id = str(interaction.user.id)

    # Liste de suggestions : (priorite, emoji, texte). Priorite basse = plus urgent/pertinent.
    suggestions = []

    # 1. Objectif hebdo perso proche de la complétion
    try:
        objectives = get_active_weekly_objectives()
        chosen_ids = set(get_user_weekly_choices(user_id) or [])
        valid_ids = {o["id"] for o in objectives}
        chosen_objs = [o for o in objectives if o["id"] in chosen_ids and o["id"] in valid_ids]
        for obj in chosen_objs:
            progress = get_user_objective_progress(user_id, obj["id"])
            if progress["completed"]:
                continue
            current = progress["current_value"] or 0
            target = obj["target_value"]
            if not target or target <= 0:
                continue
            remaining = target - current
            if remaining <= 0:
                continue
            if remaining <= 1 or (current / target) >= 0.8:
                remaining_str = int(remaining) if remaining == int(remaining) else remaining
                suggestions.append((
                    1, "🎯",
                    f"Tu es à **{remaining_str}** de ton objectif hebdo : *{obj['description']}* (+{obj['bonus_points']} pts)"
                ))
    except Exception:
        pass

    # 2. Wanted personnel qui expire bientôt
    try:
        wanted = get_active_personal_wanted(user_id)
        if wanted:
            wanted_id, wanted_pokemon, gen, bonus_pts, expires_at = wanted
            try:
                expires_dt = datetime.strptime(str(expires_at)[:19], "%Y-%m-%d %H:%M:%S")
            except Exception:
                expires_dt = None
            if expires_dt:
                remaining_hours = (expires_dt - datetime.now()).total_seconds() / 3600
                if remaining_hours <= 48:
                    if remaining_hours <= 24:
                        delai = "aujourd'hui" if remaining_hours <= 6 else "demain"
                    else:
                        delai = f"dans {int(remaining_hours // 24) + 1} jours"
                    suggestions.append((
                        1, "🎯",
                        f"Ton wanted perso **{wanted_pokemon}** expire {delai} ! (+{int(bonus_pts) if bonus_pts == int(bonus_pts) else bonus_pts} pts)"
                    ))
    except Exception:
        pass

    # 3. Opportunité Full Odds sur un jeu récemment chassé
    try:
        prefs = get_user_preferences(user_id)
        for game_key in prefs.get('recent_games', []):
            if game_key not in RETRO_LADDER_FULL_ODDS_ONLY_GAME_KEYS:
                continue
            recent_method = prefs.get('recent_methods', {}).get(game_key)
            if recent_method and is_full_odds_method(recent_method):
                continue  # déjà en Full Odds sur ce jeu
            fo_methods = [
                mk for mk in METHODS_BY_GAME.get(game_key, {})
                if str(mk).lower().startswith('full_odds') and 'horde' not in str(mk).lower()
            ]
            if fo_methods:
                game_name = GAMES.get(game_key, {}).get('fr', game_key)
                suggestions.append((
                    2, "🎲",
                    f"Un **Full Odds** sur **{game_name}** compterait dans le Classement Full Odds !"
                ))
                break
    except Exception:
        pass

    # 4. Objectif de guilde proche d'être validé
    try:
        guilde = guilde_of_user(user_id)
        if guilde:
            guilde_id, guilde_nom = guilde[0], guilde[1]
            choice = get_guilde_weekly_choice(guilde_id)
            if choice:
                progress = get_guilde_objective_progress(guilde_id, choice["id"])
                if not progress["completed"]:
                    current = progress["current_value"] or 0
                    target = choice["target_value"]
                    if target and target > 0 and (current / target) >= 0.7:
                        pct = int((current / target) * 100)
                        suggestions.append((
                            1, "🏰",
                            f"Ta guilde **{guilde_nom}** est proche de valider son objectif : *{choice['description']}* ({pct}%)"
                        ))
    except Exception:
        pass

    # 5. Filler : mission variété la plus proche de la complétion
    try:
        closest = get_closest_weekly_mission(user_id)
        if closest:
            desc, bonus, current, need = closest
            remaining = need - current
            if remaining > 0:
                suggestions.append((
                    3, "✨",
                    f"Encore **{remaining}** et tu valides la mission variété : *{desc}* (+{bonus} pts)"
                ))
    except Exception:
        pass

    suggestions.sort(key=lambda s: s[0])
    top = suggestions[:3]

    embed = discord.Embed(
        title="🧭 Quoi faire maintenant ?",
        color=discord.Color.blurple()
    )
    if top:
        embed.description = "\n\n".join(f"{emoji} {texte}" for _, emoji, texte in top)
    else:
        embed.description = "Rien d'urgent pour le moment ! Fonce sur la chasse de ton choix. 🍀"
    embed.set_footer(text="Astuce personnalisée • ShinyBot")

    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="parrainer",
    description="Parraine un nouveau joueur : bonus pour vous deux à son tout premier shiny",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(filleul="Le nouveau joueur que tu souhaites parrainer")
async def parrainer(interaction: discord.Interaction, filleul: discord.Member):
    parrain_id = str(interaction.user.id)
    filleul_id = str(filleul.id)

    if filleul.bot:
        await interaction.response.send_message("❌ Tu ne peux pas parrainer un bot.", ephemeral=True)
        return

    try:
        create_parrainage(parrain_id, filleul_id)
    except ValueError as e:
        reason = str(e)
        if reason == "self":
            msg = "❌ Tu ne peux pas te parrainer toi-même !"
        elif reason == "already_sponsored":
            existing = get_parrainage(filleul_id)
            if existing and existing[1] == parrain_id:
                msg = f"ℹ️ Tu parraines déjà {filleul.mention}."
            else:
                msg = f"❌ {filleul.mention} a déjà un parrain."
        elif reason == "not_new":
            msg = (
                f"❌ {filleul.mention} a déjà des shinys enregistrés — le parrainage "
                f"n'est possible qu'avant son tout premier shiny."
            )
        else:
            msg = "❌ Parrainage impossible."
        await interaction.response.send_message(msg, ephemeral=True)
        return

    embed = discord.Embed(
        title="🤝 Parrainage enregistré !",
        description=(
            f"{interaction.user.mention} parraine désormais {filleul.mention} !\n\n"
            f"Vous recevrez chacun **+{PARRAINAGE_BONUS_POINTS} pts** dès que "
            f"{filleul.mention} loggera son tout premier shiny."
        ),
        color=discord.Color.gold()
    )
    await interaction.response.send_message(embed=embed, ephemeral=False)


@bot.tree.command(
    name="admin_objectif_add",
    description="[ADMIN] Créer un objectif hebdomadaire en 3 étapes",
    guild=discord.Object(id=GUILD_ID)
)
async def admin_objectif_add(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    view = ObjectiveBuilderStep1(mode="weekly")
    embed = discord.Embed(
        title="📅 Créer un Objectif Hebdomadaire",
        description="**Étape 1/3** — Quel est le type d'objectif ?",
        color=discord.Color.gold()
    )
    await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


# ─────────────────────────────────────────────────────────────
# SYSTÈME UNIFIÉ DE CRÉATION D'OBJECTIFS EN 3 ÉTAPES
# Utilisé par les objectifs hebdomadaires ET mensuels
# ─────────────────────────────────────────────────────────────

# Labels lisibles pour chaque type
OBJECTIVE_TYPE_LABELS = {
    "quantity":     ("✨ Trouver X shinys",              "Peu importe le Pokémon ou le jeu"),
    "pokemon":      ("🎯 Trouver un Pokémon précis",     "Tu choisiras le Pokémon ensuite"),
    "game":         ("🎮 Trouver un shiny dans un jeu",  "Tu choisiras le jeu ensuite"),
    "race_win":     ("🏁 Gagner X race(s)",              "Race 1v1 ou en équipe"),
    "first_of_day": ("🌅 Être le premier du jour X fois","Premier shiny de la journée"),
    "points":       ("⭐ Accumuler X points",            "Points de la période"),
    "streak":       ("🔥 Streak de X jours",            "Jours consécutifs avec un shiny"),
    "letter":       ("🔤 Nom commence par une lettre",  "Tu indiqueras la lettre ensuite"),
    "starter":      ("🌱 Trouver un Pokémon starter",   "Liste des starters définie en config"),
    "legendary":    ("⭐ Trouver un légendaire",         "Liste des légendaires définie en config"),
    "pokemon_type": ("🔷 Trouver un shiny d'un type",   "Tu choisiras le type ensuite"),
}
MONTHLY_TYPE_LABELS = {
    **OBJECTIVE_TYPE_LABELS,
    "top3_month":   ("🥇 Finir top 3 du classement",    "En fin de mois"),
    "streak_days":  ("📅 Streak de X jours en fin de mois", "Valeur du streak au 1er du mois suivant"),
}

# Types qui nécessitent une valeur numérique cible
TYPES_WITH_TARGET = {"quantity", "race_win", "first_of_day", "points", "streak",
                     "top3_month", "streak_days"}
# Types qui nécessitent un sélecteur supplémentaire
TYPES_WITH_GAME    = {"game"}
TYPES_WITH_POKEMON = {"pokemon"}
TYPES_WITH_LETTER  = {"letter"}
TYPES_WITH_TYPE    = {"pokemon_type"}
# Starter et légendaire n'ont pas de sélecteur supplémentaire (liste auto)
TYPES_NO_EXTRA     = {"starter", "legendary"}


class ObjectiveBuilderStep1(discord.ui.View):
    """Étape 1 : Sélection du type d'objectif"""
    def __init__(self, mode: str):  # mode = "weekly" | "monthly"
        super().__init__(timeout=300)
        self.mode = mode
        labels = MONTHLY_TYPE_LABELS if mode == "monthly" else OBJECTIVE_TYPE_LABELS
        options = [
            discord.SelectOption(label=label[:100], description=desc[:100], value=otype)
            for otype, (label, desc) in labels.items()
        ]
        sel = discord.ui.Select(
            placeholder="Choisir le type d'objectif",
            options=options,
            min_values=1, max_values=1
        )
        sel.callback = self.type_selected
        self.add_item(sel)

    async def type_selected(self, interaction: discord.Interaction):
        otype = interaction.data["values"][0]
        labels = MONTHLY_TYPE_LABELS if self.mode == "monthly" else OBJECTIVE_TYPE_LABELS
        type_label = labels[otype][0]

        if otype in TYPES_WITH_GAME:
            view = ObjectiveBuilderStep2Game(otype, self.mode)
            embed = discord.Embed(
                title="📅 Créer un Objectif",
                description=f"Type : **{type_label}**\n\n**Étape 2/3** — Choisissez le jeu :",
                color=discord.Color.gold() if self.mode == "weekly" else discord.Color.purple()
            )
            await interaction.response.edit_message(embed=embed, view=view)

        elif otype in TYPES_WITH_POKEMON:
            modal = ObjectiveBuilderPokemonModal(otype, self.mode)
            await interaction.response.send_modal(modal)

        elif otype in TYPES_WITH_LETTER:
            modal = ObjectiveBuilderLetterModal(self.mode)
            await interaction.response.send_modal(modal)

        elif otype in TYPES_WITH_TYPE:
            view = ObjectiveBuilderTypeSelect(self.mode)
            embed = discord.Embed(
                title="📅 Créer un Objectif",
                description=f"Type : **{type_label}**\n\n**Étape 2/3** — Choisissez le type Pokémon :",
                color=discord.Color.gold() if self.mode == "weekly" else discord.Color.purple()
            )
            await interaction.response.edit_message(embed=embed, view=view)

        elif otype in TYPES_NO_EXTRA:
            # Starter / Légendaire : cible = 1, pas de sélecteur supplémentaire
            modal = ObjectiveBuilderFinalModal(otype, extra=None, mode=self.mode, extra_label=None)
            await interaction.response.send_modal(modal)

        else:
            view = ObjectiveBuilderStep2Confirm(otype, self.mode)
            embed = discord.Embed(
                title="📅 Créer un Objectif",
                description=(
                    f"Type : **{type_label}**\n\n"
                    "Cliquez sur **▶️ Configurer l'objectif** pour définir\n"
                    "la valeur cible, les points bonus et la destination."
                ),
                color=discord.Color.gold() if self.mode == "weekly" else discord.Color.purple()
            )
            await interaction.response.edit_message(embed=embed, view=view)


class ObjectiveBuilderStep2Confirm(discord.ui.View):
    """Étape intermédiaire pour les types numériques — bouton pour ouvrir le modal final"""
    def __init__(self, otype: str, mode: str):
        super().__init__(timeout=300)
        self.otype = otype
        self.mode = mode

        btn = discord.ui.Button(
            label="▶️ Configurer l'objectif",
            style=discord.ButtonStyle.primary
        )
        btn.callback = self.open_final_modal
        self.add_item(btn)

    async def open_final_modal(self, interaction: discord.Interaction):
        modal = ObjectiveBuilderFinalModal(self.otype, extra=None, mode=self.mode)
        await interaction.response.send_modal(modal)


class ObjectiveBuilderStep2Game(discord.ui.View):
    """Étape 2 : Sélection du jeu pour type=game"""
    def __init__(self, otype: str, mode: str):
        super().__init__(timeout=300)
        self.otype = otype
        self.mode = mode
        options = [discord.SelectOption(label=v["fr"][:100], value=k) for k, v in GAMES.items()]
        if len(options) <= 25:
            sel = discord.ui.Select(placeholder="🎮 Choisir le jeu", options=options, min_values=1, max_values=1)
            sel.callback = self.game_selected
            self.add_item(sel)
        else:
            sel1 = discord.ui.Select(placeholder="🎮 Jeux (1/2)", options=options[:25], min_values=1, max_values=1)
            sel1.callback = self.game_selected
            self.add_item(sel1)
            sel2 = discord.ui.Select(placeholder="🎮 Jeux (2/2)", options=options[25:50], min_values=1, max_values=1)
            sel2.callback = self.game_selected
            self.add_item(sel2)

    async def game_selected(self, interaction: discord.Interaction):
        game_key = interaction.data["values"][0]
        game_name = GAMES[game_key]["fr"]
        modal = ObjectiveBuilderFinalModal(self.otype, extra=game_key, mode=self.mode, extra_label=game_name)
        await interaction.response.send_modal(modal)


class ObjectiveBuilderPokemonModal(discord.ui.Modal):
    """Étape 2+3 fusionnées : Saisie du Pokémon + infos finales en un seul modal"""
    def __init__(self, otype: str, mode: str):
        super().__init__(title="Objectif Pokémon précis")
        self.otype = otype
        self.mode = mode

        self.pokemon_input = discord.ui.TextInput(
            label="Nom du Pokémon à trouver",
            placeholder="Ex: Évoli, Pikachu, Dracaufeu...",
            required=True, max_length=50
        )
        self.desc_input = discord.ui.TextInput(
            label="Description (laisser vide = auto)",
            placeholder="Ex: Trouver un Évoli shiny",
            required=False, max_length=150
        )
        self.bonus_input = discord.ui.TextInput(
            label="Points bonus à attribuer",
            placeholder="Ex: 5",
            required=True, max_length=6
        )
        self.diff_input = discord.ui.TextInput(
            label="Difficulté : easy / medium / hard",
            placeholder="easy",
            required=True, max_length=6
        )
        self.dest_input = discord.ui.TextInput(
            label="Destination : pool ou semaine (ou mois)",
            placeholder="pool  (ou: semaine / mois)",
            required=True, max_length=10
        )
        self.add_item(self.pokemon_input)
        self.add_item(self.desc_input)
        self.add_item(self.bonus_input)
        self.add_item(self.diff_input)
        self.add_item(self.dest_input)

    async def on_submit(self, interaction: discord.Interaction):
        pokemon_val = self.pokemon_input.value.strip()

        diff = self.diff_input.value.strip().lower()
        if diff not in ("easy", "medium", "hard"):
            await interaction.response.send_message("❌ Difficulté invalide. Utilisez : easy, medium ou hard.", ephemeral=True)
            return

        try:
            bonus = float(self.bonus_input.value.strip().replace(",", "."))
            if bonus <= 0:
                raise ValueError
        except ValueError:
            await interaction.response.send_message("❌ Points bonus invalides.", ephemeral=True)
            return

        desc_raw = self.desc_input.value.strip()
        desc = desc_raw if desc_raw else f"Trouver un {pokemon_val} shiny"

        dest_raw = self.dest_input.value.strip().lower()
        if self.mode == "weekly":
            destination = "pool" if dest_raw in ("pool", "p") else "week"
            dest_label = "pool hebdomadaire" if destination == "pool" else "semaine en cours"
        else:
            destination = "monthly_pool" if dest_raw in ("pool", "p") else "monthly"
            dest_label = "pool mensuel" if destination == "monthly_pool" else "mois en cours"

        user_id = str(interaction.user.id)
        if self.mode == "weekly":
            save_objective(self.otype, desc, 1.0, bonus, diff, pokemon_val, destination, user_id)
        else:
            save_monthly_objective(self.otype, desc, 1.0, bonus, diff, pokemon_val, destination, user_id)

        await interaction.response.send_message(
            f"✅ Objectif **{desc}** ajouté au **{dest_label}** !\n"
            f"🎯 Pokémon : **{pokemon_val}** | ⭐ Bonus : **+{bonus} pts** | Difficulté : **{diff}**",
            ephemeral=True
        )


class ObjectiveBuilderFinalModal(discord.ui.Modal):
    """Étape 3 : Description, valeur cible, points bonus, difficulté, destination"""
    def __init__(self, otype: str, extra, mode: str, extra_label: str = None):
        super().__init__(title="Finaliser l'objectif")
        self.otype = otype
        self.extra = extra
        self.mode = mode
        self.extra_label = extra_label or extra or ""

        labels = MONTHLY_TYPE_LABELS if mode == "monthly" else OBJECTIVE_TYPE_LABELS
        type_label = labels.get(otype, (otype,))[0]

        # Description pré-remplie selon le type
        default_desc = self._default_description(otype, extra_label)

        self.desc_input = discord.ui.TextInput(
            label="Description affichée aux joueurs",
            default=default_desc if default_desc else None,
            required=True, max_length=150
        )
        # Valeur cible
        needs_target = otype in TYPES_WITH_TARGET
        self.target_input = discord.ui.TextInput(
            label="Valeur cible (ex: 3 shinys, 100 pts, 5 jours)",
            placeholder="Ex: 3",
            required=True,
            default="1" if not needs_target else None,
            max_length=10
        )
        self.bonus_input = discord.ui.TextInput(
            label="Points bonus à attribuer",
            placeholder="Ex: 5",
            required=True, max_length=6
        )
        self.diff_input = discord.ui.TextInput(
            label="Difficulté : easy / medium / hard",
            placeholder="easy",
            required=True, max_length=6
        )
        self.dest_input = discord.ui.TextInput(
            label="Destination : pool ou semaine (ou mois)",
            placeholder="pool  (ou: semaine / mois)",
            required=True, max_length=10
        )
        self.add_item(self.desc_input)
        self.add_item(self.target_input)
        self.add_item(self.bonus_input)
        self.add_item(self.diff_input)
        self.add_item(self.dest_input)

    def _default_description(self, otype, extra_label):
        el = extra_label or "?"
        defaults = {
            "quantity":     "Trouver {n} shinys",
            "pokemon":      f"Trouver un {el} shiny",
            "game":         f"Trouver un shiny dans {el}",
            "race_win":     "Gagner {n} race(s) shiny",
            "first_of_day": "Être le premier du jour {n} fois",
            "points":       "Accumuler {n} points",
            "streak":       "Maintenir un streak de {n} jours",
            "top3_month":   "Finir dans le top 3 du classement ce mois",
            "streak_days":  "Avoir un streak d'au moins {n} jours",
        }
        return defaults.get(otype, "Objectif personnalisé")

    async def on_submit(self, interaction: discord.Interaction):
        # Valider difficulté
        diff = self.diff_input.value.strip().lower()
        if diff not in ("easy", "medium", "hard"):
            await interaction.response.send_message("❌ Difficulté invalide. Utilisez : easy, medium ou hard.", ephemeral=True)
            return

        # Valider bonus
        try:
            bonus = float(self.bonus_input.value.strip().replace(",", "."))
            if bonus <= 0:
                raise ValueError
        except ValueError:
            await interaction.response.send_message("❌ Points bonus invalides.", ephemeral=True)
            return

        # Valider target
        try:
            target_raw = self.target_input.value.strip().replace(",", ".")
            target = float(target_raw) if target_raw else 1.0
            if target <= 0:
                raise ValueError
        except ValueError:
            await interaction.response.send_message("❌ Valeur cible invalide.", ephemeral=True)
            return

        # Description finale (remplacer {n} par la valeur)
        desc = self.desc_input.value.strip().replace("{n}", str(int(target) if target == int(target) else target))

        # Destination
        dest_raw = self.dest_input.value.strip().lower()
        if self.mode == "weekly":
            if dest_raw in ("pool", "p"):
                destination = "pool"
                dest_label = "pool hebdomadaire"
            else:
                destination = "week"
                dest_label = "semaine en cours"
        else:  # monthly
            if dest_raw in ("pool", "p"):
                destination = "monthly_pool"
                dest_label = "pool mensuel"
            else:
                destination = "monthly"
                dest_label = "mois en cours"

        user_id = str(interaction.user.id)

        if self.mode == "weekly":
            save_objective(self.otype, desc, target, bonus, diff, self.extra, destination, user_id)
        else:
            save_monthly_objective(self.otype, desc, target, bonus, diff, self.extra, destination, user_id)

        # Résumé de confirmation
        extra_display = display_target_extra(self.extra) if self.extra else None
        lines = [f"✅ Objectif ajouté au **{dest_label}** !"]
        lines.append(f"📝 **{desc}**")
        lines.append(f"⭐ Bonus : **+{bonus} pts** | 🎯 Cible : **{int(target) if target == int(target) else target}** | Difficulté : **{diff}**")
        if extra_display:
            lines.append(f"🔍 Cible spécifique : **{extra_display}**")

        await interaction.response.send_message("\n".join(lines), ephemeral=True)


class ObjectiveBuilderLetterModal(discord.ui.Modal):
    """Modal pour objectif lettre : saisie de la lettre + params."""
    def __init__(self, mode):
        super().__init__(title="Objectif : lettre du nom")
        self.mode = mode
        self.letter_input = discord.ui.TextInput(
            label="Lettre du début du nom (ex: P, A, D...)",
            placeholder="Ex: P",
            required=True, max_length=1
        )
        self.bonus_input = discord.ui.TextInput(
            label="Points bonus",
            placeholder="Ex: 3",
            required=True, max_length=6
        )
        self.diff_input = discord.ui.TextInput(
            label="Difficulté : easy / medium / hard",
            placeholder="easy",
            required=True, max_length=6
        )
        self.dest_input = discord.ui.TextInput(
            label="Destination : pool ou semaine (ou mois)",
            placeholder="pool",
            required=True, max_length=10
        )
        self.add_item(self.letter_input)
        self.add_item(self.bonus_input)
        self.add_item(self.diff_input)
        self.add_item(self.dest_input)

    async def on_submit(self, interaction: discord.Interaction):
        letter = self.letter_input.value.strip().upper()
        diff = self.diff_input.value.strip().lower()
        if diff not in ("easy", "medium", "hard"):
            await interaction.response.send_message("❌ Difficulté invalide.", ephemeral=True)
            return
        try:
            bonus = float(self.bonus_input.value.strip().replace(",", "."))
            if bonus <= 0: raise ValueError
        except ValueError:
            await interaction.response.send_message("❌ Points invalides.", ephemeral=True)
            return
        desc = f"Trouver un shiny dont le nom commence par **{letter}**"
        dest_raw = self.dest_input.value.strip().lower()
        uid = str(interaction.user.id)
        if self.mode == "weekly":
            dest = "pool" if dest_raw in ("pool", "p") else "week"
            save_objective("letter", desc, 1.0, bonus, diff, letter, dest, uid)
            dest_label = "pool hebdomadaire" if dest == "pool" else "semaine en cours"
        else:
            dest = "monthly_pool" if dest_raw in ("pool", "p") else "monthly"
            save_monthly_objective("letter", desc, 1.0, bonus, diff, letter, dest, uid)
            dest_label = "pool mensuel" if dest == "monthly_pool" else "mois en cours"
        await interaction.response.send_message(
            f"✅ Objectif **{desc}** ajouté au **{dest_label}** ! (+{bonus} pts, {diff})",
            ephemeral=True
        )


class ObjectiveBuilderTypeSelect(discord.ui.View):
    """Sélection du type Pokémon pour un objectif pokemon_type."""
    def __init__(self, mode):
        super().__init__(timeout=300)
        self.mode = mode
        options = [
            discord.SelectOption(label=f"{fr} / {en}", value=fr)
            for fr, en in POKEMON_TYPES
        ]
        sel = discord.ui.Select(
            placeholder="🔷 Choisir le type",
            options=options, min_values=1, max_values=1
        )
        sel.callback = self.type_selected
        self.add_item(sel)

    async def type_selected(self, interaction: discord.Interaction):
        ptype = interaction.data['values'][0]
        modal = ObjectiveBuilderFinalModal("pokemon_type", extra=ptype, mode=self.mode, extra_label=ptype)
        await interaction.response.send_modal(modal)


def save_objective(otype, desc, target, bonus, diff, extra, destination, user_id):

    if destination == 'pool':
        cursor.execute("""
            INSERT INTO objectives_pool (type, description, target_value, bonus_points, difficulty, target_extra, created_by)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (otype, desc, target, bonus, diff, extra, user_id))
    else:
        week_start = get_current_week_start()
        cursor.execute("""
            INSERT INTO weekly_objectives (type, description, target_value, bonus_points, difficulty, target_extra, week_start, created_by)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (otype, desc, target, bonus, diff, extra, week_start, user_id))
    conn.commit()


@bot.tree.command(
    name="admin_objectif_list",
    description="[ADMIN] Voir tous les objectifs du pool",
    guild=discord.Object(id=GUILD_ID)
)
async def admin_objectif_list(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    cursor.execute("SELECT id, type, description, target_value, bonus_points, difficulty, target_extra, is_active FROM objectives_pool ORDER BY difficulty, id")
    rows = cursor.fetchall()
    if not rows:
        await interaction.followup.send("Le pool d'objectifs est vide. Utilisez `/admin_objectif_add`.", ephemeral=True)
        return
    diff_emoji = {'easy':'🟢','medium':'🟡','hard':'🔴'}
    embed = discord.Embed(title="📋 Pool d'Objectifs", color=discord.Color.blue())
    for row in rows[:25]:
        oid, otype, desc, target, bonus, diff, extra, active = row
        status = "✅" if active else "❌"
        extra_txt = f" | Cible: {display_target_extra(extra)}" if extra else ""
        embed.add_field(
            name=f"{status} #{oid} {diff_emoji.get(diff,'⚪')} [{diff.upper()}] {desc}",
            value=f"Type: `{otype}` | Valeur: `{target}`{extra_txt} | Bonus: **+{bonus} pts**",
            inline=False
        )
    embed.set_footer(text="Utilisez /admin_objectif_remove <id> pour supprimer un objectif")
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="admin_objectif_remove",
    description="[ADMIN] Supprimer un objectif du pool par ID",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(objectif_id="ID de l'objectif (visible avec /admin_objectif_list)")
async def admin_objectif_remove(interaction: discord.Interaction, objectif_id: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    cursor.execute("SELECT description FROM objectives_pool WHERE id=?", (objectif_id,))
    row = cursor.fetchone()
    if not row:
        await interaction.response.send_message("❌ Objectif introuvable.", ephemeral=True)
        return
    cursor.execute("UPDATE objectives_pool SET is_active=0 WHERE id=?", (objectif_id,))
    conn.commit()
    await interaction.response.send_message(f"✅ Objectif **{row[0]}** désactivé du pool.", ephemeral=True)


@bot.tree.command(
    name="admin_objectifs_semaine",
    description="[ADMIN] Gérer les objectifs de la semaine en cours",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(action="Action à effectuer")
@app_commands.choices(action=[
    app_commands.Choice(name="Tirage automatique depuis le pool", value="draw"),
    app_commands.Choice(name="Voir les objectifs actuels", value="view"),
    app_commands.Choice(name="Effacer les objectifs de la semaine", value="clear"),
])
async def admin_objectifs_semaine(interaction: discord.Interaction, action: str):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    week_start = get_current_week_start()

    if action == "draw":
        ok, result = draw_weekly_objectives()
        if ok:
            await interaction.followup.send(
                f"✅ Tirage effectué pour la semaine du **{week_start}** :\n" +
                "\n".join(f"• {r}" for r in result), ephemeral=True
            )
        else:
            await interaction.followup.send(f"⚠️ {result}\nUtilisez l'action **Effacer** puis relancez le tirage.", ephemeral=True)

    elif action == "view":
        objectives = get_active_weekly_objectives()
        if not objectives:
            await interaction.followup.send("Aucun objectif actif cette semaine.", ephemeral=True)
            return
        diff_emoji = {'easy':'🟢','medium':'🟡','hard':'🔴'}
        embed = discord.Embed(title=f"📅 Objectifs semaine du {week_start}", color=discord.Color.gold())
        for obj in objectives:
            extra_txt = f" (cible: {display_target_extra(obj['target_extra'])})" if obj['target_extra'] else ""
            embed.add_field(
                name=f"{diff_emoji.get(obj['difficulty'],'⚪')} #{obj['id']} [{obj['difficulty'].upper()}] {obj['description']}",
                value=f"Type: `{obj['type']}` | Valeur: `{obj['target_value']}`{extra_txt} | Bonus: **+{obj['bonus_points']} pts**",
                inline=False
            )
        await interaction.followup.send(embed=embed, ephemeral=True)

    elif action == "clear":
        cursor.execute("UPDATE weekly_objectives SET is_active=0 WHERE week_start=?", (week_start,))
        cursor.execute("DELETE FROM weekly_player_choices WHERE week_start=?", (week_start,))
        conn.commit()
        await interaction.followup.send(f"✅ Objectifs de la semaine du **{week_start}** effacés (choix des joueurs réinitialisés).", ephemeral=True)



# ============================================================
# ================ OBJECTIFS MENSUELS =======================
# ============================================================

MONTHLY_OBJECTIVE_TYPES = {
    'quantity':     'Trouver X shinys dans le mois',
    'method':       'Trouver un shiny avec une méthode précise',
    'game':         'Trouver un shiny dans un jeu précis',
    'pokemon':      'Trouver un Pokémon shiny précis',
    'streak':       'Maintenir un streak de X jours consécutifs',
    'points':       'Accumuler X points dans le mois',
    'race_win':     'Gagner X races shiny dans le mois',
    'first_of_day': 'Être le premier du jour X fois',
    'top3_month':   'Terminer dans le top 3 du classement en fin de mois',
    'streak_days':  "Avoir un streak d'au moins X jours en fin de mois",
}

def get_current_month_start():
    """Retourne le 1er du mois actuel au format YYYY-MM-DD"""
    today = datetime.now().date()
    return str(today.replace(day=1))

def get_active_monthly_objectives():
    month_start = get_current_month_start()
    cursor.execute("""
        SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
        FROM monthly_objectives WHERE month_start = ? AND is_active = 1
    """, (month_start,))
    rows = cursor.fetchall()
    return [{'id':r[0],'type':r[1],'description':r[2],'target_value':r[3],
              'bonus_points':r[4],'difficulty':r[5],'target_extra':r[6]} for r in rows]

def get_user_monthly_progress(user_id, objective_id):
    cursor.execute("""
        SELECT current_value, completed, bonus_awarded
        FROM monthly_objectives_progress WHERE objective_id=? AND user_id=?
    """, (objective_id, user_id))
    row = cursor.fetchone()
    if row:
        return {'current_value': row[0], 'completed': row[1], 'bonus_awarded': row[2]}
    return {'current_value': 0, 'completed': 0, 'bonus_awarded': 0}

def upsert_monthly_progress(user_id, objective_id, new_value, completed=False):
    cursor.execute("""
        INSERT INTO monthly_objectives_progress (objective_id, user_id, current_value, completed, completed_at, bonus_awarded)
        VALUES (?, ?, ?, ?, CASE WHEN ? THEN datetime('now') ELSE NULL END, 0)
        ON CONFLICT(objective_id, user_id) DO UPDATE SET
            current_value = excluded.current_value,
            completed = excluded.completed,
            completed_at = CASE WHEN excluded.completed AND completed_at IS NULL THEN datetime('now') ELSE completed_at END
    """, (objective_id, user_id, new_value, 1 if completed else 0, completed))
    conn.commit()

def award_monthly_bonus(user_id, objective_id, bonus_points, description):
    cursor.execute("""
        UPDATE monthly_objectives_progress SET bonus_awarded=1
        WHERE objective_id=? AND user_id=?
    """, (objective_id, user_id))
    award_capped_bonus(user_id, f'[Objectif Mensuel: {description[:35]}]', 'monthly_objective', bonus_points)
    conn.commit()

def check_and_update_monthly_objectives(user_id, pokemon, game, method_key, points_earned, is_first_of_day=False):
    """Vérifie et met à jour la progression des objectifs mensuels. Retourne liste (desc, bonus)."""
    # Les shinys de l'Événement DC ne comptent pas pour les objectifs
    if game and normalize_str(game) == normalize_str(GAMES['dc_event']['fr']):
        return []
    objectives = get_active_monthly_objectives()
    completed_new = []
    month_start = get_current_month_start()

    for obj in objectives:
        progress = get_user_monthly_progress(user_id, obj['id'])
        if progress['completed'] and progress['bonus_awarded']:
            continue

        otype = obj['type']
        target = obj['target_value']
        extra = obj['target_extra']
        current = progress['current_value']
        new_val = current
        completed = bool(progress['completed'])

        if otype == 'quantity':
            new_val = current + 1
            completed = new_val >= target

        elif otype == 'method':
            if extra and method_key == extra:
                new_val = 1
                completed = True

        elif otype == 'game':
            if extra and game:
                game_key_extra = extra if extra in GAMES else None
                if game_key_extra is None:
                    norm_extra = normalize_str(extra)
                    for gk, gv in GAMES.items():
                        if normalize_str(gv['fr']) == norm_extra or normalize_str(gv.get('en','')) == norm_extra:
                            game_key_extra = gk
                            break
                if game_key_extra:
                    game_fr = GAMES.get(game_key_extra, {}).get('fr', '')
                    if normalize_str(game) == normalize_str(game_fr):
                        new_val = 1
                        completed = True
                else:
                    if normalize_str(extra) in normalize_str(game):
                        new_val = 1
                        completed = True

        elif otype == 'pokemon':
            if extra and normalize_str(pokemon) == normalize_str(extra):
                new_val = 1
                completed = True

        elif otype == 'points':
            # Points de vrais shinys ce mois (hors bonus système)
            cursor.execute("""
                SELECT COALESCE(SUM(points),0) FROM shiny
                WHERE user_id=? AND DATE(created_at) >= ?
                AND methode NOT IN (
                    'participation_bonus','weekly_objective','monthly_objective',
                    'race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
                    'admin_adjustment','bounty_bonus','season_carryover',
                    'monday_first_bonus','new_player_bonus', 'parrainage_bonus','guilde_objective_bonus',
                    'challenge_bonus','type_challenge_bonus','wanted_bonus'
                )
            """, (user_id, month_start))
            total_month = cursor.fetchone()[0] or 0
            new_val = total_month
            completed = new_val >= target

        elif otype == 'first_of_day':
            if is_first_of_day:
                new_val = current + 1
                completed = new_val >= target
            else:
                continue

        elif otype == 'streak':
            # Streak réel de jours consécutifs (table user_streaks, mise à jour
            # juste avant l'appel à cette fonction dans add_shiny)
            streak_data = get_user_streak(user_id)
            new_val = streak_data.get('current_streak', 0)
            completed = new_val >= target

        elif otype == 'streak_days':
            # Même logique que 'streak' : streak réel de jours consécutifs
            streak_data = get_user_streak(user_id)
            new_val = streak_data.get('current_streak', 0)
            completed = new_val >= target

        elif otype in ('race_win', 'top3_month'):
            # Mis à jour via des fonctions dédiées
            continue

        if new_val != current or (completed and not progress['completed']):
            upsert_monthly_progress(user_id, obj['id'], new_val, completed)

        if completed and not progress['bonus_awarded']:
            award_monthly_bonus(user_id, obj['id'], obj['bonus_points'], obj['description'])
            completed_new.append((obj['description'], obj['bonus_points']))

    return completed_new

def update_monthly_race_win_objective(user_id):
    """Appelé quand un joueur gagne une race — met à jour les objectifs mensuels race_win"""
    objectives = get_active_monthly_objectives()
    completed_new = []
    for obj in objectives:
        if obj['type'] != 'race_win':
            continue
        progress = get_user_monthly_progress(user_id, obj['id'])
        if progress['completed'] and progress['bonus_awarded']:
            continue
        new_val = progress['current_value'] + 1
        completed = new_val >= obj['target_value']
        upsert_monthly_progress(user_id, obj['id'], new_val, completed)
        if completed and not progress['bonus_awarded']:
            award_monthly_bonus(user_id, obj['id'], obj['bonus_points'], obj['description'])
            completed_new.append((obj['description'], obj['bonus_points']))
    return completed_new


def finalize_monthly_top3_objectives(month_start):
    """À appeler juste après la fin du mois `month_start` : ce type d'objectif
    n'était jamais évalué nulle part (contrairement à 'race_win' qui a sa propre
    fonction dédiée), donc les joueurs ne recevaient jamais le bonus même en
    finissant réellement top 3. On regarde qui était dans le top 3 du classement
    au moment de l'appel (juste après le passage au mois suivant)."""
    cursor.execute("""
        SELECT id, target_value, bonus_points, description FROM monthly_objectives
        WHERE month_start=? AND type='top3_month' AND is_active=1
    """, (month_start,))
    objs = cursor.fetchall()
    if not objs:
        return 0
    ladder = get_ladder()
    top3_ids = [str(r[0]) for r in ladder[:3]]
    awarded = 0
    for obj_id, target, bonus, description in objs:
        for uid in top3_ids:
            progress = get_user_monthly_progress(uid, obj_id)
            if progress['bonus_awarded']:
                continue
            upsert_monthly_progress(uid, obj_id, 1, True)
            award_monthly_bonus(uid, obj_id, bonus, description)
            awarded += 1
    return awarded

def draw_monthly_objectives():
    """Tire des objectifs depuis le pool mensuel pour le mois en cours.
    Le nombre est libre — prend autant d'objectifs actifs que possible (jusqu'à 10)."""
    month_start = get_current_month_start()
    cursor.execute("SELECT COUNT(*) FROM monthly_objectives WHERE month_start=? AND is_active=1", (month_start,))
    if cursor.fetchone()[0] > 0:
        return False, "Des objectifs mensuels existent déjà pour ce mois."

    cursor.execute("""
        SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
        FROM monthly_objectives_pool WHERE is_active=1 ORDER BY RANDOM() LIMIT 10
    """)
    rows = cursor.fetchall()
    if not rows:
        return False, "Le pool d'objectifs mensuels est vide."

    drawn = []
    for row in rows:
        cursor.execute("""
            INSERT INTO monthly_objectives (type, description, target_value, bonus_points, difficulty, target_extra, month_start, is_active)
            VALUES (?, ?, ?, ?, ?, ?, ?, 1)
        """, (row[1], row[2], row[3], row[4], row[5], row[6], month_start))
        drawn.append(row[2])
    conn.commit()
    return True, drawn

def get_monthly_bonus_user_ids(month_start, month_end):
    ex = VARIETY_COUNT_EXCLUDE
    ph = ','.join('?' * len(ex))
    cursor.execute(f"""
        SELECT DISTINCT user_id FROM shiny
        WHERE date(created_at) >= date(?) AND date(created_at) < date(?)
        AND methode NOT IN ({ph})
    """, (month_start, month_end, *ex))
    return [r[0] for r in cursor.fetchall()]

def is_monthly_bonus_claimed(user_id, month_start, mission_key):
    cursor.execute("""
        SELECT 1 FROM monthly_bonus_claims
        WHERE user_id=? AND month_start=? AND mission_key=?
    """, (str(user_id), month_start, mission_key))
    return cursor.fetchone() is not None

def claim_monthly_bonus(user_id, month_start, mission_key, bonus, description, award_created_at):
    if is_monthly_bonus_claimed(user_id, month_start, mission_key):
        return False
    cursor.execute("""
        INSERT OR IGNORE INTO monthly_bonus_claims (user_id, month_start, mission_key)
        VALUES (?, ?, ?)
    """, (str(user_id), month_start, mission_key))
    if cursor.rowcount == 0:
        return False
    award_date = award_created_at[:10]
    short = f'[Bonus Mensuel: {mission_key[:25]}]'[:80]
    effective_bonus = apply_bonus_diminishing_returns(user_id, float(bonus))
    add_user_weekly_bonus_pts(user_id, float(bonus))
    cursor.execute("""
        INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
        VALUES (?, ?, '', 'monthly_objective', ?, ?, ?, 'fr')
    """, (str(user_id), short, award_date, effective_bonus, award_created_at))
    conn.commit()
    logger.info(f"Bonus mensuel attribue a {user_id}: {mission_key} (+{effective_bonus} pts, brut {bonus}) - {description}")
    return True

def check_monthly_bonus_missions(user_id, month_start, month_end):
    stats = get_period_bonus_stats(user_id, month_start, month_end)
    completed = []

    # Regrouper les missions paliers exclusifs par kind pour n'en déclencher qu'une seule
    tiered_by_kind = {}
    for mission_key, kind, need, bonus, description in MONTHLY_BONUS_MISSIONS:
        if kind in TIERED_MISSION_KINDS:
            tiered_by_kind.setdefault(kind, []).append((need, mission_key, bonus, description))

    for mission_key, kind, need, bonus, description in MONTHLY_BONUS_MISSIONS:
        if kind in TIERED_MISSION_KINDS:
            continue  # traité séparément
        if mission_current_value(stats, kind) >= need:
            completed.append((mission_key, bonus, description))

    # Pour chaque kind de palier exclusif, ne garder que le seuil le plus élevé atteint
    for kind, tiers in tiered_by_kind.items():
        current_val = mission_current_value(stats, kind)
        tiers_sorted = sorted(tiers, key=lambda x: x[0], reverse=True)
        for need, mission_key, bonus, description in tiers_sorted:
            if current_val >= need:
                completed.append((mission_key, bonus, description))
                break  # on s'arrête au premier (= plus haut seuil atteint)

    return completed

def award_monthly_period_bonuses(month_start):
    """Attribue les bonus mensuels statiques pour le mois donne, sans doublons."""
    month_end = get_next_month_start(month_start)
    award_dt = datetime.strptime(month_end, "%Y-%m-%d") - timedelta(seconds=1)
    award_created_at = award_dt.strftime("%Y-%m-%d %H:%M:%S")
    total_awarded = 0
    users = get_monthly_bonus_user_ids(month_start, month_end)
    for uid in users:
        for mission_key, bonus, description in check_monthly_bonus_missions(uid, month_start, month_end):
            if claim_monthly_bonus(uid, month_start, mission_key, bonus, description, award_created_at):
                total_awarded += 1
    if total_awarded:
        logger.info(f"{total_awarded} bonus mensuel(s) attribue(s) pour {month_start}")
    return total_awarded

async def auto_monthly_draw():
    """Tâche de fond : tire automatiquement les objectifs le 1er de chaque mois à 00h00"""
    await bot.wait_until_ready()
    while not bot.is_closed():
        now = datetime.now()
        if now.day == 1 and now.hour == 0 and now.minute < 5:
            try:
                prev_month_start = get_previous_month_start(now.date())
                award_monthly_period_bonuses(prev_month_start)
                awarded_top3 = finalize_monthly_top3_objectives(prev_month_start)
                if awarded_top3:
                    logger.info(f"✅ {awarded_top3} bonus 'top3_month' attribué(s) pour {prev_month_start}")
            except Exception as e:
                logger.error(f"Erreur attribution bonus mensuels: {e}")
            ok, result = draw_monthly_objectives()
            if ok:
                logger.info(f"✅ Tirage auto objectifs mensuels : {result}")
            await asyncio.sleep(600)
        else:
            # Calculer le prochain 1er du mois
            if now.month == 12:
                next_first = now.replace(year=now.year+1, month=1, day=1, hour=0, minute=0, second=0, microsecond=0)
            else:
                next_first = now.replace(month=now.month+1, day=1, hour=0, minute=0, second=0, microsecond=0)
            wait_seconds = (next_first - now).total_seconds()
            logger.info(f"⏳ Prochain tirage objectifs mensuels dans {wait_seconds/3600:.1f}h")
            await asyncio.sleep(min(wait_seconds, 3600))


