            "❌ Les bonus Wanted/Challenge/Race/Objectifs ne comptent pas dans le cap."
        ),
        inline=False
    )
    embed.add_field(
        name="📉 Soft cap hebdo progressif",
        value=(
            f"Sous **{WEEKLY_CAP:.0f} pts** : 100% d'efficacité\n"
            f"À 300 pts : ~{_eff_pct(300)}% | 500 pts : ~{_eff_pct(500)}%\n"
            f"À 700 pts : ~{_eff_pct(700)}% | 1000 pts : ~{_eff_pct(1000)}%"
        ),
        inline=False
    )
    embed.add_field(
        name="📈 Multiplicateur de position",
        value=(
            "Top 3 : **×0.9**\n"
            "4 à 10 : **×1.1**\n"
            "11+ : **×1.25**"
        ),
        inline=False
    )
    embed.add_field(
        name="🎯 Missions variété (chaque semaine)",
        value=(
            "Bonus si tu varies **jeux**, **méthodes**, ou fais du **Full Odds** (barème). "
            "Détails et paliers : `/ranked_missions_variete`"
        ),
        inline=False
    )

    if rank:
        pos_label = ("🔴 Nerf ×0.9" if pos_mult < 1 else
                     "🟡 Bonus ×1.1" if pos_mult == 1.1 else
                     "🟢 Comeback ×1.25")
        _eff_now = _weekly_soft_cap(weekly_pts)
        _current_eff = round((_weekly_soft_cap(weekly_pts + 10) - _eff_now) / 10 * 100)
        embed.add_field(
            name=f"📊 Votre état actuel (#{rank})",
            value=(
                f"Position : **{pos_label}**\n"
                f"Points cap semaine : **{weekly_pts:.1f} pts**\n"
                f"Efficacité actuelle : **~{_current_eff}%**"
            ),
            inline=False
        )

    embed.set_footer(text="ShinyBot · Ranked")
    await interaction.response.send_message(embed=embed, ephemeral=True)


