@bot.tree.command(
    name="admin_objectif_methode",
    description="[ADMIN] Créer un objectif 'méthode précise' avec sélection du jeu et de la méthode",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    mode="Hebdomadaire ou Mensuel",
    destination="Où ajouter l'objectif"
)
@app_commands.choices(
    mode=[
        app_commands.Choice(name="Hebdomadaire", value="weekly"),
        app_commands.Choice(name="Mensuel", value="monthly"),
    ],
    destination=[
        app_commands.Choice(name="Pool réutilisable", value="pool"),
        app_commands.Choice(name="Période en cours", value="current"),
    ]
)
async def admin_objectif_methode(interaction: discord.Interaction, mode: str, destination: str):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    # Étape 1 : choisir le jeu
    view = ObjectifMethodeGameSelect(mode, destination)
    embed = discord.Embed(
        title="🎮 Objectif Méthode Précise — Étape 1/3",
        description="Sélectionnez le **jeu** pour lequel vous voulez définir la méthode :",
        color=discord.Color.gold() if mode == "weekly" else discord.Color.purple()
    )
    await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


class ObjectifMethodeGameSelect(discord.ui.View):
    def __init__(self, mode, destination):
        super().__init__(timeout=300)
        self.mode = mode
        self.destination = destination

        options = [discord.SelectOption(label=v["fr"][:100], value=k) for k, v in GAMES.items()]
        # Diviser si > 25
        if len(options) <= 25:
            sel = discord.ui.Select(placeholder="🎮 Choisir le jeu", options=options, min_values=1, max_values=1)
            sel.callback = self.game_selected
            self.add_item(sel)
        else:
            sel1 = discord.ui.Select(placeholder="🎮 Jeux (1/2)", options=options[:25], min_values=1, max_values=1)
            sel1.callback = self.game_selected
            self.add_item(sel1)
            sel2 = discord.ui.Select(placeholder="🎮 Jeux (2/2)", options=options[25:50], min_values=1, max_values=1)
            sel2.callback = self.game_selected
            self.add_item(sel2)

    async def game_selected(self, interaction: discord.Interaction):
        game_key = interaction.data["values"][0]
        game_name = GAMES[game_key]["fr"]

        methods = METHODS_BY_GAME.get(game_key, {})
        if not methods:
            await interaction.response.send_message(
                f"❌ Aucune méthode disponible pour **{game_name}**.", ephemeral=True
            )
            return

        view = ObjectifMethodeMethodSelect(self.mode, self.destination, game_key, game_name)
        embed = discord.Embed(
            title="🎯 Objectif Méthode Précise — Étape 2/3",
            description=f"Jeu sélectionné : **{game_name}**\n\nChoisissez maintenant la **méthode** :",
            color=discord.Color.gold() if self.mode == "weekly" else discord.Color.purple()
        )
        await interaction.response.edit_message(embed=embed, view=view)


class ObjectifMethodeMethodSelect(discord.ui.View):
    def __init__(self, mode, destination, game_key, game_name):
        super().__init__(timeout=300)
        self.mode = mode
        self.destination = destination
        self.game_key = game_key
        self.game_name = game_name

        methods = METHODS_BY_GAME.get(game_key, {})
        options = [
            discord.SelectOption(
                label=f"{v['fr']} ({v['points']} pts)"[:100],
                value=method_key
            )
            for method_key, v in methods.items()
        ]
        sel = discord.ui.Select(
            placeholder="🎯 Choisir la méthode",
            options=options[:25],
            min_values=1, max_values=1
        )
        sel.callback = self.method_selected
        self.add_item(sel)

    async def method_selected(self, interaction: discord.Interaction):
        method_key = interaction.data["values"][0]
        method_name = METHODS_BY_GAME[self.game_key][method_key]["fr"]
        # Étape 3 : modal pour bonus/difficulté/destination
        modal = ObjectifMethodeFinalModal(self.mode, self.destination, self.game_key, self.game_name, method_key, method_name)
        await interaction.response.send_modal(modal)


class ObjectifMethodeFinalModal(discord.ui.Modal):
    def __init__(self, mode, destination, game_key, game_name, method_key, method_name):
        super().__init__(title="Finaliser l'objectif méthode")
        self.mode = mode
        self.destination = destination
        self.game_key = game_key
        self.game_name = game_name
        self.method_key = method_key
        self.method_name = method_name

        self.desc_input = discord.ui.TextInput(
            label="Description (laisser vide = auto)",
            placeholder=f"Ex: Trouver un shiny en {method_name}",
            default=f"Trouver un shiny en {method_name} ({game_name})",
            required=True,
            max_length=150
        )
        self.bonus_input = discord.ui.TextInput(
            label="Points bonus à attribuer",
            placeholder="Ex: 5",
            required=True,
            max_length=6
        )
        self.diff_input = discord.ui.TextInput(
            label="Difficulté : easy / medium / hard",
            placeholder="easy",
            required=True,
            max_length=6
        )
        self.add_item(self.desc_input)
        self.add_item(self.bonus_input)
        self.add_item(self.diff_input)

    async def on_submit(self, interaction: discord.Interaction):
        diff = self.diff_input.value.strip().lower()
        if diff not in ("easy", "medium", "hard"):
            await interaction.response.send_message("❌ Difficulté invalide. Utilisez : easy, medium ou hard.", ephemeral=True)
            return
        try:
            bonus = float(self.bonus_input.value.strip().replace(",", "."))
            if bonus <= 0:
                raise ValueError
        except ValueError:
            await interaction.response.send_message("❌ Points bonus invalides.", ephemeral=True)
            return

        desc = self.desc_input.value.strip()
        user_id = str(interaction.user.id)

        if self.mode == "weekly":
            dest = "pool" if self.destination == "pool" else "week"
            save_objective("method", desc, 1.0, bonus, diff, self.method_key, dest, user_id)
            dest_label = "pool hebdomadaire" if dest == "pool" else "semaine en cours"
        else:
            dest = "monthly_pool" if self.destination == "pool" else "monthly"
            save_monthly_objective("method", desc, 1.0, bonus, diff, self.method_key, dest, user_id)
            dest_label = "pool mensuel" if dest == "monthly_pool" else "mois en cours"

        await interaction.response.send_message(
            f"✅ Objectif méthode ajouté au **{dest_label}** !\n"
            f"📝 **{desc}**\n"
            f"🎮 Jeu : **{self.game_name}** | 🎯 Méthode : **{self.method_name}**\n"
            f"⭐ Bonus : **+{bonus} pts** | Difficulté : **{diff}**",
            ephemeral=True
        )


