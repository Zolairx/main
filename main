@bot.tree.command(name="admin_bounty_creer", description="[ADMIN] Créer un bounty collaboratif", guild=discord.Object(id=GUILD_ID))
@app_commands.describe(
    pokemon="Pokémon à trouver collectivement",
    objectif="Nombre de joueurs devant le trouver",
    bonus_points="Points bonus pour chaque participant quand l'objectif est atteint",
    jeu="Jeu spécifique (optionnel)",
    description="Description du bounty (optionnel)"
)
async def admin_bounty_creer(
    interaction: discord.Interaction,
    pokemon: str,
    objectif: int,
    bonus_points: float,
    jeu: str = None,
    description: str = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    # Defer immédiatement pour éviter le timeout Discord (3s)
    await interaction.response.defer(ephemeral=True)

    bounty_id = create_collab_bounty(pokemon, objectif, bonus_points, jeu, description, str(interaction.user.id))

    # Annonce dans le salon wanted alert
    try:
        channel = bot.get_channel(SALON_WANTED_ALERT_ID)
        if channel:
            jeu_txt_fr = f" sur **{jeu}**" if jeu else ""
            jeu_txt_en = f" on **{jeu}**" if jeu else ""
            desc_txt = f"\n💬 *{description}*" if description else ""
            embed = discord.Embed(
                title="🤝 Nouveau Bounty Collaboratif !  ·  New Collaborative Bounty!",
                description=(
                    f"**{pokemon}**{jeu_txt_fr} doit être trouvé par **{objectif} joueurs** !{desc_txt}\n"
                    f"**{pokemon}**{jeu_txt_en} must be found by **{objectif} players** !\n\n"
                    f"⭐ Récompense / Reward : **+{bonus_points} pts** par participant / per participant\n\n"
                    f"🇫🇷 Utilisez `/shiny_ajout` pour participer !\n"
                    f"🇬🇧 Use `/add_myshiny` to participate!"
                ),
                color=discord.Color.from_rgb(0, 200, 150),
                timestamp=datetime.now()
            )
            embed.set_footer(text=f"ShinyBot · Bounty Collab #{bounty_id}")
            await channel.send(embed=embed)
    except Exception as e:
        logger.error(f"Erreur annonce bounty: {e}")

    await interaction.followup.send(
        f"✅ Bounty collaboratif créé ! **{pokemon}** — {objectif} joueurs requis — +{bonus_points} pts chacun.",
        ephemeral=True
    )


@bot.tree.command(name="bounty", description="Voir les bounties collaboratifs actifs", guild=discord.Object(id=GUILD_ID))
async def bounty_list(interaction: discord.Interaction):
    async def _show(**kwargs):
        bounties = get_active_collab_bounties()
        embed = discord.Embed(
            title="🤝 Bounties Collaboratifs",
            color=discord.Color.from_rgb(0, 200, 150),
            timestamp=datetime.now()
        )
        if not bounties:
            embed.description = "Aucun bounty collaboratif actif pour le moment."
        else:
            for b in bounties:
                progress = get_bounty_progress(b['id'])
                bar_len = 10
                filled = int((progress / b['goal']) * bar_len) if b['goal'] > 0 else 0
                bar = "█" * filled + "░" * (bar_len - filled)
                jeu_txt = f" • {b['game']}" if b['game'] else ""
                desc_txt = f"*{b['description']}*" if b['description'] else ""
                embed.add_field(
                    name=f"#{b['id']} — {b['pokemon_name']}{jeu_txt}",
                    value=(
                        f"{desc_txt}\n"
                        f"`{bar}` **{progress}/{b['goal']}** joueurs\n"
                        f"⭐ Récompense : **+{b['bonus_points']} pts** chacun"
                    ),
                    inline=False
                )
        embed.set_footer(text="ShinyBot · Bounty Collab")
        await interaction.response.send_message(embed=embed, ephemeral=False)
        return True
    await discord_retry_wrapper(_show, context="Bounty List")


@bot.tree.command(name="admin_bounty_annuler", description="[ADMIN] Annuler un bounty collaboratif", guild=discord.Object(id=GUILD_ID))
@app_commands.describe(bounty_id="ID du bounty à annuler")
async def admin_bounty_annuler(interaction: discord.Interaction, bounty_id: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    cursor.execute("UPDATE collab_bounties SET status='cancelled', ended_at=datetime('now') WHERE id=? AND status='active'", (bounty_id,))
    conn.commit()
    if cursor.rowcount > 0:
        await interaction.response.send_message(f"✅ Bounty #{bounty_id} annulé.", ephemeral=True)
    else:
        await interaction.response.send_message(f"❌ Bounty #{bounty_id} introuvable ou déjà terminé.", ephemeral=True)


@bot.tree.command(
    name="admin_wanted_alerte",
    description="[ADMIN] Forcer l'envoi de l'alerte pour un ou tous les wanteds actifs",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(wanted_id="ID du wanted (laisser vide pour tous les wanteds actifs)")
async def admin_wanted_alerte(interaction: discord.Interaction, wanted_id: int = None):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)

    channel = bot.get_channel(SALON_WANTED_ALERT_ID)
    if not channel:
        await interaction.followup.send(f"❌ Salon introuvable (ID: {SALON_WANTED_ALERT_ID}).", ephemeral=True)
        return

    if wanted_id:
        cursor.execute("""
            SELECT id, pokemon_name, bonus_points, decay_percent, game
            FROM shiny_wanted WHERE id=? AND is_active=1
        """, (wanted_id,))
        rows = cursor.fetchall()
        if not rows:
            await interaction.followup.send(f"❌ Wanted #{wanted_id} introuvable ou inactif.", ephemeral=True)
            return
    else:
        cursor.execute("""
            SELECT id, pokemon_name, bonus_points, decay_percent, game
            FROM shiny_wanted WHERE is_active=1
            ORDER BY id DESC
        """)
        rows = cursor.fetchall()
        if not rows:
            await interaction.followup.send("❌ Aucun wanted actif.", ephemeral=True)
            return

    sent = 0
    for row in rows:
        wid, pname, bpts, decay, game = row
        # Récupérer l'indice
        cursor.execute("SELECT indice FROM shiny_wanted WHERE id=?", (wid,))
        indice_row = cursor.fetchone()
        indice = indice_row[0] if indice_row else None
        is_mystery = indice and not indice.strip().startswith("[Méthode :")
        displayed_fr = "???" if is_mystery else pname
        displayed_en = "???" if is_mystery else pname
        game_txt_fr = f" sur **{game}**" if game else ""
        game_txt_en = f" on **{game}**" if game else ""
        end_ts = int((datetime.now() + timedelta(days=7)).timestamp())
        desc = (
            f"**{displayed_fr}** est recherché{game_txt_fr} !\n"
            f"**{displayed_en}** is wanted{game_txt_en}!\n\n"
            f"⭐ Bonus : **+{bpts} pts** pour le premier trouveur / for the first finder\n"
            f"⏰ Se termine / Ends : <t:{end_ts}:F> (<t:{end_ts}:R>)\n\n"
        )
        if indice:
            desc += f"🔍 **Indice :** {indice}\n\n"
        desc += (
            f"🇫🇷 Utilisez `/shiny_ajout` pour réclamer votre bonus !\n"
            f"🇬🇧 Use `/add_myshiny` to claim your bonus!"
        )
        embed = discord.Embed(
            title="🎯 Pokémon Wanted !  ·  Wanted Pokémon!",
            description=desc,
            color=discord.Color.red(),
            timestamp=datetime.now()
        )
        embed.set_footer(text=f"ShinyBot · Wanted Alert #{wid}")
        try:
            await channel.send(embed=embed)
            sent += 1
            await asyncio.sleep(0.5)
        except Exception as e:
            logger.error(f"Erreur envoi alerte wanted #{wid}: {e}")


    await interaction.followup.send(
        f"✅ **{sent}** alerte{'s' if sent > 1 else ''} envoyée{'s' if sent > 1 else ''} dans {channel.mention} !",
        ephemeral=True
    )


@bot.tree.command(
    name="admin_liste_speciale",
    description="[ADMIN] Gérer les listes Starter / Légendaire pour les objectifs",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    action="Action",
    list_type="Type de liste",
    pokemon="Nom du Pokémon (pour ajouter/retirer)"
)
@app_commands.choices(
    action=[
        app_commands.Choice(name="Voir la liste", value="view"),
        app_commands.Choice(name="Ajouter un Pokémon", value="add"),
        app_commands.Choice(name="Retirer un Pokémon", value="remove"),
    ],
    list_type=[
        app_commands.Choice(name="Starters", value="starter"),
        app_commands.Choice(name="Légendaires", value="legendary"),
    ]
)
async def admin_liste_speciale(
    interaction: discord.Interaction,
    action: str,
    list_type: str,
    pokemon: str = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)

    list_name = "Starters" if list_type == "starter" else "Légendaires"

    if action == "view":
        cursor.execute(
            "SELECT pokemon_name FROM special_pokemon_lists WHERE list_type=? ORDER BY pokemon_name",
            (list_type,)
        )
        items = [r[0] for r in cursor.fetchall()]
        if not items:
            await interaction.followup.send(f"La liste **{list_name}** est vide.", ephemeral=True)
            return
        # Découper par chunks de 40
        chunks = [items[i:i+40] for i in range(0, len(items), 40)]
        embed = discord.Embed(
            title=f"📋 Liste {list_name} ({len(items)} entrées)",
            color=discord.Color.green() if list_type == "starter" else discord.Color.gold()
        )
        for j, chunk in enumerate(chunks[:6]):
            embed.add_field(
                name=f"{'Pokémon' if j == 0 else '...suite'}",
                value=", ".join(chunk),
                inline=False
            )
        await interaction.followup.send(embed=embed, ephemeral=True)

    elif action == "add":
        if not pokemon:
            await interaction.followup.send("❌ Précisez le nom du Pokémon.", ephemeral=True)
            return
        cursor.execute(
            "INSERT OR IGNORE INTO special_pokemon_lists (list_type, pokemon_name) VALUES (?, ?)",
            (list_type, pokemon.strip())
        )
        conn.commit()
        if cursor.rowcount > 0:
            await interaction.followup.send(f"✅ **{pokemon}** ajouté à la liste **{list_name}**.", ephemeral=True)
        else:
            await interaction.followup.send(f"ℹ️ **{pokemon}** est déjà dans la liste.", ephemeral=True)

    elif action == "remove":
        if not pokemon:
            await interaction.followup.send("❌ Précisez le nom du Pokémon.", ephemeral=True)
            return
        cursor.execute(
            "DELETE FROM special_pokemon_lists WHERE list_type=? AND LOWER(pokemon_name)=LOWER(?)",
            (list_type, pokemon.strip())
        )
        conn.commit()
        if cursor.rowcount > 0:
            await interaction.followup.send(f"✅ **{pokemon}** retiré de la liste **{list_name}**.", ephemeral=True)
        else:
            await interaction.followup.send(f"❌ **{pokemon}** n'était pas dans la liste.", ephemeral=True)


@bot.tree.command(
    name="admin_wanted_alternates",
    description="[ADMIN] Modifier les Pokémon alternatifs d'un wanted existant",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(wanted_id="ID du wanted (voir /wanted)")
async def admin_wanted_alternates(interaction: discord.Interaction, wanted_id: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    cursor.execute("SELECT pokemon_name, pokemon_alternates FROM shiny_wanted WHERE id=? AND is_active=1", (wanted_id,))
    row = cursor.fetchone()
    if not row:
        await interaction.response.send_message(f"❌ Wanted #{wanted_id} introuvable ou inactif.", ephemeral=True)
        return
    pname, alts_raw = row
    import json as _j
    current_alts = []
    if alts_raw:
        try:
            current_alts = _j.loads(alts_raw)
        except Exception:
            pass
    modal = WantedAlternatesModal(wanted_id, pname)
    if current_alts:
        modal.alternates_input.default = ", ".join(current_alts)
    await interaction.response.send_modal(modal)


