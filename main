@bot.tree.command(
    name="admin_disable_wanted",
    description="[ADMIN] Désactiver un Pokémon Shiny Wanted par ID",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    wanted_id="ID du wanted à désactiver (visible avec /wanted)"
)
async def admin_disable_wanted(interaction: discord.Interaction, wanted_id: int):
    async def _disable_wanted(**kwargs):
        await interaction.response.defer(ephemeral=True)

        if not interaction.user.guild_permissions.administrator:
            await interaction.followup.send("❌ Vous devez être administrateur pour utiliser cette commande.", ephemeral=True)
            return None

        cursor.execute("""
            SELECT pokemon_name, is_active FROM shiny_wanted WHERE id = ?
        """, (wanted_id,))
        row = cursor.fetchone()
        if not row:
            await interaction.followup.send("❌ Aucun wanted trouvé avec cet ID.", ephemeral=True)
            return None

        pokemon_name, is_active = row
        if not is_active:
            await interaction.followup.send(f"⚠️ Le wanted ID {wanted_id} (**{pokemon_name}**) est déjà désactivé.", ephemeral=True)
            return None

        cursor.execute("""
            UPDATE shiny_wanted
            SET is_active = 0, updated_at = datetime('now')
            WHERE id = ?
        """, (wanted_id,))
        conn.commit()

        embed = discord.Embed(
            title="✅ Pokémon Wanted Désactivé",
            description=f"Le wanted ID **{wanted_id}** pour **{pokemon_name}** a été désactivé.",
            color=discord.Color.red()
        )
        await interaction.followup.send(embed=embed, ephemeral=True)
        return True

    result = await discord_retry_wrapper(_disable_wanted, context="Admin Disable Wanted Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

# Dictionnaire pour stocker les races en attente d'acceptation
pending_races = {}

class RaceAcceptView(discord.ui.View):
    """Vue pour accepter ou refuser un défi de race via DM"""
    def __init__(self, race_key, challenger, adversaire, pokemon, jeu, bonus_points, guild_channel_id):
        super().__init__(timeout=300)
        self.race_key = race_key
        self.challenger = challenger
        self.adversaire = adversaire
        self.pokemon = pokemon
        self.jeu = jeu
        self.bonus_points = bonus_points
        self.guild_channel_id = guild_channel_id

    async def on_timeout(self):
        """Nettoyer la race en attente si le délai expire"""
        pending_races.pop(self.race_key, None)

    @discord.ui.button(label="✅ Accepter le défi", style=discord.ButtonStyle.success)
    async def accept(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id != self.adversaire.id:
            await interaction.response.send_message("❌ Ce défi ne vous est pas destiné.", ephemeral=True)
            return

        # Désactiver les boutons
        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(view=self)

        # Vérifier qu'il n'y a pas déjà une race active
        challenger_id = str(self.challenger.id)
        opponent_id = str(self.adversaire.id)
        cursor.execute("""
            SELECT COUNT(*) FROM shiny_races
            WHERE status = 'active'
            AND ((challenger_id = ? AND opponent_id = ?) OR (challenger_id = ? AND opponent_id = ?))
            AND LOWER(pokemon_name) = LOWER(?)
        """, (challenger_id, opponent_id, opponent_id, challenger_id, self.pokemon))
        existing = cursor.fetchone()[0] or 0
        if existing > 0:
            await interaction.followup.send("⚠️ Une race active existe déjà entre vous deux pour ce Pokémon.")
            pending_races.pop(self.race_key, None)
            return

        race_id = create_shiny_race(challenger_id, opponent_id, self.pokemon, self.jeu, self.bonus_points)
        pending_races.pop(self.race_key, None)

        # Confirmer dans le DM
        await interaction.followup.send(
            f"✅ Vous avez accepté le défi ! La race **#{race_id}** est maintenant active.\n"
            f"Le premier à trouver **{self.pokemon}** gagne **+{self.bonus_points} pts** !"
        )

        # Notifier dans le salon du serveur
        try:
            guild_channel = bot.get_channel(self.guild_channel_id)
            if guild_channel:
                embed = discord.Embed(
                    title="🏁 Race Shiny Acceptée !",
                    description=f"{self.challenger.mention} vs {self.adversaire.mention} pour trouver **{self.pokemon}** !",
                    color=discord.Color.green()
                )
                embed.add_field(name="🎮 Jeu / Version", value=self.jeu, inline=True)
                embed.add_field(name="💰 Points Bonus", value=f"+{self.bonus_points} points", inline=True)
                embed.add_field(name="🆔 ID de la Race", value=str(race_id), inline=False)
                embed.set_footer(text="Le premier à ajouter le shiny avec /shiny_ajout remporte la race !")
                await guild_channel.send(embed=embed)
        except Exception as e:
            logger.error(f"Erreur envoi notification race dans salon: {e}")

        # Notifier le challenger par DM
        try:
            await self.challenger.send(
                f"🏁 {self.adversaire.display_name} a **accepté** votre défi de race pour **{self.pokemon}** !\n"
                f"La race **#{race_id}** est active. Bonne chance !"
            )
        except Exception:
            pass

    @discord.ui.button(label="❌ Refuser", style=discord.ButtonStyle.danger)
    async def refuse(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id != self.adversaire.id:
            await interaction.response.send_message("❌ Ce défi ne vous est pas destiné.", ephemeral=True)
            return

        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(view=self)

        pending_races.pop(self.race_key, None)

        await interaction.followup.send(f"❌ Vous avez refusé le défi de **{self.challenger.display_name}**.")

        # Notifier le challenger
        try:
            await self.challenger.send(
                f"😔 **{self.adversaire.display_name}** a **refusé** votre défi de race pour **{self.pokemon}**."
            )
        except Exception:
            pass

@bot.tree.command(
    name="race_shiny",
    description="Défier jusqu'à 4 joueurs en race pour un Pokémon shiny",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    adversaire1="1er membre à défier",
    adversaire2="2e membre à défier (optionnel)",
    adversaire3="3e membre à défier (optionnel)",
    adversaire4="4e membre à défier (optionnel)",
    pokemon="Pokémon cible pour la race",
    jeu="Jeu / version utilisé(e) pour la race (texte libre)",
    bonus_points="Points bonus pour le gagnant de la race"
)
async def race_shiny(interaction: discord.Interaction,
                     adversaire1: discord.Member,
                     pokemon: str,
                     jeu: str,
                     bonus_points: float,
                     adversaire2: discord.Member = None,
                     adversaire3: discord.Member = None,
                     adversaire4: discord.Member = None):
    await interaction.response.defer(ephemeral=True)

    challenger = interaction.user
    challenger_id = str(challenger.id)

    if bonus_points <= 0:
        await interaction.followup.send("❌ Les points bonus doivent être strictement positifs.", ephemeral=True)
        return

    # Construire la liste des adversaires uniques, sans le challenger ni les bots
    seen_ids = set()
    adversaires = []
    for adv in [adversaire1, adversaire2, adversaire3, adversaire4]:
        if adv is None:
            continue
        if adv.id == challenger.id:
            await interaction.followup.send(f"❌ Vous ne pouvez pas vous défier vous-même.", ephemeral=True)
            return
        if adv.bot:
            await interaction.followup.send(f"❌ {adv.display_name} est un bot, impossible de le défier.", ephemeral=True)
            return
        if adv.id not in seen_ids:
            seen_ids.add(adv.id)
            adversaires.append(adv)

    guild_channel_id = interaction.channel_id
    guild_name = interaction.guild.name

    results_ok = []
    results_fail = []

    for adversaire in adversaires:
        opponent_id = str(adversaire.id)

        # Vérifier race active existante
        cursor.execute("""
            SELECT COUNT(*) FROM shiny_races
            WHERE status = 'active'
            AND ((challenger_id = ? AND opponent_id = ?) OR (challenger_id = ? AND opponent_id = ?))
            AND LOWER(pokemon_name) = LOWER(?)
        """, (challenger_id, opponent_id, opponent_id, challenger_id, pokemon))
        if (cursor.fetchone()[0] or 0) > 0:
            results_fail.append(f"⚠️ {adversaire.mention} : race déjà active pour ce Pokémon.")
            continue

        race_key = f"{min(challenger_id, opponent_id)}_{max(challenger_id, opponent_id)}_{pokemon.lower()}"
        if race_key in pending_races:
            results_fail.append(f"⚠️ {adversaire.mention} : défi déjà en attente.")
            continue

        pending_races[race_key] = True

        dm_embed = discord.Embed(
            title="⚔️ Défi de Race Shiny !",
            description=f"**{challenger.display_name}** vous défie en race sur le serveur **{guild_name}** !",
            color=discord.Color.orange()
        )
        dm_embed.add_field(name="🎯 Pokémon cible", value=f"**{pokemon}**", inline=True)
        dm_embed.add_field(name="🎮 Jeu / Version", value=jeu, inline=True)
        dm_embed.add_field(name="💰 Points Bonus", value=f"+{bonus_points} pts pour le gagnant", inline=True)
        if len(adversaires) > 1:
            autres = [a.display_name for a in adversaires if a.id != adversaire.id]
            dm_embed.add_field(name="👥 Autres adversaires défis", value=", ".join(autres), inline=False)
        dm_embed.set_footer(text="Vous avez 5 minutes pour accepter ou refuser.")

        view = RaceAcceptView(race_key, challenger, adversaire, pokemon, jeu, bonus_points, guild_channel_id)

        try:
            await adversaire.send(embed=dm_embed, view=view)
            results_ok.append(adversaire.mention)
        except discord.Forbidden:
            pending_races.pop(race_key, None)
            results_fail.append(f"❌ {adversaire.mention} : DMs fermés.")
        except discord.HTTPException as e:
            pending_races.pop(race_key, None)
            results_fail.append(f"❌ {adversaire.mention} : erreur HTTP {e.status}.")
        except Exception as e:
            pending_races.pop(race_key, None)
            logger.error(f"Erreur DM race vers {adversaire.id}: {e}")
            results_fail.append(f"❌ {adversaire.mention} : erreur inattendue.")

    # Résumé
    lines = []
    if results_ok:
        lines.append(f"✅ Défi envoyé à : {', '.join(results_ok)}")
        lines.append(f"Ils ont **5 minutes** pour accepter ou refuser.")
    if results_fail:
        lines.append("\n".join(results_fail))
    if not results_ok and not results_fail:
        lines.append("⚠️ Aucun adversaire valide trouvé.")

    await interaction.followup.send("\n".join(lines), ephemeral=True)

@bot.tree.command(
    name="race_stats",
    description="Voir vos statistiques de races shiny",
    guild=discord.Object(id=GUILD_ID)
)
async def race_stats(interaction: discord.Interaction):
    async def _show_stats(**kwargs):
        await interaction.response.defer(ephemeral=True)

        user_id = str(interaction.user.id)
        stats = get_race_stats(user_id)

        wins = stats['wins']
        total = stats['total']
        active = stats['active']
        total_bonus = stats['total_bonus']
        losses = max(total - wins, 0)
        winrate = (wins / total * 100) if total > 0 else 0

        embed = discord.Embed(
            title="🏁 Statistiques de Races Shiny",
            description=f"Statistiques pour {interaction.user.mention}",
            color=discord.Color.blurple()
        )
        embed.add_field(name="✅ Victoires", value=str(wins), inline=True)
        embed.add_field(name="❌ Défaites", value=str(losses), inline=True)
        embed.add_field(name="📊 Races jouées", value=str(total), inline=True)
        embed.add_field(name="🔥 Races actives", value=str(active), inline=True)
        embed.add_field(name="🏆 Winrate", value=f"{winrate:.1f}%", inline=True)
        embed.add_field(name="💰 Points bonus gagnés", value=f"{total_bonus:.1f} ⭐", inline=True)
        embed.set_footer(text="ShinyBot - Continuez à défier les autres chasseurs !")

        await interaction.followup.send(embed=embed, ephemeral=True)
        return True

    result = await discord_retry_wrapper(_show_stats, context="Race Stats Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

@bot.tree.command(
    name="race_list",
