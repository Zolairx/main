                ),
                color=discord.Color.purple(),
                timestamp=datetime.now()
            )
            embed.set_footer(text="ShinyBot · Challenge Mensuel")
            await channel.send(embed=embed)
    except Exception as e:
        logger.error(f"Erreur annonce challenge: {e}")

    await interaction.followup.send(
        f"✅ Challenge mensuel créé ! *{description}* — +{bonus_points} pts pour les {max_winners} premiers.",
        ephemeral=True
    )
    # Mise à jour immédiate du salon de statut challenge
    asyncio.create_task(update_challenge_status_message())


@bot.tree.command(
    name="admin_challenge_modifier",
    description="[ADMIN] Modifier ou supprimer le challenge mensuel en cours",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    action="Action à effectuer",
    description="Nouvelle description (si modifier)",
    bonus_points="Nouveaux points bonus (si modifier)",
    max_winners="Nouveau nombre max de gagnants (si modifier)",
    target_value="Nouvelle valeur cible (si modifier)"
)
@app_commands.choices(action=[
    app_commands.Choice(name="Modifier", value="edit"),
    app_commands.Choice(name="Supprimer / Désactiver", value="delete"),
    app_commands.Choice(name="Réinitialiser les gagnants", value="reset_winners"),
])
async def admin_challenge_modifier(
    interaction: discord.Interaction,
    action: str,
    description: str = None,
    bonus_points: float = None,
    max_winners: int = None,
    target_value: str = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)

    month_start = get_current_month_start()
    cursor.execute("SELECT id, description FROM monthly_challenge WHERE month_start=?", (month_start,))
    row = cursor.fetchone()
    if not row:
        await interaction.followup.send("❌ Aucun challenge actif ce mois-ci.", ephemeral=True)
        return

    if action == "edit":
        updates = []
        params  = []
        if description:
            updates.append("description=?")
            params.append(description)
        if bonus_points is not None:
            updates.append("bonus_points=?")
            params.append(bonus_points)
        if max_winners is not None:
            updates.append("max_winners=?")
            params.append(max_winners)
        if target_value:
            updates.append("target_value=?")
            params.append(target_value)
        if not updates:
            await interaction.followup.send("❌ Aucune modification fournie.", ephemeral=True)
            return
        params.append(month_start)
        cursor.execute(f"UPDATE monthly_challenge SET {', '.join(updates)} WHERE month_start=?", params)
        conn.commit()
        await interaction.followup.send(f"✅ Challenge mensuel mis à jour.", ephemeral=True)
        asyncio.create_task(update_challenge_status_message())

    elif action == "delete":
        cursor.execute("UPDATE monthly_challenge SET is_active=0 WHERE month_start=?", (month_start,))
        conn.commit()
        await interaction.followup.send("✅ Challenge mensuel désactivé.", ephemeral=True)
        asyncio.create_task(update_challenge_status_message())

    elif action == "reset_winners":
        # Récupérer l'id du challenge pour vider aussi le log de déduplication
        cursor.execute("SELECT id FROM monthly_challenge WHERE month_start=?", (month_start,))
        ch_row = cursor.fetchone()
        cursor.execute("DELETE FROM monthly_challenge_winners WHERE month_start=?", (month_start,))
        if ch_row:
            cursor.execute("DELETE FROM monthly_challenge_pokemon_log WHERE challenge_id=?", (ch_row[0],))
        conn.commit()
        await interaction.followup.send("✅ Gagnants réinitialisés — tout le monde peut à nouveau remporter le challenge.", ephemeral=True)
        asyncio.create_task(update_challenge_status_message())


@bot.tree.command(
    name="challenge",
    description="Voir le challenge mensuel surprise en cours",
    guild=discord.Object(id=GUILD_ID)
)
async def challenge_actuel(interaction: discord.Interaction):
    challenge = get_active_monthly_challenge()
    if not challenge:
        await interaction.response.send_message("Aucun challenge mensuel actif ce mois.", ephemeral=True)
        return
    winners_count = get_challenge_winners_count()
    remaining = max(0, challenge['max_winners'] - winners_count)
    already_won = has_won_challenge(interaction.user.id)
    embed = discord.Embed(
        title="🎯 Challenge Mensuel",
        description=f"*{challenge['description']}*",
        color=discord.Color.purple(),
        timestamp=datetime.now()
    )
    embed.add_field(name="⭐ Bonus", value=f"+{challenge['bonus_points']} pts", inline=True)
    embed.add_field(name="🏆 Gagnants", value=f"{winners_count}/{challenge['max_winners']}", inline=True)
    embed.add_field(name="🎁 Places restantes", value=str(remaining), inline=True)
    if already_won:
        embed.add_field(name="✅ Votre statut", value="Vous avez déjà remporté ce challenge !", inline=False)
    elif remaining == 0:
        embed.add_field(name="❌ Statut", value="Plus de places disponibles.", inline=False)
    embed.set_footer(text="ShinyBot · Challenge Mensuel")
    await interaction.response.send_message(embed=embed, ephemeral=False)




# ══════════════════════════════════════════════════════════════════════════════
#  SYSTÈME DE GUILDES
# ══════════════════════════════════════════════════════════════════════════════

GUILDE_MAX_MEMBRES = 30   # Taille max d'une guilde
GUILDE_NOM_MAX    = 30    # Longueur max du nom

# ── Lock anti-doublon pour le classement guildes ──────────────────────────────
guilde_classement_lock = asyncio.Lock()
last_guilde_classement_update = None
GUILDE_CLASSEMENT_COOLDOWN = 30  # secondes


class GuildeDemandeView(discord.ui.View):
    """Boutons Accepter / Refuser envoyés au chef de guilde en DM."""

    def __init__(self, demande_id: int, guilde_id: int, candidat_id: int, guilde_nom: str):
        super().__init__(timeout=None)
        self.demande_id  = demande_id
        self.guilde_id   = guilde_id
        self.candidat_id = candidat_id
        self.guilde_nom  = guilde_nom

        btn_ok = discord.ui.Button(
            label="✅ Accepter",
            style=discord.ButtonStyle.success,
            custom_id=f"guilde_accept_{demande_id}"
        )
        btn_ko = discord.ui.Button(
            label="❌ Refuser",
            style=discord.ButtonStyle.danger,
            custom_id=f"guilde_refuse_{demande_id}"
        )
        btn_ok.callback = self._accept
        btn_ko.callback = self._refuse
        self.add_item(btn_ok)
        self.add_item(btn_ko)

    async def _check_leader(self, interaction: discord.Interaction) -> bool:
        """Vérifie que c'est bien le chef (ou un admin) qui clique."""
        guilde = guilde_get_by_id(self.guilde_id)
        if not guilde:
            await interaction.response.send_message("❌ Guilde introuvable.", ephemeral=True)
            return False
        is_admin = False
        disc_guild = bot.get_guild(GUILD_ID)
        if disc_guild:
            member = disc_guild.get_member(interaction.user.id)
            if member and member.guild_permissions.administrator:
                is_admin = True
        if str(interaction.user.id) != guilde[3] and not is_admin:
            await interaction.response.send_message(
                "❌ Seul le chef de la guilde peut traiter cette demande.", ephemeral=True
            )
            return False
        return True

    async def _accept(self, interaction: discord.Interaction):
        if not await self._check_leader(interaction):
            return

        # Vérifier que la demande existe encore
        cursor.execute("SELECT status FROM shinyhunter_guilde_demandes WHERE id=?", (self.demande_id,))
        row = cursor.fetchone()
        if not row or row[0] != 'pending':
            await interaction.response.edit_message(
                content="⚠️ Cette demande a déjà été traitée.", embed=None, view=None
            )
            return

        # Vérifier que la guilde n'est pas pleine
        membres = guilde_get_members(self.guilde_id)
        if len(membres) >= GUILDE_MAX_MEMBRES:
            cursor.execute(
                "UPDATE shinyhunter_guilde_demandes SET status='refused' WHERE id=?",
                (self.demande_id,)
            )
            conn.commit()
            await interaction.response.edit_message(
                content=f"❌ La guilde est pleine ({GUILDE_MAX_MEMBRES} membres max). Demande refusée automatiquement.",
                embed=None, view=None
            )
            return

        # Vérifier que le candidat n'a pas rejoint une autre guilde entre-temps
        if guilde_of_user(self.candidat_id):
            cursor.execute(
                "UPDATE shinyhunter_guilde_demandes SET status='refused' WHERE id=?",
                (self.demande_id,)
            )
            conn.commit()
            await interaction.response.edit_message(
                content="⚠️ Ce joueur a rejoint une autre guilde depuis. Demande annulée.",
                embed=None, view=None
            )
            return

        # Ajouter le membre
        cursor.execute(
            "INSERT OR IGNORE INTO shinyhunter_guilde_membres (guilde_id, user_id) VALUES (?, ?)",
            (self.guilde_id, str(self.candidat_id))
        )
        cursor.execute(
            "UPDATE shinyhunter_guilde_demandes SET status='accepted' WHERE id=?",
            (self.demande_id,)
        )
        conn.commit()

        await interaction.response.edit_message(
            content=f"✅ <@{self.candidat_id}> a été **accepté** dans **{self.guilde_nom}** !",
            embed=None, view=None
        )

        # Notifier le candidat
        try:
            disc_guild = bot.get_guild(GUILD_ID)
            candidat = disc_guild.get_member(int(self.candidat_id)) if disc_guild else None
            if candidat:
                embed = discord.Embed(
                    title=f"🎉 Demande acceptée !",
                    description=f"Ta demande pour rejoindre la guilde **{self.guilde_nom}** a été **acceptée** !",
                    color=discord.Color.green()
                )
                embed.set_footer(text="ShinyBot · Guildes • /guilde_info pour voir ta guilde")
                await candidat.send(embed=embed)
        except Exception:
            pass

        asyncio.create_task(update_guilde_classement_message())

    async def _refuse(self, interaction: discord.Interaction):
        if not await self._check_leader(interaction):
            return

        cursor.execute("SELECT status FROM shinyhunter_guilde_demandes WHERE id=?", (self.demande_id,))
        row = cursor.fetchone()
        if not row or row[0] != 'pending':
            await interaction.response.edit_message(
                content="⚠️ Cette demande a déjà été traitée.", embed=None, view=None
            )
            return

        cursor.execute(
            "UPDATE shinyhunter_guilde_demandes SET status='refused' WHERE id=?",
            (self.demande_id,)
        )
        conn.commit()

        await interaction.response.edit_message(
            content=f"🚫 La demande de <@{self.candidat_id}> a été **refusée**.",
            embed=None, view=None
        )

        # Notifier le candidat
        try:
            disc_guild = bot.get_guild(GUILD_ID)
            candidat = disc_guild.get_member(int(self.candidat_id)) if disc_guild else None
            if candidat:
                embed = discord.Embed(
                    title="😔 Demande refusée",
                    description=f"Ta demande pour rejoindre la guilde **{self.guilde_nom}** a été **refusée**.",
                    color=discord.Color.red()
                )
                embed.set_footer(text="ShinyBot · Guildes • Tu peux tenter de rejoindre une autre guilde")
                await candidat.send(embed=embed)
        except Exception:
            pass


class GuildePodiumView(discord.ui.View):
    """Bouton 'Voir la guilde' sur les embeds du podium guildes."""
    def __init__(self, guilde_id: int):
        super().__init__(timeout=None)
        btn = discord.ui.Button(
            label="🏰 Voir la guilde",
            style=discord.ButtonStyle.secondary,
            custom_id=f"guilde_info_btn_{guilde_id}"
        )
        btn.callback = self._callback
        self.guilde_id = guilde_id
        self.add_item(btn)

    async def _callback(self, interaction: discord.Interaction):
        try:
            await interaction.response.defer(ephemeral=True)
            disc_guild = bot.get_guild(GUILD_ID)
            guilde = guilde_get_by_id(self.guilde_id)
            if not guilde:
                await interaction.followup.send("❌ Guilde introuvable.", ephemeral=True)
                return
            guilde_id, g_nom, g_desc, owner_id, g_emoji, g_logo, g_created = (
                guilde[0], guilde[1], guilde[2], guilde[3], guilde[4], guilde[5], guilde[6]
            )
            level_info = get_guilde_level_info(guilde[7] if len(guilde) > 7 else 0)
            membres = guilde_get_members(guilde_id)
            cursor.execute("""
                SELECT m.user_id, COALESCE(SUM(s.points),0) as pts
                FROM shinyhunter_guilde_membres m
                LEFT JOIN shiny s ON s.user_id = m.user_id
                WHERE m.guilde_id=? GROUP BY m.user_id ORDER BY pts DESC
            """, (guilde_id,))
            membres_pts = cursor.fetchall()
            medals = ["🥇","🥈","🥉"]
            lines = []
            for i, (uid, pts) in enumerate(membres_pts):
                m = disc_guild.get_member(int(uid)) if disc_guild else None
                name = m.display_name if m else f"<@{uid}>"
                crown = " 👑" if uid == owner_id else ""
                medal = medals[i] if i < 3 else f"`#{i+1}`"
                lines.append(f"{medal} **{name}**{crown} — {int(pts)} pts")
            embed = discord.Embed(
                title=f"{g_emoji} {g_nom}",
                description=g_desc or "*Pas de description.*",
                color=level_info['color']
            )
            if g_logo:
                embed.set_thumbnail(url=g_logo)
            embed.add_field(name="👥 Membres", value=f"{len(membres)}/{GUILDE_MAX_MEMBRES}", inline=True)
            embed.add_field(name="⭐ Points totaux", value=f"{guilde_get_points(guilde_id):.0f} pts", inline=True)
            embed.add_field(name="🏅 Niveau", value=f"**{level_info['level']}** — {level_info['title']}", inline=True)
            embed.add_field(name="📊 Classement interne", value="\n".join(lines) or "—", inline=False)
            embed.set_footer(text=f"ShinyBot · Guildes • Créée le {g_created[:10]}")
            await interaction.followup.send(embed=embed, ephemeral=True)
        except Exception as e:
            logger.error(f"Erreur GuildePodiumView: {e}")
            try:
                await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
            except Exception:
                pass


class GuildeGroupSelectView(discord.ui.View):
    """Select menu pour voir les infos d'une guilde dans le groupe."""
    def __init__(self, guildes_batch):
        super().__init__(timeout=None)
        options = []
        for gid, nom, emoji, owner_id, nb, pts, logo, gxp in guildes_batch[:25]:
            lvl = get_guilde_level_info(gxp)['level']
            options.append(discord.SelectOption(
                label=f"{emoji} {nom}"[:100],
                value=str(gid),
                description=f"Niv. {lvl} · {int(pts)} pts · {nb} membre{'s' if nb != 1 else ''}"[:100]
            ))
        select = discord.ui.Select(
            placeholder="🏰 Voir les détails d'une guilde…",
            options=options,
            min_values=1,
            max_values=1,
            custom_id="guilde_group_select"
        )
        select.callback = self._on_select
        self.add_item(select)

    async def _on_select(self, interaction: discord.Interaction):
        try:
            await interaction.response.defer(ephemeral=True)
            guilde_id = int(interaction.data["values"][0])
            disc_guild = bot.get_guild(GUILD_ID)
            guilde = guilde_get_by_id(guilde_id)
            if not guilde:
                await interaction.followup.send("❌ Guilde introuvable.", ephemeral=True)
                return
            gid, g_nom, g_desc, owner_id, g_emoji, g_logo, g_created = (
                guilde[0], guilde[1], guilde[2], guilde[3], guilde[4], guilde[5], guilde[6]
            )
            level_info = get_guilde_level_info(guilde[7] if len(guilde) > 7 else 0)
            membres = guilde_get_members(gid)
            cursor.execute("""
                SELECT m.user_id, COALESCE(SUM(s.points),0) as pts
                FROM shinyhunter_guilde_membres m
                LEFT JOIN shiny s ON s.user_id = m.user_id
                WHERE m.guilde_id=? GROUP BY m.user_id ORDER BY pts DESC
            """, (gid,))
            membres_pts = cursor.fetchall()
            medals = ["🥇","🥈","🥉"]
            lines = []
            for i, (uid, pts) in enumerate(membres_pts):
                m = disc_guild.get_member(int(uid)) if disc_guild else None
                name = m.display_name if m else f"<@{uid}>"
                crown = " 👑" if uid == owner_id else ""
                medal = medals[i] if i < 3 else f"`#{i+1}`"
                lines.append(f"{medal} **{name}**{crown} — {int(pts)} pts")
            embed = discord.Embed(
                title=f"{g_emoji} {g_nom}",
                description=g_desc or "*Pas de description.*",
                color=level_info['color']
            )
            if g_logo:
                embed.set_thumbnail(url=g_logo)
            embed.add_field(name="👥 Membres", value=f"{len(membres)}/{GUILDE_MAX_MEMBRES}", inline=True)
            embed.add_field(name="⭐ Points totaux", value=f"{guilde_get_points(gid):.0f} pts", inline=True)
            embed.add_field(name="🏅 Niveau", value=f"**{level_info['level']}** — {level_info['title']}", inline=True)
            embed.add_field(name="📊 Classement interne", value="\n".join(lines) or "—", inline=False)
            embed.set_footer(text=f"ShinyBot · Guildes • Créée le {g_created[:10]}")
            await interaction.followup.send(embed=embed, ephemeral=True)
        except Exception as e:
            logger.error(f"Erreur GuildeGroupSelectView: {e}")
            try:
                await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
            except Exception:
                pass


async def update_guilde_classement_message():
    """Met à jour le classement des guildes dans son salon dédié."""
    global last_guilde_classement_update
    current_time = datetime.now()
    if last_guilde_classement_update and (current_time - last_guilde_classement_update).total_seconds() < GUILDE_CLASSEMENT_COOLDOWN:
        logger.info("Rate limite classement guildes : ignoré (cooldown)")
        return

    async with guilde_classement_lock:
        async def _update(**kwargs):
            disc_guild = bot.get_guild(GUILD_ID)
            channel = bot.get_channel(SALON_GUILDE_CLASSEMENT_ID)
            if not disc_guild or not channel:
                logger.error("Guild ou salon classement guildes introuvable.")
                return None

            rows = guilde_leaderboard()

            # Supprimer les anciens messages
            try:
                msgs = []
                async for msg in channel.history(limit=100):
                    msgs.append(msg)
                for i in range(0, len(msgs), 8):
                    for msg in msgs[i:i+8]:
                        try:
                            await msg.delete()
                            await asyncio.sleep(0.5)
                        except discord.NotFound:
                            pass
                        except discord.HTTPException:
                            await asyncio.sleep(2)
                    if i + 8 < len(msgs):
                        await asyncio.sleep(1.5)
            except Exception as e:
                logger.warning(f"Erreur suppression messages classement guildes : {e}")

            # ── Embed d'en-tête ───────────────────────────────────────────────
            intro = discord.Embed(
                title="🏰 Classement des Guildes 🏰",
                description=(
                    "Classement des guildes de shiny hunters !\n"
                    "────────────────────────────\n"
                    "**RANKED GUILDES — SAISON EN COURS**\n\n"
                    f"⚔️ **{len(rows)} Guilde{'s' if len(rows) != 1 else ''} active{'s' if len(rows) != 1 else ''}**\n"
                    f"⚡ **Dernière mise à jour :** <t:{int(datetime.now().timestamp())}:R>\n\n"
                    "*Les points d'une guilde = somme des points ranked de ses membres.*"
                ),
                color=discord.Color.gold(),
                timestamp=datetime.now()
            )
            if disc_guild.icon:
                intro.set_author(name="ShinyBot · Guildes", icon_url=disc_guild.icon.url)
            intro.set_footer(
                text="ShinyBot • Classement automatique des Guildes",
                icon_url=disc_guild.me.display_avatar.url if disc_guild.me else None
            )
            await channel.send(embed=intro)
            await asyncio.sleep(1.0)

            if not rows:
                await channel.send(embed=discord.Embed(
                    description="Aucune guilde n'a encore été créée. Utilisez `/guilde_creer` !",
                    color=discord.Color.blurple()
                ))
                return True

            podium_colors = [discord.Color.gold(), discord.Color.light_grey(), discord.Color.from_rgb(205, 127, 50)]
            podium_emojis = ["🥇","🥈","🥉"]
            podium_desc   = [
                "La guilde dominante de la saison !",
                "Une guilde d'exception !",
                "Sur le podium des guildes légendaires !"
            ]

            # ── Top 3 podium ─────────────────────────────────────────────────
            for i, row in enumerate(rows[:3]):
                gid, nom, emoji, owner_id, nb_membres, pts, logo, gxp = row
                level_info = get_guilde_level_info(gxp)
                owner = disc_guild.get_member(int(owner_id))
                owner_name = owner.display_name if owner else f"<@{owner_id}>"

                # Classement interne membres
                cursor.execute("""
                    SELECT m.user_id, COALESCE(SUM(s.points),0) as p
                    FROM shinyhunter_guilde_membres m
                    LEFT JOIN shiny s ON s.user_id = m.user_id
                    WHERE m.guilde_id=? GROUP BY m.user_id ORDER BY p DESC LIMIT 3
                """, (gid,))
                top3_membres = cursor.fetchall()
                top_lines = []
                for j, (uid, p) in enumerate(top3_membres):
                    m = disc_guild.get_member(int(uid))
                    mname = m.display_name if m else f"<@{uid}>"
                    top_lines.append(f"{'🥇🥈🥉'[j]} {mname} — {int(p)} pts")

                embed = discord.Embed(
                    title=f"{podium_emojis[i]} {emoji} {nom}",
                    description=f"*{podium_desc[i]}*",
                    color=podium_colors[i],
                    timestamp=datetime.now()
                )
                if logo:
                    embed.set_thumbnail(url=logo)
                embed.add_field(name="⭐ Points totaux",  value=f"**{int(pts)}**",      inline=True)
                embed.add_field(name="🏅 Position",       value=f"**#{i+1}**",          inline=True)
                embed.add_field(name="👥 Membres",        value=f"**{nb_membres}/{GUILDE_MAX_MEMBRES}**", inline=True)
                embed.add_field(name="👑 Chef",           value=owner_name,              inline=True)
                embed.add_field(name="🏅 Niveau",         value=f"**{level_info['level']}** — {level_info['title']}", inline=True)
                if top_lines:
                    embed.add_field(name="🏆 Top membres", value="\n".join(top_lines),  inline=False)
                embed.set_footer(text=f"ShinyBot · Guildes • Rang #{i+1}")
                await channel.send(embed=embed, view=GuildePodiumView(gid))
                await asyncio.sleep(1.0)

            # ── Reste du classement (groupes de 10) ───────────────────────────
            if len(rows) > 3:
                rest = rows[3:]
                for batch_start in range(0, len(rest), 10):
                    batch = rest[batch_start:batch_start+10]
                    rank_start = batch_start + 4
                    lines = []
                    for k, (gid, nom, emoji, owner_id, nb, pts, logo, gxp) in enumerate(batch):
                        owner = disc_guild.get_member(int(owner_id))
                        owner_name = owner.display_name if owner else f"<@{owner_id}>"
                        lvl = get_guilde_level_info(gxp)['level']
                        lines.append(
                            f"**#{rank_start+k}** {emoji} **{nom}** *(Niv. {lvl})* — {int(pts)} pts · "
                            f"{nb} membre{'s' if nb!=1 else ''} *(chef : {owner_name})*"
                        )
                    embed = discord.Embed(
                        title=f"⚔️ Guildes #{rank_start} – #{rank_start+len(batch)-1}",
                        description="\n".join(lines),
                        color=discord.Color.blurple(),
                        timestamp=datetime.now()
                    )
                    embed.set_footer(text="ShinyBot · Classement des Guildes")
                    await channel.send(embed=embed, view=GuildeGroupSelectView(batch))
                    await asyncio.sleep(1.0)

            logger.info("✅ Classement guildes mis à jour avec succès")
            return True

        last_guilde_classement_update = datetime.now()
        await discord_retry_wrapper(
            _update,
            context="Guilde Classement Update",
            required_permissions=['send_messages', 'manage_messages']
        )



@bot.tree.command(
    name="guilde_modifier",
    description="Modifier ta guilde — emoji, nom ou description (chef uniquement)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    champ="Ce que tu veux modifier",
    valeur="Nouvelle valeur"
)
@app_commands.choices(champ=[
    app_commands.Choice(name="🎨 Emoji — changer l'emoji de la guilde", value="emoji"),
    app_commands.Choice(name="✏️ Nom — renommer ta guilde",              value="nom"),
    app_commands.Choice(name="📝 Description — modifier la description", value="description"),
])
async def guilde_modifier(interaction: discord.Interaction, champ: str, valeur: str):
    user_id = str(interaction.user.id)
    is_admin = interaction.user.guild_permissions.administrator

    guilde = guilde_of_user(user_id)
    if not guilde:
        await interaction.response.send_message("❌ Tu n'es dans aucune guilde.", ephemeral=True)
        return
    if guilde[3] != user_id and not is_admin:
        await interaction.response.send_message("❌ Seul le chef de la guilde peut modifier ces informations.", ephemeral=True)
        return

    valeur = valeur.strip()
    if not valeur:
        await interaction.response.send_message("❌ La valeur ne peut pas être vide.", ephemeral=True)
        return

    if champ == "emoji":
        import re as _re
        disc_guild = bot.get_guild(GUILD_ID)
        m = _re.match(r'^<(a?):[\w]+:\d+>$', valeur)
        if m:
            emoji_str = valeur
        elif disc_guild:
            nom_cherche = valeur.strip(':')
            found = discord.utils.get(disc_guild.emojis, name=nom_cherche)
            emoji_str = str(found) if found else valeur
        else:
            emoji_str = valeur
        if len(emoji_str) > 100:
            await interaction.response.send_message("❌ Emoji trop long.", ephemeral=True)
            return
        cursor.execute("UPDATE shinyhunter_guildes SET emoji=? WHERE id=?", (emoji_str, guilde[0]))
        conn.commit()
        embed = discord.Embed(
            title="✅ Emoji mis à jour !",
            description=f"Le nouvel emoji de **{guilde[1]}** est : {emoji_str}",
            color=discord.Color.green()
        )
        asyncio.create_task(update_guilde_classement_message())

    elif champ == "nom":
        if len(valeur) > GUILDE_NOM_MAX:
            await interaction.response.send_message(f"❌ Nom trop long (max {GUILDE_NOM_MAX} caractères).", ephemeral=True)
            return
        if guilde_get_by_name(valeur) and valeur.lower() != guilde[1].lower():
            await interaction.response.send_message(f"❌ Une guilde nommée **{valeur}** existe déjà.", ephemeral=True)
            return
        ancien = guilde[1]
        cursor.execute("UPDATE shinyhunter_guildes SET nom=? WHERE id=?", (valeur, guilde[0]))
        conn.commit()
        embed = discord.Embed(
            title="✅ Guilde renommée !",
            description=f"**{ancien}** → **{valeur}**",
            color=discord.Color.green()
        )
        asyncio.create_task(update_guilde_classement_message())

    elif champ == "description":
        if len(valeur) > 300:
            await interaction.response.send_message("❌ Description trop longue (max 300 caractères).", ephemeral=True)
            return
        cursor.execute("UPDATE shinyhunter_guildes SET description=? WHERE id=?", (valeur, guilde[0]))
        conn.commit()
        embed = discord.Embed(
            title="✅ Description mise à jour !",
            description=f"**{guilde[1]}**\n\n{valeur}",
            color=discord.Color.green()
        )
    else:
        await interaction.response.send_message("❌ Champ inconnu.", ephemeral=True)
        return

    embed.set_footer(text="ShinyBot · Guildes")
    await interaction.response.send_message(embed=embed, ephemeral=True)


@bot.tree.command(
    name="guilde_creer",
    description="Créer une nouvelle guilde (tu en deviens le chef)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    nom="Nom de la guilde (max 30 caractères)",
    emoji="Emoji représentant la guilde (optionnel, défaut ⚔️)",
    description="Courte description de la guilde (optionnel)"
)
async def guilde_creer(interaction: discord.Interaction, nom: str, emoji: str = "⚔️", description: str = ""):
    user_id = str(interaction.user.id)

    if len(nom) > GUILDE_NOM_MAX:
        await interaction.response.send_message(f"❌ Le nom est trop long (max {GUILDE_NOM_MAX} caractères).", ephemeral=True)
        return

    # Vérifier que l'utilisateur n'est pas déjà dans une guilde
    existing = guilde_of_user(user_id)
    if existing:
        await interaction.response.send_message(
            f"❌ Tu es déjà membre de la guilde **{existing[1]}**. Quitte-la d'abord avec `/guilde_quitter`.",
            ephemeral=True
        )
        return

    # Vérifier unicité du nom
    if guilde_get_by_name(nom):
        await interaction.response.send_message(f"❌ Une guilde nommée **{nom}** existe déjà.", ephemeral=True)
        return

    try:
        cursor.execute("""
            INSERT INTO shinyhunter_guildes (nom, description, owner_id, emoji)
            VALUES (?, ?, ?, ?)
        """, (nom, description[:200], user_id, emoji[:8]))
        guilde_id = cursor.lastrowid
        cursor.execute("INSERT INTO shinyhunter_guilde_membres (guilde_id, user_id) VALUES (?, ?)", (guilde_id, user_id))
        conn.commit()
        auto_assign_guilde_weekly_objective(guilde_ids=[guilde_id])
    except Exception:
        conn.rollback()
        await interaction.response.send_message("❌ Ce nom de guilde est déjà pris ou invalide.", ephemeral=True)
        return

    embed = discord.Embed(
        title=f"{emoji} Guilde **{nom}** créée !",
        description=description or "*Pas de description.*",
        color=discord.Color.green()
    )
    embed.add_field(name="👑 Chef", value=interaction.user.mention, inline=True)
    embed.add_field(name="👥 Membres", value="1", inline=True)
    embed.set_footer(text="ShinyBot · Guildes • /guilde_classement pour voir le classement")
    await interaction.response.send_message(embed=embed)


class GuildeSupprimerConfirmView(discord.ui.View):
    """Étape de confirmation avant suppression définitive d'une guilde (action irréversible)."""
    def __init__(self, guilde_id, guilde_nom, requester_id):
        super().__init__(timeout=60)
        self.guilde_id = guilde_id
        self.guilde_nom = guilde_nom
        self.requester_id = requester_id

    @discord.ui.button(label="🗑️ Confirmer la suppression", style=discord.ButtonStyle.danger)
    async def confirm(self, interaction: discord.Interaction, button: discord.ui.Button):
        if str(interaction.user.id) != self.requester_id:
            await interaction.response.send_message("❌ Seule la personne à l'origine de la demande peut confirmer.", ephemeral=True)
            return
        cursor.execute("DELETE FROM shinyhunter_guilde_membres WHERE guilde_id=?", (self.guilde_id,))
        cursor.execute("DELETE FROM shinyhunter_guildes WHERE id=?", (self.guilde_id,))
        conn.commit()
        await interaction.response.edit_message(content=f"🗑️ La guilde **{self.guilde_nom}** a été supprimée.", view=None)

    @discord.ui.button(label="Annuler", style=discord.ButtonStyle.secondary)
    async def cancel(self, interaction: discord.Interaction, button: discord.ui.Button):
        if str(interaction.user.id) != self.requester_id:
            await interaction.response.send_message("❌ Seule la personne à l'origine de la demande peut annuler.", ephemeral=True)
            return
        await interaction.response.edit_message(content="❎ Suppression annulée.", view=None)


@bot.tree.command(
    name="guilde_supprimer",
    description="Supprimer ta guilde (chef uniquement) ou une guilde quelconque (admin)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(nom="Nom de la guilde à supprimer")
async def guilde_supprimer(interaction: discord.Interaction, nom: str):
    user_id = str(interaction.user.id)
    is_admin = interaction.user.guild_permissions.administrator

    guilde = guilde_get_by_name(nom)
    if not guilde:
        await interaction.response.send_message(f"❌ Aucune guilde nommée **{nom}**.", ephemeral=True)
        return

    if guilde[3] != user_id and not is_admin:
        await interaction.response.send_message("❌ Seul le chef de la guilde (ou un admin) peut la supprimer.", ephemeral=True)
        return

    nb_membres = len(guilde_get_members(guilde[0]))
    level_info = get_guilde_level_info(guilde[7] if len(guilde) > 7 else 0)
    view = GuildeSupprimerConfirmView(guilde[0], guilde[1], user_id)
    await interaction.response.send_message(
        f"⚠️ **Es-tu sûr(e) de vouloir supprimer la guilde {guilde[1]} ?**\n\n"
        f"Cette action est **irréversible**. Elle effacera :\n"
        f"• {nb_membres} membre(s)\n"
        f"• Son niveau actuel (**{level_info['level']} — {level_info['title']}**) et toute son XP accumulée\n",
        view=view, ephemeral=True
    )


@bot.tree.command(
    name="guilde_rejoindre",
    description="Envoyer une demande pour rejoindre une guilde",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    nom="Nom de la guilde à rejoindre",
    message="Message de présentation pour le chef (optionnel)"
)
async def guilde_rejoindre(interaction: discord.Interaction, nom: str, message: str = ""):
    user_id = str(interaction.user.id)

    existing = guilde_of_user(user_id)
    if existing:
        await interaction.response.send_message(
            f"❌ Tu es déjà dans la guilde **{existing[1]}**. Quitte-la d'abord avec `/guilde_quitter`.",
            ephemeral=True
        )
        return

    guilde = guilde_get_by_name(nom)
    if not guilde:
        await interaction.response.send_message(f"❌ Aucune guilde nommée **{nom}**.", ephemeral=True)
        return

    membres = guilde_get_members(guilde[0])
    if len(membres) >= GUILDE_MAX_MEMBRES:
        await interaction.response.send_message(
            f"❌ La guilde **{guilde[1]}** est pleine ({GUILDE_MAX_MEMBRES} membres max).",
            ephemeral=True
        )
        return

    # Vérifier si une demande est déjà en attente
    cursor.execute("""
        SELECT id, status FROM shinyhunter_guilde_demandes
        WHERE guilde_id=? AND user_id=?
    """, (guilde[0], user_id))
    existing_req = cursor.fetchone()
    if existing_req and existing_req[1] == 'pending':
        await interaction.response.send_message(
            f"⏳ Tu as déjà une demande en attente pour **{guilde[1]}**. Attends la réponse du chef.",
            ephemeral=True
        )
        return

    # Créer ou réinitialiser la demande
    cursor.execute("""
        INSERT INTO shinyhunter_guilde_demandes (guilde_id, user_id, message, status)
        VALUES (?, ?, ?, 'pending')
        ON CONFLICT(guilde_id, user_id) DO UPDATE SET message=excluded.message, status='pending', created_at=datetime('now')
    """, (guilde[0], user_id, message[:300]))
    demande_id = cursor.lastrowid or existing_req[0]
    conn.commit()

    # Confirmer au candidat
    embed_candidat = discord.Embed(
        title=f"📨 Demande envoyée — {guilde[4]} {guilde[1]}",
        description=(
            f"Ta demande a été transmise au chef de la guilde.\n"
            f"Tu seras notifié par DM dès qu'elle sera traitée."
        ),
        color=discord.Color.blurple()
    )
    if guilde[5]:  # logo
        embed_candidat.set_thumbnail(url=guilde[5])
    embed_candidat.set_footer(text="ShinyBot · Guildes")
    await interaction.response.send_message(embed=embed_candidat, ephemeral=True)

    # Notifier le chef en DM
    try:
        disc_guild = bot.get_guild(GUILD_ID)
        chef = disc_guild.get_member(int(guilde[3])) if disc_guild else None
        if chef:
            embed_chef = discord.Embed(
                title=f"📬 Nouvelle demande — {guilde[4]} {guilde[1]}",
                description=(
                    f"**{interaction.user.display_name}** souhaite rejoindre ta guilde !"
                ),
                color=discord.Color.gold()
            )
            embed_chef.set_thumbnail(url=interaction.user.display_avatar.url)
            if message:
                embed_chef.add_field(name="💬 Message", value=message[:1024], inline=False)
            embed_chef.add_field(name="👥 Membres actuels", value=f"{len(membres)}/{GUILDE_MAX_MEMBRES}", inline=True)
            embed_chef.set_footer(text="ShinyBot · Utilise les boutons ci-dessous pour répondre")
            view = GuildeDemandeView(demande_id, guilde[0], interaction.user.id, guilde[1])
            await chef.send(embed=embed_chef, view=view)
    except discord.Forbidden:
        # Le chef a les DMs fermés → fallback dans le salon
        pass
    except Exception as e:
        logger.error(f"Erreur notification chef guilde: {e}")


@bot.tree.command(
    name="guilde_quitter",
    description="Quitter ta guilde actuelle",
    guild=discord.Object(id=GUILD_ID)
)
async def guilde_quitter(interaction: discord.Interaction):
    user_id = str(interaction.user.id)
    guilde = guilde_of_user(user_id)

    if not guilde:
        await interaction.response.send_message("❌ Tu n'es dans aucune guilde.", ephemeral=True)
        return

    # Si le joueur est chef et qu'il reste des membres, bloquer
    membres = guilde_get_members(guilde[0])
    if guilde[3] == user_id and len(membres) > 1:
        await interaction.response.send_message(
            "❌ Tu es chef de la guilde. Transfère d'abord la direction avec `/guilde_transferer` "
            "ou supprime la guilde avec `/guilde_supprimer`.",
            ephemeral=True
        )
        return

    cursor.execute("DELETE FROM shinyhunter_guilde_membres WHERE guilde_id=? AND user_id=?", (guilde[0], user_id))
    # Si plus de membres, supprimer la guilde automatiquement
    remaining = guilde_get_members(guilde[0])
    if not remaining:
        cursor.execute("DELETE FROM shinyhunter_guildes WHERE id=?", (guilde[0],))
    conn.commit()

    await interaction.response.send_message(f"👋 Tu as quitté la guilde **{guilde[1]}**.", ephemeral=False)


@bot.tree.command(
    name="guilde_demandes",
    description="Voir et gérer les demandes d'adhésion en attente (chef de guilde)",
    guild=discord.Object(id=GUILD_ID)
)
async def guilde_demandes(interaction: discord.Interaction):
    user_id = str(interaction.user.id)
    is_admin = interaction.user.guild_permissions.administrator

    # Trouver la guilde dont l'utilisateur est chef
    cursor.execute("SELECT * FROM shinyhunter_guildes WHERE owner_id=?", (user_id,))
    guilde = cursor.fetchone()

    if not guilde and not is_admin:
        await interaction.response.send_message(
            "❌ Tu n'es chef d'aucune guilde.", ephemeral=True
        )
        return

    # Admin sans guilde propre : montrer toutes les demandes
    if not guilde and is_admin:
        cursor.execute("""
            SELECT d.id, d.guilde_id, g.nom, g.emoji, d.user_id, d.message, d.created_at
            FROM shinyhunter_guilde_demandes d
            JOIN shinyhunter_guildes g ON g.id = d.guilde_id
            WHERE d.status='pending'
            ORDER BY d.created_at ASC
        """)
    else:
        cursor.execute("""
            SELECT d.id, d.guilde_id, g.nom, g.emoji, d.user_id, d.message, d.created_at
            FROM shinyhunter_guilde_demandes d
            JOIN shinyhunter_guildes g ON g.id = d.guilde_id
            WHERE d.guilde_id=? AND d.status='pending'
            ORDER BY d.created_at ASC
        """, (guilde[0],))

    demandes = cursor.fetchall()

    if not demandes:
        await interaction.response.send_message(
            "📭 Aucune demande en attente pour ta guilde.", ephemeral=True
        )
        return

    await interaction.response.defer(ephemeral=True)
    disc_guild = bot.get_guild(GUILD_ID)

    for d_id, g_id, g_nom, g_emoji, candidat_uid, msg, created in demandes:
        candidat = disc_guild.get_member(int(candidat_uid)) if disc_guild else None
        candidat_name = candidat.display_name if candidat else f"<@{candidat_uid}>"

        embed = discord.Embed(
            title=f"📬 Demande de {candidat_name}",
            description=f"Souhaite rejoindre **{g_emoji} {g_nom}**",
            color=discord.Color.gold()
        )
        if candidat:
            embed.set_thumbnail(url=candidat.display_avatar.url)
        if msg:
            embed.add_field(name="💬 Message", value=msg[:1024], inline=False)
        embed.set_footer(text=f"ShinyBot · Demande reçue le {created[:10]}")
        view = GuildeDemandeView(d_id, g_id, int(candidat_uid), g_nom)
        await interaction.followup.send(embed=embed, view=view, ephemeral=True)


@bot.tree.command(
    name="guilde_transferer",
    description="Transférer le rôle de chef à un autre membre",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(membre="Le membre à qui transférer la direction")
async def guilde_transferer(interaction: discord.Interaction, membre: discord.Member):
    user_id = str(interaction.user.id)
    guilde = guilde_of_user(user_id)

    if not guilde:
        await interaction.response.send_message("❌ Tu n'es dans aucune guilde.", ephemeral=True)
        return
    if guilde[3] != user_id:
        await interaction.response.send_message("❌ Seul le chef peut transférer la direction.", ephemeral=True)
        return
    if str(membre.id) == user_id:
        await interaction.response.send_message("❌ Tu es déjà le chef.", ephemeral=True)
        return

    # Vérifier que le nouveau chef est bien dans la guilde
    membres_ids = [m[0] for m in guilde_get_members(guilde[0])]
    if str(membre.id) not in membres_ids:
        await interaction.response.send_message(f"❌ {membre.display_name} n'est pas dans ta guilde.", ephemeral=True)
        return

    cursor.execute("UPDATE shinyhunter_guildes SET owner_id=? WHERE id=?", (str(membre.id), guilde[0]))
    conn.commit()

    await interaction.response.send_message(
        f"👑 La direction de **{guilde[1]}** a été transférée à {membre.mention} !"
    )


@bot.tree.command(
    name="guilde",
    description="Voir les infos de ta guilde (membres, points, classement général)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(nom="Nom d'une guilde spécifique (laisse vide pour voir la tienne)")
async def guilde_cmd(interaction: discord.Interaction, nom: str = ""):
    await interaction.response.defer(ephemeral=True)
    disc_guild = bot.get_guild(GUILD_ID)

    def build_info_embed(guilde):
        guilde_id, g_nom, g_desc, owner_id, g_emoji, g_logo, g_created = (
            guilde[0], guilde[1], guilde[2], guilde[3], guilde[4], guilde[5], guilde[6]
        )
        g_xp = guilde[7] if len(guilde) > 7 else 0
        level_info = get_guilde_level_info(g_xp)
        membres = guilde_get_members(guilde_id)
        pts_total = guilde_get_points(guilde_id)

        cursor.execute("""
            SELECT m.user_id, COALESCE(SUM(s.points), 0) as pts
            FROM shinyhunter_guilde_membres m
            LEFT JOIN shiny s ON s.user_id = m.user_id
            WHERE m.guilde_id = ?
            GROUP BY m.user_id ORDER BY pts DESC
        """, (guilde_id,))
        membres_pts = cursor.fetchall()

        medals = ["🥇", "🥈", "🥉"]
        lines = []
        for i, (uid, pts) in enumerate(membres_pts):
            member = disc_guild.get_member(int(uid)) if disc_guild else None
            name = member.display_name if member else f"<@{uid}>"
            crown = " 👑" if uid == owner_id else ""
            medal = medals[i] if i < 3 else f"`#{i+1}`"
            lines.append(f"{medal} **{name}**{crown} — {pts:.0f} pts")

        embed = discord.Embed(
            title=f"{g_emoji} {g_nom}",
            description=g_desc or "*Pas de description.*",
            color=level_info['color']
        )
        if g_logo:
            embed.set_thumbnail(url=g_logo)
        embed.add_field(name="⭐ Points totaux", value=f"**{pts_total:.0f}** pts", inline=True)
        embed.add_field(name="👥 Membres", value=f"{len(membres)}/{GUILDE_MAX_MEMBRES}", inline=True)
        embed.add_field(name="🏅 Niveau", value=f"**{level_info['level']}** — {level_info['title']}", inline=True)
        if level_info['next_level']:
            xp_bar = render_progress_bar(level_info['progress_ratio'])
            embed.add_field(
                name="✨ Progression",
                value=f"`{xp_bar}` {level_info['xp_to_next']:.0f} XP avant **{level_info['next_title']}**",
                inline=False
            )
        else:
            embed.add_field(name="✨ Progression", value="🏆 Niveau maximum atteint !", inline=False)
        if level_info['bonus_multiplier'] > 1.0:
            embed.add_field(
                name="🎁 Bonus de niveau",
                value=f"+{int((level_info['bonus_multiplier']-1)*100)}% sur les bonus d'objectif de guilde",
                inline=False
            )
        embed.add_field(name="📊 Classement interne", value="\n".join(lines) if lines else "—", inline=False)
        embed.set_footer(text=f"ShinyBot · Guildes • Créée le {g_created[:10]}")
        return embed

    def build_classement_embed():
        cursor.execute("""
            SELECT g.id, g.nom, g.emoji, COALESCE(SUM(s.points),0) as pts, COUNT(DISTINCT m.user_id) as nb, g.xp
            FROM shinyhunter_guildes g
            LEFT JOIN shinyhunter_guilde_membres m ON g.id=m.guilde_id
            LEFT JOIN shiny s ON s.user_id=m.user_id
            GROUP BY g.id ORDER BY pts DESC LIMIT 15
        """)
        rows = cursor.fetchall()
        medals = ["🥇", "🥈", "🥉"]
        lines = []
        for i, (gid, gnom, gemoji, pts, nb, gxp) in enumerate(rows):
            medal = medals[i] if i < 3 else f"`#{i+1}`"
            lvl = get_guilde_level_info(gxp)['level']
            lines.append(f"{medal} {gemoji} **{gnom}** *(Niv. {lvl})* — {pts:.0f} pts · {nb} membre{'s' if nb > 1 else ''}")
        embed = discord.Embed(
            title="🏆 Classement des Guildes",
            description="\n".join(lines) if lines else "Aucune guilde.",
            color=discord.Color.gold()
        )
        embed.set_footer(text="ShinyBot · Guildes")
        return embed

    # Résoudre la guilde cible
    if nom:
        target_guilde = guilde_get_by_name(nom)
        if not target_guilde:
            await interaction.followup.send(f"❌ Aucune guilde nommée **{nom}**.", ephemeral=True)
            return
    else:
        target_guilde = guilde_of_user(interaction.user.id)
        if not target_guilde:
            await interaction.followup.send(
                "❌ Tu n'es dans aucune guilde. Utilise `/guilde_creer` ou `/guilde_rejoindre`.",
                ephemeral=True
            )
            return

    class GuildeView(discord.ui.View):
        def __init__(self, guilde, page="info"):
            super().__init__(timeout=300)
            self.guilde = guilde
            self.page = page

        @discord.ui.button(label="🏠 Ma Guilde", style=discord.ButtonStyle.primary, custom_id="g_info")
        async def btn_info(self, inter: discord.Interaction, button: discord.ui.Button):
            await inter.response.edit_message(embed=build_info_embed(self.guilde), view=self)

        @discord.ui.button(label="🏆 Classement", style=discord.ButtonStyle.secondary, custom_id="g_classement")
        async def btn_classement(self, inter: discord.Interaction, button: discord.ui.Button):
            await inter.response.edit_message(embed=build_classement_embed(), view=self)

    embed = build_info_embed(target_guilde)
    await interaction.followup.send(embed=embed, view=GuildeView(target_guilde), ephemeral=True)


@bot.tree.command(
    name="guilde_voir",
    description="Voir l'objectif de ta guilde cette semaine et sa progression",
    guild=discord.Object(id=GUILD_ID)
)
async def guilde_voir(interaction: discord.Interaction):
    await interaction.response.defer(ephemeral=True)
    guilde = guilde_of_user(interaction.user.id)
    if not guilde:
        await interaction.followup.send("❌ Tu n'es dans aucune guilde.", ephemeral=True)
        return

    week_start = get_current_week_start()
    chosen = get_guilde_weekly_choice(guilde[0])

    embed = discord.Embed(
        title=f"🏰 {guilde[4]} {guilde[1]} — Objectif de la semaine",
        description=f"Semaine du **{week_start}**",
        color=discord.Color.blurple()
    )

    if chosen:
        progress = get_guilde_objective_progress(guilde[0], chosen['id'])
        current = int(progress['current_value'] or 0)
        target = int(chosen['target_value'])
        bar_filled = int((current / target) * 10) if target else 0
        bar = "█" * bar_filled + "░" * (10 - bar_filled)
        status = "✅ Complété !" if progress.get('bonus_awarded') else ("🟡 Atteint, bonus en attente" if progress.get('completed') else "⬜ En cours")
        extra_txt = f"\nCible : `{chosen['target_extra']}`" if chosen.get('target_extra') else ""
        embed.add_field(
            name="🎯 Objectif choisi",
            value=(
                f"**{chosen['description']}**{extra_txt}\n"
                f"`{bar}` **{current}/{target}**\n"
                f"Bonus guilde : **+{chosen['bonus_points']:.0f} pts** · {status}"
            ),
            inline=False
        )
    else:
        embed.add_field(
            name="🎯 Objectif choisi",
            value="⚠️ Aucun objectif actif cette semaine pour l'instant.",
            inline=False
        )

    embed.set_footer(text="🎯 Objectif assigné automatiquement chaque semaine à toutes les guildes • ShinyBot")

    await interaction.followup.send(embed=embed, ephemeral=True)


GUILDE_OBJECTIVE_NEEDS_EXTRA = {'method', 'game', 'pokemon', 'letter', 'pokemon_type'}
GUILDE_OBJECTIVE_EXTRA_LABEL = {
    'method': "Nom de la méthode (ex: Poké Radar)",
    'game': "Nom du jeu (ex: Écarlate)",
    'pokemon': "Nom du Pokémon (ex: Ronflex)",
    'letter': "Lettre de départ (ex: R)",
    'pokemon_type': "Type (ex: Feu)",
}


class GuildeObjectifTypeSelect(discord.ui.View):
    """Étape 1 : choisir le type d'objectif de guilde."""
    def __init__(self):
        super().__init__(timeout=180)
        options = [
            discord.SelectOption(label=label[:100], value=key)
            for key, label in GUILDE_OBJECTIVE_TYPES.items()
        ]
        select = discord.ui.Select(placeholder="🎯 Choisis le type d'objectif", options=options)
        select.callback = self.type_selected
        self.add_item(select)

    async def type_selected(self, interaction: discord.Interaction):
        type_key = interaction.data['values'][0]
        view = GuildeObjectifDifficulteSelect(type_key)
        await interaction.response.edit_message(
            content=f"Type choisi : **{GUILDE_OBJECTIVE_TYPES[type_key]}**\n\n🎚️ Choisis maintenant la difficulté :",
            view=view
        )


class GuildeObjectifDifficulteSelect(discord.ui.View):
    """Étape 2 : choisir la difficulté, puis ouvrir le formulaire."""
    def __init__(self, type_key):
        super().__init__(timeout=180)
        self.type_key = type_key
        options = [
            discord.SelectOption(label="🟢 Facile", value="easy"),
            discord.SelectOption(label="🟡 Moyen", value="medium"),
            discord.SelectOption(label="🔴 Difficile", value="hard"),
        ]
        select = discord.ui.Select(placeholder="🎚️ Choisis la difficulté", options=options)
        select.callback = self.diff_selected
        self.add_item(select)

    async def diff_selected(self, interaction: discord.Interaction):
        modal = GuildeObjectifModal(self.type_key, interaction.data['values'][0])
        await interaction.response.send_modal(modal)


class GuildeObjectifModal(discord.ui.Modal, title="Créer un objectif de guilde"):
    """Étape 3 : formulaire — seuls les champs pertinents pour le type choisi apparaissent."""
    description_input = discord.ui.TextInput(
        label="Description (affichée aux guildes)",
        placeholder="Ex: Trouver un Ronflex shiny en équipe",
        max_length=200
    )
    cible_input = discord.ui.TextInput(
        label="Objectif à atteindre (nombre)",
        placeholder="Ex: 5",
        max_length=10
    )
    bonus_input = discord.ui.TextInput(
        label="Points bonus pour la guilde",
        placeholder="Ex: 200",
        max_length=10
    )

    def __init__(self, type_key, difficulty):
        super().__init__()
        self.type_key = type_key
        self.difficulty = difficulty
        self.extra_input = None
        if type_key in GUILDE_OBJECTIVE_NEEDS_EXTRA:
            self.extra_input = discord.ui.TextInput(
                label=GUILDE_OBJECTIVE_EXTRA_LABEL[type_key],
                max_length=50
            )
            self.add_item(self.extra_input)

    async def on_submit(self, interaction: discord.Interaction):
        try:
            cible = float(self.cible_input.value.strip().replace(',', '.'))
            bonus = float(self.bonus_input.value.strip().replace(',', '.'))
        except ValueError:
            await interaction.response.send_message("❌ `Objectif` et `Points bonus` doivent être des nombres.", ephemeral=True)
            return

        extra = self.extra_input.value.strip() if self.extra_input else None
        description = self.description_input.value.strip()

        cursor.execute("""
            INSERT INTO guilde_objectives_pool
                (type, description, target_value, bonus_points, difficulty, target_extra, created_by)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (self.type_key, description[:200], cible, bonus, self.difficulty, extra, str(interaction.user.id)))
        conn.commit()
        pool_id = cursor.lastrowid

        diff_emoji = {"easy": "🟢", "medium": "🟡", "hard": "🔴"}.get(self.difficulty, "")
        recap = f"✅ Objectif ajouté au pool : **{description}** (`#{pool_id}`)\n{diff_emoji} {GUILDE_OBJECTIVE_TYPES[self.type_key]} · Cible : **{cible:g}** · Bonus : **+{bonus:g} pts**"
        if extra:
            recap += f" · {extra}"
        recap += "\n\nVeux-tu le proposer aux guildes **cette semaine** dès maintenant ?"

        view = GuildeObjectifActivateView(pool_id, description)
        await interaction.response.send_message(recap, view=view, ephemeral=True)


class GuildeObjectifActivateView(discord.ui.View):
    """Étape 4 (optionnelle) : activer directement l'objectif pour la semaine en cours."""
    def __init__(self, pool_id, description):
        super().__init__(timeout=120)
        self.pool_id = pool_id
        self.description = description

    @discord.ui.button(label="🗓️ Activer cette semaine", style=discord.ButtonStyle.success)
    async def activate(self, interaction: discord.Interaction, button: discord.ui.Button):
        week_start = get_current_week_start()
        cursor.execute("""
            SELECT id, type, description, target_value, bonus_points, difficulty, target_extra
            FROM guilde_objectives_pool WHERE id=? AND is_active=1
        """, (self.pool_id,))
        row = cursor.fetchone()
        if not row:
            await interaction.response.edit_message(content="❌ Objectif introuvable ou retiré du pool entre-temps.", view=None)
            return
        pool_id, otype, desc, target, bonus, diff, extra_db = row
        cursor.execute("""
            INSERT INTO guilde_weekly_objectives
                (pool_id, type, description, target_value, bonus_points, difficulty, target_extra, week_start, created_by)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (pool_id, otype, desc, target, bonus, diff, extra_db, week_start, str(interaction.user.id)))
        conn.commit()
        await interaction.response.edit_message(
            content=f"✅ **{self.description}** est maintenant proposé aux guildes pour la semaine en cours !",
            view=None
        )

    @discord.ui.button(label="Pool seulement", style=discord.ButtonStyle.secondary)
    async def skip(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.edit_message(
            content=f"✅ **{self.description}** ajouté au pool (pas encore actif cette semaine — utilise `/guilde_admin action:semaine` plus tard si besoin).",
            view=None
        )


