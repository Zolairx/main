@bot.tree.command(
    name="ranked_missions_variete",
    description="Missions variété de la semaine (jeux / méthodes / Full Odds)",
    guild=discord.Object(id=GUILD_ID)
)
async def ranked_missions_variete(interaction: discord.Interaction):
    user_id = str(interaction.user.id)
    ws = get_current_week_start()
    stats = get_weekly_mission_stats(user_id, ws)
    lines = []
    for mkey, kind, need, bonus, desc in WEEKLY_VARIETY_MISSIONS:
        ok = is_variety_mission_claimed(user_id, ws, mkey)
        st = "✅" if ok else "⬜"
        current = mission_current_value(stats, kind)
        label = mission_kind_label(kind)
        lines.append(f"{st} **+{bonus:.0f}** — {desc} `({min(current, need)}/{need} {label})`")
    progress = (
        f"**Ta progression (lundi → aujourd’hui)**\n"
        f"Jeux distincts : **{stats.get('games', 0)}** | Méthodes distinctes : **{stats.get('methods', 0)}** | Full Odds : **{stats.get('full_odds_count', 0)}**"
    )
    embed = discord.Embed(
        title="🎯 Missions variété (semaine en cours)",
        description=progress,
        color=discord.Color.green(),
        timestamp=datetime.now()
    )

    # Discord : chaque field est limité à 1024 chars — on découpe en chunks
    FIELD_LIMIT = 1024
    chunk = ""
    chunk_index = 1
    for line in lines:
        candidate = (chunk + "\n" + line).lstrip("\n") if chunk else line
        if len(candidate) > FIELD_LIMIT:
            embed.add_field(
                name="Paliers" if chunk_index == 1 else f"Paliers (suite {chunk_index})",
                value=chunk,
                inline=False
            )
            chunk = line
            chunk_index += 1
        else:
            chunk = candidate
    if chunk:
        embed.add_field(
            name="Paliers" if chunk_index == 1 else f"Paliers (suite {chunk_index})",
            value=chunk,
            inline=False
        )

    embed.set_footer(text=f"Semaine du {ws} · Bonus crédités en points (hors cap, comme les autres objectifs)")
    await interaction.response.send_message(embed=embed, ephemeral=True)


