def get_shiny_candidates():
    """Récupère tous les candidats pour le vote"""
    cursor.execute("SELECT id, pokemon_name, image_url, encounters, game, method FROM shiny_candidates ORDER BY id")
    return cursor.fetchall()

def add_shiny_candidate(pokemon_name, image_url, encounters, game, method, added_by):
    """Ajoute un candidat au vote avec sauvegarde automatique de l'image"""
    cursor.execute("SELECT COUNT(*) FROM shiny_candidates", ())
    count = cursor.fetchone()[0]

    if count >= 15:
        return False, "La liste est pleine (maximum 15 Pokémon)"

    cursor.execute(
        "INSERT INTO shiny_candidates (pokemon_name, image_url, encounters, game, method, added_by) VALUES (?, ?, ?, ?, ?, ?)",
        (pokemon_name, image_url, encounters, game, method, added_by)
    )
    conn.commit()
    
    # Récupérer l'ID du candidat nouvellement créé
    candidate_id = cursor.lastrowid
    
    # Sauvegarder l'image si une URL est fournie
    if image_url and candidate_id:
        # Programmer le téléchargement de l'image en arrière-plan
        async def save_image_task():
            try:
                saved_path = await download_and_save_image(image_url, candidate_id)
                if saved_path:
                    # Mettre à jour l'URL avec le chemin local
                    cursor.execute("UPDATE shiny_candidates SET image_url = ? WHERE id = ?", (saved_path, candidate_id))
                    conn.commit()
                    logger.info(f"Image URL mise à jour pour le candidat {candidate_id}")
            except Exception as e:
                logger.error(f"Erreur lors de la sauvegarde de l'image pour le candidat {candidate_id}: {e}")
        
        # Lancer la tâche en arrière-plan
        asyncio.create_task(save_image_task())
    
    return True, "Pokémon ajouté avec succès"

def get_user_votes(user_id):
    """Récupère les votes d'un utilisateur"""
    cursor.execute("SELECT candidate_id FROM shiny_votes WHERE user_id = ? ORDER BY vote_rank", (str(user_id),))
    return [row[0] for row in cursor.fetchall()]

def add_user_vote(user_id, candidate_ids):
    """Enregistre les votes d'un utilisateur (remplace les votes précédents)"""
    cursor.execute("DELETE FROM shiny_votes WHERE user_id = ?", (str(user_id),))

    for rank, candidate_id in enumerate(candidate_ids, start=1):
        cursor.execute(
            "INSERT INTO shiny_votes (user_id, candidate_id, vote_rank) VALUES (?, ?, ?)",
            (str(user_id), candidate_id, rank)
        )
    conn.commit()

def get_vote_results():
    """Récupère les résultats du vote avec scores"""
    cursor.execute("""
        SELECT
            sc.id,
            sc.pokemon_name,
            sc.game,
            sc.method,
            sc.encounters,
            sc.image_url,
            COUNT(sv.id) as vote_count,
            SUM(CASE
                WHEN sv.vote_rank = 1 THEN 3
                WHEN sv.vote_rank = 2 THEN 2
                WHEN sv.vote_rank = 3 THEN 1
                ELSE 0
            END) as total_score
        FROM shiny_candidates sc
        LEFT JOIN shiny_votes sv ON sc.id = sv.candidate_id
        GROUP BY sc.id
        ORDER BY total_score DESC, vote_count DESC
    """)
    return cursor.fetchall()

def reset_vote_system():
    """Réinitialise complètement le système de vote et supprime toutes les images"""
    # Supprimer toutes les images des candidats
    try:
        cursor.execute("SELECT id FROM shiny_candidates")
        candidate_ids = [row[0] for row in cursor.fetchall()]
        
        for candidate_id in candidate_ids:
            delete_candidate_image(candidate_id)
            
    except Exception as e:
        logger.error(f"Erreur lors de la suppression des images: {e}")
    
    # Supprimer les données de la base
    cursor.execute("DELETE FROM shiny_votes")
    cursor.execute("DELETE FROM shiny_candidates")
    conn.commit()
    
    logger.info("Système de vote réinitialisé et images supprimées")

# ============= SYSTÈME DE GESTION DES IMAGES PERMANENTES =============

async def download_and_save_image(image_url, candidate_id):
    """Télécharge et sauvegarde une image de manière permanente"""
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(image_url) as response:
                if response.status == 200:
                    # Vérifier la taille de l'image
                    content_length = response.headers.get('content-length')
                    if content_length and int(content_length) > MAX_IMAGE_SIZE:
                        logger.warning(f"Image trop grande pour le candidat {candidate_id}: {content_length} bytes")
                        return None
                    
                    # Lire le contenu de l'image
                    image_data = await response.read()
                    
                    # Vérifier la taille réelle
                    if len(image_data) > MAX_IMAGE_SIZE:
                        logger.warning(f"Image trop grande pour le candidat {candidate_id}: {len(image_data)} bytes")
                        return None
                    
                    # Déterminer l'extension du fichier
                    content_type = response.headers.get('content-type', '')
                    if 'png' in content_type:
                        extension = 'png'
                    elif 'jpeg' in content_type or 'jpg' in content_type:
                        extension = 'jpg'
                    elif 'gif' in content_type:
                        extension = 'gif'
                    elif 'webp' in content_type:
                        extension = 'webp'
                    else:
                        extension = 'jpg'  # Par défaut
                    
                    # Créer le nom du fichier
                    filename = f"candidate_{candidate_id}.{extension}"
                    filepath = IMAGES_DIR / filename
                    
                    # Sauvegarder l'image
                    with open(filepath, 'wb') as f:
                        f.write(image_data)
                    
                    logger.info(f"Image sauvegardée: {filename}")
                    return str(filepath)
                    
    except Exception as e:
        logger.error(f"Erreur lors du téléchargement de l'image pour le candidat {candidate_id}: {e}")
    
    return None

def get_local_image_path(candidate_id):
    """Récupère le chemin de l'image locale pour un candidat"""
    for ext in ['png', 'jpg', 'jpeg', 'gif', 'webp']:
        filepath = IMAGES_DIR / f"candidate_{candidate_id}.{ext}"
        if filepath.exists():
            return str(filepath)
    return None

def delete_candidate_image(candidate_id):
    """Supprime l'image d'un candidat"""
    for ext in ['png', 'jpg', 'jpeg', 'gif', 'webp']:
        filepath = IMAGES_DIR / f"candidate_{candidate_id}.{ext}"
        if filepath.exists():
            try:
                filepath.unlink()
                logger.info(f"Image supprimée: {filepath}")
                return True
            except Exception as e:
                logger.error(f"Erreur lors de la suppression de l'image {filepath}: {e}")
    return False

def cleanup_old_images():
    """Nettoie les images orphelines (sans candidat correspondant)"""
    try:
        # Récupérer tous les IDs de candidats existants
        cursor.execute("SELECT id FROM shiny_candidates")
        existing_candidates = {row[0] for row in cursor.fetchall()}
        
        # Parcourir tous les fichiers d'images
        deleted_count = 0
        for filepath in IMAGES_DIR.glob("candidate_*.*"):
            try:
                # Extraire l'ID du candidat du nom de fichier
                filename = filepath.stem  # candidate_123
                candidate_id = int(filename.split('_')[1])
                
                # Si le candidat n'existe plus, supprimer l'image
                if candidate_id not in existing_candidates:
                    filepath.unlink()
                    deleted_count += 1
                    logger.info(f"Image orpheline supprimée: {filepath}")
                    
            except (ValueError, IndexError) as e:
                logger.warning(f"Nom de fichier invalide: {filepath} - {e}")
                continue
        
        if deleted_count > 0:
            logger.info(f"Nettoyage terminé: {deleted_count} images orphelines supprimées")
            
    except Exception as e:
        logger.error(f"Erreur lors du nettoyage des images: {e}")

# ============= SYSTÈME DE GESTION D'ERREURS AVANCÉ =============

class DiscordErrorType(enum.Enum):
    """Types d'erreurs Discord"""
    RATE_LIMITED = "rate_limited"
    SERVER_ERROR = "server_error"
    CLIENT_ERROR = "client_error"
    PERMISSION_ERROR = "permission_error"
    AUTHENTICATION_ERROR = "authentication_error"
    NOT_FOUND = "not_found"
    UNKNOWN = "unknown"

def classify_discord_error(error):
    """Classifie les erreurs Discord selon leur type"""
    if isinstance(error, discord.HTTPException):
        status = error.status
        
        if status == 429:  # Rate limited
            return DiscordErrorType.RATE_LIMITED
        elif status == 403:  # Forbidden
            return DiscordErrorType.PERMISSION_ERROR
        elif status == 401:  # Unauthorized
            return DiscordErrorType.AUTHENTICATION_ERROR
        elif status == 404:  # Not found
            return DiscordErrorType.NOT_FOUND
        elif 400 <= status < 500:  # Client errors
            return DiscordErrorType.CLIENT_ERROR
        elif 500 <= status < 600:  # Server errors
            return DiscordErrorType.SERVER_ERROR
    
    return DiscordErrorType.UNKNOWN

async def check_bot_token_validity():
    """Vérifie la validité du token de bot"""
    global bot_token_valid, last_token_check
    
    current_time = datetime.now()
    if last_token_check and (current_time - last_token_check).total_seconds() < TOKEN_CHECK_INTERVAL:
        return bot_token_valid
    
    try:
        # Test simple avec une requête légère
        await bot.fetch_user(bot.user.id)
        bot_token_valid = True
        logger.debug("Token de bot validé avec succès")
    except discord.HTTPException as e:
        if e.status == 401:
            bot_token_valid = False
            logger.error("❌ Token de bot invalide ou expiré !")
        else:
            logger.warning(f"Erreur lors de la vérification du token: {e}")
    except Exception as e:
        logger.warning(f"Erreur inattendue lors de la vérification du token: {e}")
    
    last_token_check = current_time
    return bot_token_valid

async def check_bot_permissions(guild, required_permissions=None):
    """Vérifie les permissions du bot dans une guilde"""
    if not guild:
        return False, "Guilde non trouvée"
    
    try:
        bot_member = guild.get_member(bot.user.id)
        if not bot_member:
            return False, "Bot non trouvé dans la guilde"
        
        if required_permissions:
            missing_perms = []
            for perm_name in required_permissions:
                if not getattr(bot_member.guild_permissions, perm_name, False):
                    missing_perms.append(perm_name)
            
            if missing_perms:
                return False, f"Permissions manquantes: {', '.join(missing_perms)}"
        
        return True, "Permissions OK"
    
    except Exception as e:
        return False, f"Erreur vérification permissions: {e}"

def calculate_backoff_delay(attempt, base_delay=INITIAL_RETRY_DELAY, max_delay=MAX_RETRY_DELAY, multiplier=BACKOFF_MULTIPLIER, jitter=True):
    """Calcule le délai de backoff exponentiel avec jitter optionnel - ÉQUILIBRÉ POUR L'EXPÉRIENCE"""
    delay = min(base_delay * (multiplier ** attempt), max_delay)

    if jitter:
        # Ajouter un jitter de ±30% pour éviter la synchronisation (réduit de 50% à 30%)
        jitter_amount = delay * 0.3
        delay += random.uniform(-jitter_amount, jitter_amount)

    return max(delay, 1.0)  # Minimum 1 seconde (réduit de 2s à 1s)

async def discord_retry_wrapper(func, *args, context="Discord API Call", required_permissions=None, **kwargs):
    """
    Wrapper générique pour les appels Discord avec retry automatique et gestion d'erreurs avancée
    
    Args:
        func: Fonction à exécuter
        *args: Arguments de la fonction
        context: Contexte pour le logging
        required_permissions: Liste des permissions requises
        **kwargs: Arguments nommés de la fonction
    """
    # Extraire les paramètres de contrôle
    guild = kwargs.pop('guild', None)
    permissions = kwargs.pop('required_permissions', required_permissions)
    
    # Vérifier la validité du token
    if not await check_bot_token_validity():
        logger.error(f"❌ Token invalide - Abandon de {context}")
        return None
    
    # Vérifier les permissions si requises
    if permissions and guild:
        has_perms, perm_message = await check_bot_permissions(guild, permissions)
        if not has_perms:
            logger.error(f"❌ {context} - {perm_message}")
            return None
    
    last_error = None
    
    for attempt in range(MAX_RETRIES):
        try:
            result = await func(*args, **kwargs)
            if attempt > 0:
                logger.info(f"✅ {context} réussi après {attempt + 1} tentative(s)")
            return result
        
        except Exception as error:
            last_error = error
            error_type = classify_discord_error(error)
            
            # Gérer selon le type d'erreur
            if error_type == DiscordErrorType.AUTHENTICATION_ERROR:
                logger.error(f"❌ {context} - Erreur d'authentification (token invalide)")
                bot_token_valid = False
                break
            
            elif error_type == DiscordErrorType.PERMISSION_ERROR:
                logger.error(f"❌ {context} - Erreur de permissions (403) - Pas de retry")
                break
            
            elif error_type == DiscordErrorType.CLIENT_ERROR:
                logger.error(f"❌ {context} - Erreur client ({error.status if hasattr(error, 'status') else 'inconnue'}) - Pas de retry")
                break
            
            elif error_type == DiscordErrorType.RATE_LIMITED:
                retry_after = getattr(error, 'retry_after', None)
                if retry_after:
                    # Ajouter une marge de sécurité raisonnable au retry_after
                    delay = min(retry_after + 2.0, MAX_RETRY_DELAY)  # Marge réduite de 5s à 2s
                    logger.warning(f"⏳ {context} - Rate limited, attente {delay:.1f}s (tentative {attempt + 1}/{MAX_RETRIES})")
                    await asyncio.sleep(delay)
                else:
                    # Utiliser un délai raisonnable si pas de retry_after
                    delay = calculate_backoff_delay(attempt) * 1.5  # Multiplicateur réduit de 3 à 1.5
                    logger.warning(f"⏳ {context} - Rate limited sans retry_after, attente {delay:.1f}s")
                    await asyncio.sleep(delay)
                continue
            
            elif error_type == DiscordErrorType.SERVER_ERROR:
                delay = calculate_backoff_delay(attempt)
                logger.warning(f"⏳ {context} - Erreur serveur, retry dans {delay:.1f}s (tentative {attempt + 1}/{MAX_RETRIES})")
                await asyncio.sleep(delay)
                continue
            
            elif error_type == DiscordErrorType.NOT_FOUND:
                if "Unknown interaction" in str(error):
                    logger.warning(f"⚠️ {context} - Interaction expirée (404)")
                    return None
                else:
                    logger.warning(f"⚠️ {context} - Ressource non trouvée (404)")
                    return None
            
            else:
                delay = calculate_backoff_delay(attempt)
                logger.warning(f"⏳ {context} - Erreur inconnue: {error} - Retry dans {delay:.1f}s")
                await asyncio.sleep(delay)
                continue
    
    # Si on arrive ici, toutes les tentatives ont échoué
    logger.error(f"❌ {context} - Échec après {MAX_RETRIES} tentatives. Dernière erreur: {last_error}")
    return None

# ============= FONCTIONS MISES À JOUR AVEC LE NOUVEAU SYSTÈME =============

async def update_roles():
    """Version optimisée de la mise à jour des rôles avec gestion d'erreurs avancée"""
    global last_role_update
    
    # Vérifier le cooldown
    current_time = datetime.now()
    if last_role_update and (current_time - last_role_update).total_seconds() < ROLE_UPDATE_COOLDOWN:
        logger.info("Rate limite des rôles : mise à jour ignorée (cooldown)")
        return
    
    # Acquérir le verrou pour éviter les exécutions simultanées
    async with role_update_lock:
        try:
            guild = bot.get_guild(GUILD_ID)
            if guild is None:
                logger.error("Guild non trouvée")
                return

            # Vérifier les permissions du bot
            required_perms = ['manage_roles']
            has_perms, perm_message = await check_bot_permissions(guild, required_perms)
            if not has_perms:
                logger.error(f"Mise à jour des rôles impossible: {perm_message}")
                return

            ladder = get_ladder()
            logger.info(f"Mise à jour des rôles pour {len(ladder)} utilisateurs")
            
            # Récupérer tous les rôles à l'avance
            shiny_roles = {}
            for role_key, role_id in ROLE_IDS.items():
                role = guild.get_role(role_id)
                if role:
                    shiny_roles[role_key] = role
                else:
                    logger.warning(f"Rôle {role_key} ({role_id}) introuvable")
            
            # Traiter par batch pour éviter le rate limiting
            successful_updates = 0
            failed_updates = 0
            
            for batch_start in range(0, len(ladder), ROLE_UPDATE_BATCH_SIZE):
                batch_end = min(batch_start + ROLE_UPDATE_BATCH_SIZE, len(ladder))
                batch = ladder[batch_start:batch_end]
                
                # Traitement du batch - séquentiel avec délais équilibrés
                for user_data in batch:
                    user_id, *_ = user_data
                    position = batch_start + batch.index(user_data) + 1
                    result = await update_single_user_role(guild, user_id, position, shiny_roles)

                    # Délai équilibré entre chaque mise à jour de rôle
                    await asyncio.sleep(0.8)  # Réduit de 1.5s à 0.8s

                    if result is None or isinstance(result, Exception):
                        failed_updates += 1
                    else:
                        successful_updates += 1

                # Délai raisonnable entre les batches
                if batch_end < len(ladder):
                    await asyncio.sleep(BATCH_DELAY)  # Suppression des 2s supplémentaires
                    logger.debug(f"Batch {batch_start//ROLE_UPDATE_BATCH_SIZE + 1} terminé, délai de {BATCH_DELAY}s")
            
            last_role_update = current_time
            logger.info(f"Mise à jour des rôles terminée: {successful_updates} succès, {failed_updates} échecs")
            
        except Exception as e:
            logger.error(f"Erreur globale update_roles: {e}")

async def update_single_user_role(guild, user_id, position, shiny_roles):
    """Met à jour le rôle d'un seul utilisateur avec le nouveau système de retry"""
    
    async def _update_role(**kwargs):
        member = guild.get_member(int(user_id))
        if member is None:
            return None
        
        # Déterminer le nouveau rôle
        if position == 1:
            new_role_key = "SHINY_HUNTER_1"
        elif position == 2:
            new_role_key = "SHINY_HUNTER_2"
        elif position == 3:
            new_role_key = "SHINY_HUNTER_3"
        elif 4 <= position <= 8:
            new_role_key = "SHINY_MASTER"
        elif 9 <= position <= 14:
            new_role_key = "SHINY_DE_DIAMANT"
        elif 15 <= position <= 20:
            new_role_key = "SHINY_DE_EMERAUDE"
        elif 21 <= position <= 29:
            new_role_key = "SHINY_DE_PLATINE"
        elif 30 <= position <= 39:
            new_role_key = "SHINY_D_OR"
        elif 40 <= position <= 51:
            new_role_key = "SHINY_D_ARGENT"
        else:
            new_role_key = "SHINY_NOVICE"
        
        new_role = shiny_roles.get(new_role_key)
        if not new_role:
            logger.warning(f"Nouveau rôle {new_role_key} non trouvé")
            return None
        
        # Supprimer les anciens rôles shiny
        roles_to_remove = [role for role in shiny_roles.values() if role in member.roles and role != new_role]
        if roles_to_remove:
            await member.remove_roles(*roles_to_remove, reason="Mise à jour classement shiny")
        
        # Ajouter le nouveau rôle s'il n'est pas déjà présent
        if new_role not in member.roles:
            await member.add_roles(new_role, reason="Mise à jour classement shiny")
        
        logger.debug(f"Rôle mis à jour pour {member.display_name} (#{position})")
        return True
    
    return await discord_retry_wrapper(
        _update_role,
        context=f"Role Update User {user_id}",
        guild=guild,
        required_permissions=['manage_roles']
    )

async def remove_roles_from_member(member, roles_to_remove):
    """Retire les rôles shiny d'un membre avec retry"""
    async def _remove(**kwargs):
        await member.remove_roles(*roles_to_remove, reason="Réinitialisation saison ranked")
        logger.debug(f"Rôles retirés de {member.display_name}")
        return True
    
    return await discord_retry_wrapper(
        _remove,
        context=f"Remove Roles from {member.display_name}",
        guild=member.guild,
        required_permissions=['manage_roles']
    )

async def reset_all_shiny_roles():
    """Retire tous les rôles shiny de tous les membres du serveur"""
    guild = bot.get_guild(GUILD_ID)
    if guild is None:
        logger.error("Guild non trouvée")
        return None

    # Vérifier les permissions du bot
    required_perms = ['manage_roles']
    has_perms, perm_message = await check_bot_permissions(guild, required_perms)
    if not has_perms:
        logger.error(f"Réinitialisation des rôles impossible: {perm_message}")
        return None

    # Récupérer tous les rôles shiny
    shiny_roles = []
    for role_key, role_id in ROLE_IDS.items():
        role = guild.get_role(role_id)
        if role:
            shiny_roles.append(role)
        else:
            logger.warning(f"Rôle {role_key} ({role_id}) introuvable")

    if not shiny_roles:
        logger.error("Aucun rôle shiny trouvé")
        return None

    # Récupérer tous les membres du serveur
    members_with_roles = []
    for member in guild.members:
        # Vérifier si le membre a au moins un rôle shiny
        member_shiny_roles = [role for role in shiny_roles if role in member.roles]
        if member_shiny_roles:
            members_with_roles.append((member, member_shiny_roles))

    logger.info(f"Réinitialisation des rôles pour {len(members_with_roles)} membres")

    # Traiter par batch pour éviter le rate limiting
    successful_removals = 0
    failed_removals = 0
    batch_size = ROLE_UPDATE_BATCH_SIZE

    for batch_start in range(0, len(members_with_roles), batch_size):
        batch_end = min(batch_start + batch_size, len(members_with_roles))
        batch = members_with_roles[batch_start:batch_end]

        # Traitement du batch
        for member, roles_to_remove in batch:
            result = await remove_roles_from_member(member, roles_to_remove)
            if result is None or isinstance(result, Exception):
                failed_removals += 1
            else:
                successful_removals += 1

            # Délai entre chaque membre
            await asyncio.sleep(0.8)

        # Délai entre les batches
        if batch_end < len(members_with_roles):
            await asyncio.sleep(BATCH_DELAY)
            logger.debug(f"Batch {batch_start//batch_size + 1} terminé")

    logger.info(f"Réinitialisation terminée: {successful_removals} succès, {failed_removals} échecs")
    return successful_removals, failed_removals

async def background_role_updater():
    """Tâche en arrière-plan pour la mise à jour des rôles avec gestion améliorée"""
    await bot.wait_until_ready()
    logger.info("Démarrage du système de mise à jour des rôles")

    # Attendre 30 secondes après le démarrage avant la première mise à jour (équilibré)
    await asyncio.sleep(30)

    while not bot.is_closed():
        try:
            await update_roles()
            # Attendre avant la prochaine mise à jour avec délai raisonnable
            await asyncio.sleep(ROLE_UPDATE_COOLDOWN + 30)  # Réduit de 60s à 30s supplémentaires

        except asyncio.CancelledError:
            logger.info("Tâche de mise à jour des rôles annulée")
            break
        except discord.RateLimited as e:
            logger.warning(f"Rate limited dans background_role_updater, attente de {e.retry_after}s")
            await asyncio.sleep(e.retry_after + 5)  # Marge réduite de 10s à 5s
        except Exception as e:
            logger.error(f"Erreur background_role_updater: {e}")
            # En cas d'erreur, attendre raisonnablement avant de réessayer
            await asyncio.sleep(180)  # Réduit de 300s à 180s (3 minutes)

# ============= NOUVEAU SYSTÈME DE CLASSEMENT AVEC EMBEDS MULTIPLES =============

# ════════════════════════════════════════════════════════════════
# ══  PROFIL RANKED INTERACTIF                                  ══
# ════════════════════════════════════════════════════════════════

def build_profile_embed(guild, user_id, ladder_list):
    """Construit l'embed de profil ranked pour un utilisateur."""
    member = guild.get_member(int(user_id))
    if not member:
        return None

    uid_str = str(user_id)

    # Position et stats dans le ladder
    rank_pos    = next((i + 1 for i, r in enumerate(ladder_list) if str(r[0]) == uid_str), None)
    total_pts   = next((r[1] for r in ladder_list if str(r[0]) == uid_str), 0)
    wanteds     = next((int(r[2]) for r in ladder_list if str(r[0]) == uid_str), 0)
    races       = next((int(r[3]) for r in ladder_list if str(r[0]) == uid_str), 0)

    def fmt_pts(pts):
        return f"{pts:.1f}" if pts % 1 != 0 else str(int(pts))

    # Label du rang actuel
    rank_limits_labels = [
        (8,  "💜 Shiny Master"),
        (14, "💎 Diamant"),
        (20, "💚 Émeraude"),
        (29, "🏆 Platine"),
        (39, "✨ Or"),
        (51, "🌠 Argent"),
    ]
    rank_label = "🌟 Novice"
    if rank_pos:
        for lim, lbl in rank_limits_labels:
            if rank_pos <= lim:
                rank_label = lbl
                break

    # Message d'écart vers le rang supérieur
    rank_limits  = [8, 14, 20, 29, 39, 51]
    rank_names   = ["💎 Rank Diamant", "💚 Rank Émeraude", "🏆 Rank Platine", "✨ Rank Or", "🌠 Rank Argent", "🌟 Rank Novice"]
    gap_line = ""
    if rank_pos:
        cur_idx = next((i for i, l in enumerate(rank_limits) if rank_pos <= l), len(rank_limits))
        if cur_idx == 0:
            if rank_pos > 1:
                gap = ladder_list[rank_pos - 2][1] - total_pts
                if gap > 0:
                    gap_line = f"📊 **{gap:.1f} pts** derrière **#{rank_pos - 1}**"
        else:
            upper_last = rank_limits[cur_idx - 1]
            if upper_last <= len(ladder_list):
                gap = ladder_list[upper_last - 1][1] - total_pts
                if gap > 0:
                    gap_line = f"📈 **{gap:.1f} pts** pour atteindre {rank_names[cur_idx - 1]}"
                else:
                    gap_line = f"✅ Éligible pour {rank_names[cur_idx - 1]} !"

    # Nombre total de shinys
    cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id=?", (uid_str,))
    shiny_count = cursor.fetchone()[0] or 0

    # Streak
    streak_data    = get_user_streak(uid_str)
    current_streak = streak_data.get('current_streak', 0)
    best_streak    = streak_data.get('best_streak', 0)

    # 5 derniers shinys
    cursor.execute("""
        SELECT pokemon, game, methode, date, points
        FROM shiny WHERE user_id=?
        ORDER BY created_at DESC, rowid DESC
        LIMIT 5
    """, (uid_str,))
    last_shinys = cursor.fetchall()

    # Couleur selon rang
    color_map = {
        "💜 Shiny Master": discord.Color.purple(),
        "💎 Diamant":      discord.Color.blue(),
        "💚 Émeraude":    discord.Color.from_rgb(0, 200, 80),
        "🏆 Platine":      discord.Color.from_rgb(0, 191, 255),
        "✨ Or":           discord.Color.gold(),
        "🌠 Argent":       discord.Color.light_grey(),
        "🌟 Novice":       discord.Color.from_rgb(139, 69, 19),
    }
    embed_color = color_map.get(rank_label, discord.Color.blurple())

    desc = f"**{rank_label}**"
    if rank_pos:
        desc += f"  ·  **#{rank_pos}** au classement"
    if gap_line:
        desc += f"\n{gap_line}"

    embed = discord.Embed(
        title=f"👤  {member.display_name}",
        description=desc,
        color=embed_color,
        timestamp=datetime.now()
    )
    embed.set_thumbnail(url=member.display_avatar.url)
    embed.add_field(name="⭐ Points",       value=f"**{fmt_pts(total_pts)}**",                              inline=True)
    embed.add_field(name="✨ Shinys",        value=f"**{shiny_count}**",                                     inline=True)
    embed.add_field(name="🏅 Position",     value=f"**#{rank_pos or '?'}**",                                inline=True)
    embed.add_field(name="🎯 Wanteds",      value=f"**{wanteds}**",                                         inline=True)
    embed.add_field(name="🏁 Races",        value=f"**{races}**",                                           inline=True)
    embed.add_field(name="🔥 Streak",       value=f"**{current_streak}** j (record : **{best_streak}**)",   inline=True)

    if last_shinys:
        # Récupérer les wanteds mystères actifs pour masquer les noms
        cursor.execute("SELECT pokemon_name FROM shiny_wanted WHERE is_active=1 AND indice IS NOT NULL AND indice != ''")
        mystery_wanteds = {row[0].lower() for row in cursor.fetchall()
                           if not (row[0] or '').startswith("[Méthode :")}
        shiny_lines = []
        for poke, game, methode, date, pts in last_shinys:
            pts_s  = fmt_pts(pts) if pts else "?"
            game_s = (game[:14] + "…") if game and len(game) > 14 else (game or "?")
            # Masquer le nom si c'est un wanted mystère encore actif
            display_poke = "???" if poke.lower() in mystery_wanteds else poke
            shiny_lines.append(f"• **{display_poke}** — {game_s} — {date} *(+{pts_s} pts)*")
        embed.add_field(
            name="🌟 5 derniers shinys",
            value="\n".join(shiny_lines),
            inline=False
        )

    # Badges
    badges = get_user_badges(user_id)
    if badges:
        badge_str = "  ".join(f"{b[1]} {b[2]}" for b in badges)
        if len(badge_str) > 1024:
            badge_str = badge_str[:1020] + "…"
        embed.add_field(name="🎖️ Badges", value=badge_str, inline=False)

    embed.set_footer(text="ShinyBot · Profil Ranked — visible uniquement par toi")
    return embed


class PodiumProfileView(discord.ui.View):
    """Bouton 'Voir le profil' sur un embed du podium (top 3)."""

    def __init__(self, user_id, ladder_list, guild):
        super().__init__(timeout=None)
        self.user_id     = user_id
        self.ladder_list = ladder_list
        self.guild       = guild

        btn = discord.ui.Button(
            label="👤 Voir le profil",
            style=discord.ButtonStyle.secondary,
            custom_id=f"podium_profile_{user_id}"
        )
        btn.callback = self._callback
        self.add_item(btn)

    async def _callback(self, interaction: discord.Interaction):
        try:
            await interaction.response.defer(ephemeral=True)
            # Récupérer le ladder à jour au moment du clic
            ladder_list = get_ladder()
            guild = bot.get_guild(GUILD_ID)
            embed = build_profile_embed(guild, self.user_id, ladder_list)
            if embed:
                await interaction.followup.send(embed=embed, ephemeral=True)
            else:
                await interaction.followup.send("Profil introuvable.", ephemeral=True)
        except Exception as e:
            logger.error(f"Erreur PodiumProfileView: {e}")
            try:
                await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
            except Exception:
                pass


class RankedGroupSelectView(discord.ui.View):
    """Select menu unique pour voir le profil de n'importe quel joueur d'un groupe de rang."""

    def __init__(self, players, ladder_list, guild):
        super().__init__(timeout=None)
        self.ladder_list = ladder_list
        self.guild       = guild

        # Discord limite à 25 options par Select
        options = []
        for member, total_pts, _, _, pos in players[:25]:
            shiny_c = self._get_shiny_count(member.id)
            pts_s = f"{total_pts:.1f}" if total_pts % 1 != 0 else str(int(total_pts))
            options.append(discord.SelectOption(
                label=f"#{pos} — {member.display_name}"[:100],
                value=str(member.id),
                description=f"{pts_s} pts · {shiny_c} shinys"[:100]
            ))


        select = discord.ui.Select(
            placeholder="👤 Voir le profil d'un membre…",
            options=options,
            min_values=1,
            max_values=1,
            custom_id="ranked_profile_select"
        )
        select.callback = self._on_select
        self.add_item(select)

    def _get_shiny_count(self, user_id):
        cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id=?", (str(user_id),))
        return cursor.fetchone()[0] or 0

    async def _on_select(self, interaction: discord.Interaction):
        try:
            await interaction.response.defer(ephemeral=True)
            user_id = interaction.data["values"][0]
            # Récupérer le ladder à jour au moment du clic
            ladder_list = get_ladder()
            guild = bot.get_guild(GUILD_ID)
            embed = build_profile_embed(guild, user_id, ladder_list)
            if embed:
                await interaction.followup.send(embed=embed, ephemeral=True)
            else:
                await interaction.followup.send("Profil introuvable.", ephemeral=True)
        except Exception as e:
            logger.error(f"Erreur RankedGroupSelectView: {e}")
            try:
                await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
            except Exception:
                pass


async def update_classement_message():
    """Système de classement avec embeds multiples amélioré avec gestion d'erreurs avancée"""
    global last_classement_update
    
    # Vérifier le cooldown
    current_time = datetime.now()
    if last_classement_update and (current_time - last_classement_update).total_seconds() < CLASSEMENT_UPDATE_COOLDOWN:
        logger.info("Rate limite classement : mise à jour ignorée (cooldown)")
        return
    
    # Acquérir le verrou pour éviter les exécutions simultanées
    async with classement_update_lock:
        
        async def _update_message(**kwargs):
            guild = bot.get_guild(GUILD_ID)
            classement_channel = bot.get_channel(SALON_CLASSEMENT_ID)
            if not guild or not classement_channel:
                logger.error("Guild ou salon classement introuvable.")
                return None

            ladder_list = get_ladder()

            # Supprimer TOUS les messages du salon (100 derniers) - ÉQUILIBRÉ POUR L'EXPÉRIENCE
            try:
                messages_to_delete = []
                async for msg in classement_channel.history(limit=100):
                    messages_to_delete.append(msg)

                # Supprimer par batch de 8 messages max avec délais équilibrés
                for i in range(0, len(messages_to_delete), 8):  # Augmenté de 5 à 8 messages par batch
                    batch = messages_to_delete[i:i+8]
                    for msg in batch:
                        try:
                            await msg.delete()
                            await asyncio.sleep(0.5)  # Réduit de 1.0s à 0.5s
                        except discord.NotFound:
                            pass  # Message déjà supprimé
                        except discord.HTTPException as e:
                            logger.warning(f"Erreur suppression message: {e}")
                            await asyncio.sleep(2)  # Réduit de 5s à 2s
                    # Délai raisonnable entre les batches
                    if i + 8 < len(messages_to_delete):
                        await asyncio.sleep(1.5)  # Réduit de 3s à 1.5s
            except Exception as e:
                logger.warning(f"Erreur suppression messages dans le salon classement : {e}")

            podium_colors = [discord.Color.gold(), discord.Color.light_grey(), discord.Color.from_rgb(205, 127, 50)]
            podium_emojis = ["🥇", "🥈", "🥉"]
            podium_roles = ["Shiny Hunter #1", "Shiny Hunter #2", "Shiny Hunter #3"]

            # 1. Embed général d'en-tête
            intro_embed = discord.Embed(
                title="🏆 Classement Ranked Shiny Hunting 🏆",
                description=(
                    "Voici le classement des meilleurs shiny hunters !\n"
                    "────────────────────────────\n"
                    "**RANKED SHINY HUNTING - SAISON 4**\n"
                    "📅 **Fin de saison : 21 Mai 2026**\n\n"
                    f"🎯 **{len(ladder_list)} Shasseurs actifs**\n"
                    f"⚡ **Dernière mise à jour:** <t:{int(datetime.now().timestamp())}:R>"
                ),
                color=discord.Color.gold(),
                timestamp=datetime.now()
            )
            
            # Ajouter l'icône de la guilde si disponible
            if guild.icon:
                intro_embed.set_author(
                    name="ShinyBot Ranking System", 
                    icon_url=guild.icon.url
                )
            
            intro_embed.set_footer(
                text="ShinyBot • Système de classement automatique",
                icon_url=guild.me.display_avatar.url if guild.me else None
            )
            
            await classement_channel.send(embed=intro_embed)
            await asyncio.sleep(1.0)  # Délai équilibré pour l'expérience utilisateur

            # 2. Top 3 avec médailles, avatars et rôles
            for position in range(min(3, len(ladder_list))):
                user_id, total_points, wanted_count, race_wins = ladder_list[position]
                member = guild.get_member(int(user_id))
                if member:
                    points_str = f"{total_points:.1f}" if total_points % 1 != 0 else f"{int(total_points)}"
                    
                    embed = discord.Embed(
                        title=f"{podium_emojis[position]} {member.display_name}",
                        description=f"**{podium_roles[position]}**\n*{['Le maître absolu de la Shasse aux shiny !', 'Un Shasseur d\'exception !', 'Sur le podium des légendes !'][position]}*",
                        color=podium_colors[position],
                        timestamp=datetime.now()
                    )
                    embed.set_thumbnail(url=member.display_avatar.url)
                    
                    # Informations détaillées
                    embed.add_field(name="⭐ Points totaux", value=f"**{points_str}**", inline=True)
                    embed.add_field(name="🏅 Position", value=f"**#{position+1}**", inline=True)
                    embed.add_field(name="🎯 Wanteds trouvés", value=f"**{int(wanted_count)}**", inline=True)
                    embed.add_field(name="🏁 Races gagnées", value=f"**{int(race_wins)}**", inline=True)
                    
                    embed.set_footer(text=f"ShinyBot • Champion niveau {position+1}")
                    
                    await classement_channel.send(embed=embed, view=PodiumProfileView(user_id, ladder_list, guild))
                    await asyncio.sleep(1.0)  # Délai équilibré pour l'expérience utilisateur

            # 3. Classement par rôles avec préfixe "Rank"
            if len(ladder_list) > 3:
                role_groups = {
                    "💜 Rank Shiny Master":       (8,   discord.Color.purple()),
                    "💎 Rank Shiny de Diamant":   (14,  discord.Color.blue()),
                    "💚 Rank Shiny d'Émeraude":  (20,  discord.Color.from_rgb(0, 200, 80)),
                    "🏆 Rank Shiny de Platine":   (29,  discord.Color.from_rgb(0, 191, 255)),
                    "✨ Rank Shiny d'Or":         (39,  discord.Color.gold()),
                    "🌠 Rank Shiny d'Argent":    (51,  discord.Color.light_grey()),
                    "🌟 Rank Shiny Novice":        (999, discord.Color.from_rgb(139, 69, 19))
                }

                current_position = 4
                for role_name, (max_pos, color) in role_groups.items():
                    players = []
                    while current_position <= len(ladder_list) and current_position <= max_pos:
                        user_id, total_points, wanted_count, race_wins = ladder_list[current_position-1]
                        member = guild.get_member(int(user_id))
                        if member:
                            players.append((member, total_points, wanted_count, race_wins, current_position))
                        current_position += 1

                    if players:
                        # Discord limite à 25 fields par embed, donc on découpe en pages
                        for i in range(0, len(players), 25):
                            batch_players = players[i:i+25]
                            embed = discord.Embed(
                                title=role_name,
                                description=f"*{len(players)} Shasseur{'s' if len(players) > 1 else ''} dans cette catégorie*",
                                color=color,
                                timestamp=datetime.now()
                            )
                            
                            for member, total_points, wanted_count, race_wins, position in batch_players:
                                points_str = f"{total_points:.1f}" if total_points % 1 != 0 else f"{int(total_points)}"
                                value = f"**Points** : {points_str} ⭐ | **Wanteds** : {int(wanted_count)} 🎯 | **Races** : {int(race_wins)} 🏁"
                                
                                embed.add_field(
                                    name=f"#{position} - {member.display_name}",
                                    value=value,
                                    inline=False
                                )
                            
                            embed.set_footer(text=f"ShinyBot • {role_name.split(' ', 1)[1]}")
                            view = RankedGroupSelectView(batch_players, ladder_list, guild)
                            await classement_channel.send(embed=embed, view=view)
                            await asyncio.sleep(1.0)  # Délai équilibré pour l'expérience utilisateur

            logger.info("✅ Classement avec embeds multiples mis à jour avec succès")
            return True
        
        result = await discord_retry_wrapper(
            _update_message,
            context="Multi-Embed Classement Update",
            required_permissions=['send_messages', 'manage_messages']
        )
        
        if result:
            last_classement_update = current_time

@bot.event
async def on_error(event, *args, **kwargs):
    """Gestionnaire d'erreurs global pour capturer les rate limits et interactions expirées"""
    import sys
    import traceback

    exc_type, exc_value, exc_traceback = sys.exc_info()

    if isinstance(exc_value, discord.RateLimited):
        logger.warning(f"⏳ Rate limited sur {event} - Attente de {exc_value.retry_after}s")
        await asyncio.sleep(exc_value.retry_after + 2)
    elif isinstance(exc_value, discord.NotFound) and "Unknown interaction" in str(exc_value):
        logger.warning(f"⚠️ Interaction expirée sur {event} - Ignorée")
        # Ne pas logger l'erreur complète pour les interactions expirées
    else:
        logger.error(f"Erreur dans {event}:")
        traceback.print_exception(exc_type, exc_value, exc_traceback)



@bot.event
async def on_interaction(interaction: discord.Interaction):
    """Intercepte tous les clics de boutons/selects du classement ranked."""
    if interaction.type != discord.InteractionType.component:
        return  # Laisser discord.py gérer les slash commands normalement

    custom_id = interaction.data.get("custom_id", "")
    component_type = interaction.data.get("component_type", 0)

    # ── Bouton profil podium : custom_id = "podium_profile_{user_id}" ──────
    if custom_id.startswith("podium_profile_"):
        uid = custom_id[len("podium_profile_"):]
        try:
            await interaction.response.defer(ephemeral=True)
            ladder_list = get_ladder()
            guild = bot.get_guild(GUILD_ID)
            embed = build_profile_embed(guild, uid, ladder_list)
            if embed:
                await interaction.followup.send(embed=embed, ephemeral=True)
            else:
                await interaction.followup.send("Profil introuvable.", ephemeral=True)
        except Exception as e:
            logger.error(f"Erreur on_interaction podium_profile: {e}")
            try:
                await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
            except Exception:
                pass
        return  # On a géré, on arrête

    # ── Select menu ranked group ──────────────────────────────────────────────
    if custom_id == "ranked_profile_select":
        values = interaction.data.get("values", [])
        if values:
            uid = values[0]
            try:
                await interaction.response.defer(ephemeral=True)
                ladder_list = get_ladder()
                guild = bot.get_guild(GUILD_ID)
                embed = build_profile_embed(guild, uid, ladder_list)
                if embed:
                    await interaction.followup.send(embed=embed, ephemeral=True)
                else:
                    await interaction.followup.send("Profil introuvable.", ephemeral=True)
            except Exception as e:
                logger.error(f"Erreur on_interaction ranked_select: {e}")
                try:
                    await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
                except Exception:
                    pass
        return

    # Pour tout le reste, laisser discord.py traiter normalement (boutons de pagination etc.)


@bot.tree.error
async def on_app_command_error(interaction: discord.Interaction, error: app_commands.AppCommandError):
    if isinstance(error, app_commands.CommandNotFound):
        await interaction.response.send_message("Cette commande n'existe plus. Utilisez /classement a la place.", ephemeral=True)
        return
    logger.error(f"Command error: {error}")
    try:
        if not interaction.response.is_done():
            await interaction.response.send_message("Une erreur est survenue.", ephemeral=True)
    except:
        pass

# ════════════════════════════════════════════════════════════════
# ══  CLASSEMENT CHALLENGE AUTOMATIQUE (toutes les 2h)         ══
# ════════════════════════════════════════════════════════════════

SALON_CHALLENGE_STATUS_ID = 1497006919468974151
CHALLENGE_STATUS_UPDATE_INTERVAL = 7200  # 2 heures en secondes

def build_challenge_status_embed(guild):
    """Construit l'embed de classement du challenge type actif (monthly_type_challenge)."""
    challenge = get_active_monthly_type_challenge()

    if not challenge:
        embed = discord.Embed(
            title="🏅 Challenge Type — Classement",
            description="*Aucun challenge type actif pour le moment.*\nRestez à l'affût, le prochain arrive bientôt !",
            color=discord.Color.greyple(),
            timestamp=datetime.now()
        )
        embed.set_footer(text="ShinyBot · Challenge Type • Mise à jour auto toutes les 2h")
        return embed

    challenge_id = challenge[0]
    info, scores = get_type_challenge_leaderboard(challenge_id)
    if not info:
        embed = discord.Embed(
            title="🏅 Challenge Type — Classement",
            description="⚠️ Impossible de charger le classement.",
            color=discord.Color.red(),
            timestamp=datetime.now()
        )
        embed.set_footer(text="ShinyBot · Challenge Type • Mise à jour auto toutes les 2h")
        return embed

    month, year, shiny_type, top_n = info[0], info[1], info[2], info[3]
    bonus_top1, bonus_top2, bonus_top3, bonus_other = float(info[5]), float(info[6]), float(info[7]), float(info[8])
    challenge_desc, ends_at = info[9], info[10]

    embed = discord.Embed(
        title=f"🏅 Challenge Type — Classement en direct",
        description=(
            f"🔷 Type suivi : **{shiny_type}**  |  Période : **{month:02d}/{year}**\n"
            f"🏆 Récompense : **Top {top_n}**"
        ),
        color=discord.Color.blue(),
        timestamp=datetime.now()
    )

    if challenge_desc:
        embed.add_field(name="📝 Description", value=challenge_desc, inline=False)

    embed.add_field(
        name="🎁 Bonus par rang",
        value=(
            f"🥇 Top 1 : **+{bonus_top1:.2f} pts**  |  "
            f"🥈 Top 2 : **+{bonus_top2:.2f} pts**  |  "
            f"🥉 Top 3 : **+{bonus_top3:.2f} pts**  |  "
            f"🏅 Top 4+ : **+{bonus_other:.2f} pts**"
        ),
        inline=False
    )

    if ends_at:
        try:
            ts = int(datetime.strptime(ends_at, "%Y-%m-%d %H:%M").timestamp())
            embed.add_field(name="⏰ Fin du challenge", value=f"<t:{ts}:F>  (<t:{ts}:R>)", inline=False)
        except Exception:
            embed.add_field(name="⏰ Fin du challenge", value=ends_at, inline=False)

    medals = {1: "🥇", 2: "🥈", 3: "🥉"}
    if not scores:
        embed.add_field(
            name="📊 Classement",
            value="*Aucun shiny de ce type comptabilisé pour l'instant.\nSoyez le premier !*",
            inline=False
        )
    else:
        lines = []
        for position, (user_id, total_shinys) in enumerate(scores, start=1):
            member = guild.get_member(int(user_id)) if guild else None
            name = member.display_name if member else f"<@{user_id}>"
            medal = medals.get(position, "🏅" if position <= top_n else "▫️")
            reward = get_rank_bonus(position, bonus_top1, bonus_top2, bonus_top3, bonus_other)
            reward_txt = f" (+{reward:.2f} pts)" if position <= top_n and reward > 0 else ""
            lines.append(f"{medal} **#{position}** — **{name}** — {total_shinys} shiny{'s' if total_shinys > 1 else ''}{reward_txt}")

        # Découper si trop long pour un seul champ Discord (limite 1024 car.)
        chunk, chunks = [], []
        for line in lines:
            if sum(len(l) + 1 for l in chunk) + len(line) > 1000:
                chunks.append("\n".join(chunk))
                chunk = []
            chunk.append(line)
        if chunk:
            chunks.append("\n".join(chunk))

        for i, text in enumerate(chunks):
            title = "📊 Classement" if i == 0 else "📊 Classement (suite)"
            embed.add_field(name=title, value=text, inline=False)

    embed.set_footer(text="ShinyBot · Challenge Type • Mise à jour auto toutes les 2h")
    return embed
    """Édite (ou crée) le message de statut du challenge dans le salon dédié."""
    guild = bot.get_guild(GUILD_ID)
    channel = bot.get_channel(SALON_CHALLENGE_STATUS_ID)
    if not channel or not guild:
        logger.warning("Salon challenge status introuvable.")
        return

    embed = build_challenge_status_embed(guild)

    # Chercher un message existant du bot dans le salon (dans les 20 derniers)
    existing_msg = None
    try:
        async for msg in channel.history(limit=20):
            if msg.author.id == bot.user.id:
                existing_msg = msg
                break
    except Exception as e:
        logger.warning(f"Erreur lecture historique challenge status: {e}")

    try:
        if existing_msg:
            await existing_msg.edit(embed=embed)
            logger.info("Message challenge status mis à jour.")
        else:
            await channel.send(embed=embed)
            logger.info("Message challenge status créé.")
    except discord.HTTPException as e:
        logger.error(f"Erreur envoi/edit challenge status: {e}")


async def auto_challenge_status_updater():
    """Tâche de fond : met à jour le classement challenge toutes les 2h."""
    await bot.wait_until_ready()
    # Petite attente initiale pour laisser le bot se stabiliser
    await asyncio.sleep(60)
    while not bot.is_closed():
        try:
            await update_challenge_status_message()
        except Exception as e:
            logger.error(f"Erreur auto_challenge_status_updater: {e}")
        await asyncio.sleep(CHALLENGE_STATUS_UPDATE_INTERVAL)


@bot.event
async def on_ready():
    logger.info(f"Connecté en tant que {bot.user} (ID: {bot.user.id})")
    logger.info("------")

    # Vérifier immédiatement la validité du token
    if not await check_bot_token_validity():
        logger.error("❌ Token invalide détecté au démarrage !")
        return

    # Attendre que Discord soit prêt (délai équilibré)
    await asyncio.sleep(10)  # Réduit de 20s à 10s pour une meilleure expérience
    
    guild = discord.Object(id=GUILD_ID)
    
    # Synchronisation avec le nouveau système de retry
    async def _sync_commands(**kwargs):
        synced = await bot.tree.sync(guild=guild)
        # Global sync to clear old commands like /ladder
        try:
            await bot.tree.sync()
            logger.info("Global sync done")
        except Exception as e:
            logger.warning(f"Global sync failed: {e}")
        logger.info(f"✅ Synchronisation réussie - {len(synced)} commandes")
        return synced
    
    result = await discord_retry_wrapper(
        _sync_commands,
        context="Command Sync"
    )
    
    if result is None:
        logger.error("❌ Échec de la synchronisation des commandes")
    
    # Démarrer la tâche de mise à jour des rôles
    bot.loop.create_task(background_role_updater())
    
    # Démarrer le tirage automatique des objectifs hebdomadaires
    bot.loop.create_task(auto_weekly_draw())
    bot.loop.create_task(auto_assign_weekly_choices())
    bot.loop.create_task(auto_scheduled_wanteds())

    # Démarrer le tirage automatique des objectifs mensuels
    bot.loop.create_task(auto_monthly_draw())

    # Démarrer la mise à jour automatique du classement challenge (toutes les 2h)
    bot.loop.create_task(auto_challenge_status_updater())
    
    # Nettoyer les images orphelines au démarrage
    cleanup_old_images()
    
    # Vérifier que les commandes sont bien enregistrées
    logger.info("Commandes enregistrées:")
    for cmd in bot.tree.get_commands(guild=guild):
        logger.info(f"- {cmd.name}")

# Vue pour la pagination des shinys personnels
class MesShinyView(discord.ui.View):
    def __init__(self, user_id, user, current_page=1):
        super().__init__(timeout=300)
        self.user_id = user_id
        self.user = user
        self.current_page = current_page
        self.per_page = 5
        self._interaction_cooldown = {}
        
    async def _check_cooldown(self, interaction, cooldown_time=2):
        """Vérifie le cooldown pour éviter le spam"""
        user_id = interaction.user.id
        current_time = time.time()
        
        if user_id in self._interaction_cooldown:
            if current_time - self._interaction_cooldown[user_id] < cooldown_time:
                await interaction.response.send_message("⏱️ Veuillez patienter avant d'utiliser à nouveau cette fonction.", ephemeral=True)
                return False
        
        self._interaction_cooldown[user_id] = current_time
        return True
        
    async def update_embed(self, interaction):
        """Met à jour l'embed avec la page actuelle"""
        shinys, total_shinys, total_pages = get_user_shinys(self.user_id, self.current_page, self.per_page)
        stats = get_user_stats(self.user_id)
        rank, total_points = get_user_rank(self.user_id)
        
        # Couleur basée sur le rang
        if rank == 1:
            color = discord.Color.gold()
        elif rank == 2:
            color = discord.Color.light_grey()
        elif rank == 3:
            color = discord.Color.from_rgb(205, 127, 50)
        elif rank and rank <= 8:
            color = discord.Color.purple()
        elif rank and rank <= 14:
            color = discord.Color.blue()
        else:
            color = discord.Color.green()
        
        embed = discord.Embed(
            title=f"✨ Collection Shiny de {self.user.display_name}",
            color=color,
            timestamp=datetime.now()
        )
        embed.set_author(name=self.user.display_name, icon_url=self.user.display_avatar.url)
        embed.set_thumbnail(url=self.user.display_avatar.url)
        
        # Statistiques générales
        rank_title = get_rank_title(rank) if rank else "🌟 Non classé"
        points_display = f"{total_points:.1f}" if total_points % 1 != 0 else f"{int(total_points)}"
        avg_points_display = f"{stats['avg_points']:.1f}" if stats['avg_points'] and stats['avg_points'] % 1 != 0 else f"{int(stats['avg_points']) if stats['avg_points'] else 0}"
        
        embed.add_field(
            name="📊 Statistiques Générales",
            value=f"**Rang:** #{rank if rank else 'N/A'} - {rank_title}\n"
                  f"**Points totaux:** {points_display} ⭐\n"
                  f"**Total Shinys:** {stats['total_shinys']}\n"
                  f"**Moyenne par Shiny:** {avg_points_display} pts",
            inline=False
        )
        
        # Compteurs par période
        embed.add_field(
            name="📅 Compteurs",
            value=f"**Aujourd'hui:** {stats['today_count']} shiny{'s' if stats['today_count'] > 1 else ''}\n"
                  f"**Cette semaine:** {stats['week_count']} shiny{'s' if stats['week_count'] > 1 else ''}\n"
                  f"**Ce mois:** {stats['month_count']} shiny{'s' if stats['month_count'] > 1 else ''}",
            inline=True
        )
        
        # Streaks
        streak_emoji = "🔥" if stats['current_streak'] > 0 else "💤"
        streak_text = f"{streak_emoji} **Streak actuel:** {stats['current_streak']} jour{'s' if stats['current_streak'] > 1 else ''}\n"
        streak_text += f"🏆 **Meilleur streak:** {stats['best_streak']} jour{'s' if stats['best_streak'] > 1 else ''}\n"
        streak_text += f"📆 **Jours avec shiny:** {stats['total_days_with_shiny']}"
        
        embed.add_field(
            name="⚡ Streaks & Activité",
            value=streak_text,
            inline=True
        )
        
        # Informations supplémentaires
        if stats['favorite_pokemon'] != "Aucun":
            embed.add_field(
                name="🎯 Préférences",
                value=f"**Pokémon favori:** {stats['favorite_pokemon']}\n"
                      f"**Meilleur Shiny:** {stats['best_shiny']} pts",
                inline=False
            )
        
        # Liste des shinys pour cette page
        if shinys:
            shiny_list = ""
            for i, shiny in enumerate(shinys):
                # shiny = (rowid, pokemon, game, methode, odds, date, points, created_at, language)
                rowid, pokemon, game, method_key, odds, date, points, created_at, language = shiny
                
                # Obtenir le nom de la méthode dans la langue appropriée
                method_display = method_key  # Fallback
                for game_key, game_translations in GAMES.items():
                    if (game_translations.get("fr") == game or 
                        game_translations.get("en") == game):
                        if game_key in METHODS_BY_GAME and method_key in METHODS_BY_GAME[game_key]:
                            lang_code = language if language in ["fr", "en"] else "fr"
                            method_display = METHODS_BY_GAME[game_key][method_key][lang_code]
                        break
                
                emoji = get_method_emoji(method_display)
                points_display = f"{points:.1f}" if points % 1 != 0 else f"{int(points)}"
                
                index = (self.current_page - 1) * self.per_page + i + 1
                shiny_list += f"**{index}.** {emoji} **{pokemon}** - {game}\n"
                shiny_list += f"     {method_display} • {points_display} pts • `{date}`\n\n"
            
            embed.add_field(
                name=f"📝 Liste des Shinys (Page {self.current_page}/{total_pages})",
                value=shiny_list,
                inline=False
            )
        else:
            embed.add_field(
                name="📝 Liste des Shinys",
                value="*Aucun shiny enregistré pour le moment*",
                inline=False
            )
        
        # Footer avec informations de pagination
        if total_pages > 1:
            embed.set_footer(text=f"Page {self.current_page}/{total_pages} • {total_shinys} shinys au total • ShinyBot")
        else:
            embed.set_footer(text=f"{total_shinys} shinys au total • ShinyBot")
        
        return embed
    
    async def _safe_interaction_response(self, interaction, embed, error_context):
        """Gestion sécurisée des réponses d'interaction"""
        async def _respond(**kwargs):
            await interaction.response.edit_message(embed=embed, view=self)
        
        result = await discord_retry_wrapper(
            _respond,
            context=error_context
        )
        
        if result is None:
            try:
                await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
            except:
                pass
    
    @discord.ui.button(label="⬅️ Précédent", style=discord.ButtonStyle.secondary)
    async def previous_page(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id != int(self.user_id):
            await interaction.response.send_message("❌ Vous ne pouvez pas naviguer dans la collection d'un autre utilisateur !", ephemeral=True)
            return
        
        if not await self._check_cooldown(interaction):
            return
            
        _, _, total_pages = get_user_shinys(self.user_id, 1, self.per_page)
        
        if self.current_page > 1:
            self.current_page -= 1
        else:
            self.current_page = total_pages  # Boucle vers la dernière page
        
        embed = await self.update_embed(interaction)
        await self._safe_interaction_response(interaction, embed, "Previous Page")
    
    @discord.ui.button(label="🔄 Actualiser", style=discord.ButtonStyle.primary)
    async def refresh(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id != int(self.user_id):
            await interaction.response.send_message("❌ Vous ne pouvez pas actualiser la collection d'un autre utilisateur !", ephemeral=True)
            return
        
        if not await self._check_cooldown(interaction):
            return
            
        embed = await self.update_embed(interaction)
        await self._safe_interaction_response(interaction, embed, "Refresh")
    
    @discord.ui.button(label="Suivant ➡️", style=discord.ButtonStyle.secondary)
    async def next_page(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id != int(self.user_id):
            await interaction.response.send_message("❌ Vous ne pouvez pas naviguer dans la collection d'un autre utilisateur !", ephemeral=True)
            return
        
        if not await self._check_cooldown(interaction):
            return
            
        _, _, total_pages = get_user_shinys(self.user_id, 1, self.per_page)
        
        if self.current_page < total_pages:
            self.current_page += 1
        else:
            self.current_page = 1  # Boucle vers la première page
        
        embed = await self.update_embed(interaction)
        await self._safe_interaction_response(interaction, embed, "Next Page")
    
    async def on_timeout(self):
        """Désactive tous les boutons quand la vue expire"""
        for item in self.children:
            if isinstance(item, discord.ui.Button):
                item.disabled = True

# Vue corrigée pour la sélection de langue et jeu - VERSION SIMPLIFIÉE
class MultiShinyFollowUpView(discord.ui.View):
    """Vue affichée après chaque ajout de shiny — permet d'en ajouter un autre (max 5)"""
    def __init__(self, language, hunt_type, shiny_count=1):
        super().__init__(timeout=300)
        self.language = language
        self.hunt_type = hunt_type
        self.shiny_count = shiny_count

        if shiny_count >= 5:
            # Maximum atteint, on n'affiche que le bouton Terminer
            btn_done = discord.ui.Button(
                label="✅ Terminé (maximum 5 shinys atteint)" if language == "Français" else "✅ Done (max 5 shinies reached)",
                style=discord.ButtonStyle.success,
                disabled=True
            )
            self.add_item(btn_done)
        else:
            remaining = 5 - shiny_count
            btn_add = discord.ui.Button(
                label=f"✨ Ajouter un autre shiny ({remaining} restant{'s' if remaining > 1 else ''})" if language == "Français"
                      else f"✨ Add another shiny ({remaining} left)",
                style=discord.ButtonStyle.primary,
                custom_id="multi_add_another"
            )
            btn_add.callback = self.add_another
            self.add_item(btn_add)

            btn_done = discord.ui.Button(
                label="✅ Terminer" if language == "Français" else "✅ Done",
                style=discord.ButtonStyle.secondary,
                custom_id="multi_done"
            )
            btn_done.callback = self.finish
            self.add_item(btn_done)

    async def add_another(self, interaction: discord.Interaction):
        """Relance le flow de sélection de jeu (la langue et le type de chasse sont déjà connus)"""
        # Désactiver les boutons pour éviter le double-clic
        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(view=self)

        embed = discord.Embed(
            title=f"✨ Ajout de Shiny ({self.shiny_count + 1}/5)" if self.language == "Français"
                  else f"✨ Add Shiny ({self.shiny_count + 1}/5)",
            description="Choisissez le jeu :" if self.language == "Français" else "Choose the game:",
            color=discord.Color.blue()
        )
        # On repart directement sur GameSelectView — langue et type de chasse déjà connus
        game_view = GameSelectView(self.language, self.hunt_type, shiny_count=self.shiny_count + 1)
        await interaction.followup.send(embed=embed, view=game_view, ephemeral=True)

    async def finish(self, interaction: discord.Interaction):
        for item in self.children:
            item.disabled = True
        label = f"✅ Session terminée — {self.shiny_count} shiny{'s' if self.shiny_count > 1 else ''} ajouté{'s' if self.shiny_count > 1 else ''} !"
        if self.language != "Français":
            label = f"✅ Session ended — {self.shiny_count} {'shinies' if self.shiny_count > 1 else 'shiny'} added!"
        await interaction.response.edit_message(
            content=label,
            view=None
        )


class ShinyAddView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=300)
        self.step = "language"  # "language", "game", "method"
        self.language = None
        self.game = None
        self.method_key = None
        
    @discord.ui.select(
        placeholder="Choisissez votre langue / Choose your language",
        options=[
            discord.SelectOption(label="Français", value="Français", emoji="🇫🇷"),
            discord.SelectOption(label="English", value="English", emoji="🇬🇧")
        ]
    )
    async def language_select(self, interaction: discord.Interaction, select: discord.ui.Select):
        async def _respond(**kwargs):
            self.language = select.values[0]
            self.step = "hunt_type"

            # Mise à jour de la vue pour la sélection du type
            embed = discord.Embed(
                title="✨ Ajout de Shiny" if self.language == "Français" else "✨ Add Shiny",
                description=f"**Langue / Language:** {self.language}\n\n{'Choisissez le type de chasse :' if self.language == 'Français' else 'Choose the hunt type:'}",
                color=discord.Color.green()
            )

            # Créer nouvelle vue pour le type
            new_view = HuntTypeSelectView(self.language, shiny_count=1)
            await interaction.response.edit_message(embed=embed, view=new_view)

        await discord_retry_wrapper(_respond, context="Language Select")

class GameSelectView(discord.ui.View):
    def __init__(self, language, hunt_type="emulators", shiny_count=1):
        super().__init__(timeout=300)
        self.language = language
        self.hunt_type = hunt_type
        self.shiny_count = shiny_count
        
        # Créer les options de jeux
        game_options = []
        for game_key, translations in GAMES.items():
            name = translations["fr"] if language == "Français" else translations["en"]
            game_options.append(discord.SelectOption(label=name, value=game_key))
        
        # Diviser en plusieurs selects si trop d'options (max 25 par select)
        if len(game_options) <= 25:
            select = discord.ui.Select(
                placeholder="Choisissez le jeu" if language == "Français" else "Choose the game",
                options=game_options
            )
            select.callback = self.game_callback
            self.add_item(select)
        else:
            # Diviser les options en plusieurs groupes
            for i in range(0, len(game_options), 25):
                batch = game_options[i:i+25]
                select = discord.ui.Select(
                    placeholder=f"Jeux {i//25 + 1}" if language == "Français" else f"Games {i//25 + 1}",
                    options=batch
                )
                select.callback = self.game_callback
                self.add_item(select)
    
    async def game_callback(self, interaction):
        async def _respond(**kwargs):
            game_key = interaction.data['values'][0]
            
            embed = discord.Embed(
                title="✨ Ajout de Shiny" if self.language == "Français" else "✨ Add Shiny",
                description=f"**Jeu sélectionné / Selected game:** {GAMES[game_key]['fr' if self.language == 'Français' else 'en']}\n\n{'Choisissez maintenant la méthode utilisée :' if self.language == 'Français' else 'Now choose the method used:'}",
                color=discord.Color.blue()
            )
            
            # Créer nouvelle vue pour la méthode
            new_view = MethodSelectView(self.language, game_key, self.hunt_type, shiny_count=self.shiny_count)
            await interaction.response.edit_message(embed=embed, view=new_view)

        await discord_retry_wrapper(_respond, context="Game Select")

class MethodSelectView(discord.ui.View):
    def __init__(self, language, game_key, hunt_type="emulators", shiny_count=1):
        super().__init__(timeout=300)
        self.language = language
        self.game_key = game_key
        self.hunt_type = hunt_type
        self.shiny_count = shiny_count
        
        # Créer les options de méthodes
        lang_code = "fr" if language == "Français" else "en"
        method_options = []
        
        for method_key, method_data in METHODS_BY_GAME[game_key].items():
            method_name = method_data[lang_code]
            points = method_data["points"]
            label = f"{method_name} ({points} pts)"
            # Utiliser la description pour les notes si disponible
            description = None
            if "note_fr" in method_data or "note_en" in method_data:
                note_key = "note_fr" if lang_code == "fr" else "note_en"
                if note_key in method_data:
                    description = method_data[note_key]
            method_options.append(discord.SelectOption(
                label=label[:100],  # Limite Discord: 100 caractères
                value=method_key,
                description=description[:100] if description else None  # Limite Discord: 100 caractères
            ))
        
        select = discord.ui.Select(
            placeholder="Choisissez la méthode" if language == "Français" else "Choose the method",
            options=method_options
        )
        select.callback = self.method_callback
        self.add_item(select)
    
    async def method_callback(self, interaction):
        async def _respond(**kwargs):
            method_key = interaction.data['values'][0]
            # Passer par le sélecteur de type avant le modal
            view = TypeSelectView(self.language, self.game_key, method_key, self.hunt_type, self.shiny_count)
            skip_label = "Ignorer le type / Skip type" if self.language != "Français" else "Ignorer le type (optionnel)"
            embed = discord.Embed(
                title="🔷 Type du Pokémon (optionnel / optional)",
                description=(
                    "Sélectionnez le **type** de votre shiny ou ignorez cette étape.\n"
                    "Select the **type** of your shiny or skip this step."
                ),
                color=discord.Color.blue()
            )
            await interaction.response.edit_message(embed=embed, view=view)

        await discord_retry_wrapper(_respond, context="Method Select")

class TypeSelectView(discord.ui.View):
    """Étape optionnelle : sélection du type Pokémon avant le modal."""
    def __init__(self, language, game_key, method_key, hunt_type, shiny_count=1):
        super().__init__(timeout=300)
        self.language   = language
        self.game_key   = game_key
        self.method_key = method_key
        self.hunt_type  = hunt_type
        self.shiny_count = shiny_count

        options = [
            discord.SelectOption(
                label=f"{fr} / {en}",
                value=fr
            )
            for fr, en in POKEMON_TYPES
        ]
        sel = discord.ui.Select(
            placeholder="🔷 Choisir le type / Choose type",
            options=options,
            min_values=1, max_values=1
        )
        sel.callback = self.type_selected
        self.add_item(sel)

        btn_skip = discord.ui.Button(
            label="⏭️ Ignorer / Skip",
            style=discord.ButtonStyle.secondary
        )
        btn_skip.callback = self.skip_type
        self.add_item(btn_skip)

    async def type_selected(self, interaction: discord.Interaction):
        type_val = interaction.data['values'][0]
        add_shiny._pending_type = type_val
        modal = ShinyModal(self.language, self.game_key, self.method_key, self.hunt_type)
        modal._shiny_count = self.shiny_count
        await interaction.response.send_modal(modal)

    async def skip_type(self, interaction: discord.Interaction):
        add_shiny._pending_type = None
        modal = ShinyModal(self.language, self.game_key, self.method_key, self.hunt_type)
        modal._shiny_count = self.shiny_count
        await interaction.response.send_modal(modal)


