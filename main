class WantedAvanceGameSelect(discord.ui.View):
    def __init__(self, pokemon, bonus_points, decay_percent, indice, unique=False):
        super().__init__(timeout=300)
        self.pokemon = pokemon
        self.bonus_points = bonus_points
        self.decay_percent = decay_percent
        self.indice = indice
        self.unique = unique

        options = [discord.SelectOption(label=v["fr"][:100], value=k) for k, v in GAMES.items()]
        if len(options) <= 25:
            sel = discord.ui.Select(placeholder="🎮 Choisir un jeu (optionnel)", options=options, min_values=1, max_values=1)
            sel.callback = self.game_selected
            self.add_item(sel)
        else:
            sel1 = discord.ui.Select(placeholder="🎮 Jeux (1/2)", options=options[:25], min_values=1, max_values=1)
            sel1.callback = self.game_selected
            self.add_item(sel1)
            sel2 = discord.ui.Select(placeholder="🎮 Jeux (2/2)", options=options[25:50], min_values=1, max_values=1)
            sel2.callback = self.game_selected
            self.add_item(sel2)

        # Bouton "aucun jeu"
        btn_no_game = discord.ui.Button(label="🌐 Aucun jeu (tous les jeux)", style=discord.ButtonStyle.secondary)
        btn_no_game.callback = self.no_game
        self.add_item(btn_no_game)

    async def game_selected(self, interaction: discord.Interaction):
        game_key = interaction.data["values"][0]
        game_name = GAMES[game_key]["fr"]

        methods = METHODS_BY_GAME.get(game_key, {})
        if methods:
            view = WantedAvanceMethodSelect(self.pokemon, self.bonus_points, self.decay_percent, self.indice, game_key, game_name, unique=self.unique)
            embed = discord.Embed(
                title="🎯 Wanted Avancé — Étape 2/2",
                description=(
                    f"Pokémon : **{self.pokemon}** | Jeu : **{game_name}**\n\n"
                    "Sélectionnez une **méthode précise** (optionnel) :"
                ),
                color=discord.Color.red()
            )
            await interaction.response.edit_message(embed=embed, view=view)
        else:
            # Pas de méthode pour ce jeu, créer directement
            await self._create_wanted(interaction, game_key, game_name, method_key=None)

    async def no_game(self, interaction: discord.Interaction):
        await self._create_wanted(interaction, game_key=None, game_name=None, method_key=None)

    async def _create_wanted(self, interaction, game_key, game_name, method_key):
        import json as _json
        game_to_store = game_name
        wanted_id = set_wanted(self.pokemon, self.bonus_points, self.decay_percent, game_to_store)

        # Si unique : stocker paliers avec p2=p3=suite=0
        if self.unique:
            paliers = {"p1": self.bonus_points, "p2": 0, "p3": 0, "suite": 0}
            cursor.execute("UPDATE shiny_wanted SET paliers_json=? WHERE id=?", (_json.dumps(paliers), wanted_id))
            conn.commit()

        # Stocker l'indice si fourni
        if self.indice:
            cursor.execute("UPDATE shiny_wanted SET indice=? WHERE id=?", (self.indice, wanted_id))
            conn.commit()

        game_label = game_name if game_name else "Tous les jeux"
        unique_label = "🔒 **Unique** — 1er trouveur uniquement" if self.unique else f"Décroissance {self.decay_percent}%"
        embed = discord.Embed(
            title="✅ Wanted créé !",
            description=f"**{self.pokemon}** est maintenant un Pokémon Wanted !",
            color=discord.Color.green()
        )
        embed.add_field(name="🎮 Jeu", value=game_label, inline=True)
        embed.add_field(name="⭐ Bonus 1er", value=f"+{self.bonus_points} pts", inline=True)
        embed.add_field(name="📋 Type", value=unique_label, inline=True)
        if self.indice:
            embed.add_field(name="💡 Indice", value=self.indice, inline=False)
        embed.set_footer(text="ShinyBot — Wanted Avancé")
        await interaction.response.edit_message(embed=embed, view=None)


class WantedAvanceMethodSelect(discord.ui.View):
    def __init__(self, pokemon, bonus_points, decay_percent, indice, game_key, game_name, unique=False):
        super().__init__(timeout=300)
        self.pokemon = pokemon
        self.bonus_points = bonus_points
        self.decay_percent = decay_percent
        self.indice = indice
        self.game_key = game_key
        self.game_name = game_name
        self.unique = unique

        methods = METHODS_BY_GAME.get(game_key, {})
        options = [
            discord.SelectOption(
                label=f"{v['fr']} ({v['points']} pts)"[:100],
                value=method_key
            )
            for method_key, v in methods.items()
        ]
        sel = discord.ui.Select(
            placeholder="🎯 Choisir une méthode (optionnel)",
            options=options[:25],
            min_values=1, max_values=1
        )
        sel.callback = self.method_selected
        self.add_item(sel)

        # Bouton "sans méthode précise"
        btn_no_method = discord.ui.Button(label="🌐 Toutes les méthodes", style=discord.ButtonStyle.secondary)
        btn_no_method.callback = self.no_method
        self.add_item(btn_no_method)

    async def method_selected(self, interaction: discord.Interaction):
        method_key = interaction.data["values"][0]
        method_name = METHODS_BY_GAME[self.game_key][method_key]["fr"]
        await self._create_wanted_with_method(interaction, method_key, method_name)

    async def no_method(self, interaction: discord.Interaction):
        await self._create_wanted_with_method(interaction, method_key=None, method_name=None)

    async def _create_wanted_with_method(self, interaction, method_key, method_name):
        import json as _json
        indice_final = self.indice or ""
        if method_name:
            method_suffix = f"[Méthode : {method_name}]"
            indice_final = f"{indice_final} {method_suffix}".strip() if indice_final else method_suffix

        wanted_id = set_wanted(self.pokemon, self.bonus_points, self.decay_percent, self.game_name)

        # Si unique : stocker paliers avec p2=p3=suite=0
        if self.unique:
            paliers = {"p1": self.bonus_points, "p2": 0, "p3": 0, "suite": 0}
            cursor.execute("UPDATE shiny_wanted SET paliers_json=? WHERE id=?", (_json.dumps(paliers), wanted_id))
            conn.commit()

        if indice_final:
            cursor.execute("UPDATE shiny_wanted SET indice=? WHERE id=?", (indice_final, wanted_id))
            conn.commit()

        method_label = method_name if method_name else "Toutes les méthodes"
        unique_label = "🔒 **Unique** — 1er seulement" if self.unique else f"Décroissance {self.decay_percent}%"
        embed = discord.Embed(
            title="✅ Wanted créé !",
            description=f"**{self.pokemon}** est maintenant un Pokémon Wanted !",
            color=discord.Color.green()
        )
        embed.add_field(name="🎮 Jeu", value=self.game_name, inline=True)
        embed.add_field(name="🎯 Méthode", value=method_label, inline=True)
        embed.add_field(name="⭐ Bonus 1er", value=f"+{self.bonus_points} pts", inline=True)
        embed.add_field(name="📋 Type", value=unique_label, inline=True)
        if self.indice:
            embed.add_field(name="💡 Indice original", value=self.indice, inline=False)
        embed.set_footer(text="ShinyBot — Wanted Avancé")
        await interaction.response.edit_message(embed=embed, view=None)


