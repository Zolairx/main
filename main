@bot.tree.command(
    name="race_stats",
    description="Voir vos statistiques de races shiny",
    guild=discord.Object(id=GUILD_ID)
)
async def race_stats(interaction: discord.Interaction):
    async def _show_stats(**kwargs):
        await interaction.response.defer(ephemeral=True)

        user_id = str(interaction.user.id)
        stats = get_race_stats(user_id)

        wins = stats['wins']
        total = stats['total']
        active = stats['active']
        total_bonus = stats['total_bonus']
        losses = max(total - wins, 0)
        winrate = (wins / total * 100) if total > 0 else 0

        embed = discord.Embed(
            title="🏁 Statistiques de Races Shiny",
            description=f"Statistiques pour {interaction.user.mention}",
            color=discord.Color.blurple()
        )
        embed.add_field(name="✅ Victoires", value=str(wins), inline=True)
        embed.add_field(name="❌ Défaites", value=str(losses), inline=True)
        embed.add_field(name="📊 Races jouées", value=str(total), inline=True)
        embed.add_field(name="🔥 Races actives", value=str(active), inline=True)
        embed.add_field(name="🏆 Winrate", value=f"{winrate:.1f}%", inline=True)
        embed.add_field(name="💰 Points bonus gagnés", value=f"{total_bonus:.1f} ⭐", inline=True)
        embed.set_footer(text="ShinyBot - Continuez à défier les autres chasseurs !")

        await interaction.followup.send(embed=embed, ephemeral=True)
        return True

    result = await discord_retry_wrapper(_show_stats, context="Race Stats Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

@bot.tree.command(
    name="race_list",
    description="Afficher les races shiny actives",
    guild=discord.Object(id=GUILD_ID)
)
async def race_list(interaction: discord.Interaction):
    async def _show_list(**kwargs):
        await interaction.response.defer(ephemeral=True)

        open_races = get_active_open_races()
        legacy_races = get_active_races()

        if not open_races and not legacy_races:
            await interaction.followup.send("⚠️ Aucune race active pour le moment.", ephemeral=True)
            return True

        embed = discord.Embed(
            title="🏁 Races Shiny Actives",
            color=discord.Color.orange()
        )

        guild = bot.get_guild(GUILD_ID)

        for race in open_races:
            race_id, pokemon_name, game, bonus_points, created_by, created_at = race
            nb_participants = len(get_open_race_participants(race_id))
            creator = guild.get_member(int(created_by)) if guild else None
            creator_name = creator.display_name if creator else created_by
            created_str = created_at if isinstance(created_at, str) else str(created_at)

            value = (
                f"👑 **Lancée par :** {creator_name}\n"
                f"🎯 **Cible:** {pokemon_name}\n"
                f"🎮 **Jeu:** {game}\n"
                f"💰 **Bonus:** +{bonus_points} pts\n"
                f"👥 **Participants:** {nb_participants}\n"
                f"🕒 **Créée le:** {created_str}"
            )
            embed.add_field(name=f"🆕 Race Ouverte #{race_id}", value=value, inline=False)

        for race in legacy_races:
            race_id, challenger_id, opponent_id, pokemon_name, game, bonus_points, created_at = race
            challenger = guild.get_member(int(challenger_id)) if guild else None
            opponent = guild.get_member(int(opponent_id)) if guild else None
            challenger_name = challenger.display_name if challenger else challenger_id
            opponent_name = opponent.display_name if opponent else opponent_id
            created_str = created_at if isinstance(created_at, str) else str(created_at)

            value = (
                f"👤 **{challenger_name}** vs **{opponent_name}**\n"
                f"🎯 **Cible:** {pokemon_name}\n"
                f"🎮 **Jeu:** {game}\n"
                f"💰 **Bonus:** +{bonus_points} pts\n"
                f"🕒 **Créée le:** {created_str}"
            )
            embed.add_field(name=f"⚔️ Race Legacy #{race_id}", value=value, inline=False)

        embed.set_footer(text="ID de race à utiliser pour /race_cancel (admin).")
        await interaction.followup.send(embed=embed, ephemeral=True)
        return True

    result = await discord_retry_wrapper(_show_list, context="Race List Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

@bot.tree.command(
    name="race_cancel",
    description="[ADMIN] Annuler une race shiny active",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    race_id="ID de la race à annuler (voir /race_list)"
)
async def race_cancel(interaction: discord.Interaction, race_id: int):
    async def _cancel(**kwargs):
        await interaction.response.defer(ephemeral=True)

        if not interaction.user.guild_permissions.administrator:
            await interaction.followup.send("❌ Vous devez être administrateur pour utiliser cette commande.", ephemeral=True)
            return None

        # On cherche d'abord dans les races ouvertes (nouveau système), puis dans les races legacy.
        open_race = get_open_race(race_id)
        if open_race is not None:
            if open_race['status'] != 'active':
                await interaction.followup.send("⚠️ Cette race n'est pas active (déjà terminée ou annulée).", ephemeral=True)
                return None
            cancel_open_race(race_id)
            try:
                await close_open_race_message(race_id)
            except Exception:
                pass
            await interaction.followup.send(f"✅ La race ouverte #{race_id} a été annulée.", ephemeral=True)
            return True

        cursor.execute("SELECT status FROM shiny_races WHERE id = ?", (race_id,))
        row = cursor.fetchone()
        if not row:
            await interaction.followup.send("❌ Race introuvable.", ephemeral=True)
            return None

        status = row[0]
        if status != "active":
            await interaction.followup.send("⚠️ Cette race n'est pas active (déjà terminée ou annulée).", ephemeral=True)
            return None

        cursor.execute("""
            UPDATE shiny_races
            SET status = 'cancelled', ended_at = datetime('now')
            WHERE id = ?
        """, (race_id,))
        conn.commit()

        await interaction.followup.send(f"✅ La race #{race_id} a été annulée.", ephemeral=True)
        return True

    result = await discord_retry_wrapper(_cancel, context="Race Cancel Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

@bot.tree.command(
    name="reset_saison",
    description="Réinitialiser tous les points shiny et archiver la saison (Admin uniquement).",
    guild=discord.Object(id=GUILD_ID)
)
async def reset_saison(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.send_modal(ResetSaisonModal())


class ResetSaisonModal(discord.ui.Modal):
    def __init__(self):
        super().__init__(title="Confirmer le reset de saison")
        self.nom_saison_input = discord.ui.TextInput(
            label="Nom de la saison à archiver",
            placeholder="Ex: Saison 5  (laisser vide = numéro auto)",
            required=False,
            max_length=50
        )
        self.confirmation_input = discord.ui.TextInput(
            label="Tapez CONFIRMER pour valider",
            placeholder="CONFIRMER",
            required=True,
            max_length=10
        )
        self.add_item(self.nom_saison_input)
        self.add_item(self.confirmation_input)

    async def on_submit(self, interaction: discord.Interaction):
        if self.confirmation_input.value.strip().upper() != "CONFIRMER":
            await interaction.response.send_message(
                "❌ Reset annulé — tapez exactement **CONFIRMER** pour valider.",
                ephemeral=True
            )
            return

        await interaction.response.defer(ephemeral=True)
        nom_saison = self.nom_saison_input.value.strip() or None

        cursor.execute("SELECT COALESCE(MAX(season_number), 0) FROM season_meta")
        last_season = cursor.fetchone()[0]
        new_season_num = last_season + 1
        season_label = nom_saison if nom_saison else f"Saison {new_season_num}"

        ladder = get_ladder()
        total_players = len(ladder)

        cursor.execute("""
            INSERT INTO season_meta (season_number, season_name, ended_at, total_players)
            VALUES (?, ?, datetime('now'), ?)
        """, (new_season_num, season_label, total_players))

        for rank, (user_id, total_points, wanted_count, race_wins) in enumerate(ladder, 1):
            cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id = ?", (user_id,))
            total_shinys = cursor.fetchone()[0]
            cursor.execute("""
                INSERT INTO season_archives (season_number, season_name, user_id, rank, total_points, total_shinys, wanted_count, race_wins)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (new_season_num, season_label, user_id, rank, total_points or 0, total_shinys, int(wanted_count or 0), int(race_wins or 0)))

        # Attribuer badges de fin de saison
        try:
            for rank, (user_id, total_points, wanted_count, race_wins) in enumerate(ladder, 1):
                check_and_award_badges(user_id)
        except Exception as e:
            logger.error(f"Erreur badge saison: {e}")

        # Nouvelle saison : tous les participants repartent avec un bonus fixe.
        season_start_points = 50
        carry_over_entries = [(user_id, season_start_points) for user_id, *_ in ladder]

        # Calibrage doux : petit bonus de départ selon le tier de fin de saison précédente
        # (volontairement faible par rapport au cap hebdo, pour s'effacer vite en jouant).
        calibration_entries = []
        for rank, (user_id, *_rest) in enumerate(ladder, 1):
            _tier = get_tier_from_position(rank)
            _calib_bonus = SEASON_CALIBRATION_BY_TIER.get(_tier, 0)
            if _calib_bonus > 0:
                calibration_entries.append((user_id, _calib_bonus, _tier))

        # Sauvegarder l'historique des jeux avant de vider la table shiny,
        # pour que le bonus "Nouveau jeu" reste cohérent entre les saisons.
        cursor.execute("SELECT DISTINCT user_id, game FROM shiny WHERE game IS NOT NULL AND TRIM(game) != ''")
        for _uid, _game in cursor.fetchall():
            _gk = resolve_game_key(_game)
            if _gk:
                cursor.execute(
                    "INSERT OR IGNORE INTO user_game_history (user_id, game_key) VALUES (?, ?)",
                    (str(_uid), _gk)
                )

        cursor.execute("DELETE FROM shiny")
        cursor.execute("DELETE FROM user_streaks")
        cursor.execute("DELETE FROM shiny_wanted_claimed")
        cursor.execute("DELETE FROM weekly_objectives_progress")
        cursor.execute("DELETE FROM monthly_objectives_progress")
        cursor.execute("DELETE FROM weekly_player_choices")
        cursor.execute("DELETE FROM weekly_objectives")
        cursor.execute("DELETE FROM monthly_objectives")
        cursor.execute("DELETE FROM weekly_points_tracking")
        cursor.execute("DELETE FROM weekly_participation")
        cursor.execute("DELETE FROM weekly_variety_claims")
        cursor.execute("DELETE FROM monthly_bonus_claims")
        cursor.execute("DELETE FROM weekly_game_bonus")
        cursor.execute("DELETE FROM monthly_challenge_winners")
        cursor.execute("DELETE FROM monthly_challenge_pokemon_log")
        cursor.execute("DELETE FROM inactivity_decay_state")
        cursor.execute("DELETE FROM ladder_snapshot")

        # Ré-insérer les points de participation de nouvelle saison.
        date_now = datetime.now().strftime("%d-%m-%Y")
        for uid, new_pts in carry_over_entries:
            cursor.execute("""
                INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                VALUES (?, ?, ?, ?, ?, ?, datetime('now'), 'fr')
            """, (uid, f'[Participation Saison {new_season_num}]', '', 'season_carryover', date_now, new_pts))

        # Calibrage doux : bonus de départ selon le tier de fin de saison précédente.
        for uid, _calib_bonus, _tier in calibration_entries:
            cursor.execute("""
                INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                VALUES (?, ?, ?, ?, ?, ?, datetime('now'), 'fr')
            """, (uid, f'[Calibrage Saison {new_season_num} — {_tier}]', '', 'season_calibration', date_now, _calib_bonus))
        conn.commit()

        weekly_ok, weekly_result = draw_weekly_objectives()
        monthly_ok, monthly_result = draw_monthly_objectives()
        weekly_game_key = draw_weekly_game()
        weekly_game_label = GAMES.get(weekly_game_key, {}).get('fr', weekly_game_key)

        embed = discord.Embed(
            title=f"🏆 {season_label} archivée !",
            description=(
                f"**{total_players}** joueur{'s' if total_players > 1 else ''} archivé{'s' if total_players > 1 else ''}. "
                f"Tous les participants repartent avec **{season_start_points} pts** de participation."
            ),
            color=discord.Color.gold()
        )
        embed.add_field(name="📋 Saison", value=f"**{season_label}** (#{new_season_num})", inline=True)
        embed.add_field(name="👥 Joueurs archivés", value=str(total_players), inline=True)
        embed.add_field(name="⭐ Points de départ", value=f"**{season_start_points} pts** pour chaque participant", inline=True)
        if calibration_entries:
            embed.add_field(
                name="🎚️ Calibrage doux",
                value=f"**{len(calibration_entries)}** joueur(s) ont reçu un petit bonus de départ (+2 à +15 pts) selon leur tier de fin de saison.",
                inline=False
            )
        if ladder:
            winner_id = ladder[0][0]
            guild = bot.get_guild(GUILD_ID)
            winner = guild.get_member(int(winner_id)) if guild else None
            winner_name = winner.display_name if winner else winner_id
            winner_pts = ladder[0][1]
            embed.add_field(name="🥇 Champion", value=f"**{winner_name}** avec **{int(winner_pts)} pts**", inline=False)
        weekly_txt = "\n".join(f"• {obj}" for obj in weekly_result[:4]) if weekly_ok else str(weekly_result)
        monthly_txt = f"{len(monthly_result)} objectif(s) mensuel(s) tiré(s)." if monthly_ok else str(monthly_result)
        embed.add_field(
            name="📅 Nouveaux objectifs semaine",
            value=(weekly_txt[:900] if weekly_txt else "Aucun objectif hebdo tiré."),
            inline=False
        )
        embed.add_field(
            name="📆 Nouveaux objectifs mois",
            value=monthly_txt[:900],
            inline=False
        )
        embed.add_field(
            name="🎮 Nouveau jeu de la semaine",
            value=f"**{weekly_game_label}**",
            inline=False
        )
        embed.add_field(
            name="🔄 Bonus réinitialisés",
            value="Participation hebdo, jeu de la semaine, missions variété, bonus mensuels, wanteds serveur et challenges mensuels.",
            inline=False
        )
        embed.set_footer(text="ShinyBot • /mon_historique pour voir vos saisons passées")
        await interaction.followup.send(embed=embed)

        async def delayed_update():
            await asyncio.sleep(2)
            await update_classement_message()
        asyncio.create_task(delayed_update())

@bot.tree.command(
    name="reset_misaison",
    description="[ADMIN] Compresser les points pour la mi-saison sans archiver (formule √(pts)×20)",
    guild=discord.Object(id=GUILD_ID)
)
async def reset_misaison(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.send_modal(ResetMiSaisonModal())


class ResetMiSaisonModal(discord.ui.Modal):
    def __init__(self):
        super().__init__(title="Confirmer le reset de mi-saison")
        self.confirmation_input = discord.ui.TextInput(
            label="Tapez CONFIRMER pour valider",
            placeholder="CONFIRMER",
            required=True,
            max_length=10
        )
        self.add_item(self.confirmation_input)

    async def on_submit(self, interaction: discord.Interaction):
        if self.confirmation_input.value.strip().upper() != "CONFIRMER":
            await interaction.response.send_message(
                "❌ Reset annulé — tapez exactement **CONFIRMER** pour valider.",
                ephemeral=True
            )
            return

        await interaction.response.defer(ephemeral=True)

        ladder = get_ladder()
        total_players = len([r for r in ladder if r[1] and r[1] > 0])

        # Points déjà comptabilisés dans le classement Full Odds / Rétro (par joueur),
        # calculés AVANT toute suppression : ils doivent être exclus de la compression
        # générale pour ne pas être comptés deux fois, puisque leurs lignes brutes
        # ne seront pas supprimées (voir clause de conservation plus bas).
        retro_points_by_user = {uid: (pts or 0) for uid, pts in get_retro_ladder()}

        # Appliquer la formule de compression √(pts)×20 — uniquement sur les points
        # HORS Full Odds / Rétro, puisque ceux-ci sont conservés tels quels.
        import math as _math
        carry_over_entries = []
        for user_id, total_points, wanted_count, race_wins in ladder:
            non_retro_points = (total_points or 0) - retro_points_by_user.get(user_id, 0)
            if non_retro_points and non_retro_points > 0:
                new_pts = int(_math.sqrt(non_retro_points) * 20)
                if new_pts > 0:
                    carry_over_entries.append((user_id, int(non_retro_points), new_pts))

        # Construire la clause permettant d'identifier les lignes "shiny" qui comptent
        # pour le classement Full Odds / Rétro (mêmes critères que get_retro_ladder()),
        # afin de NE PAS les supprimer : ce classement doit rester intact à la mi-saison.
        _retro_game_names = get_game_names_for_keys(RETRO_LADDER_GAME_KEYS)
        _retro_fo_game_names = get_game_names_for_keys(RETRO_LADDER_FULL_ODDS_ONLY_GAME_KEYS)
        _retro_fo_methods = get_retro_full_odds_method_keys()
        _ph_game = ",".join("?" for _ in _retro_game_names) or "NULL"
        _ph_fo_game = ",".join("?" for _ in _retro_fo_game_names) or "NULL"
        _ph_fo_method = ",".join("?" for _ in _retro_fo_methods) or "NULL"
        _retro_keep_clause = f"(game IN ({_ph_game}) OR (game IN ({_ph_fo_game}) AND methode IN ({_ph_fo_method})))"
        _retro_keep_params = (*_retro_game_names, *_retro_fo_game_names, *_retro_fo_methods)

        # Supprimer les données de la saison en cours (sans toucher aux archives),
        # SAUF les shinys qui comptent pour le classement Full Odds / Rétro.
        cursor.execute(f"DELETE FROM shiny WHERE NOT {_retro_keep_clause}", _retro_keep_params)
        cursor.execute("DELETE FROM user_streaks")
        cursor.execute("DELETE FROM shiny_wanted_claimed")
        cursor.execute("DELETE FROM weekly_objectives_progress")
        cursor.execute("DELETE FROM monthly_objectives_progress")
        cursor.execute("DELETE FROM weekly_points_tracking")
        cursor.execute("DELETE FROM weekly_variety_claims")
        cursor.execute("DELETE FROM monthly_bonus_claims")
        cursor.execute("DELETE FROM inactivity_decay_state")
        cursor.execute("DELETE FROM ladder_snapshot")

        # Ré-insérer les points compressés (hors Full Odds / Rétro, déjà conservés)
        date_now = datetime.now().strftime("%d-%m-%Y")
        for uid, old_pts, new_pts in carry_over_entries:
            cursor.execute("""
                INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                VALUES (?, ?, ?, ?, ?, ?, datetime('now'), 'fr')
            """, (uid, '[Report Mi-Saison]', '', 'season_carryover', date_now, new_pts))
        conn.commit()

        # Construire le résumé des compressions
        top_summary = ""
        if carry_over_entries:
            guild = bot.get_guild(GUILD_ID)
            lines = []
            for uid, old_pts, new_pts in carry_over_entries[:5]:
                member = guild.get_member(int(uid)) if guild else None
                name = member.display_name if member else str(uid)
                lines.append(f"**{name}** : {old_pts} pts → **{new_pts} pts**")
            top_summary = "\n".join(lines)
            if len(carry_over_entries) > 5:
                top_summary += f"\n*...et {len(carry_over_entries) - 5} autres joueurs*"

        embed = discord.Embed(
            title="🔄 Mi-saison — Points compressés !",
            description=(
                f"**{total_players}** joueur{'s' if total_players != 1 else ''} traité{'s' if total_players != 1 else ''}.\n"
                f"Formule appliquée : **√(pts) × 20** (hors points Full Odds / Rétro)\n\n"
                f"Les archives de saison, l'historique et le **classement Full Odds / Rétro** sont **inchangés**."
            ),
            color=discord.Color.blurple()
        )
        if top_summary:
            embed.add_field(name="📊 Aperçu Top 5", value=top_summary, inline=False)
        embed.set_footer(text="ShinyBot · Mi-saison • /classement pour voir le nouveau classement")
        await interaction.followup.send(embed=embed)

        async def delayed_update():
            await asyncio.sleep(2)
            await update_classement_message()
        asyncio.create_task(delayed_update())


@bot.tree.command(
    name="mon_historique",
    description="Voir votre historique de saisons shiny",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    membre="Membre dont vous voulez voir l'historique (optionnel, par défaut vous)"
)
async def mon_historique(interaction: discord.Interaction, membre: discord.Member = None):
    await interaction.response.defer(ephemeral=True)

    target = membre if membre else interaction.user
    user_id = str(target.id)

    cursor.execute("""
        SELECT sa.season_number, sa.season_name, sa.rank, sa.total_points,
               sa.total_shinys, sa.wanted_count, sa.race_wins,
               sm.total_players, sa.archived_at
        FROM season_archives sa
        JOIN season_meta sm ON sa.season_number = sm.season_number
        WHERE sa.user_id = ?
        ORDER BY sa.season_number DESC
    """, (user_id,))
    rows = cursor.fetchall()

    if not rows:
        msg = f"Aucun historique de saison trouvé pour **{target.display_name}**."
        if target.id == interaction.user.id:
            msg += "\nVotre premier historique apparaîtra après le prochain `/reset_saison`."
        await interaction.followup.send(msg, ephemeral=True)
        return

    embed = discord.Embed(
        title=f"📜 Historique de {target.display_name}",
        color=discord.Color.gold(),
        timestamp=datetime.now()
    )
    embed.set_thumbnail(url=target.display_avatar.url)

    def rank_medal(r):
        if r == 1: return "🥇"
        if r == 2: return "🥈"
        if r == 3: return "🥉"
        if r <= 8: return "💜"
        if r <= 14: return "💎"
        if r <= 23: return "🏆"
        if r <= 32: return "✨"
        if r <= 43: return "🌠"
        return "🌟"

    best_rank = min(r[2] for r in rows)
    total_seasons = len(rows)

    embed.add_field(
        name="📊 Résumé",
        value=f"**Saisons jouées :** {total_seasons}\n**Meilleur rang :** {rank_medal(best_rank)} #{best_rank}",
        inline=False
    )

    for row in rows[:10]:  # Max 10 saisons affichées
        season_num, season_name, rank, pts, shinys, wanted, race_wins, total_players, archived_at = row
        pts_str = f"{pts:.1f}" if pts % 1 != 0 else f"{int(pts)}"
        date_str = archived_at[:10] if archived_at else "?"
        medal = rank_medal(rank)

        value = (
            f"{medal} **#{rank}** / {total_players} joueurs\n"
            f"⭐ **{pts_str} pts** | ✨ {shinys} shinys\n"
            f"🎯 {wanted} wanted | 🏁 {race_wins} races gagnées"
        )
        embed.add_field(
            name=f"🗓️ {season_name} — {date_str}",
            value=value,
            inline=False
        )

    if len(rows) > 10:
        embed.set_footer(text=f"Affichage des 10 dernières saisons sur {total_seasons} • ShinyBot")
    else:
        embed.set_footer(text="ShinyBot • Historique complet")

    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="admin_historique_saisons",
    description="[ADMIN] Voir l'historique de toutes les saisons",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    saison="Numéro de saison à afficher (laisser vide pour la liste de toutes les saisons)"
)
async def admin_historique_saisons(interaction: discord.Interaction, saison: int = None):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)

    if saison is None:
        # Liste de toutes les saisons
        cursor.execute("""
            SELECT season_number, season_name, total_players, ended_at
            FROM season_meta ORDER BY season_number DESC
        """)
        rows = cursor.fetchall()
        if not rows:
            await interaction.followup.send("Aucune saison archivée pour le moment.", ephemeral=True)
            return

        embed = discord.Embed(
            title="📋 Toutes les Saisons Archivées",
            color=discord.Color.blue()
        )
        for row in rows:
            num, name, players, ended = row
            date_str = ended[:10] if ended else "?"
            embed.add_field(
                name=f"#{num} — {name}",
                value=f"👥 {players} joueurs | 📅 Terminée le {date_str}\nUtilisez `/admin_historique_saisons saison:{num}` pour le détail",
                inline=False
            )
        embed.set_footer(text="ShinyBot • Historique Admin")
        await interaction.followup.send(embed=embed, ephemeral=True)

    else:
        # Détail d'une saison
        cursor.execute("SELECT season_name, total_players, ended_at FROM season_meta WHERE season_number=?", (saison,))
        meta = cursor.fetchone()
        if not meta:
            await interaction.followup.send(f"❌ Saison #{saison} introuvable.", ephemeral=True)
            return

        season_name, total_players, ended_at = meta
        cursor.execute("""
            SELECT user_id, rank, total_points, total_shinys, wanted_count, race_wins
            FROM season_archives WHERE season_number=?
            ORDER BY rank ASC
        """, (saison,))
        players = cursor.fetchall()

        guild = bot.get_guild(GUILD_ID)
        def display(uid):
            m = guild.get_member(int(uid)) if guild else None
            return m.display_name if m else f"<@{uid}>"

        embed = discord.Embed(
            title=f"🏆 {season_name} — Classement complet",
            description=f"📅 Terminée le {ended_at[:10] if ended_at else '?'} | 👥 {total_players} joueurs",
            color=discord.Color.gold()
        )

        medals = {1:"🥇",2:"🥈",3:"🥉"}
        lines = []
        for uid, rank, pts, shinys, wanted, races in players[:25]:
            pts_str = f"{pts:.1f}" if pts % 1 != 0 else f"{int(pts)}"
            medal = medals.get(rank, f"#{rank}")
            lines.append(f"{medal} **{display(uid)}** — {pts_str} pts | {shinys} shinys | {wanted} wanted | {races} races")

        if lines:
            # Découper si trop long
            chunk = ""
            field_count = 0
            for line in lines:
                if len(chunk) + len(line) > 1000:
                    embed.add_field(name=f"Classement ({field_count*10+1}-{field_count*10+10})" if field_count else "Classement", value=chunk, inline=False)
                    chunk = line + "\n"
                    field_count += 1
                else:
                    chunk += line + "\n"
            if chunk:
                embed.add_field(name="Classement" if not field_count else f"Suite", value=chunk, inline=False)

        if total_players > 25:
            embed.set_footer(text=f"Affichage des 25 premiers sur {total_players} • ShinyBot")
        else:
            embed.set_footer(text="ShinyBot • Historique Admin")

        await interaction.followup.send(embed=embed, ephemeral=True)

