        self.language = language
        self.target_member = target_member

        type_options = [
            discord.SelectOption(
                label="Émulateurs" if language == "Français" else "Emulators",
                value="emulators",
                description="Utilise les multiplicateurs normaux" if language == "Français" else "Uses normal multipliers"
            ),
            discord.SelectOption(
                label="Consoles" if language == "Français" else "Consoles",
                value="consoles",
                description="Multiplicateurs spéciaux pour consoles" if language == "Français" else "Special multipliers for consoles"
            ),
            discord.SelectOption(
                label="Consoles Controllers Mods" if language == "Français" else "Console Controller Mods",
                value="console_mods",
                description="Utilise les multiplicateurs normaux" if language == "Français" else "Uses normal multipliers"
            )
        ]

        select = discord.ui.Select(
            placeholder="Choisissez le type" if language == "Français" else "Choose the type",
            options=type_options
        )
        select.callback = self.type_callback
        self.add_item(select)

    async def type_callback(self, interaction):
