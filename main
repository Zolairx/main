}


def get_tier_color_by_position(position):
    """Renvoie la discord.Color correspondant au tier d'une position donnée."""
    tier = get_tier_from_position(position)
    return TIER_COLORS.get(tier, discord.Color.blurple())


def render_progress_bar(ratio, length=10, filled_char="▰", empty_char="▱"):
    """Génère une barre de progression textuelle du style ▰▰▰▰▰▱▱▱▱▱.

    `ratio` doit être compris entre 0.0 et 1.0 (les valeurs hors bornes sont
    clampées automatiquement).
    """
    ratio = max(0.0, min(1.0, ratio))
    filled = round(ratio * length)
    return filled_char * filled + empty_char * (length - filled)


# ════════════════════════════════════════════════════════════════
# ══  RANG DE PROGRESSION PERSONNEL (indépendant du classement)  ══
# ════════════════════════════════════════════════════════════════
# Contrairement au rang de position (Shiny Novice → Shiny Master, basé sur
# le classement relatif), ce rang est basé sur le total de points de la
# SAISON en cours et ne peut donc quasiment jamais reculer : même un joueur
# qui perd des places au classement voit ce rang progresser tant qu'il
# continue à jouer. Objectif : garantir une sensation de progression à
# tous les joueurs, pas seulement au top du classement.
# Seuils recalibrés (top 10 actuel > 1000 pts sur la saison — l'ancienne
# échelle plaçait déjà tout le top au rang max, ce qui cassait l'intérêt) :
PROGRESSION_TIERS = [
    (0,    "recrue",   "🌱", "Recrue",   discord.Color.from_rgb(139, 115, 85)),
    (200,  "chasseur", "🔎", "Shasseur", discord.Color.from_rgb(0, 191, 255)),
    (500,  "expert",   "🎯", "Expert",   discord.Color.from_rgb(0, 200, 80)),
    (900,  "veteran",  "⚔️", "Vétéran",  discord.Color.from_rgb(70, 130, 220)),
    (1400, "elite",    "💠", "Élite",    discord.Color.purple()),
    (2200, "champion", "🏆", "Champion", discord.Color.from_rgb(255, 140, 0)),
    (3500, "legende",  "👑", "Légende",  discord.Color.gold()),
]


def get_progression_tier(total_points):
    """Retourne les infos du rang de progression pour un total de points donné :
    (code, emoji, nom, couleur, seuil_actuel, seuil_suivant_ou_None, ratio_vers_le_suivant)."""
    total_points = max(0.0, float(total_points or 0))
    current = PROGRESSION_TIERS[0]
    next_tier = None
    for i, tier in enumerate(PROGRESSION_TIERS):
        if total_points >= tier[0]:
            current = tier
            next_tier = PROGRESSION_TIERS[i + 1] if i + 1 < len(PROGRESSION_TIERS) else None
        else:
            break
    if next_tier:
        span = next_tier[0] - current[0]
        ratio = (total_points - current[0]) / span if span > 0 else 1.0
    else:
        ratio = 1.0
    return {
        'code': current[1], 'emoji': current[2], 'name': current[3], 'color': current[4],
        'threshold': current[0],
        'next_code': next_tier[1] if next_tier else None,
        'next_emoji': next_tier[2] if next_tier else None,
        'next_name': next_tier[3] if next_tier else None,
        'next_threshold': next_tier[0] if next_tier else None,
        'ratio': ratio,
        'points_to_next': (next_tier[0] - total_points) if next_tier else 0,
    }


def check_progression_tier_change(old_points, new_points):
    """Retourne les infos du nouveau tier si le joueur vient de changer de
    rang de progression, sinon None."""
    old_info = get_progression_tier(old_points)
    new_info = get_progression_tier(new_points)
    if new_info['code'] != old_info['code'] and new_points > old_points:
        return new_info
    return None


async def send_progression_rank_up_message(member, tier_info, pokemon_name, points, language="fr"):
    """Annonce publique quand un joueur débloque un nouveau rang de progression personnel."""
    try:
        guild = bot.get_guild(GUILD_ID)
        if not guild:
            return
        channel = bot.get_channel(SALON_CLASSEMENT_ID)
        if not channel:
            for ch in guild.text_channels:
                if 'general' in ch.name.lower() or 'shiny' in ch.name.lower():
                    channel = ch
                    break
        if not channel:
            return

        is_fr = language == "fr" or language == "Français"
        title = f"{tier_info['emoji']} NOUVEAU RANG DE PROGRESSION : {tier_info['name'].upper()} {tier_info['emoji']}" if is_fr \
            else f"{tier_info['emoji']} NEW PROGRESSION RANK: {tier_info['name'].upper()} {tier_info['emoji']}"
        description = (
            f"{member.mention} vient d'atteindre le rang de progression **{tier_info['name']}** ! 🎉\n"
            f"-# Ce rang suit ta progression personnelle sur la saison — il ne recule jamais."
        ) if is_fr else (
            f"{member.mention} just reached the **{tier_info['name']}** progression rank! 🎉\n"
            f"-# This rank tracks your personal season progress — it never goes down."
        )
        embed = discord.Embed(title=title, description=description, color=tier_info['color'], timestamp=datetime.now())
        embed.set_author(name=member.display_name, icon_url=member.display_avatar.url)
        embed.set_thumbnail(url=member.display_avatar.url)
        embed.add_field(
            name="✨ Shiny déclencheur" if is_fr else "✨ Triggering shiny",
            value=f"**{pokemon_name}** (+{points:.2f} pts)",
            inline=False
        )
        embed.set_footer(text="ShinyBot · Rang de progression personnel" if is_fr else "ShinyBot · Personal progression rank")
        await channel.send(embed=embed)
    except Exception as e:
        logger.error(f"Erreur lors de l'annonce de rang de progression: {e}")


async def send_rank_up_message(member, rank_change_data, pokemon_name, points, language="fr"):
    """Envoie un message de félicitations pour une montée de rang"""
    try:
        guild = bot.get_guild(GUILD_ID)
        if not guild:
            return
        
        # Utiliser le salon de classement ou un salon général
        channel = bot.get_channel(SALON_CLASSEMENT_ID)
        if not channel:
            # Essayer de trouver un salon général
            for ch in guild.text_channels:
                if 'general' in ch.name.lower() or 'shiny' in ch.name.lower():
                    channel = ch
                    break
        
        if not channel:
            return
        
        changes = rank_change_data['changes']
        old_rank = rank_change_data['old_rank']
        new_rank = rank_change_data['new_rank']
        old_tier = rank_change_data['old_tier']
        new_tier = rank_change_data['new_tier']
        
        # Déterminer le type de message
        if "first" in changes:
            title = "🏆 NOUVELLE PREMIÈRE PLACE ! 🏆" if language == "fr" else "🏆 NEW FIRST PLACE ! 🏆"
            description = f"{member.mention} vient de prendre la **1ère place** du classement !"
            color = discord.Color.gold()
            emoji = "🥇"
        elif "second" in changes:
            title = "🥈 2ème place ! 🥈" if language == "fr" else "🥈 2nd Place ! 🥈"
            description = f"{member.mention} vient de passer à la **2ème place** !"
            color = discord.Color.light_grey()
            emoji = "🥈"
        elif "third" in changes:
            title = "🥉 3ème place ! 🥉" if language == "fr" else "🥉 3rd Place ! 🥉"
            description = f"{member.mention} vient de passer à la **3ème place** !"
            color = discord.Color.from_rgb(205, 127, 50)
            emoji = "🥉"
        elif "top3" in changes:
            title = "🔥 ENTREE DANS LE TOP 3 ! 🔥" if language == "fr" else "🔥 TOP 3 ENTRY ! 🔥"
            description = f"{member.mention} vient d'entrer dans le **Top 3** du classement !"
            color = discord.Color.gold()
            emoji = "🔥"
        elif "tier_change" in changes:
            tier_names = {
                "master":   ("💜 Shiny Master",       "Shiny Master"),
                "diamant":  ("💎 Shiny de Diamant",   "Shiny Diamond"),
                "emeraude": ("💚 Shiny d'Émeraude",  "Shiny Emerald"),
                "platine":  ("🏆 Shiny de Platine",   "Shiny Platinum"),
                "or":       ("✨ Shiny d'Or",         "Shiny Gold"),
                "argent":   ("🌠 Shiny d'Argent",    "Shiny Silver"),
            }
            new_tier_name = tier_names.get(new_tier, ("🌟 Nouveau tier", "🌟 New tier"))
            tier_display = new_tier_name[0] if language == "fr" else new_tier_name[1]
            title = f"⭐ NOUVEAU TIER : {tier_display} ⭐" if language == "fr" else f"⭐ NEW TIER : {tier_display} ⭐"
            description = f"{member.mention} vient d'atteindre le tier **{tier_display}** !"
            color = discord.Color.purple()
            emoji = "⭐"
        elif "significant_climb" in changes:
            places_gained = old_rank - new_rank
            title = f"📈 Montée impressionnante ! 📈" if language == "fr" else f"📈 Impressive Climb ! 📈"
            description = f"{member.mention} vient de monter de **{places_gained} places** !"
            color = discord.Color.green()
            emoji = "📈"
        else:
            # Montée normale
            places_gained = old_rank - new_rank
            title = f"⬆️ Montée de rang ! ⬆️" if language == "fr" else f"⬆️ Rank Up ! ⬆️"
            description = f"{member.mention} vient de monter de **{places_gained} place{'s' if places_gained > 1 else ''}** !"
            color = discord.Color.blue()
            emoji = "⬆️"
        
        embed = discord.Embed(
            title=title,
            description=description,
            color=color,
            timestamp=datetime.now()
        )
        
        embed.set_author(name=member.display_name, icon_url=member.display_avatar.url)
        embed.set_thumbnail(url=member.display_avatar.url)
        
        # Informations sur le changement
        rank_field = "Rang" if language == "fr" else "Rank"
        points_field = "Points" if language == "fr" else "Points"
        shiny_field = "Shiny ajouté" if language == "fr" else "Shiny added"
        
        embed.add_field(
            name=f"{emoji} Changement de {rank_field.lower()}",
            value=f"**#{old_rank}** → **#{new_rank}**\n"
                  f"{points_field}: **{int(rank_change_data['old_points'])}** → **{int(rank_change_data['new_points'])}** ⭐",
            inline=True
        )
        
        embed.add_field(
            name=f"✨ {shiny_field}",
            value=f"**{pokemon_name}** (+{points} pts)",
            inline=True
        )
        
        # Nouveau titre de rang
        new_rank_title = get_rank_title_for_position(new_rank)
        embed.add_field(
            name="🏅 Nouveau rang" if language == "fr" else "🏅 New rank",
            value=new_rank_title,
            inline=False
        )
        
        embed.set_footer(text="ShinyBot - Félicitations !" if language == "fr" else "ShinyBot - Congratulations!")
        
        await channel.send(embed=embed)
        logger.info(f"Message de montée de rang envoyé pour {member.display_name} (rang {old_rank} → {new_rank})")
        
    except Exception as e:
        logger.error(f"Erreur lors de l'envoi du message de montée de rang: {e}")

def get_method_emoji(methode):
    """Retourne un emoji selon la méthode"""
    if "Full Odds" in methode:
        return "🔥"
    elif "Masuda" in methode:
        return "🥚"
    elif "Charme Chroma" in methode or "Shiny Charm" in methode:
        return "✨"
    elif "Hordes" in methode:
        return "👥"
    elif "Légendes Arceus" in methode or "Legends Arceus" in methode:
        return "🏔️"
    elif "Violet" in methode or "Écarlate" in methode or "Scarlet" in methode:
        return "🍃"
    else:
        return "⭐"

def get_rarity_color(points):
    """Retourne une couleur selon la rareté du shiny"""
    if points >= 25:
        return discord.Color.red()  # Légendaire
    elif points >= 10:
        return discord.Color.purple()  # Épique
    elif points >= 5:
        return discord.Color.blue()  # Rare
    elif points >= 2:
        return discord.Color.green()  # Peu commun
    else:
        return discord.Color.light_grey()  # Commun

