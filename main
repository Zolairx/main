                f"👤 **{challenger_name}** vs **{opponent_name}**\n"
                f"🎯 **Cible:** {pokemon_name}\n"
                f"🎮 **Jeu:** {game}\n"
                f"💰 **Bonus:** +{bonus_points} pts\n"
                f"🕒 **Créée le:** {created_str}"
            )
            embed.add_field(name=f"ID Race #{race_id}", value=value, inline=False)

        embed.set_footer(text="ID de race à utiliser pour /race_cancel (admin).")
        await interaction.followup.send(embed=embed, ephemeral=True)
        return True

    result = await discord_retry_wrapper(_show_list, context="Race List Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

@bot.tree.command(
    name="race_cancel",
    description="[ADMIN] Annuler une race shiny active",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    race_id="ID de la race à annuler (voir /race_list)"
)
async def race_cancel(interaction: discord.Interaction, race_id: int):
    async def _cancel(**kwargs):
        await interaction.response.defer(ephemeral=True)

        if not interaction.user.guild_permissions.administrator:
            await interaction.followup.send("❌ Vous devez être administrateur pour utiliser cette commande.", ephemeral=True)
            return None

        cursor.execute("""
            SELECT status FROM shiny_races WHERE id = ?
        """, (race_id,))
        row = cursor.fetchone()
        if not row:
            await interaction.followup.send("❌ Race introuvable.", ephemeral=True)
            return None

        status = row[0]
        if status != "active":
            await interaction.followup.send("⚠️ Cette race n'est pas active (déjà terminée ou annulée).", ephemeral=True)
            return None

        cursor.execute("""
            UPDATE shiny_races
            SET status = 'cancelled', ended_at = datetime('now')
            WHERE id = ?
        """, (race_id,))
        conn.commit()

        await interaction.followup.send(f"✅ La race #{race_id} a été annulée.", ephemeral=True)
        return True

    result = await discord_retry_wrapper(_cancel, context="Race Cancel Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

@bot.tree.command(
    name="reset_saison",
    description="Réinitialiser tous les points shiny et archiver la saison (Admin uniquement).",
    guild=discord.Object(id=GUILD_ID)
)
async def reset_saison(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.send_modal(ResetSaisonModal())


class ResetSaisonModal(discord.ui.Modal):
    def __init__(self):
        super().__init__(title="Confirmer le reset de saison")
        self.nom_saison_input = discord.ui.TextInput(
            label="Nom de la saison à archiver",
            placeholder="Ex: Saison 5  (laisser vide = numéro auto)",
            required=False,
            max_length=50
        )
        self.confirmation_input = discord.ui.TextInput(
            label="Tapez CONFIRMER pour valider",
            placeholder="CONFIRMER",
            required=True,
            max_length=10
        )
        self.add_item(self.nom_saison_input)
        self.add_item(self.confirmation_input)

    async def on_submit(self, interaction: discord.Interaction):
        if self.confirmation_input.value.strip().upper() != "CONFIRMER":
            await interaction.response.send_message(
                "❌ Reset annulé — tapez exactement **CONFIRMER** pour valider.",
                ephemeral=True
            )
            return

        await interaction.response.defer(ephemeral=True)
        nom_saison = self.nom_saison_input.value.strip() or None

        cursor.execute("SELECT COALESCE(MAX(season_number), 0) FROM season_meta")
        last_season = cursor.fetchone()[0]
        new_season_num = last_season + 1
        season_label = nom_saison if nom_saison else f"Saison {new_season_num}"

        ladder = get_ladder()
        total_players = len(ladder)

        cursor.execute("""
            INSERT INTO season_meta (season_number, season_name, ended_at, total_players)
            VALUES (?, ?, datetime('now'), ?)
        """, (new_season_num, season_label, total_players))

        for rank, (user_id, total_points, wanted_count, race_wins) in enumerate(ladder, 1):
            cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id = ?", (user_id,))
            total_shinys = cursor.fetchone()[0]
            cursor.execute("""
                INSERT INTO season_archives (season_number, season_name, user_id, rank, total_points, total_shinys, wanted_count, race_wins)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (new_season_num, season_label, user_id, rank, total_points or 0, total_shinys, int(wanted_count or 0), int(race_wins or 0)))

        # Attribuer badges de fin de saison
        try:
            for rank, (user_id, total_points, wanted_count, race_wins) in enumerate(ladder, 1):
                check_and_award_badges(user_id)
        except Exception as e:
            logger.error(f"Erreur badge saison: {e}")

        # Appliquer la formule de compression √(pts)×20 pour la nouvelle saison
        import math as _math
        carry_over_entries = []
        for rank, (user_id, total_points, wanted_count, race_wins) in enumerate(ladder, 1):
            if total_points and total_points > 0:
                new_pts = int(_math.sqrt(total_points) * 20)
                if new_pts > 0:
                    carry_over_entries.append((user_id, new_pts))

        cursor.execute("DELETE FROM shiny")
        cursor.execute("DELETE FROM user_streaks")
        cursor.execute("DELETE FROM shiny_wanted_claimed")
        cursor.execute("DELETE FROM weekly_objectives_progress")
        cursor.execute("DELETE FROM monthly_objectives_progress")
        cursor.execute("DELETE FROM weekly_points_tracking")

        # Ré-insérer les points compressés
        date_now = datetime.now().strftime("%d-%m-%Y")
        for uid, new_pts in carry_over_entries:
            cursor.execute("""
                INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                VALUES (?, ?, ?, ?, ?, ?, datetime('now'), 'fr')
            """, (uid, f'[Report Saison {new_season_num}]', '', 'season_carryover', date_now, new_pts))
        conn.commit()

        embed = discord.Embed(
            title=f"🏆 {season_label} archivée !",
            description=(
                f"**{total_players}** joueur{'s' if total_players > 1 else ''} archivé{'s' if total_players > 1 else ''}. "
                f"Les points ont été compressés avec la formule **√(pts)×20** pour resserrer le classement."
            ),
            color=discord.Color.gold()
        )
        embed.add_field(name="📋 Saison", value=f"**{season_label}** (#{new_season_num})", inline=True)
        embed.add_field(name="👥 Joueurs archivés", value=str(total_players), inline=True)
        if ladder:
            winner_id = ladder[0][0]
            guild = bot.get_guild(GUILD_ID)
            winner = guild.get_member(int(winner_id)) if guild else None
            winner_name = winner.display_name if winner else winner_id
            winner_pts = ladder[0][1]
            embed.add_field(name="🥇 Champion", value=f"**{winner_name}** avec **{int(winner_pts)} pts**", inline=False)
        embed.set_footer(text="ShinyBot • /mon_historique pour voir vos saisons passées")
        await interaction.followup.send(embed=embed)

        async def delayed_update():
            await asyncio.sleep(2)
            await update_classement_message()
        asyncio.create_task(delayed_update())

@bot.tree.command(
    name="mon_historique",
    description="Voir votre historique de saisons shiny",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    membre="Membre dont vous voulez voir l'historique (optionnel, par défaut vous)"
)
async def mon_historique(interaction: discord.Interaction, membre: discord.Member = None):
    await interaction.response.defer(ephemeral=True)

    target = membre if membre else interaction.user
    user_id = str(target.id)

    cursor.execute("""
        SELECT sa.season_number, sa.season_name, sa.rank, sa.total_points,
               sa.total_shinys, sa.wanted_count, sa.race_wins,
               sm.total_players, sa.archived_at
        FROM season_archives sa
        JOIN season_meta sm ON sa.season_number = sm.season_number
        WHERE sa.user_id = ?
        ORDER BY sa.season_number DESC
    """, (user_id,))
    rows = cursor.fetchall()

    if not rows:
        msg = f"Aucun historique de saison trouvé pour **{target.display_name}**."
        if target.id == interaction.user.id:
            msg += "\nVotre premier historique apparaîtra après le prochain `/reset_saison`."
        await interaction.followup.send(msg, ephemeral=True)
        return

    embed = discord.Embed(
        title=f"📜 Historique de {target.display_name}",
        color=discord.Color.gold(),
        timestamp=datetime.now()
    )
    embed.set_thumbnail(url=target.display_avatar.url)

    def rank_medal(r):
        if r == 1: return "🥇"
        if r == 2: return "🥈"
        if r == 3: return "🥉"
        if r <= 8: return "💜"
        if r <= 14: return "💎"
        if r <= 23: return "🏆"
        if r <= 32: return "✨"
        if r <= 43: return "🌠"
        return "🌟"

    best_rank = min(r[2] for r in rows)
    total_seasons = len(rows)

    embed.add_field(
        name="📊 Résumé",
        value=f"**Saisons jouées :** {total_seasons}\n**Meilleur rang :** {rank_medal(best_rank)} #{best_rank}",
        inline=False
    )

    for row in rows[:10]:  # Max 10 saisons affichées
        season_num, season_name, rank, pts, shinys, wanted, race_wins, total_players, archived_at = row
        pts_str = f"{pts:.1f}" if pts % 1 != 0 else f"{int(pts)}"
        date_str = archived_at[:10] if archived_at else "?"
        medal = rank_medal(rank)

        value = (
            f"{medal} **#{rank}** / {total_players} joueurs\n"
            f"⭐ **{pts_str} pts** | ✨ {shinys} shinys\n"
            f"🎯 {wanted} wanted | 🏁 {race_wins} races gagnées"
        )
        embed.add_field(
            name=f"🗓️ {season_name} — {date_str}",
            value=value,
            inline=False
        )

    if len(rows) > 10:
        embed.set_footer(text=f"Affichage des 10 dernières saisons sur {total_seasons} • ShinyBot")
    else:
        embed.set_footer(text="ShinyBot • Historique complet")

    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="admin_historique_saisons",
    description="[ADMIN] Voir l'historique de toutes les saisons",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    saison="Numéro de saison à afficher (laisser vide pour la liste de toutes les saisons)"
)
async def admin_historique_saisons(interaction: discord.Interaction, saison: int = None):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)

    if saison is None:
        # Liste de toutes les saisons
        cursor.execute("""
            SELECT season_number, season_name, total_players, ended_at
            FROM season_meta ORDER BY season_number DESC
        """)
        rows = cursor.fetchall()
        if not rows:
            await interaction.followup.send("Aucune saison archivée pour le moment.", ephemeral=True)
            return

        embed = discord.Embed(
            title="📋 Toutes les Saisons Archivées",
            color=discord.Color.blue()
        )
        for row in rows:
            num, name, players, ended = row
            date_str = ended[:10] if ended else "?"
            embed.add_field(
                name=f"#{num} — {name}",
                value=f"👥 {players} joueurs | 📅 Terminée le {date_str}\nUtilisez `/admin_historique_saisons saison:{num}` pour le détail",
                inline=False
            )
        embed.set_footer(text="ShinyBot • Historique Admin")
        await interaction.followup.send(embed=embed, ephemeral=True)

    else:
        # Détail d'une saison
        cursor.execute("SELECT season_name, total_players, ended_at FROM season_meta WHERE season_number=?", (saison,))
        meta = cursor.fetchone()
        if not meta:
            await interaction.followup.send(f"❌ Saison #{saison} introuvable.", ephemeral=True)
            return

        season_name, total_players, ended_at = meta
        cursor.execute("""
            SELECT user_id, rank, total_points, total_shinys, wanted_count, race_wins
            FROM season_archives WHERE season_number=?
            ORDER BY rank ASC
        """, (saison,))
        players = cursor.fetchall()

        guild = bot.get_guild(GUILD_ID)
        def display(uid):
            m = guild.get_member(int(uid)) if guild else None
            return m.display_name if m else f"<@{uid}>"

        embed = discord.Embed(
            title=f"🏆 {season_name} — Classement complet",
            description=f"📅 Terminée le {ended_at[:10] if ended_at else '?'} | 👥 {total_players} joueurs",
            color=discord.Color.gold()
        )

        medals = {1:"🥇",2:"🥈",3:"🥉"}
        lines = []
        for uid, rank, pts, shinys, wanted, races in players[:25]:
            pts_str = f"{pts:.1f}" if pts % 1 != 0 else f"{int(pts)}"
            medal = medals.get(rank, f"#{rank}")
            lines.append(f"{medal} **{display(uid)}** — {pts_str} pts | {shinys} shinys | {wanted} wanted | {races} races")

        if lines:
            # Découper si trop long
            chunk = ""
            field_count = 0
            for line in lines:
                if len(chunk) + len(line) > 1000:
                    embed.add_field(name=f"Classement ({field_count*10+1}-{field_count*10+10})" if field_count else "Classement", value=chunk, inline=False)
                    chunk = line + "\n"
                    field_count += 1
                else:
                    chunk += line + "\n"
            if chunk:
                embed.add_field(name="Classement" if not field_count else f"Suite", value=chunk, inline=False)

        if total_players > 25:
            embed.set_footer(text=f"Affichage des 25 premiers sur {total_players} • ShinyBot")
        else:
            embed.set_footer(text="ShinyBot • Historique Admin")

        await interaction.followup.send(embed=embed, ephemeral=True)

@bot.tree.command(
    name="streaks",
    description="Afficher les streaks et compteurs de shinys",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    member="Membre dont vous voulez voir les streaks (optionnel, par défaut vous)"
)
async def streaks(interaction: discord.Interaction, member: discord.Member = None):
    async def _show_streaks(**kwargs):
        await interaction.response.defer(ephemeral=True)
        
        target_member = member if member else interaction.user
        user_id = str(target_member.id)
        
        stats = get_user_stats(user_id)
        rank, total_points = get_user_rank(user_id)
        
        # Créer l'embed
        color = discord.Color.gold() if stats['current_streak'] > 0 else discord.Color.light_grey()
        
        embed = discord.Embed(
            title=f"⚡ Streaks & Compteurs de {target_member.display_name}",
            color=color,
            timestamp=datetime.now()
        )
        embed.set_author(name=target_member.display_name, icon_url=target_member.display_avatar.url)
        embed.set_thumbnail(url=target_member.display_avatar.url)
        
        # Section Streaks
        streak_emoji = "🔥" if stats['current_streak'] > 0 else "💤"
        streak_status = "🔥 EN FEU !" if stats['current_streak'] >= 7 else ("⚡ Actif" if stats['current_streak'] > 0 else "💤 Inactif")
        
        embed.add_field(
            name=f"⚡ Streak Actuel - {streak_status}",
            value=f"{streak_emoji} **{stats['current_streak']}** jour{'s' if stats['current_streak'] > 1 else ''} consécutif{'s' if stats['current_streak'] > 1 else ''}\n"
                  f"🏆 **Meilleur streak:** {stats['best_streak']} jour{'s' if stats['best_streak'] > 1 else ''}\n"
                  f"📆 **Total jours avec shiny:** {stats['total_days_with_shiny']}",
            inline=False
        )
        
        # Section Compteurs
        embed.add_field(
            name="📅 Compteurs par Période",
            value=f"**📆 Aujourd'hui:** {stats['today_count']} shiny{'s' if stats['today_count'] > 1 else ''}\n"
                  f"**📊 Cette semaine:** {stats['week_count']} shiny{'s' if stats['week_count'] > 1 else ''}\n"
                  f"**📈 Ce mois:** {stats['month_count']} shiny{'s' if stats['month_count'] > 1 else ''}",
            inline=True
        )
        
        # Section Statistiques générales
        rank_title = get_rank_title(rank) if rank else "Non classé"
        points_display = f"{total_points:.1f}" if total_points % 1 != 0 else f"{int(total_points)}"
        embed.add_field(
            name="📊 Statistiques Générales",
            value=f"**Rang:** #{rank if rank else 'N/A'} - {rank_title}\n"
                  f"**Points totaux:** {points_display} ⭐\n"
                  f"**Total Shinys:** {stats['total_shinys']}",
            inline=True
        )
        
        # Message de motivation
        if stats['current_streak'] >= 30:
            motivation = "🌟 LÉGENDAIRE ! Votre streak est impressionnant !"
        elif stats['current_streak'] >= 14:
            motivation = "🔥 Incroyable ! Vous êtes dans la zone !"
        elif stats['current_streak'] >= 7:
            motivation = "⚡ Excellent ! Continuez comme ça !"
        elif stats['current_streak'] > 0:
            motivation = "💪 Bon début ! Gardez le rythme !"
        else:
            motivation = "💤 Pas de streak actif. Ajoutez un shiny aujourd'hui pour commencer !"
        
        embed.add_field(
            name="💬 Message",
            value=motivation,
            inline=False
        )
        
        embed.set_footer(text="ShinyBot - Gardez votre streak actif chaque jour !")
        
        await interaction.followup.send(embed=embed, ephemeral=True)
        return True
    
    result = await discord_retry_wrapper(_show_streaks, context="Streaks Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

