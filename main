PERSONAL_WANTED_BONUS    = 10.0   # Points bonus si trouvé dans les délais
PERSONAL_WANTED_DURATION = 7      # Jours pour trouver le Pokémon


def get_active_personal_wanted(user_id):
    """Retourne le wanted personnel actif (non expiré, non réclamé) ou None."""
    now_local = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    cursor.execute("""
        SELECT id, pokemon, generation, bonus_pts, expires_at
        FROM personal_wanted
        WHERE user_id=? AND claimed=0 AND datetime(expires_at) > datetime(?)
        ORDER BY created_at DESC LIMIT 1
    """, (str(user_id), now_local))
    return cursor.fetchone()


def check_personal_wanted(user_id, pokemon_name):
    """Vérifie si le shiny ajouté correspond au wanted personnel actif.
    Retourne (bonus_pts, description) si match, sinon (0, None)."""
    row = get_active_personal_wanted(user_id)
    if not row:
        return 0, None
    wanted_id, wanted_pokemon, gen, bonus_pts, expires_at = row
    if normalize_str(pokemon_name) != normalize_str(wanted_pokemon):
        return 0, None
    # Marquer comme réclamé
    cursor.execute("""
        UPDATE personal_wanted SET claimed=1, claimed_at=datetime('now')
        WHERE id=?
    """, (wanted_id,))
    effective_pts = award_capped_bonus(
        user_id, f"[🎯 Wanted Perso: {wanted_pokemon}]", 'wanted_bonus', bonus_pts
    )
    conn.commit()
    return effective_pts, f"🎯 Wanted personnel trouvé : **{wanted_pokemon}** (Gen {gen}) !"


def get_last_classement_message_id(channel_id):
    """Récupère l'ID du dernier message de classement"""
    cursor.execute("SELECT message_id FROM classement_message WHERE channel_id = ?", (str(channel_id),))
    result = cursor.fetchone()
    return result[0] if result else None

def set_last_classement_message_id(channel_id, message_id):
    """Stocke l'ID du dernier message de classement"""
    cursor.execute("REPLACE INTO classement_message (channel_id, message_id) VALUES (?, ?)", (str(channel_id), str(message_id)))
    conn.commit()

