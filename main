    """Conservé pour rétrocompatibilité — n'est plus utilisé."""
    pass

def is_new_player(user_id):
    """Vérifie si c'est le tout premier vrai shiny de ce joueur.
    Le shiny courant vient d'être inséré → COUNT == 1 signifie premier shiny."""
    cursor.execute("""
        SELECT COUNT(*) FROM shiny WHERE user_id=?
        AND methode NOT IN ('participation_bonus','weekly_objective','monthly_objective',
                            'race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
                            'admin_adjustment','bounty_bonus','season_carryover',
                            'monday_first_bonus','new_player_bonus','guilde_objective_bonus',
                            'challenge_bonus','type_challenge_bonus','wanted_bonus')
    """, (str(user_id),))
    count = cursor.fetchone()[0] or 0
    # count == 1 : le shiny qui vient d'être inséré est le seul → c'est le 1er vrai shiny
    return count == 1

def award_new_player_bonus(user_id):
    """Attribue le bonus nouveau joueur (+25 pts, réduit par le cap bonus si déjà atteint) — idempotent.
    Retourne le montant effectif crédité (float), ou None si déjà attribué."""
    # Vérifier que le bonus n'a pas déjà été attribué
    cursor.execute(
        "SELECT 1 FROM shiny WHERE user_id=? AND methode='new_player_bonus'",
        (str(user_id),)
    )
    if cursor.fetchone():
        return None  # Déjà attribué
    effective = award_capped_bonus(user_id, '[🎉 Bienvenue !]', 'new_player_bonus', 25)
    conn.commit()
    return effective


PARRAINAGE_BONUS_POINTS = 15

def get_parrainage(filleul_id):
    """Retourne (filleul_id, parrain_id, created_at, bonus_awarded) ou None."""
    cursor.execute(
        "SELECT filleul_id, parrain_id, created_at, bonus_awarded FROM shinyhunter_parrainages WHERE filleul_id=?",
        (str(filleul_id),)
    )
    return cursor.fetchone()

def has_any_real_shiny(user_id):
    """True si ce joueur a déjà au moins un vrai shiny enregistré (hors bonus système)."""
    cursor.execute("""
        SELECT COUNT(*) FROM shiny WHERE user_id=?
        AND methode NOT IN ('participation_bonus','weekly_objective','monthly_objective',
                            'race_bonus','race_malus','race_team_bonus','race_team_malus','inactivity_decay','season_calibration',
                            'admin_adjustment','bounty_bonus','season_carryover',
                            'monday_first_bonus','new_player_bonus', 'parrainage_bonus','guilde_objective_bonus',
                            'challenge_bonus','type_challenge_bonus','wanted_bonus')
    """, (str(user_id),))
    return (cursor.fetchone()[0] or 0) > 0

def create_parrainage(parrain_id, filleul_id):
    """Enregistre un parrainage. Lève ValueError si impossible."""
    parrain_id, filleul_id = str(parrain_id), str(filleul_id)
    if parrain_id == filleul_id:
        raise ValueError("self")
    if get_parrainage(filleul_id):
        raise ValueError("already_sponsored")
    if has_any_real_shiny(filleul_id):
        raise ValueError("not_new")
    cursor.execute(
        "INSERT INTO shinyhunter_parrainages (filleul_id, parrain_id) VALUES (?, ?)",
        (filleul_id, parrain_id)
    )
    conn.commit()

def award_parrainage_bonus_if_due(filleul_id):
    """Si le filleul vient de logger son tout premier shiny, attribue le bonus
    de parrainage (réduit par le cap bonus si déjà atteint) au filleul et à
    son parrain (idempotent). Retourne (parrain_id, filleul_effectif, parrain_effectif)
    si le bonus vient d'être attribué, sinon None."""
    filleul_id = str(filleul_id)
    parrainage = get_parrainage(filleul_id)
    if not parrainage:
        return None
    _, parrain_id, _, bonus_awarded = parrainage
    if bonus_awarded:
        return None
    if not is_new_player(filleul_id):
        return None
    filleul_effective = award_capped_bonus(filleul_id, '[🤝 Bonus parrainage]', 'parrainage_bonus', PARRAINAGE_BONUS_POINTS)
    parrain_effective = award_capped_bonus(parrain_id, '[🤝 Bonus parrainage]', 'parrainage_bonus', PARRAINAGE_BONUS_POINTS)
    cursor.execute(
        "UPDATE shinyhunter_parrainages SET bonus_awarded=1 WHERE filleul_id=?",
        (filleul_id,)
    )
    conn.commit()
    return parrain_id, filleul_effective, parrain_effective


async def notify_parrain_bonus(parrain_id, filleul_member, pokemon_name, filleul_effective=None, parrain_effective=None):
    """Envoie un DM au parrain quand son filleul valide son premier shiny."""
    try:
        parrain_user = bot.get_user(int(parrain_id)) or await bot.fetch_user(int(parrain_id))
        if not parrain_user:
            return
        _p_eff = parrain_effective if parrain_effective is not None else PARRAINAGE_BONUS_POINTS
        _f_eff = filleul_effective if filleul_effective is not None else PARRAINAGE_BONUS_POINTS
        embed = discord.Embed(
            title="🤝 Ton filleul a trouvé son premier shiny !",
            description=(
                f"**{filleul_member.display_name if filleul_member else 'Ton filleul'}** vient de logger "
                f"son tout premier shiny (**{pokemon_name}**) !\n\n"
                f"Tu reçois **+{_p_eff:.2f} pts** et ton filleul **+{_f_eff:.2f} pts** de bonus parrainage. 🎉"
            ),
            color=discord.Color.gold()
        )
        await parrain_user.send(embed=embed)
    except Exception as e:
        logger.error(f"Erreur notify_parrain_bonus pour {parrain_id}: {e}")


async def launch_scheduled_wanted(row):
    """Lance un wanted programmé : l'insère en DB et envoie l'alerte."""
    import json as _j
    sid, scheduled_at, pname, bpts, decay, game, indice, paliers_json, unique_w, alternates, created_by, expires_at = row

    # Créer le wanted
    cursor.execute("""
        INSERT INTO shiny_wanted (pokemon_name, bonus_points, decay_percent, game, paliers_json, indice, is_active, updated_at, expires_at)
        VALUES (?, ?, ?, ?, ?, ?, 1, datetime('now'), ?)
    """, (pname, bpts, decay, game, paliers_json, indice, expires_at))
    conn.commit()
    wanted_id = cursor.lastrowid

    # Si unique : paliers p2/p3/suite = 0
    if unique_w and not paliers_json:
        paliers = {"p1": bpts, "p2": 0, "p3": 0, "suite": 0}
        paliers_json = _j.dumps(paliers)
        cursor.execute("UPDATE shiny_wanted SET paliers_json=? WHERE id=?", (paliers_json, wanted_id))

    # Alternates
    if alternates:
        cursor.execute("UPDATE shiny_wanted SET pokemon_alternates=? WHERE id=?", (alternates, wanted_id))

    conn.commit()

    # Marquer comme lancé
    cursor.execute("UPDATE scheduled_wanteds SET status='launched' WHERE id=?", (sid,))
    conn.commit()

    # Envoyer l'alerte
    try:
        channel = bot.get_channel(SALON_WANTED_ALERT_ID)
        if channel:
            embed = build_wanted_alert_embed(pname, bpts, game, indice, paliers_json, expires_at, wanted_id=wanted_id, alternates_json=alternates)
            await channel.send(embed=embed)
            logger.info(f"Wanted programmé lancé : {pname} (ID {wanted_id})")
    except Exception as e:
        logger.error(f"Erreur alerte wanted programmé {pname}: {e}")


async def auto_scheduled_wanteds():
    """Tâche de fond : vérifie et lance les wanteds programmés toutes les 30 secondes."""
    await bot.wait_until_ready()
    while not bot.is_closed():
        try:
            now_str = datetime.now().strftime("%Y-%m-%d %H:%M")
            cursor.execute("""
                SELECT id, scheduled_at, pokemon_name, bonus_points, decay_percent,
                       game, indice, paliers_json, unique_wanted, alternates, created_by, expires_at
                FROM scheduled_wanteds
                WHERE status='pending' AND scheduled_at <= ?
            """, (now_str,))
            rows = cursor.fetchall()
            for row in rows:
                await launch_scheduled_wanted(row)
        except Exception as e:
            logger.error(f"Erreur auto_scheduled_wanteds: {e}")
        await asyncio.sleep(30)


@bot.tree.command(
    name="admin_wanted_programmer",
    description="[ADMIN] Programmer le lancement d'un wanted à une date/heure précise",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    pokemon="Nom du Pokémon wanted",
    bonus_points="Points bonus pour le 1er trouveur",
    date_heure="Date et heure de lancement (format : JJ/MM/AAAA HH:MM — ex: 25/12/2025 20:00)",
    jeu="Jeu spécifique (optionnel)",
    indice="Indice (optionnel, met ??? dans l'alerte si défini)",
    unique="Bonus uniquement pour le 1er trouveur (défaut: False)",
    alternates="Pokémon alternatifs acceptés, séparés par virgules (optionnel)",
    date_fin="Date de fin programmée (optionnel, format JJ/MM/AAAA HH:MM, doit être après date_heure)"
)
async def admin_wanted_programmer(
    interaction: discord.Interaction,
    pokemon: str,
    bonus_points: float,
    date_heure: str,
    jeu: str = None,
    indice: str = None,
    unique: bool = False,
    alternates: str = None,
    date_fin: str = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    # Parser la date/heure de lancement
    try:
        dt = datetime.strptime(date_heure.strip(), "%d/%m/%Y %H:%M")
    except ValueError:
        await interaction.response.send_message(
            "❌ Format invalide. Utilisez **JJ/MM/AAAA HH:MM** — ex: `25/12/2025 20:00`",
            ephemeral=True
        )
        return

    if dt <= datetime.now():
        await interaction.response.send_message(
            "❌ La date doit être dans le futur !",
            ephemeral=True
        )
        return

    # Parser la date de fin (optionnelle) — doit être après la date de lancement
    expires_dt = None
    if date_fin and date_fin.strip():
        try:
            expires_dt = datetime.strptime(date_fin.strip(), "%d/%m/%Y %H:%M")
        except ValueError:
            await interaction.response.send_message(
                "❌ Format de date de fin invalide. Utilisez **JJ/MM/AAAA HH:MM**.",
                ephemeral=True
            )
            return
        if expires_dt <= dt:
            await interaction.response.send_message(
                "❌ La date de fin doit être **après** la date de lancement !",
                ephemeral=True
            )
            return

    import json as _j
    paliers_json = None
    if unique:
        paliers = {"p1": bonus_points, "p2": 0, "p3": 0, "suite": 0}
        paliers_json = _j.dumps(paliers)

    alts_json = None
    if alternates:
        alt_list = [p.strip() for p in alternates.replace(';', ',').split(',') if p.strip()]
        alts_json = _j.dumps(alt_list) if alt_list else None

    cursor.execute("""
        INSERT INTO scheduled_wanteds
        (scheduled_at, pokemon_name, bonus_points, decay_percent, game, indice, paliers_json, unique_wanted, alternates, created_by, expires_at)
        VALUES (?, ?, ?, 100.0, ?, ?, ?, ?, ?, ?, ?)
    """, (
        dt.strftime("%Y-%m-%d %H:%M"),
        pokemon, bonus_points, jeu, indice, paliers_json,
        1 if unique else 0,
        alts_json,
        str(interaction.user.id),
        expires_dt.strftime("%Y-%m-%d %H:%M") if expires_dt else None
    ))
    conn.commit()
    sched_id = cursor.lastrowid

    ts = int(dt.timestamp())
    unique_label = " | 🔒 Unique (1er seulement)" if unique else ""
    jeu_label = f" | 🎮 {jeu}" if jeu else ""
    alt_label = f"\n🔄 Alternates : {alternates}" if alternates else ""
    indice_label = f"\n🔍 Indice : {indice}" if indice else ""
    fin_label = f"\n📅 Fin programmée : <t:{int(expires_dt.timestamp())}:F>" if expires_dt else ""

    embed = discord.Embed(
        title="⏰ Wanted Programmé !",
        description=(
            f"Le wanted **{pokemon}** sera lancé automatiquement :\n"
            f"📅 <t:{ts}:F> (<t:{ts}:R>)\n\n"
            f"⭐ Bonus : **+{bonus_points} pts**{unique_label}{jeu_label}"
            f"{indice_label}{alt_label}"
        ),
        color=discord.Color.orange(),
        timestamp=datetime.now()
    )
    embed.set_footer(text=f"ShinyBot · Wanted Programmé #{sched_id} — Utilisez /admin_wanted_programmes pour voir la liste")
    await interaction.response.send_message(embed=embed, ephemeral=True)

@admin_wanted_programmer.autocomplete("pokemon")
async def admin_wanted_programmer_autocomplete(interaction: discord.Interaction, current: str):
    return await pokemon_autocomplete(interaction, current)


@bot.tree.command(
    name="admin_wanted_programmes",
    description="[ADMIN] Voir et gérer les wanteds programmés",
    guild=discord.Object(id=GUILD_ID)
)
async def admin_wanted_programmes(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)

    cursor.execute("""
        SELECT id, scheduled_at, pokemon_name, bonus_points, game, unique_wanted, status
        FROM scheduled_wanteds
        ORDER BY scheduled_at ASC
        LIMIT 20
    """)
    rows = cursor.fetchall()

    if not rows:
        await interaction.followup.send("Aucun wanted programmé.", ephemeral=True)
        return

    embed = discord.Embed(
        title="⏰ Wanteds Programmés",
        color=discord.Color.orange(),
        timestamp=datetime.now()
    )

    for sid, scheduled_at, pname, bpts, game, unique_w, status in rows:
        try:
            dt = datetime.strptime(scheduled_at, "%Y-%m-%d %H:%M")
            ts = int(dt.timestamp())
            time_str = f"<t:{ts}:F> (<t:{ts}:R>)"
        except Exception:
            time_str = scheduled_at

        status_emoji = {"pending": "⏳", "launched": "✅", "cancelled": "❌"}.get(status, "❓")
        jeu_str = f" | {game}" if game else ""
        unique_str = " | 🔒 Unique" if unique_w else ""
        embed.add_field(
            name=f"{status_emoji} #{sid} — **{pname}**",
            value=f"{time_str}\n⭐ +{bpts} pts{jeu_str}{unique_str}",
            inline=False
        )

    embed.set_footer(text="Utilisez /admin_wanted_annuler_programme pour annuler un wanted en attente")
    await interaction.followup.send(embed=embed, ephemeral=True)


@bot.tree.command(
    name="admin_wanted_annuler_programme",
    description="[ADMIN] Annuler un wanted programmé avant son lancement",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(programme_id="ID du wanted programmé (voir /admin_wanted_programmes)")
async def admin_wanted_annuler_programme(interaction: discord.Interaction, programme_id: int):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    cursor.execute("SELECT pokemon_name, status FROM scheduled_wanteds WHERE id=?", (programme_id,))
    row = cursor.fetchone()
    if not row:
        await interaction.response.send_message(f"❌ Wanted programmé #{programme_id} introuvable.", ephemeral=True)
        return
    pname, status = row
    if status != "pending":
        await interaction.response.send_message(
            f"❌ Le wanted **{pname}** a déjà été **{status}** et ne peut plus être annulé.",
            ephemeral=True
        )
        return

    cursor.execute("UPDATE scheduled_wanteds SET status='cancelled' WHERE id=?", (programme_id,))
    conn.commit()
    await interaction.response.send_message(
        f"✅ Wanted programmé **{pname}** (#{programme_id}) annulé.",
        ephemeral=True
    )


@bot.tree.command(
    name="ranked_regles",
    description="Voir les règles du ranked shiny hunting",
    guild=discord.Object(id=GUILD_ID)
)
async def ranked_regles(interaction: discord.Interaction):
    user_id = str(interaction.user.id)
    weekly_pts = get_user_weekly_pts(user_id)
    pos_mult = get_position_multiplier(user_id)
    ladder = get_ladder()
    rank = next((i+1 for i, r in enumerate(ladder) if str(r[0]) == user_id), None)

    def _eff_pct(x):
        if x <= WEEKLY_CAP:
            return 100
        return round((_weekly_soft_cap(x + 10) - _weekly_soft_cap(x)) / 10 * 100)

    embed = discord.Embed(
        title="📘 Règles Ranked Shiny",
        color=discord.Color.blurple(),
        timestamp=datetime.now()
    )
    embed.add_field(
        name="🧮 Ce qui compte pour le cap 250",
