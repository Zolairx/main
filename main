@bot.tree.command(
    name="shiny_remove",
    description="Supprimer le dernier shiny ajouté par un membre (Admin uniquement).",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    member="Membre dont on veut annuler le dernier shiny"
)
async def shiny_remove(interaction: discord.Interaction, member: discord.Member):
    async def _remove_shiny(**kwargs):
        await interaction.response.defer(ephemeral=True)
        
        if not interaction.user.guild_permissions.administrator:
            await interaction.followup.send("❌ Vous devez être administrateur pour utiliser cette commande.", ephemeral=True)
            return None

        user_id = str(member.id)
        cursor.execute("SELECT rowid FROM shiny WHERE user_id = ? ORDER BY rowid DESC LIMIT 1", (user_id,))
        result = cursor.fetchone()
        if not result:
            await interaction.followup.send(f"⚠️ Aucun shiny trouvé pour {member.mention}.", ephemeral=True)
            return None

        rowid_to_delete = result[0]
        cursor.execute("DELETE FROM shiny WHERE rowid = ?", (rowid_to_delete,))
        conn.commit()
        
        await interaction.followup.send(f"✅ Le dernier shiny de {member.mention} a bien été supprimé.", ephemeral=True)
        
        # Programmer la mise à jour du classement avec un délai équilibré
        asyncio.create_task(asyncio.sleep(2))  # Réduit de 5s à 2s pour une meilleure expérience
        asyncio.create_task(update_classement_message())
        return True
    
    result = await discord_retry_wrapper(_remove_shiny, context="Shiny Remove Command")
    if result is None:
        try:
            await interaction.response.send_message(f"❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

