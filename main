POKEMON_TYPE_CHOICES = [
    "Acier", "Combat", "Dragon", "Eau", "Electrik", "Fée", "Feu", "Glace", "Insecte",
    "Normal", "Plante", "Poison", "Psy", "Roche", "Sol", "Spectre", "Ténèbres", "Vol"
]

@bot.tree.command(
    name="challenge_creer",
    description="[ADMIN] Créer un challenge mensuel par nombre de shinys d'un type",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    shiny_type="Type de shiny à compter",
    top_n="Nombre de joueurs récompensés en fin de mois",
    bonus_points="(Optionnel) Bonus uniforme par gagnant si bonus par rang non utilisés",
    bonus_top1="Bonus pour le 1er",
    bonus_top2="Bonus pour le 2e",
    bonus_top3="Bonus pour le 3e",
    bonus_autres="Bonus pour les rangs 4 à Top N",
    description="Description affichée aux joueurs",
    date_fin="Fin du challenge (format: JJ/MM/AAAA HH:MM)",
    salon_annonce="Salon où annoncer le nouveau challenge (sinon salon wanted)"
)
@app_commands.choices(
    shiny_type=[app_commands.Choice(name=t, value=t) for t in POKEMON_TYPE_CHOICES]
)
async def challenge_creer(
    interaction: discord.Interaction,
    shiny_type: str,
    top_n: app_commands.Range[int, 1, 50],
    bonus_points: app_commands.Range[float, 0, 10000] = 0,
    bonus_top1: app_commands.Range[float, 0, 10000] = 0,
    bonus_top2: app_commands.Range[float, 0, 10000] = 0,
    bonus_top3: app_commands.Range[float, 0, 10000] = 0,
    bonus_autres: app_commands.Range[float, 0, 10000] = 0,
    description: str = "",
    date_fin: str = None,
    salon_annonce: discord.TextChannel = None
):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    ends_at = None
    if date_fin:
        try:
            dt_fin = datetime.strptime(date_fin.strip(), "%d/%m/%Y %H:%M")
            if dt_fin <= datetime.now():
                await interaction.response.send_message("❌ La date de fin doit être dans le futur.", ephemeral=True)
                return
            ends_at = dt_fin.strftime("%Y-%m-%d %H:%M")
        except Exception:
            await interaction.response.send_message("❌ Format invalide pour `date_fin`. Utilisez `JJ/MM/AAAA HH:MM`.", ephemeral=True)
            return

    # Si des bonus par rang sont fournis, ils prennent priorité sur bonus_points.
    rank_bonus_sum = float(bonus_top1) + float(bonus_top2) + float(bonus_top3) + float(bonus_autres)
    if rank_bonus_sum > 0:
        b1, b2, b3, b_other = float(bonus_top1), float(bonus_top2), float(bonus_top3), float(bonus_autres)
    else:
        b1 = b2 = b3 = b_other = float(bonus_points)

    channel_id = salon_annonce.id if salon_annonce else SALON_WANTED_ALERT_ID
    now = datetime.now()
    challenge_id = create_monthly_type_challenge(
        now.month, now.year, shiny_type, int(top_n),
        float(bonus_points), b1, b2, b3, b_other,
        description, ends_at, channel_id, str(interaction.user.id)
    )

    fin_txt = date_fin if date_fin else "Non définie"
    await interaction.response.send_message(
        f"✅ Challenge type créé (ID **#{challenge_id}**)\n"
        f"• Période : **{now.strftime('%m/%Y')}**\n"
        f"• Type suivi : **{shiny_type}**\n"
        f"• Récompense : **Top {top_n}**\n"
        f"• Bonus : **Top1 +{b1:.2f} / Top2 +{b2:.2f} / Top3 +{b3:.2f} / autres +{b_other:.2f}**\n"
        f"• Fin : **{fin_txt}**"
    )
    # Mise à jour immédiate du salon classement challenge
    asyncio.create_task(update_challenge_status_message())

    # Annonce publique dans le salon demandé (ou salon wanted par défaut)
    try:
        channel = bot.get_channel(int(channel_id))
        if channel:
            ann_embed = discord.Embed(
                title="🎯 Nouveau Challenge Type",
                description=(
                    f"**Type ciblé : {shiny_type}**\n"
                    f"{description if description else '*Aucune description fournie.*'}\n\n"
                    f"🏆 Récompenses Top {top_n} :\n"
                    f"• Top 1 : **+{b1:.2f} pts**\n"
                    f"• Top 2 : **+{b2:.2f} pts**\n"
                    f"• Top 3 : **+{b3:.2f} pts**\n"
                    f"• Top 4+ : **+{b_other:.2f} pts**"
                ),
                color=discord.Color.purple(),
                timestamp=datetime.now(timezone.utc)
            )
            if ends_at:
                ts = int(datetime.strptime(ends_at, "%Y-%m-%d %H:%M").timestamp())
                ann_embed.add_field(name="⏰ Fin du challenge", value=f"<t:{ts}:F> (<t:{ts}:R>)", inline=False)
            ann_embed.set_footer(text="ShinyBot · Challenge mensuel par type")
            await channel.send(embed=ann_embed)
    except Exception as e:
        logger.error(f"Erreur annonce challenge type: {e}")

@bot.tree.command(
    name="challenge_classement",
    description="Voir le classement du challenge type actif",
    guild=discord.Object(id=GUILD_ID)
)
async def challenge_classement(interaction: discord.Interaction):
    challenge = get_active_monthly_type_challenge()
    if not challenge:
        await interaction.response.send_message("⚠️ Aucun challenge type actif.", ephemeral=True)
        return

    challenge_id = challenge[0]
    info, scores = get_type_challenge_leaderboard(challenge_id)
    if not info:
        await interaction.response.send_message("⚠️ Impossible de charger le classement.", ephemeral=True)
        return

    month, year, shiny_type, top_n = info[0], info[1], info[2], info[3]
    bonus_points, bonus_top1, bonus_top2, bonus_top3, bonus_other = info[4], info[5], info[6], info[7], info[8]
    challenge_desc, ends_at = info[9], info[10]
    guild = bot.get_guild(GUILD_ID)
    embed = discord.Embed(
        title="🏅 Classement Challenge Type",
        description=(
            f"Type : **{shiny_type}** | Période : **{month:02d}/{year}** | "
            f"Récompense : **Top {top_n}**"
        ),
        color=discord.Color.blue(),
        timestamp=datetime.now(timezone.utc)
    )
    if challenge_desc:
        embed.add_field(name="📝 Description", value=challenge_desc, inline=False)
    embed.add_field(
        name="🎁 Bonus par rang",
        value=(
            f"Top1: **+{float(bonus_top1):.2f}** | Top2: **+{float(bonus_top2):.2f}** | "
            f"Top3: **+{float(bonus_top3):.2f}** | Top4+: **+{float(bonus_other):.2f}**"
        ),
        inline=False
    )
    if ends_at:
        try:
            ts = int(datetime.strptime(ends_at, "%Y-%m-%d %H:%M").timestamp())
            embed.add_field(name="⏰ Fin", value=f"<t:{ts}:F> (<t:{ts}:R>)", inline=False)
        except Exception:
            embed.add_field(name="⏰ Fin", value=ends_at, inline=False)

    if not scores:
        embed.add_field(name="Aucun score", value="Aucun shiny correspondant pour l'instant.", inline=False)
    else:
        for position, (user_id, total_shinys) in enumerate(scores, start=1):
            member = guild.get_member(int(user_id)) if guild else None
            player_name = member.display_name if member else f"Utilisateur {user_id}"
            badge = "🏆 " if position <= top_n else ""
            embed.add_field(
                name=f"{badge}#{position} - {player_name}",
                value=f"Shinys comptabilisés : **{total_shinys}**",
                inline=False
            )
    await interaction.response.send_message(embed=embed)

@bot.tree.command(
    name="challenge_modifier_score",
    description="[ADMIN] Modifier le total d'un participant sur le challenge type actif",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    member="Participant ciblé",
    nouveau_total="Nouveau total à afficher pour ce participant"
)
async def challenge_modifier_score(interaction: discord.Interaction, member: discord.Member, nouveau_total: app_commands.Range[int, 0, 999]):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    challenge = get_active_monthly_type_challenge()
    if not challenge:
        await interaction.response.send_message("⚠️ Aucun challenge type actif à modifier.", ephemeral=True)
        return

    challenge_id, month, year, shiny_type = challenge[0], challenge[1], challenge[2], challenge[3]
    base_count, adjustment = set_type_challenge_count(challenge_id, str(member.id), int(nouveau_total))
    await interaction.response.send_message(
        f"✅ Score mis à jour pour {member.mention}\n"
        f"Challenge : **{shiny_type} ({month:02d}/{year})**\n"
        f"Compteur réel : **{base_count}** | Ajustement : **{adjustment:+d}**\n"
        f"Total affiché : **{nouveau_total}**"
    )
    asyncio.create_task(update_challenge_status_message())

@bot.tree.command(
    name="challenge_cloturer",
    description="[ADMIN] Clôturer le challenge type actif et annoncer le top final",
    guild=discord.Object(id=GUILD_ID)
)
async def challenge_cloturer(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return

    challenge = get_active_monthly_type_challenge()
    if not challenge:
        await interaction.response.send_message("⚠️ Aucun challenge type actif à clôturer.", ephemeral=True)
        return

    challenge_id = challenge[0]
    info, scores = get_type_challenge_leaderboard(challenge_id)
    if not info:
        await interaction.response.send_message("⚠️ Impossible de clôturer ce challenge.", ephemeral=True)
        return

    month, year, shiny_type, top_n = info[0], info[1], info[2], info[3]
    bonus_top1, bonus_top2, bonus_top3, bonus_other = info[5], info[6], info[7], info[8]
    close_monthly_type_challenge(challenge_id)

    guild = bot.get_guild(GUILD_ID)
    embed = discord.Embed(
        title="🎉 Résultats finaux - Challenge Type",
        description=(
            f"Challenge clôturé : **{shiny_type} ({month:02d}/{year})**\n"
            f"Récompense : **Top {top_n}**"
        ),
        color=discord.Color.purple(),
        timestamp=datetime.now(timezone.utc)
    )

    if not scores:
        embed.add_field(name="Aucun participant", value="Aucun shiny de ce type n'a été comptabilisé.", inline=False)
    else:
        winners = scores[:top_n]
        for position, (user_id, total_shinys) in enumerate(winners, start=1):
            member = guild.get_member(int(user_id)) if guild else None
            player_name = member.mention if member else f"Utilisateur {user_id}"
            medal = "🥇" if position == 1 else ("🥈" if position == 2 else ("🥉" if position == 3 else "🏅"))
            rank_bonus = get_rank_bonus(position, bonus_top1, bonus_top2, bonus_top3, bonus_other)
            if rank_bonus > 0:
                cursor.execute(
                    """
                    INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language)
                    VALUES (?, ?, '', 'type_challenge_bonus', date('now'), ?, datetime('now'), 'fr')
                    """,
                    (str(user_id), f"[Bonus Challenge Type {month:02d}/{year} Top {position}]", float(rank_bonus))
                )

            embed.add_field(
                name=f"{medal} Top {position}",
                value=f"{player_name} — **{total_shinys}** shiny(s) | Bonus : **+{float(rank_bonus):.2f} pts**",
                inline=False
            )

    conn.commit()
    await interaction.response.send_message(embed=embed)
    # Mettre à jour le salon classement (affichera "aucun challenge actif")
    asyncio.create_task(update_challenge_status_message())

@bot.tree.command(
    name="wanted",
    description="Afficher le Pokémon Shiny Wanted actuel",
    guild=discord.Object(id=GUILD_ID)
)
async def wanted(interaction: discord.Interaction):
    async def _show_wanted(**kwargs):
        await interaction.response.defer(ephemeral=True)
        
        wanteds = get_active_wanteds()
        
        if not wanteds:
            embed = discord.Embed(
                title="🎯 Pokémon Shiny Wanted",
                description="Aucun Pokémon wanted n'est actuellement défini.",
                color=discord.Color.light_grey()
            )
            await interaction.followup.send(embed=embed, ephemeral=True)
            return True

        embed = discord.Embed(
            title="🎯 Pokémon Shiny Wanted Actuels",
            description="Voici les Pokémon actuellement recherchés :",
            color=discord.Color.gold()
        )

        for wanted_data in wanteds[:10]:
            # Compter combien de personnes ont déjà réclamé le bonus pour CE wanted
            cursor.execute("""
                SELECT COUNT(*) FROM shiny_wanted_claimed 
                WHERE wanted_id = ?
            """, (wanted_data['id'],))
            claimed_count = cursor.fetchone()[0] or 0

            import json
            paliers_json = wanted_data.get('paliers_json')
            game_restriction = wanted_data.get('game')

            # Déterminer l'affichage des points
            try:
                if paliers_json:
                    paliers = json.loads(paliers_json)
                    p1 = paliers.get('p1', wanted_data['bonus_points'])
                    p2 = paliers.get('p2', p1)
                    p3 = paliers.get('p3', p2)
                    p_suite = paliers.get('suite', p3)
                    points_display = (
                        f"🥇 1er : **+{p1} pts**\n"
                        f"🥈 2e : **+{p2} pts**\n"
                        f"🥉 3e : **+{p3} pts**\n"
                        f"👥 Suivants : **+{p_suite} pts**"
                    )
                else:
                    base = wanted_data['bonus_points']
                    decay = float(wanted_data.get('decay_percent', 100.0) or 100.0)
                    if decay < 100:
                        points_display = f"**+{base} pts** (dégressif {decay}% par joueur suivant)"
                    else:
                        points_display = f"**+{base} pts** (même bonus pour tous)"
            except Exception:
                points_display = f"**+{wanted_data['bonus_points']} pts**"

            if game_restriction and game_restriction.strip():
                game_info = f"• Jeu obligatoire : **{game_restriction}**"
            else:
                game_info = "• Jeu : **Libre**"

            indice = wanted_data.get('indice')
            is_admin = interaction.user.guild_permissions.administrator

            # Si un indice est défini → wanted mystère : masquer le nom pour les non-admins
            if indice and not is_admin:
                displayed_name = "???"
            else:
                displayed_name = wanted_data['pokemon_name']

            field_name = f"🎯 {displayed_name} (ID {wanted_data['id']})"
            if indice and is_admin:
                field_name += " 🔓"  # Indique à l'admin qu'il voit le vrai nom

            field_value = (
                f"💰 **Points par palier :**\n{points_display}\n"
                f"👥 **Déjà trouvé :** {claimed_count} personne{'s' if claimed_count > 1 else ''}\n"
                f"{game_info}"
            )
            if indice:
                field_value += f"\n🔍 **Indice :** {indice}"
            if indice and not is_admin:
                field_value += "\n🕵️ *Trouvez ce Pokémon mystère pour gagner les points !*"
            # Afficher les alternates
            import json as _ja
            alts_raw = wanted_data.get('pokemon_alternates') or wanted_data.get('pokemon_alternates')
            # Récupérer depuis la DB si non présent dans le dict
            cursor.execute("SELECT pokemon_alternates FROM shiny_wanted WHERE id=?", (wanted_data['id'],))
            _alt_db = cursor.fetchone()
            if _alt_db and _alt_db[0]:
                try:
                    _alt_names = _ja.loads(_alt_db[0])
                    if _alt_names:
                        _visible = [n if is_admin or not indice or indice.strip().startswith("[Méthode :") else "???" for n in _alt_names]
                        field_value += f"\n🔄 **Aussi accepté :** {', '.join(_visible)}"
                except Exception:
                    pass
            embed.add_field(name=field_name, value=field_value, inline=False)

        embed.set_footer(text="ShinyBot - Trouvez ces Pokémon pour obtenir des points bonus !")
        
        await interaction.followup.send(embed=embed, ephemeral=True)
        return True
    
    result = await discord_retry_wrapper(_show_wanted, context="Wanted Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

class WantedGameSelectView(discord.ui.View):
    """Vue pour sélectionner le jeu obligatoire d'un wanted (après le modal)"""
    def __init__(self, pokemon, p1, p2, p3, p_suite, indice=None):
        super().__init__(timeout=300)
        self.pokemon = pokemon
        self.p1 = p1
        self.p2 = p2
        self.p3 = p3
        self.p_suite = p_suite
        self.indice = indice

        # Bouton "Tous jeux" toujours visible en premier
        btn_all = discord.ui.Button(
            label="🌍 Tous jeux (pas de restriction)",
            style=discord.ButtonStyle.success
        )
        btn_all.callback = self._make_game_callback("__all__")
        self.add_item(btn_all)

        # Selects des jeux
        game_options = [
            discord.SelectOption(label=translations["fr"][:100], value=game_key)
            for game_key, translations in GAMES.items()
        ]

        if len(game_options) <= 24:  # 24 car le bouton prend une place dans la vue
            select = discord.ui.Select(
                placeholder="🎮 Ou choisir un jeu spécifique",
                options=game_options,
                min_values=1,
                max_values=1
            )
            select.callback = self.game_selected
            self.add_item(select)
        else:
            select1 = discord.ui.Select(
                placeholder="🎮 Jeux (1/2)",
                options=game_options[:25],
                min_values=1,
                max_values=1
            )
            select1.callback = self.game_selected
            self.add_item(select1)
            select2 = discord.ui.Select(
                placeholder="🎮 Jeux (2/2)",
                options=game_options[25:],
                min_values=1,
                max_values=1
            )
            select2.callback = self.game_selected
            self.add_item(select2)

    def _make_game_callback(self, value):
        async def callback(interaction: discord.Interaction):
            await self._finalize(interaction, value)
        return callback

    async def game_selected(self, interaction: discord.Interaction):
        await self._finalize(interaction, interaction.data['values'][0])

    async def _finalize(self, interaction: discord.Interaction, selected: str):
        game_value = None if selected == "__all__" else GAMES[selected]["fr"]

        import json
        paliers = {"p1": self.p1, "p2": self.p2, "p3": self.p3, "suite": self.p_suite}
        paliers_json = json.dumps(paliers)

        cursor.execute("""
            INSERT INTO shiny_wanted (pokemon_name, bonus_points, decay_percent, game, paliers_json, indice, is_active, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, 1, datetime('now'))
        """, (self.pokemon, self.p1, 100.0, game_value, paliers_json, self.indice))
        conn.commit()
        wanted_id = cursor.lastrowid

        embed = discord.Embed(
            title="✅ Pokémon Wanted Ajouté !",
            description=f"Le wanted **{self.pokemon}** est maintenant actif.",
            color=discord.Color.green()
        )
        embed.add_field(name="🎯 Pokémon", value=f"**{self.pokemon}**", inline=True)
        embed.add_field(name="🆔 ID", value=str(wanted_id), inline=True)
        embed.add_field(
            name="💰 Points par palier",
            value=f"🥇 1er : **+{self.p1} pts**\n🥈 2e : **+{self.p2} pts**\n🥉 3e : **+{self.p3} pts**\n👥 Suivants : **+{self.p_suite} pts**",
            inline=False
        )
        if game_value:
            embed.add_field(name="🎮 Jeu obligatoire", value=f"**{game_value}**", inline=False)
        else:
            embed.add_field(name="🎮 Jeu", value="Libre (tous jeux acceptés)", inline=False)
        if self.indice:
            embed.add_field(name="🔍 Indice", value=self.indice, inline=False)
        embed.set_footer(text="ShinyBot - Cliquez sur 'Ajouter des alternates' si le wanted accepte plusieurs Pokémon")
        view = WantedAlternatesView(wanted_id, self.pokemon)
        await interaction.response.edit_message(embed=embed, view=view)


class WantedAlternatesModal(discord.ui.Modal):
    """Modal pour ajouter des Pokémon alternatifs à un wanted existant."""
    def __init__(self, wanted_id, main_pokemon):
        super().__init__(title="Ajouter des Pokémon alternatifs")
        self.wanted_id = wanted_id
        self.main_pokemon = main_pokemon
        self.alternates_input = discord.ui.TextInput(
            label="Pokémon acceptés (séparés par virgules)",
            placeholder="Ex: Évoli, Salamèche, Carapuce",
            required=True,
            max_length=500
        )
        self.add_item(self.alternates_input)

    async def on_submit(self, interaction: discord.Interaction):
        import json as _j
        raw = self.alternates_input.value.strip()
        alternates = [p.strip() for p in raw.replace(';', ',').split(',') if p.strip()]
        # Retirer le pokémon principal si inclus par erreur
        alternates = [p for p in alternates if p.lower() != self.main_pokemon.lower()]

        if not alternates:
            await interaction.response.send_message("❌ Aucun Pokémon valide.", ephemeral=True)
            return

        cursor.execute(
            "UPDATE shiny_wanted SET pokemon_alternates=? WHERE id=?",
            (_j.dumps(alternates), self.wanted_id)
        )
        conn.commit()
        alt_str = ", ".join(f"**{p}**" for p in alternates)
        embed = discord.Embed(
            title="✅ Wanted mis à jour !",
            description=(
                f"Le wanted **{self.main_pokemon}** accepte maintenant aussi :\n{alt_str}\n\n"
                f"🎯 N'importe lequel de ces Pokémon déclenchera le bonus !"
            ),
            color=discord.Color.green()
        )
        await interaction.response.send_message(embed=embed, ephemeral=True)


class WantedAlternatesView(discord.ui.View):
    """Vue affichée après création d'un wanted — permet d'ajouter des alternates."""
    def __init__(self, wanted_id, main_pokemon):
        super().__init__(timeout=300)
        self.wanted_id = wanted_id
        self.main_pokemon = main_pokemon

        btn_add = discord.ui.Button(
            label="➕ Ajouter des Pokémon alternatifs",
            style=discord.ButtonStyle.primary
        )
        btn_add.callback = self._add_alternates
        self.add_item(btn_add)

        btn_skip = discord.ui.Button(
            label="✅ Terminer sans alternates",
            style=discord.ButtonStyle.secondary
        )
        btn_skip.callback = self._skip
        self.add_item(btn_skip)

    async def _add_alternates(self, interaction: discord.Interaction):
        modal = WantedAlternatesModal(self.wanted_id, self.main_pokemon)
        await interaction.response.send_modal(modal)

    async def _skip(self, interaction: discord.Interaction):
        for item in self.children:
            item.disabled = True
        await interaction.response.edit_message(
            content="✅ Wanted créé sans Pokémon alternatifs.",
            view=self
        )


class WantedSetupModal(discord.ui.Modal, title="Créer un Pokémon Wanted"):
    pokemon_name_input = discord.ui.TextInput(
        label="Nom du Pokémon",
        placeholder="Ex: Pikachu",
        required=True,
        max_length=50
    )
    points_1er = discord.ui.TextInput(
        label="Points pour le 1er",
        placeholder="Ex: 10",
        required=True,
        max_length=6
    )
    points_2e = discord.ui.TextInput(
        label="Points 2e (vide = même que 1er)",
        placeholder="Ex: 7",
        required=False,
        max_length=6
    )
    points_3e = discord.ui.TextInput(
        label="Points 3e (vide = même que 2e)",
        placeholder="Ex: 5",
        required=False,
        max_length=6
    )
    indice_input = discord.ui.TextInput(
        label="Indice (optionnel)",
        placeholder="Ex: C'est un Pokémon de type Feu de la Gen 1",
        required=False,
        max_length=200
    )

    async def on_submit(self, interaction: discord.Interaction):
        def parse_pts(val, fallback):
            if not val or not val.strip():
                return fallback
            try:
                return float(val.strip().replace(',', '.'))
            except ValueError:
                return None

        p1 = parse_pts(self.points_1er.value, None)
        if p1 is None or p1 <= 0:
            await interaction.response.send_message("❌ Points du 1er invalides ou nuls.", ephemeral=True)
            return

        p2 = parse_pts(self.points_2e.value, p1)
        p3 = parse_pts(self.points_3e.value, p2)
        p_suite = p3  # Points suivants = même que le 3e

        if None in (p2, p3, p_suite):
            await interaction.response.send_message("❌ Une valeur de points est invalide.", ephemeral=True)
            return

        indice = self.indice_input.value.strip() or None

        embed = discord.Embed(
            title="🎯 Wanted — Choisissez le jeu",
            description=f"Pokémon : **{self.pokemon_name_input.value}**\n\nSélectionnez le jeu obligatoire ci-dessous, ou **Tous jeux** pour aucune restriction :",
            color=discord.Color.orange()
        )
        embed.add_field(
            name="💰 Points configurés",
            value=f"🥇 1er : **+{p1} pts**\n🥈 2e : **+{p2} pts**\n🥉 3e : **+{p3} pts**\n👥 Suivants : **+{p_suite} pts**",
            inline=False
        )
        if indice:
            embed.add_field(name="🔍 Indice", value=indice, inline=False)
        view = WantedGameSelectView(self.pokemon_name_input.value, p1, p2, p3, p_suite, indice)
        await interaction.response.send_message(embed=embed, view=view, ephemeral=True)


@bot.tree.command(
    name="admin_set_wanted",
    description="[ADMIN] Définir un Pokémon Shiny Wanted avec des points par palier",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(pokemon="Nom du Pokémon wanted (autocomplétion disponible)")
async def admin_set_wanted(interaction: discord.Interaction, pokemon: str = None):
