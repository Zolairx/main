def get_shiny_candidates():
    """Récupère tous les candidats pour le vote"""
    cursor.execute("SELECT id, pokemon_name, image_url, encounters, game, method FROM shiny_candidates ORDER BY id")
    return cursor.fetchall()

def add_shiny_candidate(pokemon_name, image_url, encounters, game, method, added_by):
    """Ajoute un candidat au vote avec sauvegarde automatique de l'image"""
    cursor.execute("SELECT COUNT(*) FROM shiny_candidates", ())
    count = cursor.fetchone()[0]

    if count >= 15:
        return False, "La liste est pleine (maximum 15 Pokémon)"

    cursor.execute(
        "INSERT INTO shiny_candidates (pokemon_name, image_url, encounters, game, method, added_by) VALUES (?, ?, ?, ?, ?, ?)",
        (pokemon_name, image_url, encounters, game, method, added_by)
    )
    conn.commit()
    
    # Récupérer l'ID du candidat nouvellement créé
    candidate_id = cursor.lastrowid
    
    # Sauvegarder l'image si une URL est fournie
    if image_url and candidate_id:
        # Programmer le téléchargement de l'image en arrière-plan
        async def save_image_task():
            try:
                saved_path = await download_and_save_image(image_url, candidate_id)
                if saved_path:
                    # Mettre à jour l'URL avec le chemin local
                    cursor.execute("UPDATE shiny_candidates SET image_url = ? WHERE id = ?", (saved_path, candidate_id))
                    conn.commit()
                    logger.info(f"Image URL mise à jour pour le candidat {candidate_id}")
            except Exception as e:
                logger.error(f"Erreur lors de la sauvegarde de l'image pour le candidat {candidate_id}: {e}")
        
        # Lancer la tâche en arrière-plan
        asyncio.create_task(save_image_task())
    
    return True, "Pokémon ajouté avec succès"

def get_user_votes(user_id):
    """Récupère les votes d'un utilisateur"""
    cursor.execute("SELECT candidate_id FROM shiny_votes WHERE user_id = ? ORDER BY vote_rank", (str(user_id),))
    return [row[0] for row in cursor.fetchall()]

def add_user_vote(user_id, candidate_ids):
    """Enregistre les votes d'un utilisateur (remplace les votes précédents)"""
    cursor.execute("DELETE FROM shiny_votes WHERE user_id = ?", (str(user_id),))

    for rank, candidate_id in enumerate(candidate_ids, start=1):
        cursor.execute(
            "INSERT INTO shiny_votes (user_id, candidate_id, vote_rank) VALUES (?, ?, ?)",
            (str(user_id), candidate_id, rank)
        )
    conn.commit()

def get_vote_results():
    """Récupère les résultats du vote avec scores"""
    cursor.execute("""
        SELECT
            sc.id,
            sc.pokemon_name,
            sc.game,
            sc.method,
            sc.encounters,
            sc.image_url,
            COUNT(sv.id) as vote_count,
            SUM(CASE
                WHEN sv.vote_rank = 1 THEN 3
                WHEN sv.vote_rank = 2 THEN 2
                WHEN sv.vote_rank = 3 THEN 1
                ELSE 0
            END) as total_score
        FROM shiny_candidates sc
        LEFT JOIN shiny_votes sv ON sc.id = sv.candidate_id
        GROUP BY sc.id
        ORDER BY total_score DESC, vote_count DESC
    """)
    return cursor.fetchall()

def reset_vote_system():
    """Réinitialise complètement le système de vote et supprime toutes les images"""
    # Supprimer toutes les images des candidats
    try:
        cursor.execute("SELECT id FROM shiny_candidates")
        candidate_ids = [row[0] for row in cursor.fetchall()]
        
        for candidate_id in candidate_ids:
            delete_candidate_image(candidate_id)
            
    except Exception as e:
        logger.error(f"Erreur lors de la suppression des images: {e}")
    
    # Supprimer les données de la base
    cursor.execute("DELETE FROM shiny_votes")
    cursor.execute("DELETE FROM shiny_candidates")
    conn.commit()
    
    logger.info("Système de vote réinitialisé et images supprimées")

# ============= SYSTÈME DE GESTION DES IMAGES PERMANENTES =============

async def download_and_save_image(image_url, candidate_id):
    """Télécharge et sauvegarde une image de manière permanente"""
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(image_url) as response:
                if response.status == 200:
                    # Vérifier la taille de l'image
                    content_length = response.headers.get('content-length')
                    if content_length and int(content_length) > MAX_IMAGE_SIZE:
                        logger.warning(f"Image trop grande pour le candidat {candidate_id}: {content_length} bytes")
                        return None
                    
                    # Lire le contenu de l'image
                    image_data = await response.read()
                    
                    # Vérifier la taille réelle
                    if len(image_data) > MAX_IMAGE_SIZE:
                        logger.warning(f"Image trop grande pour le candidat {candidate_id}: {len(image_data)} bytes")
                        return None
                    
                    # Déterminer l'extension du fichier
                    content_type = response.headers.get('content-type', '')
                    if 'png' in content_type:
                        extension = 'png'
                    elif 'jpeg' in content_type or 'jpg' in content_type:
                        extension = 'jpg'
                    elif 'gif' in content_type:
                        extension = 'gif'
                    elif 'webp' in content_type:
                        extension = 'webp'
                    else:
                        extension = 'jpg'  # Par défaut
                    
                    # Créer le nom du fichier
                    filename = f"candidate_{candidate_id}.{extension}"
                    filepath = IMAGES_DIR / filename
                    
                    # Sauvegarder l'image
                    with open(filepath, 'wb') as f:
                        f.write(image_data)
                    
                    logger.info(f"Image sauvegardée: {filename}")
                    return str(filepath)
                    
    except Exception as e:
        logger.error(f"Erreur lors du téléchargement de l'image pour le candidat {candidate_id}: {e}")
    
    return None

def get_local_image_path(candidate_id):
    """Récupère le chemin de l'image locale pour un candidat"""
    for ext in ['png', 'jpg', 'jpeg', 'gif', 'webp']:
        filepath = IMAGES_DIR / f"candidate_{candidate_id}.{ext}"
        if filepath.exists():
            return str(filepath)
    return None

def delete_candidate_image(candidate_id):
    """Supprime l'image d'un candidat"""
    for ext in ['png', 'jpg', 'jpeg', 'gif', 'webp']:
        filepath = IMAGES_DIR / f"candidate_{candidate_id}.{ext}"
        if filepath.exists():
            try:
                filepath.unlink()
                logger.info(f"Image supprimée: {filepath}")
                return True
            except Exception as e:
                logger.error(f"Erreur lors de la suppression de l'image {filepath}: {e}")
    return False

def cleanup_old_images():
    """Nettoie les images orphelines (sans candidat correspondant)"""
    try:
        # Récupérer tous les IDs de candidats existants
        cursor.execute("SELECT id FROM shiny_candidates")
        existing_candidates = {row[0] for row in cursor.fetchall()}
        
        # Parcourir tous les fichiers d'images
        deleted_count = 0
        for filepath in IMAGES_DIR.glob("candidate_*.*"):
            try:
                # Extraire l'ID du candidat du nom de fichier
                filename = filepath.stem  # candidate_123
                candidate_id = int(filename.split('_')[1])
                
                # Si le candidat n'existe plus, supprimer l'image
                if candidate_id not in existing_candidates:
                    filepath.unlink()
                    deleted_count += 1
                    logger.info(f"Image orpheline supprimée: {filepath}")
                    
            except (ValueError, IndexError) as e:
                logger.warning(f"Nom de fichier invalide: {filepath} - {e}")
                continue
        
        if deleted_count > 0:
            logger.info(f"Nettoyage terminé: {deleted_count} images orphelines supprimées")
            
    except Exception as e:
        logger.error(f"Erreur lors du nettoyage des images: {e}")

# ============= SYSTÈME DE GESTION D'ERREURS AVANCÉ =============

class DiscordErrorType(enum.Enum):
    """Types d'erreurs Discord"""
    RATE_LIMITED = "rate_limited"
    SERVER_ERROR = "server_error"
    CLIENT_ERROR = "client_error"
    PERMISSION_ERROR = "permission_error"
    AUTHENTICATION_ERROR = "authentication_error"
    NOT_FOUND = "not_found"
    UNKNOWN = "unknown"

def classify_discord_error(error):
    """Classifie les erreurs Discord selon leur type"""
    if isinstance(error, discord.HTTPException):
        status = error.status

        # Code 40060 = "Interaction has already been acknowledged"
        # → non-retryable : le defer/respond a déjà été envoyé, relancer planterait à nouveau
        if getattr(error, 'code', None) == 40060 or 'already been responded' in str(error).lower():
            return DiscordErrorType.CLIENT_ERROR

        if status == 429:   # Rate limited
            return DiscordErrorType.RATE_LIMITED
        elif status == 403: # Forbidden
            return DiscordErrorType.PERMISSION_ERROR
        elif status == 401: # Unauthorized
            return DiscordErrorType.AUTHENTICATION_ERROR
        elif status == 404: # Not found
            return DiscordErrorType.NOT_FOUND
        elif 400 <= status < 500:  # Client errors
            return DiscordErrorType.CLIENT_ERROR
        elif 500 <= status < 600:  # Server errors
            return DiscordErrorType.SERVER_ERROR

    # InteractionResponded est levé par discord.py directement (pas une HTTPException)
    if isinstance(error, discord.InteractionResponded):
        return DiscordErrorType.CLIENT_ERROR

    return DiscordErrorType.UNKNOWN

async def check_bot_token_validity():
    """Vérifie la validité du token de bot"""
    global bot_token_valid, last_token_check
    
    current_time = datetime.now()
    if last_token_check and (current_time - last_token_check).total_seconds() < TOKEN_CHECK_INTERVAL:
        return bot_token_valid
    
    try:
        # Test simple avec une requête légère
        await bot.fetch_user(bot.user.id)
        bot_token_valid = True
        logger.debug("Token de bot validé avec succès")
    except discord.HTTPException as e:
        if e.status == 401:
            bot_token_valid = False
            logger.error("❌ Token de bot invalide ou expiré !")
        else:
            logger.warning(f"Erreur lors de la vérification du token: {e}")
    except Exception as e:
        logger.warning(f"Erreur inattendue lors de la vérification du token: {e}")
    
    last_token_check = current_time
    return bot_token_valid

async def check_bot_permissions(guild, required_permissions=None):
    """Vérifie les permissions du bot dans une guilde"""
    if not guild:
        return False, "Guilde non trouvée"
    
    try:
        bot_member = guild.get_member(bot.user.id)
        if not bot_member:
            return False, "Bot non trouvé dans la guilde"
        
        if required_permissions:
            missing_perms = []
            for perm_name in required_permissions:
                if not getattr(bot_member.guild_permissions, perm_name, False):
                    missing_perms.append(perm_name)
            
            if missing_perms:
                return False, f"Permissions manquantes: {', '.join(missing_perms)}"
        
        return True, "Permissions OK"
    
    except Exception as e:
        return False, f"Erreur vérification permissions: {e}"

def calculate_backoff_delay(attempt, base_delay=INITIAL_RETRY_DELAY, max_delay=MAX_RETRY_DELAY, multiplier=BACKOFF_MULTIPLIER, jitter=True):
    """Calcule le délai de backoff exponentiel avec jitter optionnel - ÉQUILIBRÉ POUR L'EXPÉRIENCE"""
    delay = min(base_delay * (multiplier ** attempt), max_delay)

    if jitter:
        # Ajouter un jitter de ±30% pour éviter la synchronisation (réduit de 50% à 30%)
        jitter_amount = delay * 0.3
        delay += random.uniform(-jitter_amount, jitter_amount)

    return max(delay, 1.0)  # Minimum 1 seconde (réduit de 2s à 1s)

async def discord_retry_wrapper(func, *args, context="Discord API Call", required_permissions=None, **kwargs):
    """
    Wrapper générique pour les appels Discord avec retry automatique et gestion d'erreurs avancée
    
    Args:
        func: Fonction à exécuter
        *args: Arguments de la fonction
        context: Contexte pour le logging
        required_permissions: Liste des permissions requises
        **kwargs: Arguments nommés de la fonction
    """
    global bot_token_valid

    # Extraire les paramètres de contrôle
    guild = kwargs.pop('guild', None)
    permissions = kwargs.pop('required_permissions', required_permissions)
    
    # Vérifier la validité du token
    if not await check_bot_token_validity():
        logger.error(f"❌ Token invalide - Abandon de {context}")
        return None
    
    # Vérifier les permissions si requises
    if permissions and guild:
        has_perms, perm_message = await check_bot_permissions(guild, permissions)
        if not has_perms:
            logger.error(f"❌ {context} - {perm_message}")
            return None
    
    last_error = None
    
    for attempt in range(MAX_RETRIES):
        try:
            result = await func(*args, **kwargs)
            if attempt > 0:
                logger.info(f"✅ {context} réussi après {attempt + 1} tentative(s)")
            return result
        
        except Exception as error:
            last_error = error
            error_type = classify_discord_error(error)
            
            # Gérer selon le type d'erreur
            if error_type == DiscordErrorType.AUTHENTICATION_ERROR:
                logger.error(f"❌ {context} - Erreur d'authentification (token invalide)")
                bot_token_valid = False
                break
            
            elif error_type == DiscordErrorType.PERMISSION_ERROR:
                logger.error(f"❌ {context} - Erreur de permissions (403) - Pas de retry")
                break
            
            elif error_type == DiscordErrorType.CLIENT_ERROR:
                logger.error(f"❌ {context} - Erreur client ({error.status if hasattr(error, 'status') else 'inconnue'}) - Pas de retry")
                break
            
            elif error_type == DiscordErrorType.RATE_LIMITED:
                retry_after = getattr(error, 'retry_after', None)
                if retry_after:
                    # Ajouter une marge de sécurité raisonnable au retry_after
                    delay = min(retry_after + 2.0, MAX_RETRY_DELAY)  # Marge réduite de 5s à 2s
                    logger.warning(f"⏳ {context} - Rate limited, attente {delay:.1f}s (tentative {attempt + 1}/{MAX_RETRIES})")
                    await asyncio.sleep(delay)
                else:
                    # Utiliser un délai raisonnable si pas de retry_after
                    delay = calculate_backoff_delay(attempt) * 1.5  # Multiplicateur réduit de 3 à 1.5
                    logger.warning(f"⏳ {context} - Rate limited sans retry_after, attente {delay:.1f}s")
                    await asyncio.sleep(delay)
                continue
            
            elif error_type == DiscordErrorType.SERVER_ERROR:
                delay = calculate_backoff_delay(attempt)
                logger.warning(f"⏳ {context} - Erreur serveur, retry dans {delay:.1f}s (tentative {attempt + 1}/{MAX_RETRIES})")
                await asyncio.sleep(delay)
                continue
            
            elif error_type == DiscordErrorType.NOT_FOUND:
                if "Unknown interaction" in str(error):
                    logger.warning(f"⚠️ {context} - Interaction expirée (404)")
                    return None
                else:
                    logger.warning(f"⚠️ {context} - Ressource non trouvée (404)")
                    return None
            
            else:
                delay = calculate_backoff_delay(attempt)
                logger.warning(f"⏳ {context} - Erreur inconnue: {error} - Retry dans {delay:.1f}s")
                await asyncio.sleep(delay)
                continue
    
    # Si on arrive ici, toutes les tentatives ont échoué
    logger.error(f"❌ {context} - Échec après {MAX_RETRIES} tentatives. Dernière erreur: {last_error}")
    return None

# ============= FONCTIONS MISES À JOUR AVEC LE NOUVEAU SYSTÈME =============

async def update_roles():
    """Version optimisée de la mise à jour des rôles avec gestion d'erreurs avancée"""
    global last_role_update
    
    # Vérifier le cooldown
    current_time = datetime.now()
    if last_role_update and (current_time - last_role_update).total_seconds() < ROLE_UPDATE_COOLDOWN:
        logger.info("Rate limite des rôles : mise à jour ignorée (cooldown)")
        return
    
    # Acquérir le verrou pour éviter les exécutions simultanées
    async with role_update_lock:
        try:
            guild = bot.get_guild(GUILD_ID)
            if guild is None:
                logger.error("Guild non trouvée")
                return

            # Vérifier les permissions du bot
            required_perms = ['manage_roles']
            has_perms, perm_message = await check_bot_permissions(guild, required_perms)
            if not has_perms:
                logger.error(f"Mise à jour des rôles impossible: {perm_message}")
                return

            ladder = get_ladder()
            logger.info(f"Mise à jour des rôles pour {len(ladder)} utilisateurs")
            
            # Récupérer tous les rôles à l'avance
            shiny_roles = {}
            for role_key, role_id in ROLE_IDS.items():
                role = guild.get_role(role_id)
                if role:
                    shiny_roles[role_key] = role
                else:
                    logger.warning(f"Rôle {role_key} ({role_id}) introuvable")
            
            # Traiter par batch pour éviter le rate limiting
            successful_updates = 0
            failed_updates = 0
            
            for batch_start in range(0, len(ladder), ROLE_UPDATE_BATCH_SIZE):
                batch_end = min(batch_start + ROLE_UPDATE_BATCH_SIZE, len(ladder))
                batch = ladder[batch_start:batch_end]
                
                # Traitement du batch - séquentiel avec délais équilibrés
                for user_data in batch:
                    user_id, *_ = user_data
                    position = batch_start + batch.index(user_data) + 1
                    result = await update_single_user_role(guild, user_id, position, shiny_roles)

                    # Délai équilibré entre chaque mise à jour de rôle
                    await asyncio.sleep(0.8)  # Réduit de 1.5s à 0.8s

                    if result is None or isinstance(result, Exception):
                        failed_updates += 1
                    else:
                        successful_updates += 1

                # Délai raisonnable entre les batches
                if batch_end < len(ladder):
                    await asyncio.sleep(BATCH_DELAY)  # Suppression des 2s supplémentaires
                    logger.debug(f"Batch {batch_start//ROLE_UPDATE_BATCH_SIZE + 1} terminé, délai de {BATCH_DELAY}s")
            
            last_role_update = current_time
            logger.info(f"Mise à jour des rôles terminée: {successful_updates} succès, {failed_updates} échecs")
            
        except Exception as e:
            logger.error(f"Erreur globale update_roles: {e}")

async def update_single_user_role(guild, user_id, position, shiny_roles):
    """Met à jour le rôle d'un seul utilisateur avec le nouveau système de retry"""
    
    async def _update_role(**kwargs):
        member = guild.get_member(int(user_id))
        if member is None:
            return None
        
        # Déterminer le nouveau rôle
        if position == 1:
            new_role_key = "SHINY_HUNTER_1"
        elif position == 2:
            new_role_key = "SHINY_HUNTER_2"
        elif position == 3:
            new_role_key = "SHINY_HUNTER_3"
        elif 4 <= position <= 8:
            new_role_key = "SHINY_MASTER"
        elif 9 <= position <= 14:
            new_role_key = "SHINY_DE_DIAMANT"
        elif 15 <= position <= 20:
            new_role_key = "SHINY_DE_EMERAUDE"
        elif 21 <= position <= 29:
            new_role_key = "SHINY_DE_PLATINE"
        elif 30 <= position <= 39:
            new_role_key = "SHINY_D_OR"
        elif 40 <= position <= 51:
            new_role_key = "SHINY_D_ARGENT"
        else:
            new_role_key = "SHINY_NOVICE"
        
        new_role = shiny_roles.get(new_role_key)
        if not new_role:
            logger.warning(f"Nouveau rôle {new_role_key} non trouvé")
            return None
        
        # Supprimer les anciens rôles shiny
        roles_to_remove = [role for role in shiny_roles.values() if role in member.roles and role != new_role]
        if roles_to_remove:
            await member.remove_roles(*roles_to_remove, reason="Mise à jour classement shiny")
        
        # Ajouter le nouveau rôle s'il n'est pas déjà présent
        if new_role not in member.roles:
            await member.add_roles(new_role, reason="Mise à jour classement shiny")
        
        logger.debug(f"Rôle mis à jour pour {member.display_name} (#{position})")
        return True
    
    return await discord_retry_wrapper(
        _update_role,
        context=f"Role Update User {user_id}",
        guild=guild,
        required_permissions=['manage_roles']
    )

async def remove_roles_from_member(member, roles_to_remove):
    """Retire les rôles shiny d'un membre avec retry"""
    async def _remove(**kwargs):
        await member.remove_roles(*roles_to_remove, reason="Réinitialisation saison ranked")
        logger.debug(f"Rôles retirés de {member.display_name}")
        return True
    
    return await discord_retry_wrapper(
        _remove,
        context=f"Remove Roles from {member.display_name}",
        guild=member.guild,
        required_permissions=['manage_roles']
    )

async def reset_all_shiny_roles():
    """Retire tous les rôles shiny de tous les membres du serveur"""
    guild = bot.get_guild(GUILD_ID)
    if guild is None:
        logger.error("Guild non trouvée")
        return None

    # Vérifier les permissions du bot
    required_perms = ['manage_roles']
    has_perms, perm_message = await check_bot_permissions(guild, required_perms)
    if not has_perms:
        logger.error(f"Réinitialisation des rôles impossible: {perm_message}")
        return None

    # Récupérer tous les rôles shiny
    shiny_roles = []
    for role_key, role_id in ROLE_IDS.items():
        role = guild.get_role(role_id)
        if role:
            shiny_roles.append(role)
        else:
            logger.warning(f"Rôle {role_key} ({role_id}) introuvable")

    if not shiny_roles:
        logger.error("Aucun rôle shiny trouvé")
        return None

    # Récupérer tous les membres du serveur
    members_with_roles = []
    for member in guild.members:
        # Vérifier si le membre a au moins un rôle shiny
        member_shiny_roles = [role for role in shiny_roles if role in member.roles]
        if member_shiny_roles:
            members_with_roles.append((member, member_shiny_roles))

    logger.info(f"Réinitialisation des rôles pour {len(members_with_roles)} membres")

    # Traiter par batch pour éviter le rate limiting
    successful_removals = 0
    failed_removals = 0
    batch_size = ROLE_UPDATE_BATCH_SIZE

    for batch_start in range(0, len(members_with_roles), batch_size):
        batch_end = min(batch_start + batch_size, len(members_with_roles))
        batch = members_with_roles[batch_start:batch_end]

        # Traitement du batch
        for member, roles_to_remove in batch:
            result = await remove_roles_from_member(member, roles_to_remove)
            if result is None or isinstance(result, Exception):
                failed_removals += 1
            else:
                successful_removals += 1

            # Délai entre chaque membre
            await asyncio.sleep(0.8)

        # Délai entre les batches
        if batch_end < len(members_with_roles):
            await asyncio.sleep(BATCH_DELAY)
            logger.debug(f"Batch {batch_start//batch_size + 1} terminé")

    logger.info(f"Réinitialisation terminée: {successful_removals} succès, {failed_removals} échecs")
    return successful_removals, failed_removals

async def background_role_updater():
    """Tâche en arrière-plan pour la mise à jour des rôles avec gestion améliorée"""
    await bot.wait_until_ready()
    logger.info("Démarrage du système de mise à jour des rôles")

    # Attendre 30 secondes après le démarrage avant la première mise à jour (équilibré)
    await asyncio.sleep(30)

    while not bot.is_closed():
        try:
            await update_roles()
            # Attendre avant la prochaine mise à jour avec délai raisonnable
            await asyncio.sleep(ROLE_UPDATE_COOLDOWN + 30)  # Réduit de 60s à 30s supplémentaires

        except asyncio.CancelledError:
            logger.info("Tâche de mise à jour des rôles annulée")
            break
        except discord.RateLimited as e:
            logger.warning(f"Rate limited dans background_role_updater, attente de {e.retry_after}s")
            await asyncio.sleep(e.retry_after + 5)  # Marge réduite de 10s à 5s
        except Exception as e:
            logger.error(f"Erreur background_role_updater: {e}")
            # En cas d'erreur, attendre raisonnablement avant de réessayer
            await asyncio.sleep(180)  # Réduit de 300s à 180s (3 minutes)

# ============= NOUVEAU SYSTÈME DE CLASSEMENT AVEC EMBEDS MULTIPLES =============

# ════════════════════════════════════════════════════════════════
# ══  PROFIL RANKED INTERACTIF                                  ══
# ════════════════════════════════════════════════════════════════

def build_profile_embed(guild, user_id, ladder_list):
    """Construit l'embed de profil ranked pour un utilisateur."""
    member = guild.get_member(int(user_id))
    if not member:
        return None

    uid_str = str(user_id)

    # Position et stats dans le ladder
    rank_pos    = next((i + 1 for i, r in enumerate(ladder_list) if str(r[0]) == uid_str), None)
    total_pts   = next((r[1] for r in ladder_list if str(r[0]) == uid_str), 0)
    wanteds     = next((int(r[2]) for r in ladder_list if str(r[0]) == uid_str), 0)
    races       = next((int(r[3]) for r in ladder_list if str(r[0]) == uid_str), 0)

    def fmt_pts(pts):
        return f"{pts:.1f}" if pts % 1 != 0 else str(int(pts))

    # Label du rang actuel
    rank_limits_labels = [
        (8,  "💜 Shiny Master"),
        (14, "💎 Diamant"),
        (20, "💚 Émeraude"),
        (29, "🏆 Platine"),
        (39, "✨ Or"),
        (51, "🌠 Argent"),
    ]
    rank_label = "🌟 Novice"
    if rank_pos:
        for lim, lbl in rank_limits_labels:
            if rank_pos <= lim:
                rank_label = lbl
                break

    # Message d'écart vers le rang supérieur
    rank_limits  = [8, 14, 20, 29, 39, 51]
    rank_names   = ["💎 Rank Diamant", "💚 Rank Émeraude", "🏆 Rank Platine", "✨ Rank Or", "🌠 Rank Argent", "🌟 Rank Novice"]
    gap_line = ""
    if rank_pos:
        cur_idx = next((i for i, l in enumerate(rank_limits) if rank_pos <= l), len(rank_limits))
        if cur_idx == 0:
            if rank_pos > 1:
                target_pts = ladder_list[rank_pos - 2][1]
                gap = target_pts - total_pts
                if gap > 0:
                    bar = render_progress_bar(total_pts / target_pts) if target_pts > 0 else render_progress_bar(0)
                    gap_line = f"📊 `{bar}` **{gap:.1f} pts** derrière **#{rank_pos - 1}**"
        else:
            upper_last = rank_limits[cur_idx - 1]
            if upper_last <= len(ladder_list):
                target_pts = ladder_list[upper_last - 1][1]
                gap = target_pts - total_pts
                if gap > 0:
                    bar = render_progress_bar(total_pts / target_pts) if target_pts > 0 else render_progress_bar(0)
                    gap_line = f"📈 `{bar}` **{gap:.1f} pts** pour atteindre {rank_names[cur_idx - 1]}"
                else:
                    gap_line = f"✅ Éligible pour {rank_names[cur_idx - 1]} !"

    # Nombre total de shinys
    cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id=?", (uid_str,))
    shiny_count = cursor.fetchone()[0] or 0

    # Streak
    streak_data    = get_user_streak(uid_str)
    current_streak = streak_data.get('current_streak', 0)
    best_streak    = streak_data.get('best_streak', 0)

    # 5 derniers shinys
    cursor.execute("""
        SELECT pokemon, game, methode, date, points
        FROM shiny WHERE user_id=?
        ORDER BY created_at DESC, rowid DESC
        LIMIT 5
    """, (uid_str,))
    last_shinys = cursor.fetchall()

    # Couleur selon rang
    color_map = {
        "💜 Shiny Master": discord.Color.purple(),
        "💎 Diamant":      discord.Color.blue(),
        "💚 Émeraude":    discord.Color.from_rgb(0, 200, 80),
        "🏆 Platine":      discord.Color.from_rgb(0, 191, 255),
        "✨ Or":           discord.Color.gold(),
        "🌠 Argent":       discord.Color.light_grey(),
        "🌟 Novice":       discord.Color.from_rgb(139, 69, 19),
    }
    embed_color = color_map.get(rank_label, discord.Color.blurple())

    desc = f"**{rank_label}**"
    if rank_pos:
        desc += f"  ·  **#{rank_pos}** au classement"
    if gap_line:
        desc += f"\n{gap_line}"

    embed = discord.Embed(
        title=f"👤  {member.display_name}",
        description=desc,
        color=embed_color,
        timestamp=datetime.now()
    )
    embed.set_thumbnail(url=member.display_avatar.url)
    embed.add_field(name="⭐ Points",       value=f"**{fmt_pts(total_pts)}**",                              inline=True)
    embed.add_field(name="✨ Shinys",        value=f"**{shiny_count}**",                                     inline=True)
    embed.add_field(name="🏅 Position",     value=f"**#{rank_pos or '?'}**",                                inline=True)
    embed.add_field(name="🎯 Wanteds",      value=f"**{wanteds}**",                                         inline=True)
    embed.add_field(name="🏁 Races",        value=f"**{races}**",                                           inline=True)
    embed.add_field(name="🔥 Streak",       value=f"**{current_streak}** j (record : **{best_streak}**)",   inline=True)

    if last_shinys:
        # Récupérer les wanteds mystères actifs pour masquer les noms
        cursor.execute("SELECT pokemon_name FROM shiny_wanted WHERE is_active=1 AND indice IS NOT NULL AND indice != ''")
        mystery_wanteds = {row[0].lower() for row in cursor.fetchall()
                           if not (row[0] or '').startswith("[Méthode :")}
        shiny_lines = []
        for poke, game, methode, date, pts in last_shinys:
            pts_s  = fmt_pts(pts) if pts else "?"
            game_s = (game[:14] + "…") if game and len(game) > 14 else (game or "?")
            # Masquer le nom si c'est un wanted mystère encore actif
            display_poke = "???" if poke.lower() in mystery_wanteds else poke
            shiny_lines.append(f"• **{display_poke}** — {game_s} — {date} *(+{pts_s} pts)*")
        embed.add_field(
            name="🌟 5 derniers shinys",
            value="\n".join(shiny_lines),
            inline=False
        )

    # Badges
    badges = get_user_badges(user_id)
    if badges:
        badge_str = "  ".join(f"{b[1]} {b[2]}" for b in badges)
        if len(badge_str) > 1024:
            badge_str = badge_str[:1020] + "…"
        embed.add_field(name="🎖️ Badges", value=badge_str, inline=False)

    embed.set_footer(text="ShinyBot · Profil Ranked — visible uniquement par toi")
    return embed


class PodiumProfileView(discord.ui.View):
    """Bouton 'Voir le profil' sur un embed du podium (top 3)."""

    def __init__(self, user_id, ladder_list, guild):
        super().__init__(timeout=None)
        self.user_id     = user_id
        self.ladder_list = ladder_list
        self.guild       = guild

        btn = discord.ui.Button(
            label="👤 Voir le profil",
            style=discord.ButtonStyle.secondary,
            custom_id=f"podium_profile_{user_id}"
        )
        btn.callback = self._callback
        self.add_item(btn)

    async def _callback(self, interaction: discord.Interaction):
        try:
            await interaction.response.defer(ephemeral=True)
            # Récupérer le ladder à jour au moment du clic
            ladder_list = get_ladder()
            guild = bot.get_guild(GUILD_ID)
            embed = build_profile_embed(guild, self.user_id, ladder_list)
            if embed:
                await interaction.followup.send(embed=embed, ephemeral=True)
            else:
                await interaction.followup.send("Profil introuvable.", ephemeral=True)
        except Exception as e:
            logger.error(f"Erreur PodiumProfileView: {e}")
            try:
                await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
            except Exception:
                pass


class RankedGroupSelectView(discord.ui.View):
    """Select menu unique pour voir le profil de n'importe quel joueur d'un groupe de rang."""

    def __init__(self, players, ladder_list, guild):
        super().__init__(timeout=None)
        self.ladder_list = ladder_list
        self.guild       = guild

        # Discord limite à 25 options par Select
        options = []
        for member, total_pts, _, _, pos in players[:25]:
            shiny_c = self._get_shiny_count(member.id)
            pts_s = f"{total_pts:.1f}" if total_pts % 1 != 0 else str(int(total_pts))
            options.append(discord.SelectOption(
                label=f"#{pos} — {member.display_name}"[:100],
                value=str(member.id),
                description=f"{pts_s} pts · {shiny_c} shinys"[:100]
            ))


        select = discord.ui.Select(
            placeholder="👤 Voir le profil d'un membre…",
            options=options,
            min_values=1,
            max_values=1,
            custom_id="ranked_profile_select"
        )
        select.callback = self._on_select
        self.add_item(select)

    def _get_shiny_count(self, user_id):
        cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id=?", (str(user_id),))
        return cursor.fetchone()[0] or 0

    async def _on_select(self, interaction: discord.Interaction):
        try:
            await interaction.response.defer(ephemeral=True)
            user_id = interaction.data["values"][0]
            # Récupérer le ladder à jour au moment du clic
            ladder_list = get_ladder()
            guild = bot.get_guild(GUILD_ID)
            embed = build_profile_embed(guild, user_id, ladder_list)
            if embed:
                await interaction.followup.send(embed=embed, ephemeral=True)
            else:
                await interaction.followup.send("Profil introuvable.", ephemeral=True)
        except Exception as e:
            logger.error(f"Erreur RankedGroupSelectView: {e}")
            try:
                await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
            except Exception:
                pass


def _load_podium_font(size, bold=True):
    """Charge une police TrueType si disponible sur le serveur, sinon fallback
    sur la police par défaut de Pillow (moins jolie mais ne plante jamais)."""
    candidates = [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf" if bold else "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
    ]
    for path in candidates:
        try:
            return ImageFont.truetype(path, size)
        except Exception:
            continue
    return ImageFont.load_default()


def _draw_podium_image_sync(entries):
    """Partie CPU-bound (dessin Pillow) — exécutée dans un thread séparé via
    asyncio.to_thread pour ne jamais bloquer la boucle asyncio pendant son
    exécution (sinon les interactions Discord en attente ailleurs dans le bot
    peuvent expirer avec une erreur 'Unknown interaction')."""
    W, H = 900, 560
    BG_COLOR = (35, 39, 42, 255)
    img = Image.new("RGBA", (W, H), BG_COLOR)
    draw = ImageDraw.Draw(img)

    font_title = _load_podium_font(36)
    font_name = _load_podium_font(26)
    font_pts = _load_podium_font(22, bold=False)

    draw.text((W / 2, 45), "PODIUM RANKED", font=font_title, fill=(255, 215, 0, 255), anchor="mm")

    podium_cfg = [
        (0, 210, (192, 192, 192, 255)),
        (1, 290, (255, 215, 0, 255)),
        (2, 160, (205, 127, 50, 255)),
    ]
    block_w = 220
    gap = 30
    total_w = block_w * 3 + gap * 2
    start_x = (W - total_w) / 2
    base_y = H - 55
    avatar_size = 120

    for (slot, block_h, color), entry in zip(podium_cfg, entries):
        if entry is None:
            continue
        rank_idx, name, pts, avatar_bytes = entry

        x_center = start_x + slot * (block_w + gap) + block_w / 2
        block_top = base_y - block_h

        draw.rounded_rectangle(
            [x_center - block_w / 2, block_top, x_center + block_w / 2, base_y],
            radius=16, fill=color
        )
        draw.text((x_center, block_top + block_h / 2 + 15), f"#{rank_idx + 1}",
                   font=font_title, fill=(30, 30, 30, 255), anchor="mm")

        avatar_y = block_top - avatar_size - 20
        avatar_img = None
        if avatar_bytes:
            try:
                avatar_img = Image.open(io.BytesIO(avatar_bytes)).convert("RGBA").resize((avatar_size, avatar_size))
            except Exception:
                avatar_img = None

        border = avatar_size + 10
        border_img = Image.new("RGBA", (border, border), (0, 0, 0, 0))
        ImageDraw.Draw(border_img).ellipse((0, 0, border, border), fill=color)
        img.paste(border_img, (int(x_center - border / 2), int(avatar_y - 5)), border_img)

        if avatar_img:
            mask = Image.new("L", (avatar_size, avatar_size), 0)
            ImageDraw.Draw(mask).ellipse((0, 0, avatar_size, avatar_size), fill=255)
            img.paste(avatar_img, (int(x_center - avatar_size / 2), int(avatar_y)), mask)
        else:
            initial_img = Image.new("RGBA", (avatar_size, avatar_size), (0, 0, 0, 0))
            idraw = ImageDraw.Draw(initial_img)
            idraw.ellipse((0, 0, avatar_size, avatar_size), fill=(80, 84, 88, 255))
            idraw.text((avatar_size / 2, avatar_size / 2), (name[:1] or "?").upper(),
                       font=font_title, fill=(255, 255, 255, 255), anchor="mm")
            img.paste(initial_img, (int(x_center - avatar_size / 2), int(avatar_y)), initial_img)

        display_name = (name[:14] + "…") if len(name) > 14 else name
        draw.text((x_center, avatar_y - 15), display_name, font=font_name, fill=(255, 255, 255, 255), anchor="mm")

        pts_str = f"{pts:.0f} pts" if pts == int(pts) else f"{pts:.1f} pts"
        draw.text((x_center, base_y + 25), pts_str, font=font_pts, fill=(210, 210, 210, 255), anchor="mm")

    buf = io.BytesIO()
    img.save(buf, format="PNG")
    buf.seek(0)
    return buf


async def generate_podium_image(guild, ladder_list):
    """Génère une image PNG du podium (Top 3) avec avatars, blocs colorés par
    tier et points. Retourne un io.BytesIO prêt à être attaché à un message
    Discord, ou None si Pillow n'est pas installé / pas assez de joueurs classés.

    Le téléchargement des avatars (I/O, async) est séparé du dessin Pillow
    (CPU-bound, exécuté dans un thread via asyncio.to_thread) pour ne jamais
    bloquer la boucle asyncio du bot pendant la génération."""
    if not PIL_AVAILABLE or len(ladder_list) < 1:
        return None

    rank_order = [1, 0, 2]  # 2e, 1er, 3e (ordre visuel du podium)
    entries = []
    async with aiohttp.ClientSession() as session:
        for rank_idx in rank_order:
            if rank_idx >= len(ladder_list):
                entries.append(None)
                continue
            uid, pts, *_rest = ladder_list[rank_idx]
            member = guild.get_member(int(uid)) if guild else None
            name = member.display_name if member else f"Joueur {uid}"

            avatar_bytes = None
            if member:
                try:
                    avatar_url = str(member.display_avatar.replace(size=256, format="png").url)
                    async with session.get(avatar_url) as resp:
                        if resp.status == 200:
                            avatar_bytes = await resp.read()
                except Exception:
                    avatar_bytes = None

            entries.append((rank_idx, name, pts, avatar_bytes))

    return await asyncio.to_thread(_draw_podium_image_sync, entries)


async def update_classement_retro_message():
    """Met à jour le classement Full Odds (jeux classiques, points de capture purs)
    dans son salon dédié. Version compacte du classement principal, avec les
    mêmes tiers/couleurs et une image podium générée avec le même pipeline."""
    guild = bot.get_guild(GUILD_ID)
    channel = bot.get_channel(SALON_CLASSEMENT_RETRO_ID)
    if not guild or not channel:
        logger.error("Guild ou salon Classement Full Odds introuvable.")
        return

    ladder_list = get_retro_ladder()

    try:
        messages_to_delete = []
        async for msg in channel.history(limit=100):
            messages_to_delete.append(msg)
        for i in range(0, len(messages_to_delete), 8):
            batch = messages_to_delete[i:i+8]
            for msg in batch:
                try:
                    await msg.delete()
                    await asyncio.sleep(0.5)
                except discord.NotFound:
                    pass
                except discord.HTTPException as e:
                    logger.warning(f"Erreur suppression message Classement Full Odds: {e}")
                    await asyncio.sleep(2)
            if i + 8 < len(messages_to_delete):
                await asyncio.sleep(1.5)
    except Exception as e:
        logger.warning(f"Erreur nettoyage salon Classement Full Odds: {e}")

    retro_game_labels = ", ".join(GAMES[k]['fr'] for k in RETRO_LADDER_GAME_KEYS if k in GAMES)
    retro_fo_game_labels = ", ".join(GAMES[k]['fr'] for k in RETRO_LADDER_FULL_ODDS_ONLY_GAME_KEYS if k in GAMES)
    intro_embed = discord.Embed(
        title="🕹️ Classement Full Odds",
        description=(
            "Ce classement ne compte que les **points de capture** (aucun bonus wanted/race/objectif/guilde) "
            "des shinys attrapés dans les jeux suivants :\n"
            f"**Jeux classiques complets :** *{retro_game_labels}*\n"
            f"**Full Odds uniquement :** *{retro_fo_game_labels}* *(hors Full Odds Hordes)*\n\n"
            f"🎯 **{len(ladder_list)} Shasseurs classés**\n"
            f"⚡ **Dernière mise à jour :** <t:{int(datetime.now().timestamp())}:R>"
        ),
        color=discord.Color.dark_gold()
    )
    intro_embed.set_footer(text="ShinyBot · Classement Full Odds")
    await channel.send(embed=intro_embed)
    await asyncio.sleep(1.0)

    if not ladder_list:
        await channel.send("Aucun shiny éligible au Classement Full Odds enregistré pour le moment.")
        return

    # Image podium (réutilise le même pipeline que le classement principal)
    podium_file = None
    try:
        podium_buf = await generate_podium_image(guild, ladder_list)
        if podium_buf:
            podium_file = discord.File(podium_buf, filename="podium_full_odds.png")
    except Exception as e:
        logger.warning(f"Erreur génération image Podium Full Odds: {e}")

    # Embed podium détaillé (top 3), avec image en illustration
    podium_emojis = ["🥇", "🥈", "🥉"]
    podium_lines = []
    for i in range(min(3, len(ladder_list))):
        uid, pts = ladder_list[i]
        member = guild.get_member(int(uid))
        name = member.display_name if member else f"Joueur {uid}"
        tier_label = get_retro_rank_title_for_position(i + 1)
        podium_lines.append(f"{podium_emojis[i]} **{name}** — {pts:.0f} pts · {tier_label}")

    podium_embed = discord.Embed(
        title="🕹️ Podium Full Odds",
        description="\n".join(podium_lines),
        color=RETRO_RANK_GROUPS[0][2]
    )
    if podium_file:
        podium_embed.set_image(url="attachment://podium_full_odds.png")
        await channel.send(embed=podium_embed, file=podium_file)
    else:
        await channel.send(embed=podium_embed)
    await asyncio.sleep(1.0)

    # Reste du classement, regroupé par tier exact (comme le classement principal)
    if len(ladder_list) > 3:
        current_position = 4
        for max_pos, role_name, color in RETRO_RANK_GROUPS[2:]:
            players = []
            while current_position <= len(ladder_list) and current_position <= max_pos:
                uid, pts = ladder_list[current_position - 1]
                member = guild.get_member(int(uid))
                if member:
                    players.append((member, pts, current_position))
                current_position += 1

            if players:
                for i in range(0, len(players), 25):
                    batch_players = players[i:i + 25]
                    embed = discord.Embed(
                        title=f"🕹️ {role_name}",
                        description=f"*{len(players)} Shasseur{'s' if len(players) > 1 else ''} dans cette catégorie (Classement Full Odds)*",
                        color=color,
                        timestamp=datetime.now()
                    )
                    for member, pts, position in batch_players:
                        pts_str = f"{pts:.1f}" if pts % 1 != 0 else f"{int(pts)}"
                        embed.add_field(
                            name=f"#{position} - {member.display_name}",
                            value=f"**{pts_str}** pts ⭐",
                            inline=True
                        )
                    embed.set_footer(text=f"ShinyBot · Classement Full Odds • {role_name}")
                    await channel.send(embed=embed)
                    await asyncio.sleep(1.0)

    logger.info("✅ Classement Full Odds mis à jour avec succès")


async def update_classement_message():
    """Système de classement avec embeds multiples amélioré avec gestion d'erreurs avancée"""
    global last_classement_update
    
    # Vérifier le cooldown
    current_time = datetime.now()
    if last_classement_update and (current_time - last_classement_update).total_seconds() < CLASSEMENT_UPDATE_COOLDOWN:
        logger.info("Rate limite classement : mise à jour ignorée (cooldown)")
        return
    
    # Acquérir le verrou pour éviter les exécutions simultanées
    async with classement_update_lock:
        
        async def _update_message(**kwargs):
            guild = bot.get_guild(GUILD_ID)
            classement_channel = bot.get_channel(SALON_CLASSEMENT_ID)
            if not guild or not classement_channel:
                logger.error("Guild ou salon classement introuvable.")
                return None

            ladder_list = get_ladder()

            # Supprimer TOUS les messages du salon (100 derniers) - ÉQUILIBRÉ POUR L'EXPÉRIENCE
            try:
                messages_to_delete = []
                async for msg in classement_channel.history(limit=100):
                    messages_to_delete.append(msg)

                # Supprimer par batch de 8 messages max avec délais équilibrés
                for i in range(0, len(messages_to_delete), 8):  # Augmenté de 5 à 8 messages par batch
                    batch = messages_to_delete[i:i+8]
                    for msg in batch:
                        try:
                            await msg.delete()
                            await asyncio.sleep(0.5)  # Réduit de 1.0s à 0.5s
                        except discord.NotFound:
                            pass  # Message déjà supprimé
                        except discord.HTTPException as e:
                            logger.warning(f"Erreur suppression message: {e}")
                            await asyncio.sleep(2)  # Réduit de 5s à 2s
                    # Délai raisonnable entre les batches
                    if i + 8 < len(messages_to_delete):
                        await asyncio.sleep(1.5)  # Réduit de 3s à 1.5s
            except Exception as e:
                logger.warning(f"Erreur suppression messages dans le salon classement : {e}")

            podium_emojis = ["🥇", "🥈", "🥉"]

            # 1. Embed général d'en-tête
            intro_embed = discord.Embed(
                title="🏆 Classement Ranked Shiny Hunting 🏆",
                description=(
                    "Voici le classement des meilleurs shiny hunters !\n"
                    "────────────────────────────\n"
                    "**RANKED SHINY HUNTING - SAISON 6**\n"
                    "📅 **Fin de saison : 22 Septembre 2026**\n\n"
                    f"🎯 **{len(ladder_list)} Shasseurs actifs**\n"
                    f"⚡ **Dernière mise à jour:** <t:{int(datetime.now().timestamp())}:R>"
                ),
                color=discord.Color.gold(),
                timestamp=datetime.now()
            )
            
            # Ajouter l'icône de la guilde si disponible
            if guild.icon:
                intro_embed.set_author(
                    name="ShinyBot Ranking System", 
                    icon_url=guild.icon.url
                )
            
            intro_embed.set_footer(
                text="ShinyBot • Système de classement automatique",
                icon_url=guild.me.display_avatar.url if guild.me else None
            )
            
            await classement_channel.send(embed=intro_embed)
            await asyncio.sleep(1.0)  # Délai équilibré pour l'expérience utilisateur

            # 2. Podium visuel (image) + infos condensées du Top 3, en un seul message
            top3_view = discord.ui.View(timeout=None)
            for position in range(min(3, len(ladder_list))):
                user_id, total_points, wanted_count, race_wins = ladder_list[position]
                member = guild.get_member(int(user_id))
                if not member:
                    continue

                def _make_callback(uid):
                    async def _cb(interaction: discord.Interaction):
                        try:
                            await interaction.response.defer(ephemeral=True)
                            fresh_ladder = get_ladder()
                            fresh_guild = bot.get_guild(GUILD_ID)
                            profile_embed = build_profile_embed(fresh_guild, uid, fresh_ladder)
                            if profile_embed:
                                await interaction.followup.send(embed=profile_embed, ephemeral=True)
                            else:
                                await interaction.followup.send("Profil introuvable.", ephemeral=True)
                        except Exception as e:
                            logger.error(f"Erreur bouton profil podium: {e}")
                    return _cb

                btn = discord.ui.Button(
                    label=f"👤 {member.display_name}"[:80],
                    style=discord.ButtonStyle.secondary,
                    custom_id=f"podium_profile_{user_id}"
                )
                btn.callback = _make_callback(user_id)
                top3_view.add_item(btn)

            podium_lines = []
            for position in range(min(3, len(ladder_list))):
                user_id, total_points, wanted_count, race_wins = ladder_list[position]
                member = guild.get_member(int(user_id))
                if not member:
                    continue
                points_str = f"{total_points:.1f}" if total_points % 1 != 0 else f"{int(total_points)}"
                podium_lines.append(
                    f"{podium_emojis[position]} **{member.display_name}** — {points_str} pts "
                    f"· 🎯 {int(wanted_count)} wanteds · 🏁 {int(race_wins)} races"
                )

            podium_embed = discord.Embed(
                description="\n".join(podium_lines) if podium_lines else "Aucun joueur classé pour le moment.",
                color=discord.Color.gold()
            )
            try:
                podium_buf = await generate_podium_image(guild, ladder_list)
                if podium_buf:
                    podium_file = discord.File(podium_buf, filename="podium.png")
                    podium_embed.set_image(url="attachment://podium.png")
                    await classement_channel.send(embed=podium_embed, file=podium_file, view=top3_view)
                else:
                    await classement_channel.send(embed=podium_embed, view=top3_view)
            except Exception as e:
                logger.warning(f"Erreur génération image podium: {e}")
                await classement_channel.send(embed=podium_embed, view=top3_view)
            await asyncio.sleep(1.0)  # Délai équilibré pour l'expérience utilisateur

            # 3. Classement par rôles avec préfixe "Rank"
            if len(ladder_list) > 3:
                role_groups = {
                    "💜 Rank Shiny Master":       (8,   discord.Color.purple()),
                    "💎 Rank Shiny de Diamant":   (14,  discord.Color.blue()),
                    "💚 Rank Shiny d'Émeraude":  (20,  discord.Color.from_rgb(0, 200, 80)),
                    "🏆 Rank Shiny de Platine":   (29,  discord.Color.from_rgb(0, 191, 255)),
                    "✨ Rank Shiny d'Or":         (39,  discord.Color.gold()),
                    "🌠 Rank Shiny d'Argent":    (51,  discord.Color.light_grey()),
                    "🌟 Rank Shiny Novice":        (999, discord.Color.from_rgb(139, 69, 19))
                }

                current_position = 4
                for role_name, (max_pos, color) in role_groups.items():
                    players = []
                    while current_position <= len(ladder_list) and current_position <= max_pos:
                        user_id, total_points, wanted_count, race_wins = ladder_list[current_position-1]
                        member = guild.get_member(int(user_id))
                        if member:
                            players.append((member, total_points, wanted_count, race_wins, current_position))
                        current_position += 1

                    if players:
                        # Discord limite à 25 fields par embed, donc on découpe en pages
                        for i in range(0, len(players), 25):
                            batch_players = players[i:i+25]
                            embed = discord.Embed(
                                title=role_name,
                                description=f"*{len(players)} Shasseur{'s' if len(players) > 1 else ''} dans cette catégorie*",
                                color=color,
                                timestamp=datetime.now()
                            )
                            
                            for member, total_points, wanted_count, race_wins, position in batch_players:
                                points_str = f"{total_points:.1f}" if total_points % 1 != 0 else f"{int(total_points)}"
                                value = f"**Points** : {points_str} ⭐ | **Wanteds** : {int(wanted_count)} 🎯 | **Races** : {int(race_wins)} 🏁"
                                
                                embed.add_field(
                                    name=f"#{position} - {member.display_name}",
                                    value=value,
                                    inline=False
                                )
                            
                            embed.set_footer(text=f"ShinyBot • {role_name.split(' ', 1)[1]}")
                            view = RankedGroupSelectView(batch_players, ladder_list, guild)
                            await classement_channel.send(embed=embed, view=view)
                            await asyncio.sleep(1.0)  # Délai équilibré pour l'expérience utilisateur

            logger.info("✅ Classement avec embeds multiples mis à jour avec succès")
            return True
        
        result = await discord_retry_wrapper(
            _update_message,
            context="Multi-Embed Classement Update",
            required_permissions=['send_messages', 'manage_messages']
        )
        
        if result:
            last_classement_update = current_time

        try:
            asyncio.create_task(update_classement_retro_message())
        except Exception as e:
            logger.error(f"Erreur lancement mise à jour Classement Full Odds: {e}")

@bot.event
async def on_member_remove(member: discord.Member):
    """Quand quelqu'un quitte le serveur, on le retire automatiquement de sa
    guilde éventuelle — sinon il y reste bloqué indéfiniment (plus moyen de le
    cibler via /guilde_admin puisqu'il n'est plus un membre du serveur)."""
    try:
        if member.guild.id != GUILD_ID:
            return
        guilde = guilde_of_user(member.id)
        if not guilde:
            return
        cursor.execute("DELETE FROM shinyhunter_guilde_membres WHERE guilde_id=? AND user_id=?", (guilde[0], str(member.id)))
        if not guilde_get_members(guilde[0]):
            cursor.execute("DELETE FROM shinyhunter_guildes WHERE id=?", (guilde[0],))
            conn.commit()
            logger.info(f"Guilde '{guilde[1]}' supprimée (dernier membre {member.id} a quitté le serveur)")
        else:
            conn.commit()
            logger.info(f"{member.id} retiré automatiquement de la guilde '{guilde[1]}' (a quitté le serveur)")
    except Exception as e:
        logger.error(f"Erreur on_member_remove (nettoyage guilde) pour {member.id}: {e}")


@bot.event
async def on_error(event, *args, **kwargs):
    """Gestionnaire d'erreurs global pour capturer les rate limits et interactions expirées"""
    import sys
    import traceback

    exc_type, exc_value, exc_traceback = sys.exc_info()

    if isinstance(exc_value, discord.RateLimited):
        logger.warning(f"⏳ Rate limited sur {event} - Attente de {exc_value.retry_after}s")
        await asyncio.sleep(exc_value.retry_after + 2)
    elif isinstance(exc_value, discord.NotFound) and "Unknown interaction" in str(exc_value):
        logger.warning(f"⚠️ Interaction expirée sur {event} - Ignorée")
        # Ne pas logger l'erreur complète pour les interactions expirées
    else:
        logger.error(f"Erreur dans {event}:")
        traceback.print_exception(exc_type, exc_value, exc_traceback)



@bot.event
async def on_interaction(interaction: discord.Interaction):
    """Intercepte tous les clics de boutons/selects du classement ranked."""
    if interaction.type != discord.InteractionType.component:
        return  # Laisser discord.py gérer les slash commands normalement

    custom_id = interaction.data.get("custom_id", "")
    component_type = interaction.data.get("component_type", 0)

    # ── Guard : si discord.py a déjà une View enregistrée pour ce message,
    # elle a déjà acquitté (ou va acquitter) l'interaction via son callback.
    # On ne touche QUE les custom_ids que ce handler gère explicitement,
    # pour éviter le double-defer → 40060.
    _HANDLED_IDS = {"ranked_profile_select"}
    _HANDLED_PREFIXES = ("podium_profile_",)
    is_ours = (
        custom_id in _HANDLED_IDS
        or any(custom_id.startswith(p) for p in _HANDLED_PREFIXES)
    )
    if not is_ours:
        return  # Laissé à discord.py / aux Views

    # ── Bouton profil podium : custom_id = "podium_profile_{user_id}" ──────
    if custom_id.startswith("podium_profile_"):
        uid = custom_id[len("podium_profile_"):]
        try:
            await interaction.response.defer(ephemeral=True)
            ladder_list = get_ladder()
            guild = bot.get_guild(GUILD_ID)
            embed = build_profile_embed(guild, uid, ladder_list)
            if embed:
                await interaction.followup.send(embed=embed, ephemeral=True)
            else:
                await interaction.followup.send("Profil introuvable.", ephemeral=True)
        except discord.InteractionResponded:
            pass  # Déjà acquitté par une View, on ignore
        except Exception as e:
            logger.error(f"Erreur on_interaction podium_profile: {e}")
            try:
                await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
            except Exception:
                pass
        return

    # ── Select menu ranked group ──────────────────────────────────────────────
    if custom_id == "ranked_profile_select":
        values = interaction.data.get("values", [])
        if values:
            uid = values[0]
            try:
                await interaction.response.defer(ephemeral=True)
                ladder_list = get_ladder()
                guild = bot.get_guild(GUILD_ID)
                embed = build_profile_embed(guild, uid, ladder_list)
                if embed:
                    await interaction.followup.send(embed=embed, ephemeral=True)
                else:
                    await interaction.followup.send("Profil introuvable.", ephemeral=True)
            except discord.InteractionResponded:
                pass  # Déjà acquitté, on ignore
            except Exception as e:
                logger.error(f"Erreur on_interaction ranked_select: {e}")
                try:
                    await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
                except Exception:
                    pass
        return

    # Pour tout le reste, laisser discord.py traiter normalement (boutons de pagination etc.)


@bot.tree.error
async def on_app_command_error(interaction: discord.Interaction, error: app_commands.AppCommandError):
    if isinstance(error, app_commands.CommandNotFound):
        await interaction.response.send_message("Cette commande n'existe plus. Utilisez /classement a la place.", ephemeral=True)
        return
    logger.error(f"Command error: {error}")
    try:
        if not interaction.response.is_done():
            await interaction.response.send_message("Une erreur est survenue.", ephemeral=True)
    except:
        pass

# ════════════════════════════════════════════════════════════════
# ══  CLASSEMENT CHALLENGE AUTOMATIQUE (toutes les 2h)         ══
# ════════════════════════════════════════════════════════════════

SALON_CHALLENGE_STATUS_ID = 1497006919468974151
CHALLENGE_STATUS_UPDATE_INTERVAL = 7200  # 2 heures en secondes

def build_challenge_status_embed(guild):
    """Construit l'embed de classement du challenge type actif (monthly_type_challenge)."""
    challenge = get_active_monthly_type_challenge()

    if not challenge:
        embed = discord.Embed(
            title="🏅 Challenge Type — Classement",
            description="*Aucun challenge type actif pour le moment.*\nRestez à l'affût, le prochain arrive bientôt !",
            color=discord.Color.greyple(),
            timestamp=datetime.now()
        )
        embed.set_footer(text="ShinyBot · Challenge Type • Mise à jour auto toutes les 2h")
        return embed

    challenge_id = challenge[0]
    info, scores = get_type_challenge_leaderboard(challenge_id)
    if not info:
        embed = discord.Embed(
            title="🏅 Challenge Type — Classement",
            description="⚠️ Impossible de charger le classement.",
            color=discord.Color.red(),
            timestamp=datetime.now()
        )
        embed.set_footer(text="ShinyBot · Challenge Type • Mise à jour auto toutes les 2h")
        return embed

    month, year, shiny_type, top_n = info[0], info[1], info[2], info[3]
    bonus_top1, bonus_top2, bonus_top3, bonus_other = float(info[5]), float(info[6]), float(info[7]), float(info[8])
    challenge_desc, ends_at = info[9], info[10]

    embed = discord.Embed(
        title=f"🏅 Challenge Type — Classement en direct",
        description=(
            f"🔷 Type suivi : **{shiny_type}**  |  Période : **{month:02d}/{year}**\n"
            f"🏆 Récompense : **Top {top_n}**"
        ),
        color=discord.Color.blue(),
        timestamp=datetime.now()
    )

    if challenge_desc:
        embed.add_field(name="📝 Description", value=challenge_desc, inline=False)

    embed.add_field(
        name="🎁 Bonus par rang",
        value=(
            f"🥇 Top 1 : **+{bonus_top1:.2f} pts**  |  "
            f"🥈 Top 2 : **+{bonus_top2:.2f} pts**  |  "
            f"🥉 Top 3 : **+{bonus_top3:.2f} pts**  |  "
            f"🏅 Top 4+ : **+{bonus_other:.2f} pts**"
        ),
        inline=False
    )

    if ends_at:
        try:
            ts = int(datetime.strptime(ends_at, "%Y-%m-%d %H:%M").timestamp())
            embed.add_field(name="⏰ Fin du challenge", value=f"<t:{ts}:F>  (<t:{ts}:R>)", inline=False)
        except Exception:
            embed.add_field(name="⏰ Fin du challenge", value=ends_at, inline=False)

    medals = {1: "🥇", 2: "🥈", 3: "🥉"}
    if not scores:
        embed.add_field(
            name="📊 Classement",
            value="*Aucun shiny de ce type comptabilisé pour l'instant.\nSoyez le premier !*",
            inline=False
        )
    else:
        lines = []
        for position, (user_id, total_shinys) in enumerate(scores, start=1):
            member = guild.get_member(int(user_id)) if guild else None
            name = member.display_name if member else f"<@{user_id}>"
            medal = medals.get(position, "🏅" if position <= top_n else "▫️")
            reward = get_rank_bonus(position, bonus_top1, bonus_top2, bonus_top3, bonus_other)
            reward_txt = f" (+{reward:.2f} pts)" if position <= top_n and reward > 0 else ""
            lines.append(f"{medal} **#{position}** — **{name}** — {total_shinys} shiny{'s' if total_shinys > 1 else ''}{reward_txt}")

        # Découper si trop long pour un seul champ Discord (limite 1024 car.)
        chunk, chunks = [], []
        for line in lines:
            if sum(len(l) + 1 for l in chunk) + len(line) > 1000:
                chunks.append("\n".join(chunk))
                chunk = []
            chunk.append(line)
        if chunk:
            chunks.append("\n".join(chunk))

        for i, text in enumerate(chunks):
            title = "📊 Classement" if i == 0 else "📊 Classement (suite)"
            embed.add_field(name=title, value=text, inline=False)

    embed.set_footer(text="ShinyBot · Challenge Type • Mise à jour auto toutes les 2h")
    return embed

async def update_challenge_status_message():
    """Édite (ou crée) le message de statut du challenge dans le salon dédié."""
    guild = bot.get_guild(GUILD_ID)
    channel = bot.get_channel(SALON_CHALLENGE_STATUS_ID)
    if not channel or not guild:
        logger.warning("Salon challenge status introuvable.")
        return

    embed = build_challenge_status_embed(guild)

    # Chercher un message existant du bot dans le salon (dans les 20 derniers)
    existing_msg = None
    try:
        async for msg in channel.history(limit=20):
            if msg.author.id == bot.user.id:
                existing_msg = msg
                break
    except Exception as e:
        logger.warning(f"Erreur lecture historique challenge status: {e}")

    try:
        if existing_msg:
            await existing_msg.edit(embed=embed)
            logger.info("Message challenge status mis à jour.")
        else:
            await channel.send(embed=embed)
            logger.info("Message challenge status créé.")
    except discord.HTTPException as e:
        logger.error(f"Erreur envoi/edit challenge status: {e}")


async def auto_challenge_status_updater():
    """Tâche de fond : met à jour le classement challenge toutes les 2h."""
    await bot.wait_until_ready()
    # Petite attente initiale pour laisser le bot se stabiliser
    await asyncio.sleep(60)
    while not bot.is_closed():
        try:
            await update_challenge_status_message()
        except Exception as e:
            logger.error(f"Erreur auto_challenge_status_updater: {e}")
        await asyncio.sleep(CHALLENGE_STATUS_UPDATE_INTERVAL)


async def auto_guilde_classement_updater():
    """Met à jour le classement des guildes automatiquement toutes les heures."""
    await asyncio.sleep(90)  # Délai initial pour laisser le bot démarrer
    while not bot.is_closed():
        try:
            await update_guilde_classement_message()
        except Exception as e:
            logger.error(f"Erreur auto_guilde_classement_updater: {e}")
        await asyncio.sleep(3600)  # Toutes les heures


def cleanup_old_db_backups():
    """Supprime les sauvegardes SQLite datées plus vieilles que la rétention."""
    cutoff = datetime.now() - timedelta(days=BACKUP_RETENTION_DAYS)
    for path in BACKUPS_DIR.glob("shinybot_*.db"):
        try:
            if datetime.fromtimestamp(path.stat().st_mtime) < cutoff:
                path.unlink()
                logger.info(f"[DB BACKUP] Ancienne sauvegarde supprimée : {path}")
        except Exception as e:
            logger.warning(f"[DB BACKUP] Impossible de nettoyer {path}: {e}")


def create_database_backup(reason="auto"):
    """Crée une sauvegarde cohérente de la DB via l'API sqlite backup."""
    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    backup_path = BACKUPS_DIR / f"shinybot_{timestamp}_{reason}.db"
    conn.commit()
    with sqlite3.connect(str(backup_path)) as backup_conn:
        conn.backup(backup_conn)
    cleanup_old_db_backups()
    logger.info(f"[DB BACKUP] Sauvegarde créée : {backup_path}")
    return backup_path


async def auto_daily_db_backup():
    """Sauvegarde automatiquement shinybot.db une fois par jour."""
    await bot.wait_until_ready()
    await asyncio.sleep(20)
    last_backup_date = None
    while not bot.is_closed():
        now = datetime.now()
        if now.hour >= BACKUP_HOUR and last_backup_date != now.date():
            try:
                await asyncio.to_thread(create_database_backup, "daily")
                last_backup_date = now.date()
            except Exception as e:
                logger.error(f"[DB BACKUP] Erreur sauvegarde quotidienne: {e}", exc_info=True)
        await asyncio.sleep(1800)


@bot.tree.command(
    name="admin_backup_db",
    description="[ADMIN] Créer immédiatement une sauvegarde de la base de données",
    guild=discord.Object(id=GUILD_ID)
)
async def admin_backup_db(interaction: discord.Interaction):
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ Réservé aux administrateurs.", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    try:
        backup_path = await asyncio.to_thread(create_database_backup, "manual")
        await interaction.followup.send(
            f"✅ Sauvegarde créée : `{backup_path.name}`\nDossier : `{BACKUPS_DIR}`",
            ephemeral=True
        )
    except Exception as e:
        logger.error(f"[DB BACKUP] Erreur sauvegarde manuelle: {e}", exc_info=True)
        await interaction.followup.send("❌ Impossible de créer la sauvegarde. Consulte les logs du bot.", ephemeral=True)


@bot.event
async def on_ready():
    logger.info(f"Connecté en tant que {bot.user} (ID: {bot.user.id})")
    logger.info("------")

    # Vérifier immédiatement la validité du token
    if not await check_bot_token_validity():
        logger.error("❌ Token invalide détecté au démarrage !")
        return

    # Attendre que Discord soit prêt (délai équilibré)
    await asyncio.sleep(10)  # Réduit de 20s à 10s pour une meilleure expérience
    
    guild = discord.Object(id=GUILD_ID)
    
    # Synchronisation avec le nouveau système de retry
    async def _sync_commands(**kwargs):
        synced = await bot.tree.sync(guild=guild)
        # Global sync to clear old commands like /ladder
        try:
            await bot.tree.sync()
            logger.info("Global sync done")
        except Exception as e:
            logger.warning(f"Global sync failed: {e}")
        logger.info(f"✅ Synchronisation réussie - {len(synced)} commandes")
        return synced
    
    result = await discord_retry_wrapper(
        _sync_commands,
        context="Command Sync"
    )
    
    if result is None:
        logger.error("❌ Échec de la synchronisation des commandes")
    
    # Démarrer la tâche de mise à jour des rôles
    bot.loop.create_task(background_role_updater())
    
    # Démarrer le tirage automatique des objectifs hebdomadaires
    bot.loop.create_task(auto_weekly_draw())
    bot.loop.create_task(auto_assign_weekly_choices())
    bot.loop.create_task(auto_scheduled_wanteds())

    # Démarrer le tirage automatique des objectifs mensuels
    bot.loop.create_task(auto_monthly_draw())

    # Démarrer la mise à jour automatique du classement challenge (toutes les 2h)
    bot.loop.create_task(auto_challenge_status_updater())
    
    # Démarrer la mise à jour automatique du classement guildes (toutes les heures)
    bot.loop.create_task(auto_guilde_classement_updater())

    # Démarrer la sauvegarde quotidienne de la base de données
    if not getattr(bot, "_db_backup_task_started", False):
        bot.loop.create_task(auto_daily_db_backup())
        bot._db_backup_task_started = True
        logger.info("✅ Sauvegarde quotidienne DB activée")

    # Démarrer la vérification quotidienne de la décote d'inactivité (Top 20)
    if not getattr(bot, "_inactivity_decay_task_started", False):
        bot.loop.create_task(background_inactivity_decay())
        bot._inactivity_decay_task_started = True
        logger.info("✅ Décote d'inactivité activée")

    # Démarrer le snapshot quotidien du classement (flèches de tendance ▲▼)
    if not getattr(bot, "_ladder_snapshot_task_started", False):
        bot.loop.create_task(background_ladder_snapshot())
        bot._ladder_snapshot_task_started = True
        logger.info("✅ Snapshot quotidien du classement activé")

    # Démarrer la surveillance des challenges type expirés (distribution auto des points)
    if not getattr(bot, "_type_challenge_watcher_started", False):
        bot.loop.create_task(background_type_challenge_watcher())
        bot._type_challenge_watcher_started = True
        logger.info("✅ Finalisation automatique des challenges type activée")

    # Réattacher la vue persistante de /shiny_points (survit aux redémarrages,
    # fonctionne pour tous les messages publics existants portant ce custom_id)
    if not getattr(bot, "_shiny_points_view_registered", False):
        try:
            bot.add_view(ShinyPointsView(personal=False))
            logger.info("✅ Vue persistante /shiny_points réattachée")
        except Exception as e:
            logger.error(f"Erreur réattachement vue /shiny_points: {e}", exc_info=True)
        bot._shiny_points_view_registered = True

    # Réattacher les vues persistantes des races ouvertes encore actives (survit aux redémarrages)
    if not getattr(bot, "_open_race_views_restored", False):
        try:
            restored = restore_active_open_race_views()
            logger.info(f"✅ {restored} vue(s) de race ouverte réattachée(s) après redémarrage")
        except Exception as e:
            logger.error(f"Erreur réattachement vues races ouvertes: {e}", exc_info=True)
        bot._open_race_views_restored = True

    # Nettoyer les images orphelines au démarrage
    cleanup_old_images()
    
    # Vérifier que les commandes sont bien enregistrées
    logger.info("Commandes enregistrées:")
    for cmd in bot.tree.get_commands(guild=guild):
        logger.info(f"- {cmd.name}")

# Vue pour la pagination des shinys personnels
class MesShinyView(discord.ui.View):
    def __init__(self, user_id, user, current_page=1):
        super().__init__(timeout=300)
        self.user_id = user_id
        self.user = user
        self.current_page = current_page
        self.per_page = 5
        self._interaction_cooldown = {}
        
    async def _check_cooldown(self, interaction, cooldown_time=2):
        """Vérifie le cooldown pour éviter le spam"""
        user_id = interaction.user.id
        current_time = time.time()
        
        if user_id in self._interaction_cooldown:
            if current_time - self._interaction_cooldown[user_id] < cooldown_time:
                await interaction.response.send_message("⏱️ Veuillez patienter avant d'utiliser à nouveau cette fonction.", ephemeral=True)
                return False
        
        self._interaction_cooldown[user_id] = current_time
        return True
        
    async def update_embed(self, interaction):
        """Met à jour l'embed avec la page actuelle"""
        shinys, total_shinys, total_pages = get_user_shinys(self.user_id, self.current_page, self.per_page)
        stats = get_user_stats(self.user_id)
        rank, total_points = get_user_rank(self.user_id)
        
        # Couleur basée sur le rang
        if rank == 1:
            color = discord.Color.gold()
        elif rank == 2:
            color = discord.Color.light_grey()
        elif rank == 3:
            color = discord.Color.from_rgb(205, 127, 50)
        elif rank and rank <= 8:
            color = discord.Color.purple()
        elif rank and rank <= 14:
            color = discord.Color.blue()
        else:
            color = discord.Color.green()
        
        embed = discord.Embed(
            title=f"✨ Collection Shiny de {self.user.display_name}",
            color=color,
            timestamp=datetime.now()
        )
        embed.set_author(name=self.user.display_name, icon_url=self.user.display_avatar.url)
        embed.set_thumbnail(url=self.user.display_avatar.url)
        
        # Statistiques générales
        rank_title = get_rank_title(rank) if rank else "🌟 Non classé"
        points_display = f"{total_points:.1f}" if total_points % 1 != 0 else f"{int(total_points)}"
        avg_points_display = f"{stats['avg_points']:.1f}" if stats['avg_points'] and stats['avg_points'] % 1 != 0 else f"{int(stats['avg_points']) if stats['avg_points'] else 0}"
        
        embed.add_field(
            name="📊 Statistiques Générales",
            value=f"**Rang:** #{rank if rank else 'N/A'} - {rank_title}\n"
                  f"**Points totaux:** {points_display} ⭐\n"
                  f"**Total Shinys:** {stats['total_shinys']}\n"
                  f"**Moyenne par Shiny:** {avg_points_display} pts",
            inline=False
        )
        
        # Compteurs par période
        embed.add_field(
            name="📅 Compteurs",
            value=f"**Aujourd'hui:** {stats['today_count']} shiny{'s' if stats['today_count'] > 1 else ''}\n"
                  f"**Cette semaine:** {stats['week_count']} shiny{'s' if stats['week_count'] > 1 else ''}\n"
                  f"**Ce mois:** {stats['month_count']} shiny{'s' if stats['month_count'] > 1 else ''}",
            inline=True
        )
        
        # Streaks
        streak_emoji = "🔥" if stats['current_streak'] > 0 else "💤"
        streak_text = f"{streak_emoji} **Streak actuel:** {stats['current_streak']} jour{'s' if stats['current_streak'] > 1 else ''}\n"
        streak_text += f"🏆 **Meilleur streak:** {stats['best_streak']} jour{'s' if stats['best_streak'] > 1 else ''}\n"
        streak_text += f"📆 **Jours avec shiny:** {stats['total_days_with_shiny']}"
        
        embed.add_field(
            name="⚡ Streaks & Activité",
            value=streak_text,
            inline=True
        )
        
        # Informations supplémentaires
        if stats['favorite_pokemon'] != "Aucun":
            embed.add_field(
                name="🎯 Préférences",
                value=f"**Pokémon favori:** {stats['favorite_pokemon']}\n"
                      f"**Meilleur Shiny:** {stats['best_shiny']} pts",
                inline=False
            )
        
        # Liste des shinys pour cette page
        if shinys:
            shiny_list = ""
            for i, shiny in enumerate(shinys):
                # shiny = (rowid, pokemon, game, methode, odds, date, points, created_at, language)
                rowid, pokemon, game, method_key, odds, date, points, created_at, language = shiny
                
                # Obtenir le nom de la méthode dans la langue appropriée
                method_display = method_key  # Fallback
                for game_key, game_translations in GAMES.items():
                    if (game_translations.get("fr") == game or 
                        game_translations.get("en") == game):
                        if game_key in METHODS_BY_GAME and method_key in METHODS_BY_GAME[game_key]:
                            lang_code = language if language in ["fr", "en"] else "fr"
                            method_display = METHODS_BY_GAME[game_key][method_key][lang_code]
                        break
                
                emoji = get_method_emoji(method_display)
                points_display = f"{points:.1f}" if points % 1 != 0 else f"{int(points)}"
                
                index = (self.current_page - 1) * self.per_page + i + 1
                shiny_list += f"**{index}.** {emoji} **{pokemon}** - {game}\n"
                shiny_list += f"     {method_display} • {points_display} pts • `{date}`\n\n"
            
            embed.add_field(
                name=f"📝 Liste des Shinys (Page {self.current_page}/{total_pages})",
                value=shiny_list,
                inline=False
            )
        else:
            embed.add_field(
                name="📝 Liste des Shinys",
                value="*Aucun shiny enregistré pour le moment*",
                inline=False
            )
        
        # Footer avec informations de pagination
        if total_pages > 1:
            embed.set_footer(text=f"Page {self.current_page}/{total_pages} • {total_shinys} shinys au total • ShinyBot")
        else:
            embed.set_footer(text=f"{total_shinys} shinys au total • ShinyBot")
        
        return embed
    
    async def _safe_interaction_response(self, interaction, embed, error_context):
        """Gestion sécurisée des réponses d'interaction"""
        async def _respond(**kwargs):
            await interaction.response.edit_message(embed=embed, view=self)
        
        result = await discord_retry_wrapper(
            _respond,
            context=error_context
        )
        
        if result is None:
            try:
                await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
            except:
                pass
    
    @discord.ui.button(label="⬅️ Précédent", style=discord.ButtonStyle.secondary)
    async def previous_page(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id != int(self.user_id):
            await interaction.response.send_message("❌ Vous ne pouvez pas naviguer dans la collection d'un autre utilisateur !", ephemeral=True)
            return
        
        if not await self._check_cooldown(interaction):
            return
            
        _, _, total_pages = get_user_shinys(self.user_id, 1, self.per_page)
        
        if self.current_page > 1:
            self.current_page -= 1
        else:
            self.current_page = total_pages  # Boucle vers la dernière page
        
        embed = await self.update_embed(interaction)
        await self._safe_interaction_response(interaction, embed, "Previous Page")
    
    @discord.ui.button(label="🔄 Actualiser", style=discord.ButtonStyle.primary)
    async def refresh(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id != int(self.user_id):
            await interaction.response.send_message("❌ Vous ne pouvez pas actualiser la collection d'un autre utilisateur !", ephemeral=True)
            return
        
        if not await self._check_cooldown(interaction):
            return
            
        embed = await self.update_embed(interaction)
        await self._safe_interaction_response(interaction, embed, "Refresh")
    
    @discord.ui.button(label="Suivant ➡️", style=discord.ButtonStyle.secondary)
    async def next_page(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id != int(self.user_id):
            await interaction.response.send_message("❌ Vous ne pouvez pas naviguer dans la collection d'un autre utilisateur !", ephemeral=True)
            return
        
        if not await self._check_cooldown(interaction):
            return
            
        _, _, total_pages = get_user_shinys(self.user_id, 1, self.per_page)
        
        if self.current_page < total_pages:
            self.current_page += 1
        else:
            self.current_page = 1  # Boucle vers la première page
        
        embed = await self.update_embed(interaction)
        await self._safe_interaction_response(interaction, embed, "Next Page")
    
    async def on_timeout(self):
        """Désactive tous les boutons quand la vue expire"""
        for item in self.children:
            if isinstance(item, discord.ui.Button):
                item.disabled = True

# Vue corrigée pour la sélection de langue et jeu - VERSION SIMPLIFIÉE
# ═══════════════════════════════════════════════════════════════════════════
# ══  /shiny_ajout — FLUX UNIQUE (un seul écran de saisie)                 ══
# ═══════════════════════════════════════════════════════════════════════════
# Ancien flux : langue → type de chasse → jeu → méthode → options → modal (6 étapes).
# Nouveau flux : UN écran (jeu, méthode, consoles, type, options) pré-rempli avec les
# dernières valeurs du joueur ; le nom du Pokémon est un paramètre de la commande
# (autocomplétion) ou se saisit dans un petit modal validé contre POKEMON_FR.
#
# Le résultat public est compact ; les boutons de contrôle (annuler / ajouter un
# autre / détail du calcul) sont dans un message éphémère visible du seul joueur.

SHINY_SESSION_MAX = 5  # nombre max de shinys ajoutés à la suite dans une même session

HUNT_TYPE_LABELS = {
    'emulators':    ('🖥️ Émulateurs', '🖥️ Emulators'),
    'consoles':     ('🎮 Consoles', '🎮 Consoles'),
    'console_mods': ('🎮 Consoles Mods', '🎮 Console Controller Mods'),
}
HUNT_TYPE_HINTS = {
    'emulators':    ('Utilise les multiplicateurs normaux', 'Uses normal multipliers'),
    'consoles':     ('Multiplicateurs spéciaux pour consoles', 'Special multipliers for consoles'),
    'console_mods': ('Utilise les multiplicateurs normaux', 'Uses normal multipliers'),
}


def _fr(language):
    return language == "Français"


def detect_language(interaction):
    """Langue déduite de la locale Discord du joueur (évite l'étape « choisis ta langue »)."""
    loc = getattr(interaction, 'locale', None) if interaction is not None else None
    code = str(getattr(loc, 'value', loc) or '').lower()
    return "Français" if code.startswith('fr') else "English"


def hunt_type_label(hunt_type, language):
    fr_label, en_label = HUNT_TYPE_LABELS.get(hunt_type, (hunt_type, hunt_type))
    return fr_label if _fr(language) else en_label


def max_console_choice(hunt_type):
    """Dernier palier (« N+ ») de la table calculate_console_multiplier :
    11+ pour émulateurs/mods (×0,15), 12+ pour consoles (×0,6).
    Avant : le select s'arrêtait à « 7+ » (compté comme 7) → 12 émulateurs étaient facturés ×0,55 au lieu de ×0,15."""
    return 12 if hunt_type == "consoles" else 11


_POKEMON_INDEX = None


def _pokemon_index():
    global _POKEMON_INDEX
    if _POKEMON_INDEX is None:
        _POKEMON_INDEX = {" ".join(normalize_str(p).split()): p for p in POKEMON_FR}
    return _POKEMON_INDEX


def resolve_pokemon_name(raw):
    """Valide une saisie contre POKEMON_FR (insensible à la casse/aux accents).
    Retourne (nom_canonique | None, [suggestions proches])."""
    index = _pokemon_index()
    key = " ".join(normalize_str((raw or "").strip()).split())
    if key in index:
        return index[key], []
    close = difflib.get_close_matches(key, list(index.keys()), n=3, cutoff=0.6)
    return None, [index[c] for c in close]


def parse_hunt_counter(raw):
    """Compteur de shasse → (valeur, ok). Tolère '1 234', '1.234', '1,234', "1'234"."""
    txt = (raw or "").strip()
    if not txt:
        return 0, True
    cleaned = re.sub(r"[\s.,_'’]", "", txt)
    if cleaned.isdigit():
        return int(cleaned), True
    return 0, False


def parse_spawn_strict(raw):
    """Taux de spawn (%) → (valeur | None, ok). Vide = ok (facultatif) ; invalide = ok False."""
    if not (raw or "").strip():
        return None, True
    pct = parse_spawn_rate_input(raw)
    if pct is None or pct <= 0 or pct > 100:
        return None, False
    return pct, True


@dataclass
class ShinySubmission:
    """Tout ce qu'il faut pour enregistrer un shiny (remplace les attributs de l'ancien modal)."""
    language: str
    game_key: str
    method_key: str
    hunt_type: str
    console_count: int
    mystery: bool
    pokemon: str
    hunt_counter: int
    spawn_pct: float | None
    type_pokemon: str | None
    shiny_count: int
    db_written: bool = False


def _unit_label(hunt_type, language, plural=True):
    if hunt_type == "emulators":
        return ("émulateurs" if plural else "émulateur") if _fr(language) else ("emulators" if plural else "emulator")
    return "consoles" if plural else "console"


class ShinyFormView(discord.ui.View):
    """Écran unique de saisie : jeu / méthode / consoles / type + boutons."""

    def __init__(self, *, owner_id, language, hunt_type, prefs, mystery_available=False,
                 game_key=None, method_key=None, console_count=1, type_pokemon=None,
                 mystery=False, pokemon=None, pokemon_raw=None, hunt_counter=0,
                 spawn_pct=None, shiny_count=1, warning=None):
        super().__init__(timeout=600)
        self.owner_id = owner_id
        self.language = language
        self.hunt_type = hunt_type
        self.prefs = prefs
        self.mystery_available = mystery_available
        self.game_key = game_key if game_key in GAMES else None
        self.method_key = method_key if (self.game_key and method_key in METHODS_BY_GAME.get(self.game_key, {})) else None
        self.console_count = min(max(1, int(console_count or 1)), max_console_choice(hunt_type))
        self.type_pokemon = type_pokemon
        self.mystery = bool(mystery and mystery_available)
        self.pokemon = pokemon            # nom validé (canonique)
        self.pokemon_raw = pokemon_raw    # saisie non reconnue, à corriger
        self.hunt_counter = hunt_counter
        self.spawn_pct = spawn_pct
        self.shiny_count = shiny_count
        self.warning = warning
        self._submitting = False
        self._build_items()

    # ── construction ─────────────────────────────────────────────────────────
    @classmethod
    def fresh(cls, *, owner_id, language, hunt_type, prefs, shiny_count=1, pokemon_raw=None):
        """Formulaire pré-rempli : dernier jeu + dernière méthode utilisés."""
        fr = _fr(language)
        recents = [g for g in prefs.get('recent_games', []) if g in GAMES]
        game_key = recents[0] if recents else None
        method_key = None
        if game_key:
            last = prefs.get('recent_methods', {}).get(game_key)
            if last in METHODS_BY_GAME.get(game_key, {}):
                method_key = last
        pokemon, warning = None, None
        if pokemon_raw and pokemon_raw.strip():
            canon, _sugg = resolve_pokemon_name(pokemon_raw)
            if canon:
                pokemon, pokemon_raw = canon, None
            else:
                warning = (f"❓ « {pokemon_raw.strip()} » n'est pas reconnu — clique sur **✅ Valider** pour le corriger."
                           if fr else
                           f"❓ \"{pokemon_raw.strip()}\" isn't recognised — click **✅ Confirm** to fix it.")
        else:
            pokemon_raw = None
        try:
            mystery_available = bool(get_active_mystery_wanteds())
        except Exception as e:
            logger.error(f"Erreur détection wanted mystère: {e}")
            mystery_available = False
        return cls(owner_id=owner_id, language=language, hunt_type=hunt_type, prefs=prefs,
                   mystery_available=mystery_available, game_key=game_key, method_key=method_key,
                   pokemon=pokemon, pokemon_raw=pokemon_raw, shiny_count=shiny_count, warning=warning)

    def clone(self, **changes):
        state = dict(
            owner_id=self.owner_id, language=self.language, hunt_type=self.hunt_type, prefs=self.prefs,
            mystery_available=self.mystery_available, game_key=self.game_key, method_key=self.method_key,
            console_count=self.console_count, type_pokemon=self.type_pokemon, mystery=self.mystery,
            pokemon=self.pokemon, pokemon_raw=self.pokemon_raw, hunt_counter=self.hunt_counter,
            spawn_pct=self.spawn_pct, shiny_count=self.shiny_count, warning=None,
        )
        state.update(changes)
        return ShinyFormView(**state)

    def _game_options(self):
        fr = _fr(self.language)
        lang = "fr" if fr else "en"
        recents = [g for g in self.prefs.get('recent_games', []) if g in GAMES]
        ordered = recents + [g for g in GAMES if g not in recents]
        options = []
        for gk in ordered:
            name = GAMES[gk][lang]
            is_recent = gk in recents
            options.append(discord.SelectOption(
                label=(f"⭐ {name}" if is_recent else name)[:100],
                value=gk,
                description=(("Utilisé récemment" if fr else "Recently used") if is_recent else None),
                default=(gk == self.game_key),
            ))
        if len(options) > 25:
            logger.warning(f"[shiny_ajout] {len(options)} jeux > 25 : le select est tronqué (ajouter un 2e select).")
            options = options[:25]
        return options

    def _method_options(self):
        fr = _fr(self.language)
        lang = "fr" if fr else "en"
        note_key = "note_fr" if fr else "note_en"
        options = []
        for mk, md in METHODS_BY_GAME[self.game_key].items():
            desc = md.get(note_key)
            options.append(discord.SelectOption(
                label=f"{md[lang]} ({md['points']} pts)"[:100],
                value=mk,
                description=(desc[:100] if desc else None),
                default=(mk == self.method_key),
            ))
        if len(options) > 25:
            logger.warning(f"[shiny_ajout] {len(options)} méthodes pour {self.game_key} : tronqué à 25.")
            options = options[:25]
        return options

    def _console_options(self):
        fr = _fr(self.language)
        top = max_console_choice(self.hunt_type)
        unit_p = _unit_label(self.hunt_type, self.language, plural=True)
        unit_s = _unit_label(self.hunt_type, self.language, plural=False)
        options = []
        for n in range(1, top + 1):
            mult = calculate_console_multiplier(n, self.hunt_type)
            label = f"{n}{'+' if n == top else ''} {unit_s if n == 1 else unit_p}"
            options.append(discord.SelectOption(
                label=label, value=str(n),
                description=(f"×{mult:g} des points de base" if fr else f"×{mult:g} of base points"),
                default=(n == self.console_count),
            ))
        return options

    def _build_items(self):
        fr = _fr(self.language)

        game_sel = discord.ui.Select(
            placeholder="🎮 Choisir le jeu" if fr else "🎮 Choose the game",
            options=self._game_options(), row=0)
        game_sel.callback = self.on_game
        self.add_item(game_sel)

        if self.game_key:
            method_sel = discord.ui.Select(
                placeholder="🎯 Choisir la méthode" if fr else "🎯 Choose the method",
                options=self._method_options(), row=1)
            method_sel.callback = self.on_method
        else:
            method_sel = discord.ui.Select(
                placeholder="🎯 Choisis d'abord le jeu" if fr else "🎯 Pick the game first",
                options=[discord.SelectOption(label="—", value="_")], disabled=True, row=1)
        self.add_item(method_sel)

        console_sel = discord.ui.Select(
            placeholder="🖥️ Nombre de consoles/émulateurs" if fr else "🖥️ Number of consoles/emulators",
            options=self._console_options(), row=2)
        console_sel.callback = self.on_console
        self.add_item(console_sel)

        type_sel = discord.ui.Select(
            placeholder=(f"🔷 Type : {self.type_pokemon}" if self.type_pokemon
                         else ("🔷 Type du Pokémon (facultatif)" if fr else "🔷 Pokémon type (optional)")),
            options=[discord.SelectOption(label=f"{tfr} / {ten}", value=tfr, default=(tfr == self.type_pokemon))
                     for tfr, ten in POKEMON_TYPES],
            min_values=0, max_values=1, row=3)
        type_sel.callback = self.on_type
        self.add_item(type_sel)

        ready = bool(self.game_key and self.method_key)
        validate = discord.ui.Button(
            label="✅ Valider" if fr else "✅ Confirm",
            style=discord.ButtonStyle.success, disabled=not ready, row=4)
        validate.callback = self.on_validate
        self.add_item(validate)

        details = discord.ui.Button(
            label=("✏️ Pokémon & détails" if fr else "✏️ Pokémon & details"),
            style=discord.ButtonStyle.secondary, row=4)
        details.callback = self.on_details
        self.add_item(details)

        if self.mystery_available:
            state = (("Activé" if fr else "On") if self.mystery else ("Désactivé" if fr else "Off"))
            mystery_btn = discord.ui.Button(
                label=(f"🔮 Wanted Mystère : {state}" if fr else f"🔮 Mystery Wanted: {state}"),
                style=discord.ButtonStyle.success if self.mystery else discord.ButtonStyle.secondary, row=4)
            mystery_btn.callback = self.on_mystery
            self.add_item(mystery_btn)

        self.add_item(discord.ui.Button(
            label="🔗 Taux de spawn" if fr else "🔗 Spawn rates",
            url=SPAWN_RATE_PARTNER_URL, row=4))

        prefs_btn = discord.ui.Button(
            label="🔧 Préférences" if fr else "🔧 Preferences",
            style=discord.ButtonStyle.secondary, row=4)
        prefs_btn.callback = self.on_prefs
        self.add_item(prefs_btn)

    # ── affichage ────────────────────────────────────────────────────────────
    def build_embed(self):
        fr = _fr(self.language)
        lang = "fr" if fr else "en"
        title = "✨ Ajouter un Shiny" if fr else "✨ Add a Shiny"
        if self.shiny_count > 1:
            title += f" ({self.shiny_count}/{SHINY_SESSION_MAX})"
        ask = "*saisi à la validation*" if fr else "*asked on confirm*"
        pick = "*à choisir*" if fr else "*to pick*"

        if self.pokemon:
            poke_txt = f"**{self.pokemon}**"
        elif self.pokemon_raw:
            poke_txt = f"❓ {self.pokemon_raw}"
        else:
            poke_txt = ask
        game_txt = f"**{GAMES[self.game_key][lang]}**" if self.game_key else pick
        if self.game_key and self.method_key:
            md = METHODS_BY_GAME[self.game_key][self.method_key]
            method_txt = f"**{md[lang]}** ({md['points']} pts)"
        else:
            method_txt = pick

        console_mult = calculate_console_multiplier(self.console_count, self.hunt_type)
        unit = _unit_label(self.hunt_type, self.language, plural=self.console_count > 1)
        lines = [
            f"**Pokémon :** {poke_txt}" if fr else f"**Pokémon:** {poke_txt}",
            f"**Jeu :** {game_txt}" if fr else f"**Game:** {game_txt}",
            f"**Méthode :** {method_txt}" if fr else f"**Method:** {method_txt}",
            (f"**Chasse :** {hunt_type_label(self.hunt_type, self.language)} · "
             f"{self.console_count} {unit} (×{console_mult:g})") if fr else
            (f"**Hunt:** {hunt_type_label(self.hunt_type, self.language)} · "
             f"{self.console_count} {unit} (×{console_mult:g})"),
        ]
        extras = []
        if self.type_pokemon:
            extras.append(f"🔷 {self.type_pokemon}")
        if self.hunt_counter:
            extras.append(f"🔢 {self.hunt_counter:,}".replace(",", " "))
        spawn_mult = get_spawn_rate_multiplier(self.spawn_pct)
        if self.spawn_pct is not None:
            extras.append(f"🌱 {self.spawn_pct:g} % (×{spawn_mult:.2f})")
        if self.mystery:
            extras.append("🔮 " + ("Wanted Mystère" if fr else "Mystery Wanted"))
        if extras:
            lines.append(" · ".join(extras))
        if self.game_key and self.method_key:
            est = round(calculate_points(self.game_key, self.method_key, self.console_count, self.hunt_type) * spawn_mult, 2)
            lines.append("📐 " + (f"Base estimée : **{est:g} pts** (avant bonus et caps)" if fr
                                 else f"Estimated base: **{est:g} pts** (before bonuses and caps)"))
        if self.warning:
            lines.append("")
            lines.append(self.warning)

        embed = discord.Embed(title=title, description="\n".join(lines), color=discord.Color.gold())
        embed.set_footer(text=(
            "Le taux de spawn (%) est facultatif : clique sur ✏️ pour le saisir · 🔧 pour changer langue / type de chasse."
            if fr else
            "Spawn rate (%) is optional: click ✏️ to enter it · 🔧 to change language / hunt type."))
        return embed

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        if interaction.user.id != self.owner_id:
            try:
                await interaction.response.send_message(
                    "❌ Ce formulaire n'est pas le tien." if _fr(self.language) else "❌ This form isn't yours.",
                    ephemeral=True)
            except Exception:
                pass
            return False
        return True

    async def _refresh(self, interaction, **changes):
        new = self.clone(**changes)
        try:
            await interaction.response.edit_message(embed=new.build_embed(), view=new)
        except Exception as e:
            logger.error(f"ShinyFormView refresh: {e}")

    # ── callbacks ────────────────────────────────────────────────────────────
    async def on_game(self, interaction: discord.Interaction):
        game_key = (interaction.data.get('values') or [None])[0]
        if game_key not in GAMES:
            return await self._refresh(interaction)
        last = self.prefs.get('recent_methods', {}).get(game_key)
        method_key = last if last in METHODS_BY_GAME.get(game_key, {}) else None
        await self._refresh(interaction, game_key=game_key, method_key=method_key)

    async def on_method(self, interaction: discord.Interaction):
        await self._refresh(interaction, method_key=(interaction.data.get('values') or [None])[0])

    async def on_console(self, interaction: discord.Interaction):
        try:
            n = int((interaction.data.get('values') or ["1"])[0])
        except ValueError:
            n = 1
        await self._refresh(interaction, console_count=n)

    async def on_type(self, interaction: discord.Interaction):
        values = interaction.data.get('values') or []
        await self._refresh(interaction, type_pokemon=(values[0] if values else None))

    async def on_mystery(self, interaction: discord.Interaction):
        await self._refresh(interaction, mystery=not self.mystery)

    async def on_details(self, interaction: discord.Interaction):
        await interaction.response.send_modal(ShinyDetailsModal(self, submit_after=False))

    async def on_prefs(self, interaction: discord.Interaction):
        view = ShinyPrefsView(owner_id=self.owner_id, language=self.language, hunt_type=self.hunt_type,
                              prefs=self.prefs, back_form=self)
        await interaction.response.edit_message(embed=view.build_embed(), view=view)

    async def on_validate(self, interaction: discord.Interaction):
        if not (self.game_key and self.method_key):
            return await self._refresh(interaction)
        if not self.pokemon:
            # Nom pas encore saisi (ou non reconnu) → petit modal, puis soumission automatique
            return await interaction.response.send_modal(ShinyDetailsModal(self, submit_after=True))
        await self.submit(interaction)

    # ── soumission ───────────────────────────────────────────────────────────
    async def submit(self, interaction: discord.Interaction):
        """Verrouille l'écran (anti double-clic), enregistre le shiny puis remplace l'écran
        par le message éphémère de contrôle."""
        if self._submitting:
            return
        self._submitting = True
        fr = _fr(self.language)
        s = ShinySubmission(
            language=self.language, game_key=self.game_key, method_key=self.method_key,
            hunt_type=self.hunt_type, console_count=self.console_count, mystery=self.mystery,
            pokemon=self.pokemon, hunt_counter=self.hunt_counter, spawn_pct=self.spawn_pct,
            type_pokemon=self.type_pokemon, shiny_count=self.shiny_count)
        try:
            await interaction.response.edit_message(
                embed=discord.Embed(
                    title="⏳ Enregistrement…" if fr else "⏳ Saving…",
                    description=f"**{self.pokemon}**", color=discord.Color.light_grey()),
                view=None)
        except Exception as e:
            logger.error(f"Impossible de verrouiller le formulaire shiny: {e}")
            self._submitting = False
            return
        await run_shiny_flow(interaction, s, self)


class ShinyDetailsModal(discord.ui.Modal):
    """Nom du Pokémon + compteur + taux de spawn (les seuls champs à saisir au clavier)."""

    def __init__(self, form, submit_after=False):
        fr = _fr(form.language)
        super().__init__(title="Détails du shiny" if fr else "Shiny details")
        self.form = form
        self.submit_after = submit_after
        self.pokemon_in = discord.ui.TextInput(
            label="Nom du Pokémon" if fr else "Pokémon name",
            placeholder="Ex : Pikachu", required=True, max_length=50,
            default=(form.pokemon or form.pokemon_raw or None))
        self.add_item(self.pokemon_in)
        self.counter_in = discord.ui.TextInput(
            label="Compteur de la shasse (rencontres/resets)" if fr else "Hunt counter (encounters/resets)",
            placeholder="Ex : 1234 (facultatif)" if fr else "Ex: 1234 (optional)",
            required=False, max_length=15,
            default=(str(form.hunt_counter) if form.hunt_counter else None))
        self.add_item(self.counter_in)
        self.spawn_in = discord.ui.TextInput(
            label="Taux de spawn du Pokémon (%)" if fr else "Pokémon spawn rate (%)",
            placeholder="Ex : 8 (facultatif)" if fr else "Ex: 8 (optional)",
            required=False, max_length=6,
            default=(f"{form.spawn_pct:g}" if form.spawn_pct is not None else None))
        self.add_item(self.spawn_in)

    async def on_submit(self, interaction: discord.Interaction):
        form = self.form
        fr = _fr(form.language)
        warnings = []

        counter, counter_ok = parse_hunt_counter(self.counter_in.value)
        if not counter_ok:
            warnings.append("⚠️ Compteur non reconnu (chiffres uniquement) — ignoré." if fr
                            else "⚠️ Counter not recognised (digits only) — ignored.")
        spawn_pct, spawn_ok = parse_spawn_strict(self.spawn_in.value)
        if not spawn_ok:
            warnings.append("⚠️ Taux de spawn invalide (nombre entre 0 et 100) — ignoré, aucun bonus appliqué." if fr
                            else "⚠️ Invalid spawn rate (number between 0 and 100) — ignored, no bonus applied.")
        form.hunt_counter = counter
        form.spawn_pct = spawn_pct

        raw_name = (self.pokemon_in.value or "").strip()
        canon, suggestions = resolve_pokemon_name(raw_name)
        if canon:
            form.pokemon, form.pokemon_raw = canon, None
            if self.submit_after and not warnings:
                return await form.submit(interaction)
            new = form.clone(warning="\n".join(warnings) or None)
            try:
                await interaction.response.edit_message(embed=new.build_embed(), view=new)
            except Exception as e:
                logger.error(f"ShinyDetailsModal refresh: {e}")
            return

        # Nom non reconnu → suggestions
        form.pokemon, form.pokemon_raw = None, raw_name
        view = PokemonSuggestView(form, raw_name, suggestions, self.submit_after)
        try:
            await interaction.response.edit_message(embed=view.build_embed(warnings), view=view)
        except Exception as e:
            logger.error(f"ShinyDetailsModal suggestions: {e}")


class PokemonSuggestView(discord.ui.View):
    """« Tu voulais dire … ? » quand le nom saisi n'est pas dans POKEMON_FR."""

    def __init__(self, form, raw, suggestions, submit_after):
        super().__init__(timeout=600)
        self.form = form
        self.raw = raw
        self.suggestions = suggestions
        self.submit_after = submit_after
        fr = _fr(form.language)
        for name in suggestions[:3]:
            btn = discord.ui.Button(label=name[:80], style=discord.ButtonStyle.primary)
            btn.callback = self._make_pick(name)
            self.add_item(btn)
        keep = discord.ui.Button(
            label=(f"Garder « {raw[:40]} »" if fr else f"Keep \"{raw[:40]}\""), style=discord.ButtonStyle.secondary)
        keep.callback = self._make_pick(raw)
        self.add_item(keep)
        fix = discord.ui.Button(label="✏️ Corriger" if fr else "✏️ Edit", style=discord.ButtonStyle.secondary)
        fix.callback = self.on_fix
        self.add_item(fix)

    def build_embed(self, warnings=None):
        fr = _fr(self.form.language)
        if self.suggestions:
            txt = ((f"« **{self.raw}** » n'est pas dans la liste.\nTu voulais dire l'un de ceux-là ?") if fr
                   else (f"\"**{self.raw}**\" isn't in the list.\nDid you mean one of these?"))
        else:
            txt = ((f"« **{self.raw}** » n'est pas dans la liste et rien de proche n'a été trouvé.\n"
                    f"Vérifie l'orthographe (noms français), ou garde-le tel quel s'il est correct.") if fr
                   else (f"\"**{self.raw}**\" isn't in the list and nothing close was found.\n"
                         f"Check the spelling (French names), or keep it as is if it's correct."))
        if warnings:
            txt += "\n\n" + "\n".join(warnings)
        return discord.Embed(title="❓ Pokémon non reconnu" if fr else "❓ Unrecognised Pokémon",
                             description=txt, color=discord.Color.orange())

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        return interaction.user.id == self.form.owner_id

    def _make_pick(self, name):
        async def _pick(interaction: discord.Interaction):
            self.form.pokemon, self.form.pokemon_raw = name, None
            if self.submit_after:
                return await self.form.submit(interaction)
            new = self.form.clone()
            try:
                await interaction.response.edit_message(embed=new.build_embed(), view=new)
            except Exception as e:
                logger.error(f"PokemonSuggestView pick: {e}")
        return _pick

    async def on_fix(self, interaction: discord.Interaction):
        self.form.pokemon_raw = self.raw
        await interaction.response.send_modal(ShinyDetailsModal(self.form, submit_after=self.submit_after))


class ShinyPrefsView(discord.ui.View):
    """Langue + type de chasse (première utilisation, ou bouton 🔧 du formulaire)."""

    def __init__(self, *, owner_id, language, hunt_type, prefs, first_time=False, back_form=None,
                 pokemon_raw=None, shiny_count=1):
        super().__init__(timeout=600)
        self.owner_id = owner_id
        self.language = language
        self.hunt_type = hunt_type or "emulators"
        self.prefs = prefs
        self.first_time = first_time
        self.back_form = back_form
        self.pokemon_raw = pokemon_raw
        self.shiny_count = shiny_count
        fr = _fr(language)

        lang_sel = discord.ui.Select(
            placeholder="🌐 Langue / Language",
            options=[discord.SelectOption(label="Français", value="Français", emoji="🇫🇷", default=(language == "Français")),
                     discord.SelectOption(label="English", value="English", emoji="🇬🇧", default=(language == "English"))],
            row=0)
        lang_sel.callback = self.on_language
        self.add_item(lang_sel)

        hunt_sel = discord.ui.Select(
            placeholder="🎮 Type de chasse" if fr else "🎮 Hunt type",
            options=[discord.SelectOption(
                label=hunt_type_label(k, language).replace("🖥️ ", "").replace("🎮 ", ""),
                value=k,
                description=HUNT_TYPE_HINTS[k][0 if fr else 1],
                default=(k == self.hunt_type)) for k in HUNT_TYPE_LABELS],
            row=1)
        hunt_sel.callback = self.on_hunt
        self.add_item(hunt_sel)

        ok = discord.ui.Button(label="✅ Continuer" if fr else "✅ Continue", style=discord.ButtonStyle.success, row=2)
        ok.callback = self.on_ok
        self.add_item(ok)

    def build_embed(self):
        fr = _fr(self.language)
        if self.first_time:
            desc = (
                "👋 **Première utilisation** — deux réglages, mémorisés pour la suite :\n"
                "• **Langue** de l'affichage\n"
                "• **Type de chasse** : il change le calcul des points selon ton nombre de consoles/émulateurs.\n\n"
                "Tu pourras les modifier à tout moment avec **🔧 Préférences**."
                if fr else
                "👋 **First use** — two settings, remembered for next time:\n"
                "• Display **language**\n"
                "• **Hunt type**: it changes how points are computed from your number of consoles/emulators.\n\n"
                "You can change them at any time with **🔧 Preferences**.")
        else:
            desc = ("Change ta langue ou ton type de chasse, puis reviens au formulaire." if fr
                    else "Change your language or hunt type, then go back to the form.")
        return discord.Embed(title="🔧 Préférences" if fr else "🔧 Preferences", description=desc,
                             color=discord.Color.gold())

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        return interaction.user.id == self.owner_id

    def _copy(self, **changes):
        state = dict(owner_id=self.owner_id, language=self.language, hunt_type=self.hunt_type, prefs=self.prefs,
                     first_time=self.first_time, back_form=self.back_form, pokemon_raw=self.pokemon_raw,
                     shiny_count=self.shiny_count)
        state.update(changes)
        return ShinyPrefsView(**state)

    async def on_language(self, interaction: discord.Interaction):
        new = self._copy(language=(interaction.data.get('values') or [self.language])[0])
        await interaction.response.edit_message(embed=new.build_embed(), view=new)

    async def on_hunt(self, interaction: discord.Interaction):
        new = self._copy(hunt_type=(interaction.data.get('values') or [self.hunt_type])[0])
        await interaction.response.edit_message(embed=new.build_embed(), view=new)

    async def on_ok(self, interaction: discord.Interaction):
        save_user_preferences(str(self.owner_id), language=self.language, hunt_type=self.hunt_type)
        prefs = get_user_preferences(str(self.owner_id))
        if self.back_form is not None:
            form = self.back_form.clone(language=self.language, hunt_type=self.hunt_type, prefs=prefs)
        else:
            form = ShinyFormView.fresh(owner_id=self.owner_id, language=self.language, hunt_type=self.hunt_type,
                                       prefs=prefs, shiny_count=self.shiny_count, pokemon_raw=self.pokemon_raw)
        await interaction.response.edit_message(embed=form.build_embed(), view=form)


def build_shiny_entry(user_id, interaction=None, pokemon=None, forced_language=None):
    """Point d'entrée unique du flux d'ajout (commandes /shiny_ajout, /add_myshiny et menu).
    Retourne (embed, view)."""
    prefs = get_user_preferences(str(user_id))
    language = forced_language or prefs['language'] or detect_language(interaction)
    hunt_type = prefs['hunt_type']
    if not hunt_type:
        view = ShinyPrefsView(owner_id=user_id, language=language, hunt_type="emulators", prefs=prefs,
                              first_time=True, pokemon_raw=pokemon)
        return view.build_embed(), view
    form = ShinyFormView.fresh(owner_id=user_id, language=language, hunt_type=hunt_type, prefs=prefs,
                               pokemon_raw=pokemon)
    return form.build_embed(), form


# ───────────────────────────────────────────────────────────────────────────
# Enregistrement du shiny — 2 phases séparées :
#   1) _apply_shiny_to_db : écritures en base, exécutées UNE seule fois (jamais rejouées) ;
#   2) _send_shiny_result : messages Discord, rejouables sans risque (discord_retry_wrapper).
# Avant, tout était dans une seule fonction rejouée par le wrapper : une erreur Discord
# transitoire après add_shiny() pouvait enregistrer le shiny deux fois.
# ───────────────────────────────────────────────────────────────────────────

async def _apply_shiny_to_db(interaction, s):
    """Phase 1. Retourne un dict de résultats, ou {'error': message} (rien n'est enregistré)."""
    date_obj = datetime.now()
    date_formatted = date_obj.strftime("%d-%m-%Y")

    # Nombre de consoles/émulateurs : déjà validé en amont via le Select du formulaire (ShinyFormView)
    console_count = s.console_count if s.console_count and s.console_count >= 1 else 1

    # Compteur de la shasse : déjà nettoyé/validé par le modal
    hunt_counter = s.hunt_counter

    # Ce shiny est-il chassé pour un wanted mystère ? (toggle choisi en amont)
    is_for_mystery_wanted = s.mystery

    # Taux de spawn (%) saisi par le joueur → multiplicateur de points
    spawn_pct = s.spawn_pct
    spawn_multiplier = get_spawn_rate_multiplier(spawn_pct)

    points = calculate_points(s.game_key, s.method_key, console_count, s.hunt_type)
    if spawn_multiplier != 1.0:
        points = round(points * spawn_multiplier, 2)
    game_name = GAMES[s.game_key]["fr" if s.language == "Français" else "en"]

    # Récupérer le nom de la méthode dans la langue choisie
    lang_code = "fr" if s.language == "Français" else "en"
    method_name = METHODS_BY_GAME[s.game_key][s.method_key][lang_code]

    # Validations spécifiques pour Z-A
    if s.game_key == "za":
        # Vérifier si c'est un doublon pendant la saison
        if check_duplicate_shiny_za(str(interaction.user.id), s.pokemon):
            error_msg = "❌ Ce shiny est déjà enregistré pour Z-A (toutes méthodes) et ne compte pas." if s.language == "Français" else "❌ This shiny is already recorded for Z-A (all methods) and doesn't count."
            return {'error': error_msg}

    # Récupérer le rang AVANT l'ajout du shiny
    old_rank, old_points = get_user_rank(str(interaction.user.id))
    badge_codes_before = {b[0] for b in get_user_badges(str(interaction.user.id))}
    
    # Ajouter le shiny (avec vérification du wanted)
    # _type_pokemon est stocké dans l'instance du modal (pas d'attribut global = pas de race condition)
    total_points, bonus_points, is_wanted, objective_bonuses, special_bonuses = add_shiny(
        str(interaction.user.id), s.pokemon, game_name, s.method_key,
        date_formatted, points, lang_code, console_count, hunt_counter, s.hunt_type,
        type_pokemon=s.type_pokemon,
        for_mystery_wanted=is_for_mystery_wanted
    )
    # Le shiny est en base : ne surtout pas le réenregistrer en cas d'erreur ultérieure.
    s.db_written = True
    # Snapshot IMMÉDIAT des attributs _last_* (add_shiny est synchrone : aucun await entre
    # l'appel et cette copie, donc pas de mélange possible entre deux joueurs simultanés).
    _snap = {k: v for k, v in vars(add_shiny).items() if k.startswith('_last_')}
    mystery_reveals = _snap.get('_last_mystery_reveals', [])
    bounty_events = _snap.get('_last_bounty_events', [])
    parrain_notify = _snap.get('_last_parrain_notify', None)
    if parrain_notify:
        _pn_id, _pn_filleul_eff, _pn_parrain_eff = parrain_notify
        asyncio.create_task(notify_parrain_bonus(
            _pn_id, interaction.user, s.pokemon,
            filleul_effective=_pn_filleul_eff, parrain_effective=_pn_parrain_eff
        ))

    # Mémoriser les préférences de l'utilisateur pour accélérer le prochain ajout
    save_user_preferences(
        str(interaction.user.id),
        language=s.language,
        hunt_type=s.hunt_type,
        game_key=s.game_key,
        method_key=s.method_key,
    )
    
    # Vérifier toutes les races 1v1 actives pour ce Pokémon (multi-adversaires inclus)
    race_bonus_points = 0
    race_won = False
    race_malus_total = 0
    all_races = get_all_active_races_for_user_and_pokemon(str(interaction.user.id), s.pokemon)
    for race_info in all_races:
        mark_race_won(race_info['id'], str(interaction.user.id))
        # mark_race_won insère déjà le malus au perdant
        _race_eff = apply_bonus_diminishing_returns(str(interaction.user.id), float(race_info['bonus_points']))
        add_user_weekly_bonus_pts(str(interaction.user.id), float(race_info['bonus_points']))
        race_bonus_points += _race_eff
        race_won = True
        cursor.execute(
            "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter, hunt_type) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?, ?, ?, ?)",
            (str(interaction.user.id), f"[Race Bonus] {s.pokemon}", game_name, "race_bonus", date_formatted, _race_eff, lang_code, 1, 0, s.hunt_type)
        )
        conn.commit()
    if race_won:
        try:
            update_race_win_objective(str(interaction.user.id))
            update_monthly_race_win_objective(str(interaction.user.id))
        except Exception as e:
            logger.error(f"Erreur objectif race_win: {e}")

    # Vérifier les races ouvertes actives (nouveau système, participants illimités)
    open_race_matches = get_active_open_races_for_user_and_pokemon(str(interaction.user.id), s.pokemon)
    for race_info in open_race_matches:
        # Le jeu doit correspondre à celui de la race (corrige un ancien manque de vérification)
        if race_info['game'] and normalize_str(race_info['game']) != normalize_str(game_name):
            continue
        # Si la race impose une méthode précise, elle doit correspondre
        if race_info['method_key'] and race_info['method_key'] != s.method_key:
            continue
        # Si la race impose un nombre de consoles max, il ne doit pas être dépassé
        if race_info['max_consoles'] and console_count and console_count > race_info['max_consoles']:
            continue
        finished = finish_open_race(race_info['id'], str(interaction.user.id))
        if not finished:
            continue  # déjà remportée entre-temps par quelqu'un d'autre
        if finished['awarded_points'] > 0:
            _race_eff2 = apply_bonus_diminishing_returns(str(interaction.user.id), float(finished['awarded_points']))
            add_user_weekly_bonus_pts(str(interaction.user.id), float(finished['awarded_points']))
            race_bonus_points += _race_eff2
            race_won = True
            cursor.execute(
                "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter, hunt_type) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?, ?, ?, ?)",
                (str(interaction.user.id), f"[Race Ouverte] {s.pokemon}", game_name, "race_bonus", date_formatted, _race_eff2, lang_code, 1, 0, s.hunt_type)
            )
            conn.commit()
            try:
                update_race_win_objective(str(interaction.user.id))
                update_monthly_race_win_objective(str(interaction.user.id))
            except Exception as e:
                logger.error(f"Erreur objectif race_win (ouverte): {e}")
        # Race terminée dans tous les cas (même sans récompense si un seul participant)
        asyncio.create_task(close_open_race_message(race_info['id'], winner_member=interaction.user))

    # Vérifier si une race en équipe est en cours pour ce Pokémon
    team_race_bonus = 0
    team_race_msg = None
    try:
        guild = bot.get_guild(GUILD_ID)
        team_race_bonus, team_race_msg = await handle_team_race_point(str(interaction.user.id), s.pokemon, guild)
        if team_race_msg:
            channel = bot.get_channel(SALON_CLASSEMENT_ID)
            if channel:
                await channel.send(team_race_msg)
        # Si la race équipe est gagnée, mettre à jour objectif race_win
        if team_race_bonus > 0:
            try:
                update_race_win_objective(str(interaction.user.id))
            except Exception as e:
                logger.error(f"Erreur objectif race_win équipe: {e}")
    except Exception as e:
        logger.error(f"Erreur handle_team_race_point: {e}")

    try:
        check_and_award_badges(str(interaction.user.id))
        new_badges = get_new_badges_since(str(interaction.user.id), badge_codes_before)
    except Exception as e:
        logger.error(f"Erreur récupération nouveaux badges: {e}")
        new_badges = []
    
    # Calculer le nom affiché (masqué si wanted mystère)
    cursor.execute("""
        SELECT id FROM shiny_wanted
        WHERE is_active=1 AND LOWER(pokemon_name)=LOWER(?)
        AND indice IS NOT NULL AND indice != ''
    """, (s.pokemon,))
    _myst_row = cursor.fetchone()
    if _myst_row:
        cursor.execute("SELECT indice FROM shiny_wanted WHERE id=?", (_myst_row[0],))
        _myst_ind = cursor.fetchone()
        _is_mystery = _myst_ind and _myst_ind[0] and not _myst_ind[0].strip().startswith("[Méthode :")
    else:
        _is_mystery = False
    _display_pokemon = "???" if _is_mystery else s.pokemon

    # Vérifier si le rang a changé
    rank_change_data = check_rank_change(str(interaction.user.id), old_rank, old_points)
    if rank_change_data:
        # Envoyer le message de félicitations en arrière-plan
        lang_code_for_msg = lang_code if lang_code else "fr"
        asyncio.create_task(send_rank_up_message(
            interaction.user, 
            rank_change_data, 
            _display_pokemon, 
            points, 
            lang_code_for_msg
        ))

    # Vérifier si le rang de progression personnel a changé (indépendant du classement)
    _new_rank_ignored, _new_total_pts = get_user_rank(str(interaction.user.id))
    _progression_change = check_progression_tier_change(old_points, _new_total_pts)
    if _progression_change:
        lang_code_for_msg = lang_code if lang_code else "fr"
        asyncio.create_task(send_progression_rank_up_message(
            interaction.user, _progression_change, _display_pokemon, points, lang_code_for_msg
        ))

    return {
        'date_obj': date_obj, 'date_formatted': date_formatted,
        'console_count': console_count, 'hunt_counter': hunt_counter,
        'spawn_pct': spawn_pct, 'spawn_multiplier': spawn_multiplier, 'points': points,
        'game_name': game_name, 'method_name': method_name, 'lang_code': lang_code,
        'total_points': total_points, 'bonus_points': bonus_points, 'is_wanted': is_wanted,
        'objective_bonuses': objective_bonuses, 'special_bonuses': special_bonuses,
        'snap': _snap, 'mystery_reveals': mystery_reveals, 'bounty_events': bounty_events,
        'race_won': race_won, 'race_bonus_points': race_bonus_points, 'nb_races': len(all_races),
        'team_race_msg': team_race_msg, 'team_race_bonus': team_race_bonus,
        'new_badges': new_badges, 'display_pokemon': _display_pokemon,
        'old_rank': old_rank, 'rank_change_data': rank_change_data,
    }


async def _send_shiny_result(interaction, s, r):
    """Phase 2 : construit l'annonce publique compacte + le récapitulatif éphémère, puis envoie l'annonce."""
    is_fr = _fr(s.language)

    def t(fr_txt, en_txt):
        return fr_txt if is_fr else en_txt

    member = interaction.user
    user_id = str(member.id)
    snap = r['snap']
    total_points, bonus_points, is_wanted = r['total_points'], r['bonus_points'], r['is_wanted']
    objective_bonuses, special_bonuses = r['objective_bonuses'], r['special_bonuses']
    console_count, hunt_counter = r['console_count'], r['hunt_counter']
    spawn_pct, spawn_multiplier = r['spawn_pct'], r['spawn_multiplier']
    race_won, race_bonus_points = r['race_won'], r['race_bonus_points']
    team_race_msg = r['team_race_msg']

    sp_total = sum(pts for _, pts in special_bonuses)
    obj_total = sum(pts for _, pts in objective_bonuses)
    race_total = race_bonus_points
    # total_points = shiny effectif (après soft cap) + wanted serveur ; les bonus spéciaux,
    # objectifs et races sont insérés séparément en base et s'y ajoutent.
    grand_total = round(total_points + sp_total + obj_total + race_total, 2)
    weekly = get_user_weekly_pts(user_id)

    # ── Détail du calcul (bouton 🧮) : méthode × consoles × spawn, puis le reste ──
    pos_mult = snap.get('_last_pos_mult', 1.0)
    method_pts = METHODS_BY_GAME[s.game_key][s.method_key]["points"]
    console_mult = calculate_console_multiplier(console_count, s.hunt_type)
    pts_base = round(r['points'], 2)
    calc = [t(f"**{method_pts:g}** ⭐ (méthode)", f"**{method_pts:g}** ⭐ (method)")]
    if console_mult != 1.0:
        calc.append(f"× **{console_mult:g}** 🖥️ ({console_count} {_unit_label(s.hunt_type, s.language, console_count > 1)})")
    if spawn_multiplier != 1.0:
        calc.append(f"× **{spawn_multiplier:.2f}** 🌱 ({t('spawn', 'spawn')} {spawn_pct:g} %)")
    if console_mult != 1.0 or spawn_multiplier != 1.0:
        calc.append(f"= **{pts_base:g}** ⭐ (base)")
    if snap.get('_last_new_game_bonus'):
        calc.append(t(f"+ **{round(pts_base * 0.10, 2):g}** 🗺️ (nouveau jeu +10%)",
                      f"+ **{round(pts_base * 0.10, 2):g}** 🗺️ (new game +10%)"))
    ev_mult = snap.get('_last_event_mult', 1.0)
    if ev_mult != 1.0:
        calc.append(t(f"× **{ev_mult}** 🎉 (événement)", f"× **{ev_mult}** 🎉 (event)"))
    if pos_mult != 1.0:
        calc.append(f"📈 comeback ×{pos_mult:.2f}" if pos_mult > 1.0 else f"📉 top 3 ×{pos_mult:.2f}")
    if weekly > WEEKLY_CAP:
        eff_now, eff_next = _weekly_soft_cap(weekly), _weekly_soft_cap(weekly + 10)
        calc.append(t(f"📉 soft cap (~{round((eff_next - eff_now) / 10 * 100)}% efficacité)",
                      f"📉 soft cap (~{round((eff_next - eff_now) / 10 * 100)}% efficiency)"))
    placement_exemption = snap.get('_last_placement_exemption', 0.0)
    if placement_exemption > 0:
        calc.append(t(f"+ **{placement_exemption:.2f}** 🆕 (série de placement, soft cap ignoré)",
                      f"+ **{placement_exemption:.2f}** 🆕 (placement series, soft cap ignored)"))
    if is_wanted and bonus_points > 0:
        calc.append(f"+ **{bonus_points:.2f}** 🎯 (wanted)")
    calc.append(t(f"= **{total_points:.2f} ⭐** (shiny effectif)", f"= **{total_points:.2f} ⭐** (effective shiny)"))
    if sp_total > 0:
        calc.append(t(f"+ **{sp_total:.2f}** 🎁 (bonus spéciaux)", f"+ **{sp_total:.2f}** 🎁 (special bonuses)"))
    if obj_total > 0:
        calc.append(t(f"+ **{obj_total:.2f}** 📅 (objectifs)", f"+ **{obj_total:.2f}** 📅 (objectives)"))
    if race_total > 0:
        calc.append(f"+ **{race_total}** 🏁 (race)")
    calc.append(f"🏆 **Total : {grand_total:.2f} ⭐**")
    calc_detail = "\n".join(calc)[:4000]

    # ── Rang ────────────────────────────────────────────────────────────────
    new_rank, new_pts = get_user_rank(user_id)
    old_rank = r['old_rank']
    rank_line = None
    if new_rank:
        delta = f" *(+{old_rank - new_rank} 📈)*" if old_rank and old_rank > new_rank else ""
        rank_line = f"🏅 **#{new_rank}** — {get_rank_title_for_position(new_rank)}{delta} · {new_pts:.1f} pts"

    # ── Bonus & événements (un seul champ, sans doublon avec le résumé) ──────
    bonus_lines = []
    if is_wanted and bonus_points > 0:
        bonus_lines.append(f"🎯 **Wanted !** +{bonus_points:.2f} pts")
    if race_won and race_bonus_points > 0:
        nb = r['nb_races']
        race_lbl = t("RACE GAGNÉE" if nb <= 1 else f"{nb} RACES GAGNÉES", "RACE WON" if nb <= 1 else f"{nb} RACES WON")
        bonus_lines.append(t(f"🏁 **{race_lbl} !** +{race_bonus_points} pts · 💔 adversaires pénalisés",
                             f"🏁 **{race_lbl}!** +{race_bonus_points} pts · 💔 opponents penalised"))
    if team_race_msg:
        bonus_lines.append(f"⚔️ {team_race_msg[:200]}")
    for desc, pts in objective_bonuses:
        bonus_lines.append(f"✅ {desc} → +{pts} pts")
    for label, pts in special_bonuses:
        bonus_lines.append(f"🎁 {label} → +{pts} pts" if pts else f"🎁 {label}")
    ev_desc = snap.get('_last_event_desc')
    if ev_mult != 1.0 and ev_desc:
        bonus_lines.append(t(f"🎉 Événement ×{ev_mult} — *{ev_desc}*", f"🎉 Event ×{ev_mult} — *{ev_desc}*"))
    if snap.get('_last_new_game_bonus'):
        bonus_lines.append(t("🗺️ Premier shiny dans ce jeu — **+10% accordé !**", "🗺️ First shiny in this game — **+10% granted!**"))
    for b in r['bounty_events']:
        if b.get('completed'):
            bonus_lines.append(t(f"🤝 **Bounty complété !** (+{b['bonus_points']:.2f} pts aux participants)",
                                 f"🤝 **Bounty completed!** (+{b['bonus_points']:.2f} pts to participants)"))
        else:
            bonus_lines.append(f"🤝 Bounty : {b['progress']}/{b['goal']}")
    if r['new_badges']:
        badges = ", ".join(f"{emoji} {name}" for _c, emoji, name, _d, _a in r['new_badges'][:3])
        bonus_lines.append(f"🎖️ {t('Badge', 'Badge')} : {badges}")
    if hunt_counter > 0:
        for tier in [5000, 10000, 20000]:
            gap = tier - hunt_counter
            if 0 < gap <= 1000:
                bonus_lines.append(t(f"🔥 À seulement **{gap} rencontres** du bonus {tier:,} !",
                                     f"🔥 Only **{gap} encounters** away from the {tier:,} bonus!"))
                break

    # ── Annonce publique (compacte) ──────────────────────────────────────────
    color = member.color if hasattr(member, "color") and member.color.value else discord.Color.gold()
    congrats = t(f"Félicitations {member.mention} !", f"Congratulations {member.mention}!")
    public = discord.Embed(
        title=t("✨ Nouveau Shiny Ajouté ! ✨", "✨ New Shiny Added! ✨"),
        description=f"{congrats}\n**{r['display_pokemon']}** · {r['game_name']} · {r['method_name']}",
        color=color, timestamp=r['date_obj'])
    public.set_author(name=member.display_name, icon_url=member.display_avatar.url)
    public.set_thumbnail(url=member.display_avatar.url)
    cap_line = t(f"📊 Semaine : **{min(weekly, WEEKLY_CAP):.0f}/{WEEKLY_CAP:.0f}** pts (cap)",
                 f"📊 Week: **{min(weekly, WEEKLY_CAP):.0f}/{WEEKLY_CAP:.0f}** pts (cap)")
    points_value = f"🏆 **{grand_total:.2f} ⭐** {t('au total', 'in total')}\n{cap_line}"
    if rank_line:
        points_value += f"\n{rank_line}"
    public.add_field(name=t("Points obtenus", "Points earned"), value=points_value[:1024], inline=False)
    if bonus_lines:
        public.add_field(name=t("🎁 Bonus & Événements", "🎁 Bonuses & Events"),
                         value="\n".join(bonus_lines)[:1024], inline=False)
    hunt_bits = []
    if hunt_counter > 0:
        hunt_bits.append(f"🔢 {hunt_counter:,}".replace(",", " ") + t(" rencontres", " encounters"))
    if console_count > 1:
        hunt_bits.append(f"🖥️ {console_count} {_unit_label(s.hunt_type, s.language)}"
                         + (f" (×{console_mult:g})" if console_mult != 1.0 else ""))
    if spawn_pct is not None:
        hunt_bits.append(f"🌱 spawn {spawn_pct:g} % (×{spawn_multiplier:.2f})")
    if hunt_bits:
        public.add_field(name=t("🎮 Chasse", "🎮 Hunt"), value=" · ".join(hunt_bits), inline=False)
    public.set_footer(text=t("ShinyBot - Merci à toi bgette/bg !", "ShinyBot - Thank you!"))

    # ── Récapitulatif privé (éphémère) ───────────────────────────────────────
    summary = build_smart_shiny_summary(
        language=s.language, game_key=s.game_key, method_key=s.method_key, grand_total=grand_total,
        total_points=total_points, sp_total=sp_total, obj_total=obj_total, race_total=race_total,
        objective_bonuses=objective_bonuses, special_bonuses=special_bonuses, is_wanted=is_wanted,
        bonus_points=bonus_points, rank_change_data=r['rank_change_data'], new_rank=new_rank,
        new_badges=r['new_badges'], bounty_events=r['bounty_events'],
        mystery_reveals=r['mystery_reveals'], team_race_msg=team_race_msg)
    title = t("✅ Shiny enregistré !", "✅ Shiny recorded!")
    if s.shiny_count > 1:
        title += f" ({s.shiny_count}/{SHINY_SESSION_MAX})"
    private = discord.Embed(
        title=title,
        description=f"**{s.pokemon}** · {r['game_name']} · {r['method_name']}\n🏆 **{grand_total:.2f} ⭐**",
        color=discord.Color.green())
    private.add_field(name=t("🧠 Résumé intelligent", "🧠 Smart Summary"), value=summary, inline=False)
    mission = get_closest_weekly_mission(user_id)
    if mission:
        m_desc, m_bonus, m_cur, m_need = mission
        filled = int((m_cur / m_need) * 8) if m_need else 0
        bar = "█" * filled + "░" * (8 - filled)
        private.add_field(
            name=t("💡 Prochaine mission", "💡 Next mission"),
            value=f"*{m_desc}*\n`{bar}` {m_cur}/{m_need} — **+{m_bonus:.0f} pts** ({t('manque', 'missing')} {m_need - m_cur})",
            inline=False)
    private.set_footer(text=t("L'annonce est publiée dans le salon. Les boutons ci-dessous ne sont visibles que par toi.",
                              "The announcement is posted in the channel. The buttons below are only visible to you."))

    # Envoi en dernier (les embeds sont déjà construits : un rejeu du wrapper ne reposte qu'en cas d'échec d'envoi)
    public_message = await interaction.followup.send(embed=public, wait=True)
    return {'public_message': public_message, 'public_embed': public,
            'private_embed': private, 'calc_detail': calc_detail}


async def run_shiny_flow(interaction, s, form):
    """Orchestration : base de données (1 fois) → annonce publique (avec retry) → message éphémère de contrôle."""
    is_fr = _fr(s.language)

    async def _show(embed, view):
        try:
            await interaction.edit_original_response(embed=embed, view=view)
        except Exception as e:
            logger.error(f"Impossible de mettre à jour le message éphémère: {e}")

    try:
        r = await _apply_shiny_to_db(interaction, s)
    except Exception as e:
        logger.error(f"Erreur enregistrement shiny: {e}", exc_info=True)
        r = None

    if r is None and not s.db_written:
        # Rien n'a été écrit : on rend la main au joueur avec le formulaire intact.
        form._submitting = False
        new = form.clone(warning=("❌ Une erreur s'est produite lors de l'ajout du shiny. Réessaie." if is_fr
                                  else "❌ An error occurred while adding the shiny. Please try again."))
        return await _show(new.build_embed(), new)
    if r is not None and 'error' in r:
        form._submitting = False
        new = form.clone(warning=r['error'])
        return await _show(new.build_embed(), new)

    controls_kwargs = dict(owner_id=interaction.user.id, language=s.language, hunt_type=s.hunt_type,
                           shiny_count=s.shiny_count)
    if r is None:
        # Le shiny est en base mais une étape secondaire a planté : ne pas le réenregistrer.
        embed = discord.Embed(
            title="⚠️ Shiny enregistré, mais…" if is_fr else "⚠️ Shiny recorded, but…",
            description=("Ton shiny est bien en base, mais une étape secondaire (bonus/annonce) a échoué. "
                         "Vérifie avec **/mes_shiny** — inutile de le ré-ajouter.") if is_fr else
                        ("Your shiny is saved, but a secondary step (bonuses/announcement) failed. "
                         "Check with **/mes_shiny** — no need to add it again."),
            color=discord.Color.orange())
        return await _show(embed, ShinyControlsView(**controls_kwargs))

    sent = await discord_retry_wrapper(_send_shiny_result, interaction, s, r, context="Shiny Result")
    if sent is None:
        embed = discord.Embed(
            title="⚠️ Shiny enregistré, annonce non publiée" if is_fr else "⚠️ Shiny recorded, announcement not posted",
            description=(f"**{s.pokemon}** est bien enregistré, mais l'annonce publique n'a pas pu être envoyée. "
                         f"Inutile de le ré-ajouter.") if is_fr else
                        (f"**{s.pokemon}** is saved, but the public announcement couldn't be sent. "
                         f"No need to add it again."),
            color=discord.Color.orange())
        await _show(embed, ShinyControlsView(**controls_kwargs))
    else:
        await _show(sent['private_embed'], ShinyControlsView(
            **controls_kwargs, calc_detail=sent['calc_detail'],
            public_message=sent['public_message'], public_embed=sent['public_embed']))

    for wid, masked, count in r['mystery_reveals']:
        if is_fr:
            reveal_msg = (f"🔍 **Wanted mystère** — {count} shinys chassés pour ce wanted !\n"
                          f"Une nouvelle lettre t'est révélée (juste à toi) : `{masked}`")
        else:
            reveal_msg = (f"🔍 **Mystery Wanted** — {count} shinies hunted for this wanted!\n"
                          f"A new letter has been revealed to you only: `{masked}`")
        try:
            await interaction.followup.send(reveal_msg, ephemeral=True)
        except Exception as e:
            logger.error(f"Envoi indice wanted mystère: {e}")

    async def delayed_update():
        await asyncio.sleep(3)
        await update_classement_message()
    asyncio.create_task(delayed_update())


class ShinyControlsView(discord.ui.View):
    """Message éphémère (visible du seul joueur) : ajouter un autre / terminer / annuler / détail du calcul."""

    def __init__(self, *, owner_id, language, hunt_type, shiny_count, calc_detail=None,
                 public_message=None, public_embed=None):
        super().__init__(timeout=600)
        self.owner_id = owner_id
        self.language = language
        self.hunt_type = hunt_type
        self.shiny_count = shiny_count
        self.calc_detail = calc_detail
        self.public_message = public_message
        self.public_embed = public_embed
        fr = _fr(language)
        self._detail_btn = None

        if shiny_count >= SHINY_SESSION_MAX:
            self.add_item(discord.ui.Button(
                label=f"✅ Terminé (maximum {SHINY_SESSION_MAX} shinys atteint)" if fr
                      else f"✅ Done (max {SHINY_SESSION_MAX} shinies reached)",
                style=discord.ButtonStyle.success, disabled=True))
        else:
            remaining = SHINY_SESSION_MAX - shiny_count
            add_btn = discord.ui.Button(
                label=(f"✨ Ajouter un autre shiny ({remaining} restant{'s' if remaining > 1 else ''})" if fr
                       else f"✨ Add another shiny ({remaining} left)"),
                style=discord.ButtonStyle.primary)
            add_btn.callback = self.add_another
            self.add_item(add_btn)
            done_btn = discord.ui.Button(label="✅ Terminer" if fr else "✅ Done", style=discord.ButtonStyle.secondary)
            done_btn.callback = self.finish
            self.add_item(done_btn)

        cancel_btn = discord.ui.Button(label="↩️ Annuler ce shiny" if fr else "↩️ Cancel this shiny",
                                       style=discord.ButtonStyle.danger)
        cancel_btn.callback = self.cancel
        self.cancel_btn = cancel_btn
        self.add_item(cancel_btn)

        if calc_detail:
            detail_btn = discord.ui.Button(label="🧮 Détail du calcul" if fr else "🧮 Calculation detail",
                                           style=discord.ButtonStyle.secondary)
            detail_btn.callback = self.show_calc_detail
            self._detail_btn = detail_btn
            self.add_item(detail_btn)

    async def interaction_check(self, interaction: discord.Interaction) -> bool:
        return interaction.user.id == self.owner_id

    async def show_calc_detail(self, interaction: discord.Interaction):
        title = "🧮 Détail du calcul" if _fr(self.language) else "🧮 Calculation detail"
        await interaction.response.send_message(
            embed=discord.Embed(title=title, description=self.calc_detail, color=discord.Color.blue()),
            ephemeral=True)

    async def add_another(self, interaction: discord.Interaction):
        # On fige les boutons de CE message (sinon « Annuler » viserait le shiny suivant), mais on garde le détail.
        for item in self.children:
            if item is not self._detail_btn:
                item.disabled = True
        await interaction.response.edit_message(view=self)
        prefs = get_user_preferences(str(interaction.user.id))
        form = ShinyFormView.fresh(owner_id=interaction.user.id, language=self.language, hunt_type=self.hunt_type,
                                   prefs=prefs, shiny_count=self.shiny_count + 1)
        await interaction.followup.send(embed=form.build_embed(), view=form, ephemeral=True)

    async def finish(self, interaction: discord.Interaction):
        fr = _fr(self.language)
        n = self.shiny_count
        label = (f"✅ Session terminée — {n} shiny{'s' if n > 1 else ''} ajouté{'s' if n > 1 else ''} !" if fr
                 else f"✅ Session ended — {n} {'shinies' if n > 1 else 'shiny'} added!")
        await interaction.response.edit_message(content=label, view=None)

    async def cancel(self, interaction: discord.Interaction):
        """Supprime le dernier shiny du joueur (les bonus liés restent, comme avant)."""
        fr = _fr(self.language)

        async def _cancel(**kwargs):
            target_user_id = str(self.owner_id)
            _system = ('race_bonus', 'race_malus', 'race_team_bonus', 'race_team_malus', 'inactivity_decay',
                       'season_calibration', 'weekly_objective', 'monthly_objective', 'admin_adjustment',
                       'bounty_bonus', 'participation_bonus', 'monday_first_bonus', 'new_player_bonus',
                       'parrainage_bonus', 'challenge_bonus', 'type_challenge_bonus', 'season_carryover',
                       'wanted_bonus')
            ph = ','.join('?' * len(_system))
            cursor.execute(
                f"SELECT rowid, pokemon, game, points FROM shiny WHERE user_id=? AND methode NOT IN ({ph}) "
                f"ORDER BY rowid DESC LIMIT 1", (target_user_id, *_system))
            row = cursor.fetchone()
            if not row:
                await interaction.response.send_message(
                    "⚠️ Aucun shiny à annuler." if fr else "⚠️ No shiny to cancel.", ephemeral=True)
                return None
            rowid, pokemon, game, pts = row
            cursor.execute("DELETE FROM shiny WHERE rowid=?", (rowid,))
            conn.commit()

            self.cancel_btn.disabled = True
            self.cancel_btn.label = "↩️ Annulé" if fr else "↩️ Cancelled"
            try:
                await interaction.response.edit_message(view=self)
            except Exception:
                pass
            # L'annonce publique ne doit pas rester comme si de rien n'était.
            if self.public_message is not None and self.public_embed is not None:
                try:
                    cancelled = self.public_embed.copy()
                    cancelled.title = "❌ Shiny annulé" if fr else "❌ Shiny cancelled"
                    cancelled.color = discord.Color.dark_grey()
                    await self.public_message.edit(embed=cancelled)
                except Exception as e:
                    logger.warning(f"Impossible de marquer l'annonce comme annulée: {e}")
            await interaction.followup.send(
                (f"✅ **{pokemon}** ({game}, {pts} pts) a été retiré de ton historique." if fr
                 else f"✅ **{pokemon}** ({game}, {pts} pts) has been removed from your history."),
                ephemeral=True)
            asyncio.create_task(update_classement_message())
            return True

        await discord_retry_wrapper(_cancel, context="Cancel Last Shiny")


# Vues Admin corrigées de la même manière
class AdminShinyAddView(discord.ui.View):
    def __init__(self, target_member):
        super().__init__(timeout=300)
        self.target_member = target_member
        
    @discord.ui.select(
        placeholder="Choisissez la langue / Choose language",
        options=[
            discord.SelectOption(label="Français", value="Français", emoji="🇫🇷"),
            discord.SelectOption(label="English", value="English", emoji="🇬🇧")
        ]
    )
    async def language_select(self, interaction: discord.Interaction, select: discord.ui.Select):
        async def _respond(**kwargs):
            language = select.values[0]

            embed = discord.Embed(
                title="🛡️ Admin - Ajout de Shiny" if language == "Français" else "🛡️ Admin - Add Shiny",
                description=f"**Membre / Member:** {self.target_member.mention}\n**Langue / Language:** {language}\n\n{'Choisissez le type :' if language == 'Français' else 'Choose the type:'}",
                color=discord.Color.green()
            )

            new_view = AdminHuntTypeSelectView(language, self.target_member)
            await interaction.response.edit_message(embed=embed, view=new_view)

        await discord_retry_wrapper(_respond, context="Admin Language Select")

