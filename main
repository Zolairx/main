class AdminMethodSelectView(discord.ui.View):
    def __init__(self, language, game_key, target_member, hunt_type="emulators"):
        super().__init__(timeout=300)
        self.language = language
        self.game_key = game_key
        self.target_member = target_member
        self.hunt_type = hunt_type
        
        lang_code = "fr" if language == "Français" else "en"
        method_options = []
        
        for method_key, method_data in METHODS_BY_GAME[game_key].items():
            method_name = method_data[lang_code]
            points = method_data["points"]
            label = f"{method_name} ({points} pts)"
            # Utiliser la description pour les notes si disponible
            description = None
            if "note_fr" in method_data or "note_en" in method_data:
                note_key = "note_fr" if lang_code == "fr" else "note_en"
                if note_key in method_data:
                    description = method_data[note_key]
            method_options.append(discord.SelectOption(
                label=label[:100],  # Limite Discord: 100 caractères
                value=method_key,
                description=description[:100] if description else None  # Limite Discord: 100 caractères
            ))
        
        select = discord.ui.Select(
            placeholder="Choisissez la méthode" if language == "Français" else "Choose the method",
            options=method_options
        )
        select.callback = self.method_callback
        self.add_item(select)
    
    async def method_callback(self, interaction):
        async def _respond(**kwargs):
            method_key = interaction.data['values'][0]

            modal = AdminShinyModal(self.language, self.game_key, method_key, self.target_member, self.hunt_type)
            await interaction.response.send_modal(modal)

        await discord_retry_wrapper(_respond, context="Admin Method Select")

