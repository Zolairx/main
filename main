@bot.tree.command(
    name="admin_edit_points",
    description="[ADMIN] Modifier les points d'un utilisateur",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    member="Membre dont vous voulez modifier les points",
    points="Nombre de points à ajouter (positif) ou retirer (négatif)"
)
async def admin_edit_points(interaction: discord.Interaction, member: discord.Member, points: float):
    async def _edit_points(**kwargs):
        if not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("❌ Vous devez être administrateur pour utiliser cette commande.", ephemeral=True)
            return None

        await interaction.response.defer(ephemeral=True)

        user_id = str(member.id)

        # Vérifier que l'utilisateur a au moins un shiny
        cursor.execute("SELECT COUNT(*) FROM shiny WHERE user_id = ?", (user_id,))
        count = cursor.fetchone()[0]

        if count == 0:
            await interaction.followup.send(f"⚠️ {member.mention} n'a aucun shiny enregistré.", ephemeral=True)
            return None

        # Obtenir les points actuels
        cursor.execute("SELECT SUM(points) FROM shiny WHERE user_id = ?", (user_id,))
        current_points = cursor.fetchone()[0] or 0

        # Si on retire des points, créer une entrée "négative"
        if points != 0:
            date_obj = datetime.now()
            date_formatted = date_obj.strftime("%d-%m-%Y")

            # Créer une entrée spéciale avec un nom de Pokémon indiquant l'ajustement
            pokemon_name = f"[Ajustement Admin: {'+' if points > 0 else ''}{points} pts]"
            game_name = "Ajustement Admin"
            method_key = "admin_adjustment"

            cursor.execute(
                "INSERT INTO shiny (user_id, pokemon, game, methode, date, points, created_at, language, console_count, hunt_counter) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?, ?, ?)",
                (user_id, pokemon_name, game_name, method_key, date_formatted, points, 'fr', 1, 0)
            )
            conn.commit()

            new_points = current_points + points

            embed = discord.Embed(
                title="✅ Points Modifiés",
                description=f"Les points de {member.mention} ont été modifiés par {interaction.user.mention}",
                color=discord.Color.green(),
                timestamp=date_obj
            )
            embed.add_field(name="Points avant", value=f"{current_points} ⭐", inline=True)
            embed.add_field(name="Modification", value=f"{'+' if points > 0 else ''}{points} ⭐", inline=True)
            embed.add_field(name="Points après", value=f"{new_points} ⭐", inline=True)
            embed.set_footer(text="ShinyBot - Modification Admin")

            await interaction.followup.send(embed=embed, ephemeral=True)

            # Programmer la mise à jour du classement
            asyncio.create_task(asyncio.sleep(2))
            asyncio.create_task(update_classement_message())
            return True
        else:
            await interaction.followup.send("⚠️ La modification doit être différente de 0.", ephemeral=True)
            return None

    result = await discord_retry_wrapper(_edit_points, context="Admin Edit Points Command")
    if result is None:
        try:
            await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

@bot.tree.command(
    name="add_shiny_moi",
    description="[ADMIN] Ajouter un Pokémon shiny à la liste des candidats pour le vote (max 15)",
    guild=discord.Object(id=GUILD_ID)
)
@app_commands.describe(
    image="Image du Pokémon shiny (fichier PNG/JPG)"
)
async def add_shiny_moi(interaction: discord.Interaction, image: discord.Attachment = None):
    async def _show_modal(**kwargs):
        if not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("❌ Vous devez être administrateur pour utiliser cette commande.", ephemeral=True)
            return None

        cursor.execute("SELECT COUNT(*) FROM shiny_candidates")
        count = cursor.fetchone()[0]

        if count >= 15:
            await interaction.response.send_message("❌ La liste est pleine ! Maximum 15 Pokémon. Utilisez `/reset_vote_shiny` pour réinitialiser.", ephemeral=True)
            return None

        image_url = None
        if image:
            if not image.content_type or not image.content_type.startswith('image/'):
                await interaction.response.send_message("❌ Le fichier doit être une image (PNG, JPG, etc.)", ephemeral=True)
                return None
            image_url = image.url

        modal = AddCandidateModal(image_url=image_url)
        await interaction.response.send_modal(modal)
        return True

    result = await discord_retry_wrapper(_show_modal, context="Add Shiny Moi Command")
    if result is None:
        try:
            if not interaction.response.is_done():
                await interaction.response.send_message("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

@bot.tree.command(
    name="vote_shiny",
    description="Voter pour le Shiny du Mois (sélectionnez jusqu'à 3 Pokémon)",
    guild=discord.Object(id=GUILD_ID)
)
async def vote_shiny(interaction: discord.Interaction):
    candidates = get_shiny_candidates()

    if not candidates:
        await interaction.response.send_message("❌ Aucun Pokémon n'est disponible pour le vote actuellement.", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)

    # Embed principal avec les instructions
    main_embed = discord.Embed(
        title="🗳️ Vote pour le Shiny du Mois",
        description=f"**{len(candidates)} Pokémon** sont en compétition !\n\n"
                    f"🎯 **Comment voter ?**\n"
                    f"Sélectionnez **jusqu'à 3 Pokémon** dans le menu déroulant ci-dessous.\n\n"
                    f"**📊 Système de points:**\n"
                    f"🥇 1er choix = **3 points**\n"
                    f"🥈 2ème choix = **2 points**\n"
                    f"🥉 3ème choix = **1 point**\n\n"
                    f"⚠️ Votre nouveau vote remplacera votre vote précédent.",
        color=discord.Color.gold(),
        timestamp=datetime.now()
    )
    main_embed.set_footer(text="ShinyBot - Vote du mois")

    # Créer des embeds individuels pour chaque candidat avec leur image
    candidate_embeds = []

    for idx, candidate in enumerate(candidates[:15], 1):
        cand_id, pokemon_name, image_url, encounters, game, method = candidate

        # Choisir une couleur selon la position
        colors = [
            discord.Color.red(),
            discord.Color.blue(),
            discord.Color.green(),
            discord.Color.gold(),
            discord.Color.purple(),
            discord.Color.orange(),
            discord.Color.magenta(),
            discord.Color.teal()
        ]
        color = colors[(idx - 1) % len(colors)]

        candidate_embed = discord.Embed(
            title=f"#{idx} • {pokemon_name}",
            color=color
        )

        candidate_embed.add_field(
            name="🎮 Jeu",
            value=game,
            inline=True
        )
        candidate_embed.add_field(
            name="🎯 Méthode",
            value=method,
            inline=True
        )
        candidate_embed.add_field(
            name="🔢 Rencontres",
            value=f"{encounters:,}",
            inline=True
        )

        # Ajouter l'image si elle existe (utiliser l'image locale si disponible)
        if image_url:
            # Vérifier si c'est un chemin local ou une URL
            if image_url.startswith('shiny_images/'):
                # C'est un chemin local, utiliser file://
                candidate_embed.set_image(url=f"attachment://{Path(image_url).name}")
            else:
                # C'est une URL externe, l'utiliser directement
                candidate_embed.set_image(url=image_url)

        candidate_embed.set_footer(text=f"Candidat {idx}/{len(candidates)}")

        candidate_embeds.append(candidate_embed)

    # Envoyer l'embed principal
    await interaction.followup.send(embed=main_embed, ephemeral=True)

    # Envoyer les embeds des candidats avec gestion des images locales
    for i in range(0, len(candidate_embeds), 8):  # Augmenté de 5 à 8 pour une meilleure expérience
        batch = candidate_embeds[i:i+8]
        for idx, embed in enumerate(batch):
            candidate_idx = i + idx
            if candidate_idx < len(candidates):
                cand_id, pokemon_name, image_url, encounters, game, method = candidates[candidate_idx]
                
                # Si l'image est locale, l'attacher au message
                if image_url and image_url.startswith('shiny_images/'):
                    try:
                        image_path = Path(image_url)
                        if image_path.exists():
                            file = discord.File(image_path, filename=image_path.name)
                            await interaction.followup.send(embed=embed, file=file, ephemeral=True)
                        else:
                            await interaction.followup.send(embed=embed, ephemeral=True)
                    except Exception as e:
                        logger.warning(f"Erreur lors de l'envoi de l'image locale: {e}")
                        await interaction.followup.send(embed=embed, ephemeral=True)
                else:
                    await interaction.followup.send(embed=embed, ephemeral=True)
                
                await asyncio.sleep(0.4)  # Réduit de 0.8s à 0.4s pour une meilleure expérience

    # Embed final avec le menu de sélection
    selection_embed = discord.Embed(
        title="📝 Faites votre choix",
        description="Utilisez le menu déroulant ci-dessous pour sélectionner vos 3 Pokémon préférés :",
        color=discord.Color.blurple()
    )

    view = VoteSelectView()
    await interaction.followup.send(embed=selection_embed, view=view, ephemeral=True)

@bot.tree.command(
    name="results_shiny",
    description="[ADMIN] Afficher les résultats du vote pour le Shiny du Mois",
    guild=discord.Object(id=GUILD_ID)
)
async def results_shiny(interaction: discord.Interaction):
    async def _show_results(**kwargs):
        if not interaction.user.guild_permissions.administrator:
            await interaction.response.send_message("❌ Vous devez être administrateur pour utiliser cette commande.", ephemeral=True)
            return None

        await interaction.response.defer()

        results = get_vote_results()

        if not results:
            await interaction.followup.send("❌ Aucun résultat disponible. Aucun Pokémon n'a été ajouté au vote.", ephemeral=True)
            return None

        cursor.execute("SELECT COUNT(DISTINCT user_id) FROM shiny_votes")
        total_voters = cursor.fetchone()[0]

        embed = discord.Embed(
            title="🏆 Résultats du Vote - Shiny du Mois",
            description=f"**{total_voters}** personnes ont voté\n\n**Système de points:** 1er choix = 3pts, 2ème = 2pts, 3ème = 1pt",
            color=discord.Color.gold(),
            timestamp=datetime.now()
        )

        podium_emojis = ["🥇", "🥈", "🥉"]
        winner_image = None

        for index, result in enumerate(results[:10]):
            cand_id, pokemon_name, game, method, encounters, image_url, vote_count, total_score = result

            if index == 0 and image_url:
                winner_image = image_url

            emoji = podium_emojis[index] if index < 3 else f"**#{index+1}**"
            score_display = total_score if total_score else 0

            field_name = f"{emoji} {pokemon_name}"
            field_value = f"**Score:** {score_display} points\n**Votes:** {vote_count if vote_count else 0}\n**Jeu:** {game}\n**Méthode:** {method}\n**Rencontres:** {encounters}"

            embed.add_field(name=field_name, value=field_value, inline=False)

        embed.set_footer(text="ShinyBot - Résultats du vote")

        # Si l'image du gagnant est locale, l'attacher au message
        if winner_image:
            if winner_image.startswith('shiny_images/'):
                try:
                    image_path = Path(winner_image)
                    if image_path.exists():
                        file = discord.File(image_path, filename=image_path.name)
                        await interaction.followup.send(embed=embed, file=file)
                    else:
                        await interaction.followup.send(embed=embed)
                except Exception as e:
                    logger.warning(f"Erreur lors de l'envoi de l'image du gagnant: {e}")
                    await interaction.followup.send(embed=embed)
            else:
                embed.set_image(url=winner_image)
                await interaction.followup.send(embed=embed)
        else:
            await interaction.followup.send(embed=embed)
        return True

    result = await discord_retry_wrapper(_show_results, context="Results Shiny Command")
    if result is None:
        try:
            await interaction.followup.send("❌ Une erreur s'est produite.", ephemeral=True)
        except:
            pass

