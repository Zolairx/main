            game_key = interaction.data['values'][0]
            game_name = GAMES[game_key]["fr" if self.language == "Français" else "en"]

            embed = discord.Embed(
                title="✨ Add My Shiny" if self.language == "English" else "✨ Ajouter Mon Shiny",
                description=f"**{'Selected game' if self.language == 'English' else 'Jeu sélectionné'}:** {game_name}\n\n{'Now choose the method used:' if self.language == 'English' else 'Maintenant choisissez la méthode utilisée:'}",
                color=discord.Color.blue()
            )

            new_view = MethodSelectView(self.language, game_key, self.hunt_type, shiny_count=self.shiny_count)
            await interaction.response.edit_message(embed=embed, view=new_view)

        await discord_retry_wrapper(_respond, context="Game Select After Type")

